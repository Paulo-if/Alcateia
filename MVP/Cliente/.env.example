# Alcateia Barber — Variáveis de ambiente (Cliente)

# Supabase (obrigatório para o modo produção/operacional)
# Crie uma cópia deste arquivo como `.env` e preencha com as credenciais do seu projeto Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Instagram da barbearia (usado no rodapé da home pública; opcional)
VITE_INSTAGRAM_URL=

# Dados da barbearia para a home pública (opcional; sobrescreve valores padrão)
VITE_BARBEARIA_NOME=Alcateia Barber
VITE_BARBEARIA_WHATSAPP=

# FORÇAR MODO DEV LOCAL (fallback)
# Se `VITE_SUPABASE_URL`/`VITE_SUPABASE_ANON_KEY` não forem definidas, o app
# entra automaticamente em modo de demonstração local com aviso claro na tela.
# Defina como "true" para desabilitar o fallback e exigir configuração do Supabase.
VITE_REQUIRE_SUPABASE=false
