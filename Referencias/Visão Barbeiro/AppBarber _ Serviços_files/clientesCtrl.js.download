	$scope.confirmRemoveCliente1 = function(){

		showLoader(true);
		$.ajax({
			dataType: "html",
			url: '/pages/cadastros/removeClientes.php',
			data: {
				pescodigo: $("#pesCodigoRemoveCliente1").val()
			},
			success: function (data) {
				if (data == "0") {
					toastr.success($_CONFIG.language.mensagens.cliente_excluido);
					$scope.thisrow.remove().draw(false);
					$('#removeClienteConfirm1-modal').modal('hide')
				} else {
					toastr.error(data, $_CONFIG.language.mensagens.falha_excluir);
					$('#removeClienteConfirm1-modal').modal('hide')
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.mensagens.falha_conexao);
				showLoader(false);
			}
		});

		// $('#removeClienteConfirm1-modal').modal('hide')
