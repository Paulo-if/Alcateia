			$("#addPontos").val('');
			toastr.warning("O número de pontos a ser inserido deve ser maior que 0");
		}
	})

	$('#formAddPontos').submit(function (event) {
		if ($scope.submitAddPontos) {
			$scope.submitAddPontos = false;
			event.preventDefault();
			formAddPontos = $(this);
			showLoader(true);
			$.ajax({
				type: "POST",
				url: "/pages/cadastros/inserePessoaPonto.php",
				data: {
					pescodigo: $("#pesCodigoPonto").val(),
					pontos: $("#addPontos").val(),
					observacao: $("#pontosObs").val()
				},
				dataType: "json",

				success: function (result) {
					$scope.submitAddPontos = true;
					if (result.result[0].erro == "0") {
						toastr.success(result.result[0].resultado);
						$("#AddPontos-modal").modal("hide");
						$("#editar-modal").modal("hide");
						formAddPontos.each(function () {
							this.reset();
						});
						atualizaDados();
					} else {
						toastr.error(result.result[0].resultado);
					}
					showLoader(false);
				},
				error: function () {
					$scope.submitAddPontos = true;
					toastr.error($_CONFIG.language.mensagens.falha_conexao);
					showLoader(false);
				}
			});
		}
		return true;
	});

	$("#removePontos").keyup(function () {
