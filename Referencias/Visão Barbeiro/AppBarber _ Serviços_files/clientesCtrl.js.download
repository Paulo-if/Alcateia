	$scope.refresh = function () {
		atualizaDados();
	}

	var emit = $rootScope.$on('AtualizaListaCliente', function () {
		$scope.refresh();
	});

	$scope.compileButtons = function () {
		// if (hasManyClients) {
		// 	setTimeout(function () {
		// 		$compile($('#tbBuscaCli'))($scope)
		// 	}, 1000);
		// } else {
