				} else {
					html += "<option id='" + $_CONFIG.LISTA_ESTADO[i].Est_Nome.replace(" ", "").toLowerCase() + "' value='" + $_CONFIG.LISTA_ESTADO[i].Est_Codigo + "'> " + $_CONFIG.LISTA_ESTADO[i].Est_Nome + "</option>";
				}
			}
			$("#cliEstado").html(html);
			$("#cliEstadoEdt").html(html);
		}else{*/
			$.ajax({
				dataType: "json",
				url: '/pages/cadastros/buscaEstadoPais.php',
				method: "POST",
				data:{
					paicodigo:pais
				},
				success: function (data) {
					if (data.result.length > 0) {
