	$scope.showGeraToken = function () {
		$("#tokenCliente-modal").modal("show");
		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/buscaListaPontoItens.php',
			method: "POST",
			success: function (data) {
				if (data.buscaListaPontosItens.length > 0) {
					var html = "<option value=''>Nenhum Selecionado</option>";
					for (var i = 0; i < data.buscaListaPontosItens.length; i++) {
						html += "<option value='" + data.buscaListaPontosItens[i].PIt_Codigo + "'> " + data.buscaListaPontosItens[i].Descricao + "</option>";
					}
				}
				$("#itemTokem").html(html);
			}
		});
	}

	$scope.resgataToken = function () {
		showLoader(true);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/buscaListaPontosResgate.php",
			data: {
				pitcodigo: $("#itemTokem").val(),
				pescodigo: $("#pesCodigoToken").val()
			},
			dataType: "json",
			success: function (result) {
				if (result.data[0].erro == "0") {
					atualizaDados();
					$("#resultadoToken").html(result.data[0].resultado);
					$("#tokenId").html(result.data[0].token);
					$('#editar-modal').modal("hide");
					$('#tokenCliente-modal').modal("hide");
					$('#showTokenCliente-modal').modal("show");
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
	}

	$scope.buscaServicoCliente = function (codigo) {
		if (typeof (tabelacliservico) !== 'undefined') {
			tabelacliservico.destroy();
		}
		tabelacliservico = $('#tableServicoCliente').DataTable({
			'ajax': {
				'url': '/pages/cadastros/buscaPessoaServicoCliente.php',
				'method': 'POST',
				'data': function (d) {
					d.pescodigo = codigo;
					d.tipo = 1;
				}
			},
			"scrollX": isPortrait,

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,

			'initComplete': function () {
				$compile($('#tableServicoCliente'))($scope);
				$('#tableServicoCliente_paginate').click(function () {
					$compile($('#tableServicoCliente'))($scope);
				});
				$('#tableServicoCliente_filter').change(function () {
					$compile($('#tableServicoCliente'))($scope);
				});
				$('#tableServicoCliente_length').change(function () {
					$compile($('#tableServicoCliente'))($scope);
				});
				resizeContent();
			},
			'columns': [{
					'data': 'Ser_Descricao'
				},
				{
					'data': 'PSC_Tempo'
				},
				{
					"class": 'edtTempoServico',
					"orderable": false,
					"data": null,
					"defaultContent": '<button class="btn btn-success btn-xs"  >Editar</button>',
				},
				{
					"class": 'removeTempoServico',
					"orderable": false,
					"data": null,
					"defaultContent": '<button class="btn btn-danger btn-xs"  >Excluir</button>',
				}
			],
			'ordering': false,
			'searching': false,
			'lenghtChange': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});

		$('#tableServicoCliente tbody').on('click', 'td.edtTempoServico', function () {
			var tr = $(this).closest('tr');
			var row = tabelacliservico.row(tr);
			var data = row.data();
			var codigo = row.data().PSC_Codigo;
			var tempo = row.data().PSC_Tempo;
			$("#pscCodigoAltera").val(codigo);
			$("#clienteServicoTempoEdt").val(tempo);
			$('#alteraClienteServico-modal').modal();
		});

		$('#tableServicoCliente tbody').on('click', 'td.removeTempoServico', function () {
			var tr = $(this).closest('tr');
			var row = tabelacliservico.row(tr);
			var data = row.data();
			swal({
					title: "Excluir",
					text: "Deseja realmente excluir esta associação?",
					type: "warning",
					showCancelButton: true,
					confirmButtonColor: "#DD6B55",
					confirmButtonText: "Sim",
					cancelButtonText: "Não"
				},
				function (Confirmou) {
					if (Confirmou) {
						showLoader(true);
						$.ajax({
							type: "POST",
							url: "/pages/cadastros/removePessoaServicoCliente.php",
							data: {
								psccodigo: row.data().PSC_Codigo
							},
							dataType: "json",
							success: function (result) {
								if (result.data[0].erro == "0") {
									$scope.buscaServicoCliente($('#cliCodigoEdt').val())
									toastr.success(result.data[0].resultado);
									showLoader(false);
								} else {
									toastr.error(result.data[0].resultado);
									showLoader(false);
								}
							},
							error: function (result) {
								showLoader(false);
								toastr.error('Falha de conexão');
							}
						});
					}
				});
		});
	}

	$scope.insereSerCliente = function () {
		showLoader(true);
