	$('#cortaImagemAll-modal').on('hidden.bs.modal', function (e) {
		if (mBlob != undefined && mBlob != "") {
			if ((location.hash == '#/clientes') && (($("#editar-modal").data('bs.modal') || {}).isShown) || (($("#cadastrar-modal").data('bs.modal') || {}).isShown) && ($("#formid").val() != "#formCadastro")) {
				$('#cliImagemEdit').attr('src', mImage);
				$scope.saveImageCli();
			}
		} else {
			if ((location.hash == '#/clientes') && (($("#editar-modal").data('bs.modal') || {}).isShown) || ($("#cadastrar-modal").data('bs.modal') || {}).isShown) {
				$scope.saveImageCli();
			}
		}
		$("#imagemCutAll").resize();
		$("#imagemCutAll").cropper("reset");
	})

	$scope.editaImagemCliente = function () {
		$("#cliFotoEdt").click()
	}

	$scope.saveImageCli = function () {
		showLoader(true)
		if (mBlob != undefined) {
			dataaltera = new FormData();
			dataaltera.append('figura', mBlob);
			dataaltera.append('cliente', $('#cliCodigoEdt').val())
			$.ajax({
				dataType: 'json',
				method: 'POST',
				url: '/pages/cadastros/alteraClienteImagem.php',
				data: dataaltera,
				processData: false,
				contentType: false,
				success: function (data) {

					if (data.data[0].erro == 0) {
						$('#cliImagemEdit').attr('src', data.data[0].urlimagem);
						toastr.success(data.data[0].resultado);

						mBlob = "";
						$("#cliFotoEdt").fileinput('clear');

					} else {
						toastr.error(data.data[0].resultado);
					}
					showLoader(false)
				},
				error: function (result) {
					toastr.error('Falha de conexão');
					showLoader(false)
				}
			});
		} else {
			toastr.warning("Ops! Parece que você não concluiu a seleção da nova imagem, nenhuma alteração será feita");
			$("#cliFotoEdt").fileinput('clear');
			showLoader(false)
		}
	}

	$scope.removeImagemCliente = function () {

		swal({
				title: 'Deseja realmente remover essa imagem',
				type: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: $_CONFIG.language.sim,
				cancelButtonText: $_CONFIG.language.nao,
				closeOnConfirm: true
			},
			function () {
				showLoader(true)
				dataaltera = new FormData();

				dataaltera.append('figura', '');
				dataaltera.append('cliente', $('#cliCodigoEdt').val())
				dataaltera.append('cliFiguraEdit', '')
				$.ajax({
					dataType: 'json',
					method: 'POST',
					url: '/pages/cadastros/alteraClienteImagem.php',
					data: dataaltera,
					processData: false,
					contentType: false,
					success: function (data) {
						if (data.data[0].erro == 0) {
							$('#cliImagemEdit').attr('src', '../../img/nopicture.png');
							toastr.success(data.data[0].resultado);
							$("#otpimagencliente").val("").change();
						} else {
							toastr.error(data.data[0].resultado);
						}
						showLoader(false)

					},
					error: function (result) {
						toastr.error('Falha de conexão');
						showLoader(false)
					}
				});
			});
	}

	$(".btniconchange").click(function () {
		var thisState = 1;
		if ($(this).parent().children()[1].children[0].className == 'fa fa-plus') {
			thisState = 1;
		} else {
			thisState = 0;
		}
		$(".btniconchange").children().each(function () {
			this.className = 'fa fa-plus'
		})
		if (thisState == 1) {
			$(this).parent().children()[1].children[0].className = 'fa fa-minus'
		} else {
			$(this).parent().children()[1].children[0].className = 'fa fa-plus'
		}
	});

