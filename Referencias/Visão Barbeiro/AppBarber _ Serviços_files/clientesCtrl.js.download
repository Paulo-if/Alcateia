	function atualizaDados() {
		$(".overlay.tbrefresh").show();
		tabelaCli.ajax.reload(function () {
			if(!hasManyClients){
				totalClients = tabelaCli.settings().rows().count();
				if (totalClients >= 1500) {
					hasManyClients = true;
				} else {
					hasManyClients = false;
				}

			}
			$compile($('#tbBuscaCli'))($scope);
			$("#tbBuscaCli_paginate").click(function () {

				$compile($('#tbBuscaCli'))($scope);
				if (hasManyClients){
					$(".overlay.tbrefresh").show();
				}

			});
			
			$(".overlay.tbrefresh").hide();
		}, false);

		tabelaClienteExcluido.ajax.reload();
	}

	function buscaCEPCliente(cep) {
		mCep = cep;
		if (cep && cep.length >= parseInt($_CONFIG.language.mascaras.max_cep)) {
			cep = cep.replace("-", "");
			showLoader(true);
			var pais = $_CONFIG.language.mascaras.lang;
			$.ajax({
				dataType: "json",
				method: 'POST',
				url: '/pages/cadastros/buscaPostalCode.php',
				data: {
					code: cep,
					pais: pais
				},
				success: function (data) {
					var estado = "";
					if (pais == "pt") {
						estado = $("#" + data.estado.replace(" ", "").toLowerCase() + "").val();
					} else {
						estado = $("#" + data.estado + "").val();
					}
					$("#cliEstado").val(estado);
					$("#cliCidade").empty();

					$.ajax({
						dataType: "json",
						url: '/pages/cadastros/buscaCidadesWizard.php',
						method: "POST",
						data: {
							estCodigo: estado,
							cidNome: data.cidade
						},
						success: function (result) {
							$("#cliCidade").append(result.cidades);
							$("#cliCidade").attr("disabled", false);
							setTimeout(function () {
								$("#cliCidade").val(result.cidcodigo);
							}, 10);
							showLoader(false);
							$("#cliBairro").val(data.bairro);
							$("#cliEndereco").val(data.endereco);
						}
					});
					showLoader(false);
				},
				error: function () {
					showLoader(false);
					toastr.error($_CONFIG.language.mensagens.falha_cep, $_CONFIG.language.mensagens.falha_consulta);
				}
			});
		}
	}

	function buscaCEPClienteEdt(cep) {
		mCep = cep;

		if (cep && cep.length >= parseInt($_CONFIG.language.mascaras.max_cep)) {
			cep = cep.replace("-", "");
			showLoader(true);
			var pais = $_CONFIG.language.mascaras.lang;
			$.ajax({
				dataType: "json",
				method: 'POST',
				url: '/pages/cadastros/buscaPostalCode.php',
				data: {
					code: cep,
					pais: pais
				},
				success: function (data) {
					var estado = "";
					if (pais == "pt") {
						estado = $("#" + data.estado.replace(" ", "").toLowerCase() + "").val();
					} else {
						estado = $("#" + data.estado + "").val();
					}
					$("#cliEstadoEdt").val(estado);
					$("#cliCidadeEdt").empty();

					$.ajax({
						dataType: "json",
						url: '/pages/cadastros/buscaCidadesWizard.php',
						method: "POST",
						data: {
							estCodigo: estado,
							cidNome: data.cidade
						},
						success: function (result) {
							$("#cliCidadeEdt").append(result.cidades);
							$("#cliCidadeEdt").attr("disabled", false);
							setTimeout(function () {
								$("#cliCidadeEdt").val(result.cidcodigo);
							}, 10);
							showLoader(false);
							$("#cliBairroEdt").val(data.bairro);
							$("#cliEnderecoEdt").val(data.endereco);
						}
					});
					showLoader(false);
				},
				error: function () {
					showLoader(false);
					toastr.error($_CONFIG.language.mensagens.falha_cep, $_CONFIG.language.mensagens.falha_consulta);
				}
			});
		}
	}

	if ($_CONFIG.LISTA_PAIS.length > 0 ) {
		var html = "<option value=''></option>";
		for (var i = 0; i < $_CONFIG.LISTA_PAIS.length; i++) {
			
			html += "<option id='" +$_CONFIG.LISTA_PAIS[i].Pai_Sigla + "' value='" + $_CONFIG.LISTA_PAIS[i].Pai_Codigo + "'> " + $_CONFIG.LISTA_PAIS[i].Pai_Nome + "</option>";
			
		}

		$("#cliPais").html(html);
		$("#cliPais").val($_CONFIG.PAIS).change();
		$("#cliPaisEdt").html(html);
	}else{
		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/buscaPais.php',
			method: "POST",
			success: function (data) {
				var html = "";
				var sigla = ($_CONFIG.language.mascaras.lang).toUpperCase()
				for (var i = 0; i < data.result.length; i++) {
					if(sigla == data.result[i].Pai_Sigla ){
						html += '<option selected value="' + data.result[i].Pai_Codigo + '" data-sigla="'+data.result[i].Pai_Sigla+'">' + data.result[i].Pai_Nome + '</option>';
					}else{
						html += '<option value="' + data.result[i].Pai_Codigo + '" data-sigla="'+data.result[i].Pai_Sigla+'">' + data.result[i].Pai_Nome + '</option>';
					}
				}
				$("#cliPais").html(html);
				$("#cliPaisEdt").html(html);

			}
		});
	}

	$("#cliPais").change(function(){
		buscaEstados(this.value)
	})

	$("#cliPaisEdt").change(function(){
		
		buscaEstados(this.value)
	})

	function buscaEstados(pais) {
		
		/*if ($_CONFIG.LISTA_ESTADO.length > 0 && pais == $_CONFIG.PAIS) {
			var html = "<option value=''></option>";
