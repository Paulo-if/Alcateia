	$scope.clienteTagColor = "#ebebeb";
	var colorPicker = new iro.ColorPicker("#pickerTagCliente", {
		width: 150,
		color: "#ebebeb",
		borderWidth: 1,
		borderColor: "#fff",
		layout: [{
			component: iro.ui.Wheel,
		}, ]
	});

	colorPicker.on('color:setActive', function (color) {
		$scope.clienteTagColor = color.hexString;
	});
	colorPicker.on('input:end', function (color) {
		$scope.clienteTagColor = color.hexString;
	});

	colorPicker.on('color:change', function (color) {
		$("#tagClienteExemplo").css('background-color', color.hexString);
	});

	$scope.buscaListaTagsClientes = function(pescodigo){
		if (typeof (optTableclienteTag) !== 'undefined') {
			optTableclienteTag.destroy();
		}
		optTableclienteTag = $('#tableTagCliente').DataTable({
			'ajax': {
				'url': '/pages/cadastros/buscaClienteTag.php',
				'method': 'POST',
				'data': function (d) {
					d.pescodigo = pescodigo;
				}
			},
			"scrollX": isPortrait,
			"stateSave": true,

			'columns': [{
					'data': 'CTa_Descricao',
					'title': 'Descrição'
				},
				{
					"data": "CTa_Cor",
					"title": "Cor",
					"render": function (data) {

						return `<i class="fa fa-circle" aria-hidden="true" style="color:${data}"></i>`;
						
					}
				},
				{
					"title":'Remover',
					"class": 'btnRemover',
					"orderable": false,
					"data": null,
					"defaultContent": '<button class="btn btn-danger btn-xs"><i class="fa fa-trash"></i> Remover</button>',
				}
			],
			'ordering': false,
			'searching': false,
			'lenghtChange': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});

		$('#tableTagCliente tbody').on('click', 'td.btnRemover', function () {
			var tr = $(this).closest('tr');
			var row = optTableclienteTag.row(tr);
			var data = row.data();
			swal({
					title: "Excluir",
					text: "Deseja realmente excluir esta tag?",
					type: "warning",
					showCancelButton: true,
					confirmButtonColor: "#DD6B55",
					confirmButtonText: "Sim",
					cancelButtonText: "Não"
				},
				function (Confirmou) {
					if (Confirmou) {
						$.ajax({
							type: "POST",
							url: "/pages/cadastros/removeClienteTag.php",
							data: {
								codigo: row.data().CTa_Codigo
							},
							dataType: "json",
							success: function (result) {
								if (data.data[0].erro == 0) {
									toastr.success(data.data[0].resultado);
									$('#tableTagCliente').dataTable().api().ajax.reload();
								}else{
									toastr.error(data.data[0].resultado);
								}
							},
							error: function (result) {}
						});
					}

				});
		});
	}

	$scope.saveTagCli = function () {
		if($("#tagClienteText").val() != ''){
			if($("#cliCodigoEdt").val() != ''){
				showLoader(true)
				$.ajax({
					dataType: 'json',
					method: 'POST',
					url: '/pages/cadastros/insereClienteTag.php',
					data: {
						pescodigo: $("#cliCodigoEdt").val(),
						cor: $scope.clienteTagColor,
						descricao: $("#tagClienteText").val()
					},
					success: function (data) {
						if (data.data[0].erro == 0) {
							toastr.success(data.data[0].resultado);
							$scope.buscaListaTagsClientes($("#cliCodigoEdt").val())
						} else {
							toastr.error(data.data[0].resultado);
						}
						showLoader(false)
					},
					error: function (result) {
						toastr.error('Falha de conexão');
						showLoader(false)
					}
				});
			}else{
				toastr.error('Favor informe a cor!');
			}
		}else{
			toastr.error('Favor informe a descrição!');
		}
	}

	$scope.reativaPessoaCliente = function (pescodigo) {

		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/reativaPessoa.php',
			data: {
				tipo: 1,
				codigo: pescodigo
			},
			dataType: 'json',
			success: (result) => {
				if (result.data[0].erro == '0') {
					toastr.success(result.data[0].resultado);
					atualizaDados();
					
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: (result) => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
	}

	$scope.sendSenhaSMS = function(){
		showLoader(true);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/CLIENTEEsqueceuSenhaCelular.php",
			data: {
				client_code: $("#cli_codigo_senha_sms").val()
			},
			dataType: "json",
			success: function (data) {
				if (data.data.error == false) {
					toastr.success(data.data.message);
					showLoader(false);
				} else {
					toastr.error(data.data.message);
					showLoader(false);
				}
				//$scope.buscaSolCad();
			},
			error: function (data) {
				console.log('Falha ao inserir Cliente. Erro:' + data);
				showLoader(false);
			}
		});
	}

	$scope.desativaCliente = function(){
		showLoader(true);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/CLIENTEAlteraAcesso.php",
			data: {
				clicodigo: $("#cli_codigo_senha_sms").val(),
				pescodigocliente: $("#pes_codigo_relacao").val(),
				tipo: $("#tipo_cliente_ativo").val()
			},
			dataType: "json",
			success: function (data) {

				if (data.data.result[0].erro == '0' ) {
					toastr.success(data.data.result[0].resultado);

					if($("#tipo_cliente_ativo").val() == 1){
						$("#tipo_cliente_ativo").val(2)
						$("#txtBotaoDesativar").html('Desativar Acesso')
					}else{
						$("#tipo_cliente_ativo").val(1)
						$("#txtBotaoDesativar").html('Reativar Acesso')
					}
					showLoader(false);
				} else {
					toastr.error(data.data.result[0].resultado);
					showLoader(false);
				}
				//$scope.buscaSolCad();
			},
			error: function (data) {
				console.log('Falha ao inserir Cliente. Erro:' + data);
				showLoader(false);
			}
		});
	}
});
