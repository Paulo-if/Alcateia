	$scope.changeCpfCnpjCli = function (tipo) {

		if (tipo == 1) {

			$("#tipocampoCPFCli").val(1)
			$("#btnCpfCnpjCli").html("CPF");
			$("#cliCpf").val('');
			$("#cliCpf").attr('maxlength', '14')
			$("#cliCpf").attr('placeholder', 'CPF')
		} else {

			$("#tipocampoCPFCli").val(2)
			$("#btnCpfCnpjCli").html("CNPJ")
			$("#cliCpf").val('');
			$("#cliCpf").attr('placeholder', 'CNPJ')
			$("#cliCpf").attr('maxlength', '18')
		}
	}

