angular.module('appBeleza').controller("clientesCtrl", function ($rootScope, $compile, $scope, $state, $translate) {

	$rootScope.header = sSistema + " | " + $_CONFIG.language.clientes.breadcrumb;

	changeHeightBody();

	$("#navProf").hide();
	$("#formProf").hide();

	validaPerfil($state.current.name);

	$scope.idCliente = $_CONFIG.ID;

	$scope.dateFormat = $_CONFIG.language.mascaras.data;
	$scope.lang = $_CONFIG.language.mascaras.lang;

	$(".input-group.date").datepicker({
		language: $scope.lang,
		orientation: "bottom",
		autoclose: true,
		format: $scope.dateFormat
	});

	$('[data-inputmask]').inputmask();

	var datafim = moment().locale($scope.lang).format("L");
	var dataini = moment().add(-30, "days").locale($scope.lang).format("L");

	$scope.submitCadastro = true;
	$scope.submitEditar = true;
	$scope.submitAlteraSenha = true;
	$scope.submitAddPontos = true;
	$scope.submitRemovePontos = true;
	$scope.hasPrime = false;

	$scope.thisrow = '';
	$('.date.divDataIniAge').datepicker('update', dataini);
	$('.date.divDataFimAge').datepicker('update', datafim);
	$('.date.divDataIniCom').datepicker('update', dataini);
	$('.date.divDataFimCom').datepicker('update', datafim);
	$('.date.divDataIniPac').datepicker('update', datafim);
	$('.date.divDataFimPac').datepicker('update', datafim);

	if ($_CONFIG.TEMPOPADRAO != undefined && $_CONFIG.TEMPOPADRAO != '') {
		var tempo = parseInt($_CONFIG.TEMPOPADRAO);
		for (var i = tempo; i <= 360; i = i + tempo) {
			$('#clienteServicoTempo').append('<option value="' + i + '">' + i + ' ' + $_CONFIG.language.minutos + '</option>');
			$('#clienteServicoTempoEdt').append('<option value="' + i + '">' + i + ' ' + $_CONFIG.language.minutos + '</option>');

		};
		$('.timepicker').timepicker({
			'timeFormat': 'H:i',
			'forceRoundTime': true,
			'step': tempo
		});
	} 

	$scope.buscaProfissionalCombo = function () {
		var profissional = "";
		$.ajax({
			dataType: "json",
			async: false,
			url: 'pages/cadastros/buscaProfissionalSelect.php',
			data: {},
			success: function (data) {
				profissional += '<option  value="">Selecione um Profissional</option>';
				for (var i = 0; i < data.profissionais.length; i++) {
					var codigo = data.profissionais[i].Pes_Codigo;
					var nome = data.profissionais[i].Pes_Nome;
					profissional += '<option  value="' + codigo + '">' + nome + '</option>';
				}
				$("#cliProfAdi").html(profissional);
				$("#cliProfAdiEdt").html(profissional);
				$("#cliProfCom").prop("disabled", true);
				$("#cliProfCom").val("");
				$("#cliProfComEdt").prop("disabled", true);
				$("#cliProfComEdt").val("");
			}
		});
	}


	$scope.buscaPessoaModulo = function () {
		$.ajax({
			dataType: "json",
			async: false,
			url: 'pages/cadastros/buscaPessoaModulo.php',
			data: {},
			success: function (data) {
				if (data.data.length > 0) {
					for (var i = 0; i < data.data.length; i++) {
						if((data.data[i].TipoRel == 3)){
							$scope.hasPrime = true;
						}
					}
				}
			}
		});
	}

	$scope.buscaPessoaModulo();

	$scope.buscaServicoCombo = function () {
		var servico = "";
		$.ajax({
			dataType: "json",
			async: false,
			url: 'pages/cadastros/buscaServicoSelect.php',
			data: {},
			success: function (data) {
				servico += '<option  value="">Selecione um Servico</option>';
				for (var i = 0; i < data.servicos.length; i++) {
					var codigo = data.servicos[i].Ser_Codigo;
					var nome = data.servicos[i].Ser_Descricao;
					servico += '<option  value="' + codigo + '">' + nome + '</option>';
				}
				$("#clienteServico").html(servico);

			}
		});

	}

	$("#cliProfAdi").change(function () {
		if ($("#cliProfAdi option:selected").val() == "") {
			$("#cliProfCom").val("");
			$("#cliProfCom").prop("disabled", true);
		} else {
			$("#cliProfCom").prop("disabled", false);
		}
	});

	$("#cliProfAdiEdt").change(function () {
		if ($("#cliProfAdiEdt option:selected").val() == "") {
			$("#cliProfComEdt").val("");
			$("#cliProfComEdt").prop("disabled", true);
		} else {
			$("#cliProfComEdt").prop("disabled", false);
		}
	});

