							if (pais != "2") {
								html += "<option id='" + data.result[i].Est_Sigla + "' value='" + data.result[i].Est_Codigo + "'> " + data.result[i].Est_Nome + "</option>";
							} else {
								html += "<option id='" + data.result[i].Est_Nome.replace(" ", "").toLowerCase() + "' value='" + data.result[i].Est_Codigo + "'> " + data.result[i].Est_Nome + "</option>";
							}
						}
					}
					$("#cliEstado").html(html);
					$("#cliEstadoEdt").html(html);
				}
			});
		/*}*/
	}

	$('#formCadastro').submit(function (event) {
		if ($scope.submitCadastro) {
			if (($("#cliLoginId").val() != "") && ($("#cliEmail").val() == "")) {
				toastr.error($_CONFIG.language.errors.insira_email, $_CONFIG.language.errors.insira_email_valido);
				return true;
			} else if ($("#cliEmail").val() != "" && !validarEmail($("#cliEmail").val())) {
				toastr.error($_CONFIG.language.errors.insira_email_valido);
				return true;
			} else {
				event.preventDefault();

				$scope.submitCadastro = false;

				formCadastro = $(this);
				showLoader(true);
				dataInsere = new FormData(this);
				dataInsere.append("apelido", $("#cliApelido").html());
				dataInsere.append('imagemcli', mBlob);

				if (dataInsere.delete != undefined) {
					dataInsere.delete('cliFoto');
				}

				$.ajax({
					type: "POST",
					url: "/pages/cadastros/insereClientes.php",
					data: dataInsere,
					dataType: "json",
					processData: false,
					contentType: false,
					success: function (result) {
						$scope.submitCadastro = true;
						if (result.insereCliente[0].erro == "0") {
							if (tabelaCli.row().length < 2000) {
								atualizaDados();
							}
							$scope.cliLogin = "";
							toastr.success(result.insereCliente[0].resultado);
							$('#cadastrar-modal').modal("hide");
							formCadastro.each(function () {
								this.reset();
							});
							mBlob = '';
							$('.date.dataNascimento').datepicker('update', '');
						} else {
							toastr.error(result.insereCliente[0].resultado);
						}
						showLoader(false);
					},
					error: function (result) {
						$scope.submitCadastro = true;
						toastr.error($_CONFIG.language.errors.falha_conexao);
						showLoader(false);
					}
				});
				return true;
			}
		}
	});

	$('#formEditar').submit(function (event) {
		if ($scope.submitEditar) {

			event.preventDefault();
			$scope.submitEditar = false;
			showLoader(true);
			dataAltera = new FormData(this)
			dataAltera.append('blob', mBlob);
			$.ajax({
				type: "POST",
				//url: "/pages/cadastros/alteraClientesv2.php",
				url: "/pages/cadastros/alteraClientesv3.php",
				data: dataAltera,
				dataType: "json",
				processData: false,
				contentType: false,
				success: function (result) {

					$scope.submitEditar = true;
					if (result.data[0].erro == "0") {
						toastr.success(result.data[0].resultado);
						if (tabelaCli.rows().length < 2000) {
							atualizaDados();
						}

					} else {
						toastr.error(result.data[0].resultado);
					}
					showLoader(false);
				},
				error: function () {
					$scope.submitEditar = true;

					toastr.error($_CONFIG.language.errors.falha_conexao);
					showLoader(false);
				}
			});
			return true;
		}

	});

	$('#formAlteraSenha').submit(function (event) {
		if ($scope.submitAlteraSenha) {

			var proceed = 0;
			if (($('#usuarioAltLbl').html() == "") && ($("#cliEmailEdt").val() == "")) {
				toastr.error($_CONFIG.language.errors.insira_email_valido, $_CONFIG.language.errors.insira_email);
				return true;
			} else {
				event.preventDefault();
				$scope.submitAlteraSenha = false;
				formAlteraSenha = $(this);
				var dados = new FormData(this);
				dados.append("tipo", "2");
				showLoader(true);

				$.ajax({
					type: "POST",
					url: "/pages/cadastros/alteraClientesv2.php",
					data: {
						cliCodigoEdt: $("#pesCodigoAlt").val(),
						cliNomeEdt: $("#pesnomealterasenha").val(),
						cliEmailEdt: $("#usuarioAlt").val(),
						cliCelularEdt: $("#pescelularalterasenha").val(),
						cliRGEdt: "",
						cliCpfEdt: "",
						cliSexoEdt: "",
						cliDataNascimentoEdt: "",
						cliTelefoneEdt: "",
						cliEnderecoEdt: "",
						cliNumeroEdt: "",
						cliComplementoEdt: "",
						cliCepEdt: "",
						cliBairroEdt: "",
						cliObservacaoEdt: "",
						cliCidadeEdt: "",
						cliApelidoEdt: ""
					},
					dataType: "json",

					async: "false",

					success: function (result) {
						if (result.data[0].erro == "0") {

							$.ajax({
								type: "POST",
								url: "/pages/cadastros/alteraSenha.php",
								data: dados,
								dataType: "json",
								processData: false,
								contentType: false,
								success: function (result) {
									$scope.submitAlteraSenha = true;
									if (result.result[0].erro == "0") {
										toastr.success(result.result[0].resultado);
										atualizaDados();
										$('#editar-modal').modal("hide");
										$("#senhaAlt").val("");
										$("#usuarioAlt").val("");
										$("#usuarioAltLbl").html("");
									} else {
										toastr.error(result.result[0].resultado);
									}
									showLoader(false);
								},
								error: function (result) {
									$scope.submitAlteraSenha = true;
									toastr.error($_CONFIG.language.errors.falha_conexao);
									showLoader(false);
								}
							});
							return true;

						} else {
							$scope.submitAlteraSenha = true;
							toastr.error(result.data[0].resultado);
							proceed = 0
							showLoader(false);
							return false
						}
					},
					error: function (result) {
						$scope.submitAlteraSenha = true;
						toastr.error($_CONFIG.language.errors.falha_conexao);
						showLoader(false);
						proceed = 0
						return false
					}
				});

			}
		}
	});

	$("#cliEstado").change(function () {
		var estado = this.value;
		$("#cliCidade").empty();
		if (estado === -1) {
			$("#cliCidade").attr("disabled", true);
		} else {
			$.ajax({
				dataType: "html",
				url: '/pages/cadastros/buscaCidades.php',
				method: "POST",
				data: {
					estCodigo: estado
				},
				success: function (data) {
					$("#cliCidade").append(data);
					$("#cliCidade").attr("disabled", false);
				}
			});
		}
	});

	$("#cliEstadoEdt").change(function () {
		var estado = this.value;
		$("#cliCidadeEdt").empty();
		if (estado === -1) {
			$("#cliCidadeEdt").attr("disabled", true);
		} else {
			$.ajax({
				dataType: "html",
				url: '/pages/cadastros/buscaCidades.php',
				method: "POST",
				data: {
					estCodigo: estado
				},
				success: function (data) {
					$("#cliCidadeEdt").append(data);
					$("#cliCidadeEdt").attr("disabled", false);
				}
			});
		}
	});

	$translate('mascaras.celular')
		.then(function (value) {
			if (value != '') {
				$('#cliCelular').mask(value);
			}
		});

	$translate('mascaras.telefone')
		.then(function (value) {
			if (value != '') {
				$('#cliTelefone').mask(value);
				$('#cliTelefoneEdt').mask(value);
			}
		});

	$scope.editarCliente = function (registroTabela) {
		$scope.limpaLoginSenha();
		$scope.buscaServicoCombo();

		$('#cliNomeEdt').val(registroTabela.Nome);
		$('#pesnomealterasenha').val(registroTabela.Nome);
		

		if ((registroTabela.CPF).length <= 14) {
			$("#tipocampoCPFCliEdt").val(1)
			$scope.changeCpfCnpjCliEdt(1)
		} else {
			$("#tipocampoCPFCliEdt").val(2)
			$scope.changeCpfCnpjCliEdt(2)
		}
		$('#cliCpfEdt').val(registroTabela.CPF);
		$('#cliEmailEdt').val(registroTabela.Email);
		$('#cliCelularEdt').val(registroTabela.Celular);
		$('#cliDialCodeEdt').val(registroTabela.DDI);
		$scope.geraComboPaisTelefone('cliCelularEdt', 'cliDialCodeEdt', registroTabela.DDI)
		$('#pescelularalterasenha').val(registroTabela.Celular);
		$('#cliTelefoneEdt').val(registroTabela.Telefone);
		$('#usuarioAlt').val(registroTabela.Email);

		$('#cliAbreviaturaAlt').show(registroTabela.Email);

		if (registroTabela.Login == "") {
			$('#usuarioAltLbl').html("");
		} else {
			var typelogincolor = 'black';
			if (registroTabela.Login == 'E-mail') {
				typelogincolor = 'green';
			} else if (registroTabela.Login == 'Facebook') {
				typelogincolor = 'blue';
			} else if (registroTabela.Login == 'Desativado') {
				typelogincolor = 'red';
			} else if (registroTabela.Login == 'Não Possui') {
				typelogincolor = 'orange';
			} else {
				typelogincolor = 'green';
			}

			$('#usuarioAltLbl').html('<b style="color:black">' + $_CONFIG.language.login + ":</b> <span style='color:" + typelogincolor + "'>" + registroTabela.Login + '</span>');
		}

		$('#cliSexoEdt').val(registroTabela.Sexo);
		
		$('#cliDataNascimentoEdt').val(registroTabela.Nascimento);
		$('#cliEnderecoEdt').val(registroTabela.Endereco);
		$('#cliBairroEdt').val(registroTabela.Bairro);
		
		//$('#cliEstadoEdt').val(registroTabela.Estado);
		$('#cliCepEdt').val(registroTabela.Cep);
		$('#cliCodigoEdt').val(registroTabela.Codigo);
		$('#cliEstadoEdt').val(registroTabela.EstCodigo);
		$('#pesCodigoAlt').val(registroTabela.Codigo);
		$('#usuCodigo').val(registroTabela.UsuCodigo);
		$('#cliObservacaoEdt').val(registroTabela.Obs);
		$('#cliComplementoEdt').val(registroTabela.Complemento);
		$('#cliNumeroEdt').val(registroTabela.Numero);
		$('#lblPontos').html(registroTabela.Pontos);
		$("#pesCodigoPonto").val(registroTabela.Codigo);
		$("#pesCodigoPontoRemove").val(registroTabela.Codigo);
		$("#cliDataExpiracao").val(registroTabela.DataExpiracao);
		$("#pesCodigoToken").val(registroTabela.Codigo);
		$("#cliTentativas").val(registroTabela.NumTentativas);
		$("#cliRGEdt").val(registroTabela.RG);
		$("#cliIEEdt").val(registroTabela.PAF_IE);
		$("#cliIMEdt").val(registroTabela.PAF_IM);
		$('#cliCodigoEdt').val(registroTabela.Codigo);
		if(registroTabela.Pai_Codigo != ''){
			$("#cliPaisEdt").val(registroTabela.Pai_Codigo).change();
		}else{
			$("#cliPaisEdt").val($_CONFIG.PAIS);
		}
		setTimeout(function(){
			$('#cliEstadoEdt').val(registroTabela.EstCodigo);
			setTimeout(function(){
				$('#cliCidadeEdt').val(registroTabela.CidCodigo);
			},1000)
		},1000)

		$("#cliCidadeEdt").empty();
		if (registroTabela.Imagem != undefined && registroTabela.Imagem != "") {
			$("#cliImagemEdit").attr('src', registroTabela.Imagem)
		} else {
			$("#cliImagemEdit").attr('src', '../../img/nopicture.png')

		}
		$("#cliProfAdiEdt").val(registroTabela.ProfissionalComissao);
		$("#cliProfAdiEdt").change();
		$("#cliProfComEdt").val(registroTabela.AdicionalComissao)
		$("#cliOndeEdt").val(registroTabela.ComoSoube)
		$("#cliApelidoEdt").val(registroTabela.Apelido);
		if (registroTabela.SituacaoUsuario == "") {
			$("#btnDesativaUsuarioCliente").show();
			$("#btnReativaUsuarioCliente").hide();
			$("#acessoClientesAltera").show();
		} else {
			$("#btnDesativaUsuarioCliente").hide();
			$("#btnReativaUsuarioCliente").show();
			$("#acessoClientesAltera").hide();
		}
		if (registroTabela.Login == "Não Possui") {
			$("#btnDesativaUsuarioCliente").hide();
			$("#btnReativaUsuarioCliente").hide();
			$("#acessoClientesAltera").hide();
		} else if (registroTabela.Login == "Desativado") {
			$("#btnDesativaUsuarioCliente").hide();
			$("#btnReativaUsuarioCliente").show();
			$("#acessoClientesAltera").hide();
		}

		$.ajax({
			dataType: "html",
			url: '/pages/cadastros/buscaCidades.php',
			method: "POST",
			data: {
				estCodigo: registroTabela.EstCodigo
			},
			success: function (data) {
				$("#cliCidadeEdt").append(data);
				$("#cliCidadeEdt").attr("disabled", false);
				$('#cliCidadeEdt').val(registroTabela.CidCodigo);
			}
		});
		$scope.buscaServicoCliente(registroTabela.Codigo)
		$scope.buscaListaTagsClientes(registroTabela.Codigo)

		$("#pes_codigo_relacao").val(registroTabela.Codigo);
		$("#tipo_cliente_ativo").val(2);

		if(registroTabela.PRe_Ativo == 2){
			$("#tipo_cliente_ativo").val(1)
			$("#txtBotaoDesativar").html('Reativar Acesso')
			
		}else{
			
			$("#tipo_cliente_ativo").val(2)
		}
		if(registroTabela.Cli_Codigo != '' && !$scope.hasPrime){
			$("#cli_codigo_senha_sms").val(registroTabela.Cli_Codigo)
			$("#client_name").html(`Nome: ${registroTabela.Cli_Nome}`)
			$("#client_phone").html(`Celular: ${registroTabela.Cli_Celular}`)
			if(registroTabela.Cli_Imagem != ''){
				$("#imagem_cliente_app").css('background-image',`url('${registroTabela.Cli_Imagem}')`)
			}else{
				$("#imagem_cliente_app").css('background-image',`url(../../img/noPicture.png`)
			}
			$("#navigationUsuCliente").hide()
			$("#navigationCliDados").show()
			$("#navigationCliCadastro").hide()
			$("#infoClienteAcessoList").html('');
			$.ajax({
				type: "POST",
				url: "/pages/cadastros/CLIENTEBuscaAcessoLista.php",
				data: {
					client_code: registroTabela.Cli_Codigo
				},
				dataType: "json",
				success: function (data) {
					if (data.data.error == false) {
						if(data.data.customer.length > 0){
							for (var i = 0; i < data.data.customer.length; i++) {
								if(data.data.customer[i].TLg_Codigo == 1){
									$("#infoClienteAcessoList").append(`<span  data-toggle="tooltip" title="${data.data.customer[i].login_email}" data-content="${data.data.customer[i].login_email}" class="info-box-icon " style="border-radius: 50px;width: 30px;height: 30px; margin-right:10px; background-image: url('../../img/_3573152.svg');background-repeat: no-repeat;background-size: contain;background-color:#f2f2f2"></span>`)
								}else if(data.data.customer[i].TLg_Codigo == 2 || data.data.customer[i].TLg_Codigo == 3){
									$("#infoClienteAcessoList").append(`<span data-toggle="tooltip" title="${data.data.customer[i].login_email}" data-content="${data.data.customer[i].login_email}" class="info-box-icon" style="border-radius: 50px;width: 30px;height: 30px; margin-right:10px; background-image: url('../../img/facebook_1384005.svg');background-repeat: no-repeat;background-size: contain;background-color:#f2f2f2"></span>`)
								}else if(data.data.customer[i].TLg_Codigo == 4){
									$("#infoClienteAcessoList").append(`<span data-toggle="tooltip" title="${data.data.customer[i].login_email}" data-content="${data.data.customer[i].login_email}" class="info-box-icon" style="border-radius: 50px;width: 30px;height: 30px; margin-right:10px; background-image: url('../../img/apple-logo_747.svg');background-repeat: no-repeat;background-size: contain;background-color:#f2f2f2"></span>`)
								}else if(data.data.customer[i].TLg_Codigo == 5){
									$("#infoClienteAcessoList").append(`<span data-toggle="tooltip" title="${data.data.customer[i].login_email}" data-content="${data.data.customer[i].login_email}" class="info-box-icon" style="border-radius: 50px;width: 30px;height: 30px; margin-right:10px; background-image: url('../../img/google_104093.svg');background-repeat: no-repeat;background-size: contain;background-color:#f2f2f2"></span>`)
								}
							}
						}
					} else {
						toastr.error(data.data.message);
					}
					//$scope.buscaSolCad();
				},
				error: function (data) {
					console.log('Falha ao inserir Cliente. Erro:' + data);
					showLoader(false);
				}
			});
			$compile($('#infoClienteAcessoList'))($scope);

		}else{
			$("#cli_codigo_senha_sms").val('')
			$("#imagem_cliente_app").css('background-image',`url(../../img/noPicture.png`)
			$("#client_name").html('')
			$("#client_phone").html('')
			$("#navigationUsuCliente").show()
			$("#navigationCliDados").hide()
			if(registroTabela.Login == 'Não Possui' && !$scope.hasPrime){
				$("#navigationCliDados").hide()
				$("#navigationUsuCliente").hide()
				$("#navigationCliCadastro").show()

				var datahtmlshort = `<button class="btn btn-primary btnCopyLinkApp btn-block" data-clipboard-text="https://sites.appbarber.com.br/link/${$_CONFIG.CODESTABELECIMENTO}/${$_CONFIG.APELIDOESTABELECIMENTO}" ><i class="fa fa-download" alt="Copiar"></i> Copiar Link de Download</button>
				<button class="btn btn-success  btn-block" id="btnSendWhatsCliente" ng-click="sendDownloadApp('${registroTabela.Celular}','https://sites.appbarber.com.br/link/${$_CONFIG.CODESTABELECIMENTO}/${$_CONFIG.APELIDOESTABELECIMENTO}')"><i class="fa fa-whatsapp" alt="Copiar"></i> Enviar link via WhatsApp</button>`;
				$("#divBtnLinkApp").html(datahtmlshort)
				var clipboard = new ClipboardJS('.btnCopyLinkApp');
				clipboard.on('success', function (e) {
					toastr.success("Copiado!");
				});
				$compile($('#btnSendWhatsCliente'))($scope);
			}
		}



	}
	$scope.url = 'clientes';
	$scope.infoCliente = function (codigo) {
		$scope.mostraInfoClientes(codigo);
	}


	$scope.sendDownloadApp = function(phone,link){

		var celular = $_CONFIG.language.mascaras.codigopais.replace('+', '') + phone.replace("(", "").replace(")", "").replace(" ", "").replace("-", "");
		sendWhatsReminder(celular, `Baixe agora o AppBarber e realize seu cadastro!\n${link}`);
	}

	$scope.excluir = function (registroTabela, row) {
		$scope.thisrow ='';

		$scope.thisrow = row;
		$("#pesCodigoRemoveCliente1").val(registroTabela.Codigo);
		$("#btnAguardeRemocao").show()
		$("#btnRemoveCliente1").hide()
		$('#removeClienteConfirm1-modal').modal()
		$("#btnCancelar1").css('margin-top','0px')
		var numSegundosCliente = 1;
		var descriptionCliente = 'segundos';
		$("#numSegundosAguardoCliente").html(numSegundosCliente + ' ' + descriptionCliente);
		var t = setInterval(function () {
			numSegundosCliente = numSegundosCliente - 1;
			if (numSegundosCliente == 1) {
				descriptionCliente = 'segundo';
			}
			$("#numSegundosAguardoCliente").html(numSegundosCliente + ' ' + descriptionCliente);
		}, 500);
		setTimeout(function () {
			clearInterval(t);
			$("#btnAguardeRemocao").hide()
			$("#btnRemoveCliente1").show()
			$("#btnCancelar1").css('margin-top','5px')
		}, (numSegundosCliente * 500));

	}

	$("#addPontos").keyup(function () {
