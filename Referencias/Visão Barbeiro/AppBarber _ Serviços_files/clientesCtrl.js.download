			var row = tabelaClienteExcluido.row(tr);
			var data = row.data();


			var codigoCliente = data.Pes_Codigo;

			/*--------------------------*/

			swal({
				title: "Tem certeza que deseja reativar esse cliente?",
				text: "Ao reativar o cliente, caso o mesmo tenha usuário, ele voltará a ter acesso ao aplicativo para agendamento!",
				type: "warning",
				showCancelButton: true,
				confirmButtonColor: "#569c54",
				cancelButtonColor: "#d62d2d",
				confirmButtonText: "Reativar",
