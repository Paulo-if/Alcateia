					type: 'warning',
					showCancelButton: true,
					confirmButtonColor: '#DD6B55',
					confirmButtonText: $_CONFIG.language.sim,
					cancelButtonText: $_CONFIG.language.nao,
					closeOnConfirm: true
				},
				function () {
					showLoader(true);
					$.ajax({
						dataType: 'json',
						method: 'POST',
						url: '/pages/cadastros/removeServicoProduto.php',
						data: {
							sprcodigo: data.SPr_Codigo,
						},
						success: function (data) {
							if (data.data[0].erro == '0') {
								toastr['success'](data.data[0].resultado);
								atualizaDados();
								$('#tbBuscaProdSer').dataTable().api().ajax.reload(function () {
									$compile($('#tbBuscaProdSer'))($scope);
									$('#tbBuscaProdSer_paginate').click(function () {
										$compile($('#tbBuscaProdSer'))($scope);
									});
								});
							} else {
								toastr['error'](data.data[0].resultado);
							}
							showLoader(false);
						},
						error: function (result) {
							toastr.error($_CONFIG.language.errors.falha_conexao);
							showLoader(false);
						}
					});
				});
		});

	}

	$("#qtdProdutoServico").keyup(function () {
		if ($("#qtdProdutoServico").val() < 1) {
			$("#qtdProdutoServico").val(1);
		}
	})


	$('#serValorEdt').change(function () {
		if ($('#serValorEdt').val() != $('#serValorOriginal').val()) {
			$("#divAlteraValor").show()
		} else {
			$("#divAlteraValor").hide()
		}
	})
	$scope.buscaProdutoCombo = function () {
		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/buscaProdutosSelect.php',
			data: {},
			success: function (result) {
				var combo = "";
				combo += '<option value="-1" selected="true">Selecione um Produto</option>';
				for (var i = 0; i < result.buscaProdutos.length; i++) {
					combo += '<option value =' + result.buscaProdutos[i].Pro_Codigo + ' data-valor="' + result.buscaProdutos[i].Pro_Valor + '" data-comissao="' + result.buscaProdutos[i].Pro_Comissao + '" data-qtdminima="' + result.buscaProdutos[i].StatusQtdMinima + '">' + result.buscaProdutos[i].Pro_Descricao + '</option>';
				}
				$("#produtoServico").html(combo);
			}
		});
	}

	$scope.excluir = function (sercodigo, sernome) {
		//var registroTabela = tabelabuscaser.fnGetData(idx);

		swal({
			title: $_CONFIG.language.mensagens.excluir_titulo,
			text: $_CONFIG.language.mensagens.excluir_servico.replace('_NOME_', sernome),
			type: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#DD6B55',
			confirmButtonText: $_CONFIG.language.sim,
			cancelButtonText: $_CONFIG.language.nao,
			closeOnConfirm: true
		}, function () {
			showLoader(true);
			$.ajax({
				dataType: 'html',
				url: '/pages/cadastros/removeServicos.php',
				data: {
					sercodigo: sercodigo
				},
				success: function (data) {
					if (data == '0') {
						toastr.success($_CONFIG.language.mensagens.servico_excluido);
						atualizaDados();
					} else {
						toastr.error(data, $_CONFIG.language.mensagens.falha_excluir);
					}
					showLoader(false);
				},
				error: function (result) {
					toastr.error($_CONFIG.language.errors.falha_conexao);
					showLoader(false);
				}
			});
		});
		$('#serCodigo').html(sercodigo);
	}

	$('#cadastrar-modal').on('hidden.bs.modal', function () {
		$scope.firstTab();
	});

	$scope.avancaTab = function () {
		var $active = $('.servico .nav-tabs li.active');

		$active.next().removeClass('disabled');
		$scope.nextTab($active);
		$('a[data-target="#tab2"]').parent().removeClass('disabledTab');
		$('a[data-target="#tab3"]').parent().removeClass('disabled');
		$('a[data-target="#tab3"]').parent().removeClass('disabledTab');
	}

	$scope.retornaTab = function () {
		var $active = $('.servico .nav-tabs li.active');
		$active.prev().removeClass('disabled');
		$scope.prevTab($active);
	}

	$scope.nextTab = function (elem) {
		$(elem).next().find('a[data-toggle="tab"]').click();
	}

	$scope.prevTab = function (elem) {
		$(elem).prev().find('a[data-toggle="tab"]').click();
	}

	$scope.firstTab = function () {
		//$('#cadastrar-modal a[data-toggle="tab"]:first').click();
		//$('#editar-modal a[data-toggle="tab"]:first').click();
	}

	$('#formAssociaServicoProfissional').submit(function (event) {
		event.preventDefault();
		formAssociacao = $(this);
		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/insereProfissionalServico.php',
			data: {
				spServico: $('#serCodigoAssociacao').val(),
				spProfissional: $('#serCodigoProfissional').val(),
				spComissao: $('#serProfComissao').val()
			},
			dataType: 'json',
			success: function (result) {

				if (result.sucesso > 0) {
					var texto = '<span style="color:green;"><i class="fa fa-check"></i>&nbspInseridos com sucesso:&nbsp' + result.sucesso + '</span>'
				} else {
					var texto = '<span style="color:red;"><i class="fa fa-times"></i>&nbspFalhas ao inserir:&nbsp' + result.falha + '</span>'
				}

				swal({
					title: "<small>Resultado</small>",
					text: texto,
					html: true
				});
				atualizaDados();
				$scope.buscatabelaAssociar();
				formAssociacao.each(function () {
					this.reset();
				});
				$('#serCodigoProfissional').multiselect('deselectAll', false);
				$('#serCodigoProfissional').multiselect('updateButtonText', true);
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
		return true;
	});

	$('#formEditaServicoProfissional').submit(function (event) {
		event.preventDefault();
		formEdtAssociacao = $(this);
		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/alteraServicoProfissionalv2.php',
			data: {
				psecodigo: $('#serCodigoServicoProfissionalEdt').val(),
				comissao: $('#serProfComissaoEdt').val(),
				temposervico: $('#serIntervaloProf').val(),
				valor: $('#spValorser').val()
			},
			dataType: 'json',
			success: function (result) {
				if (result.result[0].erro == '0') {
					atualizaDados();
					toastr.success($_CONFIG.language.mensagens.alterado_com_sucesso);
					$('#editarServicoProfissional-modal').modal('hide');
					formEdtAssociacao.each(function () {
						this.reset();
					});
					$('#tbBuscaSerProf').dataTable().api().ajax.reload(function () {
						$compile($('#tbBuscaSerProf'))($scope);
						$('#tbBuscaSerProf_paginate').click(function () {
							$compile($('#tbBuscaSerProf'))($scope);
						});
					});
				} else if (result.result[0].erro == '2') {
					atualizaDados();
					toastr.warning(result.result[0].resultado);
					$('#editarServicoProfissional-modal').modal('hide');
					formEdtAssociacao.each(function () {
						this.reset();
					});
					$('#tbBuscaSerProf').dataTable().api().ajax.reload(function () {
						$compile($('#tbBuscaSerProf'))($scope);
						$('#tbBuscaSerProf_paginate').click(function () {
							$compile($('#tbBuscaSerProf'))($scope);
						});
					});
				} else {
					toastr.error(result.result[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		return true;
	});

