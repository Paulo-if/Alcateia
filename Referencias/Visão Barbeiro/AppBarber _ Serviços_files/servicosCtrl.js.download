	var tabelaCrossSellingItem;
	var requisicaoItensCrossSelling;

	$scope.atualizaCamposCrossSelling = function (type, editing) {
		var isProduct = String(type) === '2';
		var prefix = editing ? 'crossSellingEdit' : 'crossSelling';
		var $valueColumn = $('#' + prefix + 'Value').closest('.col-md-4, .col-md-6');
		var $intervalColumn = $('#' + prefix + 'Interval').closest('.col-md-4, .col-md-6');
		var $commissionColumn = $('#' + prefix + 'Commission').closest('.col-md-4, .col-md-6');

		$intervalColumn.toggle(!isProduct);
		$('#' + prefix + 'Interval').prop('disabled', isProduct);
		$valueColumn.removeClass('col-md-4 col-md-6').addClass(isProduct || editing ? 'col-md-6' : 'col-md-4');
		if (!editing) {
			$commissionColumn.removeClass('col-md-4 col-md-6').addClass(isProduct ? 'col-md-6' : 'col-md-4');
		}

		if (isProduct) {
			$('#' + prefix + 'Interval').val('');
		}
	}

	$scope.montaFiltroItensCrossSelling = function (itens) {
		var item = $('#crossSellingItem');
		if (item.data('select2')) {
			item.select2('destroy');
		}
		item.html(itens);
		item.select2({
			width: '100%'
		});
	}

	$scope.carregaItensCrossSelling = function () {
		var tipoItem = $('#crossSellingType').val();
		if (requisicaoItensCrossSelling) {
			requisicaoItensCrossSelling.abort();
		}

		if (tipoItem == '1') {
			requisicaoItensCrossSelling = $.ajax({
				dataType: 'json',
				url: '/pages/cadastros/buscaServicoSelect.php',
				data: {},
				success: function (data) {
					if ($('#crossSellingType').val() != tipoItem) {
						return;
					}
					var itens = '<option value="" selected>Selecione um Serviço</option>';
					for (var i = 0; i < data.servicos.length; i++) {
						itens += '<option value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>';
					}
					$scope.montaFiltroItensCrossSelling(itens);
				}
			});
		} else {
			requisicaoItensCrossSelling = $.ajax({
				dataType: 'json',
				url: '/pages/cadastros/buscaProdutosSelect.php',
				data: {},
				success: function (data) {
					if ($('#crossSellingType').val() != tipoItem) {
						return;
					}
					var itens = '<option value="" selected>Selecione um Produto</option>';
					for (var i = 0; i < data.buscaProdutos.length; i++) {
						itens += '<option value="' + data.buscaProdutos[i].Pro_Codigo + '">' + data.buscaProdutos[i].Pro_Descricao + '</option>';
					}
					$scope.montaFiltroItensCrossSelling(itens);
				}
			});
		}
	}

	$scope.limpaCrossSelling = function () {
		$('#formCrossSellingItem')[0].reset();
		$('#crossSellingSubmit').html('<i class="fa fa-plus"></i>&nbspAdicionar');
		$scope.atualizaCamposCrossSelling($('#crossSellingType').val(), false);
		$scope.carregaItensCrossSelling();
	}

	$scope.iniciaCrossSelling = function (service_code) {
		$('#crossSellingInterval').html($('#serIntervaloEdt').html());
		$('#crossSellingEditInterval').html($('#serIntervaloEdt').html());
		$scope.limpaCrossSelling();
		$scope.buscaCrossSellingItens(service_code);
	}

	$scope.buscaCrossSellingItens = function (service_code) {
		if (typeof (tabelaCrossSellingItem) !== 'undefined') {
			$('#tbCrossSellingItem tbody').unbind('click');
			tabelaCrossSellingItem.destroy();
		}

		tabelaCrossSellingItem = $('#tbCrossSellingItem').DataTable({
			'ajax': {
				'url': '/pages/cadastros/CROSS_SELLING_ITEM_Busca.php',
				'method': 'POST',
				'data': function (d) {
					d.service_code = service_code;
				}
			},
			'scrollX': isPortrait,
			'autoWidth': false,
			'columns': [
				{
					'data': 'cross_selling_item_name',
					'width': '56%',
					'title': 'Item'
				},
				{
					'data': 'cross_selling_item_value',
					'width': '15%',
					'title': 'Valor'
				},
				{
					'data': 'cross_selling_item_commission',
					'width': '15%',
					'title': 'Comissão'
				},
				{
					'class': 'updateCrossSellingItem',
					'orderable': false,
					'data': null,
					'width': '7%',
					'defaultContent': '<button class="btn btn-success btn-xs"><i class="fa fa-pencil"></i></button>'
				},
				{
					'class': 'removeCrossSellingItem',
					'orderable': false,
					'data': null,
					'width': '7%',
					'defaultContent': '<button class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></button>'
				}
			],
			'ordering': false,
			'searching': false,
			'lengthChange': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});

		$('#tbCrossSellingItem tbody').on('click', 'td.updateCrossSellingItem', function () {
			var tr = $(this).closest('tr');
			var row = tabelaCrossSellingItem.row(tr);
			var item = row.data();

			$('#crossSellingEditItemCode').val(item.cross_selling_item_code);
			$('#crossSellingEditInterval').val(item.cross_selling_item_interval);
			$('#crossSellingEditReturningTime').val(item.cross_selling_item_returning_time);
			$('#crossSellingEditValue').val(item.cross_selling_item_value);
			$('#crossSellingEditCommission').val(item.cross_selling_item_commission);
			$('#crossSellingEditItemName').val(item.cross_selling_item_name);
			$('#crossSellingEditItemType').val(item.cross_selling_item_type || '');
			$scope.atualizaCamposCrossSelling(item.cross_selling_item_type, true);
			$('#editarCrossSellingItem-modal').modal();
		});

		$('#tbCrossSellingItem tbody').on('click', 'td.removeCrossSellingItem', function () {
			var tr = $(this).closest('tr');
			var row = tabelaCrossSellingItem.row(tr);
			var item = row.data();

			swal({
				title: 'Excluir',
				text: 'Deseja realmente excluir este serviço extra?',
				type: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: 'Sim',
				cancelButtonText: 'Não'
			}, function (confirmou) {
				if (confirmou) {
					showLoader(true);
					$.ajax({
						type: 'POST',
						url: '/pages/cadastros/CROSS_SELLING_ITEM_Remove.php',
						data: {
							cross_selling_item_code: item.cross_selling_item_code
						},
						dataType: 'json',
						success: function (data) {
							if (data.data && data.data.error === false && data.data.cross_selling_item[0].error == 0) {
								toastr.success(data.data.cross_selling_item[0].result);
								$scope.limpaCrossSelling();
								$scope.buscaCrossSellingItens(service_code);
							} else {
								toastr.error(data.data && data.data.cross_selling_item ? data.data.cross_selling_item[0].result : $_CONFIG.language.errors.falha_conexao);
							}
							showLoader(false);
						},
						error: function () {
							toastr.error($_CONFIG.language.errors.falha_conexao);
							showLoader(false);
						}
					});
				}
			});
		});
	}

	$('#crossSellingType').change(function () {
		$scope.atualizaCamposCrossSelling($(this).val(), false);
		$scope.carregaItensCrossSelling();
	});

	$('#formCrossSellingItem').submit(function (event) {
		event.preventDefault();

		var serviceCode = $('#serCodigoEdt').val();
		var value = $('#crossSellingValue').val().replace(',', '.');
		var commission = $('#crossSellingCommission').val().replace(',', '.');
		var isProduct = $('#crossSellingType').val() == '2';
		var data = {
			type: $('#crossSellingType').val(),
			item: $('#crossSellingItem').val(),
			value: value,
			interval: isProduct ? '' : $('#crossSellingInterval').val(),
			returning_time: '',
			service_code: serviceCode,
			product_code: '',
			package_code: '',
			commission: commission,
			combo_code: ''
		};

		if (serviceCode == '') {
			toastr.warning('Selecione um serviço para gerenciar os serviços extras.');
			return false;
		}

		if (data.item == '') {
			toastr.warning('Informe o Item.');
			return false;
		}
		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/CROSS_SELLING_ITEM_Insere.php',
			data: data,
			dataType: 'json',
			success: function (result) {
				var response = result.data;
				if (response && response.error === false && response.cross_selling_item && response.cross_selling_item[0].error == 0) {
					toastr.success(response.cross_selling_item[0].result);
					$scope.limpaCrossSelling();
					$scope.buscaCrossSellingItens(serviceCode);
				} else {
					var mensagemErro = $_CONFIG.language.errors.falha_conexao;
					if (response && response.message) {
						mensagemErro = response.message;
					} else if (response && response.cross_selling_item && response.cross_selling_item[0]) {
						mensagemErro = response.cross_selling_item[0].result;
					}
					toastr.error(mensagemErro);
				}
				showLoader(false);
			},
			error: function () {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		return false;
	});

	$('#formCrossSellingItemEdit').submit(function (event) {
		event.preventDefault();

		var serviceCode = $('#serCodigoEdt').val();
		var isProduct = $('#crossSellingEditItemType').val() == '2';
		var data = {
			cross_selling_item_code: $('#crossSellingEditItemCode').val(),
			value: $('#crossSellingEditValue').val().replace(',', '.'),
			interval: isProduct ? '' : $('#crossSellingEditInterval').val(),
			returning_time: isProduct ? '' : $('#crossSellingEditReturningTime').val(),
			commission: $('#crossSellingEditCommission').val().replace(',', '.')
		};

		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/CROSS_SELLING_ITEM_Altera.php',
			data: data,
			dataType: 'json',
			success: function (result) {
				var response = result.data;
				if (response && response.error === false && response.cross_selling_item && response.cross_selling_item[0].error == 0) {
					toastr.success(response.cross_selling_item[0].result);
					$('#editarCrossSellingItem-modal').modal('hide');
					$scope.buscaCrossSellingItens(serviceCode);
				} else {
					var mensagemErro = $_CONFIG.language.errors.falha_conexao;
					if (response && response.message) {
						mensagemErro = response.message;
					} else if (response && response.cross_selling_item && response.cross_selling_item[0]) {
						mensagemErro = response.cross_selling_item[0].result;
					}
					toastr.error(mensagemErro);
				}
				showLoader(false);
			},
			error: function () {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		return false;
	});

	
		
});
