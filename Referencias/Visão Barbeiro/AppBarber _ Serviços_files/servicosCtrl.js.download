	$scope.refresh = function () {
		atualizaDados();
	}

	$scope.modalInsMensagemPer = function () {
		$('#mensagemPersonalizada-modal').modal();
	}

	$scope.salvaInsMensagemValor = function () {
		$('#serMenPersonalizada').val($('#serMensagemPer').val())
		$('#mensagemPersonalizada-modal').modal('hide');
	}

	$scope.modalEdtMensagemPer = function () {
		$('#mensagemPersonalizadaEdt-modal').modal();
	}

	$scope.salvaEdtMensagemValor = function () {
		$('#serMenPersonalizadaEdt').val($('#serMensagemPerEdt').val())
		$('#mensagemPersonalizadaEdt-modal').modal('hide');
	}

	$scope.checkDisponivel = function () {
		// $('#dispApresentacao').prop('checked', true);
		$('#dispValorApresentacao').prop('checked', true);
		$('#serCategoria').val("");
	}

	$scope.buscatabelaAssociar = function () {

		if (typeof (tabelaserprofasso) !== 'undefined') {
			tabelaserprofasso.destroy();
		}
		tabelaserprofasso = $('#tabelaserProfAsso').DataTable({
			'ajax': {
				'url': '/pages/cadastros/buscaServicoProfissional_v2.php',
				'method': 'POST',
				'data': function (d) {
					d.sercodigo = $('#serCodigoAssociacao').val();
				}
			},
			'columnDefs': [{
				'targets': [1],
				'visible': false,
				'searchable': false
			}],
			"scrollX": isPortrait,
			'initComplete': function () {
				$compile($('#tabelaserProfAsso'))($scope);
				$('#tabelaserProfAsso_paginate').click(function () {
					$compile($('#tabelaserProfAsso'))($scope);
				});
				$('#tabelaserProfAsso_filter').change(function () {
					$compile($('#tabelaserProfAsso'))($scope);
				});
				$('#tabelaserProfAsso_length').change(function () {
					$compile($('#tabelaserProfAsso'))($scope);
				});
				resizeContent();
			},
			'columns': [{
					'data': 'Pes_Nome_Principal'
				},
				{
					'data': 'PSe_Comissao_Principal'
				}
			],
			'ordering': false,
			'searching': false,
			'lenghtChange': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});
	}

	$scope.buscaCategoria = function () {
		var htmlcategoria = "";
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/buscaCategoria.php",
			dataType: "json",
			data: {
				tipo: 2
			},

			success: function (result) {

				htmlcategoria += "<option value=''>Nenhuma</option>";
				for (var i = 0; i < result.data.length; i++) {
					htmlcategoria += "<option value=" + result.data[i].TCa_Codigo + ">" + result.data[i].TCa_Descricao + "</option>"
				}
				htmlcategoria += "<br>";

				$("#serCategoria").html(htmlcategoria);
				$("#serCategoriaEdt").html(htmlcategoria);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	}

	$("#usaAuxiliarEdt").change(function () {
		if ($(this).val() == "") {
			$("#valAuxiliarEdt").prop('disabled', true);
			$("#hasStandartProf").prop('disabled', true);
			$("#auxiliarPadraoGeralComissao").prop('disabled', true);
		} else {
			$("#valAuxiliarEdt").prop('disabled', false);
			$("#hasStandartProf").prop('disabled', false);
			$("#auxiliarPadraoGeralComissao").prop('disabled', false);
		}
	});

	$scope.buscaCategoria()

	$('#formServicoAuxiliar').submit(function (event) {
		event.preventDefault();
		dataAuxiliar = new FormData(this);
		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/alteraServicoAuxiliar.php',
			data: dataAuxiliar,
			dataType: 'json',
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.data[0].erro == '0') {
					atualizaDados();
					toastr.success(result.data[0].resultado);
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		
		if($("#auxiliarPadraoGeralComissao").val() != '' && $("#usaAuxiliarEdt").val() != undefined){
			$.ajax({
				type: 'POST',
				url: '/pages/cadastros/insereServicoAuxiliar.php',
				data: {
					sercodigo: $("#sercodigoAuxiliar").val(),
					pescodigo:$_CONFIG.CODESTABELECIMENTO,
					comissao:($("#auxiliarPadraoGeralComissao").val()).replace(',','.')
				},
				dataType: 'json',
				success: function (result) {
	
					if (result.data[0] == undefined) {
						toastr.error(result.data.resultado);
					} else {
						if (result.data[0].erro == '0') {
							toastr.success(result.data[0].resultado);
						} else {
							toastr.error(result.data[0].resultado);
						}
					}
					showLoader(false);
				},
				error: function (result) {
					toastr.error($_CONFIG.language.errors.falha_conexao);
					showLoader(false);
				}
			});
		}

		if($("#hasStandartProf").val() == 1 && $("#usaAuxiliarEdt").val() == 1){
			$.ajax({
				type: 'POST',
				url: '/pages/cadastros/insereServicoAuxiliar.php',
				data: {
					sercodigo: $("#sercodigoAuxiliar").val(),
					pescodigo:$("#profissionalPadrao").val(),
					comissao:($("#auxiliarPadraoComissao").val()).replace(',','.')
				},
				dataType: 'json',
				success: function (result) {
	
					if (result.data[0] == undefined) {
						toastr.error(result.data.resultado);
					} else {
						if (result.data[0].erro == '0') {
							toastr.success(result.data[0].resultado);
							if(result.data[0].saucodigo != ''){
								$("#sauCodigo").val(result.data[0].saucodigo)
								$("#divRemoveProfissionalPadrao").show()
							}
							atualizaDados();
						} else {
							toastr.error(result.data[0].resultado);
						}
					}
					showLoader(false);
				},
				error: function (result) {
					toastr.error($_CONFIG.language.errors.falha_conexao);
					showLoader(false);
				}
			});
		}

		return true;
	});


	$scope.buscaProfissionalServicoDesconto = function () {
		var htmlprofissionais = "";
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/buscaServicoProfissional_v2.php",
			dataType: "json",
			data: {
				sercodigo: $('#serCodigoAssociacaoEdt').val()
			},

			success: function (result) {

				htmlprofissionais += "<option value=''>Nenhum</option>";
				for (var i = 0; i < result.data.length; i++) {
					htmlprofissionais += "<option value=" + result.data[i].PSe_Codigo + " data-valor='" + result.data[i].PSe_Vlr_Principal + "'>" + result.data[i].Pes_Nome_Principal + "</option>"
				}
				htmlprofissionais += "<br>";

				$("#profissionalServicoDesconto").html(htmlprofissionais);
				$("#profissionalServicoDesconto").change();
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	}

	$("#profissionalServicoDesconto").change(() => {
		if ($("#profissionalServicoDesconto").val() == '') {
			$("#valorProfissionalDesconto").prop('disabled', true);
			$("#btnInsereDescontoProfissional").prop('disabled', true);
			$("#divValorOriginalProfissional").hide();
		} else {
			$("#valorProfissionalDesconto").prop('disabled', false);
			$("#btnInsereDescontoProfissional").prop('disabled', false);
			$("#divValorOriginalProfissional").show();
			if ($("#profissionalServicoDesconto option:selected").get(0).dataset.valor != '') {
				$("#valorOriginalProfissional").html($_CONFIG.MOEDA + $("#profissionalServicoDesconto option:selected").get(0).dataset.valor)
			} else {
				$("#valorOriginalProfissional").html($_CONFIG.MOEDA + $("#valorServicoPadrao").val());
			}
		}
	});

	$("#valorProfissionalDesconto").keyup(() => {

		var valorori = 0.0;
		if ($("#profissionalServicoDesconto option:selected").get(0).dataset.valor != '') {
			valorori = parseFloat($("#profissionalServicoDesconto option:selected").get(0).dataset.valor.replace(',', '.'))
		} else {
			valorori = parseFloat($("#valorServicoPadrao").val().replace(',', '.'));
		}

		var porcent = 0.0;
		var valordesconto = $("#valorProfissionalDesconto").val()

		if (valordesconto >= valorori) {
			$("#valorProfissionalDesconto").val(valorori.toFixed(2)).change();
			porcent = 0.0;
			$("#descontoProfissionalDesconto").val(porcent.toFixed(2))
		} else {
			porcent = 100 - ((valordesconto * 100) / valorori);
			$("#descontoProfissionalDesconto").val(porcent.toFixed(2));
		}

	});

	$scope.addProfissionalDesconto = function () {
		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/insereServicoDescontoPessoa.php',
			data: {
				sdecodigo: $("#SdeCodigo").val(),
				psecodigo: $("#profissionalServicoDesconto").val(),
				desconto: $("#descontoProfissionalDesconto").val(),
				valor: $("#valorProfissionalDesconto").val()
			},
			dataType: 'json',
			success: function (result) {

				if (result.data[0] == undefined) {
					toastr.error(result.data.resultado);
				} else {

					if (result.data[0].erro == '0') {
						$scope.buscaListaProfissionalServicoDesconto($("#SdeCodigo").val())
						toastr.success(result.data[0].resultado);
					} else {
						toastr.error(result.data[0].resultado);
					}
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
	}

	$scope.buscaListaProfissionalServicoDesconto = function (sdecodigo) {
		if (typeof (listaprofdesconto) !== 'undefined') {
			$('#tabelaProfDesconto tbody').unbind('click')
			listaprofdesconto.destroy();
			$('#tabelaProfDesconto tbody').unbind('click')
		}
		listaprofdesconto = $('#tabelaProfDesconto').DataTable({
			'ajax': {
				'url': '/pages/cadastros/buscaServicoDescontoPessoa.php',
				'method': 'POST',
				'data': function (d) {
					d.sdecodigo = sdecodigo
				}
			},
			"scrollX": isPortrait,

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,
			'columns': [{
					'data': 'Pes_Nome',
					"title": "Profissional",
					"width": '55%'
				},
				{
					'data': 'SDP_Valor',
					"title": "Valor",
					"width": '20%'
				},
				{
					'data': 'SDP_Desconto',
					"title": "Desconto (%)",
					"width": '20%'
				}, {
					'class': 'removedescontoprofissional',
					'orderable': false,
					'title': 'Remover',
					'data': null,
					'defaultContent': "<i class='fa fa-trash' style='cursor:pointer;color:#EF5350';></i>",
					"width": '5%'
				}
			],
			'ordering': false,
			'searching': false,
			'lenghtChange': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});

		$('#tabelaProfDesconto tbody').on('click', 'td.removedescontoprofissional', function () {
			var tr = $(this).closest('tr');
			var row = listaprofdesconto.row(tr);
			var data = row.data();
			var sdecodigobusca = data.SDe_Codigo;
			swal({
					title: "Deseja realmente remover esse desconto",
					type: 'warning',
					showCancelButton: true,
					confirmButtonColor: '#DD6B55',
					confirmButtonText: $_CONFIG.language.sim,
					cancelButtonText: $_CONFIG.language.nao,
					closeOnConfirm: true
				},
				function () {
					showLoader(true);
					$.ajax({
						dataType: 'json',
						method: 'POST',
						url: '/pages/cadastros/removeServicoDescontoPessoa.php',
						data: {
							sdpcodigo: data.SDP_Codigo,
						},
						success: function (data) {
							if (data.data[0].erro == '0') {
								toastr['success'](data.data[0].resultado);
								$scope.buscaListaProfissionalServicoDesconto(sdecodigobusca)
							} else {
								toastr['error'](data.data[0].resultado);
							}
							showLoader(false);
						},
						error: function (result) {
							toastr.error($_CONFIG.language.errors.falha_conexao);
							showLoader(false);
						}
					});
				});
		});
	}


