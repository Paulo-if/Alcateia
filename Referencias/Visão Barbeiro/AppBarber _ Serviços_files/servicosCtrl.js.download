				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
				showLoader(false);
			}
		});

	}

	$scope.editaImagemComboSer = function () {
		$("#cboFotoEdtSer").click();
	}

	$scope.saveImageCombo = function () {
		showLoader(true)
		if (mBlob != undefined) {
			dataaltera = new FormData();
			dataaltera.append('blob', mBlob);
			dataaltera.append('imagem', $('#cboFotoEdtSer')[0].files[0]);
			dataaltera.append('cbocodigo', $('#CBoCodigoEditarSer').val())
			$.ajax({
				dataType: 'json',
				method: 'POST',
				url: '/pages/cadastros/alteraComboImagem.php',
				data: dataaltera,
				processData: false,
				contentType: false,
				success: function (data) {

					if (data.data[0].erro == 0) {
						$('#cboImagemEditSer').attr('src', data.data[0].urlimagem);
						toastr.success(data.data[0].resultado);
						mBlob = "";
						$('#tbBuscaSerCombo').dataTable().api().ajax.reload();

					} else {
						toastr.error(data.data[0].resultado);
					}
					showLoader(false)
				},
				error: function (result) {
					toastr.error('Falha de conexão');
					showLoader(false)
				}
			});
		} else {
			toastr.warning("Ops! Parece que você não concluiu a seleção da nova imagem, nenhuma alteração será feita");
			showLoader(false)
		}
	}

	$scope.removeImagemCombo = function () {
		swal({
				title: 'Deseja realmente remover essa imagem',
				type: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: $_CONFIG.language.sim,
				cancelButtonText: $_CONFIG.language.nao,
				closeOnConfirm: true
			},
			function () {
				showLoader(true)
				dataaltera = new FormData();
				dataaltera.append('imagem', '');
				dataaltera.append('cbocodigo', $('#CBoCodigoEditarSer').val());
				$.ajax({
					dataType: 'json',
					method: 'POST',
					url: '/pages/cadastros/alteraComboImagem.php',
					data: dataaltera,
					processData: false,
					contentType: false,
					success: function (data) {
						if (data.data[0].erro == 0) {
							$("#cboImagemEditSer").attr('src', '../../img/combo_sem_imagem.png')
							toastr.success(data.data[0].resultado);
							$('#tbBuscaSerCombo').dataTable().api().ajax.reload();
						} else {
							toastr.error(data.data[0].resultado);
						}
						showLoader(false)

					},
					error: function (result) {
						toastr.error('Falha de conexão');
						showLoader(false)
					}
				});
			});
	}

	$scope.getOptCombo = function(){
		$("#cadastrarComboSer-modal").modal()
		var padrao = parseInt($_CONFIG.TEMPOPADRAO)
		for (var i = padrao; i <= 360; i = i + padrao) {
			$('#CBITempoSer').append('<option value="' + i + '" >' + i + ' ' + $_CONFIG.language.minutos + '</option>');
		};
	}

	$('#cboImagemSer').fileinput({
		maxFilesNum: 1,
		showPreview: false,
		browseLabel: 'Procurar',
		removeLabel: 'Remover',
		browseIcon: '',
		allowedFileExtensions: ['png', 'jpg', 'jpeg'],
		showUpload: false,
		language: 'pt-BR'
	});



