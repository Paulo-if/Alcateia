angular.module('appBeleza').controller('servicosCtrl', function ($rootScope, $scope, $http, $compile, $state, $translate) {

	$rootScope.header = sSistema + ' | ' + $_CONFIG.language.servicos.breadcrumb;
	$('#navProf').hide();
	$('#formProf').hide();

	changeHeightBody();
	validaPerfil($state.current.name);
	$http.get('/php/buscaSessao.php').
	success(function (data, status, headers, config) {
		$scope.idCliente = data;


		$.ajax({
			dataType: 'json',
			url: localStorage.getItem('host'),
			data: {
				metodo: 'buscaParametro',
				id: $scope.idCliente,
				parcodigo: 5,
				origem: 1
			},
			success: function (data) {
				if (data.result[0] != '') {
					parTempo = data.result[0].PVa_Vlr_Principal;
					var tempo = parseInt(parTempo);
					for (var i = tempo; i <= 360; i = i + tempo) {
						$('#serIntervalo').append('<option value="' + i + '">' + i + ' ' + $_CONFIG.language.minutos + '</option>');
						$('#serIntervaloEdt').append('<option value="' + i + '">' + i + ' ' + $_CONFIG.language.minutos + '</option>');
					};
					$('.timepicker').timepicker({
						'timeFormat': 'H:i',
						'forceRoundTime': true,
						'step': tempo
					});
				} else {
					$('.timepicker').timepicker({
						'timeFormat': 'H:i',
						'forceRoundTime': true,
						'step': 10
					});
				}
			}
		});

		$.ajax({
			dataType: 'json',
			url: localStorage.getItem('host'),
			data: {
				metodo: 'buscaParametro',
				id: $scope.idCliente,
				parcodigo: 55,
				origem: 1
			},
			success: function (data) {
				if (data.result[0] != '') {
					if (data.result[0].PVa_Vlr_Principal == '1') {
						$("#tabAuxiliar").show();
					} else {
						$("#tabAuxiliar").hide();
					}
				} else {
					$("#tabAuxiliar").hide();
				}
			}
		});

		$.ajax({
			dataType: 'json',
			url: localStorage.getItem('host'),
			data: {
				metodo: 'buscaParametro',
				id: $scope.idCliente,
				parcodigo: 59,
				origem: 1
			},
			success: function (data) {
				if (data.result[0] != '') {
					if (data.result[0].PVa_Vlr_Principal == '1') {
						$("#tabExclusAssinatura").show();
					} else {
						$("#tabExclusAssinatura").hide();
					}
				} else {
					$("#tabExclusAssinatura").hide();
				}
			}
		});

		$.ajax({
			dataType: 'json',
			url: localStorage.getItem('host'),
			data: {
				metodo: 'buscaParametro',
				id: $scope.idCliente,
				parcodigo: 80,
				origem: 1
			},
			success: function (data) {
				if (data.result[0] != '') {
					if (data.result[0].PVa_Vlr_Principal == '1') {
						$(".campoCustoServico").show();
						$("#tabProduto").hide();
					} else {
						$(".campoCustoServico").hide();
						$("#tabProduto").show();
					}
				} else {
					$(".campoCustoServico").hide();
					$("#tabProduto").show();
				}
			}
		});


	});

	$('.valorFormat').on('keyup', function (e) {
		formataValorDinheiro(this);
	});

	$('.hora').mask('00:00');

	$('.input-group.date').datepicker({
		language: $_CONFIG.language.mascaras.lang,
		orientation: 'top auto',
		autoclose: true,
		format: $_CONFIG.language.mascaras.data
	});


	var datafim = moment().locale("pt-br").format("L");
	$('.date.divDataAlteracao').datepicker('update', datafim);




	$('#serComissao').on('keyup', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#serComissao').val('100,00');
		} else if (valorcomissao < 0) {
			$('#serComissao').val('0,00');
		}
	});

	$('#serComissao').on('keydown', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#serComissao').val('100,00');
		} else if (valorcomissao < 0) {
			$('#serComissao').val('0,00');
		}
	});

	$('#serComissaoEdt').on('keyup', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#serComissaoEdt').val('100,00');
		} else if (valorcomissao < 0) {
			$('#serComissaoEdt').val('0,00');
		}
	});

	$('#serComissaoEdt').on('keydown', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#serComissaoEdt').val('100,00');
		} else if (valorcomissao < 0) {
			$('#serComissaoEdt').val('0,00');
		}
	});


	$('#serDescValor').on('keyup', function () {
		var valorServico = parseFloat($('#serValorAssociacao').val().replace(',', '.'));
		var desconto = $('#serDescValor').maskMoney('unmasked')[0];
		if (desconto > valorServico) {
			desconto = valorServico;
			$('#serDescValor').maskMoney('mask', valorServico);
		}
		var porcentagem = 100 - ((desconto / valorServico) * 100);
		$('#serDescPerc').val(porcentagem.toFixed(2));
	});

	$('#serDescValorEdt').on('keyup', function () {
		var valorServico = parseFloat($('#serValorFixo').val().replace(',', '.'));
		var desconto = $('#serDescValorEdt').maskMoney('unmasked')[0];
		if (desconto > valorServico) {
			desconto = valorServico;
			$('#serDescValorEdt').maskMoney('mask', valorServico);
		}
		var porcentagem = 100 - ((desconto / valorServico) * 100);
		$('#serDescPercEdt').val(porcentagem.toFixed(2));
	});

	$('#serProfComissaoInsAlt').on('keyup', function () {
		if ($(this).val().length > 5) {
			$('#serProfComissaoInsAlt').val('100,00');
		} else if ($(this).val() < 0) {
			$('#serProfComissaoInsAlt').val('0,00');
		}
	});

	$("#serSimultaneosEdt").keyup(function () {
		if ($("#serSimultaneosEdt").val() < 0) {
			$("#serSimultaneosEdt").val(0);
		}
	})

	$("#serSimultaneos").keyup(function () {
		if ($("#serSimultaneos").val() < 0) {
			$("#serSimultaneos").val(0);
		}
	})

	$('#serProfComissaoEdt').on('keyup', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#serProfComissaoEdt').val('100,00');
		} else if (valorcomissao < 0) {
			$('#serProfComissaoEdt').val('0,00');
		}
	});

	$('#serProfComissaoEdt').on('change', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#serProfComissaoEdt').val('100,00');
		} else if (valorcomissao < 0) {
			$('#serProfComissaoEdt').val('0,00');
		}
	});


	$('#serProfComissaoEdt').on('keydown', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#serProfComissaoEdt').val('100,00');
		} else if (valorcomissao < 0) {
			$('#serProfComissaoEdt').val('0,00');
		}
	});




	$('[data-toggle="popover"]').popover({
		container: 'body'
	});

	$('#serFigura').fileinput({
		maxFilesNum: 1,
		showPreview: false,
		browseLabel: $_CONFIG.language.btn_procurar,
		removeLabel: $_CONFIG.language.btn_remover,
		browseIcon: '',
		language: "pt-BR",
		allowedFileExtensions: ['png', 'jpg', 'jpeg'],
		showUpload: false
	});

	$('#cortaImagemAll-modal').on('hidden.bs.modal', function (e) {
		/*if (mBlob != undefined && mBlob != "") {
			if (location.hash == '#/servicos') {
				if ($("#formid").val() != "#formCadastro") {
					$('#serImagemEdit').attr('src', mImage);
					$scope.saveImage();
				}
			}
		} else {
			if (location.hash == '#/servicos') {
				if ($("#formid").val() != "#formCadastro") {
					$scope.saveImage();
				}
			}
		}
		$("#imagemCutAll").resize();
		$("#imagemCutAll").cropper("reset");
		$(this).data('modal', null);*/

		if (!($("#cadastrar-modal").data('bs.modal') || {}).isShown && !($("#cadastrarComboSer-modal").data('bs.modal') || {}).isShown && ($("#editar-modal").data('bs.modal') || {}).isShown) {
			if (mBlob != undefined && mBlob != "") {
				if (location.hash == '#/servicos') {
					$('#serImagemEdit').attr('src', mImage);
					$scope.saveImage();
				}
			} else {
				if (location.hash == '#/servicos') {
					$scope.saveImage();
				}

			}
			$("#imagemCutAll").resize();
			$("#imagemCutAll").cropper("reset");
		}
		/*--------------------------------------------------------*/
		if (!($("#cadastrar-modal").data('bs.modal') || {}).isShown && !($("#cadastrarComboSer-modal").data('bs.modal') || {}).isShown && !($("#editar-modal").data('bs.modal') || {}).isShown) {
			if (mBlob != undefined && mBlob != "") {
				if (location.hash == '#/servicos') {
					$('#cboImagemEditSer').attr('src', mImage);
					$scope.saveImageCombo();
				}
			} else {
				if (location.hash == '#/servicos') {
					$scope.saveImageCombo();
				}

			}
			$("#imagemCutAll").resize();
			$("#imagemCutAll").cropper("reset");
		}
		/*--------------------------------------------------------*/
	})

	$scope.saveImage = function () {
		showLoader(true)
		if (mBlob != undefined) {
			dataaltera = new FormData();
			dataaltera.append('figura', mBlob);
			dataaltera.append('servico', $('#serCodigoEdt').val())
			$.ajax({
				dataType: 'json',
				method: 'POST',
				url: '/pages/cadastros/alteraServicoImagem.php',
				data: dataaltera,
				processData: false,
				contentType: false,
				success: function (data) {
					if (data.data[0].erro == 0) {
						$('#serImagemEdit').attr('src', data.data[0].urlimagem);
						toastr.success(data.data[0].resultado);
						$("#otpimagenservico").val("").change();
						mBlob = "";
						$("#serFiguraEdit").fileinput('clear');
					} else {
						toastr.error(data.data[0].resultado);
					}
					showLoader(false)
				},
				error: function (result) {
					toastr.error('Falha de conexão');
					showLoader(false)
				}
			});
		} else {
			toastr.warning("Ops! Parece que você não concluiu a seleção da nova imagem, nenhuma alteração será feita");
			$("#serFiguraEdit").fileinput('clear');
			showLoader(false)
		}
	}

	$scope.editarimagem = function () {
		$("#serFiguraEdit").click()
	}
	$scope.removerImagem = function () {
		$("#visualizarimagem-modal").modal('hide')
		swal({
				title: 'Deseja realmente remover essa imagem',
				type: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: $_CONFIG.language.sim,
				cancelButtonText: $_CONFIG.language.nao,
				closeOnConfirm: true
			},
			function () {
				showLoader(true)
				dataaltera = new FormData();
				dataaltera.append('figura', '');
				dataaltera.append('servico', $('#serCodigoEdt').val())
				dataaltera.append('serFiguraEdit', '')
				$.ajax({
					dataType: 'json',
					method: 'POST',
					url: '/pages/cadastros/alteraServicoImagem.php',
					data: dataaltera,
					processData: false,
					contentType: false,
					success: function (data) {
						if (data.data[0].erro == 0) {
							$('#serImagemEdit').attr('src', '../../img/ser_sem_imagem.png');
							toastr.success(data.data[0].resultado);
						} else {
							toastr.error(data.data[0].resultado);
						}
						showLoader(false)
					},
					error: function (result) {
						toastr.error('Falha de conexão');
						showLoader(false)
					}
				});
			});
	}

	$('#selDiaSemana').multiselect({
		checkboxName: 'selDiaSemana[]',
		buttonText: function (options, select) {
			if (options.length === 0) {
				return $_CONFIG.language.dia_semana;
			} else {
				var labels = [];
				options.each(function () {
					if ($(this).attr('label') !== undefined) {
						labels.push($(this).attr('label'));
					} else {
						labels.push($(this).html());
					}
				});
				return labels.join(', ') + '';
			}
		}
	});

	$('#selDiaSemana').on('click', function () {
		$('#selDiaSemana').multiselect('updateButtonText', true);
	});

	$('#selDiaSemanaEdt').multiselect({
		checkboxName: 'selDiaSemanaEdt[]',
		buttonText: function (options, select) {
			if (options.length === 0) {
				return $_CONFIG.language.dia_semana;
			} else {
				var labels = [];
				options.each(function () {
					if ($(this).attr('label') !== undefined) {
						labels.push($(this).attr('label'));
					} else {
						labels.push($(this).html());
					}
				});
				return labels.join(', ') + '';
			}
		}
	});

	$('#selDiaSemanaEdt').on('click', function () {
		$('#selDiaSemanaEdt').multiselect('updateButtonText', true);
	});

	$('#selDiaTodo').change(function () {
		if (this.value == 0) {
			$('#serDescHoraIni').prop('disabled', false);
			$('#serDescHoraFim').prop('disabled', false);
		} else {
			$('#serDescHoraIni').prop('disabled', true);
			$('#serDescHoraFim').prop('disabled', true);
		}
	});

	$('#selDiaTodoEdt').change(function () {
		if (this.value == 0) {
			$('#serDescHoraIniEdt').prop('disabled', false);
			$('#serDescHoraFimEdt').prop('disabled', false);
		} else {
			$('#serDescHoraIniEdt').prop('disabled', true);
			$('#serDescHoraFimEdt').prop('disabled', true);
		}
	});

	$('#selDiaTodo').change(function () {
		if (this.value == 0) {
			$('#serDescHoraIni').prop('disabled', false);
			$('#serDescHoraFim').prop('disabled', false);
		} else {
			$('#serDescHoraIni').prop('disabled', true);
			$('#serDescHoraFim').prop('disabled', true);
		}
	});

	function carregaDados() {
		tabelabuscaser = $('#tbBuscaSer').DataTable({
			'ajax': '/pages/cadastros/buscaServicosv2.php',

			'initComplete': function () {
				$compile($('#tbBuscaSer'))($scope);
				$('#tbBuscaSer_paginate').click(function () {
					$compile($('#tbBuscaSer'))($scope);
				});
				$('#tbBuscaSer_filter').change(function () {
					$compile($('#tbBuscaSer'))($scope);
				});
				$('#tbBuscaSer_length').change(function () {
					$compile($('#tbBuscaSer'))($scope);
				});
				$('#tbBuscaSer_filter input').keyup(function () {
					tabelabuscaser
						.fnFilter(
							jQuery.fn.DataTable.ext.type.search.string(this.value)
						)
				});
				resizeContent();
			},
			dom: 'Blfrtip',
			scrollX: isPortrait,

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,

			buttons: [{
					extend: 'excelHtml5',
					text: 'Excel',
					exportOptions: {
						columns: ':visible'
					},
					footer: 'true'
				}, {
					extend: 'pdfHtml5',
					title: sSistema + ' - ' + $_CONFIG.language.servicos.breadcrumb,
					orientation: 'landscape',
					pageSize: 'LEGAL',
					exportOptions: {
						columns: ':visible'
					}
				},
				{
					extend: 'print',
					text: 'Imprimir',
					exportOptions: {
						columns: ':visible'
					},
					footer: true
				}
			],
			'language': {
				'url': $_CONFIG.language.datatables
			},
			'columns': [{
					'data': 'Ser_Descricao',
					'title': 'Descrição',
					'class': 'mobileServico'
				},
				{
					'data': 'Ser_Valor',
					'title': 'Valor',
					'class': 'mobileServico'
				},

				{
					'data': 'Ser_Intervalo_Padrao',
					'title': 'Tempo',
					'class': 'mobileServico'
				},
				{
					'data': 'Ser_Comissao',
					'title': 'Comissão',
					'class': 'mobileServico'
				},

				{
					'data': 'TCa_Descricao',
					'title': 'Categoria',
					'class': 'mobileServico'
				},
				{
					'data': 'Ser_Usa_App',
					'title': 'Disponível',
					'class': 'mobileServico',
					'render': (data) => {
						return disponivel(data)
					},
				},

				{
					'title': '',
					'class': 'editarServico',
					'orderable': false,
					'data': null,
					'defaultContent': '<button class="btn btn-xs btn-success" >Editar <i class="fa fa-pencil"></i></button>'

				}, {
					'title': '',
					'class': 'excluirServico',
					'orderable': false,
					'data': null,
					'defaultContent': '<button class="btn btn-xs btn-danger" >Excluir <i class="fa fa-trash"></i></button>'

				}
			]
		});


		$('#tbBuscaSer tbody').on('click', 'td.editarServico', function () {
			var row = tabelabuscaser.row($(this));
			$scope.editarServico(row.data());
			$("#editar-modal").modal()
		});

		$('#tbBuscaSer tbody').on('click', 'td.excluirServico', function () {
			var row = tabelabuscaser.row($(this));
			$scope.excluir(row.data().Ser_Codigo, row.data().Ser_Descricao);
		});


		if (isMobile) {
			$('#tbBuscaSer tbody').on('click', 'td.mobileServico', function () {
				var row = tabelabuscaser.row($(this));
				$scope.editarServico(row.data());
				$('#editar-modal').modal();
			});

		}

		var profissional = '';
		var profissional2= '';
		$.ajax({
			dataType: 'json',
			url: 'pages/cadastros/buscaProfissionalSelect.php',
			data: {},
			success: function (data) {

				profissional2 += '<option  value="">Selecione o Profissional</option>';
				for (var i = 0; i < data.profissionais.length; i++) {
					var codigo = data.profissionais[i].Pes_Codigo;
					var nome = data.profissionais[i].Pes_Nome;
					profissional += '<option  value="' + codigo + '">' + nome + '</option>';
				}
				profissional2 += profissional;
				$('#serCodigoProfissional').html(profissional);
				$('#profissionalPadrao').html(profissional2);
				$('#serCodigoProfissional').multiselect({
					checkboxName: 'serCodigoProfissional[]',
					enableFiltering: true,
					includeSelectAllOption: true,
					buttonWidth: '100%',
					selectAllText: 'Selecionar Todos',
					allSelectedText: 'Todos os Profissionais Selecionados',
					filterPlaceholder: 'Buscar Profissional',
					maxHeight: 300,
					numberDisplayed: 2,
					nSelectedText: ' - Selecionados',
					nonSelectedText: 'Profissionais'

				});
				$('#serCodigoProfissionalEdt').html(profissional);
				$('#serCodigoProfissionalEdt').multiselect({
					checkboxName: 'serCodigoProfissionalEdt[]',
					enableFiltering: true,
					includeSelectAllOption: true,
					buttonWidth: '100%',
					selectAllText: 'Selecionar Todos',
					allSelectedText: 'Todos os Profissionais Selecionados',
					filterPlaceholder: 'Buscar Profissional',
					maxHeight: 300,
					numberDisplayed: 2,
					nSelectedText: ' - Selecionados',
					nonSelectedText: 'Profissionais'

				});

			}
		});

	}

	function disponivel(data) {
		var html = "";
		if (data == 1) {
			html = "<i class='ion ion-iphone' style='margin:5px;' data-toggle='tooltip' data-placement='top' title='App'></i><i class='ion ion-ios-monitor-outline' style='margin:5px;' data-toggle='tooltip' data-placement='top' title='Web'></i>";
		} else {
			html = "<i class='ion ion-ios-monitor-outline' style='margin:5px;' data-toggle='tooltip' data-placement='top' title='Web'></i>";
		}
		return html;

	}

	function atualizaDados() {
		showLoader(true);
		tabelabuscaser.ajax.reload(function () {
			showLoader(false);
			$compile($('#tbBuscaSer'))($scope);
			$('#tbBuscaSer_paginate').click(function () {
				$compile($('#tbBuscaSer'))($scope);
			});
		});
	}

	$('#formCadastro').submit(function (event) {
		event.preventDefault();
		formCadastro = $(this);

		dataInsere = new FormData(this);
		dataInsere.append('valor', parseFloat($('#serValor').val()));
		dataInsere.append('blob', mBlob);
		if (dataInsere.delete != undefined) {
			dataInsere.delete('serFigura');
		}
		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/insereServicosv2.php',
			data: dataInsere,
			dataType: 'json',
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.insereServico[0].erro == '0') {
					toastr.success(result.insereServico[0].resultado);
					$('#serCodigoAssociacao').val(result.insereServico[0].sercodigo);
					$('#serValorAssociacao').val($('#serValor').maskMoney('unmasked')[0]);

					swal({
							title: "Hora de associar aos profissionais!",
							text: "Deseja escolher e associar <b>manualmente</b> ou deseja que o sistema associe o serviço a <b>TODOS</b> os profissionais <b>automaticamente</b>?",
							type: "warning",
							showCancelButton: true,
							confirmButtonColor: "#7ddd54",
							cancelButtonColor: "#679bef",
							confirmButtonText: "Automático",
							cancelButtonText: "Manual",
							closeOnConfirm: false,
							closeOnCancel: true,
							html: true
						},
						function (isConfirm) {
							if (isConfirm) {

								var obj = $('#serCodigoProfissional').get(0).options;
								var vet = [];
								showLoader(true);
								for (var i = 0; i < obj.length; i++) {
									vet.push(obj[i].value);
								}
								$.ajax({
									type: 'POST',
									url: '/pages/cadastros/insereProfissionalServico.php',
									data: {
										spServico: $('#serCodigoAssociacao').val(),
										spProfissional: vet
									},
									dataType: 'json',
									success: function (result) {
										if (result.sucesso > 0) {
											var texto = '<span style="color:green;"><i class="fa fa-check"></i>&nbspInseridos com sucesso:&nbsp' + result.sucesso + '</span>'
										} else {
											var texto = '<span style="color:red;"><i class="fa fa-times"></i>&nbspFalhas ao inserir:&nbsp' + result.falha + '</span>'
										}

										swal({
											title: "<small>Resultado</small>",
											text: texto,
											html: true
										});
										atualizaDados();
										$scope.buscatabelaAssociar();
										formCadastro.each(function () {
											this.reset();
										});
										$scope.avancaTab();
										$scope.avancaTab();
										showLoader(false);
										mBlob = '';
									},
									error: function (result) {
										toastr.error($_CONFIG.language.errors.falha_conexao);
										showLoader(false);
									}
								});

							} else {
								$scope.avancaTab();
								atualizaDados();
								$scope.buscatabelaAssociar();
								formCadastro.each(function () {
									this.reset();
								});
								$('#serMenPersonalizadaEdt').val('')
								$('#serMensagemPer').val('');
							}
						});

				} else {
					toastr.error(result.insereServico[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		return true;
	});

	$('#formEditar').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		dataInsere = new FormData(this);
		dataInsere.append('valor', parseFloat($('#serValorEdt').val()));
		dataInsere.append('blob', mBlob);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/alteraServicosv2.php',
			data: dataInsere,
			dataType: 'json',
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.alteraServico[0].erro == '0') {
					toastr.success(result.alteraServico[0].resultado);
					atualizaDados();
					$('#serMenPersonalizadaEdt').val('');
					$('#serMensagemPerEdt').val('');
					$('#editar-modal').modal('hide');
				} else {
					toastr.error(result.alteraServico[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		return true;
	});

	$('#serPFId').on('change', function () {
		var serPFid = $('#serPFId').val();
		if (serPFid == 1) {
			$('#serPontoPF').attr('disabled', false);
		} else {
			$('#serPontoPF').attr('disabled', true);
		}
	});

	$('#serPFIdEdt').on('change', function () {
		var serPFid = $('#serPFIdEdt').val();
		if (serPFid == 1) {
			$('#serPontoPFEdt').attr('disabled', false);
		} else {
			$('#serPontoPFEdt').attr('disabled', true);
		}
	});

	$scope.editarServico = function (serdata) {

		$scope.firstTab();
		$('#serDescricaoEdt').val(serdata.Ser_Descricao);
		$('#serValorEdt').val(parseFloat(serdata.Ser_Valor.replace(",", ".")).toFixed(2));
		$('#serValorOriginal').val(parseFloat(serdata.Ser_Valor.replace(",", ".")).toFixed(2));
		$('#serValorFixo').val(serdata.Ser_Valor);
		$('#valorServicoPadrao').val(serdata.Ser_Valor);
		$('#serPontoEdt').val(serdata.Ser_Ponto);
		$('#serIntervaloEdt').val(serdata.Ser_Intervalo_Padrao);
		$('#serCodigoEdt').val(serdata.Ser_Codigo);
		$('#sercodigoAuxiliar').val(serdata.Ser_Codigo);
		$('#sercodigoAssinatura').val(serdata.Ser_Codigo);
		$('#serCodigoAssociacaoEdt').val(serdata.Ser_Codigo);
		$('#serUsaAppEdt').val(serdata.Ser_Usa_App);
		$('#serTempoRetornoEdt').val(serdata.Ser_Tem_Retorno);
		$('#serComissaoEdt').val(serdata.Ser_Comissao.replace('%', '').replace('.', ','));
		if (serdata.Ser_Figura != undefined && serdata.Ser_Figura != "") {
			$('#serImagemEdit').attr('src', serdata.Ser_Figura);
		} else {
			$('#serImagemEdit').attr('src', '../../img/ser_sem_imagem.png');
		}
		$('#serTipoPrecoEdt').val(serdata.Ser_Tip_Preco);
		$('#serObservacaoEdt').val(serdata.Ser_Observacao);
		$('#serMensagemPerEdt').val(serdata.Ser_Msg_Retorno);
		$('#serMenPersonalizadaEdt').val(serdata.Ser_Msg_Retorno)
		$('#serSimultaneosEdt').val(serdata.Ser_Simultaneo);
		$('#serCategoriaEdt').val(serdata.TCa_Codigo);
		$('#serCustoEdt').val(serdata.Ser_Custo);
		$scope.buscaServicoProgramacao(serdata.Ser_Codigo)
		$scope.iniciaCrossSelling(serdata.Ser_Codigo);

		if (serdata.Ser_Exclusivo_Assinatura != "") {
			$('#exclusivoAssinatura').val(serdata.Ser_Exclusivo_Assinatura);
		} else {
			$('#exclusivoAssinatura').val(0);
		}

		if (serdata.Ser_Duplo == $_CONFIG.language.sim) {
			$('#serDuploEdt').val(1);
		} else {
			$('#serDuploEdt').val(0);
		}

		$("#usaAuxiliarEdt").val(serdata.Ser_Tem_Auxiliar).change();
		if (serdata.Ser_Valor_Auxiliar != "") {
			$("#valAuxiliarEdt").val(serdata.Ser_Valor_Auxiliar);
		} else {
			$("#valAuxiliarEdt").val(1);
		}

		var fidelidade = "Não";
		if (serdata.Ser_Usa_Ponto == 1) {
			fidelidade = "Sim";

		} else {
			fidelidade = "Não";
		}

		if (fidelidade == $_CONFIG.language.sim) {
			$('#serPFIdEdt').val(1);
			$('#serPontoPFEdt').attr('disabled', false);
			$('#serPontoPFEdt').val(serdata.PIt_Ponto);
		} else {
			$('#serPFIdEdt').val(0);
			$('#serPontoPFEdt').attr('disabled', true);
			$('#serPontoPFEdt').val('');
		}

		// if (serdata.Ser_Dis_Apresentacao == '0') {
		// 	$('#dispApresentacaoedt').prop('checked', false);
		// } else {
		// 	$('#dispApresentacaoedt').prop('checked', true);
		// }

		if (serdata.Ser_Dis_Vlr_Apresentacao == '0') {
			$('#dispValorApresentacaoedt').prop('checked', false);
		} else {
			$('#dispValorApresentacaoedt').prop('checked', true);
		}

		if(serdata.SauCodigoSerPadrao != ''){
			$('#auxiliarPadraoGeralComissao').val(serdata.AuxPadraoServico);
			$('#sauCodigoPadrao').val(serdata.SauCodigoSerPadrao);
		}else{
			
			$('#sauCodigoPadrao').val('');
			$('#auxiliarPadraoGeralComissao').val('');
		}
		if (serdata.SAu_Codigo != '') {
			$("#hasStandartProf").val(1).change()
			$("#profissionalPadrao").val(serdata.AuxPadrao)
			$("#auxiliarPadraoComissao").val(serdata.ComissaoAux)
			$("#sauCodigo").val(serdata.SAu_Codigo);
			$("#divRemoveProfissionalPadrao").show()
		} else {
			$("#hasStandartProf").val(0).change()
			$("#profissionalPadrao").val('')
			$("#auxiliarPadraoComissao").val('')
			$("#sauCodigo").val('')
			$("#divRemoveProfissionalPadrao").hide()
		}

		if (typeof (tabelaserprof) !== 'undefined') {
			tabelaserprof.destroy();
		}
		tabelaserprof = $('#tbBuscaSerProf').DataTable({
			'ajax': {
				'url': '/pages/cadastros/buscaServicoProfissional_v2.php',
				'method': 'POST',
				'data': function (d) {
					d.sercodigo = $('#serCodigoAssociacaoEdt').val();
