					$("#CBITipoItemNewSer").val(1).change();
					$('#tbBuscaSerCombo').dataTable().api().ajax.reload();
					$('#tabelaItensItensComboSer').dataTable().api().ajax.reload(function (e) {
						var vlrTotal = e.data[0];
						if (vlrTotal == null) {
							$(".totalItensComboEdtSer").html('');
						} else {
							$(".totalItensComboEdtSer").html(vlrTotal.CBo_Valor);
						}
					});
					$("#CBoCodigoItemNewSer").val(codigoCombo);
					toastr.success(result.data[0].resultado);
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
				showLoader(false);
			}
		});
		return true;
	})

	$scope.salvaEdtComboSer = function () {
