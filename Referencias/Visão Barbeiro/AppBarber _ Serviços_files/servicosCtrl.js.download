	$('#hasStandartProf').change(()=>{
		if($("#hasStandartProf").val() == 1){
			$("#divOptProfissional").show()
		}else{
			$("#divOptProfissional").hide()
			$("#profissionalPadrao").val('');
			$("#auxiliarPadraoComissao").val('');
		}
	})


	$('#auxiliarPadraoComissao').on('keyup', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#auxiliarPadraoComissao').val('100,00');
		} else if (valorcomissao < 0) {
			$('#auxiliarPadraoComissao').val('0,00');
		}
	});

	$('#auxiliarPadraoComissao').on('keydown', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#auxiliarPadraoComissao').val('100,00');
		} else if (valorcomissao < 0) {
			$('#auxiliarPadraoComissao').val('0,00');
		}
	});

	
	$('#auxiliarPadraoGeralComissao').on('keyup', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#auxiliarPadraoGeralComissao').val('100,00');
		} else if (valorcomissao < 0) {
			$('#auxiliarPadraoGeralComissao').val('0,00');
		}
	});

	$('#auxiliarPadraoGeralComissao').on('keydown', function () {
		var valorcomissao = parseFloat($(this).val().replace(',', '.'))
		if (valorcomissao > 100.00) {
			$('#auxiliarPadraoGeralComissao').val('100,00');
		} else if (valorcomissao < 0) {
			$('#auxiliarPadraoGeralComissao').val('0,00');
		}
	});

	carregaDados();

	$scope.removerProfissionalPadrao = function(){
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/removeServicoAuxiliar.php',
			data: {
				saucodigo: $("#sauCodigo").val()
			},
			dataType: 'json',
			success: function (result) {

				if (result.data[0] == undefined) {
					toastr.error(result.data.resultado);
				} else {

					if (result.data[0].erro == '0') {
						$("#divRemoveProfissionalPadrao").hide();
						$("#profissionalPadrao").val('');
						$("#auxiliarPadraoComissao").val('');
						$("#sauCodigo").val('')
						toastr.success(result.data[0].resultado);
						atualizaDados();
					} else {
						toastr.error(result.data[0].resultado);
					}
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
	}


	$scope.buscaCombo = function () {

		if (typeof (listaComboSer) !== 'undefined') {
			$('#tbBuscaSerCombo tbody').unbind('click')
			listaComboSer.destroy();
			$('#tbBuscaSerCombo tbody').unbind('click')
		}
		listaComboSer = $('#tbBuscaSerCombo').DataTable({
			'ajax': {
				'url': '/pages/cadastros/buscaCombo.php',
				'method': 'POST',
				'data': function (d) {
					d.tipo = 4
				}
			},
			"scrollX": isPortrait,

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,

			'columns': [{
					'data': 'CBo_Descricao',
					"title": "Descricao",
					"width": '45%'
				}, {
					'data': 'CBo_Valor',
					"title": "Valor",
					"width": '10%'
				},{
					'data': 'Total_Tempo',
					"title": "Tempo",
					"width": '10%'
				},
				{
					'class': 'verItens',
					'orderable': false,
					'title': 'Itens',
					'data': null,
					'defaultContent': "<button class='btn btn-success btn-xs'><i class='fa fa-tags' style='cursor:pointer';></i> Itens</button>",
					"width": '5%'
				}, {
					'class': 'alteraCombo',
					'orderable': false,
					'title': 'Alterar',
					'data': null,
					'defaultContent': "<button class='btn btn-warning btn-xs'><i class='fa fa-pencil' style='cursor:pointer';></i> Editar</button>",
					"width": '5%'
				},
				{
					'class': 'removerCombo',
					'orderable': false,
					'title': 'Itens',
					'data': null,
					'defaultContent': "<button class='btn btn-danger btn-xs'><i class='fa fa-trash' style='cursor:pointer';></i> Remover</button>",
					"width": '5%'
				}
			],
			'ordering': false,
			'searching': false,
			'lenghtChange': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});

		$('#tbBuscaSerCombo tbody').on('click', 'td.alteraCombo', function () {
			var tr = $(this).closest('tr');
			var row = listaComboSer.row(tr);
			var data = row.data();
			$("#CBoCodigoEditarSer").val(data.CBo_Codigo)
			$("#ComboDescricaoEditSer").val(data.CBo_Descricao)
			// $("#DispApresentacaoEditSer").val(data.CBo_Disp_Apresentacao)
			$("#DispAppEditSer").val(data.CBo_Disp_App)
			if (data.CBo_Imagem != '') {
				$("#cboImagemEditSer").attr('src', data.CBo_Imagem)
			} else {
				$("#cboImagemEditSer").attr('src', '../../img/combo_sem_imagem.png')

			}
			$("#editarComboSer-modal").modal()

		});


		$('#tbBuscaSerCombo tbody').on('click', 'td.removerCombo', function () {
			var tr = $(this).closest('tr');
			var row = listaComboSer.row(tr);
			var data = row.data();
			swal({
					title: "Excluir",
					text: "Deseja realmente excluir este Item?",
					type: "warning",
					showCancelButton: true,
					confirmButtonColor: "#DD6B55",
					confirmButtonText: "Sim",
					cancelButtonText: "Não"
				},
				function (Confirmou) {
					if (Confirmou) {
						$scope.removeComboSer(data.CBo_Codigo)
					}
				});

		});

		$('#tbBuscaSerCombo tbody').on('click', 'td.verItens', function () {

			var tr = $(this).closest('tr');
			var row = listaComboSer.row(tr);
			var data = row.data();
			$("#CBoCodigoItemNewSer").val(data.CBo_Codigo);
			//$scope.buscaProdutoComboEstoque()
			if (typeof (itemListaComboSer) !== 'undefined') {
				$('#tabelaItensItensComboSer tbody').unbind('click')
				itemListaComboSer.destroy();
				$('#tabelaItensItensComboSer tbody').unbind('click')
			}
			itemListaComboSer = $('#tabelaItensItensComboSer').DataTable({
				'ajax': {
					'url': '/pages/cadastros/buscaCombo.php',
					'method': 'POST',
					'data': function (d) {
						d.tipo = 2;
						d.cbocodigo = data.CBo_Codigo
					}
				},
				"scrollX": isPortrait,

				stateSaveCallback: function (settings, data) {
					data.order = [];
					localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
				},
				stateLoadCallback: function (settings) {
					return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
				},
				"stateSave": true,
				initComplete: function (d, i) {
					var vlrTotal = this.fnGetData(0);
					if (vlrTotal != null) {
						$(".totalItensComboEdtSer").html(vlrTotal.CBo_Valor);
					} else {
						$(".totalItensComboEdtSer").html('');
					}
				},

				'columns': [{
						"data": "Imagem",
						"render": function (data) {
							return '<img height="30px" width="30px" src="' + data + '"/>';
						}
					},
					{
						'data': 'Descricao',
						"title": "Descricao"

					},
					{
						'data': 'CBI_Vlr_Unitario',
						"title": "Valor"
					},
				
					{
						'data': 'CBI_Tempo',
						"title": "Tempo"
					},
					{
						"class": 'excluirItemComboLista',
						"orderable": false,
						"data": null,
						"defaultContent": '<button type="button" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></button>',
					}
				],
				'ordering': false,
				'searching': false,
				'lenghtChange': false,
				'language': {
					'url': $_CONFIG.language.datatables
				}
			});

			$('#tabelaItensItensComboSer tbody').on('click', 'td.excluirItemComboLista', function () {
				var tr = $(this).closest('tr');
				var row = itemListaComboSer.row(tr);
				var data = row.data();
				swal({
						title: "Excluir",
						text: "Deseja realmente excluir este Item?",
						type: "warning",
						showCancelButton: true,
						confirmButtonColor: "#DD6B55",
						confirmButtonText: "Sim",
						cancelButtonText: "Não"
					},
					function (Confirmou) {
						if (Confirmou) {
							showLoader(true)
							$scope.removeItemCombo(data.CBI_Codigo, data.CBo_Codigo)
							setTimeout(function () {
								$('#tabelaItensItensComboSer').dataTable().api().ajax.reload(function (e) {
									var vlrTotal = e.data[0];
									if (vlrTotal == null) {
										$(".totalItensComboEdtSer").html('');
									} else {
										$(".totalItensComboEdtSer").html(vlrTotal.CBo_Valor);
									}
								});
								showLoader(false)
							}, 1000)
						}
					});

			});

			$("#itensComboSer-modal").modal();
		});
	}
	$scope.buscaCombo()


	
	$('#cadastrarComboSer-modal').on('hidden.bs.modal', function () {
		$scope.firstTab();
		$("#CBITipoItemSer").val(1).change()
		$("#DispAppSer").val(0).change()
		// $("#DispApresentacaoSer").val(0).change()
		$("#ComboDescricaoSer").val('')
		$scope.buscaCombo();
	});

	$scope.avancaTabCombo = function () {
		var $active = $('.combo .nav-tabs li.active');
		$active.next().removeClass('disabled');
		$scope.nextTabCombo($active);
		$('a[data-target="#tabItemComboSer"]').parent().removeClass('disabledTab');

	}

	$scope.retornaTabCombo = function () {
		var $active = $('.combo .nav-tabs li.active');
		$active.prev().removeClass('disabled');
		$scope.prevTab($active);
	}

	$scope.nextTabCombo = function (elem) {
		$(elem).next().find('a[data-toggle="tab"]').click();
	}

	$scope.prevTabCombo = function (elem) {
		$(elem).prev().find('a[data-toggle="tab"]').click();
	}

	$scope.firstTab = function () {
		$("#navTabDadosComboSer").removeClass()
		$("#navTabDadosComboSer").addClass('disabled disabledTab active')
		$("#tabDadosComboSer").removeClass();
		$("#tabDadosComboSer").addClass('tab-pane active');

		$("#navTabItensComboSer").removeClass()
		$("#navTabItensComboSer").addClass('disabled disabledTab')
		$("#tabItemComboSer").removeClass();
		$("#tabItemComboSer").addClass('tab-pane');

	}

	$('#formComboSer').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		var dados = new FormData();

		dados.append('tipo', 2)
		dados.append('descricao', $("#ComboDescricaoSer").val())
		dados.append('dispapp', $("#DispAppSer").val())
		// dados.append('dispapresentacao', $("#DispApresentacaoSer").val())
		dados.append('blob', mBlob)

		$.ajax({
			type: "POST",
			url: "/pages/cadastros/insereCombo.php",
			data: dados,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.data[0].erro == "0") {
					$("#CBoCodigoItemSer").val(result.data[0].cbocodigo)
					$scope.buscaItensComboListaSer(result.data[0].cbocodigo)
					$scope.avancaTabCombo();
					$('#formComboProdSer').each(function () {
						this.reset();
					})
					mBlob = "";
					toastr.success(result.data[0].resultado);
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
				showLoader(false);
			}
		});

		return true;
	})

	$("#CBITipoItemSer").on("change", function () {
		if ($("#CBITipoItemSer").val() == 1) {
			$("#CBIDivProdutoSer").show()
			$("#CBIDivServicoSer").hide()
		} else {
			$("#CBIDivServicoSer").show()
			$("#CBIDivProdutoSer").hide()
		}
	})
	$("#CBITipoItemNewSer").on("change", function () {
		if ($("#CBITipoItemNewSer").val() == 1) {
			$("#CBIDivProdutoNewSer").show()
			$("#CBIDivServicoNewSer").hide()
		} else {
			$("#CBIDivServicoNewSer").show()
			$("#CBIDivProdutoNewSer").hide()
		}
	})

	$("#btnNovoComboSer").on('click', function () {
		$("#CBITipoItemSer").val(1).change()
		$("#CBIQuantidadeSer").val(1)
	})

	$("#btnNovoItemSer").on('click', function () {
		$("#CBITipoItemNewSer").val(2).change()
		$("#CBIQuantidadeNewSer").val(1)
		var padrao = parseInt($_CONFIG.TEMPOPADRAO)
		for (var i = padrao; i <= 360; i = i + padrao) {
			$('#CBITempoNewSer').append('<option value="' + i + '" >' + i + ' ' + $_CONFIG.language.minutos + '</option>');
		};
	})

	$scope.buscaServicoComboLista = function () {
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/buscaServicoSelect.php',
			dataType: 'json',
			success: function (result) {
				var html = "";
				html += '<option value="">Serviço</option>';
				for (var i = 0; i < result.servicos.length; i++) {
					html += '<option value="' + result.servicos[i].Ser_Codigo + '" data-valor="'+result.servicos[i].Ser_Valor+'">' + result.servicos[i].Ser_Descricao + '</option>';
				}

				$("#CBIServicoSer").html(html);
	 			$("#CBIServicoNewSer").html(html);
			}
		});
	}
	$scope.buscaServicoComboLista()

	$("#CBIServicoSer").on("change", function(){
		$("#CBIValorSer").val($("#CBIServicoSer option:selected").get(0).dataset.valor);
	})

	$("#CBIServicoNewSer").on("change", function(){
		$("#CBIValorNewSer").val($("#CBIServicoNewSer option:selected").get(0).dataset.valor);
	})

	$("#CBIServico").on("change", function () {
		$("#CBIValorSer").val($("#CBIServico option:selected").get(0).dataset.valor)
		$("#CBIQuantidadeSer").val(1);
	})

	$("#CBIServicoNew").on("change", function () {
		$("#CBIValorNewSer").val($("#CBIServicoNew option:selected").get(0).dataset.valor)
		$("#CBIQuantidadeNewSer").val(1);
	})

	$scope.buscaItensComboListaSer = function (codigoCombo) {
		if (typeof (buscaitemListaComboSer) !== 'undefined') {
			$('#tabelaItensItensComboInsereSer tbody').unbind('click')
			buscaitemListaComboSer.destroy();
			$('#tabelaItensItensComboInsereSer tbody').unbind('click')
		}
		buscaitemListaComboSer = $('#tabelaItensItensComboInsereSer').DataTable({
			'ajax': {
				'url': '/pages/cadastros/buscaCombo.php',
				'method': 'POST',
				'data': function (d) {
					d.tipo = 2;
					d.cbocodigo = codigoCombo
				}
			},
			"scrollX": isPortrait,

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,
			initComplete: function (d, i) {
				var vlrTotal = this.fnGetData(0);
				if (vlrTotal != null) {
					$(".totalItensComboSer").html(vlrTotal.CBo_Valor);
				} else {
					$(".totalItensComboSer").html('');
				}
			},

			'columns': [{
					"data": "Imagem",
					"render": function (data) {
						return '<img height="30px" width="30px" src="' + data + '"/>';
					}
				},
				{
					'data': 'Descricao',
					"title": "Descricao"
				},
				{
					'data': 'CBI_Vlr_Unitario',
					"title": "Valor"
				},
				{
					'data': 'CBI_Tempo',
					"title": "Tempo"
				},
				{
					"class": 'excluirItemCombo',
					"orderable": false,
					"data": null,
					"defaultContent": '<button type="button" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></button>',
				}
			],
			'ordering': false,
			'searching': false,
			'lenghtChange': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});
		$('#tabelaItensItensComboInsereSer tbody').on('click', 'td.excluirItemCombo', function () {
			var tr = $(this).closest('tr');
			var row = buscaitemListaComboSer.row(tr);
			var data = row.data();
			swal({
					title: "Excluir",
					text: "Deseja realmente excluir este Item?",
					type: "warning",
					showCancelButton: true,
					confirmButtonColor: "#DD6B55",
					confirmButtonText: "Sim",
					cancelButtonText: "Não"
				},
				function (Confirmou) {
					if (Confirmou) {
						showLoader(true)
						$scope.removeItemCombo(data.CBI_Codigo, data.CBo_Codigo)
						setTimeout(function () {
							$('#tabelaItensItensComboInsereSer').dataTable().api().ajax.reload();
							showLoader(false)
						}, 1000)
					}
				});

		});
	}

	$('#formItensComboSer').submit(function (event) {
		event.preventDefault();
		var codigoCombo = $("#CBoCodigoItemSer").val();
		var formdata = $(this);
		showLoader(true);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/insereComboItens.php",
			data: {
				cbocodigo: $("#CBoCodigoItemSer").val(),
				valor: $("#CBIValorSer").val().replace(',', '.'),
				procodigo: '',
				sercocigo: $("#CBIServicoSer").val(),
				tempo: $('#CBITempoSer').val(),
				desconto: '',
				quantidade: 1
			},
			dataType: "json",
			success: function (result) {
				if (result.data[0].erro == "0") {
					formdata.each(function () {
						this.reset();
					});
					$scope.buscaItensComboListaSer(codigoCombo);
					$("#CBoCodigoItemSer").val(codigoCombo);
					$("#CBITipoItemSer").val(2).change();
					toastr.success(result.data[0].resultado);
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
				showLoader(false);
			}
		});
		return true;
	})


	$scope.removeItemCombo = function (cbicodigo, codigocombo) {
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/removeComboItens.php",
			data: {
				cbicodigo: cbicodigo,
			},
			async: false,
			dataType: "json",
			success: function (result) {
				if (result.data[0].erro == "0") {
					toastr.success(result.data[0].resultado);
				} else {
					toastr.error(result.data[0].resultado);
				}
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
			}
		});

	}

	$scope.removeCombo = function (codigocombo) {
		showLoader(true);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/removeCombo.php",
			data: {
				cbocodigo: codigocombo,
			},
			async: false,
			dataType: "json",
			success: function (result) {
				if (result.data[0].erro == "0") {
					toastr.success(result.data[0].resultado);
				} else {
					toastr.error(result.data[0].resultado);
				}
				$scope.buscaCombo();
				showLoader(false);
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
				showLoader(false);
			}
		});

	}

	$('#formItensComboNewSer').submit(function (event) {
		event.preventDefault();
		var codigoCombo = $("#CBoCodigoItemNewSer").val();
		var formdata = $(this);
		showLoader(true);
		$.ajax({
			type: "POST",
