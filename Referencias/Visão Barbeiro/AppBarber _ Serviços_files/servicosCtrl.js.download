		$('#tbBuscaSerProf tbody').on('click', 'td.altera', function () {
			var tr = $(this).closest('tr');
			var row = tabelaserprof.row(tr);
			var data = row.data();
			var tempo2 = data.PSe_Tem_Servico;
			$.ajax({
				dataType: 'json',
				url: localStorage.getItem('host'),
				data: {
					metodo: 'buscaParametro',
					id: $scope.idCliente,
					parcodigo: 5,
					origem: 1
				},
				success: function (data) {
					if (data.result[0] != '') {
						parTempo = data.result[0].PVa_Vlr_Principal;
						var tempo = parseInt(parTempo);
						for (var i = tempo; i <= 360; i = i + tempo) {
							$('#serIntervaloProf').append('<option value="' + i + '" >' + i + ' ' + $_CONFIG.language.minutos + '</option>');
						};
						$('#serIntervaloProf').val(tempo2);
						$('.timepicker').timepicker({
							'timeFormat': 'H:i',
							'forceRoundTime': true,
							'step': tempo
						});
					} else {
						$('.timepicker').timepicker({
							'timeFormat': 'H:i',
							'forceRoundTime': true,
							'step': 10
						});
					}
				}
			});
			$('#serCodigoServicoProfissionalEdt').val(data.PSe_Codigo);
			$('#serProfComissaoEdt').val(data.PSe_Comissao_Principal);
			$('#spValorser').val(data.PSe_Vlr_Principal);
			$('#spValorser').change();
			$('#editarServicoProfissional-modal').modal();
		});

