	$scope.buscaServicoProgramacao = function(sercodigo){
		$("#valorProgramacao").val("");
		if (typeof (optTbProgServico) !== 'undefined') {
			$('#tbServicoProgramado tbody').unbind('click')
			optTbProgServico.destroy();
			$('#tbServicoProgramado tbody').unbind('click')
		}
		optTbProgServico = $('#tbServicoProgramado').DataTable({
			'ajax': {
				'url': '/pages/cadastros/buscaServicoValor.php',
				'method': 'POST',
				'data': function (d) {
					d.sercodigo = sercodigo;
					d.tipo = 1;
				}
			},
			"scrollX": isPortrait,

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,
			'columns': [{
					'data': 'SVa_Valor_Format',
					"title": "Novo Valor",
					"width": '30%'
				},
				{
					'data': 'SVa_Dat_Inicio',
					"title": "Data de Atualização",
					"width": '50%'
				},
				{
					'class': 'aplicaValorAlteracao',
					'orderable': false,
					'title': 'Aplicar',
					'data': null,
					'defaultContent': `<button class="btn btn-success btn-xs"><i class="fa fa-check" aria-hidden="true"></i></button>`,
					"width": '5%'
				},
				{
					'class': 'configurarAlteracao',
					'orderable': false,
					'title': 'Configurar',
					'data': null,
					'defaultContent': `<button class="btn btn-primary btn-xs"><i class="fa fa-cog" aria-hidden="true"></i></button>`,
					"width": '5%'
				},
				{
					'class': 'editarValorAlteracao',
					'orderable': false,
					'title': 'Editar',
					'data': null,
					'defaultContent': `<button class="btn btn-warning btn-xs"><i class="fa fa-pencil" aria-hidden="true"></i></button>`,
					"width": '5%'
				},
				{
					'class': 'removerValorAlteracao',
					'orderable': false,
					'title': 'Remover',
					'data': null,
					'defaultContent': `<button class="btn btn-danger btn-xs"><i class="fa fa-trash" aria-hidden="true"></i></button>`,
					"width": '5%'
				}
			],
			'ordering': false,
			'searching': false,
			'lenghtChange': false,
			'language': {
				'url': $_CONFIG.language.datatables
			},
			"fnRowCallback": function (nRow, aData) {

                var aplicar = aData.Aplicar;

                for (var i = 0; i < nRow.children.length; i++) {

                    if ((nRow.children[i].className != "") && (nRow.children[i].className == " aplicaValorAlteracao") && (nRow.children[i].className != "sorting_1")) {
                        if (aplicar == 0) {

                            nRow.children[i].innerHTML = '<button class="btn btn-success btn-xs" disabled><i class="fa fa-check" aria-hidden="true"></i></button>';
                            nRow.children[i].className = '';
                        }
                    }
                }

            },
		});



		$('#tbServicoProgramado tbody').on('click', 'td.aplicaValorAlteracao', function () {
			var tr = $(this).closest('tr');
			var row = optTbProgServico.row(tr);
			var data = row.data();

		});

		$('#tbServicoProgramado tbody').on('click', 'td.editarValorAlteracao', function () {
			var tr = $(this).closest('tr');
			var row = optTbProgServico.row(tr);
			var data = row.data();

			$("#svaCodigoEditar").val(data.SVa_Codigo)
			$("#svaValorEDT").val(data.SVa_Valor)
			$("#DataProgramacaoEDT").val(data.SVa_Dat_Inicio)
			$("#editarProgramacaoServico-modal").modal()

		});

		$('#tbServicoProgramado tbody').on('click', 'td.configurarAlteracao', function () {
			var tr = $(this).closest('tr');
			var row = optTbProgServico.row(tr);
			var data = row.data();

			$("#svaCodigoConfigurar").val(data.SVa_Codigo);
			$("#servicoAlteracao").html(data.Ser_Descricao);
			$("#dataAlteracao").html(data.SVa_Dat_Inicio)

			if (typeof (optTbConfigProgServico) !== 'undefined') {
				$('#tbConfigServicoProgramado tbody').unbind('click')
				optTbConfigProgServico.destroy();
				$('#tbConfigServicoProgramado tbody').unbind('click')
			}
			optTbConfigProgServico = $('#tbConfigServicoProgramado').DataTable({
				'ajax': {
					'url': '/pages/cadastros/buscaServicoValor.php',
					'method': 'POST',
					'data': function (d) {
						d.sercodigo = sercodigo;
						d.tipo = 2;
					}
				},
				"scrollX": isPortrait,

				stateSaveCallback: function (settings, data) {
					data.order = [];
					localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
				},
				stateLoadCallback: function (settings) {
					return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
				},
				"stateSave": true,
				'columns': [
					{
						'data': 'Pes_Nome',
						"title": "Profissional",
						"width": '30%'
					},
					{
						'data': 'PSe_Vlr_Principal',
						"title": "Valor Atual",
						"width": '30%'
					},
					{
						'data': 'SVP_Valor_Format',
						"title": "Novo Valor",
						"width": '50%',
						"render": function (data) {
							return `<b>${data}</b>` ;
						}
					},


					{
						'class': 'addValorPessoaAlteracao',
						'orderable': false,
						'title': 'Adicionar',
						'data': null,
						'defaultContent': `<button class="btn btn-success btn-xs"><i class="fa fa-plus" aria-hidden="true"></i></button>`,
						"width": '5%'
					},
					{
						'class': 'editarValorPessoaAlteracao',
						'orderable': false,
						'title': 'Editar',
						'data': null,
						'defaultContent': `<button class="btn btn-warning btn-xs"><i class="fa fa-pencil" aria-hidden="true"></i></button>`,
						"width": '5%'
					},
					{
						'class': 'removerValorPessoaAlteracao',
						'orderable': false,
						'title': 'Remover',
						'data': null,
						'defaultContent': `<button class="btn btn-danger btn-xs"><i class="fa fa-trash" aria-hidden="true"></i></button>`,
						"width": '5%'
					}
				],
				'ordering': false,
				'searching': false,
				'lenghtChange': false,
				'language': {
					'url': $_CONFIG.language.datatables
				},
				"fnRowCallback": function (nRow, aData) {

					var editar = aData.SVP_Codigo;

					for (var i = 0; i < nRow.children.length; i++) {

						if (editar == '') {
							if ((nRow.children[i].className != "") && (nRow.children[i].className == " editarValorPessoaAlteracao") && (nRow.children[i].className != "sorting_1")) {

								nRow.children[i].innerHTML = '';
								nRow.children[i].className = '';
							}
							
							if ((nRow.children[i].className != "") && (nRow.children[i].className == " removerValorPessoaAlteracao") && (nRow.children[i].className != "sorting_1")) {

								nRow.children[i].innerHTML = '';
								nRow.children[i].className = '';
							}
						}else{
							
							if ((nRow.children[i].className != "") && (nRow.children[i].className == " addValorPessoaAlteracao") && (nRow.children[i].className != "sorting_1")) {

								nRow.children[i].innerHTML = '';
								nRow.children[i].className = '';
							}
						}
					}

				}

			});


			$('#tbConfigServicoProgramado tbody').on('click', 'td.removerValorPessoaAlteracao', function () {
				var tr = $(this).closest('tr');
				var row = optTbConfigProgServico.row(tr);
				var data = row.data();
				var svpcodigo = data.SVP_Codigo;
				swal({
						title: "Deseja realmente remover essa programação",
						type: 'warning',
						showCancelButton: true,
						confirmButtonColor: '#DD6B55',
						confirmButtonText: $_CONFIG.language.sim,
						cancelButtonText: $_CONFIG.language.nao,
						closeOnConfirm: true
					},
					function () {
						showLoader(true);
						$.ajax({
							dataType: 'json',
							method: 'POST',
							url: '/pages/cadastros/removeServicoValorPessoa.php',
							data: {
								svpcodigo: svpcodigo,
							},
							success: function (data) {
								if (data.data[0].erro == '0') {
									toastr['success'](data.data[0].resultado);
									optTbConfigProgServico.ajax.reload()
								} else {
									toastr['error'](data.data[0].resultado);
								}
								showLoader(false);
							},
							error: function (result) {
								toastr.error($_CONFIG.language.errors.falha_conexao);
								showLoader(false);
							}
						});
					});
			});

			$('#tbConfigServicoProgramado tbody').on('click', 'td.addValorPessoaAlteracao', function () {
				var tr = $(this).closest('tr');
				var row = optTbConfigProgServico.row(tr);
				var data = row.data();

				$("#pseCodigoInsere").val(data.PSe_Codigo)
				$("#insereServicoValorPessoa-modal").modal()
	
			});

			$('#tbConfigServicoProgramado tbody').on('click', 'td.editarValorPessoaAlteracao', function () {
				var tr = $(this).closest('tr');
				var row = optTbConfigProgServico.row(tr);
				var data = row.data();

				$("#svpCodigoEdita").val(data.SVP_Codigo)
				$("#svaValorServicoPessoaEDT").val(data.SVP_Valor)
				$("#editarServicoValorPessoa-modal").modal()
	
			});

			$("#configurarProgramacaoServico-modal").modal()


		});

		$('#tbServicoProgramado tbody').on('click', 'td.removerValorAlteracao', function () {
			var tr = $(this).closest('tr');
			var row = optTbProgServico.row(tr);
			var data = row.data();
			var svacodigo = data.SVa_Codigo;
			swal({
					title: "Deseja realmente remover essa programação",
					type: 'warning',
					showCancelButton: true,
					confirmButtonColor: '#DD6B55',
					confirmButtonText: $_CONFIG.language.sim,
					cancelButtonText: $_CONFIG.language.nao,
					closeOnConfirm: true
				},
				function () {
					showLoader(true);
					$.ajax({
						dataType: 'json',
						method: 'POST',
						url: '/pages/cadastros/removeServicoValor.php',
						data: {
							svacodigo: svacodigo,
						},
						success: function (data) {
							if (data.data[0].erro == '0') {
								toastr['success'](data.data[0].resultado);
								$scope.buscaServicoProgramacao($('#serCodigoEdt').val())
							} else {
								toastr['error'](data.data[0].resultado);
							}
							showLoader(false);
						},
						error: function (result) {
							toastr.error($_CONFIG.language.errors.falha_conexao);
							showLoader(false);
						}
					});
				});
		});

		$('#tbServicoProgramado tbody').on('click', 'td.aplicaValorAlteracao', function () {
			var tr = $(this).closest('tr');
			var row = optTbProgServico.row(tr);
			var data = row.data();
			var svacodigo = data.SVa_Codigo;
			swal({
				title: "Aplicando Alteração!",
				text: "Ao aplicar a alteração, o valor do serviço e das associações configuradas serão ajustados permanentemente e a programação será encerrada. <br><br>Deseja continuar?",
				type: "warning",
				showCancelButton: true,
				confirmButtonText: "Sim",
				cancelButtonText: "Não",
				closeOnConfirm: true,
				closeOnCancel: true,
				html: true
			},
			function () {
				showLoader(true);
					$.ajax({
						dataType: 'json',
						method: 'POST',
						url: '/pages/cadastros/atualizaServicoValor.php',
						data: {
							svacodigo: svacodigo,
						},
						success: function (data) {
							if (data.data[0].erro == '0') {
								toastr['success'](data.data[0].resultado);
								$("#editar-modal").modal('hide')
								atualizaDados();
							} else {
								toastr['error'](data.data[0].resultado);
							}
							showLoader(false);
						},
						error: function (result) {
							toastr.error($_CONFIG.language.errors.falha_conexao);
							showLoader(false);
						}
					});
			});
		});

	}

	$scope.editaServicoValor = function(){

		showLoader(true);

		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/alteraServicoValor.php',
			data: {
				svacodigo: $("#svaCodigoEditar").val(),
				valor:($("#svaValorEDT").val()).replace(',','.'),
				dataini: ($("#DataProgramacaoEDT").val()).replace(',','.')
			},
			dataType: 'json',
			success: function (result) {

				if (result.data[0] == undefined) {
					toastr.error(result.data.resultado);
				} else {

					if (result.data[0].erro == '0') {
						$scope.buscaServicoProgramacao($('#serCodigoEdt').val())
						$("#editarProgramacaoServico-modal").modal('hide')
						toastr.success(result.data[0].resultado);
					} else {
						toastr.error(result.data[0].resultado);
					}
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
	}


	$scope.salvaConfiguracaoServicoPessoa = function(){
		showLoader(true);

		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/insereServicoValorPessoa.php',
			data: {
				psecodigo: $("#pseCodigoInsere").val(),
				valor:($("#svaValorServicoPessoa").val()).replace(',','.'),
