function buscaToken(token) {
    var resultado = 0;
    $.ajax({
        dataType: "json",
        url: getStorage("host"),
        data: {
            metodo: 'buscaTokenRevendedor',
            id: $_CONFIG.ID,
            token: token
        },
        success: function (data) {
            if (data.result[0].erro == "0") {
                sucessoToken($('#divToken'), $('#token'), $('#msgToken'));
            } else {
                erroToken($('#divToken'), $('#token'), $('#msgToken'), data.result[0].resultado);
            }
        },
        error: function (data) {
            limpaToken($('#divToken'), $('#token'), $('#msgToken'));
        }

    });
}

function buscaTokenPag(token, sercodigo) {
    var resultado = 0;
    $.ajax({
        dataType: "json",
        url: getStorage("host"),
        data: {
            metodo: 'buscaToken',
            id: $_CONFIG.ID,
            token: token,
            sercodigo: sercodigo
        },
        success: function (data) {
            if (data.result[0].erro == "0") {
                sucessoToken($('#divTokenPag'), $('#tokenPag'), $('#msgTokenPag'));
            } else {
                erroToken($('#divTokenPag'), $('#tokenPag'), $('#msgTokenPag'), data.result[0].resultado);
            }
        },
        error: function (data) {
            limpaToken($('#divTokenPag'), $('#tokenPag'), $('#msgTokenPag'));
        }
    });
}

function buscaTokenComEdit(token, codigo, tipo) {
    var resultado = 0;
    $("#spinnerid").show();
    $("#btnAlteraItemComanda").prop('disabled', true);
    $("#btnValidarToken").prop('disabled', true);
    if (tipo == 0) {
        $.ajax({
            dataType: 'json',
            url: getStorage('host'),
            data: {
                metodo: 'buscaToken',
                id: $_CONFIG.ID,
                token: token,
                procodigo: codigo
            },
            success: function (data) {
                if (data.result[0].erro == "0") {

                    sucessoToken($('#divTokenCom'), $('#tokenCom'), $('#msgTokenCom'));
                    $("#comDesconto").val(data.result[0].desconto);
                    $("input[name=tipoDesconto][value=0]").prop('checked', true);
                    $(".line").iCheck('update');
                    $("#comCortesia").prop('disabled', true);
                    $("#btnAlteraItemComanda").prop('disabled', false);
                    $('#comToken').prop('disabled', true);
                    calculaValor();
                } else {
                    $("#spinnerid").hide();
                    erroToken($('#divTokenCom'), $('#tokenCom'), $('#msgTokenCom'), data.result[0].resultado);
                    $("#btnAlteraItemComanda").prop('disabled', false);
                    $('#btnValidarToken').prop('disabled', false);
                    $("#comCortesia").prop('disabled', false);
                }
            },
            error: function (data) {
                limpaToken($('#divTokenCom'), $('#tokenCom'), $('#msgTokenCom'));
                $("#btnAlteraItemComanda").prop('disabled', false);
                $('#btnValidarToken').prop('disabled', false);
                $("#comCortesia").prop('disabled', false);
            }
        });
    } else {
        $.ajax({
            dataType: "json",
            url: getStorage("host"),
            data: {
                metodo: 'buscaToken',
                id: $_CONFIG.ID,
                token: token,
                sercodigo: codigo
            },
            success: function (data) {
                if (data.result[0].erro == "0") {
                    sucessoToken($('#divTokenCom'), $('#tokenCom'), $('#msgTokenCom'));
                    $("#comDesconto").val(data.result[0].desconto);
                    $("input[name=tipoDesconto][value=0]").prop('checked', true);
                    $(".line").iCheck('update');
                    $("#comCortesia").prop('disabled', true);
                    $("#btnAlteraItemComanda").prop('disabled', false);
                    $('#comToken').prop('disabled', true);
                    calculaValor();
                } else {
                    erroToken($('#divTokenCom'), $('#tokenCom'), $('#msgTokenCom'), data.result[0].resultado);
                    $("#btnAlteraItemComanda").prop('disabled', false);
                    $('#btnValidarToken').prop('disabled', false);
                    $("#comCortesia").prop('disabled', false);
                }
            },
            error: function (data) {
                limpaToken($('#divTokenCom'), $('#tokenCom'), $('#msgTokenCom'));
                $("#btnAlteraItemComanda").prop('disabled', false);
                $('#btnValidarToken').prop('disabled', false);
                $("#comCortesia").prop('disabled', false);
            }
        });
    }
}

function normalizaDataCupom(data) {
    if (data == undefined || data == null || data == "") {
        return "";
    }

    data = data.toString().trim();

    if (data.indexOf(" ") > -1) {
        data = data.split(" ")[0];
    }

    if (data.indexOf("-") > -1) {
        var partes = data.split("-");
        if (partes.length == 3) {
            return partes[2] + "/" + partes[1] + "/" + partes[0];
        }
    }

    return data;
}

function validaCupomComanda() {
    $("#spinnerCupomCom").show();
    $("#btnAlteraItemComanda").prop('disabled', true);
    $("#btnValidarCupom").prop('disabled', true);

    $.ajax({
        dataType: "json",
        url: "/pages/cadastros/validaCupomComanda.php",
        data: {
            type: 1,
            service: $('#comCodSerPro').val(),
            combo_code: '',
            coupon: $('#comCupom').val(),
            professional_code: $('#comCupomProfissional').val(),
            start_date: normalizaDataCupom($('#comCupomDataInicio').val()),
            establishment_code: $_CONFIG.CODESTABELECIMENTO
        },
        success: function (data) {
            var cupom = data.coupon && data.coupon.length > 0 ? data.coupon[0] : null;

            if (data.error === false && cupom != null && cupom.error == 0 && cupom.service_value !== "" && cupom.service_value != null) {
                var serviceValue = parseFloat(cupom.service_value.toString().replace(",", "."));
                if (!isNaN(serviceValue)) {
                    $("#comValorHd").val(serviceValue.toFixed(2));
                    calculaValor();
                }

                sucessoToken($('#divCupomCom'), $('#cupomCom'), $('#msgCupomCom'));
                $('#comCupom').prop('disabled', true);
                toastr.success(cupom.result || "Cupom validado.");
            } else {
                erroToken($('#divCupomCom'), $('#cupomCom'), $('#msgCupomCom'), (cupom && cupom.result) || data.message || "Cupom invÃ¡lido.");
            }
        },
        error: function () {
            limpaToken($('#divCupomCom'), $('#cupomCom'), $('#msgCupomCom'));
            toastr.error("Falha na conexÃ£o.");
        },
        complete: function () {
            $("#spinnerCupomCom").hide();
            $("#btnAlteraItemComanda").prop('disabled', false);
            if (!$('#divCupomCom').hasClass('has-success')) {
                $("#btnValidarCupom").prop('disabled', false);
            }
        }
    });
}

function buscaTokenCom(token, procodigo) {
    var resultado = 0;
    $("#spinneridinsert").show();
    $("#btnInsereItemComanda").prop('disabled', true);
    $("#btnValidarTokenInsert").prop('disabled', true);
    $.ajax({
        dataType: "json",
        url: getStorage("host"),
        data: {
            metodo: 'buscaToken',
            id: $_CONFIG.ID,
            token: token,
            procodigo: procodigo
        },
        success: function (data) {
            if (data.result[0].erro == "0") {
                $("#spinneridinsert").hide();
                sucessoToken($('#divTokenComInsert'), $('#tokenComInsert'), $('#msgTokenComInsert'));
                $("#comDescontoInsert").val(data.result[0].desconto);
                $("input[name=tipoDescontoInsert][value=0]").prop('checked', true);
                $(".lineInsert").iCheck('update');
                $("#comCortesiaInsert").prop('disabled', true);
                $("#btnInsereItemComanda").prop('disabled', false);
                $('#comTokenInsert').prop('disabled', true);
                calculaValorInsert();
            } else {
                $("#spinneridinsert").hide();
                erroToken($('#divTokenComInsert'), $('#tokenComInsert'), $('#msgTokenComInsert'), data.result[0].resultado);
                $("#btnInsereItemComanda").prop('disabled', false);
                $("#btnValidarTokenInsert").prop('disabled', false);
                $("#comCortesiaInsert").prop('disabled', false);
            }
        },
        error: function (data) {
            limpaToken($('#divTokenComInsert'), $('#tokenComInsert'), $('#msgTokenComInsert'));
            $("#btnInsereItemComanda").prop('disabled', false);
            $("#btnValidarTokenInsert").prop('disabled', false);
            $("#comCortesiaInsert").prop('disabled', false);
        }
    });
}

//Funções LocalStorage
function setStorage(name, val) {
    if (typeof (Storage) !== "undefined") {
        localStorage.setItem(name, val);
    } else {
        alert('Este navegador não é compatível');
    }
}

function getStorage(name) {
    if (typeof (Storage) !== "undefined") {
        return localStorage.getItem(name);
    } else {
        alert('Este navegador não é compatível');
    }
}

function removeStorage(name) {
    if (typeof (Storage) !== "undefined") {
        return localStorage.removeItem(name);
    } else {
        alert('Este navegador não é compatível');
    }
}

//Funções SessioStorage
function setSessionStorage(name, val) {
    if (typeof (Storage) !== "undefined") {
        sessionStorage.setItem(name, val);
    } else {
        alert('Este navegador não é compatível');
    }
}

function getSessionStorage(name) {
    if (typeof (Storage) !== "undefined") {
        return sessionStorage.getItem(name);
    } else {
        alert('Este navegador não é compatível');
    }
}

