function verificaConsumoPacote() {
    var registro = $("#pacotesComandaCombo option:selected").get(0);
    if (registro != undefined) {
        if ($("#pacotesComandaCombo").val() != "-1") {

            var valPercent = (registro.dataset.uso / registro.dataset.total) * 100;

            $("#pacotesComandaProgress").css("width", valPercent + "%");
            $("#pacotesComandaConsumo").html(registro.dataset.uso);
            $("#pacotesComandaTotal").html(registro.dataset.total);
            $("#pacotesComandaDataCompra").html(registro.dataset.cadastro);

            $("#divPacotesComandaProgress").show();
            $("#txtPacotesComandaDataCompra").show();
        } else {
            $("#divPacotesComandaProgress").hide();
            $("#txtPacotesComandaDataCompra").hide();
        }
    }
}

