}

function insereServicoComanda(origem) {
    $("#formInsereItemComandaSer").each(function () {
        this.reset();
    });
    $("#comHoraIni").select2("val", "");
    $("#btnInsereItemComandaSer").attr("disabled", false);

    var data = new Date()
    if (data.getMinutes() < 10) {
        var hora = data.getHours() + '0' + data.getMinutes();

    } else {
        var hora = data.getHours() + '' + data.getMinutes();
    }
    // var hora = data.getHours() + '' + data.getMinutes();
    var horas = new Array();
    for (var i = 0; i < $("#comHoraIni option").length; i++) {
        horas.push($("#comHoraIni option")[i].value.replace(':', ''))
    }
    var hour = getproxhora(horas, hora);

    $("#comHoraIni").val(hour.toString().splice(2, 0, ":"))
    $("#comHoraIni").change();

    if (origem == 1) {
        $("#insereServicoOrigem").val(1);
    } else {
        $("#insereServicoOrigem").val(0);
    }
    $.ajax({
        dataType: "json",
       // url: '/pages/cadastros/buscaServicoSelect.php',
        url: '/pages/cadastros/buscaServicoSelectCombo.php',
        success: function (result) {
            var combo = "";
            $("#comInsertServico").html('<option value =""  data-valor="" data-tipopreco="">Selecione um Serviço</option>');
            for (var i = 0; i < result.servicos.length; i++) {
                combo += '<option value =' + result.servicos[i].Ser_Codigo + ' data-valor="' + result.servicos[i].Ser_Valor + '" data-tipopreco="' + result.servicos[i].Ser_Tip_Preco + '" name="' + result.servicos[i].Ser_Duplo + '" data-tipoitem="'+result.servicos[i].TipoItem+'">' + result.servicos[i].Ser_Descricao + '</option>';
            }
            $("#comInsertServico").append(combo);
            $("#comInsertServico").select2({
                templateResult: thumbServico
            });
        }
    });

    $("#comCodigoInsertSer").val($("#idComanda").html());
    $("#comClienteInsertSer").val($("#codCliente").html());

    var dataatual = moment(formataData($("#dataComanda").html().split(" ")[0])).locale("pt-br").format("L");
    $("#comInsertServico").select2("val", "");
    $("#comInsertProfissional").select2("val", "");
    $('.divDataComanda').datepicker('update', dataatual);
    $("#comanda-modal").modal("hide");
    $("#comandaInsertSer-modal").modal("show");
}

function thumbServico(state) {
    if (!state.id) {
        return state.text;
    }

    if (((state.element.dataset.tipopreco == 'Igual a') || (state.element.dataset.tipopreco == 'A partir de')) && ((state.element.dataset.valor.length != 0))) {
        var $state = $(
            '<span>' + state.text + '<br><small style="color:#adadad">' + state.element.dataset.tipopreco + ' - ' + $_CONFIG.MOEDA + ' ' + state.element.dataset.valor + '</small></span>'
        );
    } else if (((state.element.dataset.tipopreco != 'Igual a') && (state.element.dataset.tipopreco != 'A partir de')) && ((state.element.dataset.valor.length != 0))) {
        var $state = $(
            '<span>' + state.text + '<br><small style="color:#adadad">' + $_CONFIG.MOEDA + ' ' + state.element.dataset.valor + '</small></span>'
        );
    } else {
        var $state = $(
            '<span>' + state.text + '</span>'
        );
    }

    return $state;
};

function getproxhora(arr, closestTo) {
    var closest = Math.max.apply(null, arr);

    for (var i = 0; i < arr.length; i++) {
        if (parseInt(arr[i]) >= parseInt(closestTo) && parseInt(arr[i]) < parseInt(closest)) closest = arr[i];
    }

    return closest;
}

