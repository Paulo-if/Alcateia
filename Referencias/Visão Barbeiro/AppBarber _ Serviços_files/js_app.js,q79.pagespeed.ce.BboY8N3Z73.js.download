                zoomable: false
            });
           setTimeout(function () {
               resizeContent();
           }, 1000);
        };
        reader.readAsDataURL(input.files[0]);
    }*/
    $('#imagemCut').cropper("destroy")
    if (input.files && input.files[0]) {

        if ((input.files[0].size / 1024) > 2048) {
            toastr.error("A imagem deve ter no máximo 2MB");
        } else {

            var reader = new FileReader();
            var relativeSize = 0;
            reader.onload = function (e) {
                var image = new Image();

                //Set the Base64 string return from FileReader as source.
                image.src = e.target.result;
                logoEmpresa = e.target.result;
                //Validate the File Height and Width.
                image.onload = function () {
                    if (window.innerHeight > window.innerWidth) {
                        relativeSize = window.innerWidth * 0.7;
                    } else if (window.innerHeight < window.innerWidth) {
                        relativeSize = window.innerHeight * 0.7;
                    } else {
                        relativeSize = window.innerHeight * 0.7;
                    }
                    // if (((this.width > this.height) && (this.width > 2000)) || ((this.width < this.height) && (this.height > 2000)) || ((this.width == this.height) && (this.width > 2000))) {
                    //     toastr.error("A imagem deve ter menos de 2000px de altura/largura");
                    // } else {
                        imagempessoa = e.target.result;
                        $("#cortaImagem-modal").modal();
                        $('#imagemCut').attr("src", logoEmpresa);
                        $('#imagemCut').cropper({
                            aspectRatio: 14 / 9,
                            guides: false,
                            background: false,
                            zoomable: false,
                            minContainerWidth: relativeSize,
                            minContainerHeight: relativeSize,
                            minCanvasWidth: relativeSize,
                            minCanvasHeight: relativeSize

                        });
                        // setTimeout(function () {
                        //     resizeContent();
                        // }, 1000);
                    // }

                }
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
}

