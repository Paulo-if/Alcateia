function PrintAgenda(title, elem) {
    if(localStorage.getItem('profissionais') != null){
        var professionals = localStorage.getItem('profissionais').split(',');
    }else{
        var professionals = localStorage.getItem(`profissionais_${$_CONFIG.CODESTABELECIMENTO}`).split(',');
    }
    var agendamentos = localStorage.getItem('agenda');

    agendamentos = JSON.parse(agendamentos);
    var arrhoras = [];
    $(".fc-agenda-axis").each(function () {
        if (!$(this).hasClass('fc-first')) {
            arrhoras.push($(this).text());
        }
    });
    var htmltable = ``;
    for (var i = 0; i < professionals.length; i++) {
        htmltable += `<table class="table table-striped" style="width: 100%;">`;
        var currentagenda = localStorage.getItem(`current_agenda_date`)
        var jornada = JSON.parse(localStorage.getItem(`jornada${professionals[i]}${currentagenda}`))
        jornada = jornada.jornada[0];

        if(jornada != undefined){

            htmltable += `<tr><th colspan="2">${jornada.Pes_Nome}</th></tr>`;

            arrhoras.forEach(function (t, index, arr) {
                if (t != "&nbsp;") {
                    var horario = '';
                    var thishorarios = t;
                    var color = '';
                    var nextSlot = 0;
                    var height = 30;
                    var width = 'width:92%;'
                    var border = 'border: blue;border-style: solid;border-width: 3px;'
                    var check = 0;
                    var checkjornada = 0;
                    var checkjornadaini2 = 0;
                    var position = "";
                    agendamentos.forEach(function (e) {
                        var id = `${e.start.split('T')[1].split(':')[0]}:${e.start.split('T')[1].split(':')[1]}`
                        var endser = parseInt(`${e.end.split('T')[1].split(':')[0]}${e.end.split('T')[1].split(':')[1]}`)
                        var endage = `${e.end.split('T')[1].split(':')[0]}:${e.end.split('T')[1].split(':')[1]}`

                        if (`${professionals[i]}td${thishorarios}` == `${e.resources}td${id}`) {

                            if (check == 0) {
                                if (e.Encaixe == 1) {
                                    width = "width:50%;margin-left:50%;z-index:1";
                                    border = 'border: red;border-style: solid;border-width: 3px;'
                                }


                                horario += `${id} - ${endage} - ${e.title}  `
                                color = e.color;
                                if (color != "") {
                                    position = 'position:absolute'
                                }
                                height = 30;
                                var j = 1;


                                while (nextSlot < endser) {
                                    nextSlot = parseInt((arr[index + j]).replace(':', ''))

                                    if (nextSlot > endser && parseInt((arr[(index + j) - 1]).replace(':', '')) < endser) {
                                        height = height - 15
                                        check = 0;
                                    }
                                    if (nextSlot < endser) {
                                        height = height + 40;
                                        j++
                                    }

                                }
                                check = 1;
                            } else {
                                var heightcheck = 30;
                                var jcheck = 1;
                                var nextSlotcheck = 0;
                                var widthcheck = 'width:92%;'
                                var bordercheck = 'border: blue;border-style: solid;border-width: 3px;'
                                var colorcheck = ''
                                var positioncheck = ''

                                while (nextSlotcheck < endser) {
                                    nextSlotcheck = parseInt((arr[index + jcheck]).replace(':', ''))

                                    if (nextSlotcheck > endser && parseInt((arr[(index + jcheck) - 1]).replace(':', '')) < endser) {
                                        heightcheck = heightcheck - 19
                                        check = 0;
                                    }
                                    if (nextSlotcheck < endser) {
                                        heightcheck = heightcheck + 40;
                                        jcheck++
                                    }

                                }
                                if (e.Encaixe == 1) {
                                    widthcheck = "width:50%;margin-left:50%;z-index:1";
                                    bordercheck = 'border: red;border-style: solid;border-width: 3px;'
                                }
                                colorcheck = e.color;
                                if (colorcheck != "") {
                                    positioncheck = 'position:absolute'
                                }
                                horario += `<div style="${bordercheck};height:${heightcheck}px; background-color:${colorcheck};${positioncheck};${widthcheck}"> ${id} - ${endage} - ${e.title}</div>`
                                check = 1;
                            }

                        }
                    })

                    if (check == 0) {
                        var nextSlot2 = 0;
                        var height2 = 30;
                        agendamentos.forEach(function (k) {


                            if (professionals[i] == k.resources) {
                                var startuncheck = parseInt(`${k.start.split('T')[1].split(':')[0]}${k.start.split('T')[1].split(':')[1]}`);
                                var idbreak = parseInt(`${k.start.split('T')[1].split(':')[0]}:${k.start.split('T')[1].split(':')[1]}`);
                                var horbreak = `${k.start.split('T')[1].split(':')[0]}:${k.start.split('T')[1].split(':')[1]}`;
                                var endbreak = `${k.start.split('T')[1].split(':')[0]}:${k.start.split('T')[1].split(':')[1]}`;
                                var endser2 = parseInt(`${k.end.split('T')[1].split(':')[0]}${k.end.split('T')[1].split(':')[1]}`)
                                if (arr[index + 1] != undefined) {
                                    if (startuncheck < parseInt((arr[index + 1]).replace(':', '')) && startuncheck > parseInt((t).replace(':', ''))) {

                                        var j2 = 1;

                                        if (parseInt((arr[index + 1 + j2]).replace(':', '')) > endser2) {
                                            height2 = height2 + 15;
                                        }
                                        while (nextSlot2 < endser2) {

                                            nextSlot2 = parseInt((arr[index + 1 + j2]).replace(':', ''))
                                            if (nextSlot2 < endser2) {
                                                height2 = height2 + 40;
                                                j2++
                                            } else if (endser2 == nextSlot2) {
                                                height2 = height2 + 20;
                                            } else if (nextSlot2 > endser2) {
                                                height2 = height2 - 15;
                                            }
                                        }
                                        if (horario != '') {
                                            horario += `<div style="margin-left: -4px;border: green;border-style: solid;border-width: 3px;height:${height2}px; background-color:${k.color};position:absolute;width:92%"> ${horbreak} - ${endbreak} - ${k.title}</div>`
                                        } else {
                                            horario = `<div style="margin-left: -4px;border: green;border-style: solid;border-width: 3px;height:${height2}px; background-color:${k.color};position:absolute;width:92%"> ${horbreak} - ${endbreak} - ${k.title}</div>`
                                        }

                                    }
                                }
                            }

                        })
                    }


                    var htmljornada = ``;

                    if (arr[index + 1] == jornada.PJo_Hor_Ini1) {

                        var j3 = index;
                        var back = 19;
                        var height3 = 30
                        while (j3 > 0) {
                            height3 = height3 + 40;
                            back = back + 40;
                            j3--;
                        }
                        htmljornada = `<div style="border: yellow;border-radius:5px;border-style: solid;border-width: 3px;margin-left: -4px;margin-top:-${back}px;height: ${height3}px; background-color:#444444;position:absolute;width:92%">00:00 - ${jornada.PJo_Hor_Ini1}</div>`;
                        checkjornada = 1;
                    }

                    if (jornada.PJo_Hor_Ini2 != "" && checkjornada == 0) {

                        if (thishorarios == jornada.PJo_Hor_Fim1) {

                            var j3 = index + 1;
                            var nextSlot3 = 0
                            var height3 = 30
                            var endJor = parseInt((jornada.PJo_Hor_Ini2).replace(':', ''))
                            while (nextSlot3 < endJor) {
                                nextSlot3 = parseInt((arr[j3]).replace(':', ''))
                                height3 = height3 + 40;

                                if (nextSlot3 > endJor && parseInt((arr[j3 - 1]).replace(':', '')) < endJor) {
                                    height3 = height3 - 59
                                }
                                j3++
                            }
                            htmljornada = `<div style="border: yellow;border-radius:5px;border-style: solid;border-width: 3pxmargin-left: -4px;margin-top:-18px;height: ${height3}px; background-color:#444444;position:absolute;width:92%">${jornada.PJo_Hor_Fim1} - ${jornada.PJo_Hor_Ini2}</div>`;
                            checkjornada = 1;
                        } else if (thishorarios == jornada.PJo_Hor_Fim2) {

                            var j4 = index;
                            var back = 59;
                            var height4 = 30
                            while ((arr[j4]).length > 1) {
                                if (arr[j4 + 1] == undefined) {
                                    break;
                                }
                                height4 = height4 + 40;

                                j4++


                            }
                            htmljornada = `<div style="border: yellow;border-radius:5px;border-style: solid;border-width: 3px;margin-left: -4px;margin-top:-18px;height: ${height4}px; background-color:#444444;position:absolute;width:92%">${jornada.PJo_Hor_Fim2} - 23:59</div>`;
                            checkjornada = 1;
                        }
                    } else if (thishorarios == jornada.PJo_Hor_Fim1) {

                        var j4 = index;
                        var back = 59;
                        var height4 = 30
                        while ((arr[j4]).length > 1) {
                            if (arr[j4 + 1] == undefined) {
                                break;
                            }
                            height4 = height4 + 40;

                            j4++


                        }
                        htmljornada = `<div style="border: yellow;border-radius:5px;border-style: solid;border-width: 3px;margin-left: -4px;margin-top:-18px;height: ${height4}px; background-color:#444444;position:absolute;width:92%">${jornada.PJo_Hor_Fim1} - 23:59</div>`;
                        checkjornada = 1;
                    }


                    if (checkjornada == 0) {
                        var idjornada = parseInt((jornada.PJo_Hor_Ini1).replace(':', ''));
                        var idHorario = parseInt((arr[index]).replace(':', ''));
                        if (arr[index + 1] != undefined) {
                            var idHorarionext = parseInt((arr[index + 1]).replace(':', ''));
                        } else {
                            var idHorarionext = parseInt((arr[index]).replace(':', ''));
                        }


                        if (idjornada > idHorario && idjornada < idHorarionext) {

                            var j5 = index;
                            var height5 = 19;
                            var back2 = 19;
                            while ((arr[j5]).length > 1) {
                                if ((j5 - 1) == (-1)) {
                                    break
                                }

                                height5 = height5 + 40;
                                back2 = back2 + 40;
                                j5--


                            }
                            htmljornada = `<div style="border: yellow;border-radius:5px;border-style: solid;border-width: 3px;margin-left: -4px;margin-top:-${back2}px;height: ${height5}px; background-color:#444444;position:absolute;width:92%">00:00 - ${jornada.PJo_Hor_Ini1}</div>`;
                            checkjornada = 1;

                        } else if (jornada.PJo_Hor_Ini2 != "") {

                            idjornada = parseInt((jornada.PJo_Hor_Fim1).replace(':', ''));

                            if (idjornada > idHorario && idjornada < idHorarionext) {

                                var endJor = parseInt((jornada.PJo_Hor_Ini2).replace(':', ''))

                                var j5 = index + 1;
                                var nextSlot5 = parseInt((arr[j5]).replace(':', ''))

                                var height5 = 0;
                                if (idHorarionext > endJor) {
                                    height5 = 19;
                                }

                                while (nextSlot5 < endJor) {
                                    nextSlot5 = parseInt((arr[j5]).replace(':', ''))

                                    if (nextSlot5 < endJor) {
                                        height5 = height5 + 40;
                                        if (nextSlot5 == endJor) {
                                            height5 = height5 - 19;
                                        }
                                        j5++

                                    } else {
                                        break;
                                    }

                                }

                                htmljornada = `<div style="border: yellow;border-radius:5px;border-style: solid;border-width: 3px;margin-left: -4px;height: ${height5}px; background-color:#444444;position:absolute;width:92%">${jornada.PJo_Hor_Fim1} - ${jornada.PJo_Hor_Ini2}</div>`;
                                checkjornada = 1;
                            } else {
                                idjornada = parseInt((jornada.PJo_Hor_Fim2).replace(':', ''));
                                if (idjornada > idHorario && idjornada < idHorarionext) {

                                    var j5 = index;
                                    var back2 = 59;
                                    var height5 = 30
                                    while ((arr[j5]).length > 1) {

                                        if (arr[j5 + 1] == undefined) {
                                            height5 = height5 - 19;
                                            break;
                                        }
                                        height5 = height5 + 40;

                                        j5++


                                    }
                                    htmljornada = `<div style="border: yellow;border-radius:5px;border-style: solid;border-width: 3px;margin-left: -4px;height: ${height5}px; background-color:#444444;position:absolute;width:92%">${jornada.PJo_Hor_Fim2} - 23:59</div>`;
                                    checkjornada = 1;
                                }
                            }
                        } else {
                            idjornada = parseInt((jornada.PJo_Hor_Fim1).replace(':', ''));
                            if (idjornada > idHorario && idjornada < idHorarionext) {

                                var j5 = index;
                                var back2 = 59;
                                var height5 = 30
                                while ((arr[j5]).length > 1) {
                                    if (arr[j5 + 1] == undefined) {
                                        height5 = height5 - 19;
                                        break;
                                    }
                                    height5 = height5 + 40;

                                    j5++


                                }
                                htmljornada = `<div style="border: yellow;border-radius:5px;border-style: solid;border-width: 3px;margin-left: -4px;height: ${height5}px; background-color:#444444;position:absolute;width:92%">${jornada.PJo_Hor_Fim1} - 23:59</div>`;
                                checkjornada = 1;
                            }
                        }

                    }

                    var dinamCss = `height: ${height}px;${border};${position};`
                    if (height > 30) {
                        dinamCss = `height: ${height}px;${border}; position:absolute`
                    }
                    htmltable += `<tr>
                                    <th id="${professionals[i]}th${thishorarios}" style="border: blue;border-style: solid;border-width: 3px;height: 38px;width:5%" >
                                        ${thishorarios}
                                    </th>
                                    <td id="${professionals[i]}td${thishorarios}"  style="background-color: ${color};${width};${dinamCss}">
                                        ${htmljornada}${horario}
                                    </td>
                                </tr>`
                }
            })


            htmltable += `</table><div style="break-after:page"></div>`;
        }
    }


    Popup('Agenda', htmltable)

}

function Popup(title, data) {

    var mywindow = window.open('', 'Imprimir Agenda', 'height=600,width=800');
    mywindow.document.write('<html><head><title>' + title + '</title>');
    mywindow.document.write('<style>@media print {   body {-webkit-print-color-adjust: exact;}}</style>');


    mywindow.document.write('</head><body onload="window.print(); window.close();" style="width:1366px">');

    mywindow.document.write(data);
    mywindow.document.write('</body></html>');
    mywindow.document.close();
    mywindow.focus();
    return true;
}

function PrintComanda(data) {
    var tpPagCount = $('#variostiposdepagamento').children().length - 1;
    var totCom = $("#valorTotalComanda").html();
    var vlrPago = $("#comValorTotal").html();
    var selVezesParcela = $("#selVezesParcela option:selected").text();
    var selPeriodicidadeVenda = $("#selPeriodicidadeVenda option:selected").text();
    if ($("#edtComCartao").val() != "") {
        var numeroCartao = "Cartão: " + $("#edtComCartao").val();
    } else {
        var numeroCartao = "";
    }
    var isParcelado = "";

    if ($("#parcelarCaixa").get(0).checked) {
        isParcelado = "Sim";
    } else {
        isParcelado = "Não";
    }

    var html = "";
    for (var i = 0; i < tpPagCount; i++) {
        var vlrPgtoText = $("#valorPagamento" + i).val();
        var tpPgtoText = $("#tipoPagamento" + i + "  option:selected").text();
        var bandPgtoText = $("#divBandeiraPag" + i + "  option:selected").text();
        html += '<tr>';
        html += '<td>';
        html += tpPgtoText;
        html += '</td>';
        html += '<td>';
        html += bandPgtoText;
        html += '</td>';
        html += '<td>';
        html += vlrPgtoText;
        html += '</td>';
        html += '</tr>';
    }

    html2 = '<tr>';
    html2 += '<th>Total da Comanda:</th>';
    html2 += '<td>' + totCom + '</td>';
    html2 += '</tr>';
    html2 += '<tr>';
    html2 += '<th>Valor Pago:</th>';
    html2 += '<td>' + vlrPago + '</td>';
    html2 += '</tr>';
    html2 += '<tr>';
    html2 += '<th>Parcelado?</th>';
    html2 += '<td>' + isParcelado + '</td>';
    html2 += '</tr>';
    if ($("#parcelarCaixa").get(0).checked) {
        html2 += '<tr>';
        html2 += '<th>Qtd de Parcelas</th>';
        html2 += '<td>' + selVezesParcela + '</td>';
        html2 += '</tr>';
        html2 += '<tr>';
        html2 += '<th>Periodicidade</th>';
        html2 += '<td>' + selPeriodicidadeVenda + '</td>';
        html2 += '</tr>';
    }

    var title = "Comanda " + $("#idComanda").html();

    var mywindow = window.open('', 'Imprimir Comanda', 'height=600,width=800');
    mywindow.document.write('<html><head><title>' + title + '</title>');
    mywindow.document.write('<link rel="stylesheet" href="https://d3verit7xckkza.cloudfront.net/css/bootstrap.css"/>');
    mywindow.document.write('<link rel="stylesheet" media="print" href="https://d3verit7xckkza.cloudfront.net/css/onlyprint.css"/>');
    mywindow.document.write('<link rel="stylesheet" href="https://d3verit7xckkza.cloudfront.net/css/ionicons.min.css"/>');
    mywindow.document.write('</head><body onload="tipoPagamento(); window.print();window.close();">');
    mywindow.document.write(data);
    mywindow.document.write('<script>');
    mywindow.document.write('function tipoPagamento(){ document.getElementById("rowResumoPag").innerHTML = "' + html2 + '"; document.getElementById("printCartaoExterno").innerHTML = "' + numeroCartao + '"; document.getElementById("rowsTpPag").innerHTML = "' + html + '";}');
    mywindow.document.write('</scr' + 'ipt>');

    mywindow.document.write('</body></html>');
    mywindow.document.close();
    mywindow.focus();

    return true;
}

