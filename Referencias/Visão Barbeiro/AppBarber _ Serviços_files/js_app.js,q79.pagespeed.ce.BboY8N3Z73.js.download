function buscaClientes(callback, pos, nisToday) {
    var isToday = true;
    if (typeof (nisToday) !== 'undefined') {
        isToday = nisToday;
    }
    var html = "";

    if (hasManyClients && (pos == undefined || pos == '' || pos == 1)) {
        $('.selectConectado').select2({
            ajax: {
                url: localStorage.getItem('host'),
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        nome: params.term,
                        metodo: 'buscaClientes_v4',
                        tipo: 5,
                        id: $_CONFIG.ID
                    };
                },
                processResults: function (data, params) {
                    return {
                        results: data.result
                    };
                },
                cache: true
            },
            escapeMarkup: function (markup) {
                return markup;
            },
            minimumInputLength: 3,
            templateResult: thumbClienteMany,
            templateSelection: thumbClienteMany
        });
        callback(pos, isToday);
    } else {

        $.ajax({
            dataType: "json",
            url: '/pages/cadastros/buscaClientesSelect.php',
            success: function (data) {
                if (data.result.length > 0) {
                    for (var i = 0; i < data.result.length; i++) {
                        var cliente = data.result[i]
                        html += '<option data-codigo="' + cliente.Pes_Codigo + '" data-conectado="' + cliente.UDi_Conectado + '" value="' + cliente.Usu_Codigo + '">' + cliente.Pes_Nome + '</option>';
                    }
                    $("#msgUsuario").html(html);
                    $(".selectConectado").select2({
                        templateResult: thumbCliente,
                        templateSelection: thumbCliente,
                        maximumSelectionLength: 50,
                        language: {
                            maximumSelected: function (e) {

                                var htmlAviso = `
                                    <p>O número máximo de clientes permitidos por envio é <strong>${e.maximum}</strong>.</p><br>
                                    <p> Caso necessite enviar para todos clientes, utilize a opção <strong class="text-green">Notícias</strong> </p><br>
                                    <p> <h4>Maiores dúvidas, acesse nossa <strong><a target="_blank" href="https://appbarber-appbeleza.zendesk.com/hc/pt-br/articles/360002981011-Qual-a-diferen%C3%A7a-entre-Envio-de-Not%C3%ADcias-e-Envio-de-Mensagem">Central de Ajuda</a></strong>.</h4></p>
                                `;
                                swal({
                                    title: "Limite de Clientes para Envio.",
                                    text: htmlAviso,
                                    html: true,
                                    type: "warning",
                                });
                                
                                

                                return '';
                            }
                        }
                    });
                    callback(pos, isToday);
                }
            }
        });
    }
}

function thumbCliente(state) {
    if (!state.id) {
        return state.text;
    }
    return state.text;
}

function thumbClienteMany(state) {

    if (state.Pes_Nome != undefined) {

        if (!state.id) {
            return state.Pes_Nome;
        }

        var $state = $(
            '<span>' + state.Pes_Nome + '</span>'
        );
    } else {
        if (!state.id) {
            return state.text;
        }
        var $state = $(
            '<span>' + state.text + '</span>'
        );
    }

    return $state;
}

