(function () {

    var sessionID, nsessionID;
    if (getStorage("lsID") == null) {
        setStorage("lsID", 0);
    }

    sessionID = parseInt(getStorage("lsID"));
    nsessionID = sessionID + 1;
    setStorage("lsID", nsessionID);
    setSessionStorage("lsID", nsessionID);

    oneSessionInterval = setInterval(
        function () {
            if (haveAnother()) {
                $("#introTitulo").html("");
                $("#introMensagem").html("Existe outra aba do sistema aberta.");
                $(".loaderMsg").fadeIn('slow', function () {
                    $("header").addClass("blurBackground");
                    $(".wrapper").addClass("blurBackground");
                });
                updateSchedule = false;
                clearInterval(oneSessionInterval);
            }
        },
        5000
    );
})();

$(window).bind('beforeunload', function (eventObject) {
    if (getStorage("lsID") != null) {
        var lsID = parseInt(getStorage("lsID"));
        var nlsID = lsID - 1;
        setStorage("lsID", nlsID);
    }
});

