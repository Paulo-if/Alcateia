    $.ajax({
        type: "POST",
        url: "php/alternar.php",
        data: {
            origem: location.host,
            pescodigoempresa: pescodigo,
            userid: email,
            showOrNotShowInfoDates: (localStorage.getItem('notShowInfoDates') != undefined && localStorage.getItem('notShowInfoDates') == 'true') ? "notShow" : "show"
        },
        dataType: "json",
        success: function (result) {

            if (typeof (result.login) != "undefined") {
                var dados = result.login;
            } else {
                var dados = result.result;
            }
            if (dados[0].erro == "0") {
                window.location.assign(dados[0].resultado);
            } else {
                swal(dados[0].resultado, "", "error");
            }
        },
        error: function (result) {
            swal("Falha na conexão.", "", "error");
        }
    });

}

function formatCardNumber(cardnumber) {
    if (typeof (cardnumber) == 'string' && cardnumber.length == 16) {
        var card = cardnumber.substring(0, 6) + "******" + cardnumber.substring(12, 16);
        return card.toString();
    } else {
        return cardnumber.toString();
    }
};

function encode_utf8(s) {
    return unescape(encodeURIComponent(s));
  }
  
  function decode_utf8(s) {
    return decodeURIComponent(escape(s));
  }

$("#combologinmenu").change(function () {
    loginmenu($("#combologinmenu").val(), $("#combologinmenu option:selected").get(0).dataset.email);
})

$("#document_number_empresa_pf").mask("999.999.999-99");
$("#document_number_empresa_pj").mask("99.999.999/9999-99");
$("#sel_pessoa_contratacao").change(function () {

    if ($("#sel_pessoa_contratacao").val() == "PF") {
        $("#fields_pj").hide();
        $("#fields_pf").show();
    } else {
        $("#fields_pj").show();
        $("#fields_pf").hide();
    }
});
function getAllParameters(){
    var params ='';
    $.ajax({
        dataType: "json",
        url: '/pages/cadastros/PARAMETRO_Busca.php',
        method: "POST",
        async:false,
        data: {
            type: 4
        },
        success: function (data) {
            params = data.data
        }
    });

    return params
}


function changeCpfCnpjContratar(tipo) {
    if (tipo == 1) {
        $("#tipocampoCPFContratar").val(1)
        $("#btnCpfCnpjContratar").html("CPF");
        $("#document_number_empresa").val('');
        $("#document_number_empresa").attr('maxlength', '14')
        $("#document_number_empresa").attr('placeholder', 'CPF')
    } else {
        $("#tipocampoCPFContratar").val(2)
        $("#btnCpfCnpjContratar").html("CNPJ")
        $("#document_number_empresa").val('');
        $("#document_number_empresa").attr('placeholder', 'CNPJ')
        $("#document_number_empresa").attr('maxlength', '18')
    }
}

$("#document_number_empresa").keypress(function () {
    if ($("#tipocampoCPFContratar").val() == '1') {
        mascara(this, soCpf);
    } else {
        mascara(this, soCnpj)
    }
});


$(function () {

    $(".select2").select2();

    $('input:radio[name=iCheckPag]').iCheck({
        checkboxClass: 'icheckbox_square',
        radioClass: 'iradio_square-green',
        increaseArea: '20%'
    }).on('ifClicked', function (event) {
        if (this.dataset.text == "Token") {
            $("#divTokenPag").show();
            $("#divValorPag").hide();
        } else {
            $("#divTokenPag").hide();
            $("#divValorPag").show();
        }

        if (this.dataset.cartao == "1") {
            $("#divBandeiraPag").show();
        } else {
            $("#divBandeiraPag").hide();
        }
    });

    $("input[name=tipoPgto]").iCheck({
        checkboxClass: 'icheckbox_square',
        radioClass: 'iradio_square-green',
        increaseArea: '20%'
    }).on('ifClicked', function (event) {
        if (this.value == "1") {
            $("#divBoleto").show();
            $("#divCreditCard").hide();
            $("#divPIX").hide();
            $("#numParcelas").val(1);
        } else if (this.value == "3") {
            $("#divBoleto").hide();
            $("#divCreditCard").hide();
            $("#numParcelas").val(1);
            $("#divPIX").show();
        } else {
            $("#divBoleto").hide();
            $("#divPIX").hide();
            $("#divCreditCard").show();
        }
    });

    $_CONFIG.BRANDS = {
        "elo": "https://d3verit7xckkza.cloudfront.net/imgsystem/cards/elo.png",
        "discover": "https://d3verit7xckkza.cloudfront.net/imgsystem/cards/discover.png",
        "diners": "https://d3verit7xckkza.cloudfront.net/imgsystem/cards/diners.png",
        "amex": "https://d3verit7xckkza.cloudfront.net/imgsystem/cards/amex.png",
        "jcb": "https://d3verit7xckkza.cloudfront.net/imgsystem/cards/jcb.png",
        "hipercard": "https://d3verit7xckkza.cloudfront.net/imgsystem/cards/hipercard.png",
        "visa": "https://d3verit7xckkza.cloudfront.net/imgsystem/cards/visa.png",
        "mastercard": "https://d3verit7xckkza.cloudfront.net/imgsystem/cards/mastercard.png"
    };

    setTimeout(function () {
        $App.buscaAcao();
    }, 5000);
});
var zip = new JSZip();
const workerCode = `
    self.onmessage = async function (event) {
        if (event.data != [] && event.data != undefined) {

            var promisses = [];
            for (let index = 0; index < event.data.length; index++) {
                var p = '';
                var nomearquivo = event.data[index][0]
                const response = await fetch(event.data[index][1]);
                const xmlText = await response.text();
                promisses[index] = [nomearquivo,xmlText];
                await delay(1000)
            }
            self.postMessage(promisses)
        }

    }
    function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
    };
`;

const blob = new Blob([workerCode], { type: "application/javascript" });
var worker = new Worker(URL.createObjectURL(blob));
