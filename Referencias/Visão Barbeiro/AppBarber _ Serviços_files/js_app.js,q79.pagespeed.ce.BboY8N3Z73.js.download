    mywindow.document.write('<link rel="stylesheet" href="https://d3verit7xckkza.cloudfront.net/css/ionicons.min.css"/>');
    mywindow.document.write('</head><body style= "" onload="window.print();window.close();">');
    mywindow.document.write(title);
