$.fn.modal.Constructor.prototype.enforceFocus = function () {};

$.fn.dataTable.moment = function (format, locale) {
    var types = $.fn.dataTable.ext.type;

    types.detect.unshift(function (d) {
        return moment(d, format, locale, true).isValid() ?
            'moment-' + format :
            null;
    });

    types.order['moment-' + format + '-pre'] = function (d) {
        return moment(d, format, locale, true).unix();
    };
};

$.fn.regexMask = function (mask) {
    $(this).keypress(function (event) {
        if (!event.charCode) return true;
        var part1 = this.value.substring(0, this.selectionStart);
        var part2 = this.value.substring(this.selectionEnd, this.value.length);
        if (!mask.test(part1 + String.fromCharCode(event.charCode) + part2))
            return false;
    });
};

Number.prototype.formatMoney = function (c, d, t) {
    var n = this,
        c = isNaN(c = Math.abs(c)) ? 2 : c,
        d = d == undefined ? "." : d,
        t = t == undefined ? "," : t,
        s = n < 0 ? "-" : "",
        i = parseInt(n = Math.abs(+n || 0).toFixed(c)) + "",
        j = (j = i.length) > 3 ? j % 3 : 0;
    return s + (j ? i.substr(0, j) + t : "") + i.substr(j).replace(/(\d{3})(?=\d)/g, "$1" + t) + (c ? d + Math.abs(n - i).toFixed(c).slice(2) : "");
};

String.prototype.formatMoney = function () {
    var v = this;
    if (v.indexOf('.') === -1) {
        v = v.replace(/([\d]+)/, "$1,00");
    }

    v = v.replace(/([\d]+)\.([\d]{2})/g, "$1,$2");
    v = v.replace(/([\d]+)\.([\d]{1})/g, "$1,$20");
    return $_CONFIG.language.moeda + " " + v;
};

String.prototype.formatMoney2 = function () {
    var v = this;
    if (v.indexOf('.') === -1) {
        v = v.replace(/([\d]+)/, "$1,00");
    }

    v = v.replace(/([\d]+)\.([\d]{2})/g, "$1,$2");
    v = v.replace(/([\d]+)\.([\d]{1})/g, "$1,$20");
    return $_CONFIG.language.moeda + " " + v;
};

String.prototype.formatMoneyPlan = function () {
    var v = this;
    if (v.indexOf('.') === -1) {
        v = v.replace(/([\d]+)/, "$1,00");
    }

    v = v.replace(/([\d]+)\.([\d]{2})/g, "$1,$2");
    v = v.replace(/([\d]+)\.([\d]{1})/g, "$1,$20");
    return "R$ " + v;
};

String.prototype.replaceAll = String.prototype.replaceAll || function (needle, replacement) {
    return this.split(needle).join(replacement);
};

function interpret(s) {
    var aux = encodeURI(s);
    return decodeURI(aux);
};

function unescapeUnicode(str) {
    return str.replace(/\\u([a-fA-F0-9]{4})/g, function (g, m1) {
        return String.fromCharCode(parseInt(m1, 16));
    });
}

String.prototype.extenso = function (c) {
    var ex = [
        ["zero", "um", "dois", "três", "quatro", "cinco", "seis", "sete", "oito", "nove", "dez", "onze", "doze", "treze", "quatorze", "quinze", "dezesseis", "dezessete", "dezoito", "dezenove"],
        ["dez", "vinte", "trinta", "quarenta", "cinquenta", "sessenta", "setenta", "oitenta", "noventa"],
        ["cem", "cento", "duzentos", "trezentos", "quatrocentos", "quinhentos", "seiscentos", "setecentos", "oitocentos", "novecentos"],
        ["mil", "milhão", "bilhão", "trilhão", "quadrilhão", "quintilhão", "sextilhão", "setilhão", "octilhão", "nonilhão", "decilhão", "undecilhão", "dodecilhão", "tredecilhão", "quatrodecilhão", "quindecilhão", "sedecilhão", "septendecilhão", "octencilhão", "nonencilhão"]
    ];
    var a, n, v, i, n = this.replace(c ? /[^,\d]/g : /\D/g, "").split(","),
        e = " e ",
        $ = "real",
        d = "centavo",
        sl;
    for (var f = n.length - 1, l, j = -1, r = [], s = [], t = ""; ++j <= f; s = []) {
        j && (n[j] = (("." + n[j]) * 1).toFixed(2).slice(2));
        if (!(a = (v = n[j]).slice((l = v.length) % 3).match(/\d{3}/g), v = l % 3 ? [v.slice(0, l % 3)] : [], v = a ? v.concat(a) : v).length) continue;
        for (a = -1, l = v.length; ++a < l; t = "") {
            if (!(i = v[a] * 1)) continue;
            i % 100 < 20 && (t += ex[0][i % 100]) ||
                i % 100 + 1 && (t += ex[1][(i % 100 / 10 >> 0) - 1] + (i % 10 ? e + ex[0][i % 10] : ""));
            s.push((i < 100 ? t : !(i % 100) ? ex[2][i == 100 ? 0 : i / 100 >> 0] : (ex[2][i / 100 >> 0] + e + t)) +
                ((t = l - a - 2) > -1 ? " " + (i > 1 && t > 0 ? ex[3][t].replace("ão", "ões") : ex[3][t]) : ""));
        }
        a = ((sl = s.length) > 1 ? (a = s.pop(), s.join(" ") + e + a) : s.join("") || ((!j && (n[j + 1] * 1 > 0) || r.length) ? "" : ex[0][0]));
        a && r.push(a + (c ? (" " + (v.join("") * 1 > 1 ? j ? d + "s" : (/0{6,}$/.test(n[0]) ? "de " : "") + $.replace("l", "is") : j ? d : $)) : ""));
    }
    return r.join(e);
};

String.prototype.splice = function (idx, rem, str) {
    return this.slice(0, idx) + str + this.slice(idx + Math.abs(rem));
};




function formataValorDinheiro(el) {

    if (el.value == '' || el.value == '0') {
        el.value = 0.00;
    } else {
        var valaux = el.value.replace('R$', '').replace(',', '').split('.').join('');
        var valor = parseFloat(valaux) / 100;
        if (isNaN(valor)) {
            valor = 0.00;
        }
        el.value = valor.toFixed(2);
        $(el).change();
    }
}

function fix_sidebar() {
    if (!$('body').hasClass('fixed')) {
        return;
    }

    $('.sidebar').slimscroll({
        height: ($(window).height() - $('.header').height()) + 'px',
        color: '#ffcc00',
        size: '10px',
    });

    $('.rightbar').slimscroll({
        height: ($(window).height() - $('.header').height()) + 'px',
        color: 'rgba(0,255,0)',
        size: '10px'
    });
}

function buscaPlanos(sistema, codigo, tipocodigo, tabela) {
    $.ajax(
        /*{
                dataType: 'json',
                url: getStorage('host'),
                data: {
                    metodo: 'buscaPlanos',
                    tipo: '5',
                    sistema: sistema,
                    token: codigo
                },*/
        {
            method: "POST",
            dataType: "json",
            url: '/pages/cadastros/buscaplanov2.php',
            data: {
                tipo: 1,
                siscodigo: sistema,
                token: codigo,
                placodigo: "",
                tipobusca: tipocodigo
            },
            success: function (data) {
                planos = data.result;
                if (data.result.length > 0) {
                    var arr1 = _.where(planos, {
                        Pla_Num_Profissionais: '1 Profissional'
                    });
                    var arr2 = _.where(planos, {
                        Pla_Num_Profissionais: '2 a 5 Profissionais'
                    });
                    var arr3 = _.where(planos, {
                        Pla_Num_Profissionais: '6 a 15 Profissionais'
                    });
                    var arr4 = _.where(planos, {
                        Pla_Num_Profissionais: 'Mais de 15 Profissionais'
                    });
                    var html = '';
                    var tr = '<tr><th style="width: 10%;">Profissionais</th>';

                    if (data.result[0].Promo == '1') {
                        $('#divTokenPlano').show();
                    } else {
                        $('#divTokenPlano').hide();
                    }

                    if (arr1.length > 0) {

                        html += '<tr>';
                        html += '<td>1</td>';
                        arr1.forEach(function (d, idx) {
                            if (d.Pla_Descricao == 'Mensal') {
                                tr += '<th style="width: 30%;">Mensal</th>';
                            } else if (d.Pla_Descricao == 'Semestral') {
                                tr += '<th style="width: 30%;">Semestral (Até 6x no Cartão de Crédito)</th>';
                            } else if (d.Pla_Descricao == 'Anual') {
                                tr += '<th style="width: 30%;">Anual (Até 12x no Cartão de Crédito)</th>';
                            }
                            html += '<td><label>';
                            if (typeof (d.Desconto) === 'undefined' || d.Desconto == '') {
                                html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Pla_Valor + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="" class="minimal" value="' + d.Pla_Codigo + '"/> R$ ' + d.Pla_Valor;
                            } else {
                                if (typeof (d.MostrarDesconto) === 'undefined' || d.MostrarDesconto == '0') {
                                    html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Valor_Desconto + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="" class="minimal" value="' + d.Pla_Codigo + '"/>R$ ' + d.Valor_Desconto;
                                } else {
                                    html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Valor_Desconto + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="' + d.Desconto + '" class="minimal" value="' + d.Pla_Codigo + '"/><del> R$ ' + d.Pla_Valor + '</del> - R$ ' + d.Valor_Desconto;
                                }
                            }
                            html += '</label></td>';
                        });
                        html += '</tr>';
                    }

                    if (arr2.length > 0) {
                        html += '<tr>';
                        html += '<td>2 a 5</td>';
                        arr2.forEach(function (d, idx) {
                            html += '<td><label>';
                            if (typeof (d.Desconto) === 'undefined' || d.Desconto == '') {
                                html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Pla_Valor + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="" class="minimal" value="' + d.Pla_Codigo + '"/> R$ ' + d.Pla_Valor;
                            } else {
                                if (typeof (d.MostrarDesconto) === 'undefined' || d.MostrarDesconto == '0') {
                                    html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Valor_Desconto + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="" class="minimal" value="' + d.Pla_Codigo + '"/>R$ ' + d.Valor_Desconto;
                                } else {
                                    html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Valor_Desconto + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="' + d.Desconto + '" class="minimal" value="' + d.Pla_Codigo + '"/><del> R$ ' + d.Pla_Valor + '</del> - R$ ' + d.Valor_Desconto;
                                }
                            }
                            html += '</label></td>';
                        });
                        html += '</tr>';
                    }

                    if (arr3.length > 0) {
                        html += '<tr>';
                        html += '<td>6 a 15</td>';
                        arr3.forEach(function (d, idx) {
                            html += '<td><label>';
                            if (typeof (d.Desconto) === 'undefined' || d.Desconto == '') {
                                html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Pla_Valor + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="" class="minimal" value="' + d.Pla_Codigo + '"/> R$ ' + d.Pla_Valor;
                            } else {
                                if (typeof (d.MostrarDesconto) === 'undefined' || d.MostrarDesconto == '0') {
                                    html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Valor_Desconto + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="" class="minimal" value="' + d.Pla_Codigo + '"/>R$ ' + d.Valor_Desconto;
                                } else {
                                    html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Valor_Desconto + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="' + d.Desconto + '" class="minimal" value="' + d.Pla_Codigo + '"/><del> R$ ' + d.Pla_Valor + '</del> - R$ ' + d.Valor_Desconto;
                                }
                            }
                            html += '</label></td>';
                        });
                        html += '</tr>';
                    }

                    if (arr4.length > 0) {

                        html += '<tr>';
                        html += '<td>Mais de 15</td>';
                        arr4.forEach(function (d, idx) {

                            html += '<td><label>';
                            if (typeof (d.Desconto) === 'undefined' || d.Desconto == '') {
                                html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Pla_Valor + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="" class="minimal" value="' + d.Pla_Codigo + '"/> R$ ' + d.Pla_Valor;
                            } else {
                                if (typeof (d.MostrarDesconto) === 'undefined' || d.MostrarDesconto == '0') {
                                    html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Valor_Desconto + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="" class="minimal" value="' + d.Pla_Codigo + '"/>R$ ' + d.Valor_Desconto;
                                } else {
                                    html += '<input type="radio" name="cbPlano" data-sistema="' + d.Pla_Sistema + '" data-numprof="' + d.Pla_Num_Profissionais + '" data-periodo="' + d.Pla_Descricao + '" data-parcelado="' + d.Pla_Parcelado + '" data-valor="' + d.Valor_Desconto + '" data-plano="' + d.Pla_PagarMe + '" data-desconto="' + d.Desconto + '" class="minimal" value="' + d.Pla_Codigo + '"/><del> R$ ' + d.Pla_Valor + '</del> - R$ ' + d.Valor_Desconto;
                                }
                            }
                            html += '</label></td>';
                        });
                        html += '</tr>';
                    }

                    $(tabela).html(tr + html);

                    $('#text-desconto').html('');
                    $('#text-desconto').hide();

                    $('input[name=cbPlano]').iCheck({
                        checkboxClass: 'icheckbox_square',
                        radioClass: 'iradio_square-green',
                        increaseArea: '20%'
                    }).on('ifChecked', function (e, i) {
                        if (typeof (this.dataset.desconto) === 'undefined' || this.dataset.desconto == '') {
                            $('#text-desconto').html('');
                            $('#text-desconto').hide();
                        } else {
                            $('#text-desconto').html(this.dataset.desconto + ' de desconto.');
                            $('#text-desconto').show();
                        }

                    });
                } else if (data.result.length == 0 && codigo.length > 0) {
                    toastr.error('Código Promocional Inválido.');
                    $('#tokenPlano').html('');
                }
            }
        });
}

