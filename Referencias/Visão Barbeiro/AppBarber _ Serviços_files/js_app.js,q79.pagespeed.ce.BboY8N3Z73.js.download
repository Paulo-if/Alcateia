}

function PrintComandaNaoFiscal(data) {

    var htmlItens = '<table class="printer-ticket"><thead>';
    htmlItens += '<tr><th class="title" colspan="5">' + $("#nomeSalao").html() + '</th></tr>';
    htmlItens += '<tr><th class="address" colspan="5"><adrress>' + $("#infoSalao").html() + '</address></th></tr>';
    htmlItens += '<tr><th colspan="5"><p>Comanda: ' + $("#idComanda").html() + '</p>';
    htmlItens += '<p>Cliente: ' + $("#nomeClienteComanda").html() + '</p>';
    htmlItens += '<p>' + $("#dataComanda").html() + '</p></th></tr>';
    htmlItens += '</thead>';
    htmlItens += '<tbody>';
    htmlItens += '<tr>';
    htmlItens += '<td style="width:2%;"></td>';
    htmlItens += '<td style="width:35%" ><b>Descrição</b></td>';
    htmlItens += '<td style="width:35%; text-align:left;"><b>Profissional</b></td>';
    htmlItens += '<td align="center" style="width:8%;"><b>Qtd</b></td>';
    htmlItens += '<td align="right" style="width:20%;"><b>Valor</b></td>';
    htmlItens += '</tr>';

    for (var i = 0; i < tabelaComItens.fnGetData().length; i++) {

        if (tabelaComItens.fnGetData(i).Venda != "0") {
            htmlItens += '<tr><td style="width:2%;"></td>';
            htmlItens += '<td style="width:35%">' + tabelaComItens.fnGetData(i).Item + '</td>';
            htmlItens += '<td style="width:35%; text-align:left;">' + tabelaComItens.fnGetData(i).Profissional + '</td>';
            htmlItens += '<td align="center" style="width:8%;">' + tabelaComItens.fnGetData(i).Quantidade + '</td>';
            htmlItens += '<td align="right" style="width:20%;">' + tabelaComItens.fnGetData(i).Valor + '</td></tr>';
        }
    }

    htmlItens += '</tbody>';
    htmlItens += '<tfoot>';
    htmlItens += '<tr class="sup ttu p--0"><td colspan="5"><b>Formas de Pagamento</b></td></tr>';

    pagTipo0 = $("#tipoPagamento0 option:selected").html();
    if ($("#divBandeiraPag0  option:selected").val() != "") {
        pagBandeira0 = $("#divBandeiraPag0  option:selected").html();
    } else {
        pagBandeira0 = "";
    }
    pagValor0 = $("#valorPagamento0").val();

    htmlItens += '<tr class="ttu">';
    htmlItens += '<td align="center" colspan="2">' + pagTipo0 + '</td>';
    htmlItens += '<td  align="center" colspan="2">' + pagBandeira0 + '</td>';
    htmlItens += '<td align="right">' + pagValor0 + '</td>';
    htmlItens += '</tr>';

    if (($("#tipoPagamento1").val() != undefined) && ($("#tipoPagamento1").val() != "")) {

        pagTipo1 = $("#tipoPagamento1 option:selected").html();

        if ($("#divBandeiraPag1  option:selected").val() != "") {
            pagBandeira1 = $("#divBandeiraPag1  option:selected").html();
        } else {
            pagBandeira1 = "";
        }

        pagValor1 = $("#valorPagamento1").val();

        htmlItens += '<tr class="ttu">';
        htmlItens += '<td align="center" colspan="2">' + pagTipo1 + '</td>';
        htmlItens += '<td align="center" colspan="2">' + pagBandeira1 + '</td>';
        htmlItens += '<td align="right">' + pagValor1 + '</td>';
        htmlItens += '</tr>';
    }

    var totCom = $("#valorTotalComanda").html();
    var vlrPago = $("#comValorTotal").html();
    var selVezesParcela = $("#selVezesParcela option:selected").text();
    var selPeriodicidadeVenda = $("#selPeriodicidadeVenda option:selected").text();
    var isParcelado = "";

    if ($("#parcelarCaixa").get(0).checked) {
        isParcelado = "Sim";
    } else {
        isParcelado = "Não";
    }

    htmlItens += '<tr class="sup ttu p--0">';
    htmlItens += '<td colspan="4"> Parcelado? </td>';
    htmlItens += '<td align="right">' + isParcelado + '</td>';
    htmlItens += '</tr>';

    if ($("#parcelarCaixa").get(0).checked) {
        htmlItens += '<tr class="sup ttu p--0">';
        htmlItens += '<td colspan="3"> Qtd de Parcelas </td>';
        htmlItens += '<td  colspan="2" align="right">' + selVezesParcela + '</td>';
        htmlItens += '</tr>';
    }

    htmlItens += '<tr class="sup ttu p--0">';
    htmlItens += '<td colspan="4"> <b>Total da Comanda</b> </td>';
    htmlItens += '<td align="right"><b>' + totCom + '</b></td>';
    htmlItens += '</tr>';
    htmlItens += '<tr class="sup ttu p--0">';
    htmlItens += '<td colspan="4"> <b>Valor do Pagamento</b> </td>';
    htmlItens += '<td align="right"><b>' + vlrPago + '</b></td>';
    htmlItens += '</tr>';
    htmlItens += '<tr class="sup"><td colspan="5" align="center"><b>' + moment().format("DD/MM/YYYY HH:mm:ss") + '</b></td></tr>';
    htmlItens += '</tfoot></table>';

    var mywindow = window.open('', 'Imprimir Comanda');
    mywindow.document.write('<html><head>');
    mywindow.document.write('<link rel="stylesheet" href="https://d3verit7xckkza.cloudfront.net/css/bootstrap.css"/>');
    mywindow.document.write('<link rel="stylesheet" media="print" href="https://d3verit7xckkza.cloudfront.net/css/print-comanda-naofiscal.css?v=3"/>');
    mywindow.document.write('</head><body style= "" onload="window.print(); window.close();">');
    mywindow.document.write(htmlItens);
    mywindow.document.write('</body></html>');
    mywindow.document.close();
    mywindow.focus();

    return true;
}

function PrintCaixaNaoFiscal(dataCaixa) {

    var htmlItens = '<table class="printer-ticket"><thead>';
    htmlItens += '<tr><th class="title" colspan="3">Data do Caixa: ' + dataCaixa.dadosCaixa.FCa_Dat_Caixa + '</th></tr>';
    htmlItens += '<tr><th colspan="3">Usuário: ' + dataCaixa.dadosCaixa.Usu_Nome + '</th></tr>';
    htmlItens += '<tr><th colspan="3">Valor Inicial: ' + dataCaixa.dadosCaixa.FCa_Vlr_Inicial + '</th></tr>';

    htmlItens += '</thead>';
    htmlItens += '<tbody>';
    htmlItens += '<tr>';
    htmlItens += '<td><b>Descrição</b></td>';
    htmlItens += '<td><b>Pagamento</b></td>';
    htmlItens += '<td><b>Valor</b></td>';
    htmlItens += '</tr>';

    for (var i = 0; i < dataCaixa.movCaixa.length; i++) {
        if (dataCaixa.movCaixa[i].FCM_Entrada == "0") {
            htmlItens += '<tr><td> - ' + dataCaixa.movCaixa[i].FCM_Descricao + '</td>';
        } else {
            htmlItens += '<tr><td> + ' + dataCaixa.movCaixa[i].FCM_Descricao + '</td>';
        }

        htmlItens += '<td align="center">' + dataCaixa.movCaixa[i].TPa_Descricao + '</td>';
        htmlItens += '<td>' + dataCaixa.movCaixa[i].FCM_Valor + '</td></tr>';
    }

    htmlItens += '</tbody>';
    htmlItens += '<tfoot>';
    htmlItens += '<tr class="sup ttu p--0"><td colspan="3"><b>Pagamentos</b></td></tr>';

    for (var i = 0; i < dataCaixa.pagamentoCaixa.length; i++) {
        htmlItens += '<tr class="ttu">';
        htmlItens += '<td colspan="2">' + dataCaixa.pagamentoCaixa[i].TipoPagamento + '</td>';
        htmlItens += '<td align="right">' + dataCaixa.pagamentoCaixa[i].Valor + '</td>';
        htmlItens += '</tr>';
    }

    htmlItens += '<tr class="sup ttu p--0">';
    htmlItens += '<td colspan="2"> <b>Saldo</b> </td>';
    htmlItens += '<td align="right"><b>' + dataCaixa.dadosCaixa.FCa_Saldo + '</b></td>';
    htmlItens += '</tr>';
    htmlItens += '<tr class="sup"><td colspan="3" align="center"><b>' + moment().format("DD/MM/YYYY HH:mm:ss") + '</b></td></tr>';
    htmlItens += '</tfoot></table>';

    var mywindow = window.open('', 'Imprimir Caixa');
    mywindow.document.write('<html><head>');
    mywindow.document.write('<link rel="stylesheet" href="https://d3verit7xckkza.cloudfront.net/css/bootstrap.css"/>');
    mywindow.document.write('<link rel="stylesheet" media="print" href="https://d3verit7xckkza.cloudfront.net/css/print-caixa-naofiscal.css?v=3"/>');
    mywindow.document.write('</head><body style= "" onload="window.print(); window.close();">');
    mywindow.document.write(htmlItens);
    mywindow.document.write('</body></html>');
    mywindow.document.close();
    mywindow.focus();

    return true;
}

function buscaPrintCaixa(codigo, dadosCaixa) {
    $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaFinanceiroCaixaRelatorio.php",
        data: {
            codigo: codigo
        },
        dataType: "json",
        success: function (result) {
            $("#divTotalizadorImprime").html();
            var htmltotalizadorimprime = "";
            for (var i = 0; i < result.result.length; i++) {
                htmltotalizadorimprime += "<label align='right'>" + result.result[i].TipoPagamento + ": " + result.result[i].Valor + " </label><br>";
            }

            $("#divTotalizadorImprime").html(htmltotalizadorimprime);
        },
        error: function (data) {
            swal("Falha na conexão.", "", "error");
        }
    });

    $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaFinanceiroCaixa.php",
        data: {
            tipo: 6,
            fcacodigo: codigo
        },
        dataType: "json",
        success: function (result) {
            var htmlser = "";
            var htmlsernp = "";
            for (var i = 0; i < result.result.length; i++) {
                htmlser += $_CONFIG.MOEDA + result.result[i].Total;
                htmlsernp += $_CONFIG.MOEDA + result.result[i].TotalNp;
            }

            $("#totalServicoImprime").html(htmlser.replace('.', ','));
            $("#totalServicoImprimeNp").html(htmlsernp.replace('.', ','));
        },
        error: function (data) {
            console.log("Falha na conexão.", "", "error");
        }
    });

    $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaFinanceiroCaixa.php",
        data: {
            tipo: 7,
            fcacodigo: codigo
        },
        dataType: "json",
        success: function (result) {
            var htmlpro = "";
            var htmlpronp = "";
            for (var i = 0; i < result.result.length; i++) {
                htmlpro += $_CONFIG.MOEDA + result.result[i].Total;
                htmlpronp += $_CONFIG.MOEDA + result.result[i].TotalNp;
            }

            $("#totalProdutoImprime").html(htmlpro.replace('.', ','));
            $("#totalProdutoImprimeNp").html(htmlpronp.replace('.', ','));
        },
        error: function (data) {
            console.log("Falha na conexão.", "", "error");
        }
    });

    $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaFinanceiroCaixa.php",
        data: {
            tipo: 8,
            fcacodigo: codigo
        },
        dataType: "json",
        success: function (result) {
            var htmloutro = "";
            for (var i = 0; i < result.result.length; i++) {
                if (result.result[i].Total != "") {
                    htmloutro += $_CONFIG.MOEDA + result.result[i].Total;
                } else {
                    htmloutro += $_CONFIG.MOEDA + '0,00';
                }
            }

            $("#totalOutrosImprime").html(htmloutro.replace('.', ','));
        },
        error: function (data) {
            console.log("Falha na conexão.", "", "error");
        }
    });

    $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaFinanceiroCaixa.php",
        data: {
            tipo: 10,
            fcacodigo: codigo
        },
        dataType: "json",
        success: function (result) {
            var htmltotaldisp = "";
            for (var i = 0; i < result.result.length; i++) {

                if (result.result[i].Valor != "") {
                    htmltotaldisp += result.result[i].Valor;
                } else {
                    htmltotaldisp += $_CONFIG.MOEDA + '0,00';
                }
            }

            $("#lblTotalCaixaDispPrint").html(htmltotaldisp);

        },
        error: function (data) {
            console.log("Falha na conexão.", "", "error");
        }
    });

    $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaFinanceiroCaixa.php",
        data: {
            tipo: 11,
            fcacodigo: codigo
        },
        dataType: "json",
        success: function (result) {

            var htmltotalrece = "";
            for (var i = 0; i < result.result.length; i++) {
                if (result.result[i].Valor != "") {
                    htmltotalrece += result.result[i].Valor;
                } else {
                    htmltotalrece += $_CONFIG.MOEDA + '0,00';
                }
            }

            $("#lblTotalCaixaRecePrint").html(htmltotalrece);
        },
        error: function (data) {
            console.log("Falha na conexão.", "", "error");
        }
    });

    $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaFinanceiroCaixaMovimentacao.php",
        dataType: "json",
        data: {
            codigo: codigo
        },
        success: function (data) {
            var html = "";
            var classEntrada = "";
            var iconEntrada = "";
            for (var i = 0; i < data.result.length; i++) {
                if (data.result[i].FCM_Entrada == "1") {
                    classEntrada = "green";
                    iconEntrada = "+";
                } else {
                    classEntrada = "red";
                    iconEntrada = "-";
                }
                html += "<tr><td><font color='" + classEntrada + "'>" + iconEntrada + "</font></td><td><font color='" + classEntrada + "'>" + data.result[i].FCM_Descricao + "</font></td><td><font color='" + classEntrada + "'>" + data.result[i].TPa_Descricao + "</font></td><td><font color='" + classEntrada + "'>" + data.result[i].FCM_Valor + "</font></td></tr>";
            }
            $("#tbPrintCaixa").html(html);

            $("#lblNomePrint").html(dadosCaixa.Usu_Nome);
            $("#lblDataPrint").html(dadosCaixa.FCa_Dat_Caixa);
            $("#lblTotalCaixaPrint").html(dadosCaixa.FCa_Saldo);
            $("#lblValorInicialPrint").html(dadosCaixa.FCa_Vlr_Inicial);
            PrintElem("Caixa " + dadosCaixa.FCa_Dat_Caixa, '#printCaixa');
            showLoader(false);
        },
        error: function (data2) {
            $("#divLoader").hide();
            swal("Falha na conexão.", "", "error");
        }
    });
};

function PrintElem(title, elem) {
    PopupElem(title, $(elem).html());
}

function PopupElem(title, data) {
    var mywindow = window.open('', 'Imprimir recibo', 'height=600,width=800');
    mywindow.document.write('<html><head><title>' + title + '</title>');
    mywindow.document.write('<link rel="stylesheet" href="https://d3verit7xckkza.cloudfront.net/css/print.css"/>');
    mywindow.document.write('<link rel="stylesheet" href="https://d3verit7xckkza.cloudfront.net/css/bootstrap.css"/>');
    mywindow.document.write('</head><body onload="window.print();window.close();">');
    mywindow.document.write(data);
    mywindow.document.write('</body></html>');
    mywindow.document.close();
    mywindow.focus();
    return true;
}

function buscaPrintCaixaNaoFiscal(codigo, dadosCaixa) {

    var printCaixa = {
        dadosCaixa: new Object(),
        movCaixa: new Object(),
        pagamentoCaixa: new Object()
    }
    setTimeout(() => {
        $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaFinanceiroCaixaRelatorio.php",
            async: false,
            data: {
                codigo: codigo
            },
            dataType: "json",
            success: function (result) {
                printCaixa.pagamentoCaixa = result.result;
            },
            error: function (data) {
                swal("Falha na conexão.", "", "error");
            }
        });

        $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaFinanceiroCaixaMovimentacao.php",
            dataType: "json",
            async: false,
            data: {
                codigo: codigo
            },
            success: function (data) {
                printCaixa.movCaixa = data.result;
            }
        });
        printCaixa.dadosCaixa = dadosCaixa;
        showLoader(false);
        PrintCaixaNaoFiscal(printCaixa);
    }, 500);

}

function EnviaEmailComanda(cod) {
    showLoader(true);
    $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaEmailComanda.php",
        data: {
            comcodigo: cod
        },
        dataType: "json",
        success: function (result) {
            if (result.data[0].erro == "0") {
                toastr.success(result.data[0].resultado);
            } else {
                toastr.error(result.data[0].resultado);
            }
            showLoader(false);
        },
        error: function (result) {
            toastr.error("Falha de Conexão");
            showLoader(false);
        }
    });
}

