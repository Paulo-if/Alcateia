setTimeout(()=>{
    window.onbeforeunload = function(e) {
        var hasconfirm = localStorage.getItem('defaulExitAction');
        
        if (e.explicitOriginalTarget != undefined && e.explicitOriginalTarget.id == "btnLogoutSistema") {
            return undefined;
        }

        if(hasconfirm != undefined && hasconfirm != ''){
            return undefined;
            
        }else{
            return "Deseja realmente sair?";
        }
    };
},5000)



