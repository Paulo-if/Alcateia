function calculaValor() {

    var quantidade = $("#comQtde").val();
    var valor = $("#comValorHd").val().replace(",", ".");
    var comissao = $('#comComissaoHd').val();
    var comissaoprincipal = $('#comComissaoPrincipalHd').val();
    var valorDesconto;
    if (!$("#comCortesia").is(":checked")) {
        if ($("#divTokenCom").hasClass("has-success")) {
            valorDesconto = 0;
            var desconto = $("#comDesconto").val()

            var newvalor = valor - ((valor  * desconto)/100);
            $("#comValorHd").val(newvalor);
            // $("#comValorHd").val("0,00")
            $("#comValor").val(newvalor.toFixed(2));
        } else {
            valorDesconto = (valor * quantidade);
            comissao = (valorDesconto * comissaoprincipal / 100);
            $("#comComissao").maskMoney('mask', comissao);
            $("#comValor").val(valorDesconto.toFixed(2));
        }
    }
}

function calculaValorInsert() {
    var quantidade = $("#comQtdeInsert").val();
    var valor = parseFloat($("#comValorHdInsert").val().replace(",", "."));
    var valorDesconto;
  
    if ($("#divTokenComInsert").hasClass("has-success")) {
        valorDesconto = 0;
        $("#comValorHdInsert").val("0,00")
        $("#comValorInsert").val(valorDesconto.toFixed(2));
    } else {
        valorDesconto = (valor * quantidade);
        $("#comValorInsert").val(valorDesconto.toFixed(2));
        var comissao = $("#comProduto option:selected").get(0).dataset.comissao;
        if($("#comProfissionalComissao option:selected").get(0).dataset.comissao > 0.00){
            comissao = $("#comProfissionalComissao option:selected").get(0).dataset.comissao;
        }

        if (comissao == "" || comissao == undefined) {
            comissao = $("#comProduto option:selected").get(0).dataset.comissao;
        }
        if (comissao == "" || comissao == undefined) {
            comissao = 0.00;
        } else {
            comissao = parseFloat(comissao).toFixed(2);
        }
        var valor2 = parseFloat(parseFloat($('#comValorInsert').val()).toFixed(2));
        $("#comProComissao").val(parseFloat((valor2 * comissao) / 100).toFixed(2));
    }

}

function thumbCliente2(repo) {

    if (repo.loading) {
        return repo.text;
    }
    if (repo.Paf_Celular == "") {
        var celular = "";
    } else {
        var celular = " - " + repo.Paf_Celular;
    }

    if (repo.Paf_Imagem == "" || repo.Paf_Imagem == undefined) {
        var $state = $(
            '<span><img src="https://d3verit7xckkza.cloudfront.net/imgsystem/nopicture.png" class="img-thumb" /> ' + repo.Pes_Nome + celular + '</span>'
        );
    } else {
        var $state = $(
            '<span><img src="' + repo.Paf_Imagem + '" class="img-thumb" /> ' + repo.Pes_Nome + celular + '</span>'
        );
    }
    return $state;
}

function thumbClienteName(repo) {

    if (repo.loading) {
        return repo.text;
    }
    if (repo.Paf_Celular == "") {
        var celular = "";
    } else {
        var celular = " - " + repo.Paf_Celular;
    }
    return repo.Pes_Nome + celular;
}

function thumbClienteSelect(repo) {

    if (repo.loading) {
        return repo.text;
    }

    return repo.Pes_Nome;
}

function formatRepoSelection(repo) {
    return repo.Pes_Nome || repo.text;
}

function buscaAssocProfissionalServico(sercodigo, procodigo) {
    if (procodigo != '' && sercodigo != '') {
        $.ajax({
            dataType: 'json',
            url: localStorage.getItem('host'),
            data: {
                metodo: 'buscaProfissionalServico',
                profcodigo: procodigo,
                sercodigo: sercodigo,
                id: $_CONFIG.ID
            },
            success: function (result) {
                if (result.result[0].erro == '2') {
                    swal('Este Profissional não está associado a este Serviço.', 'Poderão ocorrer divergências no relatório de comissões.', 'warning');
                }
            }
        });
    }
}

function sendWhatsReminder(phone, message) {
    var encodeMessage = window.encodeURIComponent(message);

    var protocol = localStorage.getItem('wppDefaultProtocol');

    if(protocol != undefined && protocol != ''){
        window.open(protocol+"send?phone=" + phone + "&text=" + encodeMessage, "_blank");
    }else{
        
        if (isMobile) {
            window.open("https://wa.me/" + phone + "?l=pt_br&text=" + encodeMessage, "_blank");
        } else {
            window.open("https://web.whatsapp.com/send?phone=" + phone + "&text=" + encodeMessage, "_blank");
        }
    }

}

function insereLog(tipo, descricao) {
    $.ajax({
        type: "POST",
        url: "/pages/cadastros/insereLog.php",
        data: {
            tipo: tipo,
            descricao: descricao
        }
    });
}

