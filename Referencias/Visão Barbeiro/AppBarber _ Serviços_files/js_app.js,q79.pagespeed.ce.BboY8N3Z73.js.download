$("#formAlteraLogo").submit(function (event) {
    event.preventDefault();
    dataInsere = new FormData(this);
    dataInsere.append("blob", mBlob);
    dataInsere.delete("file");
    showLoader(true);
    $.ajax({
        type: "POST",
        url: "/pages/cadastros/alteraLogoEmpresa.php",
        data: dataInsere,
        dataType: "json",
        processData: false,
        contentType: false,
        success: function (result) {
            if (result.result[0].erro == "0") {
                $('.img-rounded.image').attr('src', logoEmpresa);
                $("#cortaImagem-modal").modal("hide");
                $("#file_teste").val('')
            } else {
                swal(result.result[0].resultado, "", "error");
            }
            showLoader(false);
        },
        error: function (result) {
            swal("Falha na conexão.", "", "error");
            showLoader(false);
        }
    });
});

function saveImageCrop(type) {

    if (type === "logo") {
        if ($('#imagemCut').cropper('getData').width <= 800) {

            logoEmpresa = $('#imagemCut').cropper('getCroppedCanvas').toDataURL();
            $('#imagemCut').cropper('getCroppedCanvas').toBlob(function (blob) {
                mBlob = blob;
                $("#formAlteraLogo").submit();
            });
        } else {
            logoEmpresa = $('#imagemCut').cropper('getCroppedCanvas', {
                width: 800
            }).toDataURL();
            $('#imagemCut').cropper('getCroppedCanvas', {
                width: 800
            }).toBlob(function (blob) {
                mBlob = blob;
                $("#formAlteraLogo").submit();
            });

        }
    }
}

function readURL(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function (e) {
            logoEmpresa = e.target.result;
            $("#formAlteraLogo").submit();
        };
        reader.readAsDataURL(input.files[0]);
    }
}

