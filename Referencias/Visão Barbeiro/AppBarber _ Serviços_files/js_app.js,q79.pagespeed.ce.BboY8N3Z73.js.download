$('#comCortesia').change(function () {

    if (!this.checked) {

        if ($('#comTipoItem').val() == 1) {
            if($('#comValSerHd').val() != '0,00'){
                $('#comValorHd').val($('#comValSerHd').val());
            }else{
                $('#comValorHd').val($('#itemValorOriginal').val());
            }
            // var valor = parseFloat($('#comValorRestore').val().replace(',', '.')) * parseFloat($('#comQtde').val());
            //$('#comValor').val(valor);
        } else {
            if($('#comProValor').val() != '0,00'){
                $('#comValorHd').val($('#comProValor').val());
            }else{
                $('#comValorHd').val($('#itemValorOriginal').val());
            }
            //var valor = parseFloat($('#comValorRestore').val().replace(',', '.')) * parseFloat($('#comQtde').val());
            //$('#comValor').val(valor);
        }
    } else {
        if ($("#senhaDesconto").html() == "1") {
            $('#comCortesia').get(0).checked = false;
            var statesdemo = {
                state0: {
                    title: 'Insira a senha ',
                    html: '<input class="form-control" type="password" name="password" id="password" value=""></label>',
                    buttons: {
                        Ok: 1
                    },
                    submit: function (e, v, m, f) {
                        e.preventDefault();
                        if (f.password != null) {
                            $.ajax({
                                dataType: "json",
                                method: "POST",
                                url: '/php/verificaSenhaDesconto.php',
                                data: {
                                    password: f.password
                                },
                                success: function (data) {
                                    if (data.erro == "0") {
                                        $('#comValorHd').val('0.00');
                                        $('#comValor').val('0.00');
                                        $('#comCortesia').get(0).checked = true;
                                        $.prompt.close();
                                    } else {
                                        $('#comCortesia').get(0).checked = false;
                                        toastr.error(data.resultado);
                                    }
                                },
                                error: function (data) {
                                    toastr.error("Falha de conexão");
                                }
                            });
                        }
                    }
                },
            };
            $.prompt(statesdemo);
        }else{
            $('#comValorHd').val('0.00');
            $('#comValor').val('0.00');
        }
        
    }
    calculaValor();
});

