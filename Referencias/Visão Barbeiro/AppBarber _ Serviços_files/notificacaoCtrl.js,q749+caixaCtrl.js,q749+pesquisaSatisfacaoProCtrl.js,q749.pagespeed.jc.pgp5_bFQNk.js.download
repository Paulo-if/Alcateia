var mod_pagespeed_f9JwGKna6d = "angular.module('appBeleza').controller('notificacaoCtrl', function ($scope, $http, $interval, $state) {\n	$scope.alertas = '';\n	$scope.mensagens = '';\n	$scope.aniversariantes = '';\n	$scope.totAlertas = '';\n	$scope.totMensagens = '';\n	$scope.totAniversariantes = '';\n	$scope.notFirstExecAlert = false;\n	$scope.notFirstExecMsg = false;\n	$scope.totResumo = 0;\n	$scope.filterSol = '';\n	$scope.timerNotificacoesMS = 300000;\n\n	$('.btnFilter').click(function (e) {\n		$('.btnFilter').removeClass('bg-green');\n		$('.btnFilter').addClass('bg-gray');\n		$(this).removeClass('bg-gray');\n		$(this).addClass('bg-green');\n		e.stopPropagation();\n	});\n\n	$('.btnSolCad').click(function (e) {\n		e.stopPropagation();\n	});\n\n	$scope.enviaMsg = function (codigo, today) {\n\n		buscaClientes($scope.enviaMsgCliente, codigo, today);\n	}\n	$scope.enviaMsgCliente = function (codigo, isToday) {\n\n		$('#todosSelecionadosmsg').hide();\n		$('#divmsgUsuario').show();\n		$('#formCadastroMensagem').each(function () {\n			this.reset();\n		});\n		if (isToday) {\n\n			var dataini = moment().locale('pt-br').format('L');\n			$('.date.divDataIni').datepicker('update', dataini);\n			$('#cadastrarmsg-modal').modal();\n			setTimeout(function () {\n				$('#msgUsuario option[data-codigo=\"' + codigo + '\"]').get(0).selected = true;\n				$('#msgUsuario').trigger('change');\n			}, 1200);\n		}\n	}\n\n	$('#formCadastroMensagem').submit(function (event) {\n		event.preventDefault();\n		formCadastro = $(this);\n		showLoader(true);\n\n		var horamin = $('#msgHoraEnvio').val().split(':');\n		var valoresPes = [];\n		var valoresUsu = [];\n		var semUsu = 0;\n		var todosAssinantes = $('#msgTodosAssinantes').is(':checked');\n		var obj = todosAssinantes ? (window.assinantesParaEnvio || []) : $('#msgUsuario').select2('data');\n		var isSingleMsg = $(\"#isSingleMSG\").val();\n		\n		var limitEnvios = 50;\n		if ($state.current.name == \"relDiasSemVir\" || $('#msgTodosAssinantes').is(':checked')) {\n			limitEnvios = 1000;\n		}\n\n		if(obj.length > 0){\n\n			if(obj.length > limitEnvios){\n\n				var htmlAviso = `\n					<p>O número máximo de clientes permitidos por envio é <strong>${limitEnvios}</strong>.</p><br>\n					<p> Caso necessite enviar para todos clientes, utilize a opção <strong class=\"text-green\">Notícias</strong> </p><br>\n					<p> <h4>Maiores dúvidas, acesse nossa <strong><a target=\"_blank\" href=\"https://appbarber-appbeleza.zendesk.com/hc/pt-br/articles/360002981011-Qual-a-diferen%C3%A7a-entre-Envio-de-Not%C3%ADcias-e-Envio-de-Mensagem\">Central de Ajuda</a></strong>.</h4></p>\n				`;\n				swal({\n					title: \"Limite de Clientes para Envio.\",\n					text: htmlAviso,\n					html: true,\n					type: \"warning\",\n				});\n\n				showLoader(false);\n				return false;\n\n			} else {\n\n				if (todosAssinantes) {\n					obj.forEach(function (assinante) {\n						valoresPes.push(assinante.person_code);\n						valoresUsu.push(assinante.user_code);\n					});\n				} else if (hasManyClients && (isSingleMsg == \"1\")) {\n					obj.forEach(function (e, idx) {\n						valoresPes.push(e.Pes_Codigo);\n						valoresUsu.push(e.Usu_Codigo);\n					});\n				} else {\n					obj.forEach(function (e, idx) {\n						if(!e.element){\n							return;\n						}\n						if(e.element.dataset.codigo != undefined && e.element.dataset.codigo != ''){\n							valoresPes.push(e.element.dataset.codigo);\n						}\n						if(e.element.value != undefined && e.element.value != ''){\n							valoresUsu.push(e.element.value);\n						}\n\n					});\n				}\n				\n	\n				\n				for (var index = 0; index < valoresUsu.length; index++) {\n					if (valoresUsu[index] == '') {\n						semUsu = 1;\n					}\n				}\n	\n				var horamin = $('#msgHoraEnvio').val().split(':');\n	\n				if (horamin[0] > 23) {\n					swal('Horário Inválido.', 'Informe um horário válido', 'error');\n					showLoader(false);\n				} else if (horamin[1] > 59) {\n					swal('Horário Inválido.', 'Informe um horário válido', 'error');\n					showLoader(false);\n				} else if ($('#msgEnviarSms').get(0).checked && parseInt($('#lblSaldoSMSMsg').html()) <= 0) {\n					swal('Saldo SMS insuficiente.', 'Você não possui créditos SMS. Por favor, faça uma recarga para enviar SMS.', 'error');\n					showLoader(false);\n				}else if ($('#msgEnviarSms').get(0).checked && parseInt($('#lblSaldoSMSMsg').html()) < $(\"#msgUsuario\").val().length) {\n					swal('Saldo SMS insuficiente.', 'Você não possui créditos SMS suficientes para fazer todos os envios.', 'error');\n					showLoader(false);\n				}\n				else if (!todosAssinantes && !$('#msgEnviarSms').get(0).checked && $('#msgUsuario').val() == '') {\n					swal('Cliente sem usuário.', 'Este cliente não possui usuário cadastrado e não receberá essa mensagem. Por favor utilize o envio com SMS ou a criação de um usuário para este cliente.', 'error');\n					showLoader(false);\n				} else {\n				\n					dataInsere = new FormData(this);\n					if ($('#msgEnviarSms').get(0).checked) {\n						dataInsere.append('usasms', '1');\n					} else {\n						dataInsere.append('usasms', '0');\n					}\n					dataInsere.append('msgPesCodigo', valoresPes);\n					\n					if (dataInsere.delete != undefined){\n						dataInsere.delete('msgUsuario');\n					}\n					\n					dataInsere.append('msgUsuario', valoresUsu);\n					$.ajax({\n						type: 'POST',\n						url: '/pages/cadastros/insereMensagem.php',\n						data: dataInsere,\n						dataType: 'json',\n						processData: false,\n						contentType: false,\n						success: function (result) {\n							var texto = `<span style=\"color:green;\">\n											<i class=\"fa fa-check\"></i>&nbspEnviados com sucesso:&nbsp${result.sucesso}\n										</span>`;\n							\n							if( result.falha > 0){\n								texto +=	`<span style=\"color:red;\">\n												<i class=\"fa fa-times\"></i>&nbspFalhas no envio:&nbsp${result.falha}\n											</span>`;\n							}\n	\n							swal({\n								title: '<small>Resultado</small>',\n								text: texto,\n								html: true\n							});\n							$('#cadastrarmsg-modal').modal('hide');\n							formCadastro.each(function () {\n								this.reset();\n							});\n							$('#todosSelecionadosmsg').hide();\n							$('#divmsgUsuario').show();\n							$scope.buscaSaldoSMSMsg();\n							$('#divSaldoSmsMsg').hide();\n							$('#charNumMsg').hide();\n							$('#divDescNot').removeClass('has-error');\n							showLoader(false);\n						},\n						error: function (result) {\n							swal('Falha na conexão.', '', 'error');\n							showLoader(false);\n						}\n					});\n				}\n\n				return true;\n				\n			}\n			\n		} else {\n			swal('Nenhum cliente informado.', 'Favor selecione ao menos um cliente para receber a mensagem', 'error');\n			showLoader(false);\n			return false;\n		}\n	});\n\n\n	$('#cadastrarmsg-modal').on('hidden.bs.modal', function(){\n		$(\"#isSingleMSG\").val(\"\");\n	});\n	// $scope.buscaResumo = function () {\n	// 	$http.get('/pages/relatorios/buscaRelDashboard.php').\n	// 	success(function (data, status, headers, config) {\n\n	// 		var keys = []\n	// 		var countResumo = 0;\n	// 		var obj = data.data[0];\n	// 		for (var key in obj) {\n	// 			keys.push(key)\n	// 		}\n	// 		for (var i = 0; i < keys.length; i++) {\n	// 			if (obj[keys[i]] != 0) {\n	// 				countResumo++;\n	// 			}\n	// 		}\n	// 		$scope.totResumo = countResumo;\n	// 		$('#countResumo').show();\n	// 	});\n	// }\n\n	$scope.buscaAniversariantes = function () {\n		$scope.valorSelecionado = '';\n		$http.get(localStorage.getItem('host') + '?metodo=buscaAniversariante&id=' + $_CONFIG.ID).\n		success(function (data, status, headers, config) {\n			arrAniv = new Array();\n\n			for (var i = 0; i < data.result.length; i++) {\n				objAniv = new Object();\n				dataAniversario = new Date(data.result[i].PAF_Dat_Nascimento);\n				momDate = moment(dataAniversario);\n				momDateNow = moment({\n					month: momDate.month(),\n					day: momDate.date(),\n					year: moment().year()\n				});\n\n				DiaAniversario = moment(momDateNow).locale('PT-BR').calendar(null, {\n					sameDay: '[Hoje]',\n					nextDay: '[Amanhã]',\n					nextWeek: 'dddd',\n					lastDay: '[Ontem]',\n					lastWeek: '[Semana Passada]'\n				});\n				objAniv['DiaAniversario'] = DiaAniversario\n				objAniv['Nome'] = data.result[i].Pes_Nome.trim();\n				objAniv['TotalHoje'] = data.result[i].TotalHoje;\n				objAniv['UsuCodigo'] = data.result[i].Usu_Codigo;\n				objAniv['PesCodigo'] = data.result[i].Pes_Codigo;\n\n				if (DiaAniversario == 'Hoje') {\n					objAniv['isToday'] = true;\n					objAniv['textStyle'] = 'font-weight:bold';\n					objAniv['textSize'] = 'font-size:small';\n				} else {\n					objAniv['isToday'] = false;\n					objAniv['textStyle'] = 'font-weight:normal';\n					objAniv['textSize'] = 'font-size:x-small';\n				}\n\n				if (data.result[i].PAF_Imagem == '') {\n					objAniv['Imagem'] = '/img/nopicture.png';\n				} else {\n					objAniv['Imagem'] = data.result[i].PAF_Imagem;\n				}\n				arrAniv.push(objAniv);\n			};\n			$scope.aniversariantes = arrAniv;\n\n			if ($scope.aniversariantes.length == 0) {\n				$scope.totAniversariantes = '';\n			} else {\n				$scope.totAniversariantes = $scope.aniversariantes[0].TotalHoje;\n				$('#countAniv').show();\n			}\n\n		}).\n		error(function (data, status, headers, config) {\n			console.log('Falha ao buscar as mensagens. Erro:' + data);\n		});\n	};\n\n	$scope.buscaAlerta = function () {\n		$scope.valorSelecionado = '';\n\n		$http.get(localStorage.getItem('host') + '?metodo=buscaMensagemUsuario&tipo=2&id=' + $_CONFIG.ID).\n		success(function (data, status, headers, config) {\n			$scope.alertas = data.result;\n\n			if (($scope.alertas.length > $scope.totAlertas) && $scope.notFirstExecAlert) {\n				soundNewMessage.play();\n			}\n			if ($scope.alertas.length == 0) {\n				$scope.totAlertas = '';\n			} else {\n				$scope.totAlertas = $scope.alertas.length;\n				$('#countAlert').show();\n			}\n\n			$scope.notFirstExecAlert = true;\n\n		}).\n		error(function (data, status, headers, config) {\n			console.log('Falha ao buscar os alertas. Erro:' + data);\n		});\n\n	};\n\n	$scope.buscaMensagem = function () {\n		$scope.valorSelecionado = '';\n		$scope.listamsg = '';\n		$scope.listamsg2 = '';\n		$http.get(localStorage.getItem('host') + '?metodo=buscaMensagemUsuario&tipo=1&id=' + $_CONFIG.ID).\n		success(function (data, status, headers, config) {\n			$scope.listamsg = data.result;\n\n			/* if ( ($scope.mensagens.length > $scope.totMensagens) &&\n			       ($scope.notFirstExecMsg)) {\n			   soundNewMessage.play();\n			 }\n			 if ($scope.mensagens.length == 0){\n			   $scope.totMensagens = '';\n			 } else {\n			   $scope.totMensagens = $scope.mensagens.length;\n			   $('#countMsg').show();\n			 }\n			 $scope.notFirstExecMsg = true;*/\n\n			/*-----------------------------------------------------*/\n\n			$http.get('https://api.appbarber.com.br/buscaMensagemUsuarioProfissional?api_key=TcskrU3Ejze.6&tipo=1&id=' + $_CONFIG.ID).\n			success(function (data, status, headers, config) {\n				$scope.listamsg2 = data.result;\n\n				/* if ( ($scope.mensagens.length > $scope.totMensagens) &&\n				      ($scope.notFirstExecMsg)) {\n				  soundNewMessage.play();\n				}\n				if ($scope.mensagens.length == 0){\n				  $scope.totMensagens = '';\n				} else {\n				  $scope.totMensagens = $scope.mensagens.length;\n				  $('#countMsg').show();\n				}\n				$scope.notFirstExecMsg = true;*/\n\n				$scope.mensagens = angular.extend($scope.listamsg, $scope.listamsg2)\n				if (($scope.mensagens.length > $scope.totMensagens) &&\n					($scope.notFirstExecMsg)) {\n					soundNewMessage.play();\n				}\n				if ($scope.mensagens.length == 0) {\n					$scope.totMensagens = '';\n				} else {\n					$scope.totMensagens = $scope.mensagens.length;\n					$('#countMsg').show();\n				}\n				$scope.notFirstExecMsg = true;\n\n			}).\n			error(function (data, status, headers, config) {\n				console.log('Falha ao buscar as mensagens. Erro:' + data);\n			});\n\n\n			/*-----------------------------------------------------*/\n\n		}).\n		error(function (data, status, headers, config) {\n			console.log('Falha ao buscar as mensagens. Erro:' + data);\n		});\n\n\n\n	};\n\n	$scope.buscaSolCad = function () {\n\n		$http.get(localStorage.getItem('host') + '?metodo=buscaSolicitacaoCadastro&tipo=5&id=' + $_CONFIG.ID).\n		success(function (data, status, headers, config) {\n			$scope.solcad = data.result;\n\n			//Adiciona o indíce, para que funcione o idx correto quando filtrado.\n			for (var i = 0; i < data.result.length; i++) {\n				$scope.solcad[i].idx = i;\n				if (data.result[i].SCa_Imagem == '') {\n					$scope.solcad[i].SCa_Imagem = '/img/nopicture.png';\n				} else {\n					$scope.solcad[i].SCa_Imagem = data.result[i].SCa_Imagem;\n				}\n			}\n\n			if (($scope.solcad.length > $scope.totSolCad) &&\n				($scope.notFirstExecSolCad)) {\n				soundNewMessage.play();\n			}\n			if ($scope.solcad.length == 0) {\n				$scope.totSolCad = '';\n			} else {\n				$scope.totSolCad = $scope.solcad.length;\n				$scope.totSolCadBadge = $scope.solcad[0].Total;\n				$('#countNewUser').show();\n			}\n\n			$scope.notFirstExecSolCad = true;\n\n			if ($scope.totSolCadBadge > 0) {\n				if ($scope.totSolCadBadge == 1) {\n					$scope.titleSolCad = 'Há ' + $scope.totSolCadBadge + ' solicitação pendente.';\n				} else {\n					$scope.titleSolCad = 'Há ' + $scope.totSolCadBadge + ' solicitações pendentes.';\n				}\n			} else {\n				$scope.titleSolCad = 'Nenhuma solicitação pendente.';\n			}\n\n		}).\n		error(function (data, status, headers, config) {\n			console.log('Falha ao buscar as solicitações de cadastro. Erro:' + data);\n		});\n	};\n\n	$scope.atualizaMensagem = function (mencodigo) {\n\n		$http.get(localStorage.getItem('host') + '?metodo=atualizaMensagemUsuario&mencodigo=' + mencodigo +\n			'&id=' + $scope.idCliente).\n		success(function (data, status, headers, config) {\n			$scope.buscaMensagem();\n		}).\n		error(function (data, status, headers, config) {\n			console.log('Falha ao atualizar Mensagem. Erro:' + data);\n		});\n	};\n\n\n	$scope.atualizaMensagemProfissional = function (mencodigo) {\n\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/alteraMensagemUsuarioProfissional.php\",\n			data: {\n				mepcodigo: mencodigo\n			},\n			dataType: \"json\",\n			success: function (result) {\n				$scope.buscaMensagem();\n			},\n			error: function (result) {\n				console.log('Falha ao atualizar Mensagem: ' + data);\n			}\n		});\n	};\n\n\n\n\n	$scope.showMessage = function (id, title, text, icon, tipo) {\n\n		if (tipo == 1) {\n			$scope.atualizaMensagem(id);\n		} else {\n			$scope.atualizaMensagemProfissional(id)\n		}\n		swal({\n			html: true,\n			imageUrl: icon,\n			title: title,\n			animation: 'slide-from-top',\n			text: '<h4 align=\"justify\" style=\"color:black;\">' + text + '</h4>',\n\n		});\n	}\n\n	$scope.confirmNewUser = function (index) {\n\n		if($scope.solcad[index].TipoSolicitacao == 1){\n\n			var url = localStorage.getItem('host') + '?metodo=insereCliente_v2&id=' + $scope.idCliente +\n				'&nome=' + $scope.solcad[index].SCa_Nome +\n				'&email=' + $scope.solcad[index].SCa_Email +\n				'&cpf=' + $scope.solcad[index].SCa_CPF +\n				'&celular=' + $scope.solcad[index].SCa_Celular +\n				'&login=' + $scope.solcad[index].SCa_Login +\n				'&senha=' + $scope.solcad[index].SCa_Senha +\n				'&idterceiro=' + $scope.solcad[index].IDTerceiro +\n				'&tipo=' + $scope.solcad[index].SCa_Tipo  +\n				'&imagem=' + $scope.solcad[index].SCa_Imagem.replace(/&/g, '%26');\n\n			showLoader(true);\n\n			$http.get(url.replace(/ /g, '%20')).\n			success(function (data, status, headers, config) {\n				if (data.insereCliente[0].erro == '0') {\n					$http.get(localStorage.getItem('host') +\n						'?metodo=atualizaSolicitacaoCadastro&id=' + $scope.idCliente +\n						'&scacodigo=' + $scope.solcad[index].SCa_Codigo +\n						'&scaaprovado=1'\n					).\n					success(function (data, status, headers, config) {\n						if (data.result[0].erro == '0') {\n							toastr['success'](data.result[0].resultado);\n							showLoader(false);\n						} else {\n							toastr['error'](data.result[0].resultado);\n							showLoader(false);\n						}\n						$scope.buscaSolCad();\n					}).\n					error(function (data, status, headers, config) {\n						console.log('Falha ao inserir Cliente. Erro:' + data);\n						showLoader(false);\n					});\n				} else {\n					toastr['error'](data.insereCliente[0].resultado);\n					showLoader(false);\n				}\n			}).\n			error(function (data, status, headers, config) {\n				console.log('Falha ao inserir Cliente. Erro:' + data);\n				showLoader(false);\n			});\n\n		}else{\n			showLoader(true);\n			$.ajax({\n				type: \"POST\",\n				url: \"/pages/cadastros/CLIENTEAprovaVinculo.php\",\n				data: {\n					join_request_code: $scope.solcad[index].SCa_Codigo,\n					join_request_approve: 1\n				},\n				dataType: \"json\",\n				success: function (data) {\n					if (data.data.error == false) {\n						toastr['success'](data.data.message);\n						showLoader(false);\n					} else {\n						toastr['error'](data.data.message);\n						showLoader(false);\n					}\n					$scope.buscaSolCad();\n				},\n				error: function (data) {\n					console.log('Falha ao inserir Cliente. Erro:' + data);\n					showLoader(false);\n				}\n			});\n		}\n\n	}\n\n	$scope.reproveNewUser = function (index) {\n\n		if($scope.solcad[index].TipoSolicitacao == 1){\n\n			$http.get(\n				localStorage.getItem('host') + '?metodo=atualizaSolicitacaoCadastro&id=' + $scope.idCliente +\n				'&scacodigo=' + $scope.solcad[index].SCa_Codigo +\n				'&scaaprovado=0'\n			).\n			success(function (data, status, headers, config) {\n				if (data.result[0].erro == '0') {\n					toastr[\"success\"](data.result[0].resultado)\n				} else {\n					toastr[\"error\"](data.result[0].resultado)\n				}\n				$scope.buscaSolCad();\n			}).\n			error(function (data, status, headers, config) {\n				console.log(\"Falha ao inserir Cliente. Erro:\" + data);\n			});\n		\n		}else{\n			showLoader(true);\n			$.ajax({\n				type: \"POST\",\n				url: \"/pages/cadastros/CLIENTEAprovaVinculo.php\",\n				data: {\n					join_request_code: $scope.solcad[index].SCa_Codigo,\n					join_request_approve: 0\n				},\n				dataType: \"json\",\n				success: function (data) {\n					if (data.data.error == false) {\n						toastr['success'](data.data.message);\n						showLoader(false);\n					} else {\n						toastr['error'](data.data.message);\n						showLoader(false);\n					}\n					$scope.buscaSolCad();\n				},\n				error: function (data) {\n					console.log('Falha ao inserir Cliente. Erro:' + data);\n					showLoader(false);\n				}\n			});\n		}\n	}\n\n	$scope.undoNewUser = function (index) {\n\n		if($scope.solcad[index].TipoSolicitacao == 1){\n			$http.get(\n				localStorage.getItem('host') + '?metodo=alteraSolicitacaoCadastro&id=' + $scope.idCliente +\n				'&scacodigo=' + $scope.solcad[index].SCa_Codigo +\n				'&tipo=1'\n			).\n			success(function (data, status, headers, config) {\n				if (data.result[0].erro == \"0\") {\n					toastr['success'](data.result[0].resultado)\n				} else {\n					toastr['error'](data.result[0].resultado)\n				}\n				$scope.buscaSolCad();\n			}).\n			error(function (data, status, headers, config) {\n				console.log('Falha ao inserir Cliente. Erro:' + data);\n			});\n		}else{\n			showLoader(true);\n			$.ajax({\n				type: \"POST\",\n				url: \"/pages/cadastros/CLIENTEAprovaVinculo.php\",\n				data: {\n					join_request_code: $scope.solcad[index].SCa_Codigo,\n					join_request_approve: 2\n				},\n				dataType: \"json\",\n				success: function (data) {\n					if (data.data.error == false) {\n						toastr['success'](data.data.message);\n						showLoader(false);\n					} else {\n						toastr['error'](data.data.message);\n						showLoader(false);\n					}\n					$scope.buscaSolCad();\n				},\n				error: function (data) {\n					console.log('Falha ao inserir Cliente. Erro:' + data);\n					showLoader(false);\n				}\n			});\n		}\n	}\n	\n	//$scope.buscaAlerta();\n	$scope.buscaMensagem();\n	$scope.buscaAniversariantes();\n	$scope.buscaSolCad();\n	/*$scope.buscaResumo();*/\n\n	$interval(() => {\n		if (updateSchedule) {\n			//$scope.buscaAlerta();\n			$scope.buscaMensagem();\n			$scope.buscaSolCad();\n		}\n	}, $scope.timerNotificacoesMS);\n\n\n	\n\n});";
var mod_pagespeed_6ZNTEptn6D = "angular.module('appBeleza').controller(\"caixaCtrl\", function ($rootScope, $scope, $http, $compile, $state, $interval) {\n\n	$rootScope.header = sSistema + \" | Caixa\";\n	$scope.timerIntervalCaixa = 300000;\n	$(\"#navProf\").hide();\n	$(\"#formProf\").hide();\n	\n	changeHeightBody();\n	$('[data-toggle=\"popover\"]').popover({\n		container: 'body'\n	});\n\n	if ($state.current.name == \"caixa\") {\n		validaPerfil($state.current.name);\n		$(\".btn-caixa\").hide();\n		$(\"#formCaxSaida\").unbind(\"submit\");\n		$(\"#formCaxEntrada\").unbind(\"submit\");\n		$(\"#formCadastroCaixa\").unbind(\"submit\");\n		$(\"#formDespesaCaixa\").unbind(\"submit\");\n	} else {\n		if (isMobile) {\n			$(\".btn-caixa\").hide();\n		} else {\n			$(\".btn-caixa\").show();\n		}\n	}\n\n	$(\".input-group.divData\").datepicker({\n		language: \"pt-BR\",\n		orientation: \"top auto\",\n		autoclose: true,\n		format: \"dd/mm/yyyy\"\n	});\n\n	$scope.verdia = 0;\n	$scope.buscaParVerDia = function () {\n		$.ajax({\n			dataType: 'json',\n			url: localStorage.getItem('host'),\n			async: false, \n			data: {\n				metodo: 'buscaParametro',\n				id: $scope.idCliente,\n				parcodigo: 69\n			},\n			success: function (data) {\n				if (data.result.length > 0) {\n					if (data.result[0].PVa_Vlr_Principal == '1') {\n						$scope.verdia = 1;\n					} else {\n						$scope.verdia = 0;\n						$(\".caixaVerDia\").hide();\n					}\n				} else {\n					$scope.verdia = 0;\n				}\n			}\n		});\n\n		$.ajax({\n			dataType: 'json',\n			url: localStorage.getItem('host'),\n			async: false, \n			data: {\n				metodo: 'buscaParametro',\n				id: $scope.idCliente,\n				parcodigo: 215\n			},\n			success: function (data) {\n				if (data.result.length > 0) {\n					if($_CONFIG.ISG != 1){\n						if (data.result[0].PVa_Vlr_Principal == '1') {\n							$(\".btnEdtCaixa\").hide();\n						} else {\n							$(\".btnEdtCaixa\").show();\n						}\n					}else{\n						$(\".btnEdtCaixa\").show();\n					}\n				} else {\n					$(\".btnEdtCaixa\").show()\n				}\n			}\n		});\n	}\n	$scope.buscaParVerDia()\n\n	$scope.idCliente = $_CONFIG.ID;\n\n	$.ajax({\n		dataType: \"json\",\n		url: localStorage.getItem(\"host\"),\n		data: {\n			metodo: 'buscaDataAtual',\n			id: $scope.idCliente\n		},\n		success: function (data) {\n			var datahoralocal = moment(data.buscaDataAtual[0].resultado).locale(\"pt-br\").format(\"L\");\n\n			$('.input-group.divData').datepicker('update', datahoralocal);\n			var datafim = moment().locale(\"pt-br\").format(\"L\");\n			$('.date.dateSangriaEntrada').datepicker('update', datafim);\n\n		},\n		error: function () {\n			var dataini = moment().locale(\"pt-br\").format(\"L\");\n			$('.input-group.divData').datepicker('update', dataini);\n		}\n	});\n\n	$.ajax({\n		dataType: \"json\",\n		url: localStorage.getItem(\"host\"),\n		data: {\n			metodo: 'buscaTipoPagamento',\n			id: $scope.idCliente\n		},\n		success: function (data) {\n			var html = \"\";\n			html += '<option data-cartao=\"0\" value=\"\">Forma de Pagamento</option>';\n			for (var i = 0; i < data.result.length; i++) {\n				var codigo = data.result[i].TPa_Codigo;\n				var descricao = data.result[i].TPa_Descricao;\n				var cartao = data.result[i].TPa_Cartao;\n				html += '<option data-cartao=\"' + cartao + '\" value=\"' + codigo + '\" >' + descricao + '</option>';\n			}\n			$(\"#pFormaPag\").html(html);\n			$(\"#pFormaPagSaida\").html(html);\n			$(\"#pFormaPag\").change();\n		}\n	});\n\n	$(\"#pFormaPag\").change(function () {\n		if ($(\"#pFormaPag option:selected\")[0].dataset.cartao == 1) {\n			$(\"#bandeirasHide\").show();\n			$scope.buscabandeira($(\"#pFormaPag option:selected\").val());\n		} else {\n			$(\"#bandeirasHide\").hide();\n		}\n	});\n\n	$scope.buscabandeira = function (tpacodigo) {\n		$.ajax({\n			dataType: \"json\",\n			url: localStorage.getItem(\"host\"),\n			data: {\n				metodo: 'buscaTipoBandeira',\n				id: $scope.idCliente,\n				tpacodigo: tpacodigo\n			},\n			success: function (data) {\n				var html2 = '';\n				html2 += '<option  value=\"\" selected>Sem Bandeira</option>';\n				if (data.result.length > 0) {\n					for (var i = 0; i < data.result.length; i++) {\n						var codigo = data.result[i].TBa_Codigo;\n						var descricao = data.result[i].TBa_Descricao;\n						html2 += '<option  value=\"' + codigo + '\" >' + descricao + '</option>';\n					}\n				}\n				$(\"#divBandeiraPag\").html(html2);\n			}\n		});\n	};\n\n	$scope.buscaProfissionalValeCaixa = function () {\n		$http.get('/php/buscaSessao.php').\n		success(function (data, status, headers, config) {\n			$scope.idCliente = data;\n			$.ajax({\n				dataType: \"json\",\n				url: localStorage.getItem(\"host\"),\n				data: {\n					metodo: 'buscaProfissionais',\n					id: $scope.idCliente,\n					tipo: 5\n				},\n				success: function (data) {\n					var html = \"\";\n					html += '<option value=\"\">Profissional</option>';\n					for (var i = 0; i < data.profissionais.length; i++) {\n						var codigo = data.profissionais[i].Pes_Codigo;\n						var nome = data.profissionais[i].Pes_Nome;\n						var apelido = data.profissionais[i].Pes_Apelido;\n						html += '<option value=\"' + codigo + '\">' + nome + '</option>';\n					}\n					$(\"#buscaProfissionalCaixa\").html(html);\n				}\n			});\n		});\n	};\n\n	function init() {\n		carregaDados();\n		$scope.buscaReceita();\n		$scope.buscaDespesa();\n	}\n\n	$scope.buscaDespesa = function () {\n		var despesa = \"\";\n		$(\"#proxCaixa\").val(0)\n		$(\"#proxCaixa\").attr('disabled',false)\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/buscaDespesa.php\",\n			dataType: \"json\",\n			success: (result) => {\n				despesa += \"<option value=''>Nenhuma</option>\";\n				for (var i = 0; i < result.data.length; i++) {\n					despesa += \"<option value='\" + result.data[i].TDe_Codigo + \"' data-vale='\" + result.data[i].TDe_Vale + \"'>\" + result.data[i].TDe_Descricao + \"</option>\";\n				};\n				$('#buscaDespesaCaixa').html(despesa);\n			},\n			error: () => {}\n		});\n	}\n\n	$scope.buscaReceita = function () {\n		var receita = \"\";\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/buscaReceita.php\",\n			dataType: \"json\",\n			success: (result) => {\n				//$(\"#buscaReceitaCaixa\").multiselect(\"destroy\");\n				receita += \"<option value=''>Nenhuma</option>\";\n				for (var i = 0; i < result.data.length; i++) {\n					receita += \"<option value='\" + result.data[i].TRe_Codigo + \"'>\" + result.data[i].TRe_Descricao + \"</option>\";\n				};\n				$('#buscaReceitaCaixa').html(receita);\n				/*$('#buscaReceitaCaixa').multiselect({\n					enableFiltering: true,\n					nonSelectedText: 'Receitas',\n					filterPlaceholder: 'Buscar'\n				});*/\n			},\n			error: (result) => {\n				/*$('#buscaReceitaCaixa').multiselect({\n					enableFiltering: true,\n					nonSelectedText: 'Receitas',\n					filterPlaceholder: 'Buscar'\n				});*/\n			}\n		});\n	}\n\n	function colors(value, row, index) {\n		let cor = '';\n\n		if (value.FCM_Entrada == 1) {\n			cor = 'green';\n		} else {\n			cor = 'red';\n		}\n\n		return {\n			css: {\n				\"color\": cor,\n				\"font-size\": 'smaller'\n			}\n		};\n	}\n\n  function currencySorter(a, b) {\n		var numA = parseFloat(a.replace(/[^0-9,.-]/g, '').replace(',', '.'));\n		var numB = parseFloat(b.replace(/[^0-9,.-]/g, '').replace(',', '.'));\n		return numA - numB;\n	}\n\n	function editFormatter(value, row) {\n		var btnComanda = `<button class=\"btn btn-primary comandaModal btn-xs\" data-codigo=\"${row.FCM_Codigo}\">\n								<i class=\"fa fa-list-alt\" ></i>\n							</button>`;\n\n		var btnInfo = `<button class=\"btn btn-info infoModal btn-xs\" data-codigo=\"${row.FCM_Codigo}\">\n							<i class=\"fa fa-info\" ></i>\n						</button>`;\n\n		var btnRemover = `<button class=\"btn btn-danger btn-xs deletedModal\" data-codigo=\"${row.FCM_Codigo}\">\n								<i class=\"fa fa-trash\" ></i>\n							</button>`;\n\n\n		if (row.Com_Codigo == \"\") {\n			return `${btnInfo} ${btnRemover}`\n		} else {\n			return `${btnComanda} ${btnInfo} ${btnRemover}`\n		}\n	}\n\n	function carregaDados() {\n		\n		$.ajax({\n			type: \"GET\",\n			url: getStorage('host'),\n			data: {\n				tipo: 1,\n				metodo: 'buscaFinanceiroCaixa',\n				id: $_CONFIG.ID\n			},\n			dataType: \"json\",\n			success: (data) => {\n		\n				if (data.result.length > 0 && data.result[0].FCa_Codigo !== undefined) {\n					/*---------------------------------------------------------------------------------------------------------------------------*/\n					var fcacodigo = data.result[0].FCa_Codigo;\n					$(\"#FCaCodigoCaixa\").val(fcacodigo)\n					$(\".divLoader\").hide();\n					$('#boxMovCaixa').bootstrapTable('destroy')\n					$('#boxMovCaixa').bootstrapTable({\n						url: getStorage('host'),\n						method: 'get',\n						dataType: 'json',\n						queryParams: (p) => {\n							p.fcacodigo = fcacodigo;\n							p.metodo = 'buscaFinanceiroCaixaMovimentacao';\n							p.id = $_CONFIG.ID;\n							return p;\n						},\n						responseHandler: (res) => {\n							return res.result\n						},\n						contentType: 'application/x-www-form-urlencoded',\n						uniqueId: \"FCM_Codigo\",\n						rowStyle: colors,\n						iconSize: 'sm',\n						theadClasses: 'thead-light',\n						columns: [{\n								field: 'FCM_Descricao',\n								title: 'Descricao',\n								sortable: true\n							}, {\n								field: 'FCM_Valor',\n								title: 'Valor',\n								sortable: true,\n								sorter: currencySorter\n							},\n							{\n								field: 'TPa_Descricao',\n								title: 'Pagamento',\n								sortable: true\n							}, {\n								field: '',\n								formatter: editFormatter,\n								title: '',\n								width: \"85px\"\n							}\n						],\n						search: true,\n						showRefresh: true,\n						locale: 'pt-BR',\n						onSearch: (e) => {\n							$(\"#boxMovCaixa\").bootstrapTable('refresh');\n						},\n						onPostBody: () => {\n							$(\".comandaModal\").on(\"click\", function (e) {\n								$row = $(\"#boxMovCaixa\").bootstrapTable(\"getRowByUniqueId\", this.dataset.codigo);\n								$scope.verComanda($row.Com_Codigo)\n							});\n							$(\".infoModal\").on(\"click\", function (e) {\n								$row = $(\"#boxMovCaixa\").bootstrapTable(\"getRowByUniqueId\", this.dataset.codigo);\n								$scope.verMovimentacao($row.FCM_Codigo)\n							});\n\n							$(\".deletedModal\").on(\"click\", function (e) {\n								$row = $(\"#boxMovCaixa\").bootstrapTable(\"getRowByUniqueId\", this.dataset.codigo);\n								$scope.removeMovimentacao($row.FCM_Codigo)\n							});\n						}\n\n\n					});\n\n					$(\".caxCodigo\").val(data.result[0].FCa_Codigo);\n					$(\".caxDescricao\").val(data.result[0].FCa_Descricao);\n\n					if (data.result[0].FCa_Codigo == \"\") {\n						$(\".caxCodigoEnt\").val(\"\");\n					} else {\n						$(\".caxCodigoEnt\").val(data.result[0].FCa_Codigo);\n					}\n					$(\".caxCodigoSai\").val(data.result[0].FCa_Codigo);\n\n					$(\".lblNome\").html(data.result[0].Usu_Nome);\n					$(\".lblData\").html(data.result[0].FCa_Dat_Caixa);\n					$(\".lblTotalCaixa\").html(data.result[0].FCa_Saldo);\n					$(\".lblValorInicial\").html(data.result[0].FCa_Vlr_Inicial);\n					$(\".boxCaixa\").show();\n					$(\".semCaixa\").hide();\n\n					$(\"#iconCaixa\").hide();\n					$(\".btn-caixa\").removeClass('caixa-fechado');\n\n\n					\n					var listaPagCaixaEntrada = [];\n					var listaPagCaixaSaida = [];\n					var listaPagCaixaOther = [];\n					$.ajax({\n						type: \"GET\",\n						url: getStorage('host'),\n						async: false,\n						data: {\n							tipo: 13,\n							metodo: 'buscaFinanceiroCaixa',\n							id: $_CONFIG.ID\n						},\n						dataType: \"json\",\n						success: (result) => {\n\n							for (var i = 0; i < result.result.length; i++) {\n								if(result.result[i].FCM_Entrada == 1){\n									listaPagCaixaEntrada.push(result.result[i])\n								}else if(result.result[i].FCM_Entrada == 0){\n									listaPagCaixaSaida.push(result.result[i])\n									\n								}else{\n									listaPagCaixaOther.push(result.result[i])\n								}\n							}\n						},\n						error: () => {\n							console.log(\"Falha na conexão.\", \"\", \"error\");\n						}\n					})\n\n					var primary = [];\n					var secondary = [];\n					var primaryColor = '';\n					var secondaryColor = '';\n					var primaryValor = 0.00;\n					var secondaryValor = 0.00;\n					var primarytype = '';\n					var secondarytype = '';\n					if(listaPagCaixaEntrada.length >= listaPagCaixaSaida.length){\n						primary = listaPagCaixaEntrada;\n						secondary = listaPagCaixaSaida;\n						primaryColor = 'green';\n						secondaryColor = 'red';\n						primarytype = 'Entradas';\n						secondarytype = 'Saídas';\n						\n					}else{\n						primary = listaPagCaixaSaida;\n						secondary = listaPagCaixaEntrada;\n						primaryColor = 'red';\n						secondaryColor = 'green';\n						primarytype = 'Saídas';\n						secondarytype = 'Entradas';\n					}\n					$(\".divTotalizador\").html('')\n					$(\".divTotalizador\").append(`<tr><th><b>${primarytype}</b></th><th><b>${secondarytype}</b></th></tr>`)\n\n					for (var j = 0; j < primary.length; j++) {\n						if(secondary.length > 0){\n							for (var k = 0; k < secondary.length; k++) {\n								if(primary[j].TPa_Codigo == secondary[k].TPa_Codigo){\n									$(\".divTotalizador\").append(`<tr><td><span style=\"color:${primaryColor}\">${primary[j].TipoPagamento}: <b>${primary[j].Valor}</b></span></td><td><span style=\"color:${secondaryColor}\">${secondary[k].TipoPagamento}: <b>${secondary[k].Valor}</b></span></td></tr>`)\n									primaryValor = primaryValor + parseFloat(primary[j].ValorReal)\n									secondaryValor = secondaryValor + parseFloat(secondary[k].ValorReal)\n									secondary.splice(k,1);\n									break;\n								}else if(k == (secondary.length - 1)){\n									$(\".divTotalizador\").append(`<tr><td><span style=\"color:${primaryColor}\">${primary[j].TipoPagamento}: <b>${primary[j].Valor}</b></span></td><td>-</td></tr>`)\n									primaryValor = primaryValor + parseFloat(primary[j].ValorReal)\n								}\n							}\n							if(j == (primary.length -1 ) && secondary.length > 0){\n								for (var l = 0; l < secondary.length; l++) {\n									$(\".divTotalizador\").append(`<tr><td>-</td><td><span style=\"color:${secondaryColor}\">${secondary[l].TipoPagamento}: <b>${secondary[l].Valor}</b></span</td></tr>`)\n									secondaryValor = secondaryValor + parseFloat(secondary[l].ValorReal)\n								}\n							}\n						}else{\n							$(\".divTotalizador\").append(`<tr><td><span style=\"color:${primaryColor}\">${primary[j].TipoPagamento}: <b>${primary[j].Valor}</b></span></td><td>-</td></tr>`)\n							primaryValor = primaryValor + parseFloat(primary[j].ValorReal)\n						}\n					}\n					for (var m = 0; m < listaPagCaixaOther.length; m++) {\n						$(\".divTotalizador\").append(`<tr><td >${listaPagCaixaOther[m].TipoPagamento}: <b>${listaPagCaixaOther[m].Valor}</b></td><td>-</td></tr>`)\n					}\n					$(\".divTotalizador\").append(`<tr><td>Total de ${primarytype}: <b>${$_CONFIG.MOEDA} ${primaryValor.toFixed(2).replace('.',',')}</b></td><td>Total de ${secondarytype}: <b>${$_CONFIG.MOEDA} ${secondaryValor.toFixed(2).replace('.',',')}</b></td></tr>`)\n\n\n				} else {\n					$.ajax({\n						type: \"POST\",\n						url: \"/pages/cadastros/buscaFinanceiroCaixa.php\",\n						data: {\n							tipo: 2\n						},\n						dataType: \"json\",\n						success: (data2) => {\n							if (data2.result[0].PrimeiroCaixa == \"1\") {\n								$(\"#msgPrimeiroCaixa\").show();\n							} else {\n								$(\"#msgPrimeiroCaixa\").hide();\n							}\n						},\n						error: () => {\n							console.log(\"Falha na conexão.\", \"\", \"error\");\n						}\n					});\n					$(\".lblTotalCaixa\").html(\"\");\n					$(\".lblValorInicial\").html(\"\");\n					$(\".lblNome\").html(\"\");\n					$(\".lblData\").html(\"\");\n					$(\".boxCaixa\").hide();\n					$(\".semCaixa\").show();\n\n					$(\"#iconCaixa\").show();\n					$(\".btn-caixa\").addClass('caixa-fechado');\n				}\n\n				resizeContent();\n			},\n			error: () => {\n				console.log(\"Falha na conexão.\", \"\", \"error\");\n			}\n		});\n	}\n\n	$('#formCadastroCaixa').submit(function (event) {\n		event.preventDefault();\n		showLoader(true);\n		dataForm = new FormData(this);\n		dataForm.append(\"valor\", $('#caxValor').maskMoney('unmasked')[0]);\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/insereFinanceiroCaixa.php\",\n			data: dataForm,\n			dataType: \"json\",\n			processData: false,\n			contentType: false,\n			success: (result) => {\n				if (result.result[0].erro == \"0\") {\n					toastr.success(result.result[0].resultado);\n					$('#cadastrarCaixa-modal').modal('hide');\n					carregaDados();\n				} else {\n					swal(result.result[0].resultado, \"\", \"error\");\n				}\n				showLoader(false);\n			},\n			error: () => {\n				swal(\"Falha na conexão.\", \"\", \"error\");\n				showLoader(false);\n			}\n		});\n		return true;\n	});\n\n	$('#formCaxEntrada').submit(function (event) {\n		event.preventDefault();\n		formentrada = $(this);\n		showLoader(true);\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/insereFinanceiroCaixaMovimentacaov2.php\",\n			data: {\n				codigo: $(\"#caxCodigoEnt\").val(),\n				valor: $('#caxValorEnt').maskMoney('unmasked')[0],\n				descricao: $(\"#caxDescEnt\").val(),\n				tpacodigo: $(\"#pFormaPag option:selected\").val(),\n				tbacodigo: $(\"#divBandeiraPag option:selected\").val(),\n				tipo: 1,\n				trecodigo: $(\"#buscaReceitaCaixa option:selected\").val(),\n				suprimento: $(\"#suprimentoCaixa\").val()\n				\n			},\n			dataType: \"json\",\n			success: (result) => {\n				if (result.result[0].erro == \"0\") {\n					toastr.success(result.result[0].resultado);\n					carregaDados();\n					$(\"#entradaCaixa-modal\").modal(\"hide\");\n					$(\"#pFormaPag\").val(\"\");\n					$(\"#pFormaPag\").change();\n					$(\"#divBandeiraPag\").hide();\n					formentrada.each(function () {\n						this.reset();\n					});\n				} else {\n					swal(result.result[0].resultado, \"\", \"error\");\n				}\n				showLoader(false);\n				$scope.deselectMultiselect();\n			},\n			error: (result) => {\n				swal(\"Falha na conexão.\", \"\", \"error\");\n				showLoader(false);\n			}\n		});\n		return true;\n	});\n\n	$(\"#sangria\").change(() => {\n		if ($(\"#sangria\").is(\":checked\")) {\n			$(\"#proxCaixa\").val(0)\n			$(\"#proxCaixa\").prop('disabled', true)\n			if ($(\"#buscaDespesaCaixa option:selected\").get(0).dataset.vale == 1) {\n				$(\"#buscaDespesaCaixa\").val(\"\");\n				$(\"#buscaDespesaCaixa\").change();\n				toastr.error(\"Sangrias de Caixa não podem ser vales\");\n			}\n		} else {\n			$(\"#proxCaixa\").val(0)\n			$(\"#proxCaixa\").prop('disabled', false)\n		}\n	})\n\n	$('#formCaxSaida').submit(function (event) {\n		$(\"#btnSalvarMovCaixa\").attr('disabled', true);\n		var sangria = 0;\n		if ($(\"#sangria\").is(\":checked\")) {\n			sangria = 1;\n		} else {\n			sangria = 0;\n		}\n		event.preventDefault();\n		showLoader(true);\n		var valorSaidaCaixa = $('#caxValorSai').val()\n		var descricaoSaidaCaixa = $(\"#caxDescSai\").val()\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/insereFinanceiroCaixaMovimentacao.php\",\n			data: {\n				codigo: $(\"#caxCodigoSai\").val(),\n				valor: $('#caxValorSai').maskMoney('unmasked')[0],\n				descricao: $(\"#caxDescSai\").val(),\n				tipo: 0,\n				tdecodigo: $(\"#buscaDespesaCaixa option:selected\").val(),\n				proximocaixa: $(\"#proxCaixa option:selected\").val(),\n				profissional: $(\"#buscaProfissionalCaixa\").val(),\n				sangria: sangria,\n				tpacodigo: $(\"#pFormaPagSaida\").val()\n			},\n			dataType: \"json\",\n			success: (result) => {\n				if (result.result[0].erro == \"0\") {\n					toastr.success(result.result[0].resultado);\n					\n					if (sangria == 1) {\n						swal({\n							title: \"Sangria de Caixa\",\n							text: \"Você acabou de fazer uma sangria de caixa, é recomendado que você realize uma entrada de sangria no seu financeiro, deseja realizar essa entrada agora?\",\n							type: \"warning\",\n							showCancelButton: true,\n							confirmButtonColor: \"#DD6B55\",\n							confirmButtonText: \"Sim\",\n							cancelButtonText: \"Não\"\n						}, (isconfirm) => {\n							if (isconfirm) {\n								$scope.buscaContaComboSangria();\n								$(\"#valorInsereFinSangria\").val(valorSaidaCaixa)\n								$(\"#descricaoInsereFinSangria\").val('Entrada de sangria referente a movimentação: ' + descricaoSaidaCaixa)\n								$(\"#insereFinanceiroSangria-modal\").modal()\n							} else {\n								toastr.warning(\"Você optou por não inserir a movimentação agora. Você pode fazer o lançamento manualmente em 'Financeiro > Entrada/Saída' quando desejar.\");\n							}\n						});\n					}\n					carregaDados();\n\n					$(\"#saidaCaixa-modal\").modal(\"hide\");\n					$(\"#caxValorSai\").val(\"\");\n					$(\"#caxDescSai\").val(\"\");\n					$(\"#sangria\").prop(\"checked\", false);\n					$(\"#btnSalvarMovCaixa\").attr('disabled', false);\n				} else {\n					toastr.error(result.result[0].resultado);\n					$(\"#btnSalvarMovCaixa\").attr('disabled', false);\n				}\n				showLoader(false);\n				$scope.deselectMultiselect();\n				$(\"#divProfissionalCaixa\").hide();\n			},\n			error: () => {\n				$(\"#btnSalvarMovCaixa\").attr('disabled', false);\n				swal(\"Falha na conexão.\", \"\", \"error\");\n				showLoader(false);\n			}\n		});\n		return true;\n	});\n\n\n	$scope.btnfecharcaixa = function () {\n\n		var textomsg = \"\";\n		var hasSaidaCaixa = 0;\n		$.ajax({\n			dataType: \"json\",\n			type: \"POST\",\n			url: '/pages/cadastros/buscaFinanceiroCaixa.php',\n			async: false,\n			data: {\n				fcacodigo: $(\"#caxCodigo\").val(),\n				tipo: 12\n			},\n			success: (data) => {\n				if (data.result.length > 0) {\n					textomsg = \"Deseja fechar este caixa?\"\n					hasSaidaCaixa = 1;\n				} else {\n					textomsg = \"ATENÇÃO: Não existe nenhuma saída para o próximo caixa, Deseja realmente fechar esse caixa?\"\n					hasSaidaCaixa = 0;\n				}\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n			}\n		});\n\n		if(!hasSaidaCaixa){\n			$(\"#semSaidaCaixa-modal\").modal()\n\n		}else{\n			swal({\n				title: \"Confirmar fechamento:\",\n				type: \"input\",\n				inputPlaceholder: \"Observações\",\n				showCancelButton: true,\n				confirmButtonColor: \"#DD6B55\",\n				confirmButtonText: \"Sim\",\n				cancelButtonText: \"Não\",\n				inputValue: $(\"#caxDescricao\").val(),\n				text: textomsg\n			}, (inputValue) => {\n				showLoader(true);\n				$.ajax({\n					dataType: \"json\",\n					method: \"POST\",\n					url: '/pages/cadastros/atualizaFinanceiroCaixav3.php',\n					data: {\n						codigo: $(\"#caxCodigo\").val(),\n						tipo: 1,\n						descricao: inputValue\n					},\n					success: (data) => {\n						if (data.data[0].erro == \"0\") {\n							toastr[\"success\"](\"Caixa finalizado com Sucesso.\");\n							carregaDados();\n						} else {\n							swal(\"Falha ao Finalizar.\", data.data[0].resultado, \"error\");\n						}\n						showLoader(false);\n					},\n					error: () => {\n						swal(\"Falha na conexão.\", \"\", \"error\");\n						showLoader(false);\n					}\n				});\n			});\n		}\n\n	};\n\n	$scope.fechaCaixaSemSaida = function(){\n		$(\"#semSaidaCaixa-modal\").modal('hide')\n		$.ajax({\n			dataType: \"json\",\n			type: \"POST\",\n			url: '/pages/cadastros/buscaFinanceiroCaixa.php',\n			async: false,\n			data: {\n				fcacodigo: $(\"#caxCodigo\").val(),\n				tipo: 12\n			},\n			success: (data) => {\n				if (data.result.length > 0) {\n					textomsg = \"Deseja fechar este caixa?\"\n					hasSaidaCaixa = 1;\n				} else {\n					textomsg = \"ATENÇÃO: Não existe nenhuma saída para o próximo caixa, Deseja realmente fechar esse caixa?\"\n					hasSaidaCaixa = 0;\n				}\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n			}\n		});\n\n		swal({\n			title: \"Confirmar fechamento:\",\n			type: \"input\",\n			inputPlaceholder: \"Observações\",\n			showCancelButton: true,\n			confirmButtonColor: \"#DD6B55\",\n			confirmButtonText: \"Sim\",\n			cancelButtonText: \"Não\",\n			inputValue: $(\"#caxDescricao\").val(),\n			text: textomsg\n		}, (inputValue) => {\n			showLoader(true);\n			$.ajax({\n				dataType: \"json\",\n				method: \"POST\",\n				url: '/pages/cadastros/atualizaFinanceiroCaixav3.php',\n				data: {\n					codigo: $(\"#caxCodigo\").val(),\n					tipo: 1,\n					descricao: inputValue\n				},\n				success: (data) => {\n					if (data.data[0].erro == \"0\") {\n						toastr[\"success\"](\"Caixa finalizado com Sucesso.\");\n						carregaDados();\n					} else {\n						swal(\"Falha ao Finalizar.\", data.data[0].resultado, \"error\");\n					}\n					showLoader(false);\n				},\n				error: () => {\n					swal(\"Falha na conexão.\", \"\", \"error\");\n					showLoader(false);\n				}\n			});\n		});\n	}\n\n	$scope.addSaidaProximoCaixa = function(){\n		$(\"#semSaidaCaixa-modal\").modal('hide');\n		$(\"#proxCaixa\").val(1)\n		$(\"#proxCaixa\").attr('disabled',true)\n		$(\"#saidaCaixa-modal\").modal()\n	}\n\n	$(\"#btnAtualizaCaixa\").click(() => {\n		carregaDados();\n	});\n\n	$scope.removeMovimentacao = function (codigo) {\n		swal({\n			title: \"Confirmar remoção:\",\n			text: \"Deseja remover este item?\",\n			type: \"warning\",\n			showCancelButton: true,\n			confirmButtonColor: \"#DD6B55\",\n			confirmButtonText: \"Sim\",\n			cancelButtonText: \"Não\"\n		}, () => {\n			showLoader(true);\n			$.ajax({\n				dataType: \"json\",\n				method: \"POST\",\n				url: '/pages/cadastros/removeFinanceiroCaixaMovimentacao.php',\n				data: {\n					codigo: codigo\n				},\n				success: (data) => {\n					if (data.result[0].erro == \"0\") {\n						toastr.success(\"Movimentação removida com Sucesso.\");\n						carregaDados();\n					} else {\n						swal(\"Falha ao Remover.\", data.result[0].resultado, \"error\");\n					}\n					showLoader(false);\n				},\n				error: (result) => {\n					swal(\"Falha na conexão.\", \"\", \"error\");\n					showLoader(false);\n				}\n			});\n		});\n	}\n\n	$scope.deselectMultiselect = function () {\n		$('#buscaDespesaCaixa').val('');\n		$('#buscaDespesaCaixa').change();\n		$('#proxCaixa').val(0);\n		$('#proxCaixa').change();\n		/*$('#buscaReceitaCaixa').multiselect('select', ['']);\n		$('#buscaReceitaCaixa').multiselect('refresh');*/\n	}\n\n	$scope.verComanda = function (codigo) {\n		$(\"#vercomanda-modal\").modal(\"show\");\n		$(\"#idComandaVer\").html(codigo);\n\n		if (typeof (tabelaComItensVer) != \"undefined\") {\n			tabelaComItensVer.api().destroy();\n		}\n\n		tabelaComItensVer = $('#tbComandaItensVer').dataTable({\n			ajax: \"/pages/cadastros/buscaItensComanda.php?codigo=\" + codigo,\n			language: {\n				\"url\": \"//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json\"\n			},\n			bPaginate: false,\n			bLengthChange: false,\n			bFilter: false,\n			bSort: false,\n			bInfo: false,\n			bAutoWidth: false,\n			\"scrollX\": isPortrait,\n			\"fnRowCallback\": (nRow, aData) => {\n				var id = aData.Cortesia;\n				if (id == 1) {\n					nRow.children[8].innerHTML = 'Sim';\n				} else {\n					nRow.children[8].innerHTML = 'Não';\n				}\n			},\n			initComplete: function () {\n				var vlrTotal = this.fnGetData(0);\n				$(\"#valorTotalComandaVer\").html($_CONFIG.MOEDA + vlrTotal.ValorTotal);\n				if (vlrTotal.comandaVlrPagamento != \"\") {\n					$(\"#valorPagoComandaVer\").html($_CONFIG.MOEDA + vlrTotal.comandaVlrPagamento);\n					$(\"#vlrPagoVer\").css(\"display\", \"block\");\n				} else {\n					$(\"#vlrPagoVer\").css(\"display\", \"none\");\n					$(\"#valorPagoComandaVer\").html(\"\");\n				}\n\n				$(\"#nomeClienteComandaVer\").html(vlrTotal.Cliente);\n				$(\"#idComandaVer\").html(vlrTotal.Codigo);\n				$(\"#dataComandaVer\").html(vlrTotal.dataComanda);\n			\n				\n				$(\"#comValorPagVer\").val(vlrTotal.ValorTotal);\n				$(\"#pagamentoComandaVer\").html(vlrTotal.tipoPagamento.replace(\"/\", \"<br>\"));\n			},\n			columnDefs: [{\n				\"targets\": [0, 1, 2, 3, 5, 6, 11, 12],\n				\"visible\": false,\n				\"searchable\": false\n			}],\n			columns: [{\n					\"data\": \"Codigo\"\n				},\n				{\n					\"data\": \"CodItem\"\n				},\n				{\n					\"data\": \"CodSerPro\"\n				},\n				{\n					\"data\": \"TipoItem\"\n				},\n				{\n					\"data\": \"ImgItem\"\n				},\n				{\n					\"data\": \"Data\"\n				},\n				{\n					\"data\": \"Usuario\"\n				},\n				{\n					\"data\": \"Valor\"\n				},\n				{\n					\"data\": \"ValorUn\"\n				},\n				{\n					\"data\": \"Desconto\"\n				},\n				{\n					\"data\": \"Quantidade\"\n				},\n				{\n					\"data\": \"Comissao\"\n				},\n				{\n					\"data\": \"ValorTotal\"\n				},\n				{\n					\"data\": \"Item\"\n				},\n				{\n					\"data\": \"Profissional\"\n				},\n				{\n					\"data\": \"Cliente\"\n				},\n				{\n					\"data\": \"Cortesia\"\n				},\n				{ \"data\":null,\n					\"defaultContent\":'',\n					\"render\": function (data,t,row) {\n						if(row.ExistePacote == '1'){\n							return 'Pacote';\n						}else if(row.asscodigo != ''){\n							return 'Clube de Assintura'\n						}\n					}\n				}\n			]\n		});\n	};\n\n	$scope.$on(\"$destroy\", function () {\n		if (isMobile) {\n			$(\".btn-caixa\").hide();\n		} else {\n			$(\".btn-caixa\").show();\n		}\n		carregaDados();\n\n	});\n\n	// if (intervalCaixa === undefined) {\n	// 	intervalCaixa = $interval(function () {\n	// 		carregaDados();\n	// 	}, $scope.timerIntervalCaixa);\n		\n	// }\n	$(\"#btn-caixa_busca\").click(function(){\n\n		var shroom = $(\"#caixaSide\");\n		if (shroom.hasClass('open')) {\n			carregaDados();\n		}\n	})\n\n	init();\n\n	$(\"#divProfissionalCaixa\").hide();\n\n	$(\"#buscaDespesaCaixa\").change(() => {\n		if ($(\"#buscaDespesaCaixa option:selected\").get(0).dataset.vale == 1) {\n			if ($(\"#sangria\").is(\":checked\")) {\n				$(\"#buscaDespesaCaixa\").val(\"\")\n				$(\"#buscaDespesaCaixa\").change()\n				toastr.error(\"Sangrias de Caixa não podem ser vales\");\n			} else {\n				$scope.buscaProfissionalValeCaixa();\n				$(\"#divProfissionalCaixa\").show();\n				$(\"#proxCaixa\").val(0);\n				$(\"#proxCaixa\").prop('disabled', true);\n			}\n\n		} else {\n			$(\"#buscaProfissionalCaixa\").val('');\n			$(\"#divProfissionalCaixa\").hide();\n			if ($(\"#sangria\").is(\":checked\")) {\n				$(\"#proxCaixa\").val(0);\n				$(\"#proxCaixa\").prop('disabled', true);\n			} else {\n				$(\"#proxCaixa\").val(0);\n				$(\"#proxCaixa\").prop('disabled', false);\n			}\n		}\n	});\n\n	$('#proxCaixa').change(() => {\n		if ($(\"#buscaDespesaCaixa option:selected\").get(0).dataset.vale == 1) {\n			toastr.error(\"Vales não podem ser lançados como saídas para proximos caixas\");\n			$(\"#buscaDespesaCaixa\").val(\"\")\n			$(\"#buscaDespesaCaixa\").change()\n		}\n\n	});\n\n	$scope.editaCaixaModal = function () {\n		$(\"#valorInicialCaixaEdt\").val(parseFloat($(\".lblValorInicial\").html().replace(',', '.').replace($_CONFIG.MOEDA, '')).toFixed(2))\n		$(\"#editaCaixa-modal\").modal();\n	}\n	$scope.editaDataCaixaModal = function () {\n		$(\"#editaDataCaixa-modal\").modal();\n	}\n\n	$scope.editaCaixa = function () {\n		showLoader(true);\n		$.ajax({\n			dataType: \"json\",\n			type: \"POST\",\n			url: '/pages/cadastros/alteraFinanceiroCaixa.php',\n			data: {\n				fcacodigo: $(\"#caxCodigo\").val(),\n				valor: $(\"#valorInicialCaixaEdt\").val().replace(',', '.'),\n				tipo: 1\n			},\n			success: (data) => {\n				if (data.data[0].erro == \"0\") {\n					$(\"#editaCaixa-modal\").modal(\"hide\");\n					toastr.success(data.data[0].resultado);\n					carregaDados();\n					$(\"#valorInicialCaixaEdt\").val(\"\");\n				} else {\n					toastr.success(data.data[0].error);\n				}\n				showLoader(false);\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n				showLoader(false);\n			}\n		});\n	}\n\n	$scope.editaCaixaData = function () {\n		showLoader(true);\n		$.ajax({\n			dataType: \"json\",\n			type: \"POST\",\n			url: '/pages/cadastros/alteraFinanceiroCaixa.php',\n			data: {\n				fcacodigo: $(\"#caxCodigo\").val(),\n				data: $(\"#DataCaixaEdt\").val(),\n				tipo: 2\n			},\n			success: (data) => {\n				if (data.data[0].erro == \"0\") {\n					$(\"#editaDataCaixa-modal\").modal(\"hide\");\n					toastr.success(data.data[0].resultado);\n					carregaDados();\n\n				} else {\n					toastr.success(data.data[0].error);\n				}\n				showLoader(false);\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n				showLoader(false);\n			}\n		});\n	}\n\n	$scope.buscaSugestaoCaixa = function () {\n		$.ajax({\n			dataType: \"json\",\n			url: localStorage.getItem(\"host\"),\n			data: {\n				metodo: 'buscaDataAtual',\n				id: $scope.idCliente\n			},\n			success: function (data) {\n				var datahoralocal = moment(data.buscaDataAtual[0].resultado).locale(\"pt-br\").format(\"L\");\n	\n				$('.input-group.divData').datepicker('update', datahoralocal);\n				var datafim = moment().locale(\"pt-br\").format(\"L\");\n				$('.date.dateSangriaEntrada').datepicker('update', datafim);\n	\n			},\n			error: function () {\n				var dataini = moment().locale(\"pt-br\").format(\"L\");\n				$('.input-group.divData').datepicker('update', dataini);\n			}\n		});\n		$.ajax({\n			dataType: \"json\",\n			type: \"POST\",\n			url: '/pages/cadastros/buscaFinanceiroCaixa.php',\n			data: {\n				tipo: 9\n			},\n			success: (data) => {\n				if (data.result.length > 0) {\n					$(\"#caxValor\").val(data.result[0].FCM_Valor);\n\n				} else {\n					$(\"#caxValor\").val('');\n				}\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n			}\n		});\n	}\n\n	$scope.verMovimentacao = function (codigo) {\n		$.ajax({\n			dataType: \"json\",\n			type: \"POST\",\n			url: '/pages/cadastros/buscaFinanceiroCaixaMovimentacaoDetalhes.php',\n			data: {\n				fcmcodigo: codigo\n			},\n			success: (data) => {\n				$(\"#btnGeraReciboCaixa\").unbind('click');\n				$(\"#horaMovimentacao\").html(data.result[0].FCM_Dat_Cadastro);\n\n				if (data.result[0].FCM_Entrada == 0) {\n					$(\"#tipoReceitaDespesa\").html(\"Despesa\");\n					$(\"#DesRecMovimentacao\").html(data.result[0].TDe_Descricao);\n				} else {\n					$(\"#tipoReceitaDespesa\").html(\"Receita\");\n					$(\"#DesRecMovimentacao\").html(data.result[0].TRe_Descricao);\n				}\n\n				if (data.result[0].FCM_Entrada == 1) {\n					$(\"#pagMovimentacao\").html(data.result[0].TPa_Descricao);\n					$(\"#labelPagamento\").show()\n				} else {\n					$(\"#pagMovimentacao\").html(\"\");\n					$(\"#labelPagamento\").hide()\n				}\n\n				$(\"#sanMovimentacao\").html(data.result[0].Sangria);\n				$(\"#proxCaixaMovimentacao\").html(data.result[0].ProxCaixa);\n\n				if(data.result[0].TDe_Vale == 0){\n					$(\"#divValeReciboCaixa\").hide()\n				}else{\n					$(\"#divValeReciboCaixa\").show()\n				}\n\n				$(\"#btnGeraReciboCaixa\").click(()=>{\n					$scope.geraReciboVale(data.result[0])\n				})\n\n				$(\"#infoMovimentacaoCaixa-modal\").modal();\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n			}\n		});\n	}\n\n	$(\"#botaocaixa\").click(function(){\n		var disp = \"\";\n		var rece = \"\";\n		$.ajax({\n			dataType: \"json\",\n			type: \"POST\",\n			url: '/pages/cadastros/buscaFinanceiroCaixa.php',\n			async: false,\n			data: {\n				fcacodigo: $(\"#caxCodigo\").val(),\n				tipo: 10\n			},\n			success: (data) => {\n				if (data.result[0].erro != \"1\") {\n					disp = data.result[0].Valor;\n\n				} else {\n					disp = \"\";\n				}\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n			}\n		});\n\n		$.ajax({\n			dataType: \"json\",\n			type: \"POST\",\n			url: '/pages/cadastros/buscaFinanceiroCaixa.php',\n			async: false,\n			data: {\n				fcacodigo: $(\"#caxCodigo\").val(),\n				tipo: 11\n			},\n			success: (data) => {\n				if (data.result[0].erro != \"1\") {\n					rece = data.result[0].Valor;\n\n				} else {\n					rece = \"\";\n				}\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n			}\n		});\n\n		$(this).attr('data-content', '<div><i data-toggle=\"tooltip\" data-placement=\"top\" title=\"Valor de movimentações que não constam como cartão\" class=\"fa fa-question-circle\" style=\"color:grey\" ></i>&nbspSaldo Disponível: ' + disp + '</div><br><div><i data-toggle=\"tooltip\" data-placement=\"bottom\" title=\"Total de movimentações desconsiderando as saídas e o valor inicial\" class=\"fa fa-question-circle\" style=\"color:grey\" ></i>&nbspTotal de recebimentos: ' + rece + '</div>');\n		$(this).popover('show')\n	})\n\n	$('#formDespesaCaixa').submit((event) => {\n\n		event.preventDefault();\n\n		showLoader(true);\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/insereDespesa.php\",\n			data: {\n				Despesa: $(\"#DespesaCaixa\").val(),\n				vale: $(\"#vale\").val()\n			},\n			dataType: \"json\",\n			success: (result) => {\n				if (result.data[0].erro == \"0\") {\n					toastr.success(result.data[0].resultado);\n					$('#despesacaixa-modal').modal(\"hide\");\n					$(\"#DespesaCaixa\").val(\"\")\n					$scope.buscaDespesa(false);\n				} else {\n					toastr.error(result.data[0].resultado);\n				}\n				showLoader(false);\n			},\n			error: () => {\n				toastr.error(\"Falha na conexão.\");\n				showLoader(false);\n			}\n		});\n\n		return true;\n	});\n\n	$(\"#btnImprimecaixa\").click(() => {\n		showLoader(true);\n		var dadosCaixa = {\n			Usu_Nome: $('.lblNome').html(),\n			FCa_Vlr_Inicial: $('.lblValorInicial').html(),\n			FCa_Saldo: $('.lblTotalCaixa').html(),\n			FCa_Dat_Caixa: $('.lblData').html()\n		};\n		var codigo = $(\"#caxCodigo\").val();\n		buscaPrintCaixa(codigo, dadosCaixa)\n\n	})\n\n	$(\"#btnImprimecaixanaofiscal\").click(() => {\n		showLoader(true);\n		var dadosCaixa = {\n			Usu_Nome: $('.lblNome').html(),\n			FCa_Vlr_Inicial: $('.lblValorInicial').html(),\n			FCa_Saldo: $('.lblTotalCaixa').html(),\n			FCa_Dat_Caixa: $('.lblData').html()\n		};\n		var codigo = $(\"#caxCodigo\").val();\n		buscaPrintCaixaNaoFiscal(codigo, dadosCaixa);\n	})\n\n	$scope.buscaContaComboSangria = function () {\n		var conta = \"\";\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/buscaSubConta.php\",\n			dataType: \"json\",\n			success: (result) => {\n				conta += \"<option value=''>Nenhuma</option>\";\n				for (var i = 0; i < result.data.length; i++) {\n					conta += \"<option value='\" + result.data[i].Con_Codigo + \"'>\" + result.data[i].Con_Descricao + \"</option>\";\n				};\n				$(\"#buscaContaFinSangria\").html(conta)\n			},\n			error: () => {}\n		});\n	}\n\n	$scope.insereEntradaSangriaCaixa = function () {\n\n		if ($(\"#descricaoInsereFinSangria\").val() == \"\") {\n			toastr.error(\"Informe a descrição.\");\n		} else if ($(\"#valorInsereFinSangria\").val() == \"\") {\n			toastr.error(\"Informe o valor.\");\n		} else if ($(\"#dataInsereFinSangria\").val() == \"\") {\n			toastr.error(\"Infome a data.\");\n		} else {\n			showLoader(true);\n			$.ajax({\n				type: \"POST\",\n				url: \"/pages/cadastros/insereFinanceirov4.php\",\n				dataType: \"json\",\n				data: {\n					finDescricao: $(\"#descricaoInsereFinSangria\").val(),\n					finValor: $(\"#valorInsereFinSangria\").val(),\n					finEntradaSaida: 1,\n					finData: $(\"#dataInsereFinSangria\").val(),\n					finBaixado: 1,\n					buscaDespesa: \"\",\n					buscaReceita: \"\",\n					buscaProfissional: \"\",\n					buscaConta: $(\"#buscaContaFinSangria\").val(),\n					notafiscal: \"\",\n					buscaFornecedor: \"\",\n					entradaSangria: 1,\n					retiradaFinanceiro: 0,\n					tipoPagamento: \"\"\n				},\n				success: (result) => {\n					$(\"#descricaoInsereFinSangria\").val(\"\")\n					$(\"#valorInsereFinSangria\").val(\"\")\n					$(\"#dataInsereFinSangria\").val(\"\")\n					$(\"#buscaContaFinSangria\").val(\"\"),\n						toastr.success(result.result[0].resultado);\n					$(\"#insereFinanceiroSangria-modal\").modal('hide')\n					showLoader(false);\n				},\n				error: (result) => {\n					toastr.error(\"Falha na conexão.\");\n					showLoader(false);\n				}\n			});\n		}\n	}\n\n	//------------------------------------------------------------------------------------------------\n\n	function viewcolors(value, row, index) {\n\n		let cor = '';\n		console.log(value)\n		if (value.Entrada == 1) {\n			cor = 'green';\n		} else if (value.Entrada == 0) {\n			cor = 'red';\n		} else if (value.Entrada == 3) {\n			cor = 'blue'\n		} else {\n			cor = 'dark-gray'\n		}\n\n		return {\n			css: {\n				\"color\": cor,\n				\"font-size\": 'smaller'\n			}\n		};\n	}\n\n	function viewFormatter(value, row) {\n		var btnComanda = `<button class=\"btn btn-primary viewcomandaModal btn-xs\" data-codigo=\"${row.Codigo}\">\n								<i class=\"fa fa-list-alt\" ></i>\n							</button>`;\n\n		var btnInfo = `<button class=\"btn btn-info viewinfoModal btn-xs\" data-codigo=\"${row.Codigo}\">\n							<i class=\"fa fa-info\" ></i>\n						</button>`;\n\n\n		if (row.ComCodigo == \"\" && row.Entrada != 2 && row.Entrada != 3) {\n			return `${btnInfo} `\n		} else if (row.Entrada != 2 && row.Entrada != 3) {\n			return `${btnComanda} ${btnInfo} `\n		}\n	}\n\n	function formatterFooter(data) {\n		if (data.length > 0) {\n			return `<ul  id=\"totalCaixaMovDia\" ><li ><h4><b>Saldo do Dia:</b> ${data[0].Saldo}</h4></li><li ><h4><b>Saldo Liquido do Dia:</b> ${data[0].SaldoLiquido}</h4></li></ul>`; //data.Saldo\n		}\n	}\n\n	$scope.verDiaCaixa = function () {\n		$scope.buscaCaixaMovimentacaoDia($(\"#FCaCodigoCaixa\").val());\n	}\n\n	$scope.buscaCaixaMovimentacaoDia = function (fcacodigo) {\n		\n		var tiposPagamento = '';\n		var datapagamento = '';\n		$.ajax({\n			type: \"POST\",\n			url: \"/pages/cadastros/buscaFinanceiroCaixaMovimentacaoRelacionado.php\",\n			dataType: \"json\",\n			async:false,\n			data: {\n				fcacodigo: fcacodigo,\n				tipo: 4\n			},\n			success: function (result) {\n				if (result.data != undefined) {\n					if (result.data.length > 0) {\n						datapagamento = result.data;\n						for (var i = 0; i < result.data.length; i++) {\n							if (result.data[i].Saldo != result.data[i].SaldoLiquido) {\n								tiposPagamento += `<li><b>${result.data[i].Descricao}:</b> ${result.data[i].Saldo} - ${result.data[i].SaldoLiquido}(liq)</li>`;\n							} else {\n								tiposPagamento += `<li><b>${result.data[i].Descricao}:</b> ${result.data[i].Saldo}</li>`;\n							}\n						}\n					} else {\n						tiposPagamento = '';\n					}\n				} else {\n					tiposPagamento = '';\n				}\n			},\n			error: function (result) {\n				tiposPagamento = '';\n			}\n		});\n\n		$('#listaMovDia').bootstrapTable('destroy')\n		$('#listaMovDia').bootstrapTable({\n			url: \"/pages/cadastros/buscaFinanceiroCaixaMovimentacaoRelacionado.php\",\n			method: 'post',\n			dataType: 'json',\n			queryParams: function (p) {\n				p.fcacodigo = fcacodigo;\n				p.tipo = 2;\n				return p;\n			},\n			contentType: 'application/x-www-form-urlencoded',\n			uniqueId: \"Codigo\",\n			rowStyle: viewcolors,\n			iconSize: 'sm',\n			pagination: 'true',\n			columns: [{\n					field: 'Descricao',\n					title: 'Descrição',\n					footerFormatter: formatterFooter,\n					sortable: true\n				}, {\n					field: 'Valor',\n					title: 'Valor',\n					sortable: true,\n					sorter: currencySorter\n				},\n				{\n					field: 'ValorLiquido',\n					title: 'Valor Liquido',\n					sortable: true,\n					sorter: currencySorter\n				},\n				{\n					field: 'TipoPagamento',\n					title: 'Pagamento',\n					sortable: true\n				},\n				{\n					field: 'TipoBandeira',\n					title: 'Bandeira',\n					sortable: true\n				},\n				{\n					field: '',\n					formatter: viewFormatter,\n					title: '',\n					width: \"85px\"\n				}\n			],\n\n			search: true,\n			showRefresh: true,\n			showFooter: true,\n\n			locale: 'pt-BR',\n			onSearch: function (e) {\n				$(\"#listaMovDia\").bootstrapTable('refresh');\n			},\n			onPostBody: function (f) {\n				$scope.buscaPrintVerDiaCaixa(f,datapagamento);\n				$(\".viewcomandaModal\").on(\"click\", function (e) {\n					$row = $(\"#listaMovDia\").bootstrapTable(\"getRowByUniqueId\", this.dataset.codigo);\n					$scope.verComanda($row.ComCodigo)\n				});\n				$(\".viewinfoModal\").on(\"click\", function (e) {\n					$row = $(\"#listaMovDia\").bootstrapTable(\"getRowByUniqueId\", this.dataset.codigo);\n					$scope.verMovimentacao($row.Codigo)\n				});\n\n				$(\"#totalCaixaMovDia\").append(tiposPagamento).addClass('table-condensed table-striped')\n			},\n		});\n\n		$(\"#caixaMovimentacao-modal\").modal()\n	}\n\n	$scope.buscaPrintVerDiaCaixa = function(data,pagamento){\n		var html = '';\n		var tiposPagamento = '';\n		if (data != undefined) {\n			if (data.length > 0) {\n				for (var i = 0; i < data.length; i++) {\n					classEntrada = 'black';\n					if(data[i].Entrada == 1){\n						classEntrada = 'green'\n					}else if(data[i].Entrada == 0){\n						classEntrada = 'red'\n					}else if(data[i].Entrada == 3){\n						classEntrada = 'blue'\n					}\n					html += \"<tr><td>\" + data[i].Descricao + \"</td><td>\" + data[i].Valor + \"</td><td>\" + data[i].ValorLiquido + \"</td><td>\" + data[i].TipoPagamento + \"</td><td>\" + data[i].TipoBandeira + \"</td></tr>\";\n					tiposPagamento = `<tr><td colspan=\"5\"><h4><b>Saldo do Dia:</b> ${data[i].Saldo}</h4></td></tr><tr><td colspan=\"5\"><h4><b>Saldo Liquido do Dia:</b> ${data[i].SaldoLiquido}</h4></td></tr>`\n				}\n				$(\"#listaMovDiaPrint tbody\").html(html)\n			} else {\n				html = '';\n			}\n		}\n		if(pagamento != undefined) {\n			if (pagamento.length > 0) {\n				tiposPagamento += '<tr><td colspan=\"5\"><hr></td></tr>';\n				for (var i = 0; i < pagamento.length; i++) {\n					if (pagamento[i].Saldo != pagamento[i].SaldoLiquido) {\n						tiposPagamento += `<tr><td colspan=\"5\"><b>${pagamento[i].Descricao}:</b> ${pagamento[i].Saldo} - ${pagamento[i].SaldoLiquido}(liq)</td></tr>`;\n					} else {\n						tiposPagamento += `<tr><td colspan=\"5\"><b>${pagamento[i].Descricao}:</b> ${pagamento[i].Saldo}</td></tr>`;\n					}\n				}\n				$(\"#listaMovDiaPrint tfoot\").html(tiposPagamento)\n			} else {\n				tiposPagamento = '';\n			}\n		}\n	}\n\n	$(\"#moedaCaixa\").html($_CONFIG.MOEDA);\n\n\n		$scope.buscaCaixaAberto = function () {\n			$(\"#caixaAberto\").hide()\n			showLoader(true);\n			var caixas = \"\";\n			$.ajax({\n				dataType: \"json\",\n				method: \"POST\",\n				url: '/pages/cadastros/buscaFinanceiroCaixav2.php',\n				data: {\n					edtDataIni:'',\n					edtDataFim:'',\n					tipo: 14\n				},\n				success: (data) => {\n					caixas += \"<option value=''>Selecione um caixa</option>\";\n					for (var i = 0; i < data.data.length; i++) {\n						caixas +=`<option value='${data.data[i].FCa_Codigo}'>Usuário: ${data.data[i].Usu_Nome} - Data do caixa: ${data.data[i].FCa_Dat_Caixa}</option>`\n					};\n					$(\"#listaCaixaAberto\").html(caixas)\n					showLoader(false);\n				},\n				error: () => {\n					swal(\"Falha na conexão.\", \"\", \"error\");\n					showLoader(false);\n				}\n			});\n\n\n			$(\"#verListaCaixa-modal\").modal();\n		}\n		$(\"#listaCaixaAberto\").change(() => {\n			$(\"#caixaAberto\").hide();\n		})\n		$scope.VerCaixaAberto = function(){\n			showLoader(true);\n			if($(\"#listaCaixaAberto\").val() != \"\"){\n				$.ajax({\n					type: \"GET\",\n					url: getStorage('host'),\n					data: {\n						tipo: 16,\n						metodo: 'buscaFinanceiroCaixa',\n						id: $_CONFIG.ID,\n						fcacodigo: $(\"#listaCaixaAberto\").val()\n					},\n					dataType: \"json\",\n					success: (data) => {\n				\n						if (data.result.length > 0 && data.result[0].FCa_Codigo !== undefined) {\n							/*---------------------------------------------------------------------------------------------------------------------------*/\n							showLoader(false);\n							$(\"#caixaAberto\").show()\n							var fcacodigo = data.result[0].FCa_Codigo;\n							\n							$(\".divLoader\").hide();\n							$('#boxMovCaixaHistoricoCaixaVer').bootstrapTable('destroy')\n							$('#boxMovCaixaHistoricoCaixaVer').bootstrapTable({\n								url: getStorage('host'),\n								method: 'get',\n								dataType: 'json',\n								queryParams: (p) => {\n									p.fcacodigo = fcacodigo;\n									p.metodo = 'buscaFinanceiroCaixaMovimentacao';\n									p.id = $_CONFIG.ID;\n									return p;\n								},\n								responseHandler: (res) => {\n									return res.result\n								},\n								contentType: 'application/x-www-form-urlencoded',\n								uniqueId: \"FCM_Codigo\",\n								rowStyle: colors,\n								iconSize: 'sm',\n								theadClasses: 'thead-light',\n								columns: [{\n										field: 'FCM_Descricao',\n										title: 'Descricao',\n										sortable: true\n									}, {\n										field: 'FCM_Valor',\n										title: 'Valor',\n										sortable: true,\n									},\n									{\n										field: 'TPa_Descricao',\n										title: 'Pagamento',\n										sortable: true\n									}, {\n										field: '',\n										formatter: editFormatternewCa,\n										title: '',\n										width: \"85px\"\n									}\n								],\n								search: true,\n								showRefresh: true,\n								locale: 'pt-BR',\n								onSearch: (e) => {\n									$(\"#boxMovCaixaHistoricoCaixaVer\").bootstrapTable('refresh');\n								},\n								onPostBody: () => {\n									$(\".comandaModal\").on(\"click\", function (e) {\n										$row = $(\"#boxMovCaixaHistoricoCaixaVer\").bootstrapTable(\"getRowByUniqueId\", this.dataset.codigo);\n										$scope.verComanda($row.Com_Codigo)\n									});\n									$(\".infoModal\").on(\"click\", function (e) {\n										$row = $(\"#boxMovCaixaHistoricoCaixaVer\").bootstrapTable(\"getRowByUniqueId\", this.dataset.codigo);\n										$scope.verMovimentacao($row.FCM_Codigo)\n									});\n		\n									$(\".deletedModal\").on(\"click\", function (e) {\n										$row = $(\"#boxMovCaixaHistoricoCaixaVer\").bootstrapTable(\"getRowByUniqueId\", this.dataset.codigo);\n										$scope.removeMovimentacao($row.FCM_Codigo)\n									});\n								}\n		\n		\n							});\n		\n					\n		\n							$(\".lblNomeCaixaVer\").html(data.result[0].Usu_Nome);\n							$(\".lblDatCaixaVer\").html(data.result[0].FCa_Dat_Caixa);\n							$(\".lblTotalCaixaCaixaVer\").html(data.result[0].FCa_Saldo);\n							$(\".lblValorInicialCaixaVer\").html(data.result[0].FCa_Vlr_Inicial);\n		\n							\n							var listaPagCaixaEntrada = [];\n							var listaPagCaixaSaida = [];\n							var listaPagCaixaOther = [];\n							$.ajax({\n								type: \"GET\",\n								url: getStorage('host'),\n								async: false,\n								data: {\n									tipo: 17,\n									metodo: 'buscaFinanceiroCaixa',\n									id: $_CONFIG.ID,\n									fcacodigo: $(\"#listaCaixaAberto\").val()\n								},\n								dataType: \"json\",\n								success: (result) => {\n		\n									for (var i = 0; i < result.result.length; i++) {\n										if(result.result[i].FCM_Entrada == 1){\n											listaPagCaixaEntrada.push(result.result[i])\n										}else if(result.result[i].FCM_Entrada == 0){\n											listaPagCaixaSaida.push(result.result[i])\n											\n										}else{\n											listaPagCaixaOther.push(result.result[i])\n										}\n									}\n								},\n								error: () => {\n									console.log(\"Falha na conexão.\", \"\", \"error\");\n								}\n							})\n		\n							var primary = [];\n							var secondary = [];\n							var primaryColor = '';\n							var secondaryColor = '';\n							var primaryValor = 0.00;\n							var secondaryValor = 0.00;\n							var primarytype = '';\n							var secondarytype = '';\n							if(listaPagCaixaEntrada.length >= listaPagCaixaSaida.length){\n								primary = listaPagCaixaEntrada;\n								secondary = listaPagCaixaSaida;\n								primaryColor = 'green';\n								secondaryColor = 'red';\n								primarytype = 'Entradas';\n								secondarytype = 'Saídas';\n								\n							}else{\n								primary = listaPagCaixaSaida;\n								secondary = listaPagCaixaEntrada;\n								primaryColor = 'red';\n								secondaryColor = 'green';\n								primarytype = 'Saídas';\n								secondarytype = 'Entradas';\n							}\n							$(\".divTotalizadorver\").html('')\n							$(\".divTotalizadorver\").append(`<tr><th><b>${primarytype}</b></th><th><b>${secondarytype}</b></th></tr>`)\n		\n							for (var j = 0; j < primary.length; j++) {\n								if(secondary.length > 0){\n									for (var k = 0; k < secondary.length; k++) {\n										if(primary[j].TPa_Codigo == secondary[k].TPa_Codigo){\n											$(\".divTotalizadorver\").append(`<tr><td><span style=\"color:${primaryColor}\">${primary[j].TipoPagamento}: <b>${primary[j].Valor}</b></span></td><td><span style=\"color:${secondaryColor}\">${secondary[k].TipoPagamento}: <b>${secondary[k].Valor}</b></span></td></tr>`)\n											primaryValor = primaryValor + parseFloat(primary[j].ValorReal)\n											secondaryValor = secondaryValor + parseFloat(secondary[k].ValorReal)\n											secondary.splice(k,1);\n											break;\n										}else if(k == (secondary.length - 1)){\n											$(\".divTotalizadorver\").append(`<tr><td><span style=\"color:${primaryColor}\">${primary[j].TipoPagamento}: <b>${primary[j].Valor}</b></span></td><td>-</td></tr>`)\n											primaryValor = primaryValor + parseFloat(primary[j].ValorReal)\n										}\n									}\n									if(j == (primary.length -1 ) && secondary.length > 0){\n										for (var l = 0; l < secondary.length; l++) {\n											$(\".divTotalizadorver\").append(`<tr><td>-</td><td><span style=\"color:${secondaryColor}\">${secondary[l].TipoPagamento}: <b>${secondary[l].Valor}</b></span</td></tr>`)\n											secondaryValor = secondaryValor + parseFloat(secondary[l].ValorReal)\n										}\n									}\n								}else{\n									$(\".divTotalizadorver\").append(`<tr><td><span style=\"color:${primaryColor}\">${primary[j].TipoPagamento}: <b>${primary[j].Valor}</b></span></td><td>-</td></tr>`)\n									primaryValor = primaryValor + parseFloat(primary[j].ValorReal)\n								}\n							}\n							for (var m = 0; m < listaPagCaixaOther.length; m++) {\n								$(\".divTotalizadorver\").append(`<tr><td >${listaPagCaixaOther[m].TipoPagamento}: <b>${listaPagCaixaOther[m].Valor}</b></td><td>-</td></tr>`)\n							}\n							$(\".divTotalizadorver\").append(`<tr><td>Total de ${primarytype}: <b>${$_CONFIG.MOEDA} ${primaryValor.toFixed(2).replace('.',',')}</b></td><td>Total de ${secondarytype}: <b>${$_CONFIG.MOEDA} ${secondaryValor.toFixed(2).replace('.',',')}</b></td></tr>`)\n		\n							$.ajax({\n								type: \"POST\",\n								url: \"/pages/cadastros/buscaFinanceiroCaixa.php\",\n								data: {\n									tipo: 10,\n									fcacodigo: $(\"#listaCaixaAberto\").val()\n								},\n								dataType: \"json\",\n								success: (result) => {\n					\n									var saldodisp = \"\";\n									for (var i = 0; i < result.result.length; i++) {\n					\n										if (result.result[i].Valor != \"\") {\n											saldodisp += result.result[i].Valor;\n										} else {\n											saldodisp += $_CONFIG.MOEDA + '0,00';\n										}\n									}\n					\n									$(\"#lblTotalCaixaDispCaixaVer\").html(saldodisp);\n					\n								},\n								error: () => {\n									console.log(\"Falha na conexão.\", \"\", \"error\");\n								}\n							});\n					\n							$.ajax({\n								type: \"POST\",\n								url: \"/pages/cadastros/buscaFinanceiroCaixa.php\",\n								data: {\n									tipo: 11,\n									fcacodigo: $(\"#listaCaixaAberto\").val()\n								},\n								dataType: \"json\",\n								success: (result) => {\n					\n									var saldorec = \"\";\n									for (var i = 0; i < result.result.length; i++) {\n										if (result.result[i].Valor != \"\") {\n											saldorec += result.result[i].Valor;\n										} else {\n											saldorec += $_CONFIG.MOEDA + '0,00';\n										}\n									}\n					\n									$(\"#lblTotalCaixaReceCaixaVer\").html(saldorec);\n								},\n								error: (data) => {\n									console.log(\"Falha na conexão.\", \"\", \"error\");\n								}\n							});\n						} \n		\n						resizeContent();\n					},\n					error: () => {\n						console.log(\"Falha na conexão.\", \"\", \"error\");\n					}\n				});\n			}else{\n				toastr.error(\"Selecione um caixa.\");\n				showLoader(false);\n			}\n\n		}\n		\n		function editFormatternewCa(value, row) {\n\n			var btnComanda = `<button class=\"btn btn-primary comandaModal btn-xs\" data-codigo=\"${row.FCM_Codigo}\">\n									<i class=\"fa fa-list-alt\" ></i>\n								</button>`;\n			var btnInfo = `<button class=\"btn btn-info infoModal btn-xs\" data-codigo=\"${row.FCM_Codigo}\">\n								<i class=\"fa fa-info\" ></i>\n							</button>`;\n		\n\n\n			if (row.Com_Codigo == \"\") {\n				return `${btnInfo}`\n			} else {\n				var btn = `${btnComanda} ${btnInfo}`\n				return btn;\n			}\n		}\n\n		\n});";
var mod_pagespeed_4_TxC24fz3 = "angular.module('appBeleza').controller(\"pesquisaSatisfacaoProCtrl\", function ($scope, $timeout) {\n\n    $scope.exibirModalSatisfacao = false;\n    $scope.exibirMensagemSatisfacao = false;\n\n    var pesquisa;\n    var ultima = localStorage.getItem(\"visualizacaoPesquisa\");\n\n    $scope.salvaResposta = function() {\n        var tipos = \"\";\n        var respostas = \"\";\n        for(let i = 0; i < pesquisa.survey_fields.length; i ++) {\n            var tipo = pesquisa.survey_fields[i].survey_fields_type;\n            tipos += (tipos ? \",\" : \"\") + tipo;\n            respostas += (respostas ? \"|\" : \"\");\n            if(tipo == 1) {\n                respostas += $(\"#perguntaSatisfacao\" + i).val();\n            } else if(tipo == 4) {\n                respostas += $(\"#perguntaSatisfacao\" + i).find(\":selected\").val();\n            } else {\n                var temp = \"\";\n                pesquisa.survey_fields[i].survey_fields_options.split(\",\").forEach((opcao, index) => {\n                    var pergunta = $('#perguntaSatisfacao' + i + \"-\" + index);\n                    if (pergunta.is(':checked')) {\n                        temp += (temp ? \",\" : \"\") + opcao;\n                    }\n                })\n                respostas += temp;\n            }\n        }\n        var quantiaRespondida = respostas.split(\"|\").filter((resposta) => resposta != \"\").length;\n        if(quantiaRespondida < pesquisa.survey_fields.length) {\n            $scope.fecharModal();\n            return;\n        };\n        var respostaFinal ={\"survey_code\": pesquisa.survey_code, \n                            \"survey_fields\": tipos, \n                            \"survey_answers\": respostas, \n                            \"survey_answers_number\":  pesquisa.survey_fields.length};  \n\n        $.ajax({\n            type: 'POST',\n            url: 'pages/cadastros/inserePesquisaSatisfacaoPro.php',\n            data: respostaFinal,\n            dataType: 'json',\n            success: function (result) {\n                salvarUltimaVisualizacao();\n            },\n            error: function(result) {}\n        });\n        $scope.exibirMensagemSatisfacao = true;\n        $(\"#perguntaContainer\").empty();\n        $(\"#agradecimentoSatisfacao\").show();\n        $(\"#agradecimentoSatisfacao\").text(\"Muito obrigado por responder nossa pesquisa!\");\n        $(\"#imgSatisfacaoPro\").attr('src', \"\");\n    }\n\n    $scope.fecharModal = function() {\n        $scope.exibirModalSatisfacao = false;\n        $scope.exibirMensagemSatisfacao = false;\n        salvarUltimaVisualizacao();\n    };\n\n    function criaPergunta(tipo, descricao, opcoes, index) {\n        var opcoesFinal = opcoes ? opcoes.split(\",\") : \"\"; \n        var html = `<div style=\"margin-top: 20px;\"> <span id='descricaoSatisfacao${index}' > ${descricao} </span> <div style=\"display: flex; justify-content: space-around; flex-wrap: wrap;\">`;\n        switch (tipo) {\n            case 1:\n                html+= ` <textarea class=\"form-control\" rows='2' style=\"resize: none;\" placeholder='Digite sua resposta...' id='perguntaSatisfacao${index}' name='${descricao}'></textarea> `\n                break;\n            case 2:\n                html+= opcoesFinal.map((opcao, indexOpcao) =>\n                        `<label class='campo-opcao checkbox-inline'> \n                            <input type='checkbox' id='perguntaSatisfacao${index}-${indexOpcao}' name='${descricao}'> \n                            ${opcao}\n                        </label> `).join('');\n                break;\n            case 3:\n                html+= opcoesFinal.map((opcao, indexOpcao) =>\n                        `<label class='campo-opcao radio-inline'> \n                            <input type='radio' id='perguntaSatisfacao${index}-${indexOpcao}' value='${opcao}' name='${descricao}'>\n                            ${opcao}\n                        </label>`).join('');\n                break;\n            case 4:\n                html+= `<select class='form-control input-large' id='perguntaSatisfacao${index}' name='${descricao}'>\n                            ${opcoesFinal.map((opcao, indexOpcao) => `<option id=\"perguntaOption${index}-${indexOpcao}\" value=\"${opcao}\">${opcao}</option>`)}\n                        </select>`\n                break;\n        }\n        html += \"</div> </div>\";\n        return html;\n    }\n\n    function atualizaPesquisa(data) {\n        $(\"#perguntaSatisfacaoPro\").html(data.survey_title == \"\" ? \"Pesquisa de Satisfação\" : data.survey_title);\n        $(\"#imgSatisfacaoPro\").attr('src', data.survey_image);\n        var htmlTotal = `<div class='form-group perguntas-satisfacao'> `;\n        data.survey_fields.forEach((field, index) => {\n            htmlTotal += criaPergunta(\n                            field.survey_fields_type,\n                            field.survey_fields_description, \n                            field?.survey_fields_options,\n                            index\n                        );\n        });\n        htmlTotal += \"</div> \"\n        $(\"#perguntaContainer\").html(htmlTotal);\n    }\n\n    function salvarUltimaVisualizacao() {\n        var data = new Date().getTime();\n        data += 60 * 60 * 24 * 1000; // 1 Dia em millisegundos\n        localStorage.setItem(\"visualizacaoPesquisa\", data);\n    }\n\n    if(!ultima || ultima < new Date().getTime()) {\n        $timeout(function() {\n            $.ajax({\n                type: 'POST',\n                url: 'pages/cadastros/buscaPesquisaSatisfacaoPro.php',\n                dataType: 'json',\n                success: function (result) {\n                    pesquisa = result.data.system_survey[0].survey_data;\n                    if(!pesquisa) {\n                        salvarUltimaVisualizacao();\n                        return;\n                    }\n                    codigoPesquisa = pesquisa.survey_code;\n                    $scope.exibirModalSatisfacao = true;\n                    atualizaPesquisa(pesquisa);\n                    $scope.$apply();\n                },\n                error: function(result) {\n                    console.log(result);\n                }\n            });\n        }, 5000);\n    };\n\n});";
