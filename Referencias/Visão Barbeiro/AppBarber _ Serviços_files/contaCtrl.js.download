	$scope.buscaPessoaVideoTotem = function () {
		var htmlVideos = "";
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/TOTEM_Busca_Video.php",
			data: {},
			dataType: "json",
			success: function (result) {
				if (result.data.error === false) {
					var videos = result.data.totem_video;
					
					if (videos.length > 0) {
						videos.forEach(function (video) {
							htmlVideos += `
							<div class="col-md-4" style="margin-bottom: 20px;">
								<div class="panel panel-default" style="border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); overflow: hidden;">
								<div class="panel-body" style="padding: 10px;">
									<video width="100%" height="auto" controls preload="metadata" style="border-radius: 4px; max-height: 240px;">
									<source src="${video.totem_video_link}" type="video/mp4">
									Seu navegador não suporta a tag de vídeo.
									</video>
									<div class="d-flex justify-content-between align-items-center" style="margin-top: 10px; display: flex;">
									<p style="margin: 0; font-size: 14px; flex: 1; text-align: left;">
										<strong>Descrição:</strong> ${video.totem_video_description}
									</p>
									<button class="btn btn-danger btn-sm" style="margin-left: 10px;" title="Remover vídeo"
										onclick="angular.element(this).scope().removeVideoTotem(${video.totem_video_code});">
										<i class="fa fa-trash"></i>
									</button>
									</div>
								</div>
								</div>
							</div>
							`;
						});
					} 
	
					$('#divVideosTotem').html(htmlVideos);
	
				} 
			},
			error: function () {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	};
	
	$.ajax({
		dataType: 'json',
		url: localStorage.getItem('host'),
		async: false,
		data: {
			metodo: 'buscaParametro',
			id: $scope.idCliente,
			parcodigo: 162
		},
		success: function (data) {
			if (data.result.length > 0) {
				if (data.result[0].PVa_Vlr_Principal == 1) {
					$("#totem").show()
					$scope.buscaPessoaImagemTotem();
					$scope.buscaPessoaVideoTotem();
				}
				
			}
		}
	});

	$('#formInsereImagemTotem').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		var dados = new FormData(this);
		dados.append("blob", mBlob);
		dados.delete("totemImagem");
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/TOTEM_Insere_Imagem.php",
			data: dados,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.data.error == false) {
					swal(result.data.message, "", "success");
					$("#divImgTotem").html("");
					$("#imagemCutAll").cropper("destroy");
					$scope.buscaPessoaImagemTotem();
					limparCamposImagemTotem();

				} else {
					swal(result.data.message, "", "error");
				}
				showLoader(false);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});

		return true;
	});

	$('#formInsereVideosPrime').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		var dados = new FormData(this);
	
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/TOTEM_Insere_Video.php",
			data: dados,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.data.error === false) {
					swal(result.data.message || "Vídeo inserido com sucesso.", "", "success");
					$scope.buscaPessoaVideoTotem();
					limparCamposVideoModal();
					$('#videoTotem-modal').modal('hide');
	
				} else {
					let errorMessage = result.data.message || "Erro ao inserir vídeo.";
	
					if (errorMessage === "Informe o Link") {
						errorMessage = "Tamanho máximo do arquivo excedido. O vídeo precisa ter menos que 5MB.";
					}
	
					if (Array.isArray(result.data.totem_video)) {
						const detalhes = result.data.totem_video.map(e => e.result).filter(Boolean);
						if (detalhes.length > 0) {
							errorMessage = detalhes.join("\n");
						}
					}
	
					swal(errorMessage, "", "error");
				}
				showLoader(false);
			},
			error: function () {
				swal("Falha na conexão", "", "error");
				showLoader(false);
			}
		});
	
		return true;
	});	

	$scope.removeVideoTotem = function (codigo) {
        swal({
                title: 'Excluir',
                text: 'Deseja realmente remover o vídeo?',
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#DD6B55',
                confirmButtonText: 'Sim',
                cancelButtonText: 'Não',
                closeOnConfirm: true
            },
            function () {
                $.ajax({
                    type: "POST",
                    url: "/pages/cadastros/TOTEM_Remove_Video.php",
                    data: {
                        totem_video_code: codigo

                    },
                    dataType: "json",
                    success: function (result) {

                        if (result.data.error === true || result.data.totem_video[0].error != 0) {
							const errorMsg = result.data.totem_video[0].result || "Ocorreu um erro ao excluir o vídeo.";
							toastr.error(errorMsg);
						} else {
						const successMsg = result.data.totem_video[0].result || "Vídeo atualizado com sucesso.";
						toastr.success(successMsg);
						$scope.buscaPessoaVideoTotem();
						}

						showLoader(false);

                    },

                    error: function (result) {
						swal("Falha na conexão", "", "error");
						showLoader(false);
                    }
                });
            });
    }

	$scope.buscaFiliais = function () {
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/FILIAIS_Busca.php",
			dataType: "json",
			success: function ({
				data
			}) {
				const filiais = data?.organization || [];
				const $select = $("#selectFiliaisApi");

				$select
					.empty()
					.append('<option value="">Selecione uma filial</option>');

				filiais.forEach(({
					establishment_code,
					establishment_name,
					establishment_commercial_name
				}) => {
					$select.append(
						$("<option>", {
							value: establishment_code || "",
							text: establishment_name || establishment_commercial_name || "Sem nome"
						})
					);
				});

				$select.trigger("change");
			},
			error: handleAjaxError
		});
	};

	function handleAjaxError() {
		swal("Falha na conexão.", "", "error");
		showLoader(false);
	}

	$scope.buscaFiliais();

	$scope.mostrarMensagemSucessoPerfil = function() {
		toastr.success('Dados atualizados! As alterações poderão levar até 10 minutos para aparecer.', 'Sucesso!', {
			timeOut: 8000,
			progressBar: true,
			closeButton: true
		});
	};
	$("#btnSalvarNIF").click(function() {
		var nif = $("#empNIF").val();
		
		if (!nif) {
			toastr.error("Por favor, insira um valor para o NIF", "", "error");
			return false;
		}
		
		showLoader(true);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/atualizaCodigoNIF.php",
			data: {
				nif: nif
			},
			dataType: "json",
			success: function (result) {
				showLoader(false);
				if (!result.data.error) {
					toastr.success(result.data.message || "NIF atualizado com sucesso!");
				} else {
					toastr.error(result.data.message || "Erro ao atualizar NIF", "", "error");
				}
			},
			error: function (result) {
				showLoader(false);
				toastr.error("Falha na conexão ao salvar NIF", "", "error");
			}
		});
	});

	function mostraFormularioApi() {
		mostraAbaApi();
		$("#formApiExterna").show();
	}

	function mostraAguardandoContratoApi() {
		mostraAbaApi();
		$("#aguardarContratoApi").show();
	}

	function mostraAguardandoPagamentoApi() {
		mostraAbaApi();
		$("#pagamentoApi").show();

		const link = $scope.gerarCheckoutApiExterna();

		if (link) {
			$("#btnPagarPixApiExterna").attr("href", link)
		}
	}

	function mostraAguardandoIpFixo() {
		mostraAbaApi();
		$("#enviarIpFixoApi").show();
	}

	function escondeTelasApi() {
		$("#menuApiExterna").hide();

		$("#formApiExterna").hide();
		$("#aguardarContratoApi").hide();
		$("#pagamentoApi").hide();
		$("#enviarIpFixoApi").hide();
		$("#gerenciarApi").hide();
	}

	function mostraAbaApi() {
		$("#menuApiExterna").show();
	}

	$scope.gerarCheckoutApiExterna = function () {
		let checkoutURL = null;
		const valorCentavos = 100 * 100; 

		$.ajax({
			type: "POST",
			url: "/pages/cadastros/CHECKOUT_Insere.php",
			data: {
				type: 6,
				establishment: $_CONFIG.CODESTABELECIMENTO,
				value: valorCentavos,
				installments: 1,
				payment_type: "pix",
				product_code: 28,
				product_type: 13
			},
			dataType: "json",
			async: false,
			success: function (data) {
				const hash = data?.data?.checkout?.[0]?.hash_code;

				if (hash) {
					checkoutURL = `https://checkout.appbarber.com.br/?hash=${hash}`;
				}
			},
			error: function () {
				swal("Falha na conexão.", "", "error");
			}
		});

		return checkoutURL;
	};

	function atualizaResumoApiExterna() {
		var totalCreditos = apiExternaAtivas * 5000;
		var totalValor = apiExternaAtivas * 100;
		var statusClass = apiExternaStatus === "ACTIVE" ? "badge bg-green" : "badge bg-red";
		var statusText = apiExternaStatus === "ACTIVE" ? "Ativa" : (apiExternaStatus ? "Desativada" : "");
		$("#lblSaldoApiExterna").html(apiExternaBalance === null ? "" : formatNumberBr(apiExternaBalance));
		$("#lblStatusApiExterna").html(statusText ? '<span style="padding:6px !important;" class="' + statusClass + '">' + statusText + '</span>' : "");
		$("#lblUpdateApiExterna").html(apiExternaUpdatedAt ? "Última atualização: " + formataDataApiExterna(apiExternaUpdatedAt) : "");
		$("#txtApiExternaCreditos").html(formatNumberBr(totalCreditos));
		$("#txtApiExternaFiliais").html(apiExternaAtivas);
		$("#txtApiExternaValor").html(formatMoneyBr(totalValor));
	}

	function carregaTelaGerenciamentoApi() {
		mostraAbaApi();
		$("#gerenciarApi").show();

		if (tabelaApiExterna) {
			tabelaApiExterna.api().ajax.reload();
			return;
		}

		$("#btnComprarApiExternaCreditos").prop("disabled", true);
		apiExternaAtivas = 0;
		apiExternaBalance = null;
		apiExternaStatus = "";
		apiExternaUpdatedAt = "";
		apiExternaIp = "";
		apiExternaLastIpChange = "";
		atualizaResumoApiExterna();

		tabelaApiExterna = $("#tbApiExterna").dataTable({
			ajax: {
				url: "/pages/cadastros/buscaApiExterna.php",
				dataSrc: function (json) {
					var rows = (json && json.data) ? json.data : [];
					apiExternaAtivas = calculaApiExternaAtivas(rows);
					apiExternaBalance = null;
					if (json && json.balance !== undefined && json.balance !== null) {
						apiExternaBalance = Number(json.balance);
					}
					apiExternaStatus = json && json.apiStatus ? json.apiStatus : "";
					apiExternaUpdatedAt = json && json.updatedAt ? json.updatedAt : "";
					apiExternaIp = json && json.ipAddress ? json.ipAddress : "";
					apiExternaLastIpChange = json && json.lastIpAddressChange ? json.lastIpAddressChange : "";
					$("#btnComprarApiExternaCreditos").prop("disabled", false);
					atualizaResumoApiExterna();
					return rows;
				}
			},
			columnDefs: [{
				targets: [3],
				visible: false,
				searchable: false
			}],
			columns: [{
					data: "Empresa"
				},
				{
					data: "Status"
				},
				{
					class: "remover-control",
					orderable: false,
					data: null,
					defaultContent: '<button class="btn btn-danger btn-xs" align="center"><i class="fa fa-trash"></i></button>',
				},
				{
					data: "CodigoErro"
				}
			],
			order: [
				[0, "asc"]
			]
		});

		$("#tbApiExterna tbody").on(
			"click",
			"td.remover-control",
			function () {
				var tr = $(this).closest("tr");
				var idx = tr[0]._DT_RowIndex;
				var registroTabela = tabelaApiExterna.fnGetData(idx);
				$scope.removeEmpresaApi(registroTabela.establishment_api_code);
			}
		);

		$('#apiExternaCreditos-modal').on('shown.bs.modal', function () {
			atualizaResumoApiExterna();
		});
		$("#btnPagarApiExterna").off("click").on("click", function () {
			var totalCreditos = apiExternaAtivas * 5000;
			var totalValor = apiExternaAtivas * 100;

			if (apiExternaAtivas <= 0) {
				swal("Ops!", "Nenhuma filial ativa para comprar creditos.", "error");
				return;
			}

			showLoader(true);
			$.ajax({
				type: "POST",
				url: "/php/createPaymentPixAPI.php",
				data: {
					centavos: totalValor * 100,
					valor: totalValor,
					qtd: totalCreditos,
					tipoPgto: 3,
					cardHash: ""
				},
				dataType: "json",
				success: function (result) {
					showLoader(false);
					if (result.erro == "0") {
						$("#apiExternaCreditos-modal").modal("hide");
						$App.showPIXModal(result.valor, result.resultado, 3, result.codexterno);
					} else {
						swal("Ops!", result.resultado, "error");
					}
				},
				error: function () {
					swal("Falha na conexao.", "", "error");
					showLoader(false);
				}
			});
		});
	}

	function escapeHtmlApiExterna(value) {
		return String(value === null || value === undefined ? "" : value)
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#039;");
	}

	function formataDataApiExterna(value) {
		if (!value) {
			return "";
		}
		var data = moment(value);
		return data.isValid() ? data.format("DD/MM/YYYY HH:mm:ss") : value;
	}

	function formataDuracaoApiExterna(value) {
		if (value === null || value === undefined || value === "") {
			return "-";
		}
		return value + " ms";
	}

	function valorRelatorioApiExterna(value) {
		if (value === null || value === undefined || value === "") {
			return "-";
		}
		return value;
	}

	function formataStatusApiExterna(value) {
		if (value === null || value === undefined || value === "") {
			return "-";
		}

		var status = Number(value);
		var classe = "label-default";
		if (status >= 200 && status < 300) {
			classe = "label-success";
		} else if (status >= 400 && status < 500) {
			classe = "label-warning";
		} else if (status >= 500) {
			classe = "label-danger";
		}

		return '<span class="label ' + classe + '">' + escapeHtmlApiExterna(value) + '</span>';
	}

	function atualizaBotoesRelatorioApiExterna() {
		$("#lblRelatorioApiExternaPagina").text("Página " + relatorioApiExternaPagina);
		$("#lblRelatorioApiExternaPaginaBottom").text("Página " + relatorioApiExternaPagina);
		$(".btnRelatorioApiExternaAnterior").prop("disabled", relatorioApiExternaHistorico.length === 0);
		$(".btnRelatorioApiExternaProxima").prop("disabled", !relatorioApiExternaNextCursor);
	}

	function renderizaRelatorioApiExterna(items) {
		var html = "";
		if (!items || items.length === 0) {
			html = '<tr><td colspan="9" class="text-center text-muted">Nenhum registro encontrado.</td></tr>';
		} else {
			for (var i = 0; i < items.length; i++) {
				var item = items[i] || {};
				html += "<tr>";
				html += '<td class="text-nowrap">' + escapeHtmlApiExterna(valorRelatorioApiExterna(item.method)) + "</td>";
				html += '<td class="text-center">' + formataStatusApiExterna(item.status_code) + "</td>";
				html += '<td style="word-break:break-all; min-width:260px;">' + escapeHtmlApiExterna(valorRelatorioApiExterna(item.url)) + "</td>";
				html += '<td class="text-nowrap">' + escapeHtmlApiExterna(formataDuracaoApiExterna(item.duration_ms)) + "</td>";
				html += '<td class="text-nowrap">' + escapeHtmlApiExterna(valorRelatorioApiExterna(item.ip)) + "</td>";
				html += '<td style="word-break:break-all; min-width:220px;">' + escapeHtmlApiExterna(valorRelatorioApiExterna(item.user_agent)) + "</td>";
				html += '<td style="word-break:break-all; min-width:220px;">' + escapeHtmlApiExterna(valorRelatorioApiExterna(item.request_id)) + "</td>";
				html += '<td style="word-break:break-all; min-width:160px;">' + escapeHtmlApiExterna(valorRelatorioApiExterna(item.error_message)) + "</td>";
				html += '<td class="text-nowrap">' + escapeHtmlApiExterna(valorRelatorioApiExterna(formataDataApiExterna(item.created_at))) + "</td>";
				html += "</tr>";
			}
		}
		$("#tbRelatorioApiExterna tbody").html(html);
	}

	function renderizaLoadingRelatorioApiExterna() {
		$("#tbRelatorioApiExterna tbody").html('<tr><td colspan="9" class="text-center text-muted"><i class="fa fa-refresh fa-spin"></i> Carregando...</td></tr>');
	}

	function carregaRelatorioApiExterna(cursor, adicionaHistorico) {
		$(".btnRelatorioApiExternaAnterior, .btnRelatorioApiExternaProxima").prop("disabled", true);
		renderizaLoadingRelatorioApiExterna();

		$.ajax({
			type: "GET",
			url: "/pages/cadastros/buscaRelatorioApiExterna.php",
			dataType: "json",
			data: {
				cursor: cursor || ""
			},
			success: function (response) {
				if (!response || response.success !== true) {
					var mensagem = response && response.message ? response.message : "Não foi possível carregar o relatório.";
					renderizaRelatorioApiExterna([]);
					$("#lblRelatorioApiExternaStatus").html(mensagem);
					atualizaBotoesRelatorioApiExterna();
					return;
				}

				if (adicionaHistorico) {
					relatorioApiExternaHistorico.push(relatorioApiExternaCursorAtual);
					relatorioApiExternaPagina++;
				}

				relatorioApiExternaCursorAtual = cursor || null;
				relatorioApiExternaNextCursor = response.data && response.data.next_cursor ? response.data.next_cursor : null;
				renderizaRelatorioApiExterna(response.data && response.data.items ? response.data.items : []);
				atualizaBotoesRelatorioApiExterna();
			},
			error: function () {
				renderizaRelatorioApiExterna([]);
				atualizaBotoesRelatorioApiExterna();
			}
		});
	}

	$scope.inserirEmpresaApi = function () {
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/API_Insere_Empresa.php",
			data: {
				parent_code: $_CONFIG.CODESTABELECIMENTO,
				branch_code: $("#selectFiliaisApi").val()
			},
			dataType: "json",
			success: function ({
				data
			}) {
				const apiResponse = data?.api?.[0];

				if (!apiResponse) {
					return swal(
						"Falha ao inserir",
						"Ocorreu um erro ao inserir a empresa.",
						"error"
					);
				}

				const {
					error,
					result
				} = apiResponse;
				const sucesso = error === false || error === 0 || error === "false";

				if (!sucesso) {
					return swal(
						"Falha ao inserir",
						result || "Ocorreu um erro ao inserir a empresa.",
						"error"
					);
				}

				swal(
					"Sucesso!",
					result || "Empresa adicionada com sucesso.",
					"success"
				);

				carregaTelaGerenciamentoApi();
				$scope.buscaFiliais();

				$("#selectFiliaisApi")
					.val("")
					.trigger("change");
			},
			error: handleAjaxError
		});
	};

	$scope.removeEmpresaApi = function (codigo) {
		swal({
				title: 'Excluir',
				text: 'Deseja realmente remover essa empresa? Isso irá remover o acesso dessa empresa à API.',
				type: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: 'Sim',
				cancelButtonText: 'Não',
				closeOnConfirm: true
			},
			function () {
				$.ajax({
					type: "POST",
					url: "/pages/cadastros/API_Remove_Empresa.php",
					data: {
						organization_establishment_api_code: codigo
					},
					dataType: "json",
					success: function (result) {
						var apiResponse = result && result.data && result.data.api && result.data.api[0] ? result.data.api[0] : null;
						var erro = apiResponse ? apiResponse.error : true;
						var mensagem = apiResponse && apiResponse.result ? apiResponse.result : "Ocorreu um erro ao remover a empresa.";

						if (erro === false || erro === 0 || erro === "false") {
							swal("Sucesso!", mensagem, "success");
							carregaTelaGerenciamentoApi();
							return;
						}

						swal("Falha ao remover", mensagem, "error");
						showLoader(false);

					},

					error: function (result) {
						swal("Falha na conexão", "", "error");
						showLoader(false);
					}
				});
			});
	}

	$scope.salvaIpFixo = function (ip) {
		ip = ip || $("#inputIpFixoApiExterna").val();

		$.ajax({
			type: "POST",
			url: "/pages/cadastros/API_IP_Insere.php",
			data: {
				ip_address: ip
			},
			dataType: "json",
			success: function (result) {
				const organizacao = result && result.data && result.data.organization && result.data.organization[0];

				if (organizacao && (organizacao.error === 0 || organizacao.error === "0")) {
					swal(organizacao.result || "IP salvo com sucesso.", "", "success");
					escondeTelasApi();
					carregaTelaGerenciamentoApi();
				} else {
					swal("Falha ao salvar o IP.", (organizacao && organizacao.result) || "", "error");
				}

				showLoader(false);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});

	}

	$scope.abrirModalIpApiExterna = function () {
		var ultimaAlteracao = apiExternaLastIpChange ? moment(apiExternaLastIpChange, "DD/MM/YYYY HH:mm") : null;
		var bloqueado = !!(ultimaAlteracao && ultimaAlteracao.isValid() && moment().diff(ultimaAlteracao, "hours") < 24);

		$("#lblIpAtualApiExterna").val(apiExternaIp || "-");
		$("#inputNovoIpApiExterna").val("");
		$("#avisoIpRecenteApiExterna").toggle(bloqueado);
		$("#grupoNovoIpApiExterna").toggle(!bloqueado);
		$("#btnSalvarIpApiExterna").toggle(!bloqueado);

		if (bloqueado) {
			$("#avisoIpRecenteApiExterna").html("O IP fixo já foi alterado em " + ultimaAlteracao.format("DD/MM/YYYY HH:mm") + ". Aguarde 24 horas após a última alteração para alterá-lo novamente.");
		}

		$("#editarIpApiExterna-modal").modal("show");
	}

	// Bloqueia digitacao de qualquer caractere fora de IPv4/IPv6 (inclusive a barra
	// de CIDR: a Cloudflare aceita faixa, mas o cadastro aqui e de um IP unico).
	$(document).on("input", ".input-ip-api-externa", function () {
		var limpo = this.value.replace(/[^0-9a-fA-F.:]/g, "");

		if (limpo !== this.value) {
			this.value = limpo;
		}
	});

	function validaIpApiExterna(ip) {
		var octeto = "(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])";
		var ipv4 = new RegExp("^" + octeto + "(\\." + octeto + "){3}$");
		var partes;

		if (ip.indexOf("/") !== -1) {
			return "Informe apenas o IP, sem a máscara de rede (ex.: 200.150.10.25 e não 200.150.10.25/24).";
		}

		if (ip.indexOf(":") !== -1) {
			if (!/^[0-9a-fA-F:]+$/.test(ip) || ip.indexOf(":::") !== -1 || (ip.split("::").length - 1) > 1) {
				return "IPv6 inválido. Confira o endereço informado.";
			}

			if (/^(::1|fe80:|fc|fd)/i.test(ip)) {
				return "Esse é um IPv6 de rede local. Informe o IP público fornecido pelo seu provedor de internet.";
			}

			return "";
		}

		if (!ipv4.test(ip)) {
			return "IP inválido. Informe um IPv4 (ex.: 200.150.10.25) ou um IPv6.";
		}

		partes = ip.split(".").map(Number);

		if (
			partes[0] === 10 ||
			partes[0] === 127 ||
			(partes[0] === 192 && partes[1] === 168) ||
			(partes[0] === 172 && partes[1] >= 16 && partes[1] <= 31) ||
			(partes[0] === 169 && partes[1] === 254) ||
			(partes[0] === 100 && partes[1] >= 64 && partes[1] <= 127) ||
			partes[0] === 0
		) {
			return "Esse é o IP interno da sua rede, ele não funciona na API. Pesquise por \"meu ip\" no Google ou peça o IP fixo público ao seu provedor de internet.";
		}

		return "";
	}

	$scope.salvarNovoIpApiExterna = function () {
		var ip = ($("#inputNovoIpApiExterna").val() || $("#inputIpFixoApiExterna").val() || "").trim();
		var erro;

		if (!ip) {
			swal("Ops!", "Informe o IP Fixo.", "error");
			return;
		}

		erro = validaIpApiExterna(ip);

		if (erro) {
			swal("Ops!", erro, "error");
			return;
		}

		showLoader(true);
		$("#editarIpApiExterna-modal").modal("hide");
		$scope.salvaIpFixo(ip);
	}
	

	$("#btnTrocarCartaoPlano").on('click', function () {

		swal({
				title: 'Realizar troca de cartão',
				text: 'Essa operação irá substituir o cartão cadastrado para o pagamento do plano. Deseja continuar?',
				type: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: 'Sim',
				cancelButtonText: 'Não',
				closeOnConfirm: true
			},
			function () {
				showLoader(true);
				$.ajax({
					type: "POST",
					url: "/pages/cadastros/CHECKOUT_Create.php",
					dataType: "json",
					data: {
						type: 3,
						establishment: $_CONFIG.CODESTABELECIMENTO,
						value: 0,
						installments: 1,
						payment_type: "credit_card",
						product_code: '',
						product_type: '',
						plan: "",
						origin: 2,
						metadata: ''
					},
					success: function (result) {
						showLoader(false);
						var checkout = result && result.data && result.data.checkout && result.data.checkout[0] ? result.data.checkout[0] : null;

						if (result && result.data && result.data.error === true) {
							toastr.error(result.data.message || "Falha ao gerar checkout.");
							return;
						}

						if (!checkout || checkout.error != 0 || !checkout.hash_code) {
							toastr.error((checkout && checkout.result) ? checkout.result : "Falha ao gerar checkout .");
							return;
						}

						showCheckoutLinkCard(getCheckoutUrl(checkout.hash_code));
					},
					error: function () {
						showLoader(false);
						swal("Falha na conexão.", "", "error");
					}
				});
			});
	})

	function showCheckoutLinkCard(link) {
		swal({
			title: "<strong>Troca de cartão</strong>",
			text: '\
				Acesse o <b>link de troca de cartão</b> para concluir o processo.<br><br>\
				<a id="btnOpenCheckout" target="_blank" href="' + link + '" autofocus>' + link + '</a><br><br>\
				',
			type: "info",
			showCancelButton: true,
			cancelButtonColor: "#d33",
			confirmButtonColor: "#00796B",
			confirmButtonText: "Abrir Checkout",
			cancelButtonText: "Fechar",
			closeOnConfirm: false,
			closeOnCancel: true,
			html: true,
			animation: "slide-from-top"
		},
		function (isConfirm) {
			if (isConfirm) {
				var linkElement = document.createElement("a");
				linkElement.href = link;
				linkElement.target = "_blank";
				linkElement.rel = "noopener noreferrer";
				document.body.appendChild(linkElement);
				linkElement.click();
				document.body.removeChild(linkElement);
			}
		});
	}

	$scope.buscaModuloEmpresa = function (tipo) {
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/EMPRESA_MODULO_Busca.php",
			data: {
				type: tipo
			},
			dataType: "json",
			success: function (result) {
				if (result.data.error == false) {
					if(result.data.modules.length > 0){
						if(result.data.modules[0].chatbot_code != undefined && result.data.modules[0].chatbot_code != null && result.data.modules[0].chatbot_code != ""){
							$("#abaChatbot").show();
							$scope.buscaBoletoChatbot()
						}else{
							$("#abaChatbot").hide();
						}
					}else{
						$("#abaChatbot").hide();
					}
				
				} else {
					$("#abaChatbot").hide();
				}
				
			},
			error: function (result) {
				
				
			}
		});
	}

	$scope.buscaBoletoChatbot = function (tipo) {
		if (typeof (optTabelalistaBoletoChatBot) != "undefined") {
			$('#tbBoletosChatbot tbody').unbind('click')
			optTabelalistaBoletoChatBot.destroy();
		}

		optTabelalistaBoletoChatBot = $('#tbBoletosChatbot').DataTable({
			"dom": 'T<"clear">lfrtip',
			"ajax": {
				"url": "/pages/cadastros/BOLETO_Busca.php",
				"method": "POST",
				"data": function (d) {
					d.type = 1;
				}
			},

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,

			"columns": [
				{
					"data": "boleto_date",
					"title": "Data do boleto",
					"width": "70%"
				},

				{
					"class": 'verboletos',
					"width": "12%",
					"orderable": false,
					"data": null,
					"defaultContent": '<button class="btn btn-success btn-xs" title="Ver boleto"><i class="fa fa-barcode"></i> Boleto</button>',
				},
				{
                    "data": "is_payed",
                    "title": "Pago",
					"width": "5%",
                    "render": function (data, type, row) {
						if(data == 1){
							return `<i class="fa fa-check-circle" style="color:green"></i>`
						}else{
							return ``
						}
                    }
                },
			],

			"ordering": false,

			"language": {
				"url": "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json"
			}
		});

		$('#tbBoletosChatbot tbody').on('click', 'td.verboletos', function () {
			var tr = $(this).closest('tr');
			var row = optTabelalistaBoletoChatBot.row(tr);
			var data = row.data();
			window.open(data.boleto_link, '_blank').focus();
		});
		resizeContent()

	}


	$scope.buscaModuloEmpresa(1)
});

