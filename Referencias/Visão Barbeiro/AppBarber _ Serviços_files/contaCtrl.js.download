	$('#totemImagem').fileinput({
		maxFilesNum: 1,
		showPreview: false,
		browseLabel: "Procurar ",
		removeLabel: "Remover",
		browseIcon: '',
		language: "pt-BR",
		allowedFileExtensions: ["png", "jpg", "jpeg"],
		showUpload: false
	});

	$('#video').fileinput({
		maxFilesNum: 1,
		showPreview: false,
		browseLabel: "Procurar",
		removeLabel: "Remover",
		browseIcon: '',
		language: "pt-BR",
		allowedFileExtensions: ["mp4"],
		showUpload: false
	}).on('change', function (event) {
		const file = this.files[0];
		if (file) {
			const videoUrl = URL.createObjectURL(file);
			const videoElement = document.getElementById('previewVideo');
			videoElement.src = videoUrl;
			videoElement.style.display = 'block';
		}
	}).on('fileclear', function () {
		limparCamposVideoModal(); // 
	});

	$('#video').on('change', function (e) {
		const file = e.target.files[0];
		if (file && file.type === 'video/mp4') {
			const videoURL = URL.createObjectURL(file);
			const video = $('#previewVideo');
			video.find('source').attr('src', videoURL);
			video[0].load(); 
			video.show();
		} else {
			$('#previewVideo').hide();
		}
	});

	function limparCamposVideoModal() {
		const videoElement = $('#previewVideo')[0];
		const sourceElement = $('#previewVideo source');
	
		// Revoga URL anterior para evitar vazamento de memória
		if (sourceElement.attr('src')) {
			URL.revokeObjectURL(sourceElement.attr('src'));
		}
	
		$('#formInsereVideosPrime')[0].reset(); // limpa inputs
		sourceElement.attr('src', ''); // limpa source
		videoElement.load(); // recarrega player vazio
		$(videoElement).hide(); // esconde player
	}
	

	function limparCamposImagemTotem() {
		$('#formInsereImagemTotem')[0].reset(); // limpa o campo input file
		$('#divImgTotem').empty(); // limpa a pré-visualização, se houver
	}
	

	$('#videoTotem-modal').on('hidden.bs.modal', function () {
		limparCamposVideoModal();
	});
	
