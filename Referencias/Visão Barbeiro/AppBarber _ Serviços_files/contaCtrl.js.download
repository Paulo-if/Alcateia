	$scope.buscaAbas= function(){
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/ABA_PERSONALIZADA_Busca.php",
			data: {},
			dataType: "json",
			success: function (result) {
				if(result.data.error === false){
					const tabs = result.data.tabs[0];
		
					// Marca as checkboxes de acordo com o valor retornado (1 = marcado)
					if (tabs.PAP_Pacote == 1) {
						$('input[name="pacotes"][value="1"]').prop('checked', true);
					}
					if (tabs.PAP_Assinatura == 1) {
						$('input[name="assinaturas"][value="1"]').prop('checked', true);
					}
					if (tabs.PAP_Produto == 1) {
						$('input[name="produtos"][value="1"]').prop('checked', true);
					}
					if (tabs.PAP_Fidelidade == 1) {
						$('input[name="fidelidade"][value="1"]').prop('checked', true);
					}
				}
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	}

	$scope.buscaAbas();

	$('#formPersonalizaAbas').on('submit', function (e) {
		e.preventDefault();
	
		const data = {
			subscription: $('input[name="assinaturas"][value="1"]').is(':checked') ? 1 : 0,
			product: $('input[name="produtos"][value="1"]').is(':checked') ? 1 : 0,
			bundle: $('input[name="pacotes"][value="1"]').is(':checked') ? 1 : 0,
			loyalty: $('input[name="fidelidade"][value="1"]').is(':checked') ? 1 : 0
		};
	
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/ABA_PERSONALIZADA_Atualiza.php",
			data: data,
			dataType: "json",
			success: function (result) {
				if (result.data.error === false) {
					swal("Sucesso!", "As abas foram atualizadas.", "success");
				} else {
					swal("Erro!", result.data.message || "Não foi possível atualizar.", "error");
				}
			},
			error: function () {
				swal("Falha na conexão.", "", "error");
			}
		});

		$scope.buscaAbas();
	});
