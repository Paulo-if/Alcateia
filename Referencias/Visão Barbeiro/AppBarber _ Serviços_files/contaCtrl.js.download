	$('#formCadastrarFilial').submit(function (event) {
		event.preventDefault();

		if (!validarEmail($('#filEmail').val())) {
			$('#filEmail').focus();
			toastr.error("Favor inserir um email válido");
			return false;
		}

		showLoader(true);
		var dados = new FormData(this);

		$.ajax({
			type: "POST",
			url: "/pages/cadastros/FILIAL_Insere.php",
			data: dados,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				showLoader(false);
				if (result.data && result.data.error === false) {
					toastr.success(result.data.message || "Filial cadastrada com sucesso!");
					$('#formCadastrarFilial').trigger('reset');
					var cnpjAtual = $scope.empresa.CNPJ.replaceAll('.', '').replaceAll('-', '').replaceAll('/', '');
					chageCNPJFilialInit(cnpjAtual.length == 14 ? 2 : 1, cnpjAtual);
					$("#filEmail").val($scope.empresa.Email);

					var novaFilial = result.data.branches_establishment && result.data.branches_establishment[0];
					if (novaFilial && novaFilial.user_id && novaFilial.user_hash && novaFilial.establishment_code) {
						swal({
							title: "Filial cadastrada com sucesso!",
							text: "Deseja acessar a nova unidade agora?",
							type: "success",
							showCancelButton: true,
							confirmButtonColor: "#378049",
							confirmButtonText: "Acessar nova unidade",
							cancelButtonText: "Continuar aqui",
							closeOnConfirm: false
						}, function (confirmado) {
							if (confirmado) {
								var url = "https://sistema.appbarber.com.br/php/authmobile.php?id=" + novaFilial.user_id + "&h=" + novaFilial.user_hash + "&p=" + novaFilial.establishment_code;
								window.location.replace(url);
							}
						});
					}
				} else {
					toastr.error((result.data && result.data.message) || "Não foi possível cadastrar a filial.");
				}
			},
			error: function () {
				showLoader(false);
				toastr.error("Falha na conexão.");
			}
		});

		return true;
	});

	function formattingValueAntecipacao(n) {
		return n.toFixed(2);
	}

	$("#btnCriaAntecipacao").click(() => {
		var valorAntecipacao = document.getElementById('antecipa_slider').value;
		var transferenciaAutomatica = document.getElementById('antecipaTransferenciaAutomatica').checked;
		var pwdAntecipa = document.getElementById('pwdAntecipa').value;

		if (pwdAntecipa === "") {

			toastr.error("Informe a sua senha.");

		} else {

			var params = new FormData();
			params.append("bulk_anticipation_id", $scope.antecipacao.bulk_anticipation_id);
			params.append("senha", pwdAntecipa);
			$(".loading-antecipa").show();
			fetch('./php/pagarme/confirmaAntecipacaoBulk.php', {
					method: "POST",
					body: params
				})
				.then(data => data.json())
				.then((data) => {
					$(".loading-antecipa").hide();
					if (data.errors == undefined) {
						$("#antecipacao-modal").modal('hide');
						swal("Antecipação criada com sucesso", "O valor estará disponível dia " + moment(data.payment_date).locale("pt-br").format("L"), "success");
						$scope.buscaAntecipacoesCriadas();
					} else {
						toastr.error(data.errors[0].message);
					}
				});
		}

	});


	var dataini = moment(dataAntecipa).locale("pt-br").format("L");
	$('.date.dateAntecipa').datepicker('setStartDate', dataini);
	$('.date.dateAntecipa').datepicker('update', dataini);

	$('.date.dateAntecipa').datepicker().on('changeDate', function (d, i) {
		newDate = moment();
		newDate.month(d.date.getMonth());
		newDate.year(d.date.getFullYear());
		newDate.date(d.date.getDate());
		$scope.antecipacao.payment_date = newDate.valueOf();
		verificaAntecipacao();
	});

	$('#antecipaTransferenciaAutomatica').change(() => {
		$scope.antecipacao.automatic_transfer = document.getElementById('antecipaTransferenciaAutomatica').checked;
		verificaAntecipacao();
	});

	$scope.buscaDadosAntecipacao = function () {
		buscaLimitesAntecipacao($scope.antecipacao.payment_date);
	}

	function buscaLimitesAntecipacao(payment_date) {

		$("#antecipacao-modal").modal();
		$scope.antecipacao.automatic_transfer = true;
		// var payment_date = moment().add(1, 'days').valueOf();
		fetch('./php/pagarme/buscaLimitesAntecipacao.php?paymentdate=' + payment_date + '')
			.then(data => data.json())
			.then((data) => {
				if (data.errors != undefined) {
					toastr.error(data.errors[0].message);
				} else {
					var maxAntecipacao = data.maximum;
					var minAntecipacao = data.minimum;

					$scope.antecipacao.amount = maxAntecipacao.amount;

					verificaAntecipacao();
					document.getElementById('txtTotalReceber').innerHTML = (maxAntecipacao.amount / 100).toString().formatMoney();
					$("#antecipa_slider").show();
					$("#antecipa_slider").ionRangeSlider({
						min: minAntecipacao.amount / 100,
						max: maxAntecipacao.amount / 100,
						from: maxAntecipacao.amount / 100,
						skin: "modern",
						prefix: "R$ ",
						step: 0.5,
						prettify: formattingValueAntecipacao,
						onFinish: function (data) {
							$scope.antecipacao.amount = data.from * 100;
							verificaAntecipacao();
						}
					});
				}


			});
	};

	function verificaAntecipacao() {
		$(".loading-antecipa").show();

		if ($scope.antecipacao.bulk_anticipation_id != "") {
			fetch('./php/pagarme/cancelaAntecipacaoBulk.php?bulk_anticipation_id=' + $scope.antecipacao.bulk_anticipation_id)
				.then(data => data.json())
				.then((data) => {
					if (data.errors != undefined) {
						toastr.error(data.errors[0].message);
					} else {
						criaAntecipacaoBulk();
					}
				})
		} else {
			criaAntecipacaoBulk();
		}
	}

	function criaAntecipacaoBulk() {

		var dataForm = new FormData();
		dataForm.append("paymentdate", $scope.antecipacao.payment_date)
		dataForm.append("requested_amount", $scope.antecipacao.amount)
		dataForm.append("automatic_transfer", $scope.antecipacao.automatic_transfer)

		fetch('./php/pagarme/criaAntecipacaoBulk.php', {
				method: "POST",
				body: dataForm
			})
			.then(data => data.json())
			.then((data) => {
				if (data.errors != undefined) {
					toastr.error(data.errors[0].message);
					$("#valorTotalAntecipa").html("R$ 0,00");
					$("#taxaAntecipa").html("R$ 0,00");
					$("#valorRecebidoAntecipa").html("R$ 0,00");
				} else {
					$scope.antecipacao.bulk_anticipation_id = data.id;
					$("#valorTotalAntecipa").html((data.amount / 100).toString().formatMoney2());
					$("#taxaAntecipa").html((data.anticipation_fee / 100).toString().formatMoney2());
					$("#valorRecebidoAntecipa").html(((data.amount - data.anticipation_fee) / 100).toString().formatMoney2());
				}

				$(".loading-antecipa").hide();

			});
	}

	$scope.buscaAntecipacoesCriadas = function () {
		$("#lista-antecipacoes-modal").modal();
		fetch('./php/pagarme/buscaAntecipacoesBulk.php')
			.then(data => data.json())
			.then((data) => {
				var dadosTable = [];
				if (data.length > 0) {

					data.forEach(element => {
						var status = "";
						if (element.status != "building") {
							if (element.status === "pending") {
								status = "<span class='badge bg-yellow'>Pendente</span>";
							} else if (element.status === "approved") {
								status = "<span class='badge bg-green'>Aprovado</span>";
							} else if (element.status === "refused") {
								status = "<span class='badge bg-red'>Recusado</span>";
							} else if (element.status === "canceled") {
								status = "<span class='badge bg-black'>Cancelado</span>";
							} else {
								status = "<span class='badge badge bg-grey'>Desconhecido</span>";
							}
							var el = {
								'valor': (element.amount / 100).toString().formatMoney2(),
								// 'taxa': (element.anticipation_fee / 100).toString().formatMoney2(),
								'status': status,
								'data_pagamento': moment(element.payment_date).locale("pt-br").format("L"),
							}
							dadosTable.push(el);
						}

					});
				}

				$("#tbListaAntecipacoes").bootstrapTable('refreshOptions', {
					data: dadosTable
				});
				$(".loading-list-antecipa").hide();

			});
	}

	$("#btnSaveTransferOptions").click((e) => {
		var automaticTransfer = $("#automaticTransfer").val();
		var dayForTransfer = $("#dayForTransfer").val();
		var dataForm = new FormData();
		dataForm.append("automaticTransfer", automaticTransfer);
		dataForm.append("dayForTransfer", dayForTransfer);
		showLoader(true);
		fetch('./php/pagarme/alteraInformacoesTransferencia.php', {
				method: "POST",
				body: dataForm
			})
			.then(data => data.json())
			.then((data) => {
				if (data.transfer_enabled) {
					mTransferAutomatic = "Habilitado";
				} else {
					mTransferAutomatic = "Desabilitado";
				}

				$("#lblTransferenciaAutomatica").html(mTransferAutomatic);

				$("#lblDiaTransferencia").html(data.transfer_day);

				showLoader(false);
				$("#editTransferOptions-modal").modal('hide');
			});
	});

	function buscaCEPEmpresa(cep) {

		if ($_CONFIG.PAIS != "1") {
			return;
		}

		mCep = cep;
		if (cep && cep.length >= parseInt($_CONFIG.language.mascaras.max_cep)) {
			cep = cep.replace("-", "");
			showLoader(true);
			var pais = $_CONFIG.language.mascaras.lang;
			$.ajax({
				dataType: "json",
				method: 'POST',
				url: '/pages/cadastros/buscaPostalCode.php',
				data: {
					code: cep,
					pais: pais
				},
				success: function (data) {
					var estado = "";
					if (pais == "pt") {
						estado = $("#" + data.estado.replace(" ", "").toLowerCase() + "").val();
					} else {
						estado = $("#" + data.estado + "").val();
					}
					$("#empEstado").val(estado);
					$("#empCidade").empty();

					$.ajax({
						dataType: "json",
						url: '/pages/cadastros/buscaCidadesWizard.php',
						method: "POST",
						data: {
							estCodigo: estado,
							cidNome: data.cidade
						},
						success: function (result) {
							$("#empCidade").append(result.cidades);
							$("#empCidade").attr("disabled", false);
							setTimeout(function () {
								$("#empCidade").val(result.cidcodigo);
							}, 10);
							showLoader(false);
							$("#empBairro").val(data.bairro);
							$("#empEndereco").val(data.endereco);
							setTimeout(function(){
								$scope.buscaLatLong();
							},1000)
						}
					});
					showLoader(false);
				},
				error: function () {
					showLoader(false);
					toastr.error($_CONFIG.language.mensagens.falha_cep, $_CONFIG.language.mensagens.falha_consulta);
				}
			});
		}
	}


	$("#empCEP").keyup(function (i) {
		buscaCEPEmpresa(this.value);
	});

	$("#empBairro").on('change',function(){
		$scope.buscaLatLong()
	});

	$("#empEndereco").on('change',function(){
		$scope.buscaLatLong()
	});

	$scope.buscaLatLong()

	var htmfiscalpreenchido = `<p>Você já preencheu o formulário para utilização fiscal, aguarde a finalização da sua configuração para emitir notas.</p>`;
	var htmfiscalativo = `<p>Você tem o módulo fiscal ativo. Você já pode emitir notas fiscais!</p>`;
	var htmlfislcalpendente = `<a class="btn btn-primary" href="https://${location.hostname}/dadosnf"> <i class="fa fa-clipboard" aria-hidden="true"></i> Preencher dados para o módulo fiscal</a>`;
	$.ajax({
		dataType: "json",
		url: '/pages/cadastros/buscaStatusFiscal.php',
		method: "POST",
		success: function (data) {
			if (data.data.length > 0) {
				$("#boletoFiscalFatura").hide()
				if (data.data[0].PAJ_Status_Fiscal == '') {
					$("#moduloFiscal").hide()
					$("#contentFiscal").html('')
				} else if (data.data[0].PAJ_Status_Fiscal == 2 || data.data[0].PAJ_Status_Fiscal == 3 ) {
					$("#moduloFiscal").show()
					$("#contentFiscal").html(htmfiscalpreenchido)
				} else if (data.data[0].PAJ_Status_Fiscal == 1) {
					$("#moduloFiscal").show()
					$("#contentFiscal").html(htmlfislcalpendente)
				}else{
					$("#moduloFiscal").show()
					$("#contentFiscal").html(htmfiscalativo)
					$("#contentFiscal").hide()
					$scope.buscaBoletoNF();
					$("#boletoFiscalFatura").show()

				}
			} else {
				$("#hasFiscal").html(mosession)
			}
		}
	});


	$.ajax({
		dataType: 'json',
		url: localStorage.getItem('host'),
		async: false,
		data: {
			metodo: 'buscaParametro',
			id: $scope.idCliente,
			parcodigo: 120
		},
		success: function (data) {
			if (data.result.length > 0) {
				if (data.result[0].PVa_Vlr_Principal == '') {
					$.ajax({
						dataType: "json",
						url: '/pages/cadastros/buscaStatusPessoaContaDigital.php',
						method: "POST",
						success: function (data) {
							if (data.data.length > 0) {
								if (data.data[0].CDI_Status == 1) {
									$("#contaDigital").show()
									$("#formContaDigital").show()
									$("#nextContaDigital").hide()
									$("#waitContaDigital").hide()
								}else if (data.data[0].CDI_Status == 0){
									$("#contaDigital").show()
									$("#waitContaDigital").show()
									$("#nextContaDigital").hide()
									$("#formContaDigital").hide()
								}else{
									$("#contaDigital").show()
									$("#formContaDigital").hide()
									$("#nextContaDigital").show()
									$("#waitContaDigital").hide()
								}
							} else {
								$("#contaDigital").remove()
							}
						}
					});
				}
				else if (data.result[0].PVa_Vlr_Principal == 1) {
					$("#contaDigital").show()
					$("#doneContaDigital").show()
					$("#outContaDigital").remove()
					$("#nextContaDigital").remove()
					$("#formContaDigital").remove()
					$("#waitContaDigital").remove()
				} else  {
					$("#contaDigital").show()
					$("#outContaDigital").show()
					$("#doneContaDigital").remove()
					$("#nextContaDigital").remove()
					$("#formContaDigital").remove()
					$("#waitContaDigital").remove()
				}
			} else {
				$.ajax({
					dataType: "json",
					url: '/pages/cadastros/buscaStatusPessoaContaDigital.php',
					method: "POST",
					success: function (data) {
						if (data.data.length > 0) {
							if (data.data[0].CDI_Status == 1) {
								$("#contaDigital").show()
								$("#formContaDigital").show()
								$("#nextContaDigital").hide()
								$("#waitContaDigital").hide()
							}else if(data.data[0].CDI_Status == 0){
								$("#contaDigital").show()
								$("#waitContaDigital").show()
								$("#nextContaDigital").hide()
								$("#formContaDigital").hide()
							}else{
								$("#contaDigital").show()
								$("#formContaDigital").hide()
								$("#waitContaDigital").hide()
								$("#nextContaDigital").show()
							}
						} else {
							$("#contaDigital").remove()
						}
					}
				});
			
			}
		}
	});

	$.ajax({
		dataType: 'json',
