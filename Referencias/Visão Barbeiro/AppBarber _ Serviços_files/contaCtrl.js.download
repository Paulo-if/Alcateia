	$('#formInsereImagePrime').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		var dados = new FormData(this);
		dados.append("blob", mBlob);
		dados.delete("primeImagem");
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/IMAGEM_PRIME_Insere.php",
			data: dados,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.data.error == false) {
					swal(result.data.message, "", "success");
					$("#divimgPrime").html("");
					$("#imagemCutAll").cropper("destroy");
					$scope.buscaPessoaImagemPrime();
				} else {
					swal(result.data.message, "", "error");
				}
				showLoader(false);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});

		return true;
	});

