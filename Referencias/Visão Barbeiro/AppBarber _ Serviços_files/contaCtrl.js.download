angular.module('appBeleza').controller("contaCtrl", function ($rootScope, $scope, $http, $compile, $state, $translate) {
	$rootScope.header = sSistema + " | Conta";
	$("#navProf").hide();
	$("#formProf").hide();
	changeHeightBody();
	$(".select2").select2();
	$App.timePicker('.timepicker', '0:00am', 5);
	$(".timepicker").mask('99:99');
	$scope.geraComboPaisTelefone('filCellphone', 'filDialCode');

	var host = localStorage.getItem("host");

	if ($_CONFIG.PAIS != "1") {
		$("#empCEP").attr("maxlength", "12").attr("onKeyPress", "mascara(this,soNumeros)");
	}

	$scope.dadosPerfil;
	$scope.valorMaxTransf;
	$scope.valorDisponivel;
	$scope.taxaTransferencia = 3.67;
	$scope.sSistema = sSistema;
	$scope.siteSistema = "https://sites." + sSistema.toLowerCase() + ".com.br";

	$scope.withContaStar = false;
	$scope.bankAccounts;
	$scope.totalBankAccounts = -1;
	$scope.codigoEmpresaNF = '';

	var dataAntecipa = funProxDiaUtil(moment().add(1, 'days').format("YYYY-MM-DD"), "YYYY-MM-DD");
	var qrcode;
	var tabelaApiExterna;
	var apiExternaAtivas = 0;
	var apiExternaBalance = null;
	var apiExternaStatus = "";
	var apiExternaUpdatedAt = "";
	var apiExternaIp = "";
	var apiExternaLastIpChange = "";
	var relatorioApiExternaNextCursor = null;
	var relatorioApiExternaCursorAtual = null;
	var relatorioApiExternaHistorico = [];
	var relatorioApiExternaPagina = 1;
	$scope.antecipacao = {
		bulk_anticipation_id: "",
		amount: "",
		automatic_transfer: false,
		payment_date: moment(dataAntecipa).add(1, 'days').valueOf()
	}

	$.ajax({
		dataType: "json",
		url: '/pages/cadastros/buscaPais.php',
		method: "POST",
		success: function (data) {
			var html = "";
			for (var i = 0; i < data.result.length; i++) {
				html += '<option value="' + data.result[i].Pai_Codigo + '" >' + data.result[i].Pai_Nome + '</option>';
			}
			$("#empPais").html(html);

		}
	});

	$("#empPais").change(function () {
		var paicodigo = this.value;
		
		// Mostrar/ocultar campo NIF baseado no país
		if (paicodigo != "1") {
			$("#rowNIF").show();
		} else {
			$("#rowNIF").hide();
		}
		
		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/buscaEstadoPais.php',
			method: "POST",
			data: {
				paicodigo: paicodigo
			},
			success: function (data) {
				var html = "";
				html += '<option value="">Estado</option>';
				for (var i = 0; i < data.result.length; i++) {
					html += '<option id="'+ data.result[i].Est_Sigla +'" value="' + data.result[i].Est_Codigo + '" >' + data.result[i].Est_Nome + '</option>';
				}

				$("#empEstado").html(html);
				$("#empEstado").change();
			}
		});
	})

	$("#tbListaAntecipacoes").bootstrapTable({
		locale: 'pt-BR',
		data: {}
	});

	$(".input-group.date").datepicker({
		language: "pt-BR",
		orientation: "top auto",
		autoclose: true,
		format: "dd/mm/yyyy"
	});

	$translate('mascaras.celular')
		.then(function (value) {
			if (value != '') {
				$('#empCelular').mask(value);
			}
		});

	if ($_CONFIG.PAIS == "1") {
		var maskBehavior = function (val) {
				return val.replace(/\D/g, '').length === 11 ? '(00) 00000-0000' : '(00) 0000-00009';
			},
			options = {
				onKeyPress: function (val, e, field, options) {
					field.mask(maskBehavior.apply({}, arguments), options);
				}
			};
		$('#empTelefone').mask(maskBehavior, options);
	} else {
		$translate('mascaras.telefone')
			.then(function (value) {
				if (value != '') {
					$('#empTelefone').mask(value);
				}
			});
	}

	var datafim = moment().locale("pt-br").format("L");
	var dataini = moment().add(-7, "days").locale("pt-br").format("L");
	$('.date.divDataIni').datepicker('update', dataini);
	$('.date.divDataFim').datepicker('update', datafim);

	$('#formAlteraSenha').submit((event) => {
		event.preventDefault();
		formCadastro = $(event.currentTarget);
		showLoader(true);
		var dados = new FormData(event.currentTarget);
		dados.append("tipo", "1");
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/alteraSenha.php",
			data: dados,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.result[0].erro == "0") {
					toastr.success(result.result[0].resultado);
					formCadastro.each(function () {
						this.reset();
					});
				} else {
					toastr.error(result.result[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
				showLoader(false);
			}
		});

		return true;
	});

	function buscaPerfil() {
		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/buscaPerfil.php',
			success: (data) => {
				$scope.dadosPerfil = data.perfil[0];
				$("#perNomeInfo").html($scope.dadosPerfil.nome);
				$("#perEmailInfo").html($scope.dadosPerfil.email);
				$("#perCpfInfo").html($scope.dadosPerfil.cpf);
				$("#perCelularInfo").html($scope.dadosPerfil.celular);
				$("#perTelefoneInfo").html($scope.dadosPerfil.telefone);
				$("#perSexoInfo").html($scope.dadosPerfil.sexo);
				$("#perDataNascimentoInfo").html($scope.dadosPerfil.data_nascimento);
				$("#perEnderecoInfo").html($scope.dadosPerfil.endereco);
				$("#perBairroInfo").html($scope.dadosPerfil.bairro);
				$("#perCidadeInfo").html($scope.dadosPerfil.cidade);
				$("#perEstadoInfo").html($scope.dadosPerfil.estado);
				$("#perCepInfo").html($scope.dadosPerfil.cep);
				$("#pesCodigoAlt").val($scope.dadosPerfil.pescodigo);
				$("#usuCodigo").val($scope.dadosPerfil.usucodigo);

				if ($scope.dadosPerfil.imagem != "") {
					$("#perFotoInfo").prop('src', $scope.dadosPerfil.imagem);
					$("#imgUsuFoto").prop('src', $scope.dadosPerfil.imagem);
				}
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
			}
		});
	}

	$("#perEstado").change(function () {
		var estado = this.value;
		$("#perCidade").empty();
		if (estado === -1) {
			$("#perCidade").attr("disabled", true);
		} else {
			$.ajax({
				dataType: "html",
				url: '/pages/cadastros/buscaCidades.php',
				method: "POST",
				data: {
					estCodigo: estado
				},
				success: (data) => {
					$("#perCidade").append(data);
					$("#perCidade").attr("disabled", false);
				}
			});
		}
	});

	$('#perCelular').mask('(00) 0000-00009');
	$('#perCelular').blur(function (event) {
		if ($(this).val().length == 15) {
			$('#perCelular').mask('(00) 00000-0009');
		} else {
			$('#perCelular').mask('(00) 0000-00009');
		}
	});

	$('#empFotoEdt').fileinput({
		maxFilesNum: 1,
		showPreview: false,
		browseLabel: "Procurar",
		removeLabel: "Remover",
		language: 'pt-BR',
		browseIcon: '',
		allowedFileExtensions: ["png", "jpg", "jpeg"],
		showUpload: false
	});

	$('#perFoto').fileinput({
		maxFilesNum: 1,
		showPreview: false,
		browseLabel: "Procurar",
		removeLabel: "Remover",
		language: 'pt-BR',
		browseIcon: '',
		allowedFileExtensions: ["png", "jpg", "jpeg"],
		showUpload: false
	});

	$('#fileImportDocument').fileinput({
		maxFilesNum: 1,
		showPreview: false,
		browseLabel: "Procurar",
		removeLabel: "Remover",
		language: 'pt-BR',
		browseIcon: '',
		allowedFileExtensions: ["xls", "xlsx", "csv"],
		showUpload: false
	});

	$scope.empresa = "";
	$scope.idCliente = $_CONFIG.ID;

	function chageCNPJinit(tipo, val) {
		if (tipo == 1) {
			$("#tipocampoCPFEdtConta").val(1)
			$("#btnCpfCnpjEdtConta").html("CPF");
			$("#empCNPJ").val('');
			$("#empCNPJ").attr('maxlength', '14')
			$("#empCNPJ").attr('placeholder', 'CPF');

		} else {
			$("#tipocampoCPFEdtConta").val(2)
			$("#btnCpfCnpjEdtConta").html("CNPJ")
			$("#empCNPJ").val('');
			$("#empCNPJ").attr('placeholder', 'CNPJ')
			$("#empCNPJ").attr('maxlength', '18')
		}
		$("#empCNPJ").val(val);
		$("#empCNPJ").keypress()
	}

	function chageCNPJFilialInit(tipo, val) {
		if (tipo == 1) {
			$("#tipocampoCPFFilial").val(1)
			$("#btnCpfCnpjFilial").html("CPF");
			$("#filDocumentNumber").attr('maxlength', '14')
			$("#filDocumentNumber").attr('placeholder', 'CPF');
		} else {
			$("#tipocampoCPFFilial").val(2)
			$("#btnCpfCnpjFilial").html("CNPJ")
			$("#filDocumentNumber").attr('placeholder', 'CNPJ')
			$("#filDocumentNumber").attr('maxlength', '18')
		}
		$("#filDocumentNumber").val(val);
	}

	function validaAbaCadastrarFilial() {
		$("#menuCadastrarFilial").hide();

		$.ajax({
			type: "GET",
			url: "/pages/cadastros/buscaEmpresaMatriz.php",
			dataType: "json",
			success: function (result) {
				var establishment = result && result.branches_establishment && result.branches_establishment[0];
				if (establishment && establishment.is_matriz == 1) {
					$("#menuCadastrarFilial").show();
				}
			},
			error: function () {
				console.error("Falha na conexão ao buscar dados da organização");
			}
		});
	}
	$scope.validaAbaCadastrarFilial = validaAbaCadastrarFilial;

	function validaAbaApi() {
		escondeTelasApi();

		$.ajax({
			type: "POST",
			url: "/pages/cadastros/EMPRESA_API_STATUS_Busca.php",
			dataType: "json",
			success: function (result) {

				if (
					result.error === false &&
					result.organization &&
					result.organization.length > 0
				) {

					const apiStatus = result.organization[0].api_status;

					const ApiStatus = Object.freeze({
						LIBERADO: 1,
						PREENCHIDO: 2,
						CONTRATOASSINADO: 3,
						PAGO: 4,
						CONTRATADO: 5
					});

					if (apiStatus == ApiStatus.LIBERADO) {
						mostraFormularioApi();
						return;
					}

					if (apiStatus == ApiStatus.PREENCHIDO) {
						mostraAguardandoContratoApi();
						return;
					}

					if (apiStatus == ApiStatus.CONTRATOASSINADO) {
						mostraAguardandoPagamentoApi();
						return;
					}

					if (apiStatus == ApiStatus.PAGO) {
						mostraAguardandoIpFixo();
						return;
					}

					if (apiStatus == ApiStatus.CONTRATADO) {
						carregaTelaGerenciamentoApi();
						return;
					}

				} else {
					console.error("Resposta inesperada:", result);
				}
			},
			error: function () {
				showLoader(false);
				toastr.error("Falha na conexão ao buscar status da API");
			}
		});
	}

	$scope.chageCNPJinit = chageCNPJinit;
	$scope.validaAbaApi = validaAbaApi;

	function carregaMapa(latitude, longitude, titulo, mapa, drag) {
		var myLatlng = new google.maps.LatLng(latitude, longitude);
		var mapOptions = {
			zoom: 15,
			center: myLatlng
		}
		var map = new google.maps.Map(mapa, mapOptions);
		var marker = new google.maps.Marker({
			position: myLatlng,
			map: map,
			title: titulo,
			draggable: drag,
			animation: google.maps.Animation.DROP
		});

		google.maps.event.addListener(marker, 'dragend', function (event) {
			$("#empLat").val(this.getPosition().lat());
			$("#empLong").val(this.getPosition().lng());
		});

	}

	$scope.carregaDados = function () {

		$http.get(localStorage.getItem("host") + '?metodo=buscaPessoa&tipo=2&id=' + $scope.idCliente).
		success(function (data, status, headers, config) {
			$scope.empresa = data.buscaPessoa[0];

			var cnpj = $scope.empresa.CNPJ.replaceAll('.', '').replaceAll('-', '').replaceAll('/', '')
			if (cnpj.length == 14) {
				$scope.chageCNPJinit(2, cnpj)
				chageCNPJFilialInit(2, cnpj)
			} else {
				$scope.chageCNPJinit(1, cnpj);
				chageCNPJFilialInit(1, cnpj)
			}
			$("#filEmail").val($scope.empresa.Email);

			lat = $scope.empresa.Latitude;
			$scope.codigoEmpresaNF = $scope.empresa.CodigoNF
			longit = $scope.empresa.Longitude;
			markerTitle = $scope.empresa.Nome_Fantasia;
			carregaMapa(lat, longit, markerTitle, document.getElementById('mapa'), false);
			$scope.apresentacao = $scope.empresa.Apresentacao;
			if($scope.empresa.PAJ_Ativo_Prime == '1'){
				$("#planoPrime").show()
			}else{
				$("#planoPrime").hide()
			}
			$('[data-toggle="popover"]').popover({
				container: 'body'
			});

			$("#tipoAtendimentoEmpresa").val($scope.empresa.TAt_Codigo)
			
			if ($scope.empresa.PAJ_NIF) {
				$("#empNIF").val($scope.empresa.PAJ_NIF);
			}

			if ($scope.empresa.Wifi != 1) {
				$("#empWifi").prop('checked', false);
			} else {
				$("#empWifi").prop('checked', true)
			}
			if ($scope.empresa.AtendeCrianca != 1) {
				$("#empAtendeCrianca").prop('checked', false);
			} else {
				$("#empAtendeCrianca").prop('checked', true)
			}
			if ($scope.empresa.AcessoDeficiente != 1) {
				$("#empAcessoDeficiente").prop('checked', false);
			} else {
				$("#empAcessoDeficiente").prop('checked', true)
			}
			if ($scope.empresa.Estacionamento == "Sim") {
				$("#empEstacionamentoS").prop('checked', true)
			} else if ($scope.empresa.Estacionamento == "Não") {
				$("#empEstacionamentoN").prop('checked', true)
			} else if ($scope.empresa.Estacionamento == "Sim,Pago") {
				$("#empEstacionamentoSP").prop('checked', true)
			}
			if ($scope.empresa.Pagina == "1") {
				$("#botaoCriaPagina").hide();
			} else {
				$("#botaoCriaPagina").show();
			}
			setTimeout(() => {
				$("#empPais").val($scope.empresa.Pai_Codigo);
				$("#empPais").change();
				setTimeout(() => {
					$('#empEstado').val($scope.empresa.Est_Codigo);
					$.ajax({
						dataType: "html",
						url: '/pages/cadastros/buscaCidades.php',
						method: "POST",
						data: {
							estCodigo: $scope.empresa.Est_Codigo
						},
						success: function (data) {

							$("#empCidade").append(data);
							$("#empCidade").attr("disabled", false);
							$('#empCidade').val($scope.empresa.Cid_Codigo);
						}
					});
				}, 1000);
			}, 1000)

			$scope.geraComboPaisTelefone('empCelular', 'empDDI', $scope.empresa.DDI)
			setTimeout(() => {
				$("#empCelular").val($scope.empresa.Celular)
			}, 3000)

			$("#empCidade").empty();

			if ($scope.empresa.Token != "") {
				$("#txtNomeRevendedor").html($scope.empresa.Revendedor);
				$("#txtTokenRevendedor").html($scope.empresa.Token);
				$("#divRevendedor").show();
				$("#formTokenRevenda").hide();
			} else {
				formTokenRevenda
				$("#divRevendedor").hide();
				$("#formTokenRevenda").show();
			}
			setTimeout(function(){
				carregaMapa(lat, longit, markerTitle, document.getElementById('mapaEdt'), true);
			},3000)


		}).
		error(function (data, status, headers, config) {
			console.log("Falha no método buscaPessoa. erro:" + data);
		});
	};

	function carregaDados() {
		tabelaDadosConta = $('#tbDadosConta').dataTable({
			"ajax": "/pages/cadastros/buscaDadosConta.php",
			"columnDefs": [{
				"targets": [0, 7, 8, 9, 10, 11],
				"visible": false,
				"searchable": false
			}],
			"initComplete": function (e, records, f) {

				if (records.data.length > 0) {
					$("#dataVencimentoPlano").html(records.data[0].DataVenc);
					$scope.dataContratacaoPlano = records.data[0].DataCont;
					$scope.$apply();
					$("#btnRenovarPlano").show();
					$("#empNomeFant").prop('disabled',true);
					$("#empCNPJ").prop('disabled',true);
					$("#empIE").prop('disabled',true);
					$("#empEmail").prop('disabled',true);
					$("#btngroup-cnpj").prop('disabled',true);
					$(".trocaTitularidade").show();
				} else {
					$("#dataVencimentoPlano").html('');
					$("#dataContratacaoPlano").html('');
					$("#btnRenovarPlano").hide();
					$("#empNomeFant").prop('disabled',false)
					$("#empCNPJ").prop('disabled',false)
					$("#empIE").prop('disabled',false)
					$("#empEmail").prop('disabled',false)
					$("#btngroup-cnpj").prop('disabled',false)
					$(".trocaTitularidade").hide();
				}

				$(".btnVerCartao").click(function () {
					$App.showCartaoModal(this.dataset.cardid, this.dataset.customerid);
				});

				$("#btnBoletoCodigo").click(function () {
					$("#codigoBoleto").html("");
					mBoleto = new Boleto(this.dataset.codigo);
					$("#valorBoleto").html(mBoleto.prettyAmount());
					$("#vencimentoBoleto").html(this.dataset.vencimento);
					var buttonCopyClipboard = '<button class="btn btn-sm btn-primary btnClip" data-clipboard-text="' + mBoleto.prettyNumber() + '"><i class="fa fa-copy" alt="Copiar"></i></button>';
					$("#linkBoleto").html("<a href='" + this.dataset.link + "' target='_blank'>Visualizar o Boleto</a>");
					$("#linhaBoleto").html(mBoleto.prettyNumber() + " " + buttonCopyClipboard);
					mBoleto.toSVG('#codigoBoleto');

					var clipboard = new ClipboardJS('.btnClip');
					clipboard.on('success', function (e) {
						toastr.success("Copiado!");
					});

					$("#boleto-modal").modal();

				});

				$("#btnPixCodigo").click(function () {
					$App.showPIXModal(this.dataset.valor, this.dataset.link, 3, this.dataset.codexterno);
				});
			},
			scrollX: isPortrait,
			"language": {
				"url": "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json"
			},
			"columns": [
				{ "data": "DT_RowId" },
				{ "data": "Plano" },
				{ "data": "Parcelas" },
				{ "data": "Valor" },
				{ "data": "DataVenc" },
				{ "data": "DataPgto" },
				{ "data": "Status" },
				{ "data": "IDPM" },
				{ "data": "Codigo" },
				{ "data": "Dias" },
				{ "data": "TipoAssinatura" },
				{ "data": "TipoPagamento" },
				{ "data": "Boleto" },
				{ "data": "Nota" }
			]
		});
		resizeContent();
	}

	$scope.mostrarAbaImportacao = function () {
		if (!$scope.dataContratacaoPlano) {
			return false;
		}
		var dataContratacao = moment($scope.dataContratacaoPlano, "DD/MM/YYYY");
		return dataContratacao.isValid() && moment().diff(dataContratacao, "months", true) <= 3;
	};

	tabelaHorarioFuncionamento = $('#tbHorarioFun').dataTable({
		"ajax": {
			"url": "/pages/cadastros/buscaHorarioFuncionamento.php",
			"method": "POST"
		},
		"columnDefs": [{
			"targets": [1],
			"visible": false,
			"searchable": false
		}],
		"columns": [
			{ "data": "Dia" },
			{ "data": "PHF_Dia" },
			{ "data": "PHF_Hora1" },
			{ "data": "PHF_Hora2" },
			{ "data": "PHF_Hora3" },
			{ "data": "PHF_Hora4" },
			{
				"class": 'excluir-control',
				"orderable": false,
				"data": null,
				"defaultContent": ''
			}, {
				"class": 'editar-control',
				"orderable": false,
				"data": null,
				"defaultContent": ''
			}
		],
		"language": {
			"url": "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json"
		},
		"paging": false,
		"ordering": false,
		"info": false,
		"searching": false
	});

	$('#tbHorarioFun tbody').on('click', 'td.excluir-control', function () {
		var tr = $(this).closest('tr');

		var idx = tr[0]._DT_RowIndex;
		var registroTabela = tabelaHorarioFuncionamento.fnGetData(idx);

		swal({
				title: "Confirmar exclusão:",
				text: "Deseja excluir  " + registroTabela.Dia,
				type: "warning",
				showCancelButton: true,
				confirmButtonColor: "#DD6B55",
				confirmButtonText: "Sim",
				cancelButtonText: "Não",
				closeOnConfirm: false
			},
			function () {
				showLoader(true);
				$.ajax({
					dataType: "html",
					url: '/pages/cadastros/removeHorarioFuncionamento.php',
					data: {
						dia: registroTabela.PHF_Dia
					},
					success: function (data) {
						swal("Sucesso!", " Horario de funcionamento excluido.", "success");
						tabelaHorarioFuncionamento.api().ajax.reload();
						showLoader(false);
					},
					error: function (result) {
						swal("Falha na conexão.", "", "error");
						showLoader(false);
					}
				});
			});
	});

	$('#tbHorarioFun tbody').on('click', 'td.editar-control', function () {
		var tr = $(this).closest('tr');
		var idx = tr[0]._DT_RowIndex;
		var registroTabelaAlt = tabelaHorarioFuncionamento.fnGetData(idx);
		$("#hfAltDiaSemana").multiselect("deselectAll", false);
		$("#hfAltDiaSemana").multiselect("refresh");
		$("#hfAltDiaSemana").multiselect("select", registroTabelaAlt.PHF_Dia);
		$("#hfAltHoraIni1").select2("val", registroTabelaAlt.PHF_Hora1);
		$("#hfAltHoraFim1").select2("val", registroTabelaAlt.PHF_Hora2);
		$("#hfAltHoraIni2").select2("val", registroTabelaAlt.PHF_Hora3);
		$("#hfAltHoraFim2").select2("val", registroTabelaAlt.PHF_Hora4);
		$("#alteraHorarioFuncionamento-modal").modal();
	});

	function formatNumberBr(value) {
		var text = (value || 0).toString();
		return text.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
	}

	function formatMoneyBr(value) {
		var number = Number(value || 0);
		var parts = number.toFixed(2).split(".");
		parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ".");
		return "R$ " + parts[0] + "," + parts[1];
	}

	function calculaApiExternaAtivas(rows) {
		var count = 0;
		if (!rows || !rows.length) {
			return count;
		}
		for (var i = 0; i < rows.length; i++) {
			if (rows[i].Ativa === 1 || rows[i].Ativa === "1") {
				count++;
				continue;
			}
			var status = rows[i].Status || "";
			if (status.indexOf("bg-green") !== -1 || status.indexOf("Ativa") !== -1) {
				count++;
			}
		}
		return count;
	}

	

	$scope.buscaSaldoSMS = function () {
		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/buscaDadosSMS.php',
			method: "POST",
			data: {
				tipo: 1
			},
			success: function (data) {
				if (data.result.length > 0) {
					$("#lblSaldoSMS").html(data.result[0].Saldo);
				}
			}
		});
	}

	$scope.buscaHistoricoSMS = function () {
		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/buscaDadosSMS.php',
			method: "POST",
			data: {
				tipo: 2
			},
			success: function (data) {

				var html = "";
				if (data.result.length > 0) {
					html += '<ul class="timeline">';
					for (var i = 0; i < data.result.length; i++) {

						valores = data.result[i];

						var horario = valores.PSF_Dat_Compra.split(" ");
						var usuario = valores.Usu_Nome;
						var valor = valores.PSF_Valor;
						var status = valores.SMSStatus;
						var dataExp = valores.PSF_Dat_Expiracao;
						var dataPag = valores.PSF_Dat_Pagamento;
						var qtd = valores.PSF_Qtd_Compra;
						var codStatus = valores.PSF_Status;
						var linkNota = valores.PNo_Link_PDF;
						var botaoNota= '';
						if(linkNota != ''){
							botaoNota = `<a class="btn btn-xs btn-warning" href="${linkNota}" target="_blank" style="margin-left:10px;"> <i class="fa fa-file-pdf-o" aria-hidden="true"></i> Nota</a>`
						}

						if (codStatus == '1') {
							statusCor = 'bg-green';
							statusIcon = 'ion ion-checkmark-round';
						} else if (codStatus == '0') {
							statusCor = 'bg-blue';
							statusIcon = 'ion ion-clock';
						} else {
							statusCor = 'bg-red';
							statusIcon = 'ion ion-close-round';
						}

						html += '<li class="time-label">';
						html += '<span class="' + statusCor + '">';
						html += horario[0];
						html += '</span></li>';
						html += '<li>';
						html += '<i class="ion ' + statusIcon + ' ' + statusCor + '"></i>';
						html += '<div class="timeline-item">';
						html += '<span class="time"><i class="fa fa-clock-o"></i> ' + horario[1] + '</span>';
						html += '<h3 class="timeline-header">Compra de ' + qtd + ' SMS</h3>';
						html += '<div class="timeline-body">';
						html += '<p>Realizada por: ' + usuario + '</p>';
						html += '<p>Valor: ' + valor + '</p>';

						if (codStatus != '0') {
							html += '<p>Data do Pagamento: ' + dataPag + '</p>';
						}

						html += '<small class="label ' + statusCor + '">' + status + '</small>' + botaoNota;
						html += '</div>';
						if (codStatus == '1') {
							html += '<div class="timeline-footer">';
							html += 'Expira em: ' + dataExp;
							html += '</div>';
						}
						html += '</div>';
						html += '</li>';
					}
					html += '</ul>';

				} else {
					html += '<div class="callout callout-info">';
					html += '<h4>Você ainda não possui nenhum histórico de compra.</h4>';
					html += '<p>Clique em "Comprar SMS" para efetuar uma compra de créditos SMS.</p>';
					html += '</div>';
				}
				$("#timelineSMS").html(html);
			}
		});
	}


