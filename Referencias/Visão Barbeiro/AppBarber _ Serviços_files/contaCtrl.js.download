	//** Pagamento Online ** //
	$scope.buscaSaldoCarteira = function () {
		$(".valor").maskMoney({
			prefix: 'R$ ',
			allowZero: true,
			thousands: '.',
			decimal: ','
		});
		$scope.buscaDetalhesConta();
		$.ajax({
			dataType: "json",
			url: '/php/pagarme/BuscaSaldo.php',
			success: function (data) {

				if (typeof (data.erro) != "undefined") {
					$("#pagOnlineBloqueado").show();
					$("#semCarteira").hide();
					$("#divCarteira").hide();
				} else {
					if (typeof (data.waiting_funds) == "undefined") {
						$("#semCarteira").show();
						$("#divCarteira").hide();
						$("#pagOnlineBloqueado").hide();
					} else {
						$("#semCarteira").hide();
						$("#divCarteira").show();
						$("#pagOnlineBloqueado").hide();
						var waiting_funds = data.waiting_funds.amount;
						var transferred = data.transferred.amount;
						var available = data.available.amount;

						if (available > 0) {
							$("#btnResgatar").show();
							$("#btnResgatarSld").hide();
						} else {
							$("#btnResgatar").hide();
							$("#btnResgatarSld").show();
						}

						if (waiting_funds > 0) {
							$("#btnAntecipar").show();
							$("#btnAnteciparSld").hide();
						} else {
							$("#btnResgatar").show();
							$("#btnAnteciparSld").hide();
						}

						$scope.valorDisponivel = available / 100;
						$scope.valorMaxTransf = $scope.valorDisponivel - $scope.taxaTransferencia;
						$("#saldoTransf").html(formataDinheiro(transferred));
						$("#saldoDisp").html(formataDinheiro(available));
						$("#saldoWait").html(formataDinheiro(waiting_funds));
						$("#lblValorMax").html(formataDinheiro(($scope.valorMaxTransf * 100)));
					}
				}
			}
		});
	}

	$scope.buscaDetalhesConta = function () {
		$.ajax({
			dataType: "json",
			url: '/php/pagarme/buscaDadosRecebedor.php',
			success: function (data) {
				var mAgencia, mConta, mTransferAutomatic;
				if (data.bank_account.agencia_dv == null || data.bank_account.agencia_dv == "") {
					mAgencia = data.bank_account.agencia;
				} else {
					mAgencia = data.bank_account.agencia + "-" + data.bank_account.agencia_dv;
				}

				if (data.bank_account.conta_dv == null || data.bank_account.conta_dv == "") {
					mConta = data.bank_account.conta;
				} else {
					mConta = data.bank_account.conta + "-" + data.bank_account.conta_dv;
				}

				$("#lblNomeConta").html(data.bank_account.legal_name);
				$("#lblNomeContaPag").html(data.bank_account.legal_name);
				$.ajax({
					dataType: "json",
					url: '/php/arrayBancos.php?format=json',
					success: function (banks) {
						$("#lblBancoConta").html(banks[data.bank_account.bank_code] + " (" + data.bank_account.bank_code + ")");
						$("#lblBancoContaPag").html(banks[data.bank_account.bank_code] + " (" + data.bank_account.bank_code + ")");
					}
				});

				$("#lblCpfConta").html(data.bank_account.document_number);
				$("#lblCpfContaPag").html(data.bank_account.document_number);
				$("#lblAgenciaConta").html(mAgencia);
				$("#lblAgenciaContaPag").html(mAgencia);
				$("#lblNumeroConta").html(mConta);
				$("#lblNumeroContaPag").html(mConta);

				if (data.transfer_enabled) {
					mTransferAutomatic = "Habilitado";
					$("#automaticTransfer").val("1");
				} else {
					mTransferAutomatic = "Desabilitado";
					$("#automaticTransfer").val("0");
				}

				$("#lblTransferenciaAutomatica").html(mTransferAutomatic);

				$("#lblDiaTransferencia").html(data.transfer_day);
				$("#dayForTransfer").val(data.transfer_day);

				$("#bank_code_id").val(data.bank_account.id);

			}
		});
	}

	$scope.buscaSaldoDetalhes = function (tipo) {
		$("#overlayDetalhes").show();
		$.ajax({
			dataType: "json",
			url: '/php/pagarme/buscaSaldoDetalhes.php',
			method: "POST",
			data: {
				tipo: tipo
			},
			success: function (data) {
				if (tipo == 1) {
					$("#boxResumoMovimentacao").removeClass("box-warning");
					$("#boxResumoMovimentacao").removeClass("box-info");
					$("#boxResumoMovimentacao").addClass("box-success");
				} else if (tipo == 2) {
					$("#boxResumoMovimentacao").removeClass("box-success");
					$("#boxResumoMovimentacao").removeClass("box-info");
					$("#boxResumoMovimentacao").addClass("box-warning");
				} else if (tipo == 3) {
					$("#boxResumoMovimentacao").removeClass("box-success");
					$("#boxResumoMovimentacao").removeClass("box-warning");
					$("#boxResumoMovimentacao").addClass("box-info");
				}

				$("#boxResumoMovimentacao").show();
				if (data.length > 0) {
					$(".btnPgSaldo").unbind("click");
					if (tipo == 3) {
						var html = '<table id="tbSaldoDetalhes" class="table table-striped">';
						html += "<thead><th>Data</th><th>Valor</th><th>Tipo</th><th>Status</th><th>Transferência</th></thead>";
						html += "<tbody>";

						for (var i = 0; i < data.length; i++) {
							var valor = data[i].amount;
							var type = data[i].type;
							var status = data[i].status;
							var dataCriado = data[i].date_created;
							var dataPag = data[i].funding_estimated_date;

							mDataCriado = moment(dataCriado).locale("pt-br").format("DD/MM/YYYY HH:mm");
							mDataPag = moment(dataPag).locale("pt-br").format("L");

							if (status == "pending_transfer") {
								mStatus = "Pendente";
								mStatusColor = "bg-yellow";

							} else if (status == "transferred") {
								mStatus = "Transferido";
								mStatusColor = "bg-green";
							} else if (status == "failed") {
								mStatus = "Falhou";
								mStatusColor = "bg-red";
							} else if (status == "processing") {
								mStatus = "Processando";
								mStatusColor = "bg-blue";
							} else if (status == "canceled") {
								mStatus = "Cancelado";
								mStatusColor = "bg-red";
							} else {
								mStatus = "Desconhecido";
								mStatusColor = "bg-red";
							}
							lblStatus = '<small class="label ' + mStatusColor + '">' + mStatus + '</small>';
							mType = type;
							html += "<tr>";
							html += "<td>" + mDataCriado + "</td>";
							html += "<td>" + formataDinheiro(valor) + "</td>";
							html += "<td>" + mType + "</td>";
							html += "<td>" + lblStatus + "</td>";
							html += "<td>" + mDataPag + "</td>";
							html += "</tr>";
						}

						html += "</tbody>";
						html += "</table>";
					} else {
						var html = '<table id="tbSaldoDetalhes" class="table table-striped">';
						html += "<thead><th>Data</th><th>Valor</th><th>Tipo</th><th>Status</th></thead>";
						html += "<tbody>";

						for (var i = 0; i < data.length; i++) {
							var valor = data[i].amount;
							var type = data[i].type;
							var status = data[i].status;
							var dataPag = data[i].payment_date;

							mDataPag = moment(dataPag).locale("pt-br").format("L");

							if (status == "paid") {
								mStatus = "Pago";
							} else {
								mStatus = "Aguardando Pagamento";
							}

							if (type == "credit") {
								mType = "Crédito";
							} else if (type == "refund") {
								mType = "Estorno";
							} else {
								mType = "Outro";
							}

							html += "<tr>";
							html += "<td>" + mDataPag + "</td>";
							html += "<td>" + formataDinheiro(valor) + "</td>";
							html += "<td>" + mType + "</td>";
							html += "<td>" + mStatus + "</td>";
							html += "</tr>";
						}

						html += "</tbody>";
						html += "</table>";
					}

					$("#divDetalhesSaldo").html(html);

					$("#tbSaldoDetalhes").dataTable({
						"ordering": false,
						"language": {
							"url": "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json"
						}
					});
					$compile($('#tbSaldoDetalhes'))($scope);
					$("#overlayDetalhes").hide();
				} else {
					var html = "<label>Nenhuma Movimentação</label>";
					$("#divDetalhesSaldo").html(html);
					$("#overlayDetalhes").hide();
				}
			},
			error: function () {
				$("#overlayDetalhes").hide();
			}
		});
	}

	$scope.abreModalRestagar = function () {
		$("#resgatarDisponivel-modal").modal();
	}


	function formataDinheiro(n2) {
		var n = n2 / 100;
		return "R$ " + n.toFixed(2).replace('.', ',').replace(/(\d)(?=(\d{3})+\,)/g, "$1.");
	}

	$("#btnDetalhesDisp").click(function () {
		$scope.buscaSaldoDetalhes(1);
	});

	$("#btnDetalhesWait").click(function () {
		$scope.buscaSaldoDetalhes(2);
	});

	$("#btnDetalhesTransfer").click(function () {
		$scope.buscaSaldoDetalhes(3);
	});

	$('#valorTransferir').keyup(function () {
		var valor = $('#valorTransferir').maskMoney('unmasked')[0];
		var valorDeSaida = (valor + $scope.taxaTransferencia) * 100;

		$("#lblATransferir").html(this.value);
		$("#lblValorSaida").html(formataDinheiro(valorDeSaida));
	});
	$("#carteiraDocumento").mask("000.000.000-00");

	$("#tipoConta").change(function () {
		$("#carteiraDocumento").val("");
		if (this.value == 1) {
			$("#carteiraDocumento").mask("000.000.000-00");
		} else {
			$("#carteiraDocumento").mask("00.000.000/0000-00");
		}
	});

	$("#transferirAutomatico").change(function () {

		if (this.value == "1") {
			$("#carteiraDia").prop("disabled", false);
			$("#carteiraDia").prop("required", true);
		} else {
			$("#carteiraDia").prop("disabled", true);
			$("#carteiraDia").prop("required", false);
		}
	});

	$scope.confirmaResgate = function () {
		var amount = ($('#valorTransferir').maskMoney('unmasked')[0] * 100);

		$.ajax({
			dataType: "json",
			url: '/php/pagarme/efetuaResgate.php',
			method: "POST",
			data: {
				amount: amount
			},
			success: function (data) {
				if (data.errors === undefined) {
					toastr.success("Transferência criada com sucesso.");
					$("#valorTransferir").val("");
					$scope.buscaSaldoCarteira();
					$("#btnDetalhesTransfer").click();
				} else {
					toastr.error(data.errors[0].message);
				}
			}
		});
	}

	$scope.mostraDetalhesTransaction = function (id) {

		$.ajax({
			dataType: "json",
			url: '/php/pagarme/buscaTransaction.php',
			method: "POST",
			data: {
				transaction: id
			},
			success: function (data) {
				if (data.object == "transaction") {
					$("#lblValorTransaction").html(formataDinheiro(data.paid_amount));
					$("#lblBandeiraCardTransaciton").html(data.card_brand.toUpperCase());
					$("#lblNomeCardTransaciton").html(data.card_holder_name);
					var card_first = data.card_first_digits;
					var card_last = data.card_last_digits;
					$("#lblNumeroCardTransaciton").html(card_first + "****" + card_last);
					if (data.status == "paid") {
						var status = "Pago";
					}

					$("#lblStatusTransaction").html(status);
					$("#dadosTransacao-modal").modal();

				}

			}
		});
	}

	//** Fim Pagamento Online ** //

	$scope.editarPerfil = function () {
		$('#perNome').val($scope.dadosPerfil.nome);
		$('#perCpf').val($scope.dadosPerfil.cpf);
		$('#perRg').val($scope.dadosPerfil.rg);
		$('#perEmail').val($scope.dadosPerfil.email);
		$('#perCelular').val($scope.dadosPerfil.celular);
		$('#perTelefone').val($scope.dadosPerfil.telefone);
		$('#perSexo').val($scope.dadosPerfil.sexo);
		$('#perDataNascimento').val($scope.dadosPerfil.data_nascimento);
		$('#perEndereco').val($scope.dadosPerfil.endereco);
		$('#perBairro').val($scope.dadosPerfil.bairro);

		$('#perEstado').val($scope.dadosPerfil.estcodigo);
		$('#perCep').val($scope.dadosPerfil.cep);

		$("#perCidade").empty();
		$.ajax({
			dataType: "html",
			url: '/pages/cadastros/buscaCidades.php',
			method: "POST",
			data: {
				estCodigo: $scope.dadosPerfil.estcodigo
			},
			success: function (data) {
				$("#perCidade").append(data);
				$("#perCidade").attr("disabled", false);
				$('#perCidade').val($scope.dadosPerfil.cidcodigo);
			}
		});
	}

	$("#hfDiaSemana").multiselect({
		checkboxName: 'hfDiaSemana[]',
		buttonText: function (options, select) {
			if (options.length === 0) {
				return 'Dia da Semana';
			} else {
				var labels = [];
				options.each(function () {
					if ($(this).attr('label') !== undefined) {
						labels.push($(this).attr('label'));
					} else {
						labels.push($(this).html());
					}
				});
				return labels.join(', ') + '';
			}
		}
	});

