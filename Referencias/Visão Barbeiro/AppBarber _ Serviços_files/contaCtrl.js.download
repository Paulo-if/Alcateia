	function carregaDadosSms() {
		if (typeof (tableRelatorioSMS) != "undefined") {
			tableRelatorioSMS.destroy();
		}

		tableRelatorioSMS = $('#tbRelatorioSMS').DataTable({
			"dom": 'T<"clear">lfrtip',
			"ajax": {
				"url": "/pages/cadastros/buscaDadosSMS.php",
				"method": "POST",
				"data": function (d) {
					d.tipo = 3;
					d.dataini = $("#DataIni").val();
					d.datafim = $("#DataFim").val();
				}
			},

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
