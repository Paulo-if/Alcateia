	$scope.buscaCodigoSite = function (tipo) {

		$.ajax({
			method: "POST",
			dataType: "html",
			url: '/pages/cadastros/buscaCodigoWidgetNewSites.php',
			data: {
				tipo: tipo,
				tipometodo: "1"
			},
			success: function (data) {
				if (tipo == '1') {
					$("#divCodigoSite").html(data);
				} else if (tipo == '2') {
					data = data + ' <button class="btn btn-xs btn-primary btnClipFacebook" data-clipboard-text="' + data + '" ><i class="fa fa-copy" alt="Copiar"></i> Copiar</button>';
					$("#divCodigoFacebook").html(data);
					var clipboard = new ClipboardJS('.btnClipFacebook');
					clipboard.on('success', function (e) {
						toastr.success("Copiado!");
					});
				} else if (tipo == '3') {
					data = data + ' <button class="btn btn-xs btn-primary btnClipInstagram" data-clipboard-text="' + data + '" ><i class="fa fa-copy" alt="Copiar"></i> Copiar</button>';
					$("#divCodigoInstagram").html(data);
					var clipboard = new ClipboardJS('.btnClipInstagram');
					clipboard.on('success', function (e) {
						toastr.success("Copiado!");
					});
				}  else if (tipo == '4') {

					var download = '';
					if (qrcode != undefined){
						qrcode.clear();
						qrcode.makeCode(data);
						document.getElementById("qrcode-agendamento").getElementsByTagName('img')[0].style.display = '';
					} else {

						qrcode = new QRCode(document.getElementById("qrcode-agendamento"), {
							text: data,
							width: 200,
							height: 200,
							colorDark : "#000000",
							colorLight : "#FFFFFF",
							correctLevel : QRCode.CorrectLevel.H
						});

						qrcode._oDrawing._fSuccess = function (){

							qrcode._el.getElementsByTagName('img')[0].style.display = '';
							 download = '<a href="'+ qrcode._el.getElementsByTagName('canvas')[0].toDataURL("image/png") +'" target="_blank" download="QRCodeAgendamento" class="btn btn-success btn-xs"><i class="fa fa-download" aria-hidden="true"></i> Baixar QRCode</a>';
							 $("#btnBaixarImagemQRCode").html(download);
							}


						}
						download = '<a href="'+ document.getElementById("qrcode-agendamento").getElementsByTagName('canvas')[0].toDataURL("image/png") +'" target="_blank" download="QRCodeAgendamento" class="btn btn-success btn-xs"><i class="fa fa-download" aria-hidden="true"></i> Baixar QRCode</a>';
						$("#btnBaixarImagemQRCode").html(download);

					var htmlData = '<a href="'+ data +'" target="_blank">' + data + '</a> <button class="btn btn-xs btn-primary btnClipLinkAgendamento" data-clipboard-text="' + data + '" ><i class="fa fa-copy" alt="Copiar"></i> Copiar</button>';

					$.ajax({
						dataType: "json",
						url: '/pages/cadastros/geraShortLinkAWS.php',
						method: "POST",
						data: {
							longlink: data,
							pesCodigo: $_CONFIG.CODESTABELECIMENTO,
							type: 2
						},
                  
						success: function (data) {
							var datahtmlshort = '<a href="'+ data.shortLink +'" target="_blank">' + data.shortLink + '</a> <button class="btn btn-xs btn-primary btnClipLinkAgendamento" data-clipboard-text="' + data.shortLink + '" ><i class="fa fa-copy" alt="Copiar"></i> Copiar</button>';
							$("#link-encurtado").html(datahtmlshort);
						}
					});

					$("#link-agendamento").html(htmlData);
					var clipboard = new ClipboardJS('.btnClipLinkAgendamento');
					clipboard.on('success', function (e) {
						toastr.success("Copiado!");
					});
				}

			}
		});
	}

