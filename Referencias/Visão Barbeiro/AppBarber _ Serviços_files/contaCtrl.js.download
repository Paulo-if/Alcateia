	$scope.buscaDadosRetencao = function () {
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/buscaDadosRetencao.php",
			dataType: "json",
			success: function (data) {
				const apiResponse = data.data || data;
				if (!apiResponse.error && apiResponse.reports && apiResponse.reports.length > 0) {
					const report = apiResponse.reports[0];
					const html = `
							<div style="padding: 10px 0 0 0;">

								<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">

									<div style="background: #f7f9fc; border-radius: 10px; padding: 15px;">
										<div style="font-size: 22px;">👥</div>
										<div style="font-size: 22px; font-weight: bold; color: #2c3e50;">${report.total_clients}</div>
										<div style="font-size: 13px; color: #7f8c8d;">Clientes atendidos</div>
									</div>

									<div style="background: #f7f9fc; border-radius: 10px; padding: 15px;">
										<div style="font-size: 22px;"> ⭐ </div>
										<div style="font-size: 22px; font-weight: bold; color: #2c3e50;">${report.avarage_rating}</div>
										<div style="font-size: 13px; color: #7f8c8d;">Avaliação média dos seus clientes</div>
									</div>

									<div style="background: #f7f9fc; border-radius: 10px; padding: 15px;">
										<div style="font-size: 22px;">📅</div>
										<div style="font-size: 22px; font-weight: bold; color: #2c3e50;">${report.total_services}</div>
										<div style="font-size: 13px; color: #7f8c8d;">Agendamentos realizados</div>
									</div>

									<div style="background: #f7f9fc; border-radius: 10px; padding: 15px;">
										<div style="font-size: 22px;">💰</div>
										<div style="font-size: 22px; font-weight: bold; color: #27ae60;">${report.total_service_value}</div>
										<div style="font-size: 13px; color: #7f8c8d;">Faturamento de serviços</div>
									</div>

								</div>

								<div style="margin-top: 20px; background: #fff4e5; border-radius: 10px; padding: 15px; text-align: center;">
									<div style="font-size: 20px;" > ✨ </div>
									<div style="font-size: 26px; font-weight: bold; color: #f39c12;">${report.new_clients} </div>
									<div style = "font-size: 13px; color: #7f8c8d;"> Novos clientes atendidos </div>
								</div>

								<div style="margin-top: 20px; text-align: center; font-size: 14px; color: #555;">
									Você construiu tudo isso com a gente. Tem certeza que quer prosseguir com o cancelamento?
								</div>

							</div>
							`;
					$("#retencaoCliente-conteudo").html(html);
				} else {
					$("#retencaoCliente-conteudo").html('<p>Não foi possível carregar os dados. Tente novamente.</p>');
				}
			},
			error: function () {
				$("#retencaoCliente-conteudo").html('<p>Erro ao carregar dados de retenção.</p>');
			}
		});
	};

	$('#retencaoCliente-modal').on('show.bs.modal', function () {
