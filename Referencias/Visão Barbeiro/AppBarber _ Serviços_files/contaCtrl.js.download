	function buscaCEP(cep) {
		if (cep && cep.length >= 9) {
			cep = cep.replace("-", "");

			$.ajax({
				dataType: "json",
				url: "http://cep.correiocontrol.com.br/" + cep + ".json",
				method: "GET",
				success: function (data) {
					$(".loader").show();

					$("#perEstado").val(1);
					$("#perEstado").val($("#" + data.uf + "").val())
					$("#perCidade").empty();
					$.ajax({
						dataType: "html",
						url: '/pages/cadastros/buscaCidades.php',
						method: "POST",
						data: {
							estCodigo: $("#" + data.uf + "").val(),
							cidNome: data.localidade
						},
						success: function (data) {
							$("#perCidade").append(data);
							$("#perCidade").attr("disabled", false);
						}
					});
					$("#perBairro").val(data.bairro);
					$("#perEndereco").val(data.logradouro);
					$("#perCidade").val(data.localidade);
				}
			});
			$(".loader").hide();
		}
	};

	$('#formInsereImagem').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		var dados = new FormData(this);
		dados.append("blob", mBlob);
		dados.delete("pimimagem");
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/inserePessoaImagem.php",
			data: dados,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.result[0].erro == "0") {
                    $scope.mostrarMensagemSucessoPerfil();
					$("#atualizaInfo").click()
					$("#divimg").html("");
					$("#imagemCutAll").cropper("destroy");
					$scope.buscapessoaimagem();
				} else {
					swal(result.result[0].resultado, "", "error");
				}
				showLoader(false);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});

		return true;
	});

