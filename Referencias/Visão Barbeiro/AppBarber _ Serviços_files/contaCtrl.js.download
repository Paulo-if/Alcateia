	$scope.buscapessoaimagem = function () {

		var htmlimg = "";
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/buscaPessoaImagem.php",
			data: {
				tipo: "1"
			},
			dataType: "json",
			success: function (result) {
				for (var i = 0; i < result.result.length; i++) {
					htmlimg += "<div class='col-sm-2 margin'  ng-click='alteraPessoaImagem(" + result.result[i].PIm_Codigo + ")' ><img  src='" + result.result[i].PIm_Imagem + "'  name=" + result.result[i].PIm_Codigo + "  id=" + result.result[i].PIm_Codigo + "  width='80' style='cursor:pointer;'></div>";
				}
				$("#divimg").html(htmlimg);
				$compile($('#divimg'))($scope);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	}

