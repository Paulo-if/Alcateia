	function getCheckoutUrl(hash) {
		var system = "appbarber";
		if (typeof $Options !== "undefined" && $Options.sistema) {
			system = $Options.sistema;
		} else if (typeof sSistema !== "undefined" && sSistema) {
			system = sSistema;
		}

		return "https://checkout." + system.toLowerCase() + ".com.br/?hash=" + hash;
	}

	function showCheckoutLink(link) {
		swal({
			title: "<strong>Link de Pagamento</strong>",
			text: '\
				Acesse o <b>link de pagamento</b> para concluir o pagamento via PIX.<br><br>\
				<a id="btnOpenCheckout" target="_blank" href="' + link + '" autofocus>' + link + '</a><br><br>\
				',
			type: "info",
			showCancelButton: true,
			cancelButtonColor: "#d33",
			confirmButtonColor: "#00796B",
			confirmButtonText: "Abrir Checkout",
			cancelButtonText: "Fechar",
			closeOnConfirm: false,
			closeOnCancel: true,
			html: true,
			animation: "slide-from-top"
		},
		function (isConfirm) {
			if (isConfirm) {
				var linkElement = document.createElement("a");
				linkElement.href = link;
				linkElement.target = "_blank";
				linkElement.rel = "noopener noreferrer";
				document.body.appendChild(linkElement);
				linkElement.click();
				document.body.removeChild(linkElement);
			}
		});
	}

	$scope.geraCheckoutPixBoletoNF = function(data) {
		var valorCentavos = data.PNF_Valor;
		var codigoProduto = data.CodigoProduto;
		var tipoProduto = data.TipoProduto;

		if (!valorCentavos || !codigoProduto || !tipoProduto || !data.Pes_Codigo || !data.PNC_Codigo) {
			swal("Ops!", "Dados insuficientes para gerar o checkout PIX.", "error");
			return;
		}

		var metadata = {
			slip_type: "1",
			slip_descrption: "fiscal_payment",
			establishment_code: data.Pes_Codigo,
			external_code: data.PNC_Codigo,
			type: "pix",
			pescodigo: data.Pes_Codigo,
			sessionid: "",
			pix_monthly: false,
			pagarme_invoice: "",
			migration: false,
			needNextBoleto: false
		};

		showLoader(true);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/CHECKOUT_Create.php",
			dataType: "json",
			data: {
				type: 9,
				establishment: data.Pes_Codigo,
				value: valorCentavos,
				installments: 1,
				payment_type: "pix",
				product_code: codigoProduto,
				product_type: tipoProduto,
				plan: "",
				origin: 2,
				metadata: JSON.stringify(metadata)
			},
			success: function (result) {
				showLoader(false);
				var checkout = result && result.data && result.data.checkout && result.data.checkout[0] ? result.data.checkout[0] : null;

				if (result && result.data && result.data.error === true) {
					toastr.error(result.data.message || "Falha ao gerar checkout PIX.");
					return;
				}

				if (!checkout || checkout.error != 0 || !checkout.hash_code) {
					toastr.error((checkout && checkout.result) ? checkout.result : "Falha ao gerar checkout PIX.");
					return;
				}

				showCheckoutLink(getCheckoutUrl(checkout.hash_code));
			},
			error: function () {
				showLoader(false);
				swal("Falha na conexão.", "", "error");
			}
		});
	}

	$scope.buscaListaBoletosNF = function(pescodigo,numboletos){
		if (typeof (optTabelalistaBoletoNF) != "undefined") {
			$('#tbBoletosNF tbody').unbind('click')
			optTabelalistaBoletoNF.destroy();
		}

		optTabelalistaBoletoNF = $('#tbBoletosNF').DataTable({
			"dom": 'T<"clear">lfrtip',
			"ajax": {
				"url": "/pages/cadastros/buscaBoletosNF.php",
				"method": "POST",
				"data": function (d) {
					d.tipo = 6;
					d.pescodigo = pescodigo,
					d.numboletos = numboletos
				}
			},

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,

			"columns": [
				{
					"data": "BNF_Data_Boleto",
					"title": "Data do boleto",
					"width": "70%"
				},

				{
					"class": 'verboletos',
					"width": "12%",
					"orderable": false,
					"data": null,
					"defaultContent": '<button class="btn btn-success btn-xs" title="Ver boleto"><i class="fa fa-barcode"></i> Boleto</button>',
				},
				{
					"class": 'verpix',
					"width": "8%",
					"orderable": false,
					"data": null,
					"render": function (data, type, row) {
						if (row.BNF_Pago == 1 || row.BNF_Pago == "1") {
							return "";
						}

						return '<button class="btn btn-primary btn-xs" title="Pagar com PIX"><i class="fa fa-qrcode"></i> Pix</button>';
					}
				},
				{
                    "data": "BNF_Pago",
                    "title": "Pago",
					"width": "5%",
                    "render": function (data, type, row) {
						if(data == 1){
							return `<i class="fa fa-check-circle" style="color:green"></i>`
						}else{
							return ``
						}
                    }
                },
			],

			"ordering": false,

			"language": {
				"url": "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json"
			}
		});

		$('#tbBoletosNF tbody').on('click', 'td.verboletos', function () {
			var tr = $(this).closest('tr');
			var row = optTabelalistaBoletoNF.row(tr);
			var data = row.data();
			window.open(data.url, '_blank').focus();
		});

		$('#tbBoletosNF tbody').on('click', 'td.verpix', function () {
			var tr = $(this).closest('tr');
			var row = optTabelalistaBoletoNF.row(tr);
			var data = row.data();
			$scope.geraCheckoutPixBoletoNF(data);
		});
		resizeContent()

		$("#boletosNF-modal").modal()
	}

	$scope.geraQRCodeAppCli = function(link){
		
		link = `${$scope.siteSistema}/${link}`;

		var download = '';
		if (qrcode != undefined){
			qrcode.clear();
			qrcode.makeCode(link);
			document.getElementById("qrcode-app").getElementsByTagName('img')[0].style.display = '';
		} else {

			qrcode = new QRCode(document.getElementById("qrcode-app"), {
				text: link,
				width: 200,
				height: 200,
				colorDark : "#000000",
				colorLight : "#FFFFFF",
				correctLevel : QRCode.CorrectLevel.H
			});

			qrcode._oDrawing._fSuccess = function (){

				qrcode._el.getElementsByTagName('img')[0].style.display = '';
					download = '<a href="'+ qrcode._el.getElementsByTagName('canvas')[0].toDataURL("image/png") +'" target="_blank" download="QRCodeApp" class="btn btn-success btn-xs"><i class="fa fa-download" aria-hidden="true"></i> Baixar QRCode</a>';
					$("#btnBaixarImagemQRCodeApp").html(download);
				}
			}
			download = '<a href="'+ document.getElementById("qrcode-app").getElementsByTagName('canvas')[0].toDataURL("image/png") +'" target="_blank" download="QRCodeApp" class="btn btn-success btn-xs"><i class="fa fa-download" aria-hidden="true"></i> Baixar QRCode</a>';
			$("#btnBaixarImagemQRCodeApp").html(download);
			$("#widget-qrcodigoapp-modal").modal()
	}

	$scope.buscaPessoaImagemPrime = function () {

		var htmlimg = "";
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/IMAGEM_PRIME_Busca.php",
			data: {
				tipo: "1"
			},
			dataType: "json",
			success: function (result) {
				if(result.data.error == false){
					for (var i = 0; i < result.data.prime_image.length; i++) {
						htmlimg += `<div class='col-sm-2 margin'><img ng-click="openImagePrime('${result.data.prime_image[i].prime_image_link}',${result.data.prime_image[i].prime_image_code})" src='${result.data.prime_image[i].prime_image_link}'  name='${result.data.prime_image[i].prime_image_code}'  id="${result.data.prime_image[i].prime_image_code}"  width='80' style='cursor:pointer;'></div>`;
					}
					$("#divimgPrime").html(htmlimg);
					$compile($('#divimgPrime'))($scope);
				}
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	}

