	$('#btnContinuarCancelamento').on('click', function () {
		$('#retencaoCliente-modal').modal('hide');
		setTimeout(function() {
			$("#cancelaPlano-modal").modal('show');
			// Limpa os campos do modal de cancelamento
			$("#ConfirmaCancelamento").val("");
			$("#motivoCancelamento").val("");
		}, 300);
	});

	$("#cancelaPlano").click(() => {
		showLoader(true);
		if ($("#ConfirmaCancelamento").val().trim() == "") {
			showLoader(false);
			swal("Informe a senha do usuário.", "", "error");
		} else if ($("#motivoCancelamento").val().trim() != "" && $("#motivoCancelamento").val().trim().length < 20) {
			swal("O motivo precisa ter no mínimo de 20 caracteres.", "", "error");
		} else if ($("#motivoCancelamento").val().trim() != "" && $("#motivoCancelamento").val().trim().includes("@")) {
			swal("Não é possível informar o e-mail no motivo", "", "error");
		} else if ($("#motivoCancelamento").val().trim() != "" && $("#ConfirmaCancelamento").val().trim() != "") {
			var idPagarme = "";
			var tipoPlan = "";
			if (tabelaDadosConta.fnGetData(0) != null) {
				idPagarme = tabelaDadosConta.fnGetData(0).IDPM;
				tipoPlan = tabelaDadosConta.fnGetData(0).TipoAssinatura;
			}

			var cancelouPlano = false;

			$.ajax({
				type: "POST",
				url: "/php/cancelarPagarme.php",
				data: {
					idpm: idPagarme,
					tipoPlan: tipoPlan,
					senhausuario: $("#ConfirmaCancelamento").val()
				},
				dataType: "json",
				success: function (result) {

					if (result.erro == "0") {
						cancelouPlano = true;
					} else if (result.erro == "2") {
						swal("Senha inválida.", "", "error");
						showLoader(false);
						cancelouPlano = false;
						// encerra a função e não prossegue
						return;
					} else {
						cancelouPlano = false;
					}

					if (cancelouPlano) {
						var pescodigo = mPesCodigo;
						$.ajax({
							type: "POST",
							url: "/pages/cadastros/atualizaPessoaFinanceiro.php",
							data: {
								pescodigo: pescodigo,
								motivo: $("#motivoCancelamento").val()
							},
							dataType: "json",
							success: function (result) {
								if (result.result.length == 0) {
									if (result.erro == "0") {
										$("#cancelaPlano-modal").modal("hide");
										showLoader(false);

										$.ajax({
											type: "POST",
											url: "/php/logout.php",
											success: function (result) {
												document.write(result);
											}
										});
									} else {
										swal("", result.resultado, "error");
										showLoader(false);
									}
								}
								else{
									if(result.result[0].erro == 0){
										$("#cancelaPlano-modal").modal("hide");
										showLoader(false);

										$.ajax({
											type: "POST",
											url: "/php/logout.php",
											success: function (result) {
												document.write(result);
											}
										});
									}else{
										swal("", result.result[0].resultado, "error");
										showLoader(false);
									}
								}
							},
							error: function (result) {
								swal("Falha na conexão.", "", "error");
								showLoader(false);
							}
						});
					}else{
						showLoader(false);
						swal("Ocorreu um erro inesperado ao cancelar o seu plano, entre em contato com o suporte técnico.", "", "error");
					}
				},
				error: function (result) {
					cancelouPlano = false;
					swal("Falha na conexão.", "", "error");
					showLoader(false);
				}
			});



		} else {
			showLoader(false);
			swal("Informe o motivo.", "", "error");
		}

	});

