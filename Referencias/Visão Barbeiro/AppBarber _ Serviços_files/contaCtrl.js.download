	var delayTimerToken;
	var nomeRevendaToken = "";

	function doTokenSearch(text) {
		clearTimeout(delayTimerToken);
		delayTimerToken = setTimeout(function () {
			if (text.length > 0) {
				$http.get(localStorage.getItem("host") + '?metodo=buscaTokenRevendedor&token=' + text + '&id=' + $scope.idCliente).
				success(function (data, status, headers, config) {
					if (data.result[0].erro == "0") {
						nomeRevendaToken = data.result[0].Nome;
						$("#msgTokenRevendaError").html(data.result[0].resultado);
						$("#tokenRevenda").parent().addClass("has-success");
						$("#msgTokenRevendaError").show();
					} else {
						$("#msgTokenRevendaError").html(data.result[0].resultado);
						$("#tokenRevenda").parent().addClass("has-error");
						$("#msgTokenRevendaError").show();
					}
				});
			}
		}, 500);
	}

	$("#tokenRevenda").keyup(function () {
		$("#msgTokenRevendaError").html("");
		$("#tokenRevenda").parent().removeClass("has-error");
		$("#tokenRevenda").parent().removeClass("has-success");
		$("#msgTokenRevendaError").hide();
		doTokenSearch(this.value);
	});

	$("#formTokenRevenda").submit(function (e) {
		e.preventDefault();
		if ($("#tokenRevenda").parent().hasClass("has-success")) {
			$http.get(localStorage.getItem("host") + '?metodo=insereTokenRevendedor&token=' + $("#tokenRevenda").val() + '&id=' + $scope.idCliente).
			success(function (data, status, headers, config) {
				if (data.result[0].erro == "0") {
					toastr.success(data.result[0].resultado);
					$("#txtNomeRevendedor").html(nomeRevendaToken);
					$("#txtTokenRevendedor").html($("#tokenRevenda").val());

					$("#msgTokenRevendaError").html("");
					$("#tokenRevenda").parent().removeClass("has-error");
					$("#msgTokenRevendaError").hide();
					$("#tokenRevenda").val("");

					$("#formTokenRevenda").hide();
					$("#divRevendedor").show();

				} else {
					swal(data.result[0].resultado, "", "error");
				}
			});
		} else {
			if ($("#tokenRevenda").val().length == 0) {
				$("#msgTokenRevendaError").html("Insira um token válido.");
				$("#tokenRevenda").parent().addClass("has-error");
				$("#msgTokenRevendaError").show();
			}
		}
	});



