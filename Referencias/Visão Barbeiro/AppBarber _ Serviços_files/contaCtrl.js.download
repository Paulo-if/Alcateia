	$scope.buscaSaldoLift = function () {
		$.ajax({
			dataType: 'json',
			url: localStorage.getItem('host'),
			async: false,
			data: {
				metodo: 'buscaParametro',
				id: $scope.idCliente,
				parcodigo: 168
			},
			success: function (data) {
				if (data.result.length > 0) {
					if (data.result[0].PVa_Vlr_Principal != '' && data.result[0].PVa_Vlr_Principal != undefined) {
/*------------------------------------------------------------------------------------------------------------------------------------------------------------------------------*/
						$.ajax({
							type: "POST",
							url: "/pages/cadastros/buscaCreditosBot_Lift.php",
							data: {
								idlift:data.result[0].PVa_Vlr_Principal
							},
							dataType: "json",
							success: function (result) {
								if (result.data.botId != '' && result.data.botId != undefined) {
									$("#lblSaldoWhatsBot").html(result.data.passiveSessions);
									$("#lblSaldoWhatsBot2").html(result.data.marketingSessions);
									$scope.buscaHistoricoBot()
								}else{
									$("#lblSaldoWhatsBot").html('0')
									$("#lblSaldoWhatsBot2").html('0')
								}
							},
							error: function (result) {
								$("#lblSaldoWhatsBot").html('0')
								$("#lblSaldoWhatsBot2").html('0')
							}
						});

/*------------------------------------------------------------------------------------------------------------------------------------------------------------------------------*/
						
					} else {
						$("#tabshowbot").remove()
					}
				} else {
					
				}
			}
		});
	}

	
	$scope.buscaHistoricoBot = function () {
		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/buscaPessoaBot.php',
			method: "POST",
			data: {
				tipo:1,
				dataini:'',
				datafim:'',
				fornecedor:''
			},
			success: function (data) {

				var html = "";
				if (data.data.length > 0) {
					html += '<ul class="timeline">';
					for (var i = 0; i < data.data.length; i++) {

						valores = data.data[i];

						var horario = valores.PBF_Dat_Compra.split(" ");
						var usuario = valores.Usu_Nome;
						var valor = valores.PBF_Valor;
						var status = valores.BotStatus;
						var dataExp = valores.PBF_Dat_Expiracao;
						var dataPag = valores.PBF_Dat_Pagamento;
						var qtd = valores.PBF_Qtd_Compra;
						var codStatus = valores.PBF_Status;
						var linkNota = ''; // valores.PNo_Link_PDF;
						var botaoNota= '';
						if(linkNota != ''){
							botaoNota = `<a class="btn btn-xs btn-warning" href="${linkNota}" target="_blank" style="margin-left:10px;"> <i class="fa fa-file-pdf-o" aria-hidden="true"></i> Nota</a>`
						}


						if (codStatus == '1') {
							statusCor = 'bg-green';
							statusIcon = 'ion ion-checkmark-round';
						} else if (codStatus == '0') {
							statusCor = 'bg-blue';
							statusIcon = 'ion ion-clock';
						} else {
							statusCor = 'bg-red';
							statusIcon = 'ion ion-close-round';
						}

						html += '<li class="time-label">';
						html += '<span class="' + statusCor + '">';
						html += horario[0];
						html += '</span></li>';
						html += '<li>';
						html += '<i class="ion ' + statusIcon + ' ' + statusCor + '"></i>';
						html += '<div class="timeline-item">';
						html += '<span class="time"><i class="fa fa-clock-o"></i> ' + horario[1] + '</span>';
						html += '<h3 class="timeline-header">Compra de ' + qtd + ' Sessõe(s)</h3>';
						html += '<div class="timeline-body">';
						html += '<p>Realizada por: ' + usuario + '</p>';
						html += '<p>Valor: ' + valor + '</p>';

						if (codStatus != '0') {
							html += '<p>Data do Pagamento: ' + dataPag + '</p>';
						}

						html += '<small class="label ' + statusCor + '">' + status + '</small>' + botaoNota;
						html += '</div>';
						if (codStatus == '1') {
							html += '<div class="timeline-footer">';
							html += 'Expira em: ' + dataExp;
							html += '</div>';
						}
						html += '</div>';
						html += '</li>';
					}
					html += '</ul>';

				} else {
					html += '<div class="callout callout-info">';
					html += '<h4>Você ainda não possui nenhum histórico de compra.</h4>';
					html += '<p>Clique em "Comprar Créditos do ChatBot" para efetuar uma compra de créditos.</p>';
					html += '</div>';
				}
				$("#timelineBot").html(html);
			}
		});
	}

