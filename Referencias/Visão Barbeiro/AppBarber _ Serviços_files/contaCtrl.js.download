	$("#btnNovoRenovarPlano").click(function () {

		if ($("input[name=cbPlano]:checked").length > 0) {
			var planoSelecionado = $("input[name=cbPlano]:checked").get(0);
			$("#resDescrRenovar").html(planoSelecionado.dataset.sistema);
			$("#resQtdProfRenovar").html(planoSelecionado.dataset.numprof);
			$("#resPlanoRenovar").html(planoSelecionado.dataset.periodo);
			$("#resValorRenovar").html(planoSelecionado.dataset.valor);
			$("#resDiasRenovar").html(planoSelecionado.dataset.dias);
			$("#resTokenRenovar").html($("#edtToken").val());
			$("#renovar-modal").modal("hide");

			valor = planoSelecionado.dataset.valor.replace(",", ".");
			var htmlParcelas = "";
			var numeroDeParcelas = 1;
			var hasPixOptions = false;

			if (planoSelecionado.dataset.periodo == "Semestral") {
				numeroDeParcelas = 6;
				hasPixOptions = true;
			} else if (planoSelecionado.dataset.periodo == "Anual") {
				numeroDeParcelas = 12;
				hasPixOptions = true;
			}

			for (var i = 1; i <= numeroDeParcelas; i++) {
				var valorparcela = valor / i;
				var valorparcelatext = parseFloat(valorparcela).formatMoney().replace(".", ",");
				var option = "<option value='" + i + "'>" + i + "x de R$ " + valorparcelatext + "</option>";
				htmlParcelas += option;
			}
			$("#numParcelasRenovar").html(htmlParcelas);

			if (hasPixOptions){
				$("#checkboxPIXRenovar").hide();
				$("#hrCheckboxPIXRenovar").hide();
			} else {
				$("#checkboxPIXRenovar").hide();
				$("#hrCheckboxPIRenovar").hide();
			}

			$("#confirmaRenovar-modal").modal();
		} else {
			swal("Selecione um Plano.", "", "error");
		}
	});

	$("#btnVoltarPlanoRenovar").click(function () {
		$("#confirmaRenovar-modal").modal("hide");
		$("#renovar-modal").modal("show");
	});

	$("#btnFecharRenovar").click(function () {
		$("input[name=cbPlano]").iCheck('uncheck');
	});

	$("#btnEfetuaPagamentoRenovar").click(function () {

		if ($_CONFIG.PAIS == "1") {
			var cpfcnpjText = $("#document_number_empresaRenovar").val().replaceAll(".", "").replaceAll("-", "").replaceAll("/", "");
		}

		if ($("input[name=tipoPgtoRenovar]:checked").get(0) == null) {
			swal("Insira um Método de Pagamento", "", "error");
		} else if ($_CONFIG.PAIS == "1" && cpfcnpjText == "") {
			swal("Informe o CPF ou o CNPJ", "", "error");
		} else if (($_CONFIG.PAIS == "1") && (cpfcnpjText.length != 14) && (cpfcnpjText.length != 11)) {
			swal("Informe um CPF ou o CNPJ válido", "", "error");
		} else if (($_CONFIG.PAIS == "1") && (cpfcnpjText.length == 14) && (!validarCNPJ(cpfcnpjText))) {
			swal("Informe um CNPJ válido", "", "error");
		} else if (($_CONFIG.PAIS == "1") && (cpfcnpjText.length == 11) && (!validarCPF(cpfcnpjText))) {
			swal("Informe um CPF válido", "", "error");
		} else if (!$("#condusoRenovar").get(0).checked) {
			swal("Você precisa aceitar o termo de condição de uso", "", "error");
		} else {

			var card_number = "";
			var card_holder_name = "";
			var card_expiration_month = "";
			var card_expiration_year = "";
			var card_cvv = "";
			var mCardHash = "";

			var planoSelecionado = $("input[name=cbPlano]:checked").get(0);
			var tipoPagSelecionado = $("input[name=tipoPgtoRenovar]:checked").get(0);

			var tipoPgto = "";

			if ($_CONFIG.PAIS == "1") {
				var cpfcnpj = cpfcnpjText;
			} else {
				var cpfcnpj = "";
			}

			if (tipoPagSelecionado.value == "1") {
				tipoPgto = "Boleto";
			} else if (tipoPagSelecionado.value == "2") {
				tipoPgto = "Cartão de Crédito";

				card_number = $("#card_numberRenovar").val();
				card_holder_name = $("#card_holder_nameRenovar").val();
				card_expiration_month = $("#card_expiration_monthRenovar").val();
				card_expiration_year = $("#card_expiration_yearRenovar").val();
				card_cvv = $("#card_cvvRenovar").val();

				var form = $("#payment_formRenovar");

				PagarMe.encryption_key = "ek_live_tOKDSJzPURbYjTNd3CAGwQD1nTL0wV";

				var creditCard = new PagarMe.creditCard();
				creditCard.cardHolderName = card_holder_name;
				creditCard.cardExpirationMonth = card_expiration_month;
				creditCard.cardExpirationYear = card_expiration_year;
				creditCard.cardNumber = card_number;
				creditCard.cardCVV = card_cvv;

				// pega os erros de validação nos campos do form
				var fieldErrors = creditCard.fieldErrors();

				//Verifica se há erros
				var hasErrors = false;
				for (var field in fieldErrors) {
					hasErrors = true;
					break;
				}

				if (hasErrors) {

					if (fieldErrors.card_number) {
						swal("Erro no Cartão", fieldErrors.card_number, "error");
					}else if (fieldErrors.card_holder_name) {
						swal("Erro no Cartão", fieldErrors.card_holder_name, "error");
					}else if (fieldErrors.card_expiration_month) {
						swal("Erro no Cartão", fieldErrors.card_expiration_month, "error");
					}else if (fieldErrors.card_expiration_year) {
						swal("Erro no Cartão", fieldErrors.card_expiration_year, "error");
					}else if (fieldErrors.card_cvv) {
						swal("Erro no Cartão", fieldErrors.card_cvv, "error");
					}else{
						swal("Erro no Cartão", "Entre em contato com a equipe de suporte","error")
					}

				} else {
					// se não há erros, gera o card_hash...
					creditCard.generateHash(function (cardHash) {
						mCardHash = cardHash;

						form.append($('<input type="hidden" id="card_hashRenovar" name="card_hashRenovar">').val(cardHash));
					});
				}
			} else if (tipoPagSelecionado.value == "3" && planoSelecionado.dataset.periodo == "Mensal"){
				toastr.error("Não é possível pagamento do plano mensal por PIX. Escolha outra forma de pagamento.")
				var hasErrors = true;
			}  else if (tipoPagSelecionado.value == "3"){
				tipoPgto = "Pix";
				var hasErrors = false;
			}

			if (!hasErrors) {
				$.ajax({
					dataType: "json",
					method: "GET",
					url: host,
					data: {
						metodo: "buscaPessoa",
						tipo: "2",
						id: $scope.idCliente
					},
					success: function (data) {
						if (data.buscaPessoa.length > 0) {
							var html = '<table class="table table-condensed table-hover">';
							html += '<tr height="5"><th style="width:30%"><h5>Plano:</h5></th><td><h5>' + planoSelecionado.dataset.sistema + '</h5></td></tr>';
							html += '<tr height="5"><th><h5>N. Profissionais:</h5></th><td><h5>' + planoSelecionado.dataset.numprof + '</h5></td></tr>';
							html += '<tr height="5"><th><h5>Período:</h5></th><td><h5>' + planoSelecionado.dataset.periodo + '</h5></td></tr>';
							html += '<tr height="5"><th><h5>Valor:</h5></th><td><h5>' + planoSelecionado.dataset.valor + '</h5></td></tr>';
							html += '<tr height="5"><th><h5>Tipo Pagamento:</h5></th><td><h5>' + tipoPgto + '</h5></td></tr>';
							if (planoSelecionado.dataset.parcelado == "1") {
								html += '<tr height="5"><th><h5>N° Parcelas:</h5></th><td><h5>' + $("#numParcelasRenovar option:selected").text() + '</h5></td></tr>';
							}
							html += '</table>';
							console.log('');
							swal({
									title: "",
									text: html,
									html: true,
									showCancelButton: true,
									confirmButtonColor: "#00796B",
									confirmButtonText: "Confirmar",
									cancelButtonText: "Cancelar",
									closeOnConfirm: true,
									closeOnCancel: true
								},
								function (isConfirmed) {
									if (isConfirmed) {
										showLoader(true);
										$.ajax({
											dataType: "json",
											method: "POST",
											url: "/php/alterarPagamentoPM.php",
											data: {
												descricao: planoSelecionado.dataset.sistema,
												numProf: planoSelecionado.dataset.numprof,
												plano: planoSelecionado.dataset.periodo,
												valor: planoSelecionado.dataset.valor,
												placodigo: planoSelecionado.value,
												token: $("#tokenPlano").val(),
												dias: $("#resDiasRenovar").val(),
												IDPM: $("#resIDPMRenovar").val(),
												codExterno: $("#codigoexterno").val(),
												id: $("#id").val(),
												nomeempresa: data.buscaPessoa[0].Nome,
												email: data.buscaPessoa[0].Email,
												telefone: data.buscaPessoa[0].Telefone,
												cnpj: cpfcnpj,
												tipoPgto: tipoPagSelecionado.value,
												planoPM: planoSelecionado.dataset.plano,
												numParcelas: $("#numParcelasRenovar option:selected").val(),
												parcelado: planoSelecionado.dataset.parcelado,
												cardHash: mCardHash,
												codigo: $("#resCodigoRenovar").val(),
												tipoAssinatura: $("#resTipoAssinaturaRenovar").val(),
												tipoPagamento: $("#resTipoPagamentoRenovar").val()
											},
											success: function (data) {
												if (data.erro == 1) {
													swal("", data.resultado, "error");
												} else {
													if (tipoPagSelecionado.value == "3"){

														$App.showPIXModal(planoSelecionado.dataset.valor, data.resultado, 2, data.codexterno);

													} else {
														swal({
															title: "",
															text: data.resultado,
															html: true,
															type: "success"
														},
														function () {
															window.location.assign("/index.php");
														});
													}

												}
												showLoader(false);
											},
											error: function (data) {
												showLoader(false);

											}
										});
									}
								});
						} else {
							swal("Falha ao buscar dados da Empresa. Preencha o Perfil.", "", "error");
						}
					}
				});
			}
		}
	});

	function showLoader(show) {
		if (show) {
			$("#loader").show();
			loaderDiv = new ajaxLoader($('body'));
		} else {
			loaderDiv.remove();
		}
	}

	function ajaxLoader(el, options) {
		var defaults = {
			bgColor: '#fff',
			duration: 800,
			opacity: 0.7,
			classOveride: false
		}
		this.options = jQuery.extend(defaults, options);
		this.container = $(el);

		this.init = function () {
			var container = this.container;
			this.remove();
			var overlay = $('<div></div>').css({
				'background-color': this.options.bgColor,
				'opacity': this.options.opacity,
				'width': container.width(),
				'height': container.height(),
				'position': 'absolute',
				'top': '0px',
				'left': '0px',
				'z-index': 99999
			}).addClass('ajax_overlay');
			if (this.options.classOveride) {
				overlay.addClass(this.options.classOveride);
			}
			container.append(
				overlay.append(
					$('<div></div>').addClass('ajax_loader')
				).fadeIn(this.options.duration)
			);
		};

		this.remove = function () {
			var overlay = this.container.children(".ajax_overlay");
			if (overlay.length) {
				overlay.fadeOut(this.options.classOveride, function () {
					overlay.remove();
				});
			}
		}
		this.init();
	}

