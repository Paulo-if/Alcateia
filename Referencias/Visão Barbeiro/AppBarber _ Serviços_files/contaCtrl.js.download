	$("#empEstado").change(function () {
		var estado = this.value;
		$("#empCidade").empty();
		if (estado === -1) {
			$("#empCidade").attr("disabled", true);
		} else if (estado == "") {
			$("#empCidade").attr("disabled", true);
		} else {
			$.ajax({
				dataType: "html",
				url: '/pages/cadastros/buscaCidades.php',
				method: "POST",
				data: {
					estCodigo: estado
				},
				success: function (data) {

					if (data.includes('option') == true) {
						$("#empCidade").append(data);
						$("#empCidade").attr("disabled", false);
					} else {
						toastr.warning('Nenhuma cidade disponível para esse estado no momento');
						$("#empEstado").val("")
						$("#empCidade").attr("disabled", true);
					}
				}
			});
		}
	});

	$scope.buscaLatLong = function () {
		var Endereco = $("#empEndereco").val();
		var Cidade = $("#empCidade option:selected").text();
		var Estado = $("#empEstado option:selected").text();
		var Bairro = $("#empBairro").val();
		var Numero = $("#empNumero").val();

		var url = "https://maps.googleapis.com/maps/api/geocode/json?";
		url += "key=AIzaSyCK6WvkAL7bqWyh5cElIZ8WZpE9fLwodgE";
		url += "&address=" + Endereco + "," + Numero + "," + Bairro + "," + Cidade + "," + Estado;

		$.ajax({
			type: "GET",
			url: url,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				if (result.results.length > 0) {
					var latitude = result.results[0].geometry.location.lat;
					var longitude = result.results[0].geometry.location.lng;
					var titulo = $("#empNomeFant").val();
					$("#empLat").val(latitude);
					$("#empLong").val(longitude);
					$("#mapaEdt").show();
					carregaMapa(latitude, longitude, titulo, document.getElementById('mapaEdt'), true);
				} else {
					if (result.status == "ZERO_RESULTS") {
						swal("Sem resultado", "Nenhum resultado para este endereço no google maps. Favor verificar os dados.", "error");
					} else {
						swal("Erro", "Erro ao buscar este endereço no google maps.", "error");
					}

				}
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
			}
		});
	}

	function getLambdaErrorMessage(result) {
		if (!result) {
			return "Erro ao enviar o arquivo.";
		}

		var resp = result.lambdaResponse;
		if (!resp) {
			return "Erro ao enviar o arquivo.";
		}

		if (typeof resp === "string") {
			return resp;
		}

		if (resp.errorMessage) {
			return resp.errorMessage;
		}

		if (resp.body) {
			var body = resp.body;
			if (typeof body === "string") {
				try {
					body = JSON.parse(body);
				} catch (e) {
					return resp.body;
				}
			}
			if (body && (body.error || body.message)) {
				return body.error || body.message;
			}
		}

		if (resp.statusCode && resp.statusCode >= 400) {
			return resp.message || resp.error || "Erro ao processar o arquivo.";
		}

		return "Erro ao enviar o arquivo.";
	}

	function resetImportForm() {
		$("#tipoImportDocument").val(null);
		$('#fileImportDocument').fileinput('reset');
		$("#editarEmpresa-modal").modal("hide");
	}

	$scope.abrirTicketZoho = function (dados, tipoImport) {
		$.ajax({
			type: "POST",
			url: "/pages/zoho/createTicket.php",
			data: dados,
			dataType: "json",
			processData: false,
			contentType: false,
			success: function (result) {
				if (tipoImport === "1") {
					const lambdaStatusCode = result && result.lambdaResponse ? result.lambdaResponse.statusCode : null;
					const respostaSucesso = result && result.success;
					const lambdaComErro = lambdaStatusCode && lambdaStatusCode >= 400;
					const importacaoProcessadaComSucesso = respostaSucesso && !lambdaComErro;

					if (importacaoProcessadaComSucesso) {
					    swal("Chamado criado com sucesso. Você será avisado por e-mail assim que a equipe finalizar a importação dos seus dados.", "", "success");
						resetImportForm();
						showLoader(false);
						return;
					}

					var errorMessage = getLambdaErrorMessage(result);
					swal("Erro ao enviar o arquivo.", errorMessage, "error");
					showLoader(false);
					return;
				}

				const ticketFoiCriado = result && result.data && result.data.ticket && result.data.ticket.id;

				if (ticketFoiCriado) {
					swal("Chamado criado com sucesso. Você será avisado por e-mail assim que a equipe finalizar a importação dos seus dados.", "", "success");
					resetImportForm();
					showLoader(false);
					return;
				} 
					
				swal("Erro ao criar o ticket.", "", "error");
				showLoader(false);
				
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	}

	$scope.validaCamposImportacao = function () {
		if ($("#tipoImportDocument").val() == "") {
			toastr.error("Informe o tipo de importação.");
			return false;
		}
		if ($('#fileImportDocument').fileinput('getFilesCount') == 0) {
			toastr.error("Insira o arquivo para importação.");
			return false;
		}

		return true;
	}

	$scope.appendData = function (tipoImportacao, formEl) {
		var importacaoNome = {
			"1": "Clientes",
			"2": "Serviços",
			"3": "Produtos"
		};

		const dados = new FormData(formEl);

		const email = $("#empEmail").val() || $scope.dadosPerfil.email;
		const pescodigo = $_CONFIG.CODESTABELECIMENTO;
		const empresa = $("#empNomeFant").val();
		const baseDescription = 'Envio do arquivo de importacao de ' + importacaoNome[tipoImportacao].toLowerCase() + ' da empresa ' + empresa + " - " + pescodigo + "\n";
		const name = empresa + " - " + pescodigo;

		dados.append('email', email);
		dados.append('subject', 'Importação de ' + importacaoNome[tipoImportacao]);
		dados.append('status', 'Open');
		dados.append('channel', 'Sistema');
		dados.append('category', 'Importação');
		dados.append('department_id', '880207000000006907');
		dados.append('type_import', tipoImportacao);
		dados.append('name', name);

		if (tipoImportacao == "1") {
			dados.append('description', baseDescription + "✅ Arquivo passou por limpeza e está disponível na aba de anexos.");
		}
		
		if (dados.has('fileImportDocument')) {
			var fileList = document.getElementById('fileImportDocument').files;
			if (fileList.length > 0) {
				dados.delete('fileImportDocument');
				dados.append('attachment', fileList[0]);
			}
		}

		return {
			dados: dados,
			baseDescription: baseDescription
		};
	}

	$('#formDocsImport').submit(function (event) {
		event.preventDefault();
		showLoader(true);

		if (!$scope.validaCamposImportacao()) {
			showLoader(false);
			return;
		}
		var tipoImportacao = $("#tipoImportDocument").val();
		const importPayload = $scope.appendData(tipoImportacao, event.currentTarget);
		const dados = importPayload.dados;
		const baseDescription = importPayload.baseDescription;

		if (tipoImportacao === "1"){
			$scope.abrirTicketZoho(dados, tipoImportacao);
			return;
		}

		if (tipoImportacao === "2" || tipoImportacao === "3") {
			const uploadData = new FormData();
			var fileList = document.getElementById('fileImportDocument').files;
			if (fileList.length === 0) {
				swal("Insira o arquivo para importacao.", "", "error");
				showLoader(false);
				return;
			}

			uploadData.append('type_import', tipoImportacao);
			uploadData.append('attachment', fileList[0]);

			$.ajax({
				type: "POST",
				url: "/pages/zoho/uploadImportFile.php",
				data: uploadData,
				dataType: "json",
				processData: false,
				contentType: false,
				success: function (uploadResult) {
					if (uploadResult && uploadResult.success && uploadResult.url) {
						dados.append('description', baseDescription + "\n\n<a href=\"" + uploadResult.url + "\" target=\"_blank\">Baixar arquivo</a>");
						dados.delete('attachment');
						$scope.abrirTicketZoho(dados, tipoImportacao);
						return;
					} 

					swal("Erro ao enviar o arquivo.", "", "error");
					showLoader(false);
					return;
					
				},
				error: function (result) {
					swal("Falha na conexão.", "", "error");
					showLoader(false);
					return;
				}
			});
		} 
	});

