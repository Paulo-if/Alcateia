					"width": "95%"
				},
				{
					"class": 'verboletos',
					"width": "5%",
					"orderable": false,
					"data": null,
					"defaultContent": '<button class="btn btn-primary btn-xs" >Ver Boletos <i class="fa fa-document"></i></button>',
				},
			],
			dom: 'Bfrtip',
			buttons: [{
				extend: "excelHtml5",
				title: sSistema + ' - Relatório WhatsApp',
				text: "Excel",
				exportOptions: {
					columns: ':visible'
				},
				footer: "true"
			}, {
				extend: 'pdfHtml5',
				title: sSistema + ' - Relatório WhatsApp',
				orientation: 'landscape',
				footer: true,
				exportOptions: {
					columns: ':visible'
				}

			}],
			"ordering": false,

			"language": {
				"url": "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json"
			}
		});

		$('#tbFaturaBoletosNf tbody').on('click', 'td.verboletos', function () {
			var tr = $(this).closest('tr');
			var row = optTabelaRelatorioBoleto.row(tr);
			var data = row.data();
			$scope.buscaListaBoletosNF(data.Pes_Codigo,data.BNF_Num_Emissao);
		});
		setTimeout(function () {

			$.ajax({
				method: "POST",
				url: "/pages/cadastros/consultaEmpresaNF.php",
				dataType: "json",
				data:{
					idEmpresa: $scope.codigoEmpresaNF
				},
				success: function (result) {

					if(result.data.certificadoDigital != undefined && result.data.certificadoDigital != ""){
						$("#vencimentoCertificadoDigital").html(result.data.certificadoDigital.dataVencimento);
					}else{

						$("#divCertificadoDigital").hide();
					}
				},
				error: function (result) {
					$("#divCertificadoDigital").hide();
					
				}
			});
		},3000)
		

	}


