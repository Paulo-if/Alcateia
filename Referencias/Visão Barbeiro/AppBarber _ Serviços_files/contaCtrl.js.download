				{ "data": "Cliente" },
				{ "data": "StatusEnvio" },
				{ "data": "Mensagem" },
				{ "data": "TipoEnvio" }
			],
			dom: 'Bfrtip',
			buttons: [{
				extend: "excelHtml5",
				title: sSistema + ' - Relatório SMS',
				text: "Excel",
				exportOptions: {
					columns: ':visible'
				},
				footer: "true"
			}, {
				extend: 'pdfHtml5',
				title: sSistema + ' - Relatório SMS',
				orientation: 'landscape',
				footer: true,
