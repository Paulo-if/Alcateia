	var delayTimerSearchSite;
	function searchSite(abreviatura) {
		clearTimeout(delayTimerSearchSite);

		delayTimerSearchSite = setTimeout(function() {

			$("#showLoadingSearchSite").html('<i class="fa fa-spinner fa-spin"></i>');
			$("#showLoadingSearchSite").show();

			fetch(`${localStorage.getItem("host")}?metodo=buscaAbreviatura&abreviatura=${abreviatura}`)
			.then(data => data.json())
			.then(data => {
				if (data.result && data.result[0].erro == "0"){
					$("#showLoadingSearchSite").html('<i class="fa fa-check text-green"></i>');
					$("#msgLinkSiteError").html(data.result[0].resultado);
					$("#msgLinkSiteError").addClass("text-green");
					$("#btnAlterarAbreviaturaSite").prop("disabled", false);
					$("#btnAlterarAbreviaturaSite").on("click", function(){
						saveNewLinkSite(abreviatura);
					});
				} else {
					$("#showLoadingSearchSite").html('<i class="fa fa-times text-red"></i>');
					$("#msgLinkSiteError").html(data.result[0].resultado);
					$("#msgLinkSiteError").addClass("text-red");
				}
			});
		}, 1000); // Will do the ajax stuff after 1000 ms, or 1 s
	}

	$("#btnAlterarSitePixel").on("click", function(){
		saveTagTerceiros($scope.empresa.pixel, 1);
	});

	$("#btnAlterarSiteGtag").on("click", function(){
		saveTagTerceiros($scope.empresa.gtag, 2);
	});

	$("#btnAlterarSitePixelApp").on("click", function(){
		saveTagTerceiros($scope.empresa.PAJ_Pixel_App, 3);
	});

	function saveNewLinkSite(link){

		var dataForm = new FormData();
		dataForm.append("abreviatura", link);

		showLoader(true);
		fetch('./pages/cadastros/alteraAbreviatura.php', {
				method: "POST",
				body: dataForm
			})
			.then(data => data.json())
			.then((data) => {

				if (data.result && data.result[0].erro == "0"){
					toastr.success(data.result[0].resultado);

					var urlSite = `https://sites.${sSistema.toLowerCase()}.com.br/${link}`;

					$("#msgTokenRevendaError").removeClass("text-red");
					$("#msgTokenRevendaError").removeClass("text-green");
					$("#btnAlterarAbreviaturaSite").unbind('click');
					$("#btnAlterarAbreviaturaSite").prop("disabled", true);
					$("#msgTokenRevendaError").html('');
					$("#showLoadingSearchSite").html('<i class="fa fa-spinner fa-spin"></i>');
					$("#showLoadingSearchSite").hide();

					$("#pesSiteApp").children().prop('href', urlSite);
					$("#pesSiteApp").children().html(urlSite);

					$("#editarEmpresa-modal").modal('hide');
					$('#editarEmpresa-modal a[data-toggle="tab"]:first').click();
				} else {
					toastr.error(data.result[0].resultado);
				}

				showLoader(false);
			});
	}

	function saveTagTerceiros(tag, tipo){

		var dataForm = new FormData();
		dataForm.append("tag", tag);
		dataForm.append("tipo", tipo);

		showLoader(true);
		fetch('./pages/cadastros/alteraTagTerceiros.php', {
				method: "POST",
				body: dataForm
			})
			.then(data => data.json())
			.then((data) => {

				if (data.result && data.result[0].erro == "0"){
                    $scope.mostrarMensagemSucessoPerfil();
				} else {
					toastr.error(data.result[0].resultado);
				}

				showLoader(false);
			});
	}

	$("#edtNovoLinkSite").on('keyup', function() {
		this.value = this.value.replace(/[^a-zA-Z0-9-]/g, '');
		$("#msgLinkSiteError").removeClass("text-red");
		$("#msgLinkSiteError").removeClass("text-green");
		$("#btnAlterarAbreviaturaSite").unbind('click');
		$("#btnAlterarAbreviaturaSite").prop("disabled", true);
		$("#msgLinkSiteError").html('');
		$("#showLoadingSearchSite").hide();
		if (this.value.length > 0){
			searchSite(this.value);
		}
	});

	$scope.buscaBoletoNF = function(){
		if (typeof (optTabelaRelatorioBoleto) != "undefined") {
			$('#tbFaturaBoletosNf tbody').unbind('click')
			optTabelaRelatorioBoleto.destroy();
		}

		optTabelaRelatorioBoleto = $('#tbFaturaBoletosNf').DataTable({
			"dom": 'T<"clear">lfrtip',
			"ajax": {
				"url": "/pages/cadastros/buscaBoletosNF.php",
				"method": "POST",
				"data": function (d) {
					d.tipo = 5;
					d.pescodigo =mPesCodigo;

				}
			},

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,
			"initComplete": function (e, records, f) {
				resizeContent()
			},
			"columns": [
				{
					"data": "Descricao",
