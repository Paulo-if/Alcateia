	$('#wizardprof-modal').on('hidden.bs.modal', function () {
		var semservico = false;
		var semjornada = false;
		if ($('#pesCodigoWiz').val() != "" || $('#pesCodigoWiz').val() != undefined) {
			$.ajax({
				type: 'POST',
				url: '/pages/cadastros/buscaServicoProfissionalWizard.php',
				data: {
					spProfissional: $('#pesCodigoWiz').val()
				},
				dataType: 'html',
				success: (result) => {
					if (result == "") {
						semservico = true
					}
				},
				error: () => {
					toastr.error($_CONFIG.language.errors.falha_conexao);
				}
			});

			$.ajax({
				type: 'POST',
				url: '/pages/cadastros/buscaProfissionalJornadaWizard.php',
				data: {
					pjProfissional: $('#pesCodigoWiz').val()
				},
				dataType: 'html',
				success: (result) => {

					if (result.trim() == "") {
						semjornada = true
					} else {

					}
				},
				error: () => {
					toastr.error($_CONFIG.language.errors.falha_conexao);
				}
			});
		}

		setTimeout(() => {

			if (semservico && semjornada) {
				swal({
					title: "Atenção!",
					text: "Esse profissional não teve <b>nenhum serviço</b> associado e <b>não teve jornada</b> de trabalho cadastrada, portanto <b>não será possível agendar</b> com ele.</br> Para associar <b>Serviços</b> e cadastrar uma <b>Jornada</b> clique em <label class='btn btn-success btn-xs'>Editar <i class='fa fa-pencil'></i></label> e selecione as abas <b>SERVIÇOS</b> e <b>JORNADA</b>",
					type: "warning",
					html: true
				});
			} else if (semservico && !semjornada) {
				swal({
					title: "Atenção!",
					text: "Esse profissional não teve <b>nenhum serviço</b> associado, portanto <b>não será possível agendar</b> com ele.</br> Para associar <b>Serviços</b> clique em <label class='btn btn-success btn-xs'>Editar <i class='fa fa-pencil'></i></label> e selecione a aba <b>SERVIÇOS</b>",
					type: "warning",
					html: true
				});
			} else if (!semservico && semjornada) {
				swal({
					title: "Atenção!",
					text: "Esse profissional <b>não teve jornada</b> de trabalho cadastrada, portanto <b>não será possível agendar</b> com ele.</br> Para cadastrar uma <b>Jornada</b> clique em <label class='btn btn-success btn-xs'>Editar <i class='fa fa-pencil'></i></label> e selecione a aba <b>JORNADA</b>",
					type: "warning",
					html: true
				});
			}

		}, 1000)

		$('#pesCodigoWiz').val('');
		$scope.clearModal();
		$scope.firstTab();
	});

	$('#editar-modal').on('hidden.bs.modal', function () {
		$('#editar-modal a[data-toggle="tab"]:first').click();
		$("#formEditar").each(function () {
			this.reset();
		});
	});

	$scope.avancaTab = function () {
		var $active = $('.wizard .nav-tabs li.active');
		$active.next().removeClass('disabled');
		$scope.nextTab($active);
	}

	$scope.retornaTab = function () {
		var $active = $('.wizard .nav-tabs li.active');
		$active.prev().removeClass('disabled');
		$scope.prevTab($active);
	}

	$scope.nextTab = function (elem) {
		$(elem).next().find('a[data-toggle="tab"]').click();
	}

	$scope.prevTab = function (elem) {
		$(elem).prev().find('a[data-toggle="tab"]').click();
	}

	$scope.firstTab = function () {
		$('#wizardprof-modal a[data-toggle="tab"]:first').click();
	}

	$scope.clearModal = function () {
		$('#formEnderecoWizard').each(function () {
			this.reset();
		});

		$('#formServicoWizard').each(function () {
			this.reset();
		});

		$('#formJornadaWizard').each(function () {
			this.reset();
		});

		$('#formUsuarioWizard').each(function () {
			this.reset();
		});

		$('#formDadosWizard').each(function () {
			this.reset();
		});

		$('.select2').val(null).trigger('change');
		var diasDaSemana = $('#pjDiaSemana');
		diasDaSemana.multiselect('deselectAll', false);
		diasDaSemana.multiselect('updateButtonText');

	}

	$scope.fecharModal = function () {
		$('#wizardprof-modal').modal('hide');
		$scope.firstTab();
	}

	function buscaJornada(codigo) {
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/buscaProfissionalJornadaWizard.php',
			data: {
				pjProfissional: codigo
			},
			dataType: 'html',
			success: function (result) {
				$('#tbodyJornada').html(result);
				$compile($('#tbodyJornada'))($scope);
			},
			error: function (result) {
				toastr.error($_CONFIG.language.errors.falha_conexao);
			}
		});
	}

