				tipo: 1
			},
			dataType: "json",
			success: (result) => {

				var html = "";
				html += "<option value=''>Tipo de dedução </option>"
				for (var i = 0; i < result.data.length; i++) {
					html += "<option value='" + result.data[i].TPD_Codigo + "'>" + result.data[i].TPD_Descricao + "</option>";
				};
				$("#spDeducao").html(html);
				$("#spDeducaoEdt").html(html);

			},
			error: () => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
			}
		});

	}

	$scope.buscaProfissionalDeducao = function (codigo) {

		if (typeof (tabelaDeducao) != 'undefined') {
			$('#tbDeducao tbody').unbind('click')
			tabelaDeducao.destroy();
		}

		tabelaDeducao = $('#tbDeducao').DataTable({
			'dom': 'T<"clear">lfrtip',
			'ajax': {
				'url': "/pages/cadastros/buscaPessoaDeducao.php",
				'method': 'POST',
				'data': {
					codigo: codigo,
					tipo: 1
				},
			},

			"scrollX": isPortrait,
			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,
			'columns': [{
					'data': 'TPD_Descricao'
				},
				{
					'data': 'PDe_Valor'
				},
				{
					'class': 'editarpessoadeducao',
					'orderable': false,
					'data': null,
					'defaultContent': "<a><i class='fa fa-pencil' style='cursor:pointer;'></i></a>"
				},
				{
					'class': 'excluirpessoadeducao',
					'orderable': false,
					'data': null,
					'defaultContent': "<a><i class='fa fa-trash' style='cursor:pointer;'></i></a>"
				}

			],
			'paging': false,
			'searching': false,
			'ordering': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});

		$('#tbDeducao tbody').on('click', 'td.editarpessoadeducao', function () {
			var tr = $(this).closest('tr');
			var row = tabelaDeducao.row(tr);
			var data = row.data();
			$("#spDeducaoValor").val(data.PDe_Valor);
			$("#spDeducaoCodigo").val(data.PDe_Codigo);
			setTimeout(function () {
				$("#spDeducaoEdt").val(data.TPD_Codigo);

			}, 500)
			$("#editarDeducaoProfissional-modal").modal();

		});

		$('#tbDeducao tbody').on('click', 'td.excluirpessoadeducao', function () {
			var tr = $(this).closest('tr');
			var row = tabelaDeducao.row(tr);
			var data = row.data();
			swal({
				title: "Deseja realmente excluir esta Dedução?",
				type: "warning",
				showCancelButton: true,
				confirmButtonColor: "#DD6B55",
				confirmButtonText: "Sim",
				cancelButtonText: "Não",
				closeOnConfirm: true
			}, () => {
				showLoader(true);
				$.ajax({
					dataType: "json",
					method: "POST",
					url: '/pages/cadastros/removePessoaDeducao.php',
					data: {
						codigo: data.PDe_Codigo
					},
					success: (result) => {

						if (result.data.length != undefined) {
							if (result.data[0].erro == 0) {
								toastr.success(result.data[0].resultado);
								$scope.buscaProfissionalDeducao(data.Pes_Codigo);
							} else {
								swal(result.data[0].resultado, "", "error");
							}
						} else {
							swal(result.data.resultado, "", "error");
						}

						showLoader(false);
					},
					error: () => {
						swal("Falha na conexão.", "", "error");
						showLoader(false);
					}
				});
			});
		});

	}

	$('#formInserePessoaDeducao').submit(function (event) {
