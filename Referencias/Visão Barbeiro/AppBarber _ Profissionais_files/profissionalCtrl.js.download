	$scope.buscaProfissionalRemuneracao = function (codigo) {

		if (typeof (tabelaRemuneracao) != 'undefined') {
			$('#tbRemuneracao tbody').unbind('click')
			tabelaRemuneracao.destroy();
		}

		tabelaRemuneracao = $('#tbRemuneracao').DataTable({
			'dom': 'T<"clear">lfrtip',
			'ajax': {
				'url': "/pages/cadastros/buscaPessoaPagamento.php",
				'method': 'POST',
				'data': {
					codigo: codigo,
					tipo: 1
				},
			},
			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,
			"scrollX": isPortrait,
			'columns': [{
					'data': 'TPP_Descricao'
				},
				{
					'data': 'PPg_Valor'
				},
				{
					'class': 'editarpessoaremuneracao',
					'orderable': false,
					'data': null,
					'defaultContent': "<a><i class='fa fa-pencil' style='cursor:pointer;'></i></a>"
				},
				{
					'class': 'excluirpessoaremuneracao',
