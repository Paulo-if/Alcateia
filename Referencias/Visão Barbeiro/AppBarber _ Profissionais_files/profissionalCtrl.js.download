	});

	$('#proEstado').change(function () {
		var estado = this.value;
		$('#proCidade').empty();
		if (estado === -1) {
			$('#proCidade').attr('disabled', true);
		} else {
			$.ajax({
				dataType: 'html',
				url: '/pages/cadastros/buscaCidades.php',
				method: 'POST',
				data: {
					estCodigo: estado
				},
				success: (data) => {
					$('#proCidade').append(data);
					$('#proCidade').attr('disabled', false);
				}
			});
		}
	});

