	$scope.excluirJornada = function (dia, codigo) {
		swal({
			title: $_CONFIG.language.mensagens.excluir_titulo,
			text: $_CONFIG.language.mensagens.excluir_jornada,
			type: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#DD6B55',
			confirmButtonText: $_CONFIG.language.sim,
			cancelButtonText: $_CONFIG.language.nao
		}, () => {
			showLoader(true);
			$.ajax({
				dataType: 'html',
				url: '/pages/cadastros/removeProfissionalJornada.php',
				data: {
					pescodigo: codigo,
					dia: dia
				},
				success: (data) => {
					if (data == '0') {
						toastr.success('Jornada Excluida com Sucesso.');
						buscaJornada(codigo);
						buscaJornadaEdt(codigo);
					} else {
						toastr.error(data, $_CONFIG.language.mensagens.falha_excluir);
					}
					showLoader(false);
				},
				error: () => {
					toastr.error($_CONFIG.language.errors.falha_conexao);
					showLoader(false);
				}
			});
		});
	}

	$scope.excluirJornadaPeriodo = function (dia, codigo) {
		swal({
			title: $_CONFIG.language.mensagens.excluir_titulo,
			text: $_CONFIG.language.mensagens.excluir_jornada,
			type: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#DD6B55',
			confirmButtonText: $_CONFIG.language.sim,
			cancelButtonText: $_CONFIG.language.nao
		}, () => {
			showLoader(true);
			$.ajax({
				dataType: 'html',
				url: '/pages/cadastros/removePessoaJornadaPeriodo.php',
				data: {
					pescodigo: codigo,
					dia: dia
				},
				success: (data) => {
					if (data == '0') {
						toastr.success('Jornada Excluida com Sucesso.');
						buscaJornada(codigo);
						buscaJornadaEdt(codigo);
						buscaJornadaper(codigo);
					} else {
						toastr.error(data, $_CONFIG.language.mensagens.falha_excluir);
					}
					showLoader(false);
				},
				error: () => {
					toastr.error($_CONFIG.language.errors.falha_conexao);
					showLoader(false);
				}
			});
		});
	}

	$scope.excluirServico = function (codigo, profissional) {
		swal({
				title: $_CONFIG.language.mensagens.excluir_titulo,
				text: $_CONFIG.language.mensagens.desfazer_associacao,
				type: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: $_CONFIG.language.sim,
				cancelButtonText: $_CONFIG.language.nao
			},
			function () {
				showLoader(true);
				$.ajax({
					dataType: 'html',
					method: 'GET',
					url: '/pages/cadastros/removeServicoProfissional.php',
					data: {
						psecodigo: codigo
					},
					success: (data) => {
						if (data == '0') {
							toastr.success($_CONFIG.language.errors.associacao_removida);
							buscaServico(profissional);
							buscaServicoEdt(profissional);
							$scope.buscaServicoCombo(profissional);
						} else {
							toastr.error(data, $_CONFIG.language.mensagens.falha_excluir);
						}
						showLoader(false);
					},
					error: () => {
						toastr.error($_CONFIG.language.errors.falha_conexao);
						showLoader(false);
					}
				});
			});
	}

	$('#spValor').change(function () {
		mascara(this, soValorReal)
	});

	$scope.editarServico = function (codigo, profissional, comissao, tempo2, valor) {
		$.ajax({
			dataType: 'json',
			url: localStorage.getItem('host'),
			data: {
				metodo: 'buscaParametro',
				id: $scope.idCliente,
				parcodigo: 5,
				origem: 1
			},
			success: (data) => {
				if (data.result[0] != '') {
					parTempo = data.result[0].PVa_Vlr_Principal;
					var tempo = parseInt(parTempo);
					$('#serIntervalo').html('');
					for (var i = tempo; i <= 360; i = i + tempo) {
						$('#serIntervalo').append('<option value="' + i + '" >' + i + ' ' + $_CONFIG.language.minutos + '</option>');
					};

					$('#serIntervalo').val(tempo2);

					$('.timepicker').timepicker({
						'timeFormat': 'H:i',
						'forceRoundTime': true,
						'step': tempo
					});
				} else {
					$('.timepicker').timepicker({
						'timeFormat': 'H:i',
						'forceRoundTime': true,
						'step': 10
					});
				}
			}
		});

		if (comissao == '') {
			$('#valComissao').val('');
		} else {
			$('#valComissao').val(comissao);
		}
		if (tempo2 == '') {
			$('#serIntervalo').val('');
		} else {
			$('#serIntervalo').val(tempo2);
		}
		$('#pseCodigo').val(codigo);
		$('#proCodigo').val(profissional);
		$('#spValor').val(valor);
		$('#spValor').change();
		$('#editarServico-modal').modal('show');
	}


	$scope.editaServicoLinha = function (codigo, profissional, comissao, tempo2, valor) {
		if (isMobile) {
			$scope.editarServico(codigo, profissional, comissao, tempo2, valor);
		}

	}

