	$('#formJornadaEdtPer').submit(function (event) {
		event.preventDefault();
		formJornada = $(this);
		dataJornada = new FormData(this);
		dataJornada.append('pjProfissionalPer', $('#pesCodigoWizPer').val());


		dataJornada.append('dataini',moment($('#dataJonadaPerido').data('daterangepicker').startDate).format("DD/MM/YYYY") );
		dataJornada.append('datafim', moment($('#dataJonadaPerido').data('daterangepicker').endDate).format("DD/MM/YYYY"));
		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/inserePessoaJornadaPeriodo.php',
			data: dataJornada,
			dataType: 'json',
			processData: false,
			contentType: false,
			success: (result) => {
				if (result.insereProfissionalJornada[0].erro == '0') {
					atualizaDados();
					buscaJornadaper($('#pesCodigoWizPer').val());
					formJornada.each(function () {
						this.reset();
					});
					toastr.success(result.insereProfissionalJornada[0].resultado);
					var diasDaSemana = $('#pjDiaSemanaEdtPer');
					diasDaSemana.multiselect('deselectAll', false);
					diasDaSemana.multiselect('updateButtonText');
					$('.select2').val(null).trigger('change');
				} else {
					toastr.error(result.insereProfissionalJornada[0].resultado);
				}
				showLoader(false);
			},
			error: () => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		return true;
	});

	$('#spServico').multiselect({
		checkboxName: 'spServico[]',
		enableFiltering: true,
		includeSelectAllOption: true,
		buttonWidth: '100%',
		selectAllText: 'Selecionar Todos',
		allSelectedText: 'Todos os Serviços Selecionados',
		filterPlaceholder: 'Buscar Serviço',
		maxHeight: 200,
		buttonText: function (options, select) {
			if (options.length === 0) {
				return $_CONFIG.language.servico;
			} else {
				var labels = [];
				options.each(function () {
					if ($(this).attr('label') !== undefined) {
						labels.push($(this).attr('label'));
					} else {
						labels.push($(this).html());
					}
				});
				return labels.join(', ') + '';
			}
		}
	});

	$('#spServico').on('click', function () {
		$('#spServico').multiselect('updateButtonText', true);
	});

	$scope.buscaServicoCombo = function (profissional) {
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/buscaServicoNaoAssociado.php',
			dataType: 'json',
			data: {
				profissional: profissional
			},
			success: (result) => {
				$('#spServicoi').multiselect('destroy');
				var html = "";

				for (var i = 0; i < result.servicos.length; i++) {
					html += '<option value="' + result.servicos[i].Ser_Codigo + '"  >' + result.servicos[i].Ser_Descricao + '</option>';
				}

				$('#spServicoi').html(html);
				$('#spServicoi').multiselect({
					checkboxName: 'spServico[]',
					enableFiltering: true,
					includeSelectAllOption: true,
					buttonWidth: '100%',
					selectAllText: 'Selecionar Todos',
					allSelectedText: 'Todos os Serviços Selecionados',
					filterPlaceholder: 'Buscar Serviço',
					maxHeight: 200,
					buttonText: function (options, select) {
						if (options.length === 0) {
							return $_CONFIG.language.servico;
						} else {
							var labels = [];
							options.each(function () {
								if ($(this).attr('label') !== undefined) {
									labels.push($(this).attr('label'));
								} else {
									labels.push($(this).html());
								}
							});
							return labels.join(', ') + '';
						}
					}
				});

				$('#spServicoi').on('click', function () {
					$('#spServicoi').multiselect('updateButtonText', true);
				});

			}
		});
	}

	$('#cortaImagemAll-modal').on('hidden.bs.modal', function (e) {
		if (mBlob != undefined && mBlob != "") {
			if (location.hash == '#/profissionais') {
				if ($("#formid").val() != "#formDadosWizard") {
					$('#profImagemEdit').attr('src', mImage);
					$scope.saveImageProf();
				}
			}
		} else {

			if (location.hash == '#/profissionais') {
				$scope.saveImageProf();
			}
		}
		$("#imagemCutAll").resize();
		$("#imagemCutAll").cropper("reset");
		$(this).data('modal', null);
	})

	$scope.editarimagemprof = function () {
		$("#proFotoEdt").click()
	}

	$scope.saveImageProf = function () {

		showLoader(true)

		if (mBlob != undefined) {

			dataaltera = new FormData();

			dataaltera.append('figura', mBlob);
			dataaltera.append('profissional', $('#proCodigoEdt').val())
			//dataaltera.append('proFotoEdt', $('#proFotoEdt').prop('files')[0])
			$.ajax({
				dataType: 'json',
				method: 'POST',
				url: '/pages/cadastros/alteraProfissionalImagem.php',
				data: dataaltera,
				processData: false,
				contentType: false,
				success: (data) => {

					if (data.data[0].erro == 0) {
						$('#profImagemEdit').attr('src', data.data[0].urlimagem);
						toastr.success(data.data[0].resultado);
						mBlob = "";
						$("#proFotoEdt").fileinput("clear")

					} else {
						toastr.error(data.data[0].resultado);
					}
					showLoader(false)
				},
				error: () => {
					toastr.error('Falha de conexão');
					showLoader(false)
				}
			});
		} else {
			toastr.warning("Ops! Parece que você não concluiu a seleção da nova imagem, nenhuma alteração será feita");
			$("#proFotoEdt").fileinput("clear")
			showLoader(false)
		}

	}

	$scope.removeImagemProf = function () {
		swal({
			title: 'Deseja realmente remover essa imagem',
			type: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#DD6B55',
			confirmButtonText: $_CONFIG.language.sim,
			cancelButtonText: $_CONFIG.language.nao,
			closeOnConfirm: true
		}, () => {
			showLoader(true)
			dataaltera = new FormData();

			dataaltera.append('figura', '');
			dataaltera.append('profissional', $('#proCodigoEdt').val())
			dataaltera.append('proFotoEdt', '')
			$.ajax({
				dataType: 'json',
				method: 'POST',
				url: '/pages/cadastros/alteraProfissionalImagem.php',
				data: dataaltera,
				processData: false,
				contentType: false,
				success: (data) => {
					if (data.data[0].erro == 0) {
						$('#profImagemEdit').attr('src', '../../img/nopicture.png');
						toastr.success(data.data[0].resultado);
						$("#otpimagenprofissional").val("").change();
					} else {
						toastr.error(data.data[0].resultado);
					}
					showLoader(false)

				},
				error: () => {
					toastr.error('Falha de conexão');
					showLoader(false)
				}
			});
		});

	}

