	$('#formDadosWizard').submit(function (event) {
		var noslashes = ($("#proApelidoWiz").val()).replace(/'/g,'');
		$("#proApelidoWiz").val(noslashes);
		event.preventDefault();
		formCadastro = $(this);
		showLoader(true);
		dadosInsere = new FormData(this);
		if (mBlob != undefined) {
			dadosInsere.append("blob", mBlob);
		}
		dadosInsere.delete('proFotoWiz')
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/insereProfissionais_v3.php',
			data: dadosInsere,
			dataType: 'json',
			processData: false,
			contentType: false,
			success: (result) => {
				if(result.insereProfissional.length >0){

					if (result.insereProfissional[0].erro == '0') {
						toastr.success(result.insereProfissional[0].resultado);
						$('#pesCodigoWiz').val(result.insereProfissional[0].pescodigo);
						$('#proLoginWiz').val($('#proEmailWiz').val());
	
						buscaJornada($('#pesCodigoWiz').val());
						$('.date.dataNascimento').datepicker('update', '');
						showLoader(false);
						mBlob = '';
						swal({
							title: "Hora de associar os serviços!",
							text: "Deseja escolher e associar <b>manualmente</b> ou deseja que o sistema associe <b>TODOS</b> os serviços <b>automaticamente</b> ao profissional?",
							type: "warning",
							showCancelButton: true,
							confirmButtonColor: "#7ddd54",
							cancelButtonColor: "#679bef",
							confirmButtonText: "Automático",
							cancelButtonText: "Manual",
							closeOnConfirm: false,
							closeOnCancel: true,
							html: true
						}, function (isConfirm) {
							if (isConfirm) {
	
								var obj = $('#spServico').get(0).options;
								var vet = [];
								showLoader(true);
								for (var i = 0; i < obj.length; i++) {
									vet.push(obj[i].value);
								}
								
	
								$.ajax({
									type: 'POST',
									url: '/pages/cadastros/insereServicoProfissional.php',
									data: {
										spServico: vet,
										spProfissional: $('#pesCodigoWiz').val()
									},
									dataType: 'json',
	
									success: (result) => {
										if (result.sucesso) {
											var texto = '<span style="color:green;"><i class="fa fa-check"></i>&nbspInseridos com sucesso:&nbsp' + result.sucesso + '</span>'
										} else {
											var texto = '<span style="color:red;"><i class="fa fa-times"></i>&nbspFalhas ao inserir:&nbsp' + result.falha + '</span>'
										}
										swal({
											title: "<small>Resultado</small>",
											text: texto,
											html: true
										});
										atualizaDados();
										$scope.avancaTab();
										buscaServico($('#pesCodigoWiz').val());
										
										showLoader(false);
									},
									error: () => {
										toastr.error($_CONFIG.language.errors.falha_conexao);
										showLoader(false);
									}
								});
	
							} else {
								atualizaDados();
								$scope.avancaTab();
								buscaServico($('#pesCodigoWiz').val());
							}
						});
					} else {
						toastr.error(result.insereProfissional[0].resultado);
					}
				}else{
					toastr.error(result.insereProfissional.resultado);
				}
				showLoader(false);
			},
			error: () => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		showLoader(false);
		return true;
	});

