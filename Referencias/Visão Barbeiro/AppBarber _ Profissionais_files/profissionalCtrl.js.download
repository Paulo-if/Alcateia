	$scope.alteraProfissionalJornada = function (dia, profissional, hrini1, hrfim1, hrini2, hrfim2,pjDisponivel) {
		$("#profissionalAlteraJornada").val(profissional);
		$("#jorAltDiaSemana option").prop("selected", false);
		$("#jorAltDiaSemana").multiselect("refresh");
		$("#jorAltDiaSemana").multiselect("select", dia);
		$("#jorHoraIniEdt1").val(hrini1)
		$("#jorHoraFimEdt1").val(hrfim1)
		$("#jorHoraIniEdt2").val(hrini2)
		$("#jorHoraFimEdt2").val(hrfim2)
		if(pjDisponivel != ''){
			$("#jorDispAgendamento").val(pjDisponivel)
		}else{
			$("#jorDispAgendamento").val(1)
		}
		$('#alteraHorarioJornada-modal').modal();
	}

	$scope.alteraProfissionalJornadaLinha = function (dia, profissional, hrini1, hrfim1, hrini2, hrfim2,pjDisponivel) {
