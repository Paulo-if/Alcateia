	$scope.changeCpfCnpj = function (tipo) {

		if (tipo == 1) {

			$("#tipocampoCPF").val(1)
			$("#btnCpfCnpj").html("CPF");
			$("#proCpfWiz").val('')
			$("#proCpfWiz").attr('maxlength', '14')
			$("#proCpfWiz").attr('placeholder', 'CPF')
		} else {

			$("#tipocampoCPF").val(2)
			$("#btnCpfCnpj").html("CNPJ")
			$("#proCpfWiz").val('')
			$("#proCpfWiz").attr('placeholder', 'CNPJ')
			$("#proCpfWiz").attr('maxlength', '18')
		}
	}


	$("#tipocampoCPF").val(1)
	$scope.changeCpfCnpj(1)

	$("#proCpfWiz").keypress(function () {
		if ($("#tipocampoCPF").val() == '1') {
			mascara(this, soCpf);
		} else {
			mascara(this, soCnpj)
		}
	})

