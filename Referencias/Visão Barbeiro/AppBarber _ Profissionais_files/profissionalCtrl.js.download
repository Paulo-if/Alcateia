	$scope.excluir = function (row) {
		var registroTabela = row.data();
		swal({
			title: $_CONFIG.language.mensagens.excluir_titulo,
			text: $_CONFIG.language.mensagens.excluir_profissional.replace('_NOME_', registroTabela.Pes_Nome),
			type: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#DD6B55',
			confirmButtonText: $_CONFIG.language.sim,
			cancelButtonText: $_CONFIG.language.nao,
			closeOnConfirm: true
		}, () => {
			showLoader(true);
			$.ajax({
				dataType: 'html',
				url: '/pages/cadastros/removeProfissionais.php',
				data: {
					pescodigo: registroTabela.Pes_Codigo
				},
				success: (data) => {
					if (data == '0') {
						toastr.success($_CONFIG.language.mensagens.profissional_excluido);
						row.remove().draw();
					} else {
						var resultado = data;
						toastr.error(resultado, $_CONFIG.language.mensagens.falha_excluir);
					}
					showLoader(false);
				},
				error: () => {
					toastr.error($_CONFIG.language.errors.falha_conexao);
					showLoader(false);
				}
			});
		});
		$('#proCodigoInfo').html(registroTabela.Pes_Codigo);
	}

	function buscaCEP(cep) {
		if (cep && cep.length >= 9) {
			cep = cep.replace('-', '');

			$.ajax({
				dataType: 'json',
				url: 'http://cep.correiocontrol.com.br/' + cep + '.json',
				method: 'GET',
				success: (data) => {
					$('.loader').show();

					$('#proEstado').val(1);
					$('#proEstado').val($('#' + data.uf + '').val())
					$('#proCidade').empty();
					$.ajax({
						dataType: 'html',
						url: '/pages/cadastros/buscaCidades.php',
						method: 'POST',
						data: {
							estCodigo: $('#' + data.uf + '').val(),
							cidNome: data.localidade
						},
						success: (data) => {
							$('#proCidade').append(data);
							$('#proCidade').attr('disabled', false);
						}
					});
					$('#proBairro').val(data.bairro);
					$('#proEndereco').val(data.logradouro);
					$('#proCidade').val(data.localidade);
				}
			});

			$('.loader').hide();

		}

	};

	function buscaCategoria(codigo) {

		if (typeof (tbCategoriaWz) != 'undefined') {
			tbCategoriaWz.api().destroy();
		}

		tbCategoriaWz = $('#tbCategoriaWiz').dataTable({
			'dom': 'T<"clear">lfrtip',
			'ajax': {
				'url': $('#tbCategoriaWiz').data('source'),
				'method': 'POST',
				'data': {
					pescodigo: codigo
				},
			},

			stateSaveCallback: function (settings, data) {
				data.order = [];
				localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data))
			},
			stateLoadCallback: function (settings) {
				return JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance))
			},
			"stateSave": true,
			"scrollX": isPortrait,
			'columnDefs': [{
				'targets': [0, 2, 3],
				'visible': false,
				'searchable': false
			}],
			'columns': [{
					'data': 'TCa_Codigo'
				},
				{
					'data': 'TCa_Descricao'
				},
				{
					'data': 'Pes_Nome'
				},
				{
					'data': 'PTC_Codigo'
				},
				{
					'class': 'excluir-control',
					'orderable': false,
					'data': null,
					'defaultContent': ''
				}

			],
			'paging': false,
			'searching': false,
			'ordering': false,
			'language': {
				'url': $_CONFIG.language.datatables
			}
		});

		$('#tbCategoriaWiz tbody').on('click', 'td.excluir-control', function () {
			var tr = $(this).closest('tr');
			var idx = tr[0]._DT_RowIndex;
			var registroTabela = tbCategoriaWz.fnGetData(idx);
			swal({
					title: $_CONFIG.language.mensagens.excluir_titulo,
					text: $_CONFIG.language.mensagens.excluir_categoria,
					type: 'warning',
					showCancelButton: true,
					confirmButtonColor: '#DD6B55',
					confirmButtonText: $_CONFIG.language.sim,
					cancelButtonText: $_CONFIG.language.nao
				},
				function () {
					showLoader(true);
					$.ajax({
						dataType: 'html',
						url: '/pages/cadastros/removeProfissionalCategoria.php',
						data: {
							tcacodigo: registroTabela.TCa_Codigo,
							pescodigo: codigo
						},
						success: (data) => {
							toastr.success($_CONFIG.language.mensagens.categoria_excluida);
							tbCategoriaWz.api().ajax.reload();
							$('#spCategoria').multiselect('deselectAll', false);
							$('#spCategoria').multiselect('updateButtonText');

							showLoader(false);
						},
						error: () => {
							toastr.error($_CONFIG.language.errors.falha_conexao);
							showLoader(false);
						}
					});
				});

		});
	}

	$('#formCategoriaEdt').submit(function (event) {
		event.preventDefault();
		formCategoria = $(this);
		categorias = new FormData(this);
		categorias.append('pesCodigo', $('#pesCodigoWiz').val());

		showLoader(true);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/insereProfissionalCategoria.php',
			data: categorias,
			dataType: 'json',
			processData: false,
			contentType: false,
			success: (result) => {
				if (result.result[0].erro == '0') {
					tbCategoriaWz.api().ajax.reload();
					formCategoria.each(function () {
						this.reset();
					});
					$('#spCategoria').multiselect('deselectAll', false);
					$('#spCategoria').multiselect('updateButtonText');
					toastr.success(result.result[0].resultado);
					$('.select2').val(null).trigger('change');
				} else {
					toastr.error(result.result[0].resultado);
				}
				showLoader(false);
			},
			error: () => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});

		return true;
	});

	$scope.refresh = function () {
		atualizaDados();
	}

