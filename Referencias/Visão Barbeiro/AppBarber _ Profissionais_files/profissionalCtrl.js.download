	$scope.editarProfissional = (row) => {

		var registroTabela = row.data();

		if (registroTabela.EhCNPJ == 1) {
			$("#tipocampoCPFEdt").val(2)
			$scope.changeCpfCnpjEdt(2)
		} else {
			$("#tipocampoCPFEdt").val(1)
			$scope.changeCpfCnpjEdt(1)
		}
		$('#proNomeEdt').val(registroTabela.Pes_Nome);
		$('#proCpfEdt').val(registroTabela.PAF_CPF);
		$('#proEmailEdt').val(registroTabela.PAF_Email);
		$('#proCelularEdt').val(registroTabela.PAF_Celular);
		$('#proTelefoneEdt').val(registroTabela.PAF_Telefone);
		$('#usuarioAlt').val(registroTabela.PAF_Email);
		$("#proDataExpiracao").val(registroTabela.Usu_Dat_Expiracao);
		$("#proTentativas").val(registroTabela.Usu_Tentativa);

		if (registroTabela.Usu_Login == '') {
			$('#proAbreviaturaAlt').show();
		} else {
			$('#proAbreviaturaAlt').hide();
		}

		$('#proSexoEdt').val(registroTabela.PAF_Sexo);
		$('#proDataNascimentoEdt').val(registroTabela.PAF_Dat_Nascimento);
		$('#proEnderecoEdt').val(registroTabela.PAF_Endereco);
		$('#proBairroEdt').val(registroTabela.PAF_Bairro);
		$('#proCepEdt').val(registroTabela.PAF_CEP);
		$('#proCodigoEdt').val(registroTabela.Pes_Codigo);
		$('#pesCodigoAlt').val(registroTabela.Pes_Codigo);
		$('#pesCodigoWiz').val(registroTabela.Pes_Codigo);
		$('#pesCodigoWizPer').val(registroTabela.Pes_Codigo);
		$('#pesCodigoWizSer').val(registroTabela.Pes_Codigo);
		$('#usuCodigo').val(registroTabela.Usu_Codigo);
		$('#usuCodigoWiz').val(registroTabela.Usu_Codigo);
		$('#usuCodigoWizSer').val(registroTabela.Usu_Codigo);
		if (registroTabela.PAF_Imagem != undefined && registroTabela.PAF_Imagem != '') {
			$('#profImagemEdit').attr('src', registroTabela.PAF_Imagem)
		} else {
			$('#profImagemEdit').attr('src', '../../img/nopicture.png')
		}
		if(registroTabela.PAF_Disp_Apresentacao == ""){
			$("#proDispAresentacaoEdt").val(1)
		}else{
			$("#proDispAresentacaoEdt").val(registroTabela.PAF_Disp_Apresentacao)
		}
		
		$('#proDDiEdt').val(registroTabela.PAF_DDI);
		$('#proComplementoEdt').val(registroTabela.PAF_Complemento);
		$('#proObservacaoEdt').val(registroTabela.PAF_Observacao);
		$('#proNumeroEdt').val(registroTabela.PAF_Numero);
		$('#proRgEdt').val(registroTabela.PAF_RG);
		$('#proApelidoEdt').val(registroTabela.Pes_Apelido);
		$('#proDispAppEdt').val(registroTabela.PAF_Dis_Aplicativo);
		if (registroTabela.SituacaoUsuario == '') {
			$('#btnDesativaUsuario').show();
			$('#btnReativaUsuario').hide();
		} else {
			$('#btnDesativaUsuario').hide();
			$('#btnReativaUsuario').show();
		}
		if (registroTabela.Usu_Login == '') {
			$('#btnDesativaUsuario').hide();
			$('#acessoProfissionalAltera').hide();
		} else {
			$('#btnDesativaUsuario').show();
			$('#acessoProfissionalAltera').show();
		}

		if (registroTabela.Usu_Login == 'Não Possui') {
			$('#btnDesativaUsuario').hide();
			$('#btnReativaUsuario').hide();
			$('#acessoProfissionalAltera').hide();
		}
		if (document.getElementById('proGestor') != null) {

			if (registroTabela.PAF_Gestor == '1') {
				$('#proGestorEdt').get(0).checked = true;
			} else {
				$('#proGestorEdt').get(0).checked = false;
			}
		}

		$('#proEstadoEdt').val(registroTabela.Est_Codigo);

		$('#proCidadeEdt').empty();
		$.ajax({
			dataType: 'html',
			url: '/pages/cadastros/buscaCidades.php',
			method: 'POST',
			data: {
				estCodigo: registroTabela.Est_Codigo
			},
			success: (data) => {
				$('#proCidadeEdt').append(data);
				$('#proCidadeEdt').attr('disabled', false);
				$('#proCidadeEdt').val(registroTabela.Cid_Codigo);
			}
		});
		
		$scope.geraComboPaisTelefone('proCelularEdt','proDDiEdt',registroTabela.PAF_DDI)
		

		$("#pesCodigoRemuneracao").val(registroTabela.Pes_Codigo);
		$("#pesCodigoDeducao").val(registroTabela.Pes_Codigo);
		$scope.buscaServicoCombo(registroTabela.Pes_Codigo);
		buscaJornadaEdt(registroTabela.Pes_Codigo);
		buscaJornadaper(registroTabela.Pes_Codigo);
		buscaServicoEdt(registroTabela.Pes_Codigo);
		buscaCategoria(registroTabela.Pes_Codigo);
		buscaJornadaServico(registroTabela.Pes_Codigo)
		$("#pesCodigoEdtRemuneracao").val(registroTabela.Pes_Codigo)
		$("#pesCodigoEdtDeducao").val(registroTabela.Pes_Codigo)
		$("#spValorRemuneracao").val("");
		$("#spRemuneracao").val("").change();
		$scope.buscaServicoComboJornada()
		$scope.buscaProfissionalRemuneracao(registroTabela.Pes_Codigo)
		$scope.buscaTipoPessoaPagamento();
		$scope.buscaProfissionalDeducao(registroTabela.Pes_Codigo)
		$scope.buscaTipoPessoaDeducao();
		$scope.buscaPerfilUsuario(registroTabela.Usu_Codigo)

	}

