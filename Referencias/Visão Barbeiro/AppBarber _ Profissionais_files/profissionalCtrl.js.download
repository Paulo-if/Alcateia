	$('#spValorDeducao').on('change', function () {
		valor = parseFloat($(this).val().replace(',', '.'));
		if (valor > 100) {
			$('#spValorDeducao').val('100.00');
		} else if ($(this).val() < 0) {
			$('#spValorDeducao').val('0');
		}
	});

