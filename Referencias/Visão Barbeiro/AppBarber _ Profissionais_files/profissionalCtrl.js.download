	$scope.buscaServicoComboJornada = function () {
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/buscaServicoSelect.php',
			dataType: 'json',
			success: function (result) {
				var html = "";
				html += '<option value="">Serviço</option>';
				for (var i = 0; i < result.servicos.length; i++) {
					html += '<option value="' + result.servicos[i].Ser_Codigo + '">' + result.servicos[i].Ser_Descricao + '</option>';
				}

				$('#pjServico').html(html);
				$('#pjServico').select2();
			}
		});
	}

	$('#formJornadaEdtSer').submit(function (event) {
		event.preventDefault();
		if ($("#pjDiaSemanaEdtSer").val() != null) {
			if ($("#pjServico").val() != "") {
				formJornadaSer = $(this);
				dataJornada = new FormData(this);
				showLoader(true);
				$.ajax({
					type: 'POST',
					url: '/pages/cadastros/inserePessoaJornadaServico.php',
					data: dataJornada,
					dataType: 'json',
					processData: false,
					contentType: false,
					success: (result) => {
						if (result.data[0].erro == '0') {
							atualizaDados();
							buscaJornadaServico($('#pesCodigoWizSer').val());
							toastr.success(result.data[0].resultado);
							var diasDaSemana = $('#pjDiaSemanaEdtSer');
							diasDaSemana.multiselect('deselectAll', false);
							diasDaSemana.multiselect('updateButtonText');
							$('.select2').val(null).trigger('change');
							$("#pjServico").val("")
							$("#pjServico").change()
						} else {
							toastr.error(result.data[0].resultado);
						}
						showLoader(false);
					},
					error: () => {
						toastr.error($_CONFIG.language.errors.falha_conexao);
						showLoader(false);
					}
				});

				return true;

			} else {
				toastr.error('Selecione um serviço!');
				return false;
			}
		} else {
			toastr.error('Selecione um dia da semana!');
			return false;
		}
	});

