	$scope.reativaPessoa = function (pescodigo) {

		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/reativaPessoa.php',
			data: {
				tipo: 2,
				codigo: pescodigo
			},
			dataType: 'json',
			success: (result) => {
				if (result.data[0].erro == '0') {
					toastr.success(result.data[0].resultado);
					atualizaDados();
					
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: (result) => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
	}


	$scope.buscaPerfilUsuario = function(usuario){



		$(".btnAlteraAcessoUsuario").remove();
		$(".tipoAcessoProfissional").hide();

		if(usuario != ''){
			$("#profissionalComAcesso").show()
			$.ajax({
				type: 'POST',
				url: '/pages/cadastros/buscaUsuarioPerfil.php',
				data: {
					usuarioProfissional: usuario,
					tipo: 1
				},
				dataType: 'json',
				success: (result) => {
					if (result.data.length > 0) {
						if(result.data.length == 1){
							if(result.data[0].SMo_Codigo == 1){
								$("#acessoUsuWeb").append(`<button class="btn btn-danger btn-xs pull-right btnAlteraAcessoUsuario" ng-click="addUsuWeb(${usuario})">Bloqueado <i class="fa fa-lock"></i></button>`)
							}
							if(result.data[0].SMo_Codigo == 2){
								$("#acessoUsuApp").append(`<button class="btn btn-danger btn-xs pull-right btnAlteraAcessoUsuario" ng-click="addUsuApp(${usuario})">Bloqueado <i class="fa fa-lock"></i></button>`)
							}
						}
						for (var i = 0; i < result.data.length; i++) {
							if(result.data[i].SMo_Codigo == 1){
								$("#acessoUsuApp").append(`<button class="btn btn-success btn-xs pull-right btnAlteraAcessoUsuario"  ng-click="removeAcessoSistema(${result.data[i].UPe_Codigo},${usuario})">Liberado <i class="fa fa-unlock-alt"></i></button>`)
							}
							if(result.data[i].SMo_Codigo == 2){
								$("#acessoUsuWeb").append(`<button class="btn btn-success btn-xs pull-right btnAlteraAcessoUsuario"  ng-click="removeAcessoSistema(${result.data[i].UPe_Codigo},${usuario})">Liberado <i class="fa fa-unlock-alt"></i></button>`)
							}
						}
						$compile($('#acessoUsuWeb'))($scope);
						$compile($('#acessoUsuApp'))($scope);
					} else {
						if(result.data.erro != undefined){
							toastr.error($_CONFIG.language.errors.falha_conexao);
						}else{
							$("#acessoUsuWeb").append(`<button class="btn btn-danger btn-xs pull-right btnAlteraAcessoUsuario" ng-click="addUsuWeb(${usuario})">Bloqueado <i class="fa fa-lock"></i></button>`)
							$("#acessoUsuApp").append(`<button class="btn btn-danger btn-xs pull-right btnAlteraAcessoUsuario" ng-click="addUsuApp(${usuario})">Bloqueado <i class="fa fa-lock"></i></button>`)
							$compile($('#acessoUsuWeb'))($scope);
						$compile($('#acessoUsuApp'))($scope);
						}
					}
				},
				error: (result) => {
					toastr.error($_CONFIG.language.errors.falha_conexao);
				}
			});
		}else{
			$("#profissionalSemAcesso").show()
		}

	}


	$scope.removeAcessoSistema = function(upecodigo,usucodigo){

		

			swal({
				title: "Tem certeza que deseja bloquear essa forma de acesso do profissional?",
				text: "Ao bloquear uma forma de acesso do profissional, ele não poderá mais logar na plataforma especificada. <br> Caso deseje remover o acesso total, basta desativar o usuário!",
				type: "warning",
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: 'Sim',
				cancelButtonText: 'Não',
				closeOnConfirm: true,
				html:true
			}, function (isConfirm) {
				if (isConfirm) {
					showLoader(true)
					$.ajax({
						type: 'POST',
						url: '/pages/cadastros/removeUsuarioPerfil.php',
						data: {
							upecodigo: upecodigo
						},
						dataType: 'json',
						success: (result) => {
							if (result.data[0].erro == '0') {
								$scope.buscaPerfilUsuario(usucodigo)
								toastr.success(result.data[0].resultado);
							} else {
								toastr.error(result.data[0].resultado);
							}
							showLoader(false);
						},
						error: (result) => {
							toastr.error($_CONFIG.language.errors.falha_conexao);
							showLoader(false);
						}
					});
				} 
			});
		

	}


	$scope.addUsuWeb = function(usucodigo){

		if(isGestor){
			swal({
				title: "Tem certeza que deseja dar acesso ao módulo web para o profissional?",
				text: `Ao dar acesso ao módulo web, o profissional terá acesso a mais opções que no aplicativo. <br><br>Se prosseguir com a ativação, você pode limitar algumas ações com o perfil de acesso.<br><br>
				Para mais informações sobre o perfil de acesso <a class="btn btn-primary btn-xs" target="_blank" href="https://appbarber-appbeleza.zendesk.com/hc/pt-br/articles/360001572971-Como-montar-um-Perfil-de-Acesso-no-Webadmin">Clique Aqui!</a>`,
				type: "warning",
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: 'Sim',
				cancelButtonText: 'Não',
				closeOnConfirm: true,
				html: true
			}, function (isConfirm) {
				if (isConfirm) {
					var percodigo = '';
					$.ajax({
						type: 'POST',
						url: '/pages/cadastros/buscaUsuarioPerfil.php',
						data: {
							usuarioProfissional: usucodigo,
							tipo:2
						},
						dataType: 'json',
						success: (result) => {
							if (result.data.length > 0) {
								if (result.data[0].erro == '0') {
									percodigo = result.data[0].Per_Codigo;

									$.ajax({
										type: 'POST',
										url: '/pages/cadastros/insereUsuarioPerfil.php',
										data: {
											percodigo: percodigo,
											usucodigo:usucodigo
										},
										dataType: 'json',
										success: (result) => {
											if (result.data[0].erro == '0') {
												$scope.buscaPerfilUsuario(usucodigo)
												toastr.success(result.data[0].resultado);
											} else {
												toastr.error(result.data[0].resultado);
											}
											showLoader(false);
										},
										error: (result) => {
											toastr.error($_CONFIG.language.errors.falha_conexao);
											showLoader(false);
										}
									});
								} else {
									toastr.error(result.data[0].resultado);
								}
							} else {
								toastr.error($_CONFIG.language.errors.falha_conexao);
							}
						},
						error: (result) => {
							toastr.error($_CONFIG.language.errors.falha_conexao);
						}
					});
				
				} 
			});
		}else{
			toastr.error('A liberação de acesso deve ser feita por um usuário gestor');
		}
	}


	$scope.addUsuApp = function(usucodigo){
		if(isGestor){
			swal({
				title: "Tem certeza que deseja dar acesso ao módulo aplicativo para o profissional?",
				text: `O profissional terá acesso  a própria agenda e as proprias comissões pelo Aplicativo.<br> Demais funcionalidades podem ser limitadas/liberas pelos parâmetros do sistema!`,
				type: "warning",
				showCancelButton: true,
				confirmButtonColor: '#DD6B55',
				confirmButtonText: 'Sim',
				cancelButtonText: 'Não',
				closeOnConfirm: true,
				html: true
			}, function (isConfirm) {
				if (isConfirm) {
					var percodigo = '';
					$.ajax({
						type: 'POST',
						url: '/pages/cadastros/buscaUsuarioPerfil.php',
						data: {
							usuarioProfissional: usucodigo,
							tipo:3
						},
						dataType: 'json',
						success: (result) => {
							if (result.data.length > 0) {
								if (result.data[0].erro == '0') {
									percodigo = result.data[0].Per_Codigo;

									$.ajax({
										type: 'POST',
										url: '/pages/cadastros/insereUsuarioPerfil.php',
										data: {
											percodigo: percodigo,
											usucodigo:usucodigo
										},
										dataType: 'json',
										success: (result) => {
											if (result.data[0].erro == '0') {
												$scope.buscaPerfilUsuario(usucodigo)
												toastr.success(result.data[0].resultado);
											} else {
												toastr.error(result.data[0].resultado);
											}
											showLoader(false);
										},
										error: (result) => {
											toastr.error($_CONFIG.language.errors.falha_conexao);
											showLoader(false);
										}
									});
								} else {
									toastr.error(result.data[0].resultado);
								}
							} else {
								toastr.error($_CONFIG.language.errors.falha_conexao);
							}
						},
						error: (result) => {
							toastr.error($_CONFIG.language.errors.falha_conexao);
						}
					});
				
				} 
			});
		}else{
			toastr.error('A liberação de acesso deve ser feita por um usuário gestor');
		}

	}


	var localeDateRangePicker = {
        "format": "DD/MM/YYYY",
        "separator": " - ",
        "applyLabel": "Confirmar",
        "cancelLabel": "Cancelar",
        "fromLabel": "De",
        "toLabel": "Até",
        "customRangeLabel": "Personalizado",
        "weekLabel": "S",
        "daysOfWeek": [
            "Dom",
            "Seg",
            "Ter",
            "Qua",
            "Qui",
            "Sex",
            "Sab"
        ],
        "monthNames": [
            "Janeiro",
            "Fevereiro",
            "Março",
            "Abril",
            "Maio",
            "Junho",
            "Julho",
            "Agosto",
            "Setembro",
            "Outubro",
            "Novembro",
            "Dezembro"
        ],
        "firstDay": 1
    };

	function cb(start, end) {
        $('#reportrange span').html(start.format('MMMM D, YYYY') + ' - ' + end.format('MMMM D, YYYY'));
    }
    $('#dataJonadaPerido').daterangepicker({
        "locale": localeDateRangePicker
    }, cb);

	$('#dataJonadaPeridoEdt').daterangepicker({
        "locale": localeDateRangePicker
    }, cb);

});