	$scope.buscaValorAlteraServico = function () {
		$scope.alteraServico($('#pseCodigo').val(), $('#valComissao').val(), $('#serIntervalo').val(), $('#proCodigo').val(), $('#spValor').val());
	}

	$('#btnRemoveComissao').on('click', function () {
