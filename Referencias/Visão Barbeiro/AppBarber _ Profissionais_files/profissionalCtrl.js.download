	function atualizaDados() {
		showLoader(true);
		$rootScope.$emit('buscaProfissionalHeaderAgenda', {});
		tabelaprofissionais.ajax.reload(() => {
			showLoader(false);
			$compile($('#tbBuscaProf'))($scope);
		});

		tabelaprofissionaisexcluido.ajax.reload(() => {
			showLoader(false);
			$compile($('#tbBuscaProfExcluido'))($scope);
		});
	}

	function mostraNotas(data) {
		var html = "";
		if (data != "") {
			var nota = parseFloat(data);

			var fullStar = "<span><i class='fa fa-star'></i></span>";
			var halfStar = "<span><i class='fa fa-star-half-o'></i></span>";
			var emptyStar = "<span><i class='fa fa-star-o'></i></span>";
			var hintNota = "Nota: " + nota;
			if (nota == 0) {
				hintNota = "Sem Avaliação";
			}
			html += "<div class='row text-center' style='color: #F9A825; font-size: 18px;' data-toggle='tooltip' data-placement='top' title='" + hintNota + "'>";

			if (nota == 5) {
				html += (fullStar + fullStar + fullStar + fullStar + fullStar);
			} else if (nota > 4) {
				html += (fullStar + fullStar + fullStar + fullStar + halfStar);
			} else if (nota == 4) {
				html += (fullStar + fullStar + fullStar + fullStar + emptyStar);
			} else if (nota > 3) {
				html += (fullStar + fullStar + fullStar + halfStar + emptyStar);
			} else if (nota == 3) {
				html += (fullStar + fullStar + fullStar + emptyStar + emptyStar);
			} else if (nota > 2) {
				html += (fullStar + fullStar + halfStar + emptyStar + emptyStar);
			} else if (nota == 2) {
				html += (fullStar + fullStar + emptyStar + emptyStar + emptyStar);
			} else if (nota > 1) {
				html += (fullStar + halfStar + emptyStar + emptyStar + emptyStar);
			} else if (nota == 1) {
				html += (fullStar + emptyStar + emptyStar + emptyStar + emptyStar);
			} else if (nota > 0) {
				html += (halfStar + emptyStar + emptyStar + emptyStar + emptyStar);
			} else if (nota == 0) {
				html += (emptyStar + emptyStar + emptyStar + emptyStar + emptyStar);
			}

			html += '</div>';
		}
		return html;
	}

	function mostraDisponivelApp(data) {
		var html = "";
		if (data == "1") {
			html += "<i class='ion ion-iphone' style='margin:5px;' data-toggle='tooltip' data-placement='top' title='App'></i><i class='ion ion-ios-monitor-outline' style='margin:5px;' data-toggle='tooltip' data-placement='top' title='Web'></i>";
		} else {
			html += "<i class='ion ion-ios-monitor-outline' style='margin:5px;' data-toggle='tooltip' data-placement='top' title='Web'></i>";
		}
		return html;

	}

	$('#formCadastro').submit(function (event, obj) {
		event.preventDefault();
		formCadastro = $(this);
		showLoader(true);
		dataInsere.append("blob", mBlob);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/insereProfissionais.php',
			data: dataInsere,
			dataType: 'json',
			processData: false,
			contentType: false,
			success: (result) => {
				
					if (result.insereProfissional[0].erro == '0') {
						atualizaDados();
						toastr.success(result.insereProfissional[0].resultado);
						$('#cadastrar-modal').modal('hide');
	
						formCadastro.each(function () {
							this.reset();
						});
						mBlob = '';
					} else {
						toastr.error(result.insereProfissional[0].resultado);
					}
				
				showLoader(false);
			},
			error: () => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
		return true;
	});

	$('#formEditar').submit(function (event) {
		event.preventDefault();
		var noslashes = ($("#proApelidoEdt").val()).replace(/'/g,'');
		$("#proApelidoEdt").val(noslashes);
		showLoader(true);
		dataEdita = new FormData(this);
		dataEdita.append("blob", mBlob);
		$.ajax({
			type: 'POST',
			url: '/pages/cadastros/alteraProfissionais_v4.php',
			data: dataEdita,
			dataType: 'json',
			processData: false,
			contentType: false,
			success: (result) => {
				if (result.alteraProfissional[0].erro == '0') {
					toastr.success(result.alteraProfissional[0].resultado);
					atualizaDados();
					$('#editar-modal').modal('hide');

				} else {
					toastr.error(result.alteraProfissional[0].resultado);
				}
				showLoader(false);
			},
			error: () => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
		return true;
	});

	$('#formAlteraSenha').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		var gestor = 0;
		if ($("#proGestorEdt").is(":checked")) {
			gestor = 'on'
		}
		var dados = new FormData(this);
		dados.append('tipo', '1');

		$.ajax({
			type: "POST",
			url: "/pages/cadastros/alteraProfissionais.php",
			data: {
				proCodigoEdt: $("#pesCodigoAlt").val(),
				proNomeEdt: "",
				proEmailEdt: $("#usuarioAlt").val(),
				proCelularEdt: "",
				proRgEdt: "",
				proCpfEdt: "",
				proSexoEdt: "",
				proDataNascimentoEdt: "",
				proTelefoneEdt: "",
				proEnderecoEdt: "",
				proNumeroEdt: "",
				proComplementoEdt: "",
				proCepEdt: "",
				proBairroEdt: "",
				proObservacaoEdt: "",
				proCidadeEdt: "",
				proDispAppEdt: "",
				proApelidoEdt: "",
				proGestorEdt: gestor
			},
			dataType: "json",
			async: "false",
			success: (result) => {
				if (result.alteraProfissional[0].erro == "0") {

					$.ajax({
						type: 'POST',
						url: '/pages/cadastros/alteraSenha.php',
						data: dados,
						dataType: 'json',
						processData: false,
						contentType: false,
						success: (result) => {
							if (result.result[0].erro == '0') {
								toastr.success(result.result[0].resultado);
								$("#senhaAlt").val("");
								atualizaDados();
								$('#editar-modal').modal('hide');
							} else {
								toastr.error(result.result[0].resultado);
							}
							showLoader(false);
						},
						error: () => {
							toastr.error($_CONFIG.language.errors.falha_conexao);
							showLoader(false);
						}
					});

				} else {
					toastr.error(result.alteraProfissional[0].resultado);
					proceed = 0
					showLoader(false);
					return false
				}
			},
			error: () => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
				proceed = 0;
				return false;
			}
		});

		return true;
	});

	$('#proFotoWiz').fileinput({
		maxFilesNum: 1,
		showPreview: false,
		browseLabel: $_CONFIG.language.btn_procurar,
		removeLabel: $_CONFIG.language.btn_remover,
		browseIcon: '',
		language: "pt-BR",
