	})

	$scope.alteraServico = function (codigo, comissao, tempo, profissional, valor) {
		showLoader(true);
		$.ajax({
			dataType: 'json',
			method: 'POST',
			url: '/pages/cadastros/alteraServicoProfissionalv2.php',
			data: {
				psecodigo: codigo,
				comissao: comissao,
				temposervico: tempo,
				valor: valor
			},
			success: (data) => {
				if (data.result[0].erro == '0') {
					toastr.success($_CONFIG.language.mensagens.associacao_alterada);
					buscaServico(profissional);
					buscaServicoEdt(profissional);
				} else if (data.result[0].erro == '2') {
					toastr.warning(data.result[0].resultado);
					buscaServico(profissional);
					buscaServicoEdt(profissional);
				} else {
					toastr.error(data.result[0].resultado, $_CONFIG.language.mensagens.falha_alterar);
				}
				showLoader(false);
				$('#editarServico-modal').modal('hide');
			},
			error: () => {
				toastr.error($_CONFIG.language.errors.falha_conexao);
				showLoader(false);
			}
		});
	}

	$('#valComissao').on('keyup', function () {
		valor = $('#valComissao').val();
		valoa = parseInt(valor);
		if (valor >= 100) {
			$('#valComissao').val(100);
		}
	});

	$.ajax({
		type: 'POST',
		url: '/pages/cadastros/buscaCategoria.php',
		dataType: 'json',
		data: {
			tipo: 1
		},
		success: (result) => {
			for (var i = 0; i < result.data.length; i++) {
				categorias += "<option value='" + result.data[i].TCa_Codigo + "'>" + result.data[i].TCa_Descricao + "</option>";
			};
			$('#spCategoria').html(categorias);
			$('#spCategoria').multiselect({
				buttonText: function (options, select) {
					if (options.length === 0) {
						return 'Categorias';
					} else if (options.length > 3) {
						return $_CONFIG.language.mais_categorias_selecionada;
					} else {
						var labels = [];
						options.each(function () {
							if ($(this).attr('label') !== undefined) {
								labels.push($(this).attr('label'));
							} else {
								labels.push($(this).html());
							}
						});
						return labels.join(', ') + '';
					}
				},
				buttonWidth: '100%'
			});
		},
		error: () => {
			$('#spCategoria').multiselect();
		}
	});

	collapseAll();

