	function readImage(file) {
		var reader = new FileReader();
		var image = new Image();
		reader.readAsDataURL(file);
		reader.onload = function (_file) {
			image.src = _file.target.result;
			image.onload = function () {
				var w = this.width,
					h = this.height,
					t = file.type,
					n = file.name,
					s = ~~(file.size / 1024) + 'KB';

				if (s > 500) {
					alert($_CONFIG.language.imagem_maior_que + ' 500kb');
					$('#proFoto').fileinput('clear');
					formCadastro.proFoto.focus();
					return false;
				}
			};
			image.onerror = function () {
				alert('Invalid file type: ' + file.type);
				$('#proFoto').fileinput('clear');
				formCadastro.proFoto.focus();
				return false;
			};

		};
	}

