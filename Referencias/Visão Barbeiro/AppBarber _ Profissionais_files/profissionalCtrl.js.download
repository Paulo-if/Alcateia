angular.module('appBeleza').controller('profissionalCtrl', function ($compile, $rootScope, $scope, $state) {

	$rootScope.header = sSistema + ' | ' + $_CONFIG.language.profissionais.breadcrumb;
	$('#navProf').hide();
	$('#formProf').hide();

	$('[data-toggle="popover"]').popover({
		container: 'body'
	});

	$('.valorFormat').on('keyup', function (e) {
		formataValorDinheiro(this);
	});

	changeHeightBody();

	validaPerfil($state.current.name);

	$scope.dateFormat = $_CONFIG.language.mascaras.data;
	$scope.lang = $_CONFIG.language.mascaras.lang;
	var categorias = '';

	$('.input-group.date').datepicker({
		todayHighlight: true,
		language: $scope.lang,
		orientation: 'top',
		autoclose: true,
		format: $scope.dateFormat
	});

	$('[data-inputmask]').inputmask();

	$.ajax({
		dataType: 'json',
		url: localStorage.getItem('host'),
		data: {
			metodo: 'buscaParametro',
			id: $scope.idCliente,
			parcodigo: 58,
			origem: 1
		},
		success: function (data) {
			if (data.result[0] != '') {
				if (data.result[0].PVa_Vlr_Principal == '1') {
					$("#jornadaServico").show();
				} else {
					$("#jornadaServico").hide();
				}
			} else {
				$("#jornadaServico").hide();
			}
		}
	});

	if (typeof (parTempo) == 'undefined' || parTempo == '') {
		$.ajax({
			dataType: 'json',
			url: localStorage.getItem('host'),
			data: {
				metodo: 'buscaParametro',
				id: $scope.idCliente,
				parcodigo: 5,
				origem: 1
			},
			success: (data) => {
				if (data.result.length > 0) {
					if (data.result[0].PVa_Vlr_Principal == '40') {
						parTempo = '20';
					} else if (data.result[0].PVa_Vlr_Principal == '45') {
						parTempo = '15';
					} else {
						parTempo = data.result[0].PVa_Vlr_Principal;
					}
				} else {
					parTempo = '30';
				}
				$('.timepicker').timepicker({
					'timeFormat': 'H:i',
					'maxTime': '23',
					'minTime': '01',
					'forceRoundTime': true,
					'step': parseInt(parTempo)
				});
			}
		});
	} else {
		if (parTempo == '40') {
			parTempo = '20';
		} else if (parTempo == '45') {
			parTempo = '15';
		}
		$('.timepicker').timepicker({
			'timeFormat': 'H:i',
			'maxTime': '23',
			'minTime': '01',
			'forceRoundTime': true,
			'step': parseInt(parTempo)
		});

	}

	$scope.validar = function () {
		var proNome = formCadastro.proNome.value;
		var proCpf = formCadastro.proCpf.value;
		var proEmail = formCadastro.proEmail.value;
		var proCelular = formCadastro.proCelular.value;

		if (proNome == '') {
			alert($_CONFIG.language.errors.campo_nome);
			formCadastro.proNome.focus();
			return false;
		}

		if (proCpf == '') {
			alert($_CONFIG.language.errors.campo_cpf);
			formCadastro.proCpf.focus();
			return false;
		}

		if (proEmail == '') {
			alert($_CONFIG.language.errors.campo_email);
			formCadastro.proEmail.focus();
			return false;
		}

		if (proCelular == '') {
			alert($_CONFIG.language.errors.campo_celular);
			formCadastro.proCelular.focus();
			return false;
		}
	}

	$scope.validarAlterar = function () {
		var proSenha = formAlteraSenha.senhaAlt.value;

		if (proSenha == '') {
			toastr.error($_CONFIG.language.errors.campo_senha);
			formAlteraSenha.senhaAlt.focus();
			return false;
		}

	}

