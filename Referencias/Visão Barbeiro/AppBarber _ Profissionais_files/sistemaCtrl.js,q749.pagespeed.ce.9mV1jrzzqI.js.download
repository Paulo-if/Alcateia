      $scope.insereCaixaContaCli = function () {
        $(".divNumParcelasModal").hide();
        $("#parceladoContaCliModal").val(0);
        if ($("#insereCaixaContaCli").val() == 1) {
          $("#divPagamentoContaCli").show();
          $(".divParceladoModal").show();
          $scope.TipoPagamentoContaCliente();
        } else {
          $(".divParceladoModal").hide();
          $("#divPagamentoContaCli").hide();
        }
      };
      $("#insereCaixaContaCli").change(() => {
        $scope.insereCaixaContaCli();
      });

      $scope.TipoPagamentoContaCliente = function () {
        var tipopagamentocc = "";
        $scope.tiposPagamento = $_CONFIG.LISTA_PAGAMAENTO;
        tipopagamentocc +=
          "<option value='' selected>Tipo de Pagamento</option>";
        for (var i = 0; i < $scope.tiposPagamento.length; i++) {
          tipopagamentocc +=
            "<option value='" +
            $scope.tiposPagamento[i].TPa_Codigo +
            "'>" +
            $scope.tiposPagamento[i].TPa_Descricao +
            "</option>";
        }

        $("#tipoPagamentoContaCli").html(tipopagamentocc);
        $("#tipoBandeiraContaCli").html(
          "<option value=''>Sem Bandeira</option>"
        );
        $("#tipoBandeiraContaCli").prop("disabled", true);
      };

      $("#tipoPagamentoContaCli").change(function () {
        if ($("#tipoPagamentoContaCli").val() == "") {
          $("#tipoBandeiraContaCli").html(
            "<option value=''>Sem Bandeira</option>"
          );
          $("#tipoBandeiraContaCli").prop("disabled", true);
        } else {
          $("#tipoBandeiraContaCli").prop("disabled", false);
          $scope.buscaBandeiraContaCliente();
        }
      });

      $scope.buscaBandeiraContaCliente = function () {
        var tipobandeiracc = "";
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaTipoBandeira.php",
          data: {
            tipopagamento: $("#tipoPagamentoContaCli option:selected").val(),
          },
          dataType: "json",
          success: function (result) {
            $("#tipoBandeiraContaCli").val("");
            if ($("#tipoPagamentoContaCli option:selected").val() == "") {
              tipobandeiracc += "<option value=''>Sem Bandeira</option>";
            }

            if (result.data.length == 0) {
              tipobandeiracc += "<option value=''>Sem Bandeira</option>";
              $("#tipoBandeiraContaCli").prop("disabled", true);
            } else {
              for (var i = 0; i < result.data.length; i++) {
                tipobandeiracc +=
                  "<option value='" +
                  result.data[i].TBa_Codigo +
                  "'>" +
                  result.data[i].TBa_Descricao +
                  "</option>";
              }
              $("#tipoBandeiraContaCli").prop("disabled", false);
            }

            $("#tipoBandeiraContaCli").html(tipobandeiracc);
          },
          error: function (result) {},
        });
      };

      $scope.verificaSenhaContaCli = function () {
        if ($("#senhaInserecaixacontacli").html() == "1") {
          if ($("#insereCaixaContaCli").val() != 1) {
            var statesdemo = {
              state0: {
                title: "Insira a senha ",
                html: '<input class="form-control" type="password" name="password" id="password" value=""></label>',
                buttons: {
                  Ok: 1,
                },
                zIndex: 99999,
                submit: function (e, v, m, f) {
                  e.preventDefault();
                  if (f.password != null) {
                    $.ajax({
                      dataType: "json",
                      method: "POST",
                      url: "/php/verificaSenhaCaixa.php",
                      data: {
                        password: f.password,
                      },
                      success: function (data) {
                        if (data.erro == "0") {
                          $scope.insereContaClienteCredito(0);
                          $.prompt.close();
                        } else {
                          toastr.error(data.resultado);
                        }
                      },
                      error: function (data) {
                        toastr.error("Falha de conexão");
                      },
                    });
                  }
                },
              },
            };

            $.prompt(statesdemo);
          } else {
            if ($("#tipoPagamentoContaCli").val() != "") {
              $scope.insereContaClienteCredito(1);
            } else {
              toastr.error("Insira uma forma de pagamento");
            }
          }
        } else {
          if ($("#insereCaixaContaCli").val() == 1) {
            if ($("#tipoPagamentoContaCli").val() != "") {
              $scope.insereContaClienteCredito(1);} 
            else {
              toastr.error("Insira uma forma de pagamento");
            }
          } else {
            $scope.insereContaClienteCredito(0);
          }
        }
      };

      $scope.insereContaClienteCredito = function (inserecaixa) {
        if ($("#cliPesCodigoInfo").val() == "") {
          toastr.error("Informe um Cliente.");
        } else if ($("#ContaCliDescEnt").val() == "") {
          toastr.error("Informe a Descrição.");
        } else if ($("#ContaCliValorEnt").val() == "") {
          toastr.error("Informe o Valor.");
        } else if ($("#ContaCliDataEnt").val() == "") {
          toastr.error("Informe a data.");
        } else {
          showLoader(true);
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/insereContaCliente_v6.php",
            dataType: "json",
            data: {
              valor: $("#ContaCliValorEnt").maskMoney("unmasked")[0],
              tipo: 1,
              pescodigocliente: $("#cliPesCodigoInfo").val(),
              inserecaixa: inserecaixa,
              tpacodigo: $("#tipoPagamentoContaCli").val(),
              tbacodigo: $("#tipoBandeiraContaCli").val(),
              datalancamento: $("#ContaCliDataEnt").val(),
              descricao: $("#ContaCliDescEnt").val(),
              parceladoContaCli: $("#parceladoContaCliModal").val(),
              numParcelasContaCli: $("#numParcelasContaCliModal").val(),
              periodicidadeContaCli: $("#periodicidadeContaCliModal").val(),
            },
            success: function (result) {
              if (result.data[0].erro == "0") {
                toastr.success(result.data[0].resultado);
                $("#creditocontacli-modal").modal("hide");
                $("#insereCaixaContaCli").val(0);
                $scope.insereCaixaContaCli();
                $("#ContaCliDescEnt").val("");
                $("#ContaCliValorEnt").val(0);
                $("#ContaCliValorEnt").focus();
                $("#tbContaClienteInfo").dataTable().api().ajax.reload();
                $scope.buscaPessoaContaInfoCli($("#cliPesCodigoInfo").val());
              } else {
                toastr.error(result.data[0].resultado);
              }
              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
        }
      };

      $("#formDebitoContaCliente").submit(function (event) {
        if ($("#cliPesCodigoInfo").val() == "") {
          toastr.error("Informe um Cliente.");
          return false;
        } else if ($("#ContaCliDescSai").val() == "") {
          toastr.error("Informe a Descrição.");
        } else if ($("#ContaCliValorSai").val() == "") {
          toastr.error("Informe o Valor.");
        } else if ($("#ContaCliDataSai").val() == "") {
          toastr.error("Informe a data.");
        } else {
          event.preventDefault();
          formCadastroDebitoCli = $(this);
          dataForm = new FormData(this);
          dataForm.append(
            "valor",
            $("#ContaCliValorSai").maskMoney("unmasked")[0]
          );
          dataForm.append("tipo", "0");
          dataForm.append("pescodigo", $("#cliPesCodigoInfo").val());
          showLoader(true);

          $.ajax({
            type: "POST",
            url: "/pages/cadastros/insereContaCliente.php",
            data: dataForm,
            dataType: "json",
            processData: false,
            contentType: false,
            success: function (result) {
              if (result.result[0].erro == "0") {
                toastr.success(result.result[0].resultado);
                $("#debitocontacli-modal").modal("hide");
                formCadastroDebitoCli.each(function () {
                  this.reset();
                });
                $("#tbContaClienteInfo").dataTable().api().ajax.reload();
                $scope.buscaPessoaContaInfoCli($("#cliPesCodigoInfo").val());
              } else {
                toastr.error(result.result[0].resultado);
              }
              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });

          return true;
        }
      });

      $("#creditocontacli-modal").on("hidden.bs.modal", function (e) {
        $("#ContaCliValorEnt").val("");
        $("#ContaCliDescEnt").val("");

        $(".date.dataInContaCli").datepicker("update", dataabrecomanda);
        $("#insereCaixaContaCli").attr("checked", false);
        $scope.insereCaixaContaCli();
      });

      $("#debitocontacli-modal").on("hidden.bs.modal", function (e) {
        $("#ContaCliValorSai").val("");
        $("#ContaCliDescSai").val("");
        $("#ContaCliDataSai").val("");
      });

      $("#btnEnviaWhatsCliente").click(function () {
        $scope.sendWhatsCliente($("#cliCelularInfo").html());
      });

      $scope.sendWhatsCliente = function (celular) {
        var celular =
          $_CONFIG.language.mascaras.codigopais.replace("+", "") +
          celular
            .replace("(", "")
            .replace(")", "")
            .replace(" ", "")
            .replace("-", "");

        sendWhatsReminder(celular, "");
      };

      $scope.isUndefined = function (value) {
        if (value == undefined) {
          return "";
        } else {
          return value;
        }
      };

      $scope.mascaratelefonepaisatual = "";
      var listapais = [];
      if (localStorage.getItem("listaPaisTelefone") != null) {
        listapais = localStorage.getItem("listaPaisTelefone").split(",");
      }

      $scope.geraComboPaisTelefone = function (
        idfield,
        dialcode,
        ddi = undefined
      ) {
        var initpais = "br";

        if (ddi != undefined && ddi != "") {
          $.ajax({
            url: "./pages/cadastros/listaPaisDDI.json",
            dataType: "json",
            async: false,
            success: function (data) {
              initpais = data[ddi];
            },
          });
        } else {
          if ($_CONFIG.PAIS == 2) {
            initpais = "pt";
          } else if ($_CONFIG.PAIS == 10) {
            initpais = "py";
          } else if ($_CONFIG.PAIS == 11) {
            initpais = "bo";
          } else if ($_CONFIG.PAIS == 4) {
            initpais = "us";
          } else {
            initpais = "br";
          }
        }
        if (foo != undefined) {
          foo.destroy();
        }

        this[idfield + "selector"] = document.querySelector("#" + idfield);

        if (listapais == "" || listapais == undefined) {
          listapais = ["br", "pt", "py", "bo", "us"];
        }

        var foo = (this[idfield + "config"] = window.intlTelInput(
          this[idfield + "selector"],
          {
            initialCountry: initpais,
            preferredCountries: listapais,
            autoPlaceholder: "aggressive",
            utilsScript: "./js/utilsintelinput.js",
          }
        ));

        this[idfield + "selector"].addEventListener(
          "open:countrydropdown",
          function () {
            var mascara = this.placeholder;
            mascara = mascara
              .replaceAll("1", "0")
              .replaceAll("2", "0")
              .replaceAll("3", "0")
              .replaceAll("4", "0")
              .replaceAll("5", "0")
              .replaceAll("6", "0")
              .replaceAll("7", "0")
              .replaceAll("8", "0")
              .replaceAll("9", "0");
            $scope.mascaratelefonepaisatual = mascara;
            $("#" + idfield).unmask();
          }
        );

        this[idfield + "selector"].addEventListener(
          "close:countrydropdown",
          function () {
            var mascara = this.placeholder;

            mascara = mascara
              .replaceAll("1", "0")
              .replaceAll("2", "0")
              .replaceAll("3", "0")
              .replaceAll("4", "0")
              .replaceAll("5", "0")
              .replaceAll("6", "0")
              .replaceAll("7", "0")
              .replaceAll("8", "0")
              .replaceAll("9", "0");
            if (mascara == $scope.mascaratelefonepaisatual) {
              if ($scope.mascaratelefonepaisatual != "") {
                $("#" + idfield).mask($scope.mascaratelefonepaisatual);
                $("#" + dialcode).val(foo.getSelectedCountryData().dialCode);
              } else {
                $("#" + idfield).unmask();
              }
            }
          }
        );

        this[idfield + "selector"].addEventListener(
          "countrychange",
          function () {
            var index = listapais.indexOf(foo.getSelectedCountryData().iso2);
            if (index != -1) {
              listapais.splice(index, 1);
            }
            listapais.push(foo.getSelectedCountryData().iso2);

            localStorage.setItem("listaPaisTelefone", listapais);
            var mascara = this.placeholder;

            mascara = mascara
              .replaceAll("1", "0")
              .replaceAll("2", "0")
              .replaceAll("3", "0")
              .replaceAll("4", "0")
              .replaceAll("5", "0")
              .replaceAll("6", "0")
              .replaceAll("7", "0")
              .replaceAll("8", "0")
              .replaceAll("9", "0");
            $scope.mascaratelefonepaisatual = mascara;
            if ($scope.mascaratelefonepaisatual != "") {
              $("#" + idfield).mask($scope.mascaratelefonepaisatual);
              $("#" + dialcode).val(foo.getSelectedCountryData().dialCode);
            } else {
              $("#" + idfield).unmask();
            }
          }
        );

        setTimeout(function () {
          foo._triggerCountryChange();
          $("#" + idfield).mask(
            $("#" + idfield)[0]
              .placeholder.replaceAll("1", "0")
              .replaceAll("2", "0")
              .replaceAll("3", "0")
              .replaceAll("4", "0")
              .replaceAll("5", "0")
              .replaceAll("6", "0")
              .replaceAll("7", "0")
              .replaceAll("8", "0")
              .replaceAll("9", "0")
          );
          $("#" + dialcode).val(foo.getSelectedCountryData().dialCode);
        }, 1500);
      };

      $scope.emiteSemCliente = 1;
      $scope.emiteSemCPF = 1;
      $scope.emiteSemEndereco = 1;

      $scope.generateCupom = function (comanda, cliente, geraaproser = 0) {
        $("#cliCupomNome").val("");
        $("#cliCupomNomeProd").val("");
        $("#cliCupomEmail").val("");
        $("#cliCupomEmailProd").val("");
        $("#tipoPessoaNota").val("F");
        $("#tipoPessoaEmitProd").val("F");
        $("#cliCupomCPF").val("");
        $("#cliCupomCPFProd").val("");
        $("#cliCupomCEP").val("");
        $("#cliCupomCEPProd").val("");
        $("#cliCupomUF").val("");
        $("#cliCupomUFProd").val("");
        $("#cliCupomCidade").val("");
        $("#cliCupomCidadeProd").val("");
        $("#cliCupomBairro").val("");
        $("#cliCupomBairroProd").val("");
        $("#cliCupomLogradouro").val("");
        $("#cliCupomLogradouroProd").val("");
        $("#cliCupomNumero").val("");
        $("#cliCupomNumeroProd").val("");
        $("#cliCupomComplemento").val("");
        $("#cliCupomComplementoProd").val("");
        $("#cliCupomTelefoneProd").val("");
        showLoader(true);
        // geraproser
        // 0 - gera pros dois
        // 1 - gera só serviço
        // 2 - gera só produto
        $("#numComanda").html(comanda);
        $("#numComandaProd").html(comanda);
        $("#cliCupomObs").val("");
        $("#valorComissaoDisplay").val("");

        var valorPis = 0;
        var valorInss = 0;
        var valorCofins = 0;
        var valorIr = 0;
        var valorServicos = 0;
        var valorComissao = 0;
        var valorProduto = 0;
        var descricaoServicos = "";
        var citvalorProduto = 0;
        var numeroServico = 0;
        var numeroProduto = 0;
        var erroProduto = 0;
        var obsParceiro = "";
        var obsOriginal = "";

        var aplicaInfoClienteComandaObs = function () {
          var nomeClienteObs = $("#cliCupomNome").val() || "Consumidor Final";
          var textoAtual = $("#cliCupomObs")
            .val()
            .replace(/^Cliente: .*? - Comanda: .*?\n\n/, "");
          $("#cliCupomObs").val(
            `Cliente: ${nomeClienteObs} - Comanda: ${comanda}\n\n${textoAtual}`
          );
        };

        $("#usaEndereco").val(0).change();
        $("#usaEnderecoProd").val(0).change();

        $.ajax({
          dataType: "json",
          method: "POST",
          url: "/pages/cadastros/buscaComandaItens.php",
          async: false,
          data: {
            codigo: $("#numComanda").html(),
          },
          success: function (data) {
            $scope.itensComandaNota = data.data;
            for (var a = 0; a < $scope.itensComandaNota.length; a++) {
              if ($scope.itensComandaNota[a].Ser_Codigo != "") {
                if ($scope.parnfapacote == 1) {
                  if ($scope.itensComandaNota[a].PPD_Codigo == "") {
                    numeroServico++;
                  }
                } else {
                  numeroServico++;
                }
              } else if (
                $scope.itensComandaNota[a].CIt_Venda == 1 &&
                $scope.itensComandaNota[a].Pro_Gorjeta != 1 &&
                $scope.itensComandaNota[a].PPD_Codigo == ""
              ) {
                numeroProduto++;
              }
            }
          },
          error: function (data) {
            $scope.itensComandaNota = "";
          },
        });

        if (numeroServico > 0 && (geraaproser == 0 || geraaproser == 1)) {
          $scope.arrayMetadados = [];
          if ($scope.parnfse == 1) {
            for (var i = 0; i < $scope.itensComandaNota.length; i++) {
              if ($scope.itensComandaNota[i].Ser_Codigo != "") {
                if (i != 0) {
                  descricaoServicos += "; ";
                }

                var citvalor = parseFloat(
                  $scope.itensComandaNota[i].CIt_Valor.replace(",", ".")
                );
                var valorcomissaodesconto = parseFloat(
                  $scope.itensComandaNota[i].CIt_Comissao_Principal.replace(
                    ",",
                    "."
                  )
                );

                if ($scope.parnfapacote == 1) {
                  if ($scope.itensComandaNota[i].PPD_Codigo != "") {
                    citvalor = 0;
                    valorcomissaodesconto = 0;
                  }
                }

                if ($("#empresaCST").val() != "") {
                  $.ajax({
                    dataType: "json",
                    method: "POST",
                    url: "/pages/cadastros/buscaServicoSerCodigo.php",
                    async: false,
                    data: {
                      sercodigo: $scope.itensComandaNota[i].Ser_Codigo,
                    },
                    success: function (result) {
                      for (var j = 0; j < result.servicos.length; j++) {
                        valorPis =
                          valorPis +
                          (citvalor * result.servicos[j].Ser_Pis) / 100;
                        valorInss =
                          valorInss +
                          (citvalor * result.servicos[j].Ser_Inss) / 100;
                        valorCofins =
                          valorCofins +
                          (citvalor * result.servicos[j].Ser_Cofins) / 100;
                        valorIr =
                          valorIr +
                          (citvalor * result.servicos[j].Ser_Ir) / 100;
                      }
                      $("#valorPis").html(valorPis);
                      $("#valorInss").html(valorInss);
                      $("#valorCofins").html(valorCofins);
                      $("#valorClss").html(valorClss);
                      $("#valorIr").html(valorIr);
                    },
                    error: function (result) {
                      console.log(result);
                    },
                  });
                  $("#divCSTEmpresa").show();
                } else {
                  $("#divCSTEmpresa").hide();
                }
                $("#valorPis").html(valorPis);
                $("#valorInss").html(valorInss);
                $("#valorCofins").html(valorCofins);
                $("#valorClss").html(valorClss);
                $("#valorIr").html(valorIr);
                descricaoServicos += `${$scope.itensComandaNota[i].Ser_Descricao}  ${$scope.itensComandaNota[i].CIt_Valor}`;
                valorServicos = valorServicos + citvalor;
                console.log($scope.parnfdescontoparceiro);
                if ($scope.parnfdescontoparceiro == 1) {
                  var pesCodigoParceiro =
                    $scope.itensComandaNota[i].Pes_Codigo_Destino;
                  if (
                    pesCodigoParceiro != "" &&
                    pesCodigoParceiro != undefined
                  ) {
                    $.ajax({
                      type: "POST",
                      url: "/pages/cadastros/buscaPessoav2.php",
                      async: false,
                      data: {
                        tipo: 2,
                        pescodigo: pesCodigoParceiro,
                      },
                      dataType: "json",
                      success: function (result) {
                        if (result.data.length != 0) {
                          if (
                            result.data[0].PAF_CPF != "" &&
                            result.data[0].PNa_Codigo != ""
                          ) {
                            var cnpjParceiro = result.data[0].PAF_CPF;
                            $.ajax({
                              type: "POST",
                              url: "/pages/cadastros/buscaPessoaNaturezav2.php",
                              async: false,
                              data: {
                                tipo: "1",
                                pescodigo: pesCodigoParceiro,
                              },
                              dataType: "json",
                              success: function (result) {
                                var valorcomissaodesconto = parseFloat(
                                  $scope.itensComandaNota[i].CIt_Comissao_Principal.replace(",", ".")
                                );

                                if ($scope.parnfapacote == 1) {
                                  if ($scope.itensComandaNota[i].PPD_Codigo != "") {
                                    valorcomissaodesconto = 0;
                                  }
                               }

                                valorComissao =
                                  valorComissao + valorcomissaodesconto;
                                var profissional = "";
                                if ($scope.arrayMetadados.length > 0) {
                                  for (
                                    let j = 0;
                                    j < $scope.arrayMetadados.length;
                                    j++
                                  ) {
                                    if (
                                      $scope.arrayMetadados[j][0] ==
                                      pesCodigoParceiro
                                    ) {
                                      $scope.arrayMetadados[j][3] =
                                        $scope.arrayMetadados[j][3] +
                                        parseFloat(
                                          valorcomissaodesconto.toFixed(2)
                                        );
                                      break;
                                    } else {
                                      if (
                                        j ==
                                        $scope.arrayMetadados.length - 1
                                      ) {
                                        $scope.arrayMetadados.push([
                                          pesCodigoParceiro,
                                          result.data[0].Pes_Nome,
                                          cnpjParceiro,
                                          parseFloat(
                                            valorcomissaodesconto.toFixed(2)
                                          ),
                                          result.data[0].Codigo,
                                        ]);
                                        break;
                                      }
                                    }
                                  }
                                } else {
                                  $scope.arrayMetadados.push([
                                    pesCodigoParceiro,
                                    result.data[0].Pes_Nome,
                                    cnpjParceiro,
                                    parseFloat(
                                      valorcomissaodesconto.toFixed(2)
                                    ),
                                    result.data[0].Codigo,
                                  ]);
                                }
                                if ($scope.nomeProfissionalNota == 1) {
                                  profissional = `${result.data[0].Pes_Nome},`;
                                }
                                if (
                                  cnpjParceiro.replace(/\D/g, "").length >= 14
                                ) {
                                  obsParceiro += `R$ ${valorcomissaodesconto.toFixed(
                                    2
                                  )} de cota-parte profissional parceiro ${profissional} CNPJ ${cnpjParceiro}, emitida no código: ${
                                    result.data[0].Codigo
                                  };\n`;
                                  if (
                                    $_CONFIG.CODESTABELECIMENTO == 17169048 ||
                                    $_CONFIG.CODESTABELECIMENTO == 90 ||
                                    $_CONFIG.CODESTABELECIMENTO == 17774557 ||
                                    $_CONFIG.CODESTABELECIMENTO == 20657910 ||
                                    $_CONFIG.CODESTABELECIMENTO == 15084113
                                  ) {
                                    descricaoServicos += ` - R$ ${valorcomissaodesconto.toFixed(
                                      2
                                    )} de cota-parte profissional parceiro ${profissional} CNPJ ${cnpjParceiro}, emitida no código: ${
                                      result.data[0].Codigo
                                    }\n`;
                                  }
                                } else {
                                  obsParceiro += `R$ ${valorcomissaodesconto.toFixed(
                                    2
                                  )} de cota-parte profissional parceiro ${profissional} CPF ${cnpjParceiro}, emitida no código: ${
                                    result.data[0].Codigo
                                  };\n`;
                                  if (
                                    $_CONFIG.CODESTABELECIMENTO == 17169048 ||
                                    $_CONFIG.CODESTABELECIMENTO == 90 ||
                                    $_CONFIG.CODESTABELECIMENTO == 17774557 ||
                                    $_CONFIG.CODESTABELECIMENTO == 20657910 ||
                                    $_CONFIG.CODESTABELECIMENTO == 15084113
                                  ) {
                                    descricaoServicos += ` - R$ ${valorcomissaodesconto.toFixed(
                                      2
                                    )} de cota-parte profissional parceiro ${profissional} CPF ${cnpjParceiro}, emitida no código: ${
                                      result.data[0].Codigo
                                    }\n`;
                                  }
                                }
                              },
                              error: function (result) {
                                toastr.error("Falha na conexão.");
                              },
                            });
                          }
                        }
                      },
                      error: function (result) {
                        toastr.error("Falha na conexão.");
                      },
                    });
                  }
                }
              }
            }
          }
        }

        if (numeroProduto > 0 && (geraaproser == 0 || geraaproser == 2)) {
          if ($scope.parnfe == 1) {
            var itensArray = [];
            var htmlProdNota = "";
            for (var k = 0; k < $scope.itensComandaNota.length; k++) {
              if (
                $scope.itensComandaNota[k].Ser_Codigo == "" &&
                $scope.itensComandaNota[k].CIt_Venda == 1 &&
                ($scope.itensComandaNota[k].Pro_Gorjeta == 0 ||
                  $scope.itensComandaNota[k].Pro_Gorjeta == "")
              ) {
                citvalorProduto = parseFloat(
                  $scope.itensComandaNota[k].CIt_Valor.replace(",", ".")
                );
                $.ajax({
                  dataType: "json",
                  method: "POST",
                  url: "/pages/cadastros/buscaProdutosv2.php",
                  async: false,
                  data: {
                    procodigo: $scope.itensComandaNota[k].Pro_Codigo,
                  },
                  success: function (result) {
                    if (
                      result.data[0].Pro_Cfop == "" ||
                      result.data[0].Pro_ICMS == "" ||
                      result.data[0].Pro_Ncm == ""
                    ) {
                      erroProduto = 1;
                      numeroProduto = 0;
                      k = $scope.itensComandaNota.length;
                    } else {
                      htmlProdNota += `<tr>
														<td>
															${result.data[0].Pro_Descricao}
														</td>
														<td>
															${$scope.itensComandaNota[k].CIt_Quantidade}
														</td>
														<td>
															${$scope.itensComandaNota[k].CIt_Vlr_Unitario}
														</td>
														<td>
															<select id="proCfopLista${$scope.itensComandaNota[k].Pro_Codigo}${k}" >
																<option value="${result.data[0].Pro_Cfop}" data-produto="${result.data[0].Pro_Codigo}">${result.data[0].Pro_Cfop}</option>
																<option value="${result.data[0].Pro_Cfop_Secundario}" data-produto="${result.data[0].Pro_Codigo}">${result.data[0].Pro_Cfop_Secundario}</option>
															</select>
														</td>
													</tr>`;

                      $scope.createChangeCfop.push(
                        `proCfopLista${$scope.itensComandaNota[k].Pro_Codigo}${k}`
                      );

                      if (result.data[0].Pro_CEST == "") {
                        itensArray.push({
                          valorUnitario:
                            $scope.itensComandaNota[k].CIt_Vlr_Unitario,
                          quantidade: $scope.itensComandaNota[k].CIt_Quantidade,
                          unidadeMedida: "UN",
                          cfop: result.data[0].Pro_Cfop,
                          descricao: result.data[0].Pro_Descricao,
                          ncm: result.data[0].Pro_Ncm,
                          codigo: result.data[0].Pro_Codigo,
                          ean: result.data[0].Pro_Codigo_Barras,
                          eanTributavel: result.data[0].Pro_Codigo_Barras,
                          impostos: {
                            icms: {
                              situacaoTributaria: result.data[0].Pro_ICMS,
                              origem: 0,
                            },
                            pis: {
                              situacaoTributaria: result.data[0].Pro_Pis,
                            },
                            cofins: {
                              situacaoTributaria: result.data[0].Pro_Cofins,
                            },
                            ibsCbs: {
                              classificacaoTributaria: "000001",
                            },
                          },
                        });
                      } else {
                        itensArray.push({
                          valorUnitario:
                            $scope.itensComandaNota[k].CIt_Vlr_Unitario,
                          quantidade: $scope.itensComandaNota[k].CIt_Quantidade,
                          unidadeMedida: "UN",
                          cfop: result.data[0].Pro_Cfop,
                          descricao: result.data[0].Pro_Descricao,
                          ncm: result.data[0].Pro_Ncm,
                          codigo: result.data[0].Pro_Codigo,
                          cest: result.data[0].Pro_CEST,
                          ean: result.data[0].Pro_Codigo_Barras,
                          eanTributavel: result.data[0].Pro_Codigo_Barras,
                          impostos: {
                            icms: {
                              situacaoTributaria: result.data[0].Pro_ICMS,
                              origem: 0,
                            },
                            pis: {
                              situacaoTributaria: result.data[0].Pro_Pis,
                            },
                            cofins: {
                              situacaoTributaria: result.data[0].Pro_Cofins,
                            },
                            ibsCbs: {
                              classificacaoTributaria: "000001",
                            },
                          },
                        });
                      }
                    }
                  },
                  error: function (result) {
                    console.log(result);
                  },
                });
                valorProduto = valorProduto + citvalorProduto;
              }
            }

            $scope.produtosNota = JSON.stringify(itensArray);
            $("#tableItensNfProduto").html(htmlProdNota);
            $("#valorCupomProd").html(valorProduto);
            $("#valorCupomDisplayProd").val(
              `${$_CONFIG.MOEDA} ${valorProduto.toFixed(2).replace(",", ".")}`
            );

            for (var l = 0; l < $scope.createChangeCfop.length; l++) {
              $(`#${$scope.createChangeCfop[l]}`).change(function () {
                var procodigoloop = $(this).get(0)[0].dataset.produto;
                for (var m = 0; m < itensArray.length; m++) {
                  if (itensArray[m].codigo == procodigoloop) {
                    itensArray[m].cfop = this.value;
                    $scope.produtosNota = JSON.stringify(itensArray);
                  }
                }
              });
            }
          }
        }

        var html = "<option value=''>Estado</option>";
        for (var i = 0; i < $_CONFIG.LISTA_ESTADO.length; i++) {
          html +=
            "<option value='" +
            $_CONFIG.LISTA_ESTADO[i].Est_Sigla +
            "'> " +
            $_CONFIG.LISTA_ESTADO[i].Est_Sigla +
            "</option>";
        }

        $("#cliCupomUF").html(html);
        $("#cliCupomUFProd").html(html);
        $("#veiculoTranspoteNotaProd").html(html);
        $("#transporteNotaProd").val("SemOcorrenciaDeTransporte").change();

        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaPessoa.php",
          data: {
            tipo: 1,
          },
          dataType: "json",
          success: function (result) {
            $scope.dadosEmpresaNota = result.buscaPessoa[0];
            $("#empresaCNAE").val(result.buscaPessoa[0].CNAE);
            // $("#empresaCodigoNF").val(result.buscaPessoa[0].CodigoNF);
            //$("#empresaCodigoNFProd").val(result.buscaPessoa[0].CodigoNF);
            var codigoempresahtml = `<option value="${result.buscaPessoa[0].CodigoNF}">${result.buscaPessoa[0].CNPJ}</option>`;
            $.ajax({
              type: "POST",
              url: "/pages/cadastros/buscaPessoaEnotas.php",
              dataType: "json",
              async: false,
              success: function (result) {
                if (result.data.length > 0) {
                  for (var i = 0; i < result.data.length; i++) {
                    codigoempresahtml += `<option value="${result.data[i].PEn_Codigo_GW}">${result.data[i].PEn_CNPJ}</option>`;
                  }
                }
              },
              error: function (result) {},
            });

            $("#empresaCodigoNF").html(codigoempresahtml);
            $("#empresaCodigoNFProd").html(codigoempresahtml);
            $("#cidCodigoEmpresaNotaProduto").val(
              result.buscaPessoa[0].Cid_Codigo
            );
            $scope.emiteSemCliente =
              result.buscaPessoa[0].Cid_Emissao_SemCliente;
            $scope.emiteSemCPF = result.buscaPessoa[0].Cid_Emissao_SemCPF;
            $scope.emiteSemEndereco =
              result.buscaPessoa[0].Cid_Emissao_SemEndereco;
            $("#empresaCST").val(result.buscaPessoa[0].CST);

            if ($scope.emiteSemCliente == 0) {
              $("#nomeObrigatorio").show();
              $("#nomeObrigatorioProd").show();
            } else {
              $("#nomeObrigatorio").hide();
              $("#nomeObrigatorioProd").hide();
            }

            if ($scope.emiteSemCPF == 0) {
              $("#CPFObrigatorio").show();
              $("#CPFObrigatorioProd").show();
            } else {
              $("#CPFObrigatorio").hide();
              $("#CPFObrigatorioProd").hide();
            }

            if ($scope.emiteSemEndereco == 0) {
              $("#EstadoObrigatorio").show();
              $("#EstadoObrigatorioProd").show();
              $("#CidadeObrigatorio").show();
              $("#CidadeObrigatorioProd").show();
              $("#CepObrigatorio").show();
              $("#CepObrigatorioProd").show();
              $("#BairroObrigatorio").show();
              $("#BairroObrigatorioProd").show();
              $("#LogradouroObrigatorio").show();
              $("#LogradouroObrigatorioProd").show();
              $("#NumeroObrigatorio").show();
              $("#NumeroObrigatorioProd").show();
            } else {
              $("#EstadoObrigatorio").hide();
              $("#EstadoObrigatorioProd").hide();
              $("#CidadeObrigatorio").hide();
              $("#CidadeObrigatorioProd").hide();
              $("#CepObrigatorio").hide();
              $("#CepObrigatorioProd").hide();
              $("#BairroObrigatorio").hide();
              $("#BairroObrigatorioProd").hide();
              $("#LogradouroObrigatorio").hide();
              $("#LogradouroObrigatorioProd").hide();
              $("#NumeroObrigatorio").hide();
              $("#NumeroObrigatorioProd").hide();
            }

            $.ajax({
              type: "POST",
              url: "/pages/cadastros/buscaPessoaNatureza.php",
              data: {
                tipo: "1",
              },
              dataType: "json",
              success: function (result) {
                var naturezalista = "";
                for (var i = 0; i < result.data.length; i++) {
                  if (i == 0) {
                    naturezalista += `<option selected value='${result.data[i].Nat_Codigo_Externo}' data-nbs='${result.data[i].Nat_NBS}' data-itemlista='${result.data[i].PNa_Codigo_Municipal_Servico}' data-aliquota='${result.data[i].PNa_Aliquota}' data-federal='${result.data[i].Nat_IBPTFederal}' data-estadual='${result.data[i].Nat_IBPTEstadual}' data-municipal='${result.data[i].Nat_IBPTMunicipal}'>${result.data[i].Nat_Descricao}</option>`;
                    $("#oldValueNatureza").val(
                      result.data[i].Nat_Codigo_Externo
                    );
                  } else {
                    naturezalista += `<option value='${result.data[i].Nat_Codigo_Externo}'  data-nbs='${result.data[i].Nat_NBS}' data-itemlista='${result.data[i].PNa_Codigo_Municipal_Servico}' data-aliquota='${result.data[i].PNa_Aliquota}' data-federal='${result.data[i].Nat_IBPTFederal}' data-estadual='${result.data[i].Nat_IBPTEstadual}' data-municipal='${result.data[i].Nat_IBPTMunicipal}'>${result.data[i].Nat_Descricao}</option>`;
                  }
                }
                $("#servicoNatureza").unbind("change");
                $("#servicoNatureza").html(naturezalista);

                $("#servicoNatureza").on("change", function () {
                  if (
                    $("#servicoNatureza option:selected").get(0).dataset
                      .federal != "" &&
                    $("#servicoNatureza option:selected").get(0).dataset
                      .municipal != ""
                  ) {
                    var valoritem = parseFloat(
                      $("#valorCupom")
                        .html()
                        .replace($_CONFIG.MOEDA, "")
                        .replace(",", ".")
                    );

                    var federal =
                      (valoritem *
                        $("#servicoNatureza option:selected").get(0).dataset
                          .federal) /
                      100;
                    var estadual =
                      (valoritem *
                        $("#servicoNatureza option:selected").get(0).dataset
                          .estadual) /
                      100;
                    var municipal =
                      (valoritem *
                        $("#servicoNatureza option:selected").get(0).dataset
                          .municipal) /
                      100;

                    var preinfoOrigem = `Valor aproximado dos impostos: \nR$ ${federal.toFixed(
                      2
                    )} Federal, R$ ${estadual.toFixed(
                      2
                    )} Estadual, R$ ${municipal.toFixed(
                      2
                    )} Municipal Fonte: IBPT/FECOMERCIO\n\n`;

                    $("#cliCupomObs").val(`${preinfoOrigem} ${obsOriginal}`);
                  }
                  $("#cliCupomObs").val(
                    $("#cliCupomObs")
                      .val()
                      .replaceAll(
                        $("#oldValueNatureza").val(),
                        $("#servicoNatureza option:selected").val()
                      )
                  );
                  $("#oldValueNatureza").val(
                    $("#servicoNatureza option:selected").val()
                  );
                  aplicaInfoClienteComandaObs();
                });
                setTimeout(function () {
                  $("#servicoNatureza").trigger("change");
                }, 1000);
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
              },
            });

            var infoOrigem = "";
            var infoProcon = "";
            $("#valorCupom").html(valorServicos);

            if ($scope.dadosEmpresaNota.Pes_Codigo == 189886) {
              infoOrigem =
                "Fonte: IBPT/FECOMERCIO RJ - 18.1.A Resolução CGSN Nº 137, de 04 de Dezembro de 2017.\n";
            } else if (
              $scope.dadosEmpresaNota.Pes_Codigo == 8866546 ||
              $scope.dadosEmpresaNota.Pes_Codigo == 12690404 ||
              $scope.dadosEmpresaNota.Pes_Codigo == 320798 ||
              $scope.dadosEmpresaNota.Pes_Codigo == 7007706 ||
              $scope.dadosEmpresaNota.Pes_Codigo == 3224558 ||
              $scope.dadosEmpresaNota.Pes_Codigo == 13329906 ||
              $scope.dadosEmpresaNota.Pes_Codigo == 1034072 ||
              $scope.dadosEmpresaNota.Pes_Codigo == 20271388 ||
              $scope.dadosEmpresaNota.Pes_Codigo == 20657910
            ) {
              infoOrigem =
                "EMISSAO DE NOTA CONFORME RESOLUCAO CGSN N. 140, DE 22 DE MAIO DE 2018\n";
            } else if ($scope.dadosEmpresaNota.Pes_Codigo == 17774557) {
              infoOrigem =
                "Serviço prestado sob regime de parceria nos termos da Lei nº 13.352/2016\n";
            }else if ($scope.dadosEmpresaNota.Pes_Codigo == 10839540) {
              infoOrigem =
                "Valor aproximado dos tributos: 17,29% - Fonte IBPT\n";
            }

            if ($scope.dadosEmpresaNota.Cid_Codigo != "") {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/buscaCidadeProcon.php",
                async: false,
                data: {
                  cidcodigo: $scope.dadosEmpresaNota.Cid_Codigo,
                },
                dataType: "json",
                success: function (result) {
                  if (result.data.length > 0) {
                    infoProcon = `TELEFONE DO PROCON: ${result.data[0].CPo_Telefone} \n ENDERECO DO PROCON: ${result.data[0].CPo_Endereco}`;
                  }
                },
                error: function (result) {
                  toastr.error("Falha na conexão.");
                },
              });
            }
            $("#valorCupomDisplay").val(
              `${$_CONFIG.MOEDA} ${valorServicos.toFixed(2).replace(",", ".")}`
            );
            if ($_CONFIG.CODESTABELECIMENTO == 20657910) {
              descricaoServicos =
                descricaoServicos +
                "\nEMISSAO DE NOTA CONFORME RESOLUCAO CGSN N. 140, DE 22 DE MAIO DE 2018";
            }
            $("#servicosPrestados").html(descricaoServicos);
            $("#servicosPrestadosDisplay").val(descricaoServicos);
            if ($scope.parnfdescontoparceiro == 1) {
              if ($scope.parDescriaoSalaoParceiro == 1) {
                $("#valorComissaoDisplay").val(0.0);
              } else {
                $("#valorComissaoDisplay").val(valorComissao.toFixed(2));
              }

              if (obsParceiro != "") {
                let jsonmetadata = "";
                $("#cliCupomMetadata").val(``);
                if ($scope.arrayMetadados.length > 0) {
                  setTimeout(() => {
                    if (
                      $scope.dadosEmpresaNota.Pes_Codigo == 1315052 ||
                      $scope.dadosEmpresaNota.Pes_Codigo == 5386498 ||
                      $scope.dadosEmpresaNota.Pes_Codigo == 18835846 ||
                      $scope.dadosEmpresaNota.Pes_Codigo == 1033225 ||
                      $scope.dadosEmpresaNota.Pes_Codigo == 5768816 ||
                      $scope.dadosEmpresaNota.Pes_Codigo == 12333758
                    ) {
                      for (let j = 0; j < $scope.arrayMetadados.length; j++) {
                        jsonmetadata =
                          jsonmetadata +
                          `{"cnpj": "${
                            $scope.arrayMetadados[j][2]
                          }","razaoSocial": "${
                            $scope.arrayMetadados[j][1]
                          }","valorServico": ${parseFloat(
                            $scope.arrayMetadados[j][3].toFixed(2)
                          )},"codigoServicoParceiro": "${
                            $scope.arrayMetadados[j][4]
                          }"}`;
                        if (j != $scope.arrayMetadados.length - 1) {
                          jsonmetadata = jsonmetadata + ",";
                        }
                      }
                      $("#cliCupomMetadata").val(
                        `{"profissionaisParceiros": [${jsonmetadata}], "regimeEspecialTributacao": 3}`
                      );
                    } else if ($scope.dadosEmpresaNota.Pes_Codigo == 14724552) {
                      for (let j = 0; j < $scope.arrayMetadados.length; j++) {
                        jsonmetadata =
                          jsonmetadata +
                          `{"codigoServicoMunicipio": "${
                            $scope.arrayMetadados[j][4]
                          }","descricao": "Parceiro ${
                            $scope.arrayMetadados[j][1]
                          } CNPJ ${
                            $scope.arrayMetadados[j][2]
                          }","valorUnitario": "${parseFloat(
                            $scope.arrayMetadados[j][3].toFixed(2)
                          )}","quantidade": 1,"valorDesconto":0,"tributavel":"2","tipoDeducao":"P","cnae":"${$(
                            "#empresaCNAE"
                          ).val()}"}`;
                        if (j != $scope.arrayMetadados.length - 1) {
                          jsonmetadata = jsonmetadata + ",";
                        }
                      }
                      if (jsonmetadata != "") {
                        jsonmetadata =
                          jsonmetadata +
                          `,{"codigoServicoMunicipio": "${$(
                            "#servicoNatureza"
                          ).val()}","descricao": "${$(
                            "#servicosPrestados"
                          ).html()}","valorUnitario": "${(
                            valorServicos - valorComissao
                          ).toFixed(
                            2
                          )}","quantidade": 1,"valorDesconto":0,"tributavel":"1","cnae":"${$(
                            "#empresaCNAE"
                          ).val()}"}`;
                      } else {
                        jsonmetadata =
                          jsonmetadata +
                          `{"codigoServicoMunicipio": "${$(
                            "#servicoNatureza"
                          ).val()}","descricao": "${$(
                            "#servicosPrestados"
                          ).html()}","valorUnitario": "${(
                            valorServicos - valorComissao
                          ).toFixed(
                            2
                          )}","quantidade": 1,"valorDesconto":0,"tributavel":"1","cnae":"${$(
                            "#empresaCNAE"
                          ).val()}"}`;
                      }
                      $("#cliCupomMetadata").val(
                        `{"itens": [${jsonmetadata}]}`
                      );
                    }
                  }, 1000);
                }
                if($scope.dadosEmpresaNota.Pes_Codigo == 25733422){
                  $("#cliCupomObs").val(`${infoOrigem}R$ ${(valorServicos - valorComissao).toFixed(2)} de cota-parte do salão parceiro: ${$scope.dadosEmpresaNota.CNPJ}\n${obsParceiro} \n\n\n Conforme Lei do Salão-Parceiro (Lei nº 13.352/2016)\n\n ${infoProcon}`);
                }else{
                  $("#cliCupomObs").val(`${infoOrigem}R$ ${(valorServicos - valorComissao).toFixed(2)} de cota-parte do salão parceiro: ${$scope.dadosEmpresaNota.CNPJ}\n${obsParceiro} \n\n\n ${infoProcon}`);
                }
              } else {
                $("#cliCupomObs").val(`${infoOrigem}\n\n\n ${infoProcon}`);
                $("#cliCupomMetadata").val("");
              }
            } else {
              $("#valorComissaoDisplay").val(0.0);
              $("#cliCupomObs").val(`${infoOrigem} \n\n\n ${infoProcon}`);
            }

            obsOriginal = $("#cliCupomObs").val();
            aplicaInfoClienteComandaObs();
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
          },
        });

        if (cliente != "") {
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaPessoav2.php",
            data: {
              tipo: 1,
              pescodigo: cliente,
            },
            dataType: "json",
            success: function (result) {
              if (result.data.length > 0) {
                $scope.dadosClienteNota = result.data[0];
                $("#cliCupomNome").val(result.data[0].Pes_Nome);
                $("#cliCupomNomeProd").val(result.data[0].Pes_Nome);
                $("#cliCupomEmail").val(result.data[0].PAF_Email);
                $("#cliCupomEmailProd").val(result.data[0].PAF_Email);
                if (result.data[0].PAF_CPF.length <= 14) {
                  $("#tipoPessoaNota").val("F");
                } else {
                  $("#tipoPessoaNota").val("J");
                }
                if (result.data[0].PAF_CPF.length <= 14) {
                  $("#tipoPessoaEmitProd").val("F");
                } else {
                  $("#tipoPessoaEmitProd").val("J");
                }
                $("#cliCupomCPF").val(result.data[0].PAF_CPF);
                $("#cliCupomCPFProd").val(result.data[0].PAF_CPF);
                $("#cliCupomCEP").val(result.data[0].PAF_CEP);
                $("#cliCupomCEPProd").val(result.data[0].PAF_CEP);
                $("#cliCupomUF").val(result.data[0].Est_Sigla);
                $("#cliCupomUFProd").val(result.data[0].Est_Sigla);
                $("#cliCupomCidade").val(result.data[0].Cid_Nome);
                $("#cliCupomCidadeProd").val(result.data[0].Cid_Nome);
                $("#cliCupomBairro").val(result.data[0].PAF_Bairro);
                $("#cliCupomBairroProd").val(result.data[0].PAF_Bairro);
                $("#cliCupomLogradouro").val(result.data[0].PAF_Endereco);
                $("#cliCupomLogradouroProd").val(result.data[0].PAF_Endereco);
                $("#cliCupomNumero").val(result.data[0].PAF_Numero);
                $("#cliCupomNumeroProd").val(result.data[0].PAF_Numero);
                $("#cliCupomComplemento").val(result.data[0].PAF_Complemento);
                $("#cliCupomComplementoProd").val(
                  result.data[0].PAF_Complemento
                );
                $("#cliCupomTelefoneProd").val(result.data[0].PAF_Celular);
                aplicaInfoClienteComandaObs();
              }
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
            },
          });
        }

        setTimeout(() => {
          if ($scope.parEnderecoNota == 1) {
            $("#usaEndereco").val(1).change();
            $("#usaEnderecoProd").val(1).change();
          }

          aplicaInfoClienteComandaObs();

          showLoader(false);
        }, 1000);

        if (
          numeroServico > 0 &&
          (geraaproser == 0 || geraaproser == 1) &&
          $scope.parnfse == 1 &&
          valorServicos > 0
        ) {
          // if ($_CONFIG.CODESTABELECIMENTO == 9319370 && $scope.parnfce == 1) {
           // criaNotaConsumidor(comanda, cliente, 0);
          //} else {
            $("#generateCupon-modal").modal();
          //}
        }

        if (
          numeroProduto > 0 &&
          (geraaproser == 0 || geraaproser == 2) &&
          $scope.parnfe == 1
        ) {
          if ($scope.parnfce == 1) {
            criaNotaConsumidor(comanda, cliente, 1);
          } else {
            $("#generateCuponProduto-modal").modal();
          }
        }
        if (erroProduto == 1) {
          toastr.warning(
            'Favor, antes de fazer a emissão dos produtos, preencha todos os dados referentes emissão em "Cadastros > Produtos"'
          );
        }
      };

      $("#transporteNotaProd").on("change", function () {
        if ($("#transporteNotaProd").val() != "SemOcorrenciaDeTransporte") {
          $(".divDadosTransporte").show();
        } else {
          $(".divDadosTransporte").hide();
        }
      });

      function FormataStringData(data) {
        var dia = data.split("/")[0];
        var mes = data.split("/")[1];
        var ano = data.split("/")[2];

        return ano + "-" + ("0" + mes).slice(-2) + "-" + ("0" + dia).slice(-2);
      }

      $scope.criaCupom = function () {
        showLoader(true);
        var timegerado = new Date().getTime();
        var proceedNota = 1;
        var msgerro = "";

        var datacompetencia = "";

        if ($("#dataCompetencia").val() != "") {
          var dataString = new Date(
            FormataStringData($("#dataCompetencia").val())
          ).toISOString();
          datacompetencia = dataString;
        }

        if ($scope.emiteSemEndereco == undefined) {
          $scope.emiteSemEndereco = 1;
        } else if ($scope.emiteSemEndereco == 0) {
          if (
            $("#cliCupomUF").val() == "" ||
            $("#cliCupomUF").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o estado do cliente.";
          } else if (
            $("#cliCupomCidade").val() == "" ||
            $("#cliCupomCidade").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe a cidade do cliente.";
          } else if (
            $("#cliCupomCEP").val() == "" ||
            $("#cliCupomCEP").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o CEP do cliente.";
          } else if (
            $("#cliCupomBairro").val() == "" ||
            $("#cliCupomBairro").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o bairro do cliente.";
          } else if (
            $("#cliCupomLogradouro").val() == "" ||
            $("#cliCupomLogradouro").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o logradouro do cliente.";
          } else if (
            $("#cliCupomNumero").val() == "" ||
            $("#cliCupomNumero").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o numero do endereço do cliente.";
          }
        }

        if ($scope.emiteSemCPF == undefined) {
          $scope.emiteSemCPF = 1;
        } else if ($scope.emiteSemCPF == 0) {
          if (
            $("#cliCupomCPF").val() == "" ||
            $("#cliCupomCPF").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o CPF do tomador do serviço. Favor informe o CPF do cliente.";
          }
        }

        if ($scope.emiteSemCliente == undefined) {
          $scope.emiteSemCliente = 1;
        } else if ($scope.emiteSemCliente == 0) {
          if (
            $("#cliCupomNome").val() == "" ||
            $("#cliCupomNome").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o nome do tomador do serviço. Favor informe o nome do cliente.";
          }
        }

        if (
          $("#enviaCupomEmail").val() == "1" &&
          $("#cliCupomEmail").val() == ""
        ) {
          proceedNota = 0;
          msgerro = "Informe um e-mail pra o envio a emissão.";
        }

        if (proceedNota == 1) {
          if ($("#servicoNatureza option:selected").get(0) != undefined) {
            if (
              $("#empresaCodigoNF").val() != "" &&
              $("#empresaCodigoNF").val() != undefined
            ) {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/insereNotaFiscal.php",
                data: {
                  comcodigo: $("#numComanda").html(),
                  idEmpresa: $("#empresaCodigoNF").val(),
                  idExternoNota: $("#numComanda").html() + "_" + timegerado,
                  enviarEmail: $("#enviaCupomEmail").val(),
                  nomeCliente: $("#cliCupomNome").val(),
                  emailCliente: $("#cliCupomEmail").val(),
                  cpfCliente: $("#cliCupomCPF").val(),
                  logradouroCliente: $("#cliCupomLogradouro").val(),
                  numeroCliente: $("#cliCupomNumero").val(),
                  complementoCliente: $("#cliCupomComplemento").val(),
                  bairroCliente: $("#cliCupomBairro").val(),
                  cepCliente: $("#cliCupomCEP").val(),
                  ufCliente: $("#cliCupomUF").val(),
                  cidadeCliente: $("#cliCupomCidade").val(),
                  descricaoServico: $("#servicosPrestados").html(),
                  aliquotaIss: parseFloat(
                    $("#servicoNatureza option:selected").get(0).dataset
                      .aliquota
                  ),
                  itemServico: $("#servicoNatureza option:selected").get(0)
                    .dataset.itemlista,
                  cnae: $("#empresaCNAE").val(),
                  codigoServico: $("#servicoNatureza").val(),
                  valorTotal: parseFloat(
                    $("#valorCupom")
                      .html()
                      .replace($_CONFIG.MOEDA, "")
                      .replace(",", ".")
                  ),
                  timegerado: timegerado,
                  valorClss: parseFloat(
                    $("#valorClss").html().replace(",", ".")
                  ),
                  valorPis: parseFloat($("#valorPis").html().replace(",", ".")),
                  valorCofins: parseFloat(
                    $("#valorCofins").html().replace(",", ".")
                  ),
                  valorInss: parseFloat(
                    $("#valorInss").html().replace(",", ".")
                  ),
                  valorIr: parseFloat($("#valorIr").html().replace(",", ".")),
                  observacao: $("#cliCupomObs").val(),
                  deducoes: $("#valorComissaoDisplay").val(),
                  tipoPessoa: $("#tipoPessoaNota").val(),
                  ie: $("#cliCupomIE").val(),
                  im: $("#cliCupomIM").val(),
                  datacompetencia: datacompetencia,
                  descricaocidadeservico: $(
                    "#servicoNatureza option:selected"
                  ).get(0).text,
                  metadados: $("#cliCupomMetadata").val(),
                  codigoNBS: $("#servicoNatureza option:selected").get(0)
                    .dataset.nbs,
                },
                dataType: "json",
                success: function (result) {
                  showLoader(false);
                  if (result.data[0].erro == 1) {
                    toastr.warning(result.data[0].resultado);
                  } else {
                    toastr.warning(result.resultNota.erronf);
                    if (
                      result.resultNota.nfid == "" ||
                      result.resultNota.nfid == undefined
                    ) {
                      $.ajax({
                        type: "POST",
                        url: "/pages/cadastros/removeComandaNotaFiscal.php",
                        data: {
                          cnfcodigoexterno:
                            $("#numComanda").html() + "_" + timegerado,
                        },
                        dataType: "json",
                        success: function (data) {
                          if (data.data.erro != undefined) {
                            toastr.error(data.data.resultado);
                          } else {
                            if (data.data[0].erro == "0") {
                              toastr.success(data.data[0].resultado);
                            } else {
                              toastr.error(data.data[0].resultado);
                            }
                          }
                        },
                        error: function (result) {
                          toastr.error("Falha na conexão.");
                        },
                      });
                    }
                    $("#generateCupon-modal").modal("hide");
                  }
                  if (location.hash == "#/emissoes") {
                    $rootScope.$emit("buscaRelatorioEmissao", {});
                  }
                },
                error: function (result) {
                  showLoader(false);
                  toastr.error("Falha na conexão.");
                },
              });
            } else {
              showLoader(false);
              toastr.error("Informe o ID da empresa");
            }
          } else {
            showLoader(false);
            toastr.error("Selecione o Serviço");
          }
        } else {
          showLoader(false);
          toastr.error(msgerro);
        }
      };

      $scope.criaCupomProd = function () {
        showLoader(true);
        var timegerado = new Date().getTime();
        var proceedNota = 1;
        var msgerro = "";

        if (
          $("#cliCupomUFProd").val() == "" ||
          $("#cliCupomUFProd").val() == undefined
        ) {
          proceedNota = 0;
          msgerro =
            "Endereço é obrigatório para nota de produtos. Favor informe o estado do cliente.";
        } else if (
          $("#cliCupomCidadeProd").val() == "" ||
          $("#cliCupomCidadeProd").val() == undefined
        ) {
          proceedNota = 0;
          msgerro =
            "Endereço é obrigatório para nota de produtos. Favor informe a cidade do cliente.";
        } else if (
          $("#cliCupomCEPProd").val() == "" ||
          $("#cliCupomCEPProd").val() == undefined
        ) {
          proceedNota = 0;
          msgerro =
            "Endereço é obrigatório para nota de produtos. Favor informe o CEP do cliente.";
        } else if (
          $("#cliCupomBairroProd").val() == "" ||
          $("#cliCupomBairroProd").val() == undefined
        ) {
          proceedNota = 0;
          msgerro =
            "Endereço é obrigatório para nota de produtos. Favor informe o bairro do cliente.";
        } else if (
          $("#cliCupomLogradouroProd").val() == "" ||
          $("#cliCupomLogradouroProd").val() == undefined
        ) {
          proceedNota = 0;
          msgerro =
            "Endereço é obrigatório para nota de produtos. Favor informe o logradouro do cliente.";
        } else if (
          $("#cliCupomNumeroProd").val() == "" ||
          $("#cliCupomNumeroProd").val() == undefined
        ) {
          proceedNota = 0;
          msgerro =
            "Endereço é obrigatório para nota de produtos. Favor informe o numero do endereço do cliente.";
        }

        if (
          $("#cliCupomCPFProd").val() == "" ||
          $("#cliCupomCPFProd").val() == undefined
        ) {
          proceedNota = 0;
          msgerro =
            "Sua cidade exige o CPF do tomador do serviço. Favor informe o CPF do cliente.";
        }

        if ($scope.emiteSemCliente == undefined) {
          $scope.emiteSemCliente = 1;
        } else if ($scope.emiteSemCliente == 0) {
          if (
            $("#cliCupomNomeProd").val() == "" ||
            $("#cliCupomNomeProd").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o nome do tomador do serviço. Favor informe o nome do cliente.";
          }
        }

        if (
          $("#enviaCupomEmailProd").val() == "1" &&
          $("#cliCupomEmailProd").val() == ""
        ) {
          proceedNota = 0;
          msgerro = "Informe um e-mail pra o envio a emissão.";
        }

        if (proceedNota == 1) {
          var infoProcon = "";
          if ($("#cidCodigoEmpresaNotaProduto").val() != "") {
            $.ajax({
              type: "POST",
              url: "/pages/cadastros/buscaCidadeProcon.php",
              async: false,
              data: {
                cidcodigo: $("#cidCodigoEmpresaNotaProduto").val(),
              },
              dataType: "json",
              success: function (result) {
                if (result.data.length > 0) {
                  infoProcon = `TELEFONE DO PROCON: ${result.data[0].CPo_Telefone} \n ENDERECO DO PROCON: ${result.data[0].CPo_Endereco}`;
                }
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
              },
            });
          }

          $.ajax({
            dataType: "json",
            url: localStorage.getItem("host"),
            async: false,
            data: {
              metodo: "buscaComanda",
              id: $_CONFIG.ID,
              comcodigo: $("#numComandaProd").html(),
              tipo: 6,
            },
            success: function (data) {
              if (data.result[0].TPa_Descricao != "") {
                $scope.tpapagamento = data.result[0].TPa_Descricao;
                if (data.result[0].TBa_Descricao != "") {
                  $scope.tbapagamento = data.result[0].TBa_Descricao;
                }
              }
            },
            error: function () {
              swal("Falha na conexão.", "", "error");
            },
          });

          if ($scope.tpapagamento != "") {
            $scope.arrPagamento = [];
            var descricaoPagamento = "";
            $scope.valorPagamentoNota = parseFloat(
              $("#valorCupomDisplayProd")
                .val()
                .replace($_CONFIG.MOEDA, "")
                .replace(" ", "")
            );
            var pushPagamento = "";
            if (
              $scope.tpapagamento == "Dinheiro" ||
              $scope.tpapagamento == "dinheiro"
            ) {
              pushPagamento = "Dinheiro";
            } else if (
              $scope.tpapagamento == "Cartão de Crédito" ||
              $scope.tpapagamento == "cartão de crédito"
            ) {
              pushPagamento = "CartaoDeCredito";
            } else if (
              $scope.tpapagamento == "Cartão de Débito" ||
              $scope.tpapagamento == "cartão de débito"
            ) {
              pushPagamento = "CartaoDeDebito";
            } else if (
              $scope.tpapagamento == "Cheque" ||
              $scope.tpapagamento == "cheque"
            ) {
              pushPagamento = "Cheque";
            } else if (
              $scope.tpapagamento == "Boleto" ||
              $scope.tpapagamento == "boleto"
            ) {
              pushPagamento = "BoletoBancario";
            } else if (
              $scope.tpapagamento == "PIX" ||
              $scope.tpapagamento == "pix" ||
              $scope.tpapagamento == "Pix"
            ) {
              pushPagamento = "PagamentoInstantaneoPix";
            } else if (
              $scope.tpapagamento == "Resgate de Pontos" ||
              $scope.tpapagamento == "resgate de pontos"
            ) {
              pushPagamento = "ProgramaFidelidadeCashbackCarteiraVirtual";
            } else {
              descricaoPagamento = $scope.tpapagamento;
              pushPagamento = "Outros";
            }

            if (descricaoPagamento != "") {
              $scope.arrPagamento.push({
                tipo: pushPagamento,
                valor: $scope.valorPagamentoNota,
                descricao: descricaoPagamento,
              });
            } else {
              if (
                pushPagamento == "CartaoDeCredito" ||
                pushPagamento == "CartaoDeDebito"
              ) {
                $scope.arrPagamento.push({
                  tipo: pushPagamento,
                  valor: $scope.valorPagamentoNota,
                  credenciadoraCartao: {
                    tipoIntegracaoPagamento: "NaoIntegradoAoSistemaDeGestao",
                  },
                });
              } else {
                $scope.arrPagamento.push({
                  tipo: pushPagamento,
                  valor: $scope.valorPagamentoNota,
                });
              }
            }
          } else {
            $scope.arrPagamento.push({
              tipo: "Dinheiro",
              valor: $scope.valorPagamentoNota,
            });
          }

          if (
            $("#empresaCodigoNFProd").val() != "" &&
            $("#empresaCodigoNFProd").val() != undefined
          ) {
            if (infoProcon != "") {
              var infoaddnota = `${$("#cliCupomAdInfo").val()} \n${infoProcon}`;
            } else {
              var infoaddnota = $("#cliCupomAdInfo").val();
            }
            if ($("#transporteNotaProd").val() == "SemOcorrenciaDeTransporte") {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/insereNotaFiscalProdutos.php",
                data: {
                  comcodigo: $("#numComandaProd").html(),
                  idEmpresa: $("#empresaCodigoNFProd").val(),
                  idExternoNota: $("#numComandaProd").html() + "_" + timegerado,
                  enviarEmail: $("#enviaCupomEmailProd").val(),
                  nomeCliente: $("#cliCupomNomeProd").val(),
                  telefoneCliente: $("#cliCupomTelefoneProd").val(),
                  emailCliente: $("#cliCupomEmailProd").val(),
                  cpfCliente: $("#cliCupomCPFProd").val(),
                  logradouroCliente: $("#cliCupomLogradouroProd").val(),
                  numeroCliente: $("#cliCupomNumeroProd").val(),
                  complementoCliente: $("#cliCupomComplementoProd").val(),
                  bairroCliente: $("#cliCupomBairroProd").val(),
                  cepCliente: $("#cliCupomCEPProd").val(),
                  ufCliente: $("#cliCupomUFProd").val(),
                  cidadeCliente: $("#cliCupomCidadeProd").val(),
                  item: $scope.produtosNota,
                  timegerado: timegerado,
                  tipoemissao: 1,
                  pagamento: JSON.stringify($scope.arrPagamento),
                  tipoPessoaEmitProd: $("#tipoPessoaEmitProd").val(),
                  ie: $("#cliCupomIEProd").val(),
                  im: $("#cliCupomIMProd").val(),
                  informacaoAdicional: infoaddnota,
                  natureza: $("#naturezaNotaProduto").val(),
                  /*,datacompetencia: datacompetenciaprod*/
                },
                dataType: "json",
                success: function (result) {
                  showLoader(false);
                  if (result.data[0].erro == 1) {
                    toastr.warning(result.data[0].resultado);
                  } else {
                    toastr.warning(result.resultNota.erronf);
                    if (
                      result.resultNota.nfid == "" ||
                      result.resultNota.nfid == undefined
                    ) {
                      $.ajax({
                        type: "POST",
                        url: "/pages/cadastros/removeComandaNotaFiscal.php",
                        data: {
                          cnfcodigoexterno:
                            $("#numComandaProd").html() + "_" + timegerado,
                        },
                        dataType: "json",
                        success: function (data) {
                          if (data.data.erro != undefined) {
                            toastr.error(data.data.resultado);
                          } else {
                            if (data.data[0].erro == "0") {
                              toastr.success(data.data[0].resultado);
                            } else {
                              toastr.error(data.data[0].resultado);
                            }
                          }
                        },
                        error: function (result) {
                          toastr.error("Falha na conexão.");
                        },
                      });
                    }
                    $("#generateCuponProduto-modal").modal("hide");
                  }
                },
                error: function (result) {
                  showLoader(false);
                  toastr.error("Falha na conexão.");
                },
              });
            } else {
              /*---------------------------------------------------------------------*/

              $.ajax({
                type: "POST",
                url: "/pages/cadastros/insereNotaFiscalProdutosv2.php",
                data: {
                  comcodigo: $("#numComandaProd").html(),
                  idEmpresa: $("#empresaCodigoNFProd").val(),
                  idExternoNota: $("#numComandaProd").html() + "_" + timegerado,
                  enviarEmail: $("#enviaCupomEmailProd").val(),
                  nomeCliente: $("#cliCupomNomeProd").val(),
                  telefoneCliente: $("#cliCupomTelefoneProd").val(),
                  emailCliente: $("#cliCupomEmailProd").val(),
                  cpfCliente: $("#cliCupomCPFProd").val(),
                  logradouroCliente: $("#cliCupomLogradouroProd").val(),
                  numeroCliente: $("#cliCupomNumeroProd").val(),
                  complementoCliente: $("#cliCupomComplementoProd").val(),
                  bairroCliente: $("#cliCupomBairroProd").val(),
                  cepCliente: $("#cliCupomCEPProd").val(),
                  ufCliente: $("#cliCupomUFProd").val(),
                  cidadeCliente: $("#cliCupomCidadeProd").val(),
                  item: $scope.produtosNota,
                  timegerado: timegerado,
                  tipoemissao: 1,
                  pagamento: JSON.stringify($scope.arrPagamento),
                  tipoPessoaEmitProd: $("#tipoPessoaEmitProd").val(),
                  ie: $("#cliCupomIEProd").val(),
                  im: $("#cliCupomIMProd").val(),
                  informacaoAdicional: infoaddnota,
                  natureza: $("#naturezaNotaProduto").val(),
                  modalidadeTransporte: $("#transporteNotaProd").val(),
                  usarDadosEmitente: "",
                  tipoPessoaTransportadora: $(
                    "#transportadoraNotaProd option:selected"
                  ).get(0).dataset.tipopessoa,
                  cpfcnpjTransportadora: $(
                    "#transportadoraNotaProd option:selected"
                  ).get(0).dataset.cnpj,
                  nomeTransportadora: $("#transportadoraNotaProd ").val(),
                  ieTransportadora: $(
                    "#transportadoraNotaProd option:selected"
                  ).get(0).dataset.ie,
                  enderecoTransportadora: $(
                    "#transportadoraNotaProd option:selected"
                  ).get(0).dataset.endereco,
                  ufTransportadora: $(
                    "#transportadoraNotaProd option:selected"
                  ).get(0).dataset.uf,
                  cidadeTransportadora: $(
                    "#transportadoraNotaProd option:selected"
                  ).get(0).dataset.cidade,
                  veiculoPlaca: $("#placaVeiculoTranspoteNotaProd").val(),
                  veiculoUF: $("#veiculoTranspoteNotaProd").val(),
                  qtdVolume: $("#qtdTransporteNota").val(),
                  especieVolume: $("#especieTransporteNotaProd").val(),
                  marcaVolume: $("#marcaTransporteNotaProd").val(),
                  numeracaoVolume: $("#numeracaoTransporteNotaProd").val(),
                  pesoBrutoVomume: $("#pesoBrutoNotaProd").val(),
                  pesoLiqVolume: $("#pesoLiquidoNotaProd").val(),
                },
                dataType: "json",
                success: function (result) {
                  showLoader(false);
                  if (result.data[0].erro == 1) {
                    toastr.warning(result.data[0].resultado);
                  } else {
                    toastr.warning(result.resultNota.erronf);
                    if (
                      result.resultNota.nfid == "" ||
                      result.resultNota.nfid == undefined
                    ) {
                      $.ajax({
                        type: "POST",
                        url: "/pages/cadastros/removeComandaNotaFiscal.php",
                        data: {
                          cnfcodigoexterno:
                            $("#numComandaProd").html() + "_" + timegerado,
                        },
                        dataType: "json",
                        success: function (data) {
                          if (data.data.erro != undefined) {
                            toastr.error(data.data.resultado);
                          } else {
                            if (data.data[0].erro == "0") {
                              toastr.success(data.data[0].resultado);
                            } else {
                              toastr.error(data.data[0].resultado);
                            }
                          }
                        },
                        error: function (result) {
                          toastr.error("Falha na conexão.");
                        },
                      });
                    }
                    $("#generateCuponProduto-modal").modal("hide");
                  }
                },
                error: function (result) {
                  showLoader(false);
                  toastr.error("Falha na conexão.");
                },
              });

              /*---------------------------------------------------------------------*/
            }
          } else {
            showLoader(false);
            toastr.error("Informe o ID da empresa");
          }
        } else {
          showLoader(false);
          toastr.error(msgerro);
        }
      };

      $scope.lang = $_CONFIG.language.mascaras.lang;

      $scope.diplayGorjeta = function () {
        $("#comandaInsereGorjeta-modal").modal();
      };

      $scope.insereComandaGorjeta = function () {
        showLoader(true);
        $.ajax({
          dataType: "json",
          method: "POST",
          url: "/pages/cadastros/insereComandaGorjeta.php",
          data: {
            profissional: $("#profissionalGorjeta").val(),
            valor: $("#valorComandaGorjeta").val(),
            comcodigo: $("#idComanda").html(),
          },
          success: function (data) {
            if (data.data.erro != undefined) {
              toastr.error(data.data.resultado);
            } else {
              if (data.data[0].erro == "0") {
                toastr.success(data.data[0].resultado);
                $scope.atualizaDadosItens();
                if (location.hash == "#/comandasabertas") {
                  $rootScope.$emit("atualizaDadosComanda", {});
                }
                $("#comandaInsereGorjeta-modal").modal("hide");
                $("#valorComandaGorjeta").val("");
                $("#profissionalGorjeta").val("");
              } else {
                toastr.error(data.data[0].resultado);
              }
            }
            showLoader(false);
          },
        });
      };

      $scope.alteraComandaGorjeta = function () {
        showLoader(true);
        $.ajax({
          dataType: "json",
          method: "POST",
          url: "/pages/cadastros/alteraComandaGorjeta.php",
          data: {
