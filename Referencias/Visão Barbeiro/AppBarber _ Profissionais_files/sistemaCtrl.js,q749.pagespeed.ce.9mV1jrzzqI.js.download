angular
  .module("appBeleza")
  .controller(
    "sistemaCtrl",
    function ($rootScope, $scope, $compile, $state, $translate, $sce) {
      $scope.idCliente = $_CONFIG.ID;
      $scope.tiposPagamento = "";
      $scope.manyClients = false;
      $scope.textMax = "110";
      $scope.mensagempreview = "";
      $scope.datamensagempreview = "";
      $scope.horaenviomensagenpreview = "";
      $scope.sistemaName = $Options.sistema;
      $scope.sistemaColor = $Options.sistemaCor;
      $scope.nomeEmpresa = $_CONFIG.ESTABELECIMENTO;
      $scope.parnota = 0;
      $scope.parnfse = 0;
      $scope.parnfe = 0;
      $scope.parnfce = 0;
      $scope.parnfapacote = 0;
      $scope.parnfssinatura = 0;
      $scope.emitnota = 0;
      $scope.nomeProfissionalNota = 0;
      $scope.caixinha = 0;
      $scope.geracomissaoprof = 0;
      $scope.numImagemProntuario = 0;
      $scope.parnfdescontoparceiro = 0;
      $scope.itensComandaNota = "";
      $scope.itensPacoteNota = "";
      $scope.produtosNota = "";
      $scope.produtosNotaPacote = "";
      $scope.dadosEmpresaNota = "";
      $scope.dadosEmpresaNotaPacote = "";
      $scope.dadosEmpresaNotaAssinatura = "";
      $scope.dadosClienteNota = "";
      $scope.dadosClienteNotaPacote = "";
      $scope.dadosClienteNotaAssinatura = "";
      $scope.parValorShowComissao = 0;
      clientesNomesComanda = new Array();
      $scope.tpapagamento = "";
      $scope.tbapagamento = "";
      $scope.tpapagamentopacote = "";
      $scope.tbapagamentopacote = "";
      $scope.arrPagamentopacote = [];
      $scope.valorPagamentoNota = "";
      $scope.arrPagamento = [];
      $scope.parEnderecoNota = 0;
      $scope.parSplit = 0;
      $scope.parTipoSplit = 1;
      $scope.temProfissionalSplit = 0;
      $scope.parDescriaoSalaoParceiro = 0;
      $scope.parDescontoProduto = 0;
      $scope.campoTransporteNota = 0;
      $scope.overrideParceiro = 0;
      $scope.dadosClienteComanda = "";
      $scope.typeCadComanda = 3;
      $scope.parContaDigital = "";
      $scope.parContaDigital2 = "";

      function podeCobrarClienteComanda() {
        return $scope.parContaDigital == 1 || $_CONFIG.COBRANCA_CLIENTE == "1";
      }

      function atualizaBotaoCobrarClienteComanda(valorTotal) {
        var valor = parseFloat(String(valorTotal || "0").replace(",", "."));

        if (podeCobrarClienteComanda() && valor >= 1.0) {
          $("#btnCobrarCliente").show();
        } else {
          $("#btnCobrarCliente").hide();
        }
      }
      $scope.mostrabtntotem = false;
      $scope.arrayMetadados = [];

      $scope.createChangeCfop = [];

      $("#linhaPagamento0").remove();
      $("#linhaPagamento1").remove();
      $scope.favoritos = [];

      //	$scope.hasNotaNegada = 0;

      $(".navbar .menufavorito")
        .slimscroll({
          height: "560px",
          alwaysVisible: false,
          size: "3px",
        })
        .css("width", "100%");

      if (
        localStorage.getItem("favoritos_" + $_CONFIG.CODUSUARIO) != undefined &&
        localStorage.getItem("favoritos_" + $_CONFIG.CODUSUARIO) != ""
      ) {
        $scope.favoritos = JSON.parse(
          localStorage.getItem("favoritos_" + $_CONFIG.CODUSUARIO)
        );
      }

      String.prototype.extenso = function (c) {
        var ex = [
          [
            "zero",
            "um",
            "dois",
            "três",
            "quatro",
            "cinco",
            "seis",
            "sete",
            "oito",
            "nove",
            "dez",
            "onze",
            "doze",
            "treze",
            "quatorze",
            "quinze",
            "dezesseis",
            "dezessete",
            "dezoito",
            "dezenove",
          ],
          [
            "dez",
            "vinte",
            "trinta",
            "quarenta",
            "cinquenta",
            "sessenta",
            "setenta",
            "oitenta",
            "noventa",
          ],
          [
            "cem",
            "cento",
            "duzentos",
            "trezentos",
            "quatrocentos",
            "quinhentos",
            "seiscentos",
            "setecentos",
            "oitocentos",
            "novecentos",
          ],
          [
            "mil",
            "milhão",
            "bilhão",
            "trilhão",
            "quadrilhão",
            "quintilhão",
            "sextilhão",
            "setilhão",
            "octilhão",
            "nonilhão",
            "decilhão",
            "undecilhão",
            "dodecilhão",
            "tredecilhão",
            "quatrodecilhão",
            "quindecilhão",
            "sedecilhão",
            "septendecilhão",
            "octencilhão",
            "nonencilhão",
          ],
        ];
        var a,
          n,
          v,
          i,
          n = this.replace(c ? /[^,\d]/g : /\D/g, "").split(","),
          e = " e ",
          $ = "real",
          d = "centavo",
          sl;
        for (
          var f = n.length - 1, l, j = -1, r = [], s = [], t = "";
          ++j <= f;
          s = []
        ) {
          j && (n[j] = (("." + n[j]) * 1).toFixed(2).slice(2));
          if (
            !((a = (v = n[j]).slice((l = v.length) % 3).match(/\d{3}/g)),
            (v = l % 3 ? [v.slice(0, l % 3)] : []),
            (v = a ? v.concat(a) : v)).length
          )
            continue;
          for (a = -1, l = v.length; ++a < l; t = "") {
            if (!(i = v[a] * 1)) continue;
            (i % 100 < 20 && (t += ex[0][i % 100])) ||
              ((i % 100) + 1 &&
                (t +=
                  ex[1][(((i % 100) / 10) >> 0) - 1] +
                  (i % 10 ? e + ex[0][i % 10] : "")));
            s.push(
              (i < 100
                ? t
                : !(i % 100)
                ? ex[2][i == 100 ? 0 : (i / 100) >> 0]
                : ex[2][(i / 100) >> 0] + e + t) +
                ((t = l - a - 2) > -1
                  ? " " +
                    (i > 1 && t > 0 ? ex[3][t].replace("ão", "ões") : ex[3][t])
                  : "")
            );
          }
          a =
            (sl = s.length) > 1
              ? ((a = s.pop()), s.join(" ") + e + a)
              : s.join("") ||
                ((!j && n[j + 1] * 1 > 0) || r.length ? "" : ex[0][0]);
          a &&
            r.push(
              a +
                (c
                  ? " " +
                    (v.join("") * 1 > 1
                      ? j
                        ? d + "s"
                        : (/0{6,}$/.test(n[0]) ? "de " : "") +
                          $.replace("l", "is")
                      : j
                      ? d
                      : $)
                  : "")
            );
        }
        return r.join(e);
      };

      $.ajax({
        dataType: "json",
        url: "/pages/cadastros/buscaTipoPagamentoSelect.php",
        async: false,
        data: {},
        success: function (result) {
          $_CONFIG.LISTA_PAGAMAENTO = result.result;
          $scope.tiposPagamento = result.result;
        },
      });

      $.ajax({
        dataType: "json",
        url: "/pages/cadastros/buscaEstadosCombo.php",
        method: "POST",
        async: false,
        success: function (data) {
          $_CONFIG.LISTA_ESTADO = data.result;
        },
      });

      $.ajax({
        dataType: "json",
        url: "/pages/cadastros/buscaPais.php",
        method: "POST",
        async: false,
        success: function (data) {
          $_CONFIG.LISTA_PAIS = data.result;
        },
      });

      $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaProdutov4Tipo.php",
        async: false,
        data: {
          tipo: 2,
        },
        dataType: "json",
        success: function (result) {
          if (result.data.length > 0) {
            if (result.data[0].TotalProdutos > 1500) {
              $_CONFIG.HASMANYPRODUCTS = 1;
            } else {
              $_CONFIG.HASMANYPRODUCTS = 0;
            }
          }
        },
      });

      $.ajax({
        type: "POST",
        url: "/pages/cadastros/buscaPessoaInfoss.php",
        dataType: "json",
        async: false,
        success: function (result) {
          if (result.data.length > 0) {
            if (result.data[0].PIf_ID != "") {
              $scope.mostrabtntotem = true;
            } else {
              $scope.mostrabtntotem = false;
            }
          }
        },
        error: function (result) {},
      });

      $scope.buscaparcaixinha = function () {
        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          async: false,
          data: {
            metodo: "buscaParametro",
            id: $scope.idCliente,
            parcodigo: 63,
          },
          success: function (data) {
            if (data.result.length > 0) {
              if (data.result[0].PVa_Vlr_Principal == "1") {
                $scope.caixinha = 1;
              } else {
                $scope.caixinha = 0;
                $("#itemMenuCaixinha").hide();
              }
            } else {
              $scope.caixinha = 0;
            }
          },
        });
      };
      $scope.buscaparcaixinha();

      $scope.buscaparnota = function () {
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaParametroPessoa_v2.php",
          async: false,
          data: {
            tipo: 4,
          },
          success: function (data) {
            if (data.data.length > 0) {
              console.log(data);
              for (var i = 0; i < data.data.length; i++) {
                if (data.data[i].Par_Codigo == 64) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parnota = 1;
                  } else {
                    $scope.parnota = 0;
                    $("#emissoesItemMenu").hide();
                  }
                } else if (data.data[i].Par_Codigo == 65) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parnfse = 1;
                  } else {
                    $scope.parnfse = 0;
                  }
                } else if (data.data[i].Par_Codigo == 66) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parnfe = 1;
                    $("#divTransportadora").show();
                  } else {
                    $scope.parnfe = 0;
                  }
                } else if (data.data[i].Par_Codigo == 73) {
                  if (data.data[i].PVa_Vlr_Principal == "3") {
                    $scope.parnfdescontoparceiro = 1;
                  } else if (
                    data.data[i].PVa_Vlr_Principal == "1" ||
                    data.data[i].PVa_Vlr_Principal == "2"
                  ) {
                    $scope.overrideParceiro = 1;
                  } else {
                    $scope.parnfdescontoparceiro = 0;
                  }
                } else if (data.data[i].Par_Codigo == 86) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parnfapacote = 1;
                  } else {
                    $scope.parnfapacote = 0;
                  }
                } else if (data.data[i].Par_Codigo == 87) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parnfce = 1;
                  } else {
                    $scope.parnfce = 0;
                  }
                } else if (data.data[i].Par_Codigo == 103) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parEnderecoNota = 1;
                  } else {
                    $scope.parEnderecoNota = 0;
                  }
                } else if (data.data[i].Par_Codigo == 117) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parDescriaoSalaoParceiro = 1;
                  } else {
                    $scope.parDescriaoSalaoParceiro = 0;
                  }
                } else if (data.data[i].Par_Codigo == 122) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parnfssinatura = 1;
                  } else {
                    $scope.parnfssinatura = 0;
                  }
                } else if (data.data[i].Par_Codigo == 125) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.nomeProfissionalNota = 1;
                  } else {
                    $scope.nomeProfissionalNota = 0;
                  }
                } else if (data.data[i].Par_Codigo == 150) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.campoTransporteNota = 1;
                    $("#optTransporteNota").show();
                  } else {
                    $scope.campoTransporteNota = 0;
                    $("#optTransporteNota").hide();
                  }
                } else if (data.data[i].Par_Codigo == 120) {
                  if (data.data[i].PVa_Vlr_Principal == "1") {
                    $scope.parContaDigital = 1;
                    $scope.parContaDigital2 = 1;
                    $("#btnCobrarCliente").show();
                  } else {
                    $scope.parContaDigital = 0;
                    $scope.parContaDigital2 = 0;
                    if (podeCobrarClienteComanda()) {
                      $("#btnCobrarCliente").show();
                    } else {
                      $("#btnCobrarCliente").hide();
                    }
                  }
                } else if (data.data[i].Par_Codigo == 215) {
                  if ($_CONFIG.ISG != 1) {
                    if (data.data[i].PVa_Vlr_Principal == "1") {
                      $(".btnEdtCaixa").hide();
                    } else {
                      $(".btnEdtCaixa").show();
                    }
                  } else {
                    $(".btnEdtCaixa").show();
                  }
                } else if (data.data[i].Par_Codigo == 216) {
                  if ($_CONFIG.ISG == 1) {
                    if (data.data[i].PVa_Vlr_Principal == "1") {
                      $("#btnVerCaixaAbertoGestor").show();
                    } else {
                      $("#btnVerCaixaAbertoGestor").hide();
                    }
                  } else {
                    $("#btnVerCaixaAbertoGestor").hide();
                  }
                }
              }

              if ($scope.overrideParceiro == 1) {
                $scope.parnfdescontoparceiro = 1;
                $scope.parDescriaoSalaoParceiro = 1;
              }
            } else {
              $scope.parnota = 0;
              $scope.parnfse = 0;
              $scope.parnfe = 0;
              $scope.parnfapacote = 0;
              $scope.parnfce = 0;
              $scope.parnfdescontoparceiro = 0;
              $scope.parEnderecoNota = 0;
              $scope.parDescriaoSalaoParceiro = 0;
              $scope.parnfssinatura = 0;
              $scope.nomeProfissionalNota = 0;
              $scope.campoTransporteNota = 0;
              $scope.overrideParceiro = 0;
            }
          },
        });
      };
      $scope.buscaparnota();

      $scope.buscaParValidaBotaoContaDigital = function () {
        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          async: false,
          data: {
            metodo: "buscaParametro",
            id: $scope.idCliente,
            parcodigo: 174,
          },
          success: function (data) {
            if (data.result.length > 0) {
              if (data.result[0].PVa_Vlr_Principal == "1") {
                $scope.parContaDigital = 1;
                $("#btnCobrarCliente").show();
              } else {
                $scope.parContaDigital = 0;
                if (podeCobrarClienteComanda()) {
                  $("#btnCobrarCliente").show();
                } else {
                  $("#btnCobrarCliente").hide();
                }
              }
            } else {
              $scope.caixinha = 0;
            }
          },
        });
      };
      if (podeCobrarClienteComanda()) {
        $scope.buscaParValidaBotaoContaDigital();
      }
      if ($scope.parnota == 1) {
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaAviso.php",
          async: false,
          data: {
            tipo: 1,
            pescodigo: "",
          },
          success: function (data) {
            if (data.data.length > 0) {
              for (var i = 0; i < data.data.length; i++) {
                if (
                  data.data[i].CNF_Status == "Negada" ||
                  data.data[i].CNF_Status == "Aguardando Emissão..."
                ) {
                  $scope.hasNotaNegada = 1;
                  break;
                }
              }
            } else {
              $scope.hasNotaNegada = 0;
            }
          },
        });
      }

      if ($scope.campoTransporteNota == 1) {
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaTipoTransportadora.php",
          async: false,

          success: function (data) {
            var html = '<option value="">Selecione uma Transportadora</option>';
            if (data.data.length > 0) {
              for (var i = 0; i < data.data.length; i++) {
                html += `<option value="${data.data[i].TTr_Descricao}" data-tipopessoa="${data.data[i].TipoPessoa}" data-cnpj="${data.data[i].TTr_CNPJ}" data-cidade="${data.data[i].Cid_Nome}" data-ie="${data.data[i].TTr_IE}" data-uf="${data.data[i].Est_Sigla}" data-endereco="${data.data[i].TTr_Endereco}">${data.data[i].TTr_Descricao}</option>`;
              }
            }
            $("#transportadoraNotaProd").html(html);
          },
        });
      }
      var goToEmissao = function goEmissao() {
        $state.go("emissoes");
      };

      var goToServico = function goToServico() {
        $state.go("servicos");
      };

      var goToCaixa = function goToCaixa() {
        $state.go("relCaixa");
      };

      var goToComanda = function goToComanda() {
        $state.go("comandasAbertas");
      };

      var goToRecorrente = function goToRecorrente() {
        $state.go("relRecorrente");
      };

      var goToAssinante = function goToAssinante() {
        $state.go("assinantes");
      };

      var goToEstoque = function goToEstoque() {
        $state.go("relGerencialEstoque");
      };

      if ($scope.hasNotaNegada == 1) {
        $App.showMessageColor(
          "Módulo fiscal",
          "Exitem emissões negadas ou pendentes. clique aqui para visualizar",
          1,
          goToEmissao,
          "error"
        );
      }

      var showalertmessages = localStorage.getItem("alertMesssage");

      if (showalertmessages == null) {
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaAviso.php",
          async: false,
          data: {
            tipo: 2,
            pescodigo: "",
          },
          success: function (data) {
            if (data.data.length > 0) {
              for (var i = 0; i < data.data.length; i++) {
                if (data.data[i].SVa_Codigo != "") {
                  $App.showMessage(
                    "Serviços",
                    "Existem agendamentos de troca de valor de serviços pendentes. Aplique as alterações para efetivar a troca. Clique aqui para ir aos serviços",
                    2,
                    goToServico
                  );
                }
              }
            }
          },
        });

        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaAviso.php",
          async: false,
          data: {
            tipo: 3,
            pescodigo: "",
          },
          success: function (data) {
            if (data.data.length > 0) {
              for (var i = 0; i < data.data.length; i++) {
                if (data.data[i].FCa_Codigo != "") {
                  $App.showMessageColor(
                    "Caixas",
                    "Existem caixas abertos a mais de 30 dias no seu estabelecimento. Finalize seus caixas para manter seu financeiro atualizado. Clique aqui para ir ao histórico de caixas",
                    2,
                    goToCaixa,
                    "warning"
                  );
                }
              }
            }
          },
        });

        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaAviso.php",
          async: false,
          data: {
            tipo: 4,
            pescodigo: "",
          },
          success: function (data) {
            if (data.data.length > 0) {
              for (var i = 0; i < data.data.length; i++) {
                if (data.data[i].NumComanda > 0) {
                  $App.showMessageColor(
                    "Comandas",
                    "Existem comandas abertas nos últimos 90 dias. Finalize suas comandas para manter suas informações atualizadas. Clique aqui para ver as comandas abertas",
                    2,
                    goToComanda,
                    "error"
                  );
                }
              }
            }
          },
        });

        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaAviso.php",
          async: false,
          data: {
            tipo: 5,
            pescodigo: "",
          },
          success: function (data) {
            if (data.data.length > 0) {
              for (var i = 0; i < data.data.length; i++) {
                if (data.data[i].NumAgendamentos > 0) {
                  $App.showMessageColor(
                    "Agendamentos Recorrentes",
                    "Existem agendamentos recorrentes acabando nos próximos 7 dias. Clique aqui para ir até a lista de agendamentos recorrentes",
                    2,
                    goToRecorrente
                  );
                }
              }
            }
          },
        });

        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaAviso.php",
          async: false,
          data: {
            tipo: 6,
            pescodigo: "",
          },
          success: function (data) {
            if (data.data.length > 0) {
              for (var i = 0; i < data.data.length; i++) {
                if (data.data[i].NumAssinaturas > 0) {
                  $App.showMessageColor(
                    "Assinantes",
                    "Existem assinantes com vencimento previsto para os proximos 7 dias. Clique aqui para ir até a lista de assinantes ",
                    2,
                    goToAssinante,
                    "warning"
                  );
                }
              }
            }
          },
        });

        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaAviso.php",
          async: false,
          data: {
            tipo: 7,
            pescodigo: "",
          },
          success: function (data) {
            if (data.data.length > 0) {
              for (var i = 0; i < data.data.length; i++) {
                if (data.data[i].TotalProdVencer > 0) {
                  $App.showMessageColor(
                    "Produtos a vencer",
                    "Existem produtos vencendo nos próximos 30 dias. Clique aqui para ver quais.",
                    2,
                    goToEstoque,
                    "warning"
                  );
                }
              }
            }
          },
        });
      }

      $.ajax({
        dataType: "json",
        url: localStorage.getItem("host"),
        async: false,
        data: {
          metodo: "buscaParametro",
          id: $scope.idCliente,
          parcodigo: 60,
        },
        success: function (data) {
          if (data.result.length > 0) {
            if (data.result[0].PVa_Vlr_Principal == "1") {
              $scope.geracomissaoprof = 1;
            } else {
              $scope.geracomissaoprof = 0;
            }
          } else {
            $scope.geracomissaoprof = 0;
          }
        },
      });

      $.ajax({
        dataType: "json",
        url: localStorage.getItem("host"),
        async: false,
        data: {
          metodo: "buscaParametro",
          id: $scope.idCliente,
          parcodigo: 126,
        },
        success: function (data) {
          if (data.result.length > 0) {
            if (
              data.result[0].PVa_Vlr_Principal == "1" ||
              data.result[0].PVa_Vlr_Principal == "2"
            ) {
              $scope.parDescontoProduto = data.result[0].PVa_Vlr_Principal;
            } else {
              $scope.parDescontoProduto = 0;
            }
          } else {
            $scope.parDescontoProduto = 0;
          }
        },
      });

      $.ajax({
        dataType: "json",
        url: "/pages/cadastros/buscaPais.php",
        method: "POST",
        success: function (data) {
          var html = "";
          var sigla = $_CONFIG.language.mascaras.lang.toUpperCase();
          for (var i = 0; i < data.result.length; i++) {
            if (sigla == data.result[i].Pai_Sigla) {
              html +=
                '<option selected value="' +
                data.result[i].Pai_Codigo +
                '" data-sigla="' +
                data.result[i].Pai_Sigla +
                '">' +
                data.result[i].Pai_Nome +
                "</option>";
            } else {
              html +=
                '<option value="' +
                data.result[i].Pai_Codigo +
                '" data-sigla="' +
                data.result[i].Pai_Sigla +
                '">' +
                data.result[i].Pai_Nome +
                "</option>";
            }
          }
          $("#cliPais").html(html);
          $("#cliPaisEdt").html(html);
        },
      });

      $(".input-group.date").datepicker({
