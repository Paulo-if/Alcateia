      $scope.buscaPessoaContaInfoCli = function (cliente) {
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaPessoaContaCliente.php",
          data: {
            tipo: 1,
            pescodigo: cliente,
          },
          dataType: "json",
          success: function (result) {
            if (result.data[0] != undefined) {
              if (result.data[0].erro == undefined) {
                if (result.data[0].PCo_Saldo != undefined) {
                  $("#saldoContaCli").html(result.data[0].PCo_Saldo);
                } else {
                  $("#saldoContaCli").html($_CONFIG.MOEDA + " 0,00");
                }
              } else {
                $("#saldoContaCli").html("");
              }
            } else {
              $("#saldoContaCli").html($_CONFIG.MOEDA + " 0,00");
            }
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });
      };

      $scope.showDetailsContaCliente = function () {
        if (typeof tabelaClienteContaInfo != "undefined") {
          tabelaClienteContaInfo.destroy();
        }
        $App.formatDateSort();
        tabelaClienteContaInfo = $("#tbContaClienteInfo").DataTable({
          ajax: {
            url: "/pages/cadastros/buscaContaClientes.php",
            method: "POST",
            data: function (d) {
              d.pescodigo = $("#cliPesCodigoInfo").val();
            },
          },
          fnRowCallback: function (nRow, aData) {
            var id = aData.PCo_Tipo; // ID is returned by the server as part of the data
            var Comanda = aData.Com_Codigo; // ID is returned by the server as part of the data
            var $nRow = $(nRow); // cache the row wrapped up in jQuery
            if (id == "D") {
              $nRow
                .map(function () {
                  return $(this).css({
                    color: "#F44336",
                  });
                })
                .get();
            } else {
              $nRow
                .map(function () {
                  return $(this).css({
                    color: "#1B5E20",
                  });
                })
                .get();
            }

            if (aData.Saldo == null) {
              $("#valorTotalContaCli").html($_CONFIG.MOEDA + "0,00");
            } else {
              $("#valorTotalContaCli").html(aData.Saldo);
            }

            switch (Comanda) {
              case "":
                $nRow.map(function () {}).get();
                nRow.children[4].children[0].disabled = "true";
                nRow.children[4].children[0].className =
                  "btn btn-secondary btn-xs";
                nRow.children[4].className = "";
                break;
              default:
                $nRow.map(function () {}).get();

                break;
            }

            return nRow;
          },
          dom: "Bfrtip",
          buttons: [
            {
              extend: "excelHtml5",
              text: "Excel",
              exportOptions: {
                columns: ":visible",
              },
              footer: "true",
