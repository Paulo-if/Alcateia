      // altera prontuario
      $("#formAlteraDetalhesAgendamento").submit(function (event) {
        event.preventDefault();
        if ($("#AdeCodgioAltera").val() != "") {
          showLoader(true);
          var dados = new FormData(this);

          $.ajax({
            type: "POST",
            url: "/pages/cadastros/alteraAgendamentoProntuario.php",
            data: dados,
            dataType: "json",
            processData: false,
            contentType: false,
            success: function (result) {
              if (result.result[0].erro == "0") {
                $scope.atualizatabelaProntuario();
                toastr.success(result.result[0].resultado);
              } else {
                toastr.error(result.result[0].resultado);
              }
              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
          return true;
        } else {
          showLoader(true);
          formInsereDet = $(this);
          var dados = new FormData(this);
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/insereAgendamentoProntuario.php",
            data: {
              codigoAgendamento: $("#AgeCodigoBuscaImagem").val(),
              ageMaterial: $("#ageMaterialEdt").val(),
              ageDetalhes: $("#ageDetalhesEdt").val(),
              ageCorte: $("#ageCorteEdt").val(),
            },
            dataType: "json",
            success: function (result) {
              if (result.result[0].erro == "0") {
                toastr.success(result.result[0].resultado);
                $scope.atualizatabelaProntuario();
                $("#EditaProntuario-modal").modal("hide");
              } else {
                toastr.error(result.result[0].resultado);
              }
              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
          return true;
        }
      });

      /*--------Mascaras--------*/

      $translate("mascaras.telefone").then(function (value) {
        if (value != "") {
          $("#cliTelefone").mask(value);
          $("#cliTelefoneComanda").mask(value);
        }
      });

      $("#msgEnviarSms").change(function (event) {
        $scope.sendSms = this.checked;
        if (this.checked) {
          $("#msgDescricao").attr("maxlength", $scope.textMax);
          $scope.countCharMsg();
          $("#divSaldoSmsMsg").show();
          $("#charNumMsg").show();
        } else {
          $("#msgDescricao").removeAttr("maxlength");
          $("#divSaldoSmsMsg").hide();
          $("#charNumMsg").hide();
          $("#divDescNot").removeClass("has-error");
        }
      });

      $("#msgDescricao").keyup(function () {
        $scope.countCharMsg();
      });

      $scope.countCharMsg = function (text) {
        if ($scope.sendSms) {
          var text_length = $("#msgDescricao").val().length;
          if (text_length > $scope.textMax) {
            $("#divDescMsg").addClass("has-error");
          } else {
            $("#divDescMsg").removeClass("has-error");
          }
          $("#charTextMsg").html(text_length + " caracteres");
        }
      };

      $scope.buscaSaldoSMSMsg = function () {
        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          data: {
            metodo: "buscaPessoaSMS",
            tipo: 1,
            id: $scope.idCliente,
          },
          success: function (data) {
            if (data.result.length > 0) {
              $("#lblSaldoSMSMsg").html(data.result[0].Saldo);
            }
          },
        });
      };
      buscaEstados($_CONFIG.PAIS);

      function buscaEstados(pais) {
        var html = "<option value='-1'>Estado</option>";
        for (var i = 0; i < $_CONFIG.LISTA_ESTADO.length; i++) {
          if (pais != "2") {
            html +=
              "<option id='" +
              $_CONFIG.LISTA_ESTADO[i].Est_Sigla +
              "' value='" +
              $_CONFIG.LISTA_ESTADO[i].Est_Codigo +
              "'> " +
              $_CONFIG.LISTA_ESTADO[i].Est_Nome +
              "</option>";
          } else {
            html +=
              "<option id='" +
              $_CONFIG.LISTA_ESTADO[i].Est_Nome.replace(" ", "").toLowerCase() +
              "' value='" +
              $_CONFIG.LISTA_ESTADO[i].Est_Codigo +
              "'> " +
              $_CONFIG.LISTA_ESTADO[i].Est_Nome +
              "</option>";
          }
        }

        $("#cliEstado").html(html);
        $("#cliEstadoEdt").html(html);
        $("#cliCupomUF").html(html);
      }
      $("#cliEstado").change(function () {
        var estado = this.value;
        $("#cliCidade").empty();
        if (estado === -1) {
          $("#cliCidade").attr("disabled", true);
        } else {
          $.ajax({
            dataType: "html",
            url: "/pages/cadastros/buscaCidades.php",
            method: "POST",
            data: {
              estCodigo: estado,
            },
            success: function (data) {
              $("#cliCidade").append(data);
              $("#cliCidade").attr("disabled", false);
            },
          });
        }
      });

      $scope.geraComandaInfo = function () {
        $scope.isereComandaInfoCliente($("#cliPesCodigoInfo").val());
      };

      $scope.isereComandaInfoCliente = function (codigocliente) {
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/insereComandas.php",
          data: {
            comObs: "Comanda aberta pela info do Cliente.",
            comNumCartao: "",
            comTipoManual: 0,
            comCliente: codigocliente,
          },
          dataType: "json",
          success: function (result) {
            if (result.result[0].erro == "0") {
              $("#nomeClienteComanda").html(result.result[0].NomeCliente);
              $("#idComanda").html(result.result[0].ComCodigo);
              $("#numComanda").html(result.result[0].ComCodigo);
              $("#numComandaProd").html(result.result[0].ComCodigo);
              $("#dataComanda").html(result.result[0].DataComanda);
              $("#edtComCartao").val(result.result[0].CodigoExterno);
              $("#codCliente").val(result.result[0].Cliente);
              if (result.result[0].TPRCodigo == 3) {
                $("#comandaProfissionalAviso").show();
              } else {
                $("#comandaProfissionalAviso").hide();
              }
              $("#comanda-modal").modal("show");
              $("#infoCliente-modal").modal("hide");

              $scope.buscaPessoaConta();

              var PromissePagamento = new Promise((resolve, reject) => {
                resolve($scope.atualizaTipoPagemento());
              });
              PromissePagamento.then(() => {
                $scope.buscaItensComanda(result.result[0].ComCodigo);
              });
            } else {
            }
            showLoader(false);
          },
          error: function (result) {
            swal("Falha na conexão.", "", "error");
            showLoader(false);
          },
        });
      };

      $scope.pagaContaCliente = function (tipo, valor) {
        var comanda = 0.0;
        comanda = parseFloat(
          $("#valorPagamento0")
            .val()
            .replace(",", ".")
            .replace($_CONFIG.MOEDA, "")
        );
        if (tipo == 1) {
          $("#valorPagamento0").val((comanda - valor).toFixed(2));
        } else {
          var val = valor - comanda;
          if (val >= 0) {
            $("#valorPagamento0").val((0).toFixed(2));
          } else {
            $("#valorPagamento0").val((comanda - valor).toFixed(2));
          }
        }
        $("#valorPagamento0").focus();
        $("#valorPagamento0").change();
        $("#btnPagacomanda").prop("disabled", true);
      };

      $scope.rotateImage = function (degree) {
        $("#imagemCutAll").cropper("rotate", degree);
      };

      $scope.saveImageCrop = function () {
        var formimagem = $("#formid").val();
        if ($("#imagemCutAll").cropper("getData").width <= 800) {
          logoEmpresa = $("#imagemCutAll")
            .cropper("getCroppedCanvas")
            .toDataURL();
          $("#imagemCutAll")
            .cropper("getCroppedCanvas")
            .toBlob(function (blob) {
              mBlob = blob;
              if (
                formimagem == "#formAlteraImagem" ||
                formimagem == "#formInsereImagem"
              ) {
                $(formimagem).submit();
              }
              mImage = $("#imagemCutAll")
                .cropper("getCroppedCanvas")
                .toDataURL("image/jpeg");
              $("#cortaImagemAll-modal").modal("hide");
            });
        } else {
          logoEmpresa = $("#imagemCutAll")
            .cropper("getCroppedCanvas", {
              width: 600,
            })
            .toDataURL();
          $("#imagemCutAll")
            .cropper("getCroppedCanvas", {
              width: 800,
            })
            .toBlob(function (blob) {
              mBlob = blob;
              if (
                formimagem == "#formAlteraImagem" ||
                formimagem == "#formInsereImagem"
              ) {
                $(formimagem).submit();
              }
              mImage = $("#imagemCutAll")
                .cropper("getCroppedCanvas")
                .toDataURL("image/jpeg");
              $("#cortaImagemAll-modal").modal("hide");
            });
        }
      };

      $("#btnCompraSms").click(function () {
        swal(
          {
            title: "Confirmar :",
            text: "Deseja realmente ir até a compra de sms, os campos preenchidos serão perdidos",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Sim",
            cancelButtonText: "Não",
            closeOnConfirm: true,
          },
          function () {
            var url = location.href;
            url = url.split("#/")[0];
            url = url + "#/sms";
            window.location.href = url;
            $("#cadastrarmsg-modal").modal("hide");
          }
        );
      });

      $scope.bucaClienteAssociacao = function () {
        if (hasManyClients) {
          $("#buscaClienteAssociaComanda").select2({
            ajax: {
              url: localStorage.getItem("host"),
              dataType: "json",
              delay: 250,
              data: function (params) {
                return {
                  nome: params.term,
                  metodo: "buscaClientes_v4",
                  tipo: 5,
                  id: $_CONFIG.ID,
                };
              },
              processResults: function (data, params) {
                return {
                  results: data.result,
                };
              },
              cache: true,
            },
            placeholder: "Sem Cadastro",
            escapeMarkup: function (markup) {
              return markup;
            }, // let our custom formatter work
            minimumInputLength: 3,
            templateResult: thumbClienteName,
            templateSelection: formatRepoSelection,
          });
        } else {
          $.ajax({
            dataType: "json",
            url: localStorage.getItem("host"),
            data: {
              metodo: "buscaClientes_v3",
              id: $_CONFIG.ID,
              tipo: 2,
            },
            success: function (data) {
              clientesNomesComanda.length = 0;
              var html =
                '<option data-usucodigo="" data-imagem="" value="0" selected>Sem Cadastro</option>';
              for (var i = 0; i < data.result.length; i++) {
                var codigo = data.result[i].Pes_Codigo;
                var nome = data.result[i].Pes_Nome;
                var foto = data.result[i].Paf_Imagem;
                var usucod = data.result[i].Usu_Codigo;
                var celular = data.result[i].Paf_Celular;
                html +=
                  '<option data-usucodigo="' +
                  usucod +
                  '" data-imagem="' +
                  foto +
                  '" value="' +
                  codigo +
                  '">' +
                  nome +
                  " - " +
                  celular +
                  "</option>";
                clientesNomesComanda.push(nome);
              }
              $("#buscaClienteAssociaComanda").html(html);
              if (data.result.length > 800) {
                $("#buscaClienteAssociaComanda").select2({
                  minimumInputLength: 3,
                });
                $scope.manyClients = true;
              } else {
                $("#buscaClienteAssociaComanda").select2();
                $scope.manyClients = false;
              }
              $("#buscaClienteAssociaComanda").val("0").trigger("change");
            },
          });
        }
      };

      $scope.associaClienteComanda = function () {
        $("#associaClienteComanda-modal").modal("show");

        $("#associaComCodigo").val($("#idComanda").html());
        $scope.bucaClienteAssociacao();
      };

      $("#formAssociaClienteComanda").submit(function (event) {
        event.preventDefault();
        showLoader(true);
        formAssocia = $(this);
        var dados = new FormData(this);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/atualizaClienteComanda.php",
          data: dados,
          dataType: "json",
          processData: false,
          contentType: false,
          success: function (result) {
            if (result.result[0].erro == "0") {
              toastr.success(result.result[0].resultado, "");
              formAssocia.each(function () {
                this.reset();
              });
              $scope.atualizaComandaCliente(result.result[0].comcodigo);
              $("#associaClienteComanda").modal("hide");
            } else {
              toastr.error(result.result[0].resultado);
            }
            showLoader(false);
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });

        return true;
      });

      $scope.atualizaComandaCliente = function (comcodigo) {
        $.ajax({
          dataType: "json",
          method: "POST",
          url: "pages/cadastros/atualizaComandaCliente.php",
          data: {
            comcodigo: comcodigo,
          },
          success: function (data) {
            $("#nomeClienteComanda").html(data.result[0].Cliente);

            $("#labelTipoClienteComanda").html("Cliente: ");
            $("#iconInfoCliente").show();
            $("#TprTipoComanda").html(data.result[0].TPR_Codigo);

            $("#codCliente").val(data.result[0].CodCliente);

            $("#btnAssociaClienteComanda").hide();
            $("#associaClienteComanda-modal").modal("hide");
            $scope.buscaItensComanda(comcodigo);
            $scope.buscaPessoaConta();
            if (location.hash == "#/comandasabertas") {
              $rootScope.$emit("atualizaDadosComanda", {});
            }
            if (location.hash == "#/filaDeEspera") {
              $rootScope.$emit("atualizaDadosFila", {});
            }
            if (location.hash == "#/agenda") {
              $rootScope.$emit("BuscaAgenda", {});
            }
          },
        });
      };

      $scope.infoshowGeraToken = function () {
        $("#geratokenCliente-modal").modal("show");
