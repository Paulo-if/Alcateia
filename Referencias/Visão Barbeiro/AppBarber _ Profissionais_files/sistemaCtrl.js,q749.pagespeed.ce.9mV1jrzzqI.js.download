      $("#buttonAbreNovaComanda").click(function () {
        // $('.date.DataComandaAbre').datepicker('update', curTimeZone);
        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          data: {
            metodo: "buscaDataAtual",
            id: $scope.idCliente,
          },
          success: function (data) {
            var datahoralocal = moment(data.buscaDataAtual[0].resultado)
              .locale("pt-br")
              .format("L");

            $(".date.DataComandaAbre").datepicker("update", datahoralocal);
            if (curTimeZone.getMinutes() < 10) {
              var hora =
                curTimeZone.getHours() + "0" + curTimeZone.getMinutes();
            } else {
              var hora = curTimeZone.getHours() + "" + curTimeZone.getMinutes();
            }
            var horas = new Array();
            for (var i = 0; i < $("#horaComandaInicio option").length; i++) {
              horas.push(
                $("#horaComandaInicio option")[i].value.replace(":", "")
              );
            }

            $("#horaComandaInicio").select2();
            $("#horaComandaInicio").select2("val", "");
            var hour = getproxhora(horas, hora);
            $("#horaComandaInicio").val(hour.toString().splice(2, 0, ":"));
            $("#horaComandaInicio").change();
          },
          error: function () {
            var dataini = moment().locale("pt-br").format("L");
            $(".date.DataComandaAbre").datepicker("update", dataini);
          },
        });
      });

