            var valPercent = (data.PPa_Qtd_Usada / data.PPa_Qtd_Sessao) * 100;
            $("#progPacote").css("width", valPercent + "%");
            $("#pacdescricao").html(data.PPa_Descricao);
            $("#pacdatcadastro").html(data.PPa_Dat_Cadastro);
            $("#qtdConsumo").html(data.PPa_Qtd_Usada);
            $("#qtdTotal").html(data.PPa_Qtd_Sessao);
          }
        );
      };

      $scope.insereDesconto = function () {
