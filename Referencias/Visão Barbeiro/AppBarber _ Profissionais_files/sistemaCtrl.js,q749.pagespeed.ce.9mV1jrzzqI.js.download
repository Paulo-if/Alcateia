      $scope.calcularPreco = function () {
        var atendimentos = parseFloat($("#totalAtendimentos").val());
        var clientes = parseFloat($("#clientesUnicos").val());
        var faturado = parseFloat($("#valorCorte").val().replace(",", "."));

        var preco = faturado * (atendimentos / clientes);
        var barba = preco * 1.17;
        var combo = preco * 1.76;

        $("#planoCorte").val("R$ " + preco.toFixed(2).replace(".", ","));
        $("#planoBarba").val("R$ " + barba.toFixed(2).replace(".", ","));
        $("#planoCombo").val("R$ " + combo.toFixed(2).replace(".", ","));
      };

      $("#videoModal").on("hidden.bs.modal", function () {
        var iframe = $(this).find("iframe");
        var src = iframe.attr("src");
        iframe.attr("src", ""); // Remove o src (para forçar o stop)
        iframe.attr("src", src); // Reatribui o src original
      });

      $scope.buscaTabelaComandaTotem = function () {
        if (typeof tabelacomandatotemopt !== "undefined") {
          tabelacomandatotemopt.destroy();
        }
        tabelacomandatotemopt = $("#comandaTotemTable").DataTable({
          ajax: {
            url: "/pages/cadastros/COMANDA_TOTEM_STATUS_Busca.php",
            method: "POST",
            data: function (d) {
              d.type = 1;
            },
          },
          scrollX: isPortrait,
          initComplete: function () {
            $compile($("#comandaTotemTable"))($scope);
            $("#comandaTotemTableo_paginate").click(function () {
              $compile($("#comandaTotemTable"))($scope);
            });
            $("#comandaTotemTable_filter").change(function () {
              $compile($("#tabelaserProfAsso"))($scope);
            });
            $("#comandaTotemTable_length").change(function () {
              $compile($("#comandaTotemTable"))($scope);
            });
            resizeContent();
          },
          columns: [
            {
              data: "invoice_code",
              title: "Comanda",
            },
            {
              data: "person_name",
              title: "Cliente",
            },
            {
              data: "invoice_message",
              title: "Mensagem",
            },
            {
              data: "insert_date",
              title: "Data do pagamento",
            },
            {
              class: "abrecomanda-control",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn btn-success btn-xs " id="abreComandaContaCliente">Ver Comanda</button>',
            },
          ],
          ordering: false,
          searching: false,
          lenghtChange: false,
          paging: false,
          language: {
            url: $_CONFIG.language.datatables,
          },
        });

        $("#comandaTotemTable tbody").on(
          "click",
          "td.abrecomanda-control",
          function () {
            var tr = $(this).closest("tr");
            var row = tabelacomandatotemopt.row(tr);
            var data = row.data();
            displayComanda(data.invoice_code);
            $("#listaComandaTotem-modal").modal("hide");
          }
        );

        $("#listaComandaTotem-modal").modal();
      };

      $scope.buscaNIF = function () {
        $.ajax({
          dataType: "json",
          url: "pages/cadastros/EMPRESA_NIF_Busca.php",
          data: {},
          success: function (result) {
            console.log(result);
            if(result.data.nif[0].Pai_Codigo == 2 && result.data.nif[0].PAJ_NIF == ""){
              $("#nif-modal").modal();
            }
            localStorage.setItem("buscaNIF_feito_" + $_CONFIG.ID, "true");
          },
        });
      };

      var verificaBuscaNIF = localStorage.getItem("buscaNIF_feito_" + $_CONFIG.ID);
      if (verificaBuscaNIF == null) {
        $scope.buscaNIF();
      }

      $scope.salvarNIF = function () {
        var nif = $("#codigoNIF").val();

        if (!nif) {
          toastr.error("Por favor, insira um valor para o NIF", "", "error");
          return false;
        }

        showLoader(true);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/atualizaCodigoNIF.php",
          data: {
            nif: nif
          },
          dataType: "json",
          success: function (result) {
            showLoader(false);
            if (!result.data.error) {
              toastr.success(result.data.message || "NIF atualizado com sucesso!");
              $("#nif-modal").modal("hide");
              return;
            } 
            
            toastr.error(result.data.message || "Erro ao atualizar NIF", "", "error");
            
          },
          error: function (result) {
            showLoader(false);
            toastr.error("Falha na conexão ao salvar NIF", "", "error");
          }
        });
      }

      $scope.geraHashCheckout = function (planCode, callback) {
        $.ajax({
          type: "POST",
          dataType: "json",
          url: "php/plans/criaCheckoutRenovacao.php",
          data: {
            placodigo: planCode,
            payment_method: 3,
            periodicidade: 1,
            installments: 1
          },
          success: function (data) {

            if (data.errorl) {
              return callback(null);
            }

            return callback(data.checkout[0].hash_code);
          },
          error: function () {
            callback(null);
          }
        });
      };

      $scope.verificarVencimentoSistema = function () {
        const diasRaw = $_CONFIG.DIASEXPIRAR;
        const diasExpirar = parseInt(diasRaw, 10);
        const isExpired =
          diasRaw !== undefined &&
          diasRaw !== null &&
          diasRaw !== "" &&
          !isNaN(diasExpirar) &&
          diasExpirar <= 2;

        const isManager = $_CONFIG.ISG;
        const system = $scope.sistemaName.toLowerCase();

        $.ajax({
          dataType: "json",
          url: "pages/cadastros/PAYMENT_Info_Busca.php",
          data: {},
          success: function (result) {
            if (result.data.error == false) {
              console.log("DIASEXPIRAR:", $_CONFIG.DIASEXPIRAR);
              console.log("isExpired:", isExpired);

              const isMonthly = result.data.payment[0].establishment_invoice_plan_description == "Mensal";
              const planCode = result.data.payment[0].estalishment_plan_code;

              if (isExpired && isManager && isMonthly) {
                $scope.geraHashCheckout(planCode, function (hash) {
                  if (hash) {
                    var link = `https://checkout.${system}.com.br/?hash=${hash}`;
                    $("#btnCheckoutPixModal").attr("href", link);
                    $("#regularizacaoSistema-modal").modal();
                  }
                });

              }
            }
          }
        });
      };

      $scope.verificarVencimentoSistema();
    }
  );
