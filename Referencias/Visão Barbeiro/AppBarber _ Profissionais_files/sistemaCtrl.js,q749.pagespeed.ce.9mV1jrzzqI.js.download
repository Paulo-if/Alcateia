          },
          columns: [
            {
              data: "DT_RowId",
            },
            {
              data: "PCo_Codigo",
            },
            {
              data: "PCo_Descricao",
            },
            {
              data: "PCo_Dat_Lancamento",
              type: "moment-DD/MM/YYYY",
            },
            {
              data: "PCo_Valor",
            },
            {
              data: "PCo_TipoMov",
            },
            {
              data: "Saldo",
            },
            {
              data: "PCo_Tipo",
            },
            {
