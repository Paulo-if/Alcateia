      $scope.cobraContaDigitalPix = function () {
        showLoader(true);
        $("#optCombrancaContaDigital-modal").modal("hide");
        var com_codigo = $("#idComanda").html();
        var browserScreenHeight =
          window.innerHeight ||
          document.documentElement.clientHeight ||
          document.body.clientHeight;
        var browserScreenWidth =
          window.innerWidth ||
          document.documentElement.clientWidth ||
          document.body.clientWidth;
        var time_zone_off_set = new Date().getTimezoneOffset() / 60;
        var qrcode_pix;
        var pixIntervId;
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/pay_with_pix_zoop.php",
          data: {
            invoice_code: com_codigo,
            payment_amount: $("#valorPagamento0").val().replace(",", "."),
            payment_currency: "BRL",
            payment_description: `${$_CONFIG.APELIDOESTABELECIMENTO}_${com_codigo}_PIX`,
            device_color_depth: screen.colorDepth,
            device_java_enabled: navigator.javaEnabled(),
            device_language: navigator.language,
            device_screen_height: browserScreenHeight,
            device_screen_width: browserScreenWidth,
            device_time_zone_off_set: time_zone_off_set,
            device_type: "BROWSER",
            postal_code: $scope.dadosClienteComanda.Cli_CEP,
          },
          dataType: "json",
          success: function (data) {
            if (data.data.error == false) {
              if (qrcode_pix != undefined) {
                $("#qrcode-pagamento-comanda").html("")
                clearInterval(pixIntervId);
                  pixIntervId = null;
              } else {
                $("#qrcode-pagamento-comanda").html("")
                clearInterval(pixIntervId);
                  pixIntervId = null;
                $("#qrcode-pagamento-comanda").qrcode(data.data.online_payment[0].pix_qr_code)
                /*qrcode_pix = new QRCode(
                  document.getElementById("qrcode-pagamento-comanda"),
                  {
                    text: data.data.online_payment[0].pix_qr_code,
                    width: 200,
                    height: 200,
                    colorDark: "#000000",
                    colorLight: "#FFFFFF",
                    correctLevel: QRCode.CorrectLevel.H,
                  }
                );*/
                $("#com_codigo_title_pix").html(com_codigo);
               
                  var htmlData =
                    '<button class="btn btn-sm btn-primary btnClipLinkQrCode" data-clipboard-text="' +
                    data.data.online_payment[0].pix_qr_code +
                    '" ><i class="fa fa-copy" alt="Copiar"></i> Pix Copia e Cola</button>';
                  $("#btnBaixarImagemQRCode_pix").html(htmlData);
                  var clipboard = new ClipboardJS(".btnClipLinkQrCode");
                  clipboard.on("success", function (e) {
                    toastr.success("Copiado!");
                  });

                  clearInterval(pixIntervId);
                  pixIntervId = null;
                  pixIntervId = setInterval(function () {
                    if (buscaComandaPagoOnline(com_codigo) == true) {
                      $("#qrCodePagamento-modal").modal("hide");
                      clearInterval(pixIntervId);
                      displayComanda(com_codigo);
                      $("#btnCobrarCliente").hide();
                    }
                  }, 10000);

                  var cincoMin = 60 * 5;
                  var display = document.querySelector("#timer_pix");
                  $scope.startTimer(cincoMin, display);
                  setTimeout(function () {
                    clearInterval(pixIntervId);
                  }, 300000);
                
                $("#qrCodePagamento-modal").modal();

                showLoader(false);
              }
            } else {
              showLoader(false);
              toastr.error(data.data.message);
            }
          },
          error: function (data) {
            showLoader(false);
          },
        });
      };

      function buscaComandaPagoOnline(com_codigo) {
        var retorno = false;
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/COMANDA_Busca_Pagamento_Online_Empresa.php",
          async: false,
          data: {
            type: 1,
            invoice_code: com_codigo,
          },
          dataType: "json",
          success: function (data) {
            if (data.data.error == false) {
              retorno = true;
            } else {
              retorno = false;
            }
          },
          error: function (result) {},
        });
        return retorno;
      }

      $scope.startTimer = function (duration, display) {
        var timer = duration,
          minutes,
          seconds;
        var countdown;
        clearInterval(countdown);
        countdown = null;
        countdown = setInterval(function () {
          minutes = parseInt(timer / 60, 10);
          seconds = parseInt(timer % 60, 10);

          minutes = minutes < 10 ? "0" + minutes : minutes;
          seconds = seconds < 10 ? "0" + seconds : seconds;

          display.textContent = minutes + ":" + seconds;

          if (--timer < 0) {
            $("#label_timer_pix").html(
              '<b style="color:red">Seu código expirou, a tela será fechada automaticamente<b/>'
            );
            setTimeout(function () {
              $("#qrCodePagamento-modal").modal("hide");
            }, 4000);
            clearInterval(countdown);
          }
        }, 1000);
      };

