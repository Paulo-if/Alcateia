          buttons: [
            {
              extend: "excelHtml5",
              text: "Excel",
              exportOptions: {
                columns: [0, 1, 2, 3, 4, 5],
              },
              footer: "true",
            },
            {
              extend: "pdfHtml5",
              title: $Options.sistema + " - Histórioco de Comandas",
              orientation: "landscape",
              pageSize: "LEGAL",
              exportOptions: {
                columns: [0, 1, 2, 3, 4, 5],
              },
            },
            {
              extend: "print",
              text: "Imprimir",
              exportOptions: {
                columns: [0, 1, 2, 3, 4, 5],
              },
              footer: true,
            },
          ],

          stateSaveCallback: function (settings, data) {
            data.order = [];
