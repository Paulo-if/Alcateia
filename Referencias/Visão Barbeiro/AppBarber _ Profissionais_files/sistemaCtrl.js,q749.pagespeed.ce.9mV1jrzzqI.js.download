      $scope.imprimirProntuario = function () {
        PrintElem("Prontuário", "#prontuarioImprimir");
      };

      function PrintElem(title, elem) {
        Popup(title, $(elem).html());
      }

      function Popup(title, data) {
        var mywindow = window.open(
          "",
          "Imprimir prontuário",
          "height=600,width=800"
        );
        mywindow.document.write("<html><head><title>" + title + "</title>");
        mywindow.document.write(
          '<link rel="stylesheet" href="/css/print.css"/>'
        );
        mywindow.document.write(
          '<link rel="stylesheet" href="css/bootstrap.css"/>'
        );
        mywindow.document.write(
          '</head><body onload="window.print();window.close();">'
        );
        mywindow.document.write(data);
        mywindow.document.write("</body></html>");
        mywindow.document.close();
        mywindow.focus();
        return true;
      }

      $scope.buscaTipoCategoriaGeral = function () {
        var tipccategoria = "";
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaTipoCategoria.php",
          dataType: "json",

          success: function (result) {
            tipccategoria += "<option value=''>Nenhuma</option>";
            for (var i = 0; i < result.result.length; i++) {
              tipccategoria +=
                "<option value='" +
                result.result[i].TCT_Codigo +
                "'>" +
                result.result[i].TCT_Descricao +
                "</option>";
            }
            $("#tipocategoria").html(tipccategoria);
          },
          error: function (result) {
            tipccategoria +=
              "<option value=''>Nenhuma opção disponível</option>";
            $("#tipocategoria").html(tipccategoria);
          },
        });
      };
      $scope.buscaTipoCategoriaGeral();

      $scope.buscaCategoriaGeral = function (tipo, elem) {
        var htmlcategoria = "";
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaCategoria.php",
          dataType: "json",
          data: {
            tipo: tipo,
          },

          success: function (result) {
            htmlcategoria += "<option value=''>Nenhuma</option>";
            for (var i = 0; i < result.data.length; i++) {
              htmlcategoria +=
                "<option value=" +
                result.data[i].TCa_Codigo +
                ">" +
                result.data[i].TCa_Descricao +
                "</option>";
            }
            htmlcategoria += "<br>";

            $("#" + elem).html(htmlcategoria);
          },
          error: function (result) {
            swal("Falha na conexão.", "", "error");
            showLoader(false);
          },
        });
      };

      $scope.buscaCategoriaProfissionalGeral = function () {
        $("#spCategoria").multiselect("destroy");
        var categorias = "";
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaCategoria.php",
          dataType: "json",
          data: {
            tipo: 1,
          },

          success: function (result) {
            for (var i = 0; i < result.data.length; i++) {
              categorias +=
                "<option value='" +
                result.data[i].TCa_Codigo +
                "'>" +
                result.data[i].TCa_Descricao +
                "</option>";
            }
            $("#spCategoria").html(categorias);
            $("#spCategoria").multiselect({
              buttonText: function (options, select) {
                if (options.length === 0) {
                  return "Categorias";
                } else if (options.length > 3) {
                  return $_CONFIG.language.mais_categorias_selecionada;
                } else {
                  var labels = [];
                  options.each(function () {
                    if ($(this).attr("label") !== undefined) {
                      labels.push($(this).attr("label"));
                    } else {
                      labels.push($(this).html());
                    }
                  });
                  return labels.join(", ") + "";
                }
              },
              buttonWidth: "100%",
            });
          },
          error: function (result) {
            $("#spCategoria").multiselect();
          },
        });
      };

      $scope.cadastrarCategoriaGeral = function (tipo) {
        $("#cadastrarcategoria-modal").modal();
        $("#tipocategoria").val(tipo);
      };

      $("#formCategoria").submit(function (event) {
        event.preventDefault();
        formCategoria = $(this);
        dataForm = new FormData(this);
        showLoader(true);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/insereCategoria.php",
          data: dataForm,
          dataType: "json",
          processData: false,
          contentType: false,
          success: function (result) {
            if (result.data[0].erro == "0") {
              if (location.hash == "#/categorias") {
                $rootScope.$emit("atualizaDadosCategoria", {});
              }
              if (location.hash == "#/servicos") {
                $scope.buscaCategoriaGeral(2, "serCategoria");
                $scope.buscaCategoriaGeral(2, "serCategoriaEdt");
                setTimeout(function () {
                  $("#serCategoria").val(result.data[0].codigocategoria);
                  $("#serCategoriaEdt").val(result.data[0].codigocategoria);
                }, 1000);
              }
              if (location.hash == "#/estoque") {
                $scope.buscaCategoriaGeral(3, "proCategoria");
                $scope.buscaCategoriaGeral(3, "proCategoriaEdt");
                setTimeout(function () {
                  $("#proCategoria").val(result.data[0].codigocategoria);
                  $("#proCategoriaEdt").val(result.data[0].codigocategoria);
                }, 1000);
              }
              if (location.hash == "#/profissionais") {
                $scope.buscaCategoriaProfissionalGeral();
              }
              toastr.success(result.data[0].resultado);
              $("#cadastrarcategoria-modal").modal("hide");
              formCategoria.each(function () {
                this.reset();
              });
            } else {
              toastr.error(result.data[0].resultado);
            }
            showLoader(false);
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });

        return true;
      });

      $scope.verpreviewmensagem = function () {
        if ($scope.sistemaName == "AppBarber") {
          $("#logopushbarber").show();
          $("#logopushbeleza").hide();
        } else {
          $("#logopushbarber").hide();
          $("#logopushbeleza").show();
        }
        $("#previewmensagem-modal").modal();
      };

      $scope.buscaDocumentoSelect = function () {
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaDocumento.php",
          data: {
            tipo: 1,
          },
          dataType: "json",

          success: function (result) {
            var html = "<option value=''> Documento</option>";
            for (var i = 0; i < result.data.length; i++) {
              html +=
                "<option value='" +
                result.data[i].Doc_Codigo +
                "'>" +
                result.data[i].Doc_Titulo +
                "</option>";
            }
            $("#documentoSelect").html(html);
            $("#documentoSelectProfissional").html(html);
          },
          error: function (result) {
            $("#documentoSelect").html("<option value=''> Documento</option>");
            $("#documentoSelectProfissional").html(
              "<option value=''> Documento</option>"
            );
            showLoader(false);
          },
        });
      };

      $scope.novoDocumentoCliente = function (
        cliente,
        profissional,
        agendamento,
        servico,
        assinatura,
        adecodigo
      ) {
        $("#divCorpoDocumento").hide();
        $("#corpoDocumentoCliente").data("wysihtml5").editor.setValue("");
        $("#pesCodigoClienteDocumento").val(cliente);
        $("#pesCodigoProfissionalDocumento").val(profissional);
        $("#ageCodigoDocumento").val(agendamento);
        $("#serCodigoDocumento").val(servico);
        $("#assCodigoDocumento").val(assinatura);
        $("#adeCodigoDocumento").val(adecodigo);
        $scope.buscaDocumentoSelect();

        $("#novodocumentocliente-modal").modal();
      };

      $scope.novoDocumentoProfissional = function (profissional) {
        $("#divCorpoDocumentoProfissional").hide();
        $("#corpoDocumentoProfissional").data("wysihtml5").editor.setValue("");

        $("#codigoProfissionalDocumento").val(profissional);

        $scope.buscaDocumentoSelect();

        $("#novodocumentoprofissional-modal").modal();
      };

      $scope.listDocumento = function (
        cliente,
        profissional,
        agendamento,
        servico,
        assinatura,
        adecodigo
      ) {
        if (typeof tabelaDocumentosPront != "undefined") {
          $("#tabelaListaDocumentos tbody").unbind("click");
          tabelaDocumentosPront.destroy();
        }
        tabelaDocumentosPront = $("#tabelaListaDocumentos").DataTable({
          dom: 'T<"clear">lfrtip',
          ajax: {
            url: "/pages/cadastros/buscaPessoaDocumento.php",
            method: "POST",
            data: function (d) {
              d.tipo = 2;
              d.cliente = cliente;
              d.adecodigo = adecodigo;
            },
          },
          scrollX: isPortrait,
          stateSaveCallback: function (settings, data) {
            data.order = [];
            localStorage.setItem(
              "DataTables_" + settings.sInstance,
              JSON.stringify(data)
            );
          },
          stateLoadCallback: function (settings) {
            return JSON.parse(
              localStorage.getItem("DataTables_" + settings.sInstance)
            );
          },
          stateSave: true,
          columns: [
            {
              data: "Doc_Titulo",
            },
            {
              data: "PDo_Dat_Cadastro",
              type: "moment-DD/MM/YYYY hh:mm",
            },
            {
              class: "viewDocumento",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn btn-success btn-xs"><i class="fa fa-search"></i></button>',
            },
            {
              class: "printDocumento",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn bg-teal-dark btn-xs"><i class="fa fa-print"></i></button>',
            },
            {
              class: "pdfDocumento",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn bg-teal-dark btn-xs"><i class="fa fa-file-pdf-o"></i></button>',
            },
            {
              class: "removeDocumentoProntuario",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></button>',
            },
          ],
          order: [1, "asc"],
          language: {
            url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
          },
        });

        $("#tabelaListaDocumentos tbody").on(
          "click",
          "td.viewDocumento",
          function () {
            var tr = $(this).closest("tr");
            var row = tabelaDocumentosPront.row(tr);
            var data = row.data();
            var emailDocumento = "";
            if (data.Pes_Nome != undefined && data.Pes_Nome != null) {
              nomeDestinatario = data.Pes_Nome;
            }
            if (data.PAF_Email != undefined && data.PAF_Email != null) {
              emailDocumento = data.PAF_Email;
            } else if (data.Pes_Email != undefined && data.Pes_Email != null) {
              emailDocumento = data.Pes_Email;
            }
            $("#tituloDocumentoView").html(data.Doc_Titulo);
            $("#corpoDocumentoView").html(data.PDo_Corpo);
            $("#assinaturaDocumentoView").html("");
            $("#btnEnviarDocumentoEmail")
              .data("email", (emailDocumento || "").toString().trim())
              .data("Doc_Titulo", data.Doc_Titulo || "")
              .data("PDo_Corpo", data.PDo_Corpo || "")
              .data("PDo_Link_Assinatura", data.PDo_Link_Assinatura || "");
            $("#viewdocumentocliente-modal").modal();
          }
        );

        $("#tabelaListaDocumentos tbody").on(
          "click",
          "td.printDocumento",
          function () {
            var tr = $(this).closest("tr");
            var row = tabelaDocumentosPront.row(tr);
            var data = row.data();
            Popup(data.Doc_Titulo, data.PDo_Corpo);
          }
        );
        $("#tabelaListaDocumentos tbody").on(
          "click",
          "td.pdfDocumento",
          function () {
            var tr = $(this).closest("tr");
            var row = tabelaDocumentosPront.row(tr);
            var data = row.data();
            $scope.salvaPdfHtml(data.Doc_Titulo, data.PDo_Corpo);
          }
        );

        $("#tabelaListaDocumentos tbody").on(
          "click",
          "td.removeDocumentoProntuario",
          function () {
            var tr = $(this).closest("tr");
            var row = tabelaDocumentosPront.row(tr);
            var data = row.data();
            swal(
              {
                title: "Excluir",
                text: "Deseja realmente excluir este documento?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Sim",
                cancelButtonText: "Não",
              },
              function (Confirmou) {
                if (Confirmou) {
                  $.ajax({
                    type: "POST",
                    url: "/pages/cadastros/removePessoaDocumento.php",
                    data: {
                      pdocodigo: data.PDo_Codigo,
                    },
                    dataType: "json",
                    success: function (result) {
                      tabelaDocumentosPront.ajax.reload();
                      toastr.success(result.data[0].resultado);
                    },
                    error: function (result) {},
                  });
                }
              }
            );
          }
        );

        var buttonnovodocumento =
          '<button id="btnNovoDocumentoProntuario" class="btn bg-teal-dark" ng-click="novoDocumentoCliente(' +
          cliente +
          "," +
          profissional +
          "," +
          agendamento +
          "," +
          servico +
          "," +
          assinatura +
          "," +
          adecodigo +
          ')"><i class="fa fa-plus"></i> Documento</button>';
        $("#divBtnNovoDocumento").html(buttonnovodocumento);
        $("#listaDocumentos-modal").modal();
        $compile($("#divBtnNovoDocumento"))($scope);
      };

      $("#documentoSelect").change(function () {
        if ($(this).val() != "") {
          $("#divCorpoDocumento").show();
          $("#btnPrintDocumento").unbind("click");
          $("#btndpfDocumento").unbind("click");
          $(this).prop("disabled", true);
          $("#corpoDocumentoCliente").data("wysihtml5").editor.setValue("");
          showLoader(true);

          $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaDocumento.php",
            data: {
              tipo: 2,
              doccodigo: $(this).val(),
            },
            dataType: "json",

            success: function (result) {
              if (result.data[0] != undefined && result.data[0] != "") {
                setTimeout(function () {
                  $("#documentoSelect").prop("disabled", false);
                }, 1500);

                $.ajax({
                  type: "POST",
                  url: "/pages/cadastros/replaceDocumento.php",
                  data: {
                    pesCodigoCliente: $("#pesCodigoClienteDocumento").val(),
                    corpoDocumento: result.data[0].Doc_Corpo,
                    pesCodigoProfissional: $(
                      "#pesCodigoProfissionalDocumento"
                    ).val(),
                    ageCodigo: $("#ageCodigoDocumento").val(),
                    serCodigo: $("#serCodigoDocumento").val(),
                    assCodigo: $("#assCodigoDocumento").val(),
                  },
                  dataType: "json",

                  success: function (result) {
                    $("#corpoDocumentoCliente")
                      .data("wysihtml5")
                      .editor.setValue(result.data);
                    $compile($("#btnPrintDocumento"))($scope);
                    $compile($("#btndpfDocumento"))($scope);
                    showLoader(false);
                  },

                  error: function (result) {
                    showLoader(false);

                    toastr.error("Falha na conexão.");
                  },
                });
              } else {
                $("#corpoDocumentoCliente")
                  .data("wysihtml5")
                  .editor.setValue("");
              }
            },
            error: function (result) {
              $("#corpoDocumentoCliente").data("wysihtml5").editor.setValue("");
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
        } else {
          $("#divCorpoDocumento").hide();
          $("#corpoDocumentoCliente").data("wysihtml5").editor.setValue("");
        }
      });

