      // Atualiza Dados itens
      $scope.atualizaDadosItens = function () {
        tabelaComItens.api().ajax.reload(function (e) {
          $("#listServicoComanda").html("");
          $("#listServicoComandaEdt").html("");
          var itens = tabelaComItens.fnGetData();
          var atualizavalores = 0;
          var valor = 0;

          if (itens.length != 1) {
            var numItemPagoonline = 0;
            for (var i = 0; i < itens.length; i++) {
              if (itens[i].PagamentoOnline == 1) {
                numItemPagoonline++;
                if (j == 1) {
                  valor = valor + parseFloat(itens[i].Valor.replace(",", "."));
                  valor = parseFloat(valor);
                  $("#btnNovoTipo").click();
                  $("#btnRemoveTipo1").remove();
                  atualizavalores = 1;
                } else {
                  valor = valor + parseFloat(itens[i].Valor.replace(",", "."));
                  valor = parseFloat(valor);
                  atualizavalores = 1;
                }
              }
              if (itens[i].CPoPagamentoTotal == 0) {
                valor = itens[i].CPoValor;
              }
              if (itens[i].TipoItem == 1) {
                $("#listServicoComanda").append(
                  `<option value="${itens[i].AgeCodigo}">${itens[i].Item} - Profissional: ${itens[i].Profissional}</option>`
                );
                $("#listServicoComandaEdt").append(
                  `<option value="${itens[i].AgeCodigo}">${itens[i].Item} - Profissional: ${itens[i].Profissional}</option>`
                );
              }
            }
            if (numItemPagoonline == itens.length) {
              if (itens[i].CPoPagamentoTotal == 1) {
                $("#btnInsereProdutoComanda").prop("disabled", false);
                $("#btnInsereServicoComanda").prop("disabled", false);
                $scope.removeTipoPagemento();
              } else {
                $("#btnInsereProdutoComanda").prop("disabled", true);
                $("#btnInsereServicoComanda").prop("disabled", true);
                atualizavalores = 1;
                valor = itens[0].CPoValor;
              }
              if ($_CONFIG.COBRANCA_CLIENTE == "1") {
                atualizaBotaoCobrarClienteComanda(itens[0].ValorTotal);
              } else {
                $("#btnCobrarCliente").hide();
              }
            }
            if (numItemPagoonline == 0) {
              atualizaBotaoCobrarClienteComanda(itens[0].ValorTotal);
            }
          } else {
            if (itens[0].PagamentoOnline == 1) {
              if (itens[0].CPoPagamentoTotal == 1) {
                $("#btnInsereProdutoComanda").prop("disabled", false);
                $("#btnInsereServicoComanda").prop("disabled", false);
                $scope.removeTipoPagemento();
              } else {
                $("#btnInsereProdutoComanda").prop("disabled", true);
                $("#btnInsereServicoComanda").prop("disabled", true);
                atualizavalores = 1;
                valor = itens[0].CPoValor;
              }
              if ($_CONFIG.COBRANCA_CLIENTE == "1") {
                atualizaBotaoCobrarClienteComanda(itens[0].ValorTotal);
              } else {
                $("#btnCobrarCliente").hide();
              }
            } else {
              atualizaBotaoCobrarClienteComanda(itens[0].ValorTotal);
            }
          }
          var vlrTotal = e.data[0];

          $("#valorTotalComanda").html($_CONFIG.MOEDA + vlrTotal.ValorTotal);
          $("#comValorPag").val(vlrTotal.ValorTotal);
          $("#comValorTotal").html($_CONFIG.MOEDA + vlrTotal.ValorTotal);
          if (atualizavalores == 0) {
            $("#valorPagamento0").val(vlrTotal.ValorTotal);
            if (j == 2) {
              $("#valorPagamento1").val(0.0);
            }
            $scope.calculaParcelas(vlrTotal.ValorTotal);
            $compile($("#tbComandaItens"))($scope);
            $("#tbComandaItens_paginate").click(function () {
              $compile($("#tbComandaItens"))($scope);
            });
          } else {
            $("#valorPagamento0").val(valor);
            $("#valorPagamento1").val(
              parseFloat(vlrTotal.ValorTotal.replace(",", ".")) - valor
            );
            $scope.calculaParcelas(vlrTotal.ValorTotal);
            $compile($("#tbComandaItens"))($scope);
            $("#tbComandaItens_paginate").click(function () {
              $compile($("#tbComandaItens"))($scope);
            });
          }
          $("#valorPagamento0").change();
          if ($("#valorPagamento1").val() !== undefined) {
            $("#valorPagamento1").change();
          }
        });
      };

