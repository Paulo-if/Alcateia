      $scope.getSubParameters = function () {
        var params = getAllParameters();
        var assList = [115, 164, 165, 166, 203, 214];
        if ($scope.parContaDigital2 == 1) {
          var assList = [115, 146, 164, 165, 166, 182, 183, 184, 203, 214];
        }

        var paramAssList = [];
        for (let i = 0; i < assList.length; i++) {
          paramAssList.push(
            params.find(({ parameter_code }) => parameter_code === assList[i])
          );
        }

        if (typeof optTabelaParametro != "undefined") {
          $("#params_table tbody").unbind("click");
          optTabelaParametro.destroy();
        }
        optTabelaParametro = $("#params_table").DataTable({
          dom: 'T<"clear">lfrtip',
          data: paramAssList,
          scrollX: isPortrait,
          columns: [
            {
              data: "parameter_description",
              title: "Parametro",
              width: "80%",
            },

            {
              orderable: false,
              data: "parameter_code",
              width: "10%",
              render: function (data, t, r) {
                if (r.parameter_primary_value == 1) {
                  var istrue = "selected";
                  var isfalse = "";
                } else {
                  var istrue = "";
                  var isfalse = "selected";
                }
                return `<select class='form-control' id="select_value_${r.parameter_code}">
                                    <option value="1" ${istrue}>Sim</option>
                                    <option value="0" ${isfalse}>Não</option>
                                </select>`;
              },
            },
            {
              class: "saveParameter",
              orderable: false,
              data: null,
              width: "5%",
              defaultContent:
                '<button class="btn btn-success btn-xs" ><i class="fa fa-floppy-o"></i></button>',
            },
          ],
          ordering: false,
          language: {
            url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
          },
        });

        $("#params_table tbody").on("click", "td.saveParameter", function () {
          var tr = $(this).closest("tr");
          var row = optTabelaParametro.row(tr);
          var data = row.data();

          $scope.salvaParametro(
            data.parameter_code,
            $(`#select_value_${data.parameter_code}`).val(),
            ""
          );
        });

        $("#param_modal-modal").modal();
        setTimeout(() => {
          resizeContent();
        }, 1000);
      };

      $scope.geraCupomComanda = function () {
        showLoader(true);
        $.ajax({
          dataType: "json",
          method: "POST",
          url: "/pages/cadastros/buscaComandaItens.php",
          async: false,
          data: {
            codigo: $("#lblComCodigo").html(),
          },
          success: function (data) {
            $scope.itensComandacupon = data.data;
            if (!$scope.itensComandacupon || $scope.itensComandacupon.length == 0) {
              toastr.error("Não foi possível gerar o comprovante.");
              showLoader(false);
              return;
            }

            var escapeHtml = function (value) {
              return String(value == null ? "" : value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/\"/g, "&quot;")
                .replace(/'/g, "&#39;");
            };

            var itemBase = $scope.itensComandacupon[0];
            var comcodigocupom =
              itemBase.Com_Codigo || $("#idComanda").html() || $("#lblComCodigo").html();
            var nomecupom = itemBase.Cliente || $("#nomeClienteComanda").html() || "Cliente";
            var valorcupom = itemBase.Com_Vlr_Total || "0,00";
            var datacomanda =
              itemBase.Com_Dat_Cadastro || $("#dataComanda").html() || moment().format("DD/MM/YYYY HH:mm");

            var estabelecimento = "";
            var enderecoEstabelecimento = "";
            var telefoneEstabelecimento = "";
            var emailEstabelecimento = "";
            var cnpjEstabelecimento = "";

            $.ajax({
              dataType: "json",
              url: "/pages/cadastros/buscaPessoa.php",
              method: "POST",
              async: false,
              data: {
                tipo: 2,
              },
              success: function (resultPessoa) {
                if (resultPessoa.buscaPessoa && resultPessoa.buscaPessoa.length > 0) {
                  var empresa = resultPessoa.buscaPessoa[0];
                  estabelecimento = empresa.Nome || "";
                  enderecoEstabelecimento =
                    (empresa.Endereco || "") +
                    ", " +
                    (empresa.Numero || "") +
                    " - " +
                    (empresa.Bairro || "") +
                    " | " +
                    (empresa.Cid_Nome || "") +
                    "/" +
                    (empresa.Est_Sigla || "");
                  telefoneEstabelecimento = empresa.Telefone || empresa.Celular || "";
                  emailEstabelecimento = empresa.Email || "";
                  cnpjEstabelecimento = empresa.CNPJ || "";
                }
              },
            });

            if (estabelecimento == "") {
              estabelecimento = $("#nomeSalao").html() || $_CONFIG.ESTABELECIMENTO || "";
            }

            var responsavelGeral = itemBase.Pes_Nome || "";

            var trloop = "";
            var itemLinha = 1;

            for (var a = 0; a < $scope.itensComandacupon.length; a++) {
              var nomeitem = $scope.itensComandacupon[a].Ser_Descricao;
              if ($scope.itensComandacupon[a].Ser_Descricao == "") {
                nomeitem = $scope.itensComandacupon[a].Pro_Descricao;
              }

              if ($scope.itensComandacupon[a].CIt_Venda == "0") {
                continue;
              }

              trloop += `<tr>
                  <td class="center">${itemLinha}</td>
                  <td>${escapeHtml(nomeitem)}</td>
                  <td>${escapeHtml($scope.itensComandacupon[a].Profissional || "-")}</td>
                  <td class="center">${escapeHtml($scope.itensComandacupon[a].CIt_Quantidade || "1")}</td>
                  <td class="right">${escapeHtml($scope.itensComandacupon[a].CIt_Valor || "0,00")}</td>
							  </tr>`;
              itemLinha++;
            }

            if (trloop == "") {
              trloop = `<tr><td colspan="5" class="empty-row">Sem itens vendidos para exibir.</td></tr>`;
            }

            var valorPago = $("#comValorTotal").html() || valorcupom;
            var parcelado = "Não";
            if ($("#parcelarCaixa").length > 0 && $("#parcelarCaixa").get(0).checked) {
              parcelado = "Sim";
            }
            var qtdParcelas = $("#selVezesParcela option:selected").text() || "-";
            var periodicidadeParcela =
              $("#selPeriodicidadeVenda option:selected").text() || "-";

            var htmlTeste = `<html>
								<head>
									<meta charset="UTF-8">
									<title>AppBeleza - Comprovante</title>
                <style>
                  body {
                    margin: 0;
                    padding: 20px;
                    background: #ffffff;
                    font-family: Verdana, Arial, sans-serif;
                    color: #1d1d1d;
                  }

                  .receipt-wrap {
                    max-width: 920px;
                    margin: 0 auto;
                  }

                  .printer-ticket {
                    width: 100%;
                    border-collapse: collapse;
                  }

                  .printer-ticket th,
                  .printer-ticket td {
                    border-bottom: 1px solid #e6e6e6;
                    padding: 8px 6px;
                    font-size: 12px;
                    text-align: left;
                  }

                  .printer-ticket .title {
                    font-size: 18px;
                    text-align: center;
                    border-bottom: 0;
                    padding-top: 2px;
                    padding-bottom: 2px;
                  }

                  .printer-ticket .address {
                    font-size: 11px;
                    line-height: 1.4;
                    text-align: center;
                    color: #4d4d4d;
                    border-bottom: 0;
                    padding-top: 2px;
                    padding-bottom: 10px;
                  }

                  .printer-ticket .meta {
                    text-align: center;
                    border-top: 1px solid #dcdcdc;
                    border-bottom: 1px solid #dcdcdc;
                    padding-top: 10px;
                    padding-bottom: 10px;
                  }

                  .printer-ticket .meta p {
                    margin: 3px 0;
                    font-size: 12px;
                  }

                  .printer-ticket .head {
                    text-transform: uppercase;
                    font-size: 11px;
                    color: #555;
                    letter-spacing: 0.3px;
                  }

                  .center {
                    text-align: center !important;
                  }

                  .right {
                    text-align: right !important;
                  }

                  .resumo {
                    width: 100%;
                    border-collapse: collapse;
                    margin-top: 10px;
                  }

                  .resumo th,
                  .resumo td {
                    border-bottom: 1px solid #e6e6e6;
                    padding: 8px 6px;
                    font-size: 12px;
                    text-align: left;
                  }

                  .resumo td:last-child {
                    text-align: right;
                    font-weight: 700;
                  }

                  .empty-row {
                    text-align: center;
                    color: #666;
                  }
                </style>
								</head>

              <body>
                <div class="receipt-wrap">
                  <table class="printer-ticket">
                    <thead>
                      <tr><th class="title" colspan="5">${escapeHtml(estabelecimento)}</th></tr>
                      <tr><th class="address" colspan="5">
                        ${
                          enderecoEstabelecimento != ""
                            ? `${escapeHtml(enderecoEstabelecimento)}<br>`
                            : ""
                        }
                        ${
                          telefoneEstabelecimento != ""
                            ? `Telefone: ${escapeHtml(telefoneEstabelecimento)}<br>`
                            : ""
                        }
                        ${
                          emailEstabelecimento != ""
                            ? `Email: ${escapeHtml(emailEstabelecimento)}<br>`
                            : ""
                        }
                        ${
                          cnpjEstabelecimento != ""
                            ? `${escapeHtml(cnpjEstabelecimento)}`
                            : ""
                        }
                        ${
                          responsavelGeral != ""
                            ? `<br>Responsável geral: ${escapeHtml(responsavelGeral)}`
                            : ""
                        }
                      </th></tr>
                      <tr><th class="meta" colspan="5">
                        <p><strong>Comprovante não fiscal</strong></p>
                        <p>Comanda: ${escapeHtml(comcodigocupom)}</p>
                        <p>Cliente: ${escapeHtml(nomecupom)}</p>
                        <p>${escapeHtml(datacomanda)}</p>
                      </th></tr>
                      <tr>
                        <th class="head" style="width:6%;">Item</th>
                        <th class="head" style="width:38%;">Descrição</th>
                        <th class="head" style="width:28%;">Prof.</th>
                        <th class="head center" style="width:8%;">Qtd</th>
                        <th class="head right" style="width:20%;">Valor (R$)</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${trloop}
                    </tbody>
                  </table>

                  <table class="resumo">
                    <tr>
                      <th>Total da Comanda:</th>
                      <td>R$ ${escapeHtml(valorcupom)}</td>
                    </tr>
                    <tr>
                      <th>Valor Pago:</th>
                      <td>${escapeHtml(valorPago)}</td>
                    </tr>
                    <tr>
                      <th>Parcelado?</th>
                      <td>${escapeHtml(parcelado)}</td>
                    </tr>
                    ${
                      parcelado == "Sim"
                        ? `<tr><th>Qtd de Parcelas</th><td>${escapeHtml(qtdParcelas)}</td></tr>
                           <tr><th>Periodicidade</th><td>${escapeHtml(periodicidadeParcela)}</td></tr>`
                        : ""
                    }
                  </table>
                </div>
								</body>

							</html>`;

            var element = htmlTeste;
            var opt = {
              margin: [15, 15],
              filename: `${nomecupom}-${comcodigocupom}.pdf`,
              image: {
                type: "jpeg",
                quality: 0.98,
              },
              html2canvas: {
                scale: 2,
                letterRendering: true,
              },
              jsPDF: {
                unit: "pt",
                format: "letter",
                orientation: "portrait",
              },
              pagebreak: {
                mode: ["avoid-all", "css", "legacy"],
              },
            };
            html2pdf().set(opt).from(element).save();

            showLoader(false);
          },
          error: function (data) {
            $scope.itensComandacupon = "";
            showLoader(false);
          },
        });
      };

      $scope.buscaValorServico = function () {
        var servico = "";
        $.ajax({
          dataType: "json",
          url: "pages/cadastros/buscaServicoSelect.php",
          data: {},
          success: function (data) {
            var servico =
              '<option  value="" selected>Selecione seu serviço de corte</option>';
            for (var i = 0; i < data.servicos.length; i++) {
              var valor = data.servicos[i].Ser_Valor;
              var nome = data.servicos[i].Ser_Descricao;
              var moeda = data.servicos[i].Moeda;
              servico += `<option value="${valor}">${nome} - ${moeda}${valor}</option>`;
            }
            $("#valorCorte").html(servico);
          },
        });
      };

