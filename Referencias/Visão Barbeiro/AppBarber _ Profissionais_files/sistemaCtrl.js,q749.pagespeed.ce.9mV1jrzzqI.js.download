      $("#btnImprimeDocumento").click(function () {
        var titulo = $("#tituloDocumentoView").html();
        var corpo = $("#corpoDocumentoView").html();
        var assinatura = $("#assinaturaDocumentoView").html();
        
        var conteudoCompleto = corpo;
        if (assinatura && assinatura.trim() !== '') {
          conteudoCompleto += '<div style="margin-top: 20px; text-align: center;">' + assinatura + '</div>';
        }
        
        Popup(titulo, conteudoCompleto);
      });

      $("#btnEnviarDocumentoEmail")
        .off("click.sendDocumentoSistema")
        .on("click.sendDocumentoSistema", function (event) {
          event.preventDefault();

          var $btnEnviarDocumentoEmail = $(this);
          if ($btnEnviarDocumentoEmail.data("sending") === true) {
            return;
          }

          var email =
            ($btnEnviarDocumentoEmail.data("email") || "").toString().trim();
          var titulo = ($("#tituloDocumentoView").text() || "").trim();
          var corpo = $("#corpoDocumentoView").html() || "";
          var assinaturaLink =
            (
              $btnEnviarDocumentoEmail.data("signature_link") ||
              $btnEnviarDocumentoEmail.data("PDo_Link_Assinatura") ||
              ""
            )
              .toString()
              .trim();
          var codigoDocumento =
            ($btnEnviarDocumentoEmail.data("PDo_Codigo") || "")
              .toString()
              .trim();

          if (titulo == "") {
            titulo =
              ($btnEnviarDocumentoEmail.data("Doc_Titulo") || "")
                .toString()
                .trim();
          }

          if (corpo == "") {
            corpo =
              ($btnEnviarDocumentoEmail.data("PDo_Corpo") || "")
                .toString();
          }

          if (email == "") {
            toastr.warning("E-mail do cliente associado a este documento não encontrado.");
            return;
          }

          $btnEnviarDocumentoEmail.data("sending", true).prop("disabled", true);

          showLoader(true);
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/enviaEmailDocumentoCliente.php",
            data: {
              email: email,
              document_title: titulo,
              document_body: corpo,
              signature_link: assinaturaLink,
              PDo_Codigo: codigoDocumento,
            },
            dataType: "json",
            success: function (result) {
              var retorno = result != undefined ? result.data : null;
              var envioOk =
                retorno != undefined &&
                retorno != null &&
                (retorno.erro == "0" || retorno.erro == 0);

              if (envioOk) {
                toastr.success("Documento enviado com sucesso.");
              } else {
                var mensagemErro =
                  retorno != undefined && retorno != null && retorno.resultado
                    ? retorno.resultado
                    : "";
                toastr.error(
                  mensagemErro || "Nao foi possivel enviar o documento por e-mail."
                );
              }

              showLoader(false);
              $btnEnviarDocumentoEmail
                .data("sending", false)
                .prop("disabled", false);
            },
            error: function () {
              toastr.error("Falha na conexao.");
              showLoader(false);
              $btnEnviarDocumentoEmail
                .data("sending", false)
                .prop("disabled", false);
            },
          });
        });

      $("#btnPDFDocumento").click(function () {
        var titulo = $("#tituloDocumentoView").html();
        var corpo = $("#corpoDocumentoView").html();
        
        var imgAssinatura = $("#assinaturaDocumentoView").find("img");
        
        if (imgAssinatura.length > 0 && imgAssinatura.attr("src")) {
          var img = new Image();
          img.crossOrigin = "Anonymous";
          
          img.onload = function () {
            var canvas = document.createElement("canvas");
            canvas.width = img.width;
            canvas.height = img.height;
            var ctx = canvas.getContext("2d");
            ctx.drawImage(img, 0, 0);
            
            try {
              var base64Image = canvas.toDataURL("image/png");
              var conteudoComImagem = corpo + 
                `<div style="margin-top: 20px; text-align: center;">
                  <label><strong>Assinatura</strong></label><br>
                  <img src="${base64Image}" style="width:300px; border: 1px solid #ddd; padding: 5px;">
                </div>`;
              $scope.salvaPdfHtml(titulo, conteudoComImagem);
            } catch (e) {
              console.error("Erro ao converter imagem para base64:", e);
              $scope.salvaPdfHtml(titulo, corpo);
            }
          };
          
          img.onerror = function() {
            console.error("Erro ao carregar imagem de assinatura");
            $scope.salvaPdfHtml(titulo, corpo);
          };
          
          img.src = imgAssinatura.attr("src") + 
            (imgAssinatura.attr("src").includes("?") ? "&" : "?") + 
            "t=" + new Date().getTime();
        } else {
          $scope.salvaPdfHtml(titulo, corpo);
        }
      });

      $scope.salvaPdf = function (titulo, elem) {
        showLoader(true);
        var element = elem;
        var opt = {
          margin: [15, 15],
          filename: `${titulo}.pdf`,
          image: {
            type: "jpeg",
            quality: 0.98,
          },
          html2canvas: {
            scale: 2,
            letterRendering: true,
          },
          jsPDF: {
            unit: "pt",
            format: "letter",
            orientation: "portrait",
          },
          pagebreak: {
            mode: ["avoid-all", "css", "legacy"],
          },
        };

        html2pdf().set(opt).from(element).save();
        showLoader(false);
      };

      $scope.salvaPdfHtml = function (titulo, html) {
        showLoader(true);
        var element = html;
        var opt = {
          margin: [15, 15],
          filename: `${titulo}.pdf`,
          image: {
            type: "jpeg",
            quality: 0.98,
          },
          html2canvas: {
            scale: 2,
            letterRendering: true,
          },
          jsPDF: {
            unit: "pt",
            format: "letter",
            orientation: "portrait",
          },
          pagebreak: {
            mode: ["avoid-all", "css", "legacy"],
          },
        };

        html2pdf().set(opt).from(element).save();
        showLoader(false);
      };

      $scope.addAuxiliar = function (
        codigo,
        sercodigo,
        pescodigoauxiliar,
        porcentagemauxiliar
      ) {
        $.ajax({
          dataType: "json",
          url: "pages/cadastros/buscaProfissionalSelect.php",
          success: function (data) {
            var profissional = "";
            profissional +=
              '<option  value="">' +
              $_CONFIG.language.profissional +
              "</option>";
            for (var i = 0; i < data.profissionais.length; i++) {
              var codigo = data.profissionais[i].Pes_Codigo;
              var nome = data.profissionais[i].Pes_Nome;
              profissional +=
                '<option  value="' + codigo + '">' + nome + "</option>";
            }
            $("#PesAuxiliar").html(profissional);

            if (pescodigoauxiliar != undefined && pescodigoauxiliar != "") {
              $("#removeAuxiliarComanda").show();
              $("#PesAuxiliar").val(pescodigoauxiliar);
            } else {
              $("#removeAuxiliarComanda").hide();
              $("#PesAuxiliar").val("");
            }
          },
        });

        if (porcentagemauxiliar != undefined && porcentagemauxiliar != "") {
          $("#PorAuxiliar").val(porcentagemauxiliar);
        } else {
          $("#PorAuxiliar").val("");
          $.ajax({
            dataType: "json",
            url: "pages/cadastros/buscaServicoAuxiliar.php",
            data: {
              sercodigo: sercodigo,
            },
            dataType: "json",
            success: function (data) {
              if (data.data.length > 0) {
                $("#PorAuxiliar")
                  .val(data.data[0].SAu_Comissao.replace(".", ""))
                  .keyup();
              } else {
                $("#PorAuxiliar").val("");
              }
            },
            error: function (data) {
              $("#PorAuxiliar").val("");
            },
          });
        }
        $("#CitCodigoAuxiliar").val(codigo);
        $("#auxiliar-modal").modal();
      };

      $scope.salvaAuxiliar = function () {
        if ($("#PesAuxiliar").val() == "") {
          toastr.error("Selecione um profissional");
        } else if ($("#PorAuxiliar").val() == "") {
          toastr.error("Informe a porcentagem de comissão a ser recebida");
        } else {
          showLoader(true);
          $.ajax({
            dataType: "json",
            method: "POST",
            url: "pages/cadastros/atualizaComandaAuxiliar.php",
            data: {
              citCodigo: $("#CitCodigoAuxiliar").val(),
              profissional: $("#PesAuxiliar").val(),
              comissao: $("#PorAuxiliar").val(),
              tipo: 1,
            },
            success: function (data) {
              if (data.data[0].erro == "0") {
                toastr.success(data.data[0].resultado);
                $scope.buscaItensComanda(data.data[0].comcodigo);
                $("#auxiliar-modal").modal("hide");
                showLoader(false);
              } else {
                toastr.error(data.data[0].resultado);
                showLoader(false);
              }
            },
            error: function (data) {
              toastr.success("Falha de conexão");
              showLoader(false);
            },
          });
        }
      };

      $scope.removeAuxiliar = function () {
        if ($("#CitCodigoAuxiliar").val() == "") {
          toastr.error("Informe o codigo do item");
        } else {
          showLoader(true);
          $.ajax({
            dataType: "json",
            method: "POST",
            url: "pages/cadastros/atualizaComandaAuxiliar.php",
            data: {
              citCodigo: $("#CitCodigoAuxiliar").val(),
              tipo: 2,
            },
            success: function (data) {
              if (data.data[0].erro == "0") {
                toastr.success(data.data[0].resultado);
                $scope.buscaItensComanda(data.data[0].comcodigo);
                $("#auxiliar-modal").modal("hide");
                showLoader(false);
              } else {
                toastr.error(data.data[0].resultado);
                showLoader(false);
              }
            },
            error: function (data) {
              toastr.success("Falha de conexão");
              showLoader(false);
            },
          });
        }
      };

      $("#PorAuxiliar").on("change", function () {
        valor = parseFloat($(this).val().replace(",", "."));
        if (valor > 100) {
          $("#PorAuxiliar").val("100.00");
        } else if ($(this).val() < 0) {
          $("#PorAuxiliar").val("0");
        }
      });

