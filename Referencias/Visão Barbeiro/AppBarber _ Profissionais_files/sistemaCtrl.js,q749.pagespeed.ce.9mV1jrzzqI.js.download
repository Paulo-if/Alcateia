              if (data.data[0].erro == "0") {
                toastr.success(data.data[0].resultado);
                $scope.atualizaDadosItens();
                if (location.hash == "#/comandasabertas") {
                  $rootScope.$emit("atualizaDadosComanda", {});
                }
                $("#comandaAlteraGorjeta-modal").modal("hide");
                $("#valorComandaGorjetaAltera").val("");
                $("#profissionalGorjetaAltera").val("");
              } else {
                toastr.error(data.data[0].resultado);
              }
            }
            showLoader(false);
          },
        });
      };

      $scope.edtImgProntuario = function () {
        $("#aimImagemInsere").click();
      };

      $("#cortaImagemAll-modal").on("hidden.bs.modal", function (e) {
        if ($scope.numImagemProntuario <= 2) {
          if (mBlob != undefined && mBlob != "") {
            if (($("#insereProntuario-modal").data("bs.modal") || {}).isShown) {
              $("#imagemProntuario" + $scope.numImagemProntuario).attr(
                "src",
                mImage
              );
              $("#formInsereImagemAgendamento").submit();
              $scope.numImagemProntuario++;
            }
            if (($("#EditaProntuario-modal").data("bs.modal") || {}).isShown) {
              if ($("#formid").val() == "#formAlteraImagemAgendamento") {
                $("#formAlteraImagemAgendamento").submit();
              } else {
                $("#formInsereImagemAgendamentoEDT").submit();
              }
            }
          }
          $("#imagemCutAll").resize();
          $("#imagemCutAll").cropper("reset");
        }
      });

      $("#formEditarClienteAgenda").submit(function (event) {
        event.preventDefault();
        showLoader(true);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/alteraClientes.php",
          data: new FormData(this),
          dataType: "json",
          processData: false,
          contentType: false,
          success: function (result) {
            if (result.alteraCliente[0].erro == "0") {
              /*if ($("#cliSenhaAgenda").val() != "") {
						$.ajax({
							type: "POST",
							url: "/pages/cadastros/alteraSenha.php",
							data: {
								tipo: 2,
								usuCodigo: $('#usucodigoalteracao').val(),
								pesCodigoAlt: $('#cliCodigoEdtAgenda').val(),
								senhaAlt: $("#cliSenhaAgenda").val(),
							},
							dataType: "json",
							success: function (result) {
								if (result.result[0].erro == "0") {
									toastr.success(result.result[0].resultado);

								} else {
									toastr.error(result.result[0].resultado);
								}
								showLoader(false);
							},
							error: function (result) {
								toastr.error($_CONFIG.language.errors.falha_conexao);
								showLoader(false);
							}
						});

					}*/
              toastr.success(result.alteraCliente[0].resultado);
              $("#editarClienteAgenda-modal").modal("hide");
              if (location.hash == "#/agenda") {
                $rootScope.$emit("BuscaAgenda", {});
              } else {
                $("#infoCliente-modal").modal("hide");
                setTimeout(function () {
                  $scope.mostraInfoClientes($("#cliCodigoEdtAgenda").val());
                  if (location.hash == "#/clientes") {
                    $rootScope.$emit("AtualizaListaCliente", {});
                  }
                }, 500);
              }
            } else {
              toastr.error(result.alteraCliente[0].resultado);
            }
            showLoader(false);
          },
          error: function (result) {
            toastr.error($_CONFIG.language.errors.falha_conexao);
            showLoader(false);
          },
        });

        return true;
      });

      $scope.editarClienteInfo = function () {
        $.ajax({
          method: "POST",
          dataType: "json",
          url: "/pages/cadastros/buscaClienteAlteraAgenda.php",
          data: {
            cliente: $("#cliPesCodigoInfo").val(),
          },
          success: function (data) {
            $("#cliSenhaAgenda").val("");
            $("#cliNomeEdtAgenda").val(data.result[0].Pes_Nome);
            $("#cliCpfEdtAgenda").val(data.result[0].Paf_Cpf);
            $("#cliEmailEdtAgenda").val(data.result[0].Paf_Email);
            $("#cliEmailEdtAgenda").change();
            $("#cliCelularEdtAgenda").val(data.result[0].Paf_Celular);
            $("#cliTelefoneEdtAgenda").val(data.result[0].Paf_Telefone);
            $("#cliEnderecoEdtAgenda").val(data.result[0].Paf_Endereco);
            $("#cliSexoEdtAgenda").val(data.result[0].Paf_Sexo);
            $("#cliDataNascimentoEdtAgenda").val(
              data.result[0].PAF_Dat_Nascimento
            );
            $("#usucodigoalteracao").val(data.result[0].Usu_Codigo);
            if (data.result[0].Usu_Codigo == "") {
              $("#possuiusu").hide();
              $("#npossuiusu").show();
            } else {
              $("#npossuiusu").hide();
              $("#possuiusu").show();
            }
            $("#cliEstadoEdtAgenda").val(data.result[0].Est_Sigla);
            $("#cliCepEdtAgenda").val(data.result[0].Paf_CEP);
            $("#cliCodigoEdtAgenda").val(data.result[0].Pes_Codigo);
            $("#cliEstadoEdtAgenda").val(data.result[0].Est_Codigo);
            $("#pesCodigoAltAgenda").val(data.result[0].Pes_Codigo);
            $("#cliObservacaoEdtAgenda").val(data.result[0].Paf_Observacao);
            $("#cliNumeroEdtAgenda").val(data.result[0].Paf_Numero);
            $("#cliComplementoEdtAgenda").val(data.result[0].Paf_Complemento);
            $("#cliBairroEdtAgenda").val(data.result[0].Paf_Bairro);
            $("#cliOndeAgenda").val(data.result[0].PAF_Com_Soube);
            $("#cliRGEdtAgenda").val(data.result[0].Paf_RG);
            $("#cliDialCodeEdtAgenda").val(data.result[0].DDI);
            $scope.geraComboPaisTelefone(
              "cliCelularEdtAgenda",
              "cliDialCodeEdtAgenda",
              data.result[0].DDI
            );
            $.ajax({
              dataType: "html",
              url: "/pages/cadastros/buscaCidades.php",
              method: "POST",
              data: {
                estCodigo: data.result[0].Est_Codigo,
              },
              success: function (result) {
                $("#cliCidadeEdtAgenda").append(result);
                $("#cliCidadeEdtAgenda").attr("disabled", false);
                $("#cliCidadeEdtAgenda").val(data.result[0].Cid_Codigo);
              },
            });
          },
          error: function (result) {},
        });
        $('[data-toggle="popover"]').popover({
          container: "body",
        });
        $("#editarClienteAgenda-modal").modal();
      };
      $("#cadastrarClienteComanda-modal").on("show.bs.modal", function (e) {
        $scope.geraComboPaisTelefone("cliCelularComanda", "cliDialCodeComanda");
      });

      $scope.runBuscaProntuarioCliente = function () {
        $scope.buscaProntuarioCliente($("#pescodigoProntuario").val());
      };

      $scope.limpaDataPront = function () {
        $("#cliDatInicioPron").val("");
        $("#cliDatFimPron").val("");
      };

      $scope.geraReciboVale = function (data) {
        $("#valorReciboVale").html(data.FCM_Valor);
        $("#dataReciboVale").html(data.FCM_Dat_Cadastro);
        $("#nomeReciboVale").html(data.Pes_Nome);
        var valor = data.FCM_Valor;
        valor = valor.replace($_CONFIG.MOEDA, "");
        $("#valorExtensoReciboVale").html(valor.extenso(true).toUpperCase());
        $("#reciboVale-modal").modal();
        $scope.buscaEmpresaInformacoesRecibo();
      };

      $scope.buscaEmpresaInformacoesRecibo = function () {
        var cidData = "";
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaEmpresaInfo.php",
          method: "POST",
          async: false,
          dataType: "json",
          success: function (result) {
            cidData =
              result.buscaPessoa[0].Cid_Nome +
              " (" +
              result.buscaPessoa[0].Est_Sigla +
              ")";
          },
        });
        var data = new Date();

        var mes = "";
        var dia = "";
        if (data.getDate() < 10) {
          dia = "0" + data.getDate();
        } else {
          dia = data.getDate();
        }
        if (data.getMonth() == 0) {
          mes = "Janeiro";
        } else if (data.getMonth() == 1) {
          mes = "Fevereiro";
        } else if (data.getMonth() == 2) {
          mes = "Março";
        } else if (data.getMonth() == 3) {
          mes = "Abril";
        } else if (data.getMonth() == 4) {
          mes = "Maio";
        } else if (data.getMonth() == 5) {
          mes = "Junho";
        } else if (data.getMonth() == 6) {
          mes = "Julho";
        } else if (data.getMonth() == 7) {
          mes = "Agosto";
        } else if (data.getMonth() == 8) {
          mes = "Setembro";
        } else if (data.getMonth() == 9) {
          mes = "Outubro";
        } else if (data.getMonth() == 10) {
          mes = "Novembro";
        } else if (data.getMonth() == 11) {
          mes = "Dezembro";
        }
        $("#dataLocalReciboVale").html(
          cidData + ", " + dia + " de " + mes + " de " + data.getFullYear()
        );
      };

      $scope.imorimeReciboVale = function () {
        PrintElem("Recibo Vale", "#reciboValeImprimir");
      };

      $("#usaEndereco").change(() => {
        if ($("#usaEndereco").val() == 0) {
          $("#cliCupomCEP").val($scope.dadosClienteNota.Paf_CEP);
          $("#cliCupomUF").val($scope.dadosClienteNota.Est_Sigla);
          $("#cliCupomCidade").val($scope.dadosClienteNota.Cid_Nome);
          $("#cliCupomBairro").val($scope.dadosClienteNota.Paf_Bairro);
          $("#cliCupomLogradouro").val($scope.dadosClienteNota.Paf_Endereco);
          $("#cliCupomNumero").val($scope.dadosClienteNota.Paf_Numero);
          $("#cliCupomComplemento").val(
            $scope.dadosClienteNota.Paf_Complemento
          );
        } else {
          $("#cliCupomCEP").val($scope.dadosEmpresaNota.CEP);
          $("#cliCupomUF").val($scope.dadosEmpresaNota.Estado);
          $("#cliCupomCidade").val($scope.dadosEmpresaNota.Cidade);
          $("#cliCupomBairro").val($scope.dadosEmpresaNota.Bairro);
          $("#cliCupomLogradouro").val($scope.dadosEmpresaNota.Endereco);
          $("#cliCupomNumero").val($scope.dadosEmpresaNota.Numero);
          $("#cliCupomComplemento").val($scope.dadosEmpresaNota.Complemento);
        }
      });

      $("#usaEnderecoProd").change(() => {
        if ($("#usaEnderecoProd").val() == 0) {
          $("#cliCupomCEPProd").val($scope.dadosClienteNota.Paf_CEP);
          $("#cliCupomUFProd").val($scope.dadosClienteNota.Est_Sigla);
          $("#cliCupomCidadeProd").val($scope.dadosClienteNota.Cid_Nome);
          $("#cliCupomBairroProd").val($scope.dadosClienteNota.Paf_Bairro);
          $("#cliCupomLogradouroProd").val(
            $scope.dadosClienteNota.Paf_Endereco
          );
          $("#cliCupomNumeroProd").val($scope.dadosClienteNota.Paf_Numero);
          $("#cliCupomComplementoProd").val(
            $scope.dadosClienteNota.Paf_Complemento
          );
          $("#cliCupomTelefoneProd").val($scope.dadosClienteNota.Paf_Celular);
        } else {
          $("#cliCupomCEPProd").val($scope.dadosEmpresaNota.CEP);
          $("#cliCupomUFProd").val($scope.dadosEmpresaNota.Estado);
          $("#cliCupomCidadeProd").val($scope.dadosEmpresaNota.Cidade);
          $("#cliCupomBairroProd").val($scope.dadosEmpresaNota.Bairro);
          $("#cliCupomLogradouroProd").val($scope.dadosEmpresaNota.Endereco);
          $("#cliCupomNumeroProd").val($scope.dadosEmpresaNota.Numero);
          $("#cliCupomComplementoProd").val(
            $scope.dadosEmpresaNota.Complemento
          );
          $("#cliCupomTelefoneProd").val($scope.dadosEmpresaNota.Telefone);
        }
      });

      $scope.emiteSemClientePacote = 0;
      $scope.emiteSemCPFPacote = 0;
      $scope.emiteSemEnderecoPacote = 0;

      $scope.generateCupomPacote = function (
        ppacodigo,
        cliente,
        geraaproser = 0,
        geraparteparceiro = ""
      ) {
        if ($scope.parnfapacote == 1 && $scope.parnota == 1) {
          $("#ppaCodigoNotaPacote").val(ppacodigo);
          $("#ppaCodigoNotaPacoteProduto").val(ppacodigo);
          $scope.itensPacoteNota = "";

          var valorPis = 0;
          var valorInss = 0;
          var valorCofins = 0;
          var valorIr = 0;
          var valorServicos = 0;
          var valorProduto = 0;
          var valorComissao = 0;
          var descricaoServicos = "";
          var citvalorProduto = 0;
          var numeroServicoPacote = 0;
          var numeroProdutoPacote = 0;
          var erroProduto = 0;
          var obsParceiro = "";
          var obsOriginal = "";

          var valorComissaoPacoteVenda = 0;
          var obsComissaoPacoteVenda = "";

          if ($scope.parEnderecoNota == 0) {
            $("#usaEnderecoNotaPacote").val(0).change();
          } else {
            $("#usaEnderecoNotaPacote").val(1).change();
          }
          $("#usaEnderecoNotaPacoteProd").val(0).change();

          if (geraparteparceiro != 1) {
            $.ajax({
              method: "POST",
              dataType: "json",
              url: "/pages/cadastros/buscaPessoaPacoteItens.php",
              async: false,
              data: {
                ppacodigo: ppacodigo,
                tipo: 1,
              },
              success: function (data) {
                $scope.itensPacoteNota = data.data;
                for (var a = 0; a < $scope.itensPacoteNota.length; a++) {
                  if ($scope.itensPacoteNota[a].Ser_Codigo != "") {
                    numeroServicoPacote++;
                  } else if ($scope.itensPacoteNota[a].Pro_Codigo != "") {
                    numeroProdutoPacote++;
                  }
                }

                if (
                  $scope.itensPacoteNota[0].PPa_Comissao != "" &&
                  $scope.itensPacoteNota[0].PPa_Comissao > 0.0
                ) {
                  valorComissaoPacoteVenda = parseFloat(
                    $scope.itensPacoteNota[0].PPa_Comissao
                  );

                  var profissionalcom = "";
                  var cnpjParceirovenda = $scope.itensPacoteNota[0].PAF_CPF;
                  if ($scope.nomeProfissionalNota == 1) {
                    profissionalcom = `${$scope.itensPacoteNota[0].Pes_Nome},`;
                  }

                  if (cnpjParceirovenda.replace(/\D/g, "").length >= 14) {
                    obsParceiro += `R$ ${valorComissaoPacoteVenda.toFixed(
                      2
                    )} de cota-parte profissional parceiro ${profissionalcom} CNPJ ${cnpjParceirovenda}, emitida no código: ${
                      $scope.itensPacoteNota[0].Codigo_Emissao
                    };\n`;
                  } else {
                    obsParceiro += `R$ ${valorComissaoPacoteVenda.toFixed(
                      2
                    )} de cota-parte profissional parceiro ${profissionalcom} CPF ${cnpjParceirovenda}, emitida no código: ${
                      $scope.itensPacoteNota[0].Codigo_Emissao
                    };\n`;
                  }
                }
                $(".nomePacoteEmissao").html(
                  $scope.itensPacoteNota[0].Pac_Descricao
                );
              },
              error: function (result) {},
            });
          } else {
            $.ajax({
              method: "POST",
              dataType: "json",
              url: "/pages/cadastros/buscaPessoaPacoteItens.php",
              async: false,
              data: {
                ppacodigo: ppacodigo,
                tipo: 3,
              },
              success: function (data) {
                $scope.itensPacoteNota = data.data;
                for (var a = 0; a < $scope.itensPacoteNota.length; a++) {
                  if ($scope.itensPacoteNota[a].Ser_Codigo != "") {
                    numeroServicoPacote++;
                  } else if ($scope.itensPacoteNota[a].Pro_Codigo != "") {
                    numeroProdutoPacote++;
                  }
                }

                if (
                  $scope.itensPacoteNota[0].PPa_Comissao != "" &&
                  $scope.itensPacoteNota[0].PPa_Comissao > 0.0
                ) {
                  valorComissaoPacoteVenda = parseFloat(
                    $scope.itensPacoteNota[0].PPa_Comissao
                  );

                  var profissionalcom = "";
                  var cnpjParceirovenda =
                    $scope.itensPacoteNota[0].PAF_CPF_prof;
                  if ($scope.nomeProfissionalNota == 1) {
                    profissionalcom = `${$scope.itensPacoteNota[0].Pes_Nome_prof},`;
                  }

                  if (cnpjParceirovenda.replace(/\D/g, "").length >= 14) {
                    obsParceiro += `R$ ${valorComissaoPacoteVenda.toFixed(
                      2
                    )} de cota-parte profissional parceiro ${profissionalcom} CNPJ ${cnpjParceirovenda}, emitida no código: ${
                      $scope.itensPacoteNota[0].Codigo_Emissao
                    };\n`;
                  } else {
                    obsParceiro += `R$ ${valorComissaoPacoteVenda.toFixed(
                      2
                    )} de cota-parte profissional parceiro ${profissionalcom} CPF ${cnpjParceirovenda}, emitida no código: ${
                      $scope.itensPacoteNota[0].Codigo_Emissao
                    };\n`;
                  }
                }
                $(".nomePacoteEmissao").html(
                  $scope.itensPacoteNota[0].Pac_Descricao
                );
              },
              error: function (result) {},
            });
          }

          if (
            numeroServicoPacote > 0 &&
            (geraaproser == 0 || geraaproser == 1)
          ) {
            if ($scope.parnfse == 1) {
              for (var i = 0; i < $scope.itensPacoteNota.length; i++) {
                if ($scope.itensPacoteNota[i].Ser_Codigo != "") {
                  if (i != 0) {
                    if (numeroServicoPacote > 1) {
                      descricaoServicos += ", ";
                    }
                  }
                  var citvalor =
                    $scope.itensPacoteNota[i].PTe_Quantidade *
                    parseFloat(
                      $scope.itensPacoteNota[i].PTe_Valor.replace(",", ".")
                    );
                  if ($("#empresaCSTNotaPacote").val() != "") {
                    $.ajax({
                      dataType: "json",
                      method: "POST",
                      url: "/pages/cadastros/buscaServicoSerCodigo.php",
                      async: false,
                      data: {
                        sercodigo: $scope.itensPacoteNota[i].Ser_Codigo,
                      },
                      success: function (result) {
                        for (var j = 0; j < result.servicos.length; j++) {
                          valorPis =
                            valorPis +
                            (citvalor * result.servicos[j].Ser_Pis) / 100;
                          valorInss =
                            valorInss +
                            (citvalor * result.servicos[j].Ser_Inss) / 100;
                          valorCofins =
                            valorCofins +
                            (citvalor * result.servicos[j].Ser_Cofins) / 100;
                          valorIr =
                            valorIr +
                            (citvalor * result.servicos[j].Ser_Ir) / 100;
                        }
                        $("#valorPisNotaPacote").html(valorPis);
                        $("#valorInssNotaPacote").html(valorInss);
                        $("#valorCofinsNotaPacote").html(valorCofins);
                        $("#valorClssNotaPacote").html(valorClss);
                        $("#valorIrNotaPacote").html(valorIr);
                      },
                      error: function (result) {
                        console.log(result);
                      },
                    });
                    $("#divCSTEmpresaNotaPacote").show();
                  } else {
                    $("#divCSTEmpresaNotaPacote").hide();
                  }
                  $("#valorPisNotaPacote").html(valorPis);
                  $("#valorInssNotaPacote").html(valorInss);
                  $("#valorCofinsNotaPacote").html(valorCofins);
                  $("#valorClssNotaPacote").html(0);
                  $("#valorIrNotaPacote").html(valorIr);
                  descricaoServicos += `${$scope.itensPacoteNota[i].Ser_Descricao} QTD: ${$scope.itensPacoteNota[i].PTe_Quantidade}`;
                  valorServicos = valorServicos + citvalor;

                  /*----------------------------------------------------------------------------------------------------------------------------------------------------*/

                  if ($scope.parnfdescontoparceiro == 1) {
                    var pesCodigoParceiro =
                      $scope.itensPacoteNota[i].Pes_Codigo;
                    if (
                      pesCodigoParceiro != "" &&
                      pesCodigoParceiro != undefined
                    ) {
                      $.ajax({
                        type: "POST",
                        url: "/pages/cadastros/buscaPessoav2.php",
                        async: false,
                        data: {
                          tipo: 2,
                          pescodigo: pesCodigoParceiro,
                        },
                        dataType: "json",
                        success: function (result) {
                          if (result.data.length != 0) {
                            if (
                              result.data[0].PAF_CPF != "" &&
                              result.data[0].PNa_Codigo != ""
                            ) {
                              var cnpjParceiro = result.data[0].PAF_CPF;
                              $.ajax({
                                type: "POST",
                                url: "/pages/cadastros/buscaPessoaNaturezav2.php",
                                async: false,
                                data: {
                                  tipo: "1",
                                  pescodigo: pesCodigoParceiro,
                                },
                                dataType: "json",
                                success: function (result) {
                                  var valorcomissaodesconto = parseFloat(
                                    $scope.itensPacoteNota[i].Comissao.replace(
                                      ",",
                                      "."
                                    )
                                  );
                                  valorComissao =
                                    valorComissao + valorcomissaodesconto;
                                  var profissional = "";
                                  if ($scope.nomeProfissionalNota == 1) {
                                    profissional = `${result.data[0].Pes_Nome},`;
                                  }

                                  if (
                                    cnpjParceiro.replace(/\D/g, "").length >= 14
                                  ) {
                                    obsParceiro += `R$ ${valorcomissaodesconto.toFixed(
                                      2
                                    )} de cota-parte profissional parceiro ${profissional} CNPJ ${cnpjParceiro}, emitida no código: ${
                                      result.data[0].Codigo
                                    };\n`;
                                  } else {
                                    obsParceiro += `R$ ${valorcomissaodesconto.toFixed(
                                      2
                                    )} de cota-parte profissional parceiro ${profissional} CPF ${cnpjParceiro}, emitida no código: ${
                                      result.data[0].Codigo
                                    };\n`;
                                  }
                                },
                                error: function (result) {
                                  toastr.error("Falha na conexão.");
                                },
                              });
                            }
                          }
                        },
                        error: function (result) {
                          toastr.error("Falha na conexão.");
                        },
                      });
                    }
                  }

                  /*----------------------------------------------------------------------------------------------------------------------------------------------------*/
                }
              }
              valorComissao = valorComissao + valorComissaoPacoteVenda;
              $("#valorCupomNotaPacote").html(valorServicos);
              $("#valorCupomDisplayNotaPacote").val(
                `${$_CONFIG.MOEDA} ${valorServicos
                  .toFixed(2)
                  .replace(",", ".")}`
              );
              $("#servicosPrestadosNotaPacote").html(descricaoServicos);
              $("#servicosPrestadosDisplayNotaPacote").val(descricaoServicos);
            }
          }

          if (
            numeroProdutoPacote > 0 &&
            (geraaproser == 0 || geraaproser == 2)
          ) {
            if ($scope.parnfe == 1) {
              var itensArray = [];
              var htmlProdNota = "";
              for (var k = 0; k < $scope.itensPacoteNota.length; k++) {
                if (
                  $scope.itensPacoteNota[k].Ser_Codigo == "" &&
                  $scope.itensPacoteNota[k].Pro_Codigo != ""
                ) {
                  citvalorProduto =
                    $scope.itensPacoteNota[k].PTe_Quantidade *
                    parseFloat(
                      $scope.itensPacoteNota[k].PTe_Valor.replace(",", ".")
                    );
                  $.ajax({
                    dataType: "json",
                    method: "POST",
                    url: "/pages/cadastros/buscaProdutosv2.php",
                    async: false,
                    data: {
                      procodigo: $scope.itensPacoteNota[k].Pro_Codigo,
                    },
                    success: function (result) {
                      if (
                        result.data[0].Pro_Cfop == "" ||
                        result.data[0].Pro_ICMS == "" ||
                        result.data[0].Pro_Ncm == ""
                      ) {
                        erroProduto = 1;
                        numeroProdutoPacote = 0;
                        k = $scope.itensPacoteNota.length;
                      } else {
                        htmlProdNota += `<tr>
																<td>
																	${result.data[0].Pro_Descricao}
																</td>
																<td>
																	${$scope.itensPacoteNota[k].PTe_Quantidade}
																</td>
																<td>
																	${$scope.itensPacoteNota[k].PTe_Valor}
																</td>
															</tr>`;

                        if (result.data[0].Pro_CEST == "") {
                          itensArray.push({
                            valorUnitario: $scope.itensPacoteNota[k].PTe_Valor,
                            quantidade:
                              $scope.itensPacoteNota[k].PTe_Quantidade,
                            unidadeMedida: "UN",
                            cfop: result.data[0].Pro_Cfop,
                            descricao: result.data[0].Pro_Descricao,
                            ncm: result.data[0].Pro_Ncm,
                            codigo: result.data[0].Pro_Codigo,
                            ean: result.data[0].Pro_Codigo_Barras,
                            eanTributavel: result.data[0].Pro_Codigo_Barras,
                            impostos: {
                              icms: {
                                situacaoTributaria: result.data[0].Pro_ICMS,
                                origem: 0,
                              },
                              pis: {
                                situacaoTributaria: result.data[0].Pro_Pis,
                              },
                              cofins: {
                                situacaoTributaria: result.data[0].Pro_Cofins,
                              },
                            },
                          });
                        } else {
                          itensArray.push({
                            valorUnitario: $scope.itensPacoteNota[k].PTe_Valor,
                            quantidade:
                              $scope.itensPacoteNota[k].PTe_Quantidade,
                            unidadeMedida: "UN",
                            cfop: result.data[0].Pro_Cfop,
                            descricao: result.data[0].Pro_Descricao,
                            ncm: result.data[0].Pro_Ncm,
                            codigo: result.data[0].Pro_Codigo,
                            ean: result.data[0].Pro_Codigo_Barras,
                            eanTributavel: result.data[0].Pro_Codigo_Barras,
                            cest: result.data[0].Pro_CEST,
                            impostos: {
                              icms: {
                                situacaoTributaria: result.data[0].Pro_ICMS,
                                origem: 0,
                              },
                              pis: {
                                situacaoTributaria: result.data[0].Pro_Pis,
                              },
                              cofins: {
                                situacaoTributaria: result.data[0].Pro_Cofins,
                              },
                            },
                          });
                        }
                      }
                    },
                    error: function (result) {
                      console.log(result);
                    },
                  });
                  valorProduto = valorProduto + citvalorProduto;
                }
              }

              $scope.produtosNotaPacote = JSON.stringify(itensArray);
              $("#tableItensNfProdutoNotaPacote").html(htmlProdNota);
              $("#valorCupomProdNotaPacote").html(valorProduto);
              $("#valorCupomDisplayProdNotaPacote").val(
                `${$_CONFIG.MOEDA} ${valorProduto.toFixed(2).replace(",", ".")}`
              );
            }
          }

          var html = "<option value=''>Estado</option>";
          for (var i = 0; i < $_CONFIG.LISTA_ESTADO.length; i++) {
            html +=
              "<option value='" +
              $_CONFIG.LISTA_ESTADO[i].Est_Sigla +
              "'> " +
              $_CONFIG.LISTA_ESTADO[i].Est_Sigla +
              "</option>";
          }

          $("#cliCupomUFNotaPacote").html(html);
          $("#cliCupomUFProdNotaPacote").html(html);

          $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaPessoa.php",
            data: {
              tipo: 1,
            },
            dataType: "json",
            success: function (result) {
              $scope.dadosEmpresaNotaPacote = result.buscaPessoa[0];
              $("#empresaCNAENotaPacote").val(result.buscaPessoa[0].CNAE);
              // $("#empresaCodigoNFNotaPacote").val(result.buscaPessoa[0].CodigoNF);
              // $("#empresaCodigoNFProdNotaPacote").val(result.buscaPessoa[0].CodigoNF);

              var codigoempresahtml = `<option value="${result.buscaPessoa[0].CodigoNF}">${result.buscaPessoa[0].CNPJ}</option>`;
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/buscaPessoaEnotas.php",
                dataType: "json",
                async: false,
                success: function (result) {
                  if (result.data.length > 0) {
                    for (var i = 0; i < result.data.length; i++) {
                      codigoempresahtml += `<option value="${result.data[i].PEn_Codigo_GW}">${result.data[i].PEn_CNPJ}</option>`;
                    }
                  }
                },
                error: function (result) {},
              });

              $("#empresaCodigoNFNotaPacote").html(codigoempresahtml);
              $("#empresaCodigoNFProdNotaPacote").html(codigoempresahtml);

              $("#cidCodigoNotaProdutoPacote").val(
                result.buscaPessoa[0].Cid_Codigo
              );
              $scope.emiteSemClientePacote =
                result.buscaPessoa[0].Cid_Emissao_SemCliente;
              $scope.emiteSemCPFPacote =
                result.buscaPessoa[0].Cid_Emissao_SemCPF;
              $scope.emiteSemEnderecoPacote =
                result.buscaPessoa[0].Cid_Emissao_SemEndereco;
              $("#empresaCSTNotaPacote").val(result.buscaPessoa[0].CST);

              if ($scope.emiteSemCliente == 0) {
                $("#nomeObrigatorioNotaPacote").show();
                $("#nomeObrigatorioProdNotaPacote").show();
              } else {
                $("#nomeObrigatorioNotaPacote").hide();
                $("#nomeObrigatorioProdNotaPacote").hide();
              }

              if ($scope.emiteSemCPF == 0) {
                $("#CPFObrigatorioNotaPacote").show();
                $("#CPFObrigatorioProdNotaPacote").show();
              } else {
                $("#CPFObrigatorioNotaPacote").hide();
                $("#CPFObrigatorioProdNotaPacote").hide();
              }

              if ($scope.emiteSemEndereco == 0) {
                $("#EstadoObrigatorioNotaPacote").show();
                $("#CidadeObrigatorioNotaPacote").show();
                $("#CepObrigatorioNotaPacote").show();
                $("#BairroObrigatorioNotaPacote").show();
                $("#NumeroObrigatorioNotaPacote").show();
                $("#LogradouroObrigatorioNotaPacote").show();

                $("#EstadoObrigatorioProdNotaPacote").show();
                $("#CidadeObrigatorioProdNotaPacote").show();
                $("#CepObrigatorioProdNotaPacote").show();
                $("#BairroObrigatorioProdNotaPacote").show();
                $("#LogradouroObrigatorioProdNotaPacote").show();
                $("#NumeroObrigatorioProdNotaPacote").show();
              } else {
                $("#EstadoObrigatorioNotaPacote").hide();
                $("#CidadeObrigatorioNotaPacote").hide();
                $("#CepObrigatorioNotaPacote").hide();
                $("#BairroObrigatorioNotaPacote").hide();
                $("#LogradouroObrigatorioNotaPacote").hide();
                $("#NumeroObrigatorioNotaPacote").hide();

                $("#EstadoObrigatorioProdNotaPacote").hide();
                $("#CidadeObrigatorioProdNotaPacote").hide();
                $("#CepObrigatorioProdNotaPacote").hide();
                $("#BairroObrigatorioProdNotaPacote").hide();
                $("#LogradouroObrigatorioProdNotaPacote").hide();
                $("#NumeroObrigatorioProdNotaPacote").hide();
              }

              var infoOrigem = "";
              var infoProcon = "";
              $("#valorCupomNotaPacote").html(valorServicos);
              if ($scope.dadosEmpresaNota.Pes_Codigo == 189886) {
                infoOrigem =
                  "Fonte: IBPT/FECOMERCIO RJ - 18.1.A Resolução CGSN Nº 137, de 04 de Dezembro de 2017.\n";
              } else if (
                $scope.dadosEmpresaNota.Pes_Codigo == 8866546 ||
                $scope.dadosEmpresaNota.Pes_Codigo == 12690404 ||
                $scope.dadosEmpresaNota.Pes_Codigo == 320798 ||
                $scope.dadosEmpresaNota.Pes_Codigo == 7007706 ||
                $scope.dadosEmpresaNota.Pes_Codigo == 3224558 ||
                $scope.dadosEmpresaNota.Pes_Codigo == 13329906 ||
                $scope.dadosEmpresaNota.Pes_Codigo == 1034072 ||
                $scope.dadosEmpresaNota.Pes_Codigo == 20271388 ||
                $scope.dadosEmpresaNota.Pes_Codigo == 20657910
              ) {
                infoOrigem =
                  "EMISSAO DE NOTA CONFORME RESOLUCAO CGSN N. 140, DE 22 DE MAIO DE 2018\n";
              } else if ($scope.dadosEmpresaNota.Pes_Codigo == 17774557) {
                infoOrigem =
                  "Serviço prestado sob regime de parceria nos termos da Lei nº 13.352/2016\n";
              }else if ($scope.dadosEmpresaNota.Pes_Codigo == 10839540) {
                infoOrigem =
                  "Valor aproximado dos tributos: 17,29% - Fonte IBPT\n";
              }

              if ($scope.dadosEmpresaNota.Cid_Codigo != "") {
                $.ajax({
                  type: "POST",
                  url: "/pages/cadastros/buscaCidadeProcon.php",
                  async: false,
                  data: {
                    cidcodigo: $scope.dadosEmpresaNota.Cid_Codigo,
                  },
                  dataType: "json",
                  success: function (result) {
                    if (result.data.length > 0) {
                      infoProcon = `TELEFONE DO PROCON: ${result.data[0].CPo_Telefone} \n ENDERECO DO PROCON: ${result.data[0].CPo_Endereco}`;
                    }
                  },
                  error: function (result) {
                    toastr.error("Falha na conexão.");
                  },
                });
              }

              if ($scope.parnfdescontoparceiro == 1) {
                if ($scope.parDescriaoSalaoParceiro == 1) {
                  $("#valorComissaoDisplayNotaPacote").val(0.0);
                } else {
                  $("#valorComissaoDisplayNotaPacote").val(
                    valorComissao.toFixed(2)
                  );
                }
                if (obsParceiro != "") {
                  $("#cliCupomObsNotaPacote").val(
                    `${infoOrigem}R$ ${(valorServicos - valorComissao).toFixed(
                      2
                    )} de cota-parte do salão parceiro: ${
                      $scope.dadosEmpresaNotaPacote.CNPJ
                    }\n${obsParceiro} \n\n\n ${infoProcon}`
                  );
                } else {
                  $("#cliCupomObsNotaPacote").val(
                    `${infoOrigem}\n\n\n ${infoProcon}`
                  );
                }
              } else {
                $("#valorCupomDisplayNotaPacote").val(0.0);
                $("#cliCupomObsNotaPacote").val(
                  `${infoOrigem} \n\n\n ${infoProcon}`
                );
              }
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
            },
          });

          $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaPessoaNatureza.php",
            data: {
              tipo: "1",
            },
            dataType: "json",
            success: function (result) {
              var naturezalista = "";
              for (var i = 0; i < result.data.length; i++) {
                naturezalista += `<option value='${result.data[i].Nat_Codigo_Externo}'  data-nbs='${result.data[i].Nat_NBS}' data-itemlista='${result.data[i].PNa_Codigo_Municipal_Servico}' data-aliquota='${result.data[i].PNa_Aliquota}'>${result.data[i].Nat_Descricao}</option>`;
              }
              $("#servicoNaturezaNotaPacote").html(naturezalista);
              $("#servicoNaturezaNotaPacote").select2();
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
            },
          });

          if (cliente != "") {
            $.ajax({
              type: "POST",
              url: "/pages/cadastros/buscaClienteAlteraAgenda.php",
              data: {
                cliente: cliente,
              },
              dataType: "json",
              success: function (result) {
                $scope.dadosClienteNotaPacote = result.result[0];
                $("#cliCupomNomeNotaPacote").val(result.result[0].Pes_Nome);
                $("#cliCupomEmailNotaPacote").val(result.result[0].Paf_Email);
                $("#cliCupomCPFNotaPacote").val(result.result[0].Paf_Cpf);
                $("#cliCupomCEPNotaPacote").val(result.result[0].Paf_CEP);
                $("#cliCupomUFNotaPacote").val(result.result[0].Est_Sigla);
                $("#cliCupomCidadeNotaPacote").val(result.result[0].Cid_Nome);
                $("#cliCupomBairroNotaPacote").val(result.result[0].Paf_Bairro);
                $("#cliCupomLogradouroNotaPacote").val(
                  result.result[0].Paf_Endereco
                );
                $("#cliCupomNumeroNotaPacote").val(result.result[0].Paf_Numero);
                $("#cliCupomComplementoNotaPacote").val(
                  result.result[0].Paf_Complemento
                );
                $("#cliCupomNomeProdNotaPacote").val(result.result[0].Pes_Nome);
                $("#cliCupomEmailProdNotaPacote").val(
                  result.result[0].Paf_Email
                );
                $("#cliCupomCPFProdNotaPacote").val(result.result[0].Paf_Cpf);
                $("#cliCupomCEPProdNotaPacote").val(result.result[0].Paf_CEP);
                $("#cliCupomUFProdNotaPacote").val(result.result[0].Est_Sigla);
                $("#cliCupomCidadeProdNotaPacote").val(
                  result.result[0].Cid_Nome
                );
                $("#cliCupomBairroProdNotaPacote").val(
                  result.result[0].Paf_Bairro
                );
                $("#cliCupomLogradouroProdNotaPacote").val(
                  result.result[0].Paf_Endereco
                );
                $("#cliCupomNumeroProdNotaPacote").val(
                  result.result[0].Paf_Numero
                );
                $("#cliCupomComplementoProdNotaPacote").val(
                  result.result[0].Paf_Complemento
                );
                $("#cliCupomTelefoneProdNotaPacote").val(
                  result.result[0].Paf_Celular
                );
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
              },
            });
          }

          if (
            numeroServicoPacote > 0 &&
            (geraaproser == 0 || geraaproser == 1) &&
            $scope.parnfse == 1
          ) {
            $("#generateCupomServicoPacote-modal").modal();
          }

          if (
            numeroProdutoPacote > 0 &&
            (geraaproser == 0 || geraaproser == 2) &&
            $scope.parnfe == 1
          ) {
            if ($scope.parnfce == 1) {
              criaNotaConsumidor(ppacodigo, cliente, 1, 1);
            } else {
              $("#generateCuponProdutoPacote-modal").modal();
            }
          }
          if (erroProduto == 1) {
            toastr.warning(
              'Favor, antes de fazer a emissão dos produtos, preencha todos os dados referentes emissão em "Cadastros > Produtos"'
            );
          }
        }
      };

