      $("#formCliDocumento").submit(function (event) {
        event.preventDefault();
        formDocumento = $(this);
        showLoader(true);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/inserePessoaDocumento.php",
          data: new FormData(this),
          dataType: "json",
          processData: false,
          contentType: false,
          success: function (result) {
            if (result.data.erro == undefined) {
              toastr.success(result.data[0].resultado);
              $("#novodocumentocliente-modal").modal("hide");
              showLoader(false);
              tabelaDocumentosPront.ajax.reload();
            } else {
              toastr.error(result.data.resultado);
              showLoader(false);
            }
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });

        return true;
      });

      $("#formProDocumento").submit(function (event) {
        event.preventDefault();
        formDocumento = $(this);
        showLoader(true);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/inserePessoaDocumento.php",
          data: {
            pesCodigoClienteDocumento: $("#codigoProfissionalDocumento").val(),
            documentoSelect: $("#documentoSelectProfissional").val(),
            corpoDocumentoCliente: $("#corpoDocumentoProfissional").val(),
            adeCodigoDocumento: "",
          },
          dataType: "json",
          success: function (result) {
            if (result.data.erro == undefined) {
              toastr.success(result.data[0].resultado);
              $("#novodocumentoprofissional-modal").modal("hide");
              showLoader(false);
            } else {
              toastr.error(result.data.resultado);
              showLoader(false);
