              $("#valorTotalContaCli").html("0,00");
            } else {
              $("#valorTotalContaCli").html(vlrTotal.Saldo);
            }

            resizeContent();
          },

          stateSaveCallback: function (settings, data) {
            data.order = [];
            localStorage.setItem(
              "DataTables_" + settings.sInstance,
              JSON.stringify(data)
            );
          },
          stateLoadCallback: function (settings) {
            return JSON.parse(
              localStorage.getItem("DataTables_" + settings.sInstance)
            );
          },
          stateSave: true,
          columnDefs: [
            {
              targets: [0, 1, 6, 7, 8, 9, 11, 12],
              visible: false,
              searchable: false,
            },
          ],
          language: {
