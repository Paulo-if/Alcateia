      };

      $scope.buscaCliPonto = function (codigo) {
        if (typeof tabelaCliPonto !== "undefined") {
          tabelaCliPonto.destroy();
        }
        tabelaCliPonto = $("#tableCliPontos").DataTable({
          dom: 'T<"clear">lfrtip',
          ajax: {
            url: "/pages/relatorios/buscaProgramaFidelidade.php",
            method: "POST",
            data: function (d) {
              d.selTipo = 1;
              d.selCliente = codigo;
            },
          },

          stateSaveCallback: function (settings, data) {
            data.order = [];
            localStorage.setItem(
              "DataTables_" + settings.sInstance,
              JSON.stringify(data)
            );
          },
          stateLoadCallback: function (settings) {
            return JSON.parse(
              localStorage.getItem("DataTables_" + settings.sInstance)
            );
          },
          stateSave: true,

          columns: [
            {
              data: "Nome",
            },
            {
              data: "TotalPontos",
            },
          ],
          ordering: false,
          language: {
            url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
          },
        });
      };

      // Busca ItensComandaVer
      $rootScope.$on("buscaItensComandaVer", function (event, codigo) {
        $scope.buscaItensComandaVer(codigo.any);
      });

      $scope.buscaItensComandaVer = function (codigo) {
        if (typeof tabelaComItensVer != "undefined") {
          tabelaComItensVer.api().destroy();
        }
        var codigoClienteAssinatura = "";
        tabelaComItensVer = $("#tbComandaItensVer").dataTable({
          ajax: "/pages/cadastros/buscaItensComanda.php?codigo=" + codigo,
          language: {
            url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
          },
          bPaginate: false,
          bLengthChange: false,
          bFilter: false,
          bSort: false,
          bInfo: false,
          bAutoWidth: false,
          fnRowCallback: function (nRow, aData) {
            var id = aData.Cortesia;

            if (id == 1) {
              nRow.children[8].innerHTML = "Sim";
            } else {
              nRow.children[8].innerHTML = "Não";
            }
          },
          initComplete: function () {
            var vlrTotal = this.fnGetData(0);
            $("#valorTotalComandaVer").html(
              $_CONFIG.MOEDA + vlrTotal.ValorTotal
            );
            if (vlrTotal.comandaVlrPagamento != "") {
              $("#valorPagoComandaVer").html(
                $_CONFIG.MOEDA + vlrTotal.comandaVlrPagamento
              );
              $("#vlrPagoVer").css("display", "block");
            } else {
              $("#vlrPagoVer").css("display", "none");
              $("#valorPagoComandaVer").html("");
            }
            $("#nomeClienteComandaVer").html(vlrTotal.Cliente);
            codigoClienteAssinatura = vlrTotal.ClienteCodigo;
            $("#idComandaVer").html(vlrTotal.Codigo);
            $("#dataComandaVer").html(vlrTotal.dataComanda);
            $("#comValorPagVer").val(vlrTotal.ValorTotal);
            $("#pagamentoComandaVer").html(
              vlrTotal.tipoPagamento.replace("/", "<br>")
            );
          },
          stateSaveCallback: function (settings, data) {
            data.order = [];
            localStorage.setItem(
              "DataTables_" + settings.sInstance,
              JSON.stringify(data)
            );
          },
          stateLoadCallback: function (settings) {
            return JSON.parse(
              localStorage.getItem("DataTables_" + settings.sInstance)
            );
          },
          stateSave: true,
          columnDefs: [
            {
              targets: [0, 1, 2, 3, 5, 6, 11, 12],
              visible: false,
              searchable: false,
            },
          ],
          columns: [
            {
              data: "Codigo",
            },
            {
              data: "CodItem",
            },
            {
              data: "CodSerPro",
            },
            {
              data: "TipoItem",
            },
            {
              data: "ImgItem",
            },
            {
              data: "Data",
            },
            {
              data: "Usuario",
            },
            {
              data: "Valor",
            },
            {
              data: "ValorUn",
            },
            {
              data: "Desconto",
            },
            {
              data: "Quantidade",
            },
            {
              data: "Comissao",
            },
            {
              data: "ValorTotal",
            },
            {
              data: "Item",
            },
            {
              data: "Profissional",
            },
            {
              data: "Cliente",
            },
            {
              data: "Cortesia",
            },
            {
              data: null,
              defaultContent: "",
              render: function (data, t, row) {
                if (row.ExistePacote == "1") {
                  return "Pacote";
                } else if (row.asscodigo != "") {
                  return "Clube de Assintura";
                }
              },
            },
          ],
        });
      };

      //Seleciona novo cliente
      $scope.selecionaNovoCliente = function (pesCodigo) {
        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          data: {
            metodo: "buscaClientes",
            id: $scope.idCliente,
          },
          success: function (data) {
            clientesNomesComanda.length = 0;
            var html =
              '<option data-usucodigo="" data-imagem="" value="0" selected>Sem Cadastro</option>';
            for (var i = 0; i < data.clientes.length; i++) {
              var codigo = data.clientes[i].Pes_Codigo;
              var nome = data.clientes[i].Pes_Nome;
              var foto = data.clientes[i].Paf_Imagem;
              var usucod = data.clientes[i].Usu_Codigo;
              var celular = "";
              if (data.clientes[i].Paf_Celular != "") {
                celular = " - " + data.clientes[i].Paf_Celular;
              }
              html +=
                '<option data-usucodigo="' +
                usucod +
                '" data-imagem="' +
                foto +
                '" value="' +
                codigo +
                '">' +
                nome +
                "" +
                celular +
                "</option>";
            }
            $("#comCliente").html(html);

            setTimeout(function () {
              $("#comCliente").val(pesCodigo);
              $("#comCliente").change();
            }, 1000);
          },
        });
      };

      $scope.geraDescontoComanda = function () {
        if ($("#comValorDesconto").val() == "") {
          toastr.error("Informe o desconto");
        } else {
          if ($("#senhaDesconto").html() == "1") {
            var statesdemo = {
              state0: {
                title: "Insira a senha ",
                html: '<input class="form-control" type="password" name="password" id="password" value=""></label>',
                buttons: {
                  Ok: 1,
                },
                submit: function (e, v, m, f) {
                  e.preventDefault();
                  if (f.password != null) {
                    $.ajax({
                      dataType: "json",
                      method: "POST",
                      url: "/php/verificaSenhaDesconto.php",
                      data: {
                        password: f.password,
                      },
                      success: function (data) {
                        if (data.erro == "0") {
                          $.ajax({
                            type: "POST",
                            url: "/pages/cadastros/alteraComandaDesconto.php",
                            data: {
                              comanda: $("#idComanda").html(),
                              desconto: $("#comValorDesconto").val(),
                              senhaDesconto: data.p,
                            },
                            dataType: "json",
                            success: function (result) {
                              showLoader(true);
                              if (result.data[0].erro == "0") {
                                $scope.atualizaDadosItens();
                                if (location.hash == "#/comandasabertas") {
                                  $rootScope.$emit("atualizaDadosComanda", {});
                                }
                                toastr.success(result.data[0].resultado);
                                $("#descontoComanda-modal").modal("hide");
                                $("#comValorDesconto").val("");
                              } else {
                                toastr.error(result.data[0].resultado);
                              }
                              showLoader(false);
                              $("#comValor").attr("disabled", true);
                            },
                            error: function (result) {
                              toastr.error("Falha na conexão.");
                              showLoader(false);
                              $("#comValor").attr("disabled", true);
                            },
                          });
                          $.prompt.close();
                        } else {
                          toastr.error(data.resultado);
                        }
                      },
                      error: function (data) {
                        toastr.error("Falha de conexão");
                      },
                    });
                  }
                },
              },
            };
            $.prompt(statesdemo);
          } else {
            $.ajax({
              type: "POST",
              url: "/pages/cadastros/alteraComandaDesconto.php",
              data: {
                comanda: $("#idComanda").html(),
                desconto: $("#comValorDesconto").val(),
              },
              dataType: "json",
              success: function (result) {
                showLoader(true);
                if (result.data[0].erro == "0") {
                  $scope.atualizaDadosItens();
                  if (location.hash == "#/comandasabertas") {
                    $rootScope.$emit("atualizaDadosComanda", {});
                  }
                  toastr.success(result.data[0].resultado);
                  $("#descontoComanda-modal").modal("hide");
                  $("#comValorDesconto").val("");
                } else {
                  toastr.error(result.data[0].resultado);
                }
                showLoader(false);
                $("#comValor").attr("disabled", true);
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
                showLoader(false);
                $("#comValor").attr("disabled", true);
              },
            });
          }
        }
      };

      $scope.atualizatabelaProntuario = function () {
        tabelaProntuario.ajax.reload();
      };

      //Monta o prontuario do cliente
      $rootScope.$on("buscaClienteProntuario", function (pescodigo) {
        $scope.buscaProntuarioCliente(pescodigo);
      });

      $scope.buscaProntuarioCliente = function (PescodigoCliente) {
        $("#pescodigoProntuario").val(PescodigoCliente);
        if (typeof tabelaProntuario != "undefined") {
          $("#tableProntuario tbody").unbind("click");
          tabelaProntuario.destroy();
          $("#tableProntuario tbody").unbind("click");
        }
        tabelaProntuario = $("#tableProntuario").DataTable({
          ajax: {
            url: "/pages/cadastros/buscaAgendamentoProntuariov2.php",
            method: "POST",
            data: {
              pescodigocliente: PescodigoCliente,
              tipo: 1,
              agecodigo: "",
              dataini: $("#cliDatInicioPron").val(),
              datafim: $("#cliDatFimPron").val(),
              pescodigoprofissional: $("#profPront").val(),
              sercodigo: $("#servicoPront").val(),
            },
          },
          columnDefs: [
            {
              targets: [3, 9],
              visible: false,
              searchable: false,
            },
          ],
          fnRowCallback: function (nRow, aData) {
            var $nRow = $(nRow);
            var id = aData.TemProntuario;
            switch (id) {
              case "0":
                $nRow.map(function () {}).get();
                nRow.children[5].style.display = "none";
                nRow.children[6].style.display = "none";
                nRow.children[8].style.display = "none";
                break;
              default:
                $nRow.map(function () {}).get();
                nRow.children[4].style.display = "none";
                nRow.children[7].style.display = "none";
                break;
            }
          },

          stateSaveCallback: function (settings, data) {
            data.order = [];
            localStorage.setItem(
              "DataTables_" + settings.sInstance,
              JSON.stringify(data)
            );
          },
          stateLoadCallback: function (settings) {
            return JSON.parse(
              localStorage.getItem("DataTables_" + settings.sInstance)
            );
          },
          stateSave: true,

          columns: [
            /*0*/ {
              class: "details-control",
              orderable: false,
              data: null,
              defaultContent: "",
            },
            /*1*/
            {
              data: "Age_Dat_Inicio",
              type: "moment-DD/MM/YYYY hh:mm",
            },
            /*2*/
            {
              data: "Ser_Descricao",
            },
            /*3*/
            {
              data: "ADe_Codigo",
            },
            /*4*/
            {
              data: "Profissional",
            },
            /*5*/
            {
              class: "adicionar",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn btn-info btn-block btn-xs"><i class="fa fa-plus"></i>&nbspNovo</button>',
            },
            /*6*/
            {
              class: "editar",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn btn-block btn-success btn-xs"><i class="fa fa-pencil"></i>&nbspEditar</button>',
            },
            /*7*/
            {
              class: "remover",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn btn-danger btn-block btn-xs"><i class="fa fa-trash"></i>&nbspExcluir</button>',
            },
            /*8*/
            {
              data: null,
              defaultContent: "",
            },
            /*9*/
            {
              data: "Age_Codigo",
            },
            /*10*/
            {
              class: "imprimir",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn bg-teal-dark btn-block btn-xs"><i class="fa fa-print"></i></button>',
            },
          ],
          ordering: false,
          language: {
            url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
          },
        });

        $("#tableProntuario tbody").on(
          "click",
          "td.details-control",
          function () {
            var tr = $(this).closest("tr");
            var row = tabelaProntuario.row(tr);
            if (row.child.isShown()) {
              row.child.hide();
              tr.removeClass("shown");
            } else {
              row.child($scope.formatDetails(row.data())).show();
              tr.addClass("shown");
              $compile($("#tableProntuario"))($scope);
            }
          }
        );

        $("#tableProntuario tbody").on("click", "td.adicionar", function () {
          var tr = $(this).closest("tr");
          var row = tabelaProntuario.row(tr);
          var agendamentoprontcodigo = row.data().Age_Codigo;

          $("#codigoAgendamento").val(agendamentoprontcodigo);
          $("#codigoAgendamentoImagem").val(agendamentoprontcodigo);
          $scope.numImagemProntuario = 0;
          $("#imagemProntuario0").attr(
            "src",
            "https://d3verit7xckkza.cloudfront.net/imgsystem/pront_sem_imagem.png"
          );
          $("#imagemProntuario1").attr(
            "src",
            "https://d3verit7xckkza.cloudfront.net/imgsystem/pront_sem_imagem.png"
          );
          $("#imagemProntuario2").attr(
            "src",
            "https://d3verit7xckkza.cloudfront.net/imgsystem/pront_sem_imagem.png"
          );
          $("#insereProntuario-modal").modal();
          $("#divDetalhes").show();
        });

        $("#tableProntuario tbody").on("click", "td.editar", function () {
          var tr = $(this).closest("tr");
          var row = tabelaProntuario.row(tr);
          $scope.numImagemProntuario = 0;
          $("#AgeCodigoBuscaImagem").val(row.data().Age_Codigo);
          $("#ageMaterialEdt").val(row.data().ADe_Material);
          $("#ageDetalhesEdt").val(
            row.data().ADe_Detalhes.replaceAll("__", "\r\n")
          );
          $("#ageCorteEdt").val(row.data().ADe_Corte);
          $("#codigoAgendamentoImagemEdit").val(row.data().Age_Codigo);
          $("#AdeCodgioAltera").val(row.data().ADe_Codigo);
          $("#AdeCodgioAlteraImg").val(row.data().ADe_Codigo);
          $scope.buscaImagemProntuarioAlteracao(row.data().Age_Codigo);
          $("#EditaProntuario-modal").modal();
        });

        $("#tableProntuario tbody").on("click", "td.imprimir", function () {
          var tr = $(this).closest("tr");
          var row = tabelaProntuario.row(tr);

          $("#printMaterial").html(row.data().ADe_Material);
          $("#printObs").html(row.data().ADe_Detalhes.replaceAll("__", "<br>"));
          $("#printPro").html(row.data().ADe_Corte);
          $("#printData").html(row.data().Age_Dat_Inicio);
          $("#printServico").html(row.data().Ser_Descricao);
          $("#printProfissional").html(row.data().Profissional);
          setTimeout(function () {
            $scope.imprimirProntuario();
          }, 300);
        });

        $("#tableProntuario tbody").on("click", "td.remover", function () {
          var tr = $(this).closest("tr");
          var row = tabelaProntuario.row(tr);
          swal(
            {
              title: "Deseja realmente excluir este prontuário?",
              type: "warning",
              showCancelButton: true,
              confirmButtonColor: "#DD6B55",
              confirmButtonText: "Sim",
              cancelButtonText: "Não",
              closeOnConfirm: true,
            },
            function () {
              showLoader(true);
              $.ajax({
                dataType: "json",
                method: "POST",
                url: "/pages/cadastros/removeAgendamentoProntuario.php",
                data: {
                  adeCodigo: row.data().ADe_Codigo,
                  tipo: 2,
                },
                success: function (result) {
                  if (result.data[0].erro == "0") {
                    toastr.success(result.data[0].resultado);
                  } else {
                    toastr.error(result.data[0].resultado);
                  }
                  $scope.buscaProntuarioCliente(row.data().Pes_Codigo);
                  showLoader(false);
                },
                error: function (result) {
                  toastr.error("Falha na conexão.");
                  showLoader(false);
                },
              });
            }
          );
        });

        $scope.formatDetails = function (d) {
          $scope.buscaImagemProntuario(d.Age_Codigo);
          var documentoline = "";
          if (d.ADe_Codigo != "") {
            documentoline =
              "<tr>" +
              '<td class="col-md-12"></td>' +
              '<td id="tddocumento"><buttom class="btn btn-xs btn-primary pull-left" ng-click="listDocumento(' +
              PescodigoCliente +
              "," +
              d.Pes_Codigo_Profissional +
              "," +
              d.Age_Codigo +
              ",null,null," +
              d.ADe_Codigo +
              ')">Documentos</buttom></td>' +
              "</tr>";
          }
          return (
            '<table cellpadding="5" class="table table-striped" cellspacing="0" border="0" style="border: 1px solid #e0e0d1;display:block;" >' +
            "<tr >" +
            '<td style="text-align:justify;"><strong>Detalhes:</strong>&nbsp&nbsp&nbsp&nbsp&nbsp' +
            d.ADe_Detalhes.replaceAll("__", "<br>") +
            "</td>" +
            "<td ></td>" +
            "</tr>" +
            "<tr>" +
            "<td ><strong>Material Utiliazado:</strong>&nbsp&nbsp&nbsp&nbsp&nbsp" +
            d.ADe_Material +
            "</td>" +
            "<td></td>" +
            "</tr>" +
            "<tr>" +
            "<td ><strong>Tipo de Corte:</strong> &nbsp&nbsp&nbsp&nbsp&nbsp" +
            d.ADe_Corte +
            "</td>" +
            "<td></td>" +
            "</tr>" +
            "<tr>" +
            "<td><strong>Imagens do agendamento: </strong></td>" +
            "<td></td>" +
            "</tr>" +
            "<tr>" +
            '<td id="imgPront" class="col-md-12"></td>' +
            "<td></td>" +
            "</tr>" +
            documentoline +
            "</table>"
          );
        };

        $scope.buscaImagemProntuario = function (codigo) {
          var PescodigoCliente = "";
          if (location.hash == "#/agenda") {
            PescodigoCliente = $("#lblPesCodigo").html();
          } else if (location.hash == "#/clientes") {
            PescodigoCliente = $("#cliPesCodigoInfo").val();
          }
          var htmlimg = "";
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaAgendamentoProntuario.php",
            data: {
              pescodigo: PescodigoCliente,
              tipo: "2",
              dataini: "",
              datafim: "",
              agecodigo: codigo,
            },
            dataType: "json",
            success: function (result) {
              for (var i = 0; i < result.data.length; i++) {
                htmlimg +=
                  "<div class='col-sm-2 margin' ng-click='ampliaImagem(&quot;" +
                  result.data[i].AIm_Imagem +
                  "&quot;)'><img  src='" +
                  result.data[i].AIm_Imagem +
                  "'  name=" +
                  [i] +
                  "  id=" +
                  [i] +
                  "  width='80' style='cursor:pointer;'><label>" +
                  result.data[i].AIm_Legenda +
                  "</label></div>";
              }
              $("#imgPront").html(htmlimg);
              $compile($("#imgPront"))($scope);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
        };
      };

      $scope.buscaProntuarioDocumento = function (pescodigo, adecodigo) {
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaPessoaDocumento.php",
          data: {
            cliente: pescodigo,
            tipo: "2",
            adecodigo: adecodigo,
          },
          dataType: "json",
          success: function (result) {
            return "foo";
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });
      };

      // Busca as imagens que podem ser alteradas no prontuario
      $scope.buscaImagemProntuarioAlteracao = function (codigo) {
        $("#divimgagealt").html("");
        var PescodigoCliente = "";
        if (location.hash == "#/agenda") {
          PescodigoCliente = $("#lblPesCodigo").html();
        } else if (location.hash == "#/clientes") {
          PescodigoCliente = $("#cliPesCodigoInfo").val();
        }
        var htmlimgalt = "";
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaAgendamentoProntuario.php",
          data: {
            pescodigo: PescodigoCliente,
            tipo: "2",
            dataini: "",
            datafim: "",
            agecodigo: codigo,
          },
          dataType: "json",
          success: function (result) {
            var nonimage = 3 - result.data.length;
            htmlimgalt +=
              '<form id="formAlteraImagemAgendamento" enctype="multipart/form-data">';
            htmlimgalt +=
              '<input id="AimCodigoAltera" name="AimCodigoAltera" hidden>';
            htmlimgalt += `<input type="file" style="display:none;" name="imgAgeAlter" id="imgAgeAlter" accept="image/*" onChange='readURL2(this,$("#formAlteraImagemAgendamento"));'>`;
            for (var i = 0; i < result.data.length; i++) {
              htmlimgalt += `<div  class="col-md-4 mouse-over" ng-click="alteraProntuarioImagem(${result.data[i].AIm_Codigo})"><a class="pointer"><img  src="${result.data[i].AIm_Imagem}" width="75%" ></div></a>`;
            }
            htmlimgalt += "</form>";
            htmlimgalt +=
              '<form id="formInsereImagemAgendamentoEDT" enctype="multipart/form-data">';
            htmlimgalt += `<input type="hidden" id="codigoAgendamentoImagemEdit" name="codigoAgendamentoImagem" value="${codigo}">`;
            htmlimgalt += `<input type="file" style="display:none;" name="aimImagem" id="aimImagemEdt" accept="image/*" onChange='readURL2(this,$("#formInsereImagemAgendamentoEDT"));'>`;

            for (var i = 0; i < nonimage; i++) {
              htmlimgalt += `<div  class="col-md-4 " ng-click="insereImagemProntuarioEdita()"><a class="pointer"><img   src="https://d3verit7xckkza.cloudfront.net/imgsystem/pront_sem_imagem.png" width="75%" ></a></div>`;
            }
            htmlimgalt += "</form>";

            $("#divimgagealt").html(htmlimgalt);
            $compile($("#divimgagealt"))($scope);

            $("#formInsereImagemAgendamentoEDT").submit(function (event) {
              event.preventDefault();
              showLoader(true);
              formInsereImgedt = $(this);
              var dados = new FormData(this);
              dados.append("blob", mBlob);
              dados.delete("aimImagem");
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/insereAgendamentoProntuarioImagem.php",
                data: dados,
                dataType: "json",
                processData: false,
                contentType: false,
                success: function (result) {
                  if (result.result[0].erro == "0") {
                    toastr.success(result.result[0].resultado, "");
                    formInsereImgedt.each(function () {
                      this.reset();
                    });
                    $scope.buscaImagemProntuarioAlteracao(
                      $("#AgeCodigoBuscaImagem").val()
                    );
                  } else {
                    toastr.error(result.result[0].resultado);
                  }
                  showLoader(false);
                },
                error: function (result) {
                  toastr.error("Falha na conexão.");
                  showLoader(false);
                },
              });

              return true;
            });

            //altera imgens do prontuario
            $("#formAlteraImagemAgendamento").submit(function (event) {
              event.preventDefault();
              showLoader(true);
              var dados = new FormData(this);
              dados.append("blob", mBlob);
              dados.delete("imgAgeAlter");
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/alteraAgendamentoProntuarioImagem.php",
                data: dados,
                dataType: "json",
                processData: false,
                contentType: false,
                success: function (result) {
                  if (result.result[0].erro == "0") {
                    $scope.atualizatabelaProntuario();
                    toastr.success(result.result[0].resultado);
                    $scope.buscaImagemProntuarioAlteracao(
                      $("#AgeCodigoBuscaImagem").val()
                    );
                  } else {
                    toastr.error(result.result[0].resultado);
                  }
                  showLoader(false);
                },
                error: function (result) {
                  toastr.error("Falha na conexão.");
                  showLoader(false);
                },
              });
              return true;
            });
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });
      };

      $scope.buscaImagemProntuarioImprecao = function (codigo) {
        var PescodigoCliente = "";
        if (location.hash == "#/agenda") {
          PescodigoCliente = $("#lblPesCodigo").html();
        } else if (location.hash == "#/clientes") {
          PescodigoCliente = $("#cliPesCodigoInfo").val();
        }
        var htmlimgalt = "";
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaAgendamentoProntuario.php",
          data: {
            pescodigo: PescodigoCliente,
            tipo: "2",
            dataini: "",
            datafim: "",
            agecodigo: codigo,
          },
          dataType: "json",
          success: function (result) {
            if (result.data.length <= 0) {
              htmlimgalt +=
                "<div  class='col-sm-12 margin'><label>Não existem imagens para este agendamento</label></div>";
            } else {
              for (var i = 0; i < result.data.length; i++) {
                htmlimgalt +=
                  "<div class='col-sm-6 col-sm-offset-3 margin' ><img  src='" +
                  result.data[i].AIm_Imagem +
                  "'  name=" +
                  [i] +
                  "  id=" +
                  [i] +
                  "  width='400' ><label>" +
                  result.data[i].AIm_Legenda +
                  "</label></div>";
              }
            }
            $("#imagensPrint").html(htmlimgalt);
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });
      };

      //Seta codigos para a alteração da imagem do prontuario
      $scope.alteraProntuarioImagem = function (codigo, legenda) {
        $("#AimCodigoAltera").val(codigo);
        $("#aimLegendaedt").val(legenda);
        $("#imgAgeAlter").click();
      };
      $scope.insereImagemProntuarioEdita = function () {
        $("#aimImagemEdt").click();
      };

      //Amplia imagens do prontuario
      $scope.ampliaImagem = function (imgsrc) {
        $("#ampliaImagem-modal").modal();
        $("#imagemProntuario").prop("src", imgsrc);
      };
      // Seta data atual para os relatorios
      $scope.dataAtual = function () {
        var dataini = moment().locale("pt-br").format("L");
        var datafim = moment().locale("pt-br").format("L");
        $(".date.divDataIni").datepicker("update", dataini);
        $(".date.divDataFim").datepicker("update", datafim);
      };

      //Busca combo de profissionais do header agenda
      $rootScope.$on("buscaProfissionalHeaderAgenda", function () {
        $scope.buscaProfissionaisHeaderAgenda();
      });

      $scope.buscaProfissionaisHeaderAgenda = function () {
        var html = "";
        $.ajax({
          dataType: "json",
          async: false,
          url: "/pages/cadastros/buscaProfissionalHeader.php",
          success: function (data) {
            for (var i = 0; i < data.profissionais.length; i++) {
              var codigo = data.profissionais[i].Pes_Codigo;
              var nome = data.profissionais[i].Pes_Apelido;
              html += '<option  value="' + codigo + '">' + nome + '</option>';
            }
            $("#users_menu").html(html);
            $('#users_menu').multiselect("destroy");
            // $('#users_menu').selectpicker({
            // 	"liveSearch": true,
            // 	"liveSearchPlaceholder": "Filtrar",
            // 	"noneSelectedText": "Nenhum Profissional Selecionado",
            // 	"maxOptions": 20,
            // 	"mobile": isMobile,
            // 	"width": "fit",
            // 	"selectedTextFormat": "count > 5",
            // 	"countSelectedText": "{0} profissionais selecionados",
            // 	"maxOptionsText": ["Máximo de 20 Profissionais", "Máximo de 20 Profissionais"]
            // });

            $('#users_menu').multiselect({
              enableFiltering: true,
              filterPlaceholder: 'Procurar...',
              buttonText: function (options, select) {
                if (options.length === 0) {
                  return 'Nenhum Profissional Selecionado ...';
                } else if (options.length > 5) {
                  return options.length + ' profissionais Selecionados';
                } else {
                  var labels = [];
                  options.each(function () {
                    if ($(this).attr('label') !== undefined) {
                      labels.push($(this).attr('label'));
                    } else {
                      labels.push($(this).html());
                    }
                  });
                  return labels.join(', ') + '';
                }
              }
            });

            if (getStorage("profissionais_" + $_CONFIG.CODESTABELECIMENTO) == null) {
              if (getStorage("profissionais") == null) {
                $('#users_menu').multiselect('select', $("#users_menu").get(0).options[0].value);
              } else {
                $('#users_menu').multiselect('select', getStorage("profissionais").split(","));
                if ($('#users_menu').multiselect('select') == null) {
                  $('#users_menu').multiselect('select', $("#users_menu").get(0).options[0].value);
                }
              }
            } else {
              $('#users_menu').multiselect('select', getStorage("profissionais_" + $_CONFIG.CODESTABELECIMENTO).split(","));
              if ($('#users_menu').multiselect('select') == null) {
                $('#users_menu').multiselect('select', $("#users_menu").get(0).options[0].value);
              }
            }

          }
        });
      }
      $scope.buscaProfissionaisHeaderAgenda();

      $scope.infos = new Array();
      $scope.buscaCatalagoProduto = function () {
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaProdutos.php",
          method: "POST",
          data: {
            tipo: 1,
          },
          success: function (result) {
            var half1 = "";
            var half2 = "";

            if (result.data.length % 2 == 1) {
              half2 = result.data.length / 2 + 0.5;
              half1 = result.data.length / 2 - 0.5;
            } else {
              half1 = result.data.length / 2;
              half2 = result.data.length / 2;
            }
            $scope.infos.produtos = [];
            $scope.infos.produtos2 = [];
            $scope.infos.produtos3 = [];
            for (var i = 0; i < result.data.length; i++) {
              $scope.infos.produtos3.push(result.data[i]);
              if (i < half2) {
                $scope.infos.produtos.push(result.data[i]);
              } else {
                $scope.infos.produtos2.push(result.data[i]);
              }
            }
          },
        });

        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaServicoSelect.php",
          method: "POST",
          data: {
            tipo: 1,
          },
          success: function (result) {
            var half1 = "";
            var half2 = "";
            if (result.servicos.length % 2 == 1) {
              half2 = result.servicos.length / 2 + 0.5;
              half1 = result.servicos.length / 2 - 0.5;
            } else {
              half1 = result.servicos.length / 2;
              half2 = result.servicos.length / 2;
            }
            $scope.infos.servico = [];
            $scope.infos.servico2 = [];
            $scope.infos.servico3 = [];
            for (var i = 0; i < result.servicos.length; i++) {
              $scope.infos.servico3.push(result.servicos[i]);
              if (i < half2) {
                $scope.infos.servico.push(result.servicos[i]);
              } else {
                $scope.infos.servico2.push(result.servicos[i]);
              }
            }
          },
        });
      };

      $scope.buscaCatalagoProduto();
      $scope.catalogo = function () {
        $("#catalogoProduto-modal").modal();
        $scope.buscaCatalagoProduto();
      };

      $("#cadastrarComanda-modal").on("shown.bs.modal", function (e) {
        if (!$scope.manyClients) {
          $scope.buscaInfoCombos();
        }
      });

      $("#comanda-modal").on("show.bs.modal", function (e) {
        $("#btnInsereProdutoComanda").prop("disabled", false);
        $("#btnInsereServicoComanda").prop("disabled", false);
        $("#btnCobrarCliente").prop("disabled", false);
      });

      $("#comanda-modal").on("hidden.bs.modal", function (e) {
        $("#comValorRecebido").val("");
        $("#comValorTroco").val("");
      });

      // ComInsertServiço

      // Parcelar Caixa
      $("#parcelarCaixa").change(function () {
        if ($("#tipoPagamento1 option:selected").val() !== undefined) {
          toastr.warning(
            "Não é possível parcelar comandas com mais de um tipo de pagamento"
          );
          $("#parcelarCaixa").prop("checked", false);
          $("#trParcelar").hide();
          $("#trParcelarPer").hide();
        }
      });

      // Botão novo tipo de Pagamento
      var g = 0;
      $("#btnNovoTipo").click(function () {
        valorCompletoComanda = 0.0;
        var valor = 0;
        $scope.novoTipoPagamento();

        var valorComandaReal = $("#valorTotalComanda")
          .html()
          .replace($_CONFIG.MOEDA, "")
          .replace(",", ".");
        valorComandaReal = parseFloat(valorComandaReal).toFixed(2);

        var listaIten = tabelaComItens.fnGetData();
        for (var i = 0; i < listaIten.length; i++) {
          if (listaIten[i].PagamentoOnline == 1) {
            valor = valor + parseFloat(listaIten[i].Valor);

            valor = parseFloat(valor);
          }
          if (listaIten[i].CPoPagamentoTotal == 0) {
            valor = listaIten[i].CPoValor;
          }
        }

        if (g < 1) {
          if (valor == 0) {
            valorCompletoComanda = $("#valorPagamento0")
              .val()
              .replace($_CONFIG.MOEDA, "")
              .replace(",", ".");
            valorCompletoComanda = parseFloat(valorCompletoComanda).toFixed(2);
            if (
              parseFloat(valorCompletoComanda) >= parseFloat(valorComandaReal)
            ) {
              $("#valorPagamento0").val((valorCompletoComanda / 2).toFixed(2));
              $("#valorPagamento1").val((valorCompletoComanda / 2).toFixed(2));
              $("#valorPagamento1").focus();
              $("#valorPagamento0").focus();
              $("#btnInsereProdutoComanda").prop("disabled", true);
              $("#btnInsereServicoComanda").prop("disabled", true);
              $("#btnCobrarCliente").prop("disabled", true);
            } else {
              $("#valorPagamento1").val(
                (valorComandaReal - valorCompletoComanda).toFixed(2)
              );
              $("#valorPagamento1").focus().change();
              $("#btnInsereProdutoComanda").prop("disabled", true);
              $("#btnInsereServicoComanda").prop("disabled", true);
              $("#btnCobrarCliente").prop("disabled", true);
              valorCompletoComanda = valorComandaReal;
            }
          } else {
            valorCompletoComanda = $("#valorTotalComanda")
              .html()
              .replace($_CONFIG.MOEDA, "")
              .replace(",", ".");
            valorCompletoComanda = parseFloat(valorCompletoComanda).toFixed(2);

            $("#valorPagamento0").val(parseFloat(valor).toFixed(2));
            $("#valorPagamento1").val(
              (valorCompletoComanda - valor).toFixed(2)
            );
            $("#valorPagamento1").focus();
            $("#valorPagamento0").focus();
            $("#btnInsereProdutoComanda").prop("disabled", true);
            $("#btnInsereServicoComanda").prop("disabled", true);
            $("#btnCobrarCliente").prop("disabled", true);
          }

          g++;
        }
      });

      // Botão finalizar comanda
      $("#btnFinalizarComanda").click(function () {
        $("#btnFinalizarComanda").prop("disabled", true);

        const hasSenhaCaixaContaCli = $("#senhaInserecaixa").html();
        var pagamentoComanda = parseFloat(
          $("#comValorTotal")
            .html()
            .replace($_CONFIG.MOEDA, "")
            .replace(",", ".")
        );
        var valorTotalComanda = parseFloat(
          $("#valorTotalComanda")
            .html()
            .replace($_CONFIG.MOEDA, "")
            .replace(",", ".")
        );

        var mensagemContaCliente = "";
        var tituloContaCliente = "";
        var insereContaCliente = 0;
        var insereCaixinha = 0;
        var displayContaCliente = 0;
        var displayCaixinha = 0;
        var inverteMensagem = 0;
        var insereCaixa = 1;
        var tipopessoacomanda = "cliente";
        var erro = 1;
        var triggerStone = [];
        if ($("#TprTipoComanda").html() == "3") {
          tipopessoacomanda = "profissional";
        }

        if (
          $("#tipoPagamento0 option:selected").val() === undefined ||
          $("#tipoPagamento0 option:selected").val() == ""
        ) {
          toastr.error("Selecione um Tipo de Pagamento.");
          $("#btnFinalizarComanda").prop("disabled", false);
          erro = 1;
        } else {
          if (
            $("#tipoPagamento1 option:selected").val() !== undefined &&
            $("#tipoPagamento1 option:selected").val() == ""
          ) {
            toastr.error("Selecione o Segundo Tipo de Pagamento.");
            $("#btnFinalizarComanda").prop("disabled", false);
            erro = 1;
          } else {
            if (pagamentoComanda != valorTotalComanda) {
              if (
                $("#nomeClienteComanda").html() == "" ||
                $("#nomeClienteComanda").html() == "Sem Cadastro"
              ) {
                mensagemContaCliente =
                  "<h4>Valor de pagamento é diferente do valor da comanda e não tem cliente associado.<br><br>Deseja prosseguir mesmo assim?</h4>";
                tituloContaCliente = "<strong>Atenção</strong>";
                displayContaCliente = 1;
                inverteMensagem = 1;
              } else if (pagamentoComanda < valorTotalComanda) {
                mensagemContaCliente =
                  "<h4>Valor de pagamento é menor que o valor da comanda.<br><br>Deseja adicionar o saldo como <strong>débito</strong> do " +
                  tipopessoacomanda +
                  "?</h4>";
                tituloContaCliente =
                  "<strong>Conta do " + tipopessoacomanda + "</strong>";
                displayContaCliente = 1;
              } else if (pagamentoComanda > valorTotalComanda) {
                mensagemContaCliente =
                  "<h4>Valor de pagamento é maior que o valor da comanda.<br><br>Deseja adicionar o saldo como <strong>crédito</strong> do " +
                  tipopessoacomanda +
                  "?</h4>";
                tituloContaCliente =
                  "<strong>Conta do " + tipopessoacomanda + "</strong>";
                displayContaCliente = 1;

                if ($scope.caixinha == 1) {
                  displayCaixinha = 1;
                } else {
                  displayCaixinha = 0;
                }
              }
            }
            erro = 0;
          }
        }

        if (erro == 0) {
          var proceedComanda = new Promise((resolve, reject) => {
            if (displayContaCliente == 1) {
              bootbox.dialog({
                message: mensagemContaCliente,
                title: tituloContaCliente,
                onEscape: function () {
                  $("#btnFinalizarComanda").prop("disabled", false);
                },
                onHide: function () {
                  $("#btnFinalizarComanda").prop("disabled", false);
                },
                buttons: {
                  success: {
                    label: "Sim",
                    className: "btn-success",
                    callback: function () {
                      if (hasSenhaCaixaContaCli /*&& inverteMensagem == 1*/) {
                        var statesdemo = {
                          state0: {
                            title: "Insira a senha ",
                            html: '<input class="form-control" type="password" name="password" id="password" value=""></label>',
                            buttons: {
                              Ok: 1,
                            },
                            submit: function (e, v, m, f) {
                              e.preventDefault();
                              if (f.password != null) {
                                $.ajax({
                                  dataType: "json",
                                  method: "POST",
                                  url: "/php/verificaSenhaCaixa.php",
                                  data: {
                                    password: f.password,
                                  },
                                  success: function (data) {
                                    if (data.erro == "0") {
                                      insereContaCliente = 1;
                                      insereCaixinha = 0;
                                      resolve({
                                        contacli: insereContaCliente,
                                        caixinha: insereCaixinha,
                                      });
                                      $.prompt.close();
                                    } else {
                                      toastr.error(data.resultado);
                                      $("#btnFinalizarComanda").prop(
                                        "disabled",
                                        false
                                      );
                                    }
                                  },
                                  error: function (data) {
                                    toastr.error(data.resultado);
                                    $("#btnFinalizarComanda").prop(
                                      "disabled",
                                      false
                                    );
                                  },
                                });
                              }
                            },
                          },
                        };
                        $.prompt(statesdemo);
                      } else {
                        insereContaCliente = 1;
                        insereCaixinha = 0;
                        resolve({
                          contacli: insereContaCliente,
                          caixinha: insereCaixinha,
                        });
                      }
                    },
                  },
                  danger: {
                    label: "Não",
                    className: "btn-danger",
                    callback: function () {
                      if (hasSenhaCaixaContaCli /*&& inverteMensagem == 0*/) {
                        var statesdemo = {
                          state0: {
                            title: "Insira a senha ",
                            html: '<input class="form-control" type="password" name="password" id="password" value=""></label>',
                            buttons: {
                              Ok: 1,
                            },
                            submit: function (e, v, m, f) {
                              e.preventDefault();
                              if (f.password != null) {
                                $.ajax({
                                  dataType: "json",
                                  method: "POST",
                                  url: "/php/verificaSenhaCaixa.php",
                                  data: {
                                    password: f.password,
                                  },
                                  success: function (data) {
                                    if (data.erro == "0") {
                                      insereContaCliente = 0;
                                      if (displayCaixinha == 1) {
                                        swal(
                                          {
                                            title: "Caixinha",
                                            text: "<h4>Deseja inserir esse valor no caixinha?</h4>",
                                            type: "warning",
                                            showCancelButton: true,
                                            confirmButtonColor: "#DD6B55",
                                            confirmButtonText:
                                              $_CONFIG.language.sim,
                                            cancelButtonText:
                                              $_CONFIG.language.nao,
                                            closeOnConfirm: true,
                                            closeOnCancel: true,
                                            html: true,
                                          },
                                          function (isConfirm) {
                                            if (isConfirm) {
                                              insereCaixinha = 1;
                                            }
                                            resolve({
                                              contacli: insereContaCliente,
                                              caixinha: insereCaixinha,
                                            });
                                          }
                                        );
                                      } else {
                                        resolve({
                                          contacli: insereContaCliente,
                                          caixinha: insereCaixinha,
                                        });
                                      }
                                      $.prompt.close();
                                    } else {
                                      toastr.error(data.resultado);
                                      $("#btnFinalizarComanda").prop(
                                        "disabled",
                                        false
                                      );
                                    }
                                  },
                                  error: function (data) {
                                    toastr.error("Falha de conexão");
                                    $("#btnFinalizarComanda").prop(
                                      "disabled",
                                      false
                                    );
                                  },
                                });
                              }
                            },
                          },
                        };
                        $.prompt(statesdemo);
                      } else {
                        if (inverteMensagem == 0) {
                          insereContaCliente = 0;
                          insereCaixinha = 0;
                          if (displayCaixinha == 1) {
                            swal(
                              {
                                title: "Caixinha",
                                text: "<h4>Deseja inserir esse valor no caixinha?</h4>",
                                type: "warning",
                                showCancelButton: true,
                                confirmButtonColor: "#DD6B55",
                                confirmButtonText: $_CONFIG.language.sim,
                                cancelButtonText: $_CONFIG.language.nao,
                                closeOnConfirm: true,
                                closeOnCancel: true,
                                html: true,
                              },
                              function (isConfirm) {
                                if (isConfirm) {
                                  insereCaixinha = 1;
                                }
                                resolve({
                                  contacli: insereContaCliente,
                                  caixinha: insereCaixinha,
                                });
                              }
                            );
                          } else {
                            resolve({
                              contacli: insereContaCliente,
                              caixinha: insereCaixinha,
                            });
                          }
                        } else {
                          $("#btnFinalizarComanda").prop("disabled", false);
                        }
                      }
                    },
                  },
                  main: {
                    label: "Cancelar",
                    className: "btn-primary",
                    callback: function () {
                      $("#btnFinalizarComanda").prop("disabled", false);
                    },
                  },
                },
              });
            } else {
              resolve({
                contacli: insereContaCliente,
                caixinha: insereCaixinha,
              });
            }
          });

          var proceedComandaCaixa = new Promise((resolve, reject) => {
            if ($("#insereCaixa").get(0).checked) {
              insereCaixa = 1;
              resolve({
                inserecaixa: insereCaixa,
              });
            } else {
              if (hasSenhaCaixaContaCli == 1) {
                var statesdemo = {
                  state0: {
                    title: "Insira a senha ",
                    html: '<input class="form-control" type="password" name="password" id="password" value=""></label>',
                    buttons: {
                      Ok: 1,
                    },
                    submit: function (e, v, m, f) {
                      e.preventDefault();
                      if (f.password != null) {
                        $.ajax({
                          dataType: "json",
                          method: "POST",
                          url: "/php/verificaSenhaCaixa.php",
                          data: {
                            password: f.password,
                          },
                          success: function (data) {
                            if (data.erro == "0") {
                              insereCaixa = 0;
                              resolve({
                                inserecaixa: insereCaixa,
                              });
                              $.prompt.close();
                            } else {
                              toastr.error(data.resultado);
                              $("#btnFinalizarComanda").prop("disabled", false);
                            }
                          },
                          error: function (data) {
                            toastr.error("Falha de conexão");
                            $("#btnFinalizarComanda").prop("disabled", false);
                          },
                        });
                      }
                    },
                  },
                };
                $.prompt(statesdemo);
              } else {
                insereCaixa = 0;
                resolve({
                  inserecaixa: insereCaixa,
                });
              }
            }
          });

          proceedComanda.then((infoCliCaixinha) => {
            proceedComandaCaixa.then((infoCaixa) => {
              if (
                ($scope.parnota == 1 && $scope.parnfse == 1) ||
                ($scope.parnota == 1 && $scope.parnfe == 1)
              ) {
                closeComanda(infoCaixa.inserecaixa, infoCliCaixinha, true);
              } else {
                closeComanda(infoCaixa.inserecaixa, infoCliCaixinha, false);
              }
            });
          });
        }
      });

      // Pacote Comandas Com
      $("#pacotesComandaCombo").change(function () {
        verificaConsumoPacote();
      });

      // Hide ComandaPacotes-Modal
      $("#comandaPacote-modal").on("hide.bs.modal", function () {
        $("#pacotesComandaCombo").val("-1").trigger("change");
      });

      // Produto change
      $("#comProduto").change(function () {
        $("#tipoUnidadeAddonComanda").html(
          $("#comProduto option:selected").get(0).dataset.tunabreviatura
        );
        if ($("#comProduto option:selected").get(0).dataset.tuncodigo != 1) {
          $("#comQtdeInsert").attr("type", "text");
          $("#comQtdeInsert").attr(
            "onkeyup",
            "formataValorDinheiro(this); calculaValorInsert();"
          );
        } else {
          $("#comQtdeInsert").attr("type", "number");
          $("#comQtdeInsert").attr("onkeyup", "");
        }
        if ($("#comProduto option:selected").get(0).dataset.iscombo == 0) {
          $.ajax({
            dataType: "json",
            method: "POST",
            url: "/pages/cadastros/buscaPessoaProduto.php",
            data: {
              procodigo: $("#comProduto option:selected").val(),
              tipo: 2,
            },
            success: function (data) {
              var html2 = "";
              html2 +=
                '<option value="" data-comissao="0">Profissional</option>';
              for (var i = 0; i < data.data.length; i++) {
                var codigo = data.data[i].Pes_Codigo;
                var apelido = data.data[i].Pes_Apelido;
                var comissao = data.data[i].comissao;
                html2 +=
                  '<option value="' +
                  codigo +
                  '" data-comissao="' +
                  comissao +
                  '">' +
                  apelido +
                  "</option>";
              }
              $("#comProfissionalComissao").html(html2);
            },
          });

          var mensagem = $("#comProduto option:selected").get(0).dataset
            .qtdminima;
          if (mensagem != "") {
            toastr.warning(mensagem);
          }
          $("#comValorHdInsert").attr("disabled", false);
          $("#comQtdeInsert").attr("disabled", false);
          $("#comTokenInsert").attr("disabled", false);
          $("#btnValidarTokenInsert").attr("disabled", false);
          $("#comParaUsoInsert").attr("disabled", false);
          if ($scope.parValorShowComissao == 1) {
            $("#comProComissao").attr("disabled", true);
          } else {
            $("#comProComissao").attr("disabled", false);
          }
        } else {
          $("#comValorHdInsert").attr("disabled", true);
          $("#comQtdeInsert").attr("disabled", true);
          $("#comTokenInsert").attr("disabled", true);
          $("#comProComissao").attr("disabled", true);
          $("#btnValidarTokenInsert").attr("disabled", true);
          $("#comParaUsoInsert").attr("disabled", true);
        }
      });

      // Informações do cliente
      $("#iconInfoCliente").click(function (event) {
        $scope.mostraInfoClientes($("#codCliente").val());
      });

      // Destroy scope
      $scope.$on("$destroy", function () {
        $("#btnFinalizarComanda").unbind("click");
        $("#btnNovoTipo").unbind("click");
        $("#iconInfoCliente").unbind("click");
        $("#formInsereItemComanda").unbind("submit");
        $("#formInsereItemComandaSer").unbind("submit");
        $("#formAlteraItemPacote").unbind("submit");
        $("#formCadastroComanda").unbind("subimit");
      });

      // Campo comissao Profissional
      $("#comProComissao").on("keyup", function (e) {
        formataValorDinheiro(this);
      });

      $("#btnCliPacote").click(function () {
        $scope.buscaCliPacote(
          $("#cliDatInicioPac").val(),
          $("#cliDatFimPac").val()
        );
      });

      $("#btnCliAgendamento").click(function () {
        $scope.buscaCliAgendamento(
          $("#cliDatInicioAge").val(),
          $("#cliDatFimAge").val()
        );
      });

      $("#btnCliComanda").click(function () {
        $scope.buscaCliComanda(
          $("#cliDatInicioCom").val(),
          $("#cliDatFimCom").val()
        );
      });

      $scope.avancaTab = function () {
        var $active = $(".cliente .nav-tabs li.active");
        $scope.nextTab($active);
      };

      $scope.retornaTab = function () {
        var $active = $(".cliente .nav-tabs li.active");
        $scope.prevTab($active);
      };

      $scope.nextTab = function (elem) {
        $(elem).next().find('a[data-toggle="tab"]').click();
      };

      $scope.prevTab = function (elem) {
        $(elem).prev().find('a[data-toggle="tab"]').click();
      };

      $scope.firstTab = function () {
        $('#infoCliente-modal a[data-toggle="tab"]:first').click();
      };

      /*--------Submits---------*/

      // Cadastrar Comanda
      $("#formCadastroComanda").submit(function (event) {
        if (
          $("#comTipoManual").val() == 1 &&
          $("#comProfissional").val() == ""
        ) {
          toastr.warning("Informe o Profissional");
        } else {
          showLoader(true);
          event.preventDefault();
          formCadastro = $(this);
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/insereComandasv2.php",
            data: new FormData(this),
            dataType: "json",
            processData: false,
            contentType: false,
            success: function (result) {
              if (result.result[0].erro == "0") {
                toastr.success(result.result[0].resultado);
                $("#nomeClienteComanda").html(result.result[0].NomeCliente);
                $("#idComanda").html(result.result[0].ComCodigo);
                $("#numComanda").html(result.result[0].ComCodigo);
                $("#numComandaProd").html(result.result[0].ComCodigo);
                $("#dataComanda").html(result.result[0].DataComanda);
                $("#edtComCartao").val(result.result[0].CodigoExterno);
                $("#codCliente").val(result.result[0].Cliente);
                $("#TprTipoComanda").html(result.result[0].TPRCodigo);
                $("#infoPontosCli").hide();

                if (result.result[0].TPRCodigo == 3) {
                  $("#labelTipoClienteComanda").html("Profissional: ");
                  $("#iconInfoCliente").hide();
                  $("#btnAssociaClienteComanda").hide();
                } else {
                  $("#labelTipoClienteComanda").html("Cliente: ");
                  $("#iconInfoCliente").show();
                  if (result.result[0].NomeCliente != "") {
                    $("#btnAssociaClienteComanda").hide();
                    $("#infoPontosCli").show();

                    $.ajax({
                      dataType: "html",
                      url: "/pages/relatorios/buscaProgramaFidelidade.php",
                      method: "POST",
                      data: {
                        selCliente: result.result[0].Cliente,
                        selTipo: 1,
                      },
                      dataType: "json",
                      success: function (data) {
                        if (data.data.length == 1) {
                          $("#stringPontosCli").html(data.data[0].TotalPontos);
                        } else {
                          $("#stringPontosCli").html(0);
                        }
                      },
                    });
                  } else {
                    $("#btnAssociaClienteComanda").show();
                    $("#nomeClienteComanda").html("Sem Cadastro");
                  }
                }
                $("#comanda-modal").modal("show");

                $scope.buscaPessoaConta();

                var PromissePagamento = new Promise((resolve, reject) => {
                  resolve($scope.atualizaTipoPagemento());
                });
                PromissePagamento.then(() => {
                  $scope.buscaItensComanda(result.result[0].ComCodigo);
                });

                if (location.hash == "#/agenda") {
                  $rootScope.$emit("BuscaAgenda", {});
                }

                $("#cadastrarComanda-modal").modal("hide");

                $("#comCliente").val("0").trigger("change");

                formCadastro.each(function () {
                  this.reset();
                });

                $("#comTipoManual").val(0);
                $("#comTipoManual").change();
                $(".date.DataComandaAbre").datepicker(
                  "update",
                  dataabrecomanda
                );
              } else {
                toastr.error(result.result[0].resultado);
              }
              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
        }

        return true;
      });

      $("#comQtde").keyup(function () {
        if ($("#comQtde").val() > 1 && $("#comToken").val() == "") {
          $("#comToken").prop("disabled", true);
        } else {
          $("#comToken").prop("disabled", false);
        }
        if ($("#comQtde").val() == 0 || $("#comQtde").val() == "") {
          $("#comQtde").val(1);
        }
      });

      $("#comQtde").change(function () {
        if ($("#comQtde").val() > 1 && $("#comToken").val() == "") {
          $("#comToken").prop("disabled", true);
        } else {
          $("#comToken").prop("disabled", false);
        }
        if ($("#comQtde").val() == 0 || $("#comQtde").val() == "") {
          $("#comQtde").val(1);
        }
      });

      $("#comToken").keyup(function () {
        if ($("#comToken").val() != "") {
          $("#comQtde").val(1).change();
          $("#comQtde").prop("disabled", true);
        } else {
          $("#comQtde").prop("disabled", false);
        }
      });

      $("#comQtdeInsert").keyup(function () {
        if ($("#comQtdeInsert").val() > 1 && $("#comTokenInsert").val() == "") {
          $("#comTokenInsert").prop("disabled", true);
        } else {
          $("#comTokenInsert").prop("disabled", false);
        }
      });
      $("#comQtdeInsert").change(function () {
        if ($("#comQtdeInsert").val() > 1 && $("#comTokenInsert").val() == "") {
          $("#comTokenInsert").prop("disabled", true);
        } else {
          $("#comTokenInsert").prop("disabled", false);
        }
      });

      $("#comTokenInsert").keyup(function () {
        if ($("#comTokenInsert").val() != "") {
          $("#comQtdeInsert").val(1);
          $("#comQtdeInsert").prop("disabled", true);
        } else {
          $("#comQtdeInsert").prop("disabled", false);
        }
      });

      // Insere itens Comanda
      $("#formInsereItemComanda").submit(function (event) {
        $("#comQtdeInsert").prop("disabled", false);
        $("#comTokenInsert").prop("disabled", false);
        event.preventDefault();
        if ($("#comProduto").val() != "-1") {
          if (
            $("#comQtdeInsert").val() != "0" &&
            $("#comQtdeInsert").val() != "" &&
            $("#comQtdeInsert").val() > 0 &&
            $("#comQtdeInsert").val() != "e"
          ) {
            if (
              $("#comTokenInsert").val() != "" ||
              $("#comValorHdInsertOLD").val() == $("#comValorHdInsert").val() ||
              $("#comParaUsoInsert").is(":checked") ||
              $("#comCortesiaInsert").is(":checked")
            ) {
              if ($("#TprTipoComanda").html() == 3) {
                if ($scope.geracomissaoprof == 1) {
                  if (
                    $("#comProComissao").val() != "0.00" &&
                    $("#comProfissionalComissao").val() == "" &&
                    $("#comProComissao").val() != "0,00" &&
                    $("#comProfissionalComissao").val() == ""
                  ) {
                    toastr.error(
                      "Insira o Profissional que irá receber a comissão."
                    );
                    return false;
                  }
                }
              } else {
                if (
                  $("#comProComissao").val() != "0.00" &&
                  $("#comProfissionalComissao").val() == "" &&
                  $("#comProComissao").val() != "0,00" &&
                  $("#comProfissionalComissao").val() == ""
                ) {
                  toastr.error(
                    "Insira o Profissional que irá receber a comissão."
                  );
                  return false;
                }
              }
              if ($("#divTokenComInsert").hasClass("has-error")) {
                $("#comCortesia").prop("disabled", false);
                toastr.error("Token Inválido.");
              } else if (
                $("#comTokenInsert").val() != "" &&
                !$("#divTokenComInsert").hasClass("has-success")
              ) {
                toastr.error("Token não validado, tentando novamente...");
                $("#comToken").keyup();
              } else if (
                $("#tipoDescontoInsert").val() == "-1" &&
                $("#comDesconto").val() != ""
              ) {
                toastr.error("Insira o tipo de desconto.");
              } else {
                var valorAgendamento = "";

                if ($("#comParaUsoInsert").is(":checked")) {
                  valorAgendamento = $("#listServicoComanda").val();
                }
                if ($("#comTokenInsert").val().length < 5) {
                  $("#comTokenInsert").val("");
                }

                $("#comValorInsert").attr("disabled", false);

                if (
                  $("#comProduto option:selected").get(0).dataset.iscombo == 1
                ) {
                  $("#comProComissao").val("");
                }
                formInsereItemComanda = $(this);
                showLoader(true);
                $.ajax({
                  type: "POST",
                  url: "/pages/cadastros/insereComandaItensV4.php",
                  data: {
                    comcodigo: $("#comCodigoInsert").val(),
                    procodigo: $("#comProduto").val(),
                    valor: $("#comValorInsert").val().replace(",", "."),
                    valorunitario: $("#comValorHdInsert")
                      .val()
                      .replace(",", "."),
                    cittoken: $("#comTokenInsert").val(),
                    citvenda: Number($("#comParaUsoInsert").is(":checked")),
                    citcomissaoproduto: $("#comProComissao").val(),
                    pescodigoprocomissao: $("#comProfissionalComissao").val(),
                    citcortesia: Number($("#comCortesiaInsert").is(":checked")),
                    iscombo: $("#comProduto option:selected").get(0).dataset
                      .iscombo,
                    qtd: $("#comQtdeInsert").val(),
                    agecodigovinculo: valorAgendamento,
                    checksenha: 0,
                  },
                  dataType: "json",

                  success: function (result) {
                    if (result.result[0].erro == "0") {
                      if ($("#insereProdutoOrigem").val() == 1) {
                        $scope.atualizaDadosItens();
                      }
                      if (location.hash == "#/comandasabertas") {
                        $rootScope.$emit("atualizaDadosComanda", {});
                      }
                      if (location.hash == "#/filaDeEspera") {
                        $rootScope.$emit("atualizaDadosFila", {});
                      }
                      toastr.success(result.result[0].resultado);

                      $("#btnValidarTokenInsert").prop("disabled", false);

                      $("#comandaInsert-modal").modal("hide");
                      if ($("#insereProdutoOrigem").val() == 1) {
                        $("#comanda-modal").modal("show");
                      }
                      formInsereItemComanda.each(function () {
                        this.reset();
                      });

                      $("#comValorHdInsert").attr("disabled", false);
                      $("#comQtdeInsert").attr("disabled", false);
                      $("#comTokenInsert").attr("disabled", false);
                      $("#btnValidarTokenInsert").attr("disabled", false);
                      $("#comParaUsoInsert").attr("disabled", false);
                      if ($scope.parValorShowComissao == 1) {
                        $("#comProComissao").attr("disabled", true);
                      } else {
                        $("#comProComissao").attr("disabled", false);
                      }
                    } else {
                      if (result.result[0].erro != "2") {
                        toastr.error(result.result[0].resultado);
                      } else {
                        //swal(result.result[0].resultado, "", "error");
                        /*-----------------------------------------------------------------------------------------------------------------------------*/

                        swal(
                          {
                            title:
                              "Não será possível inserir o produto na comanda!",
                            text: "O total de lançamentos desse produto em comandas em aberto execederá o seu saldo em estoque. Confira o relatório <b>Produtos em comandas abertas</b> para mais detalhes.",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#7ddd54",
                            cancelButtonColor: "#679bef",
                            confirmButtonText: "Ver relatório",
                            cancelButtonText: "Ok",
                            closeOnConfirm: false,
                            closeOnCancel: true,
                            html: true,
                          },
                          function (isConfirm) {
                            if (isConfirm) {
                              swal.close();
                              $("#comandaInsert-modal").modal("hide");
                              $state.go("relGerencialEstoque");
                            }
                          }
                        );

                        /*-----------------------------------------------------------------------------------------------------------------------------*/
                      }
                      if (
                        $("#comProduto option:selected").get(0).dataset
                          .iscombo == 1
                      ) {
                        $("#comQtdeInsert").prop("disabled", true);
                        $("#comTokenInsert").prop("disabled", true);
                        $("#comValorInsert").attr("disabled", true);
                      }
                    }
                    showLoader(false);
                    if (
                      $("#comProduto option:selected").get(0).dataset.iscombo ==
                      0
                    ) {
                      $("#comValorInsert").attr("disabled", true);
                    }
                  },
                  error: function (result) {
                    toastr.error("Falha na conexão.");
                    showLoader(false);
                    if (
                      $("#comProduto option:selected").get(0).dataset.iscombo ==
                      0
                    ) {
                      $("#comValorInsert").attr("disabled", true);
                    }
                  },
                });

                return true;
              }
            } else {
              if ($("#senhaDesconto").html() == "1") {
                var statesdemo = {
                  state0: {
                    title: "Insira a senha ",
                    html: '<input class="form-control" type="password" name="password" id="password" value=""></label>',
                    buttons: {
                      Ok: 1,
                    },
                    submit: function (e, v, m, f) {
                      e.preventDefault();
                      if (f.password != null) {
                        showLoader(true);

                        if ($("#TprTipoComanda").html() == 3) {
                          if ($scope.geracomissaoprof == 1) {
                            if (
                              $("#comProComissao").val() != "0.00" &&
                              $("#comProfissionalComissao").val() == "" &&
                              $("#comProComissao").val() != "0,00" &&
                              $("#comProfissionalComissao").val() == ""
                            ) {
                              toastr.error(
                                "Insira o Profissional que irá receber a comissão."
                              );
                              showLoader(false);
                              $.prompt.close();
                              return false;
                            }
                          }
                        } else {
                          if (
                            $("#comProComissao").val() != "0.00" &&
                            $("#comProfissionalComissao").val() == "" &&
                            $("#comProComissao").val() != "0,00" &&
                            $("#comProfissionalComissao").val() == ""
                          ) {
                            toastr.error(
                              "Insira o Profissional que irá receber a comissão."
                            );
                            showLoader(false);
                            $.prompt.close();
                            return false;
                          }
                        }

                        if ($("#divTokenComInsert").hasClass("has-error")) {
                          $("#comCortesia").prop("disabled", false);
                          showLoader(false);
                          $.prompt.close();
                          toastr.error("Token Inválido.");
                        } else if (
                          $("#comTokenInsert").val() != "" &&
                          !$("#divTokenComInsert").hasClass("has-success")
                        ) {
                          toastr.error(
                            "Token não validado, tentando novamente..."
                          );
                          showLoader(false);
                          $.prompt.close();
                          $("#comToken").keyup();
                        } else if (
                          $("#tipoDescontoInsert").val() == "-1" &&
                          $("#comDesconto").val() != ""
                        ) {
                          showLoader(false);
                          $.prompt.close();
                          toastr.error("Insira o tipo de desconto.");
                        } else {
                          if ($("#comTokenInsert").val().length < 5) {
                            $("#comTokenInsert").val("");
                          }

                          $("#comValorInsert").attr("disabled", false);
                          formInsereItemComanda = $(this);
                          showLoader(true);
                          if (
                            $("#comProduto option:selected").get(0).dataset
                              .iscombo == 1
                          ) {
                            $("#comProComissao").val("");
                          }
                          $.ajax({
                            type: "POST",
                            url: "/pages/cadastros/insereComandaItensV4.php",
                            data: {
                              comcodigo: $("#comCodigoInsert").val(),
                              procodigo: $("#comProduto").val(),
                              valor: $("#comValorInsert")
                                .val()
                                .replace(",", "."),
                              valorunitario: $("#comValorHdInsert")
                                .val()
                                .replace(",", "."),
                              cittoken: $("#comTokenInsert").val(),
                              citvenda: Number(
                                $("#comParaUsoInsert").is(":checked")
                              ),
                              citcomissaoproduto: $("#comProComissao").val(),
                              pescodigoprocomissao: $(
                                "#comProfissionalComissao"
                              ).val(),
                              citcortesia: Number(
                                $("#comCortesiaInsert").is(":checked")
                              ),
                              iscombo: $("#comProduto option:selected").get(0)
                                .dataset.iscombo,
                              qtd: $("#comQtdeInsert").val(),
                              senhaitens: MD5(f.password),

                              checksenha: 1,
                            },
                            dataType: "json",

                            success: function (result) {
                              if (result.result[0].erro == "0") {
                                if ($("#insereProdutoOrigem").val() == 1) {
                                  $scope.atualizaDadosItens();
                                }
                                if (location.hash == "#/comandasabertas") {
                                  $rootScope.$emit("atualizaDadosComanda", {});
                                }
                                if (location.hash == "#/filaDeEspera") {
                                  $rootScope.$emit("atualizaDadosFila", {});
                                }
                                toastr.success(result.result[0].resultado);

                                $("#btnValidarTokenInsert").prop(
