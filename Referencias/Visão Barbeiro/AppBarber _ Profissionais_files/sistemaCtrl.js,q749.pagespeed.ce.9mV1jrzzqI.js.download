      $.ajax({
        dataType: "json",
        url: localStorage.getItem("host"),
        data: {
          metodo: "buscaParametro",
          id: $scope.idCliente,
          parcodigo: 23,
        },
        success: function (data) {
          if (data.result.length > 0) {
            if (data.result[0].PVa_Vlr_Principal == "1") {
              $(".campoComissaoComanda").show();

              $("#comComissao").attr("readonly", true);
              $("#comProComissao").attr("readonly", true);
              $scope.parValorShowComissao = 1;
            } else if (data.result[0].PVa_Vlr_Principal == "2") {
              $(".campoComissaoComanda").hide();
              $scope.parValorShowComissao = 2;
            } else {
              $(".campoComissaoComanda").show();

              $("#comComissao").attr("readonly", false);
              $("#comProComissao").attr("readonly", false);
              $scope.parValorShowComissao = 0;
            }
          } else {
            $(".campoComissaoComanda").show();
            $scope.parValorShowComissao = 0;
            $("#comComissao").attr("readonly", false);
            $("#comProComissao").attr("readonly", false);
          }
        },
      });

      //--------------------------------------------------------------------------------------------------------------------------------
      // Funções
      $scope.buscaInfoCombos = function () {
        if (hasManyClients) {
          $("#comCliente").select2({
            ajax: {
              url: localStorage.getItem("host"),
              dataType: "json",
              delay: 250,
              data: function (params) {
                return {
                  nome: params.term,
                  metodo: "buscaClientes_v4",
                  tipo: 5,
                  id: $_CONFIG.ID,
                };
              },
              processResults: function (data, params) {
                return {
                  results: data.result,
                };
              },
              cache: true,
            },
            placeholder: "Sem Cadastro",
            escapeMarkup: function (markup) {
              return markup;
            },
            minimumInputLength: 3,
            templateResult: thumbClienteName,
            templateSelection: formatRepoSelection,
          });
        } else {
          $.ajax({
            dataType: "json",
            url: localStorage.getItem("host"),
            data: {
              metodo: "buscaClientes_v3",
              id: $_CONFIG.ID,
              tipo: 2,
            },
            success: function (data) {
              clientesNomesComanda.length = 0;
              var html =
                '<option data-usucodigo="" data-imagem="" value="0" selected>Sem Cadastro</option>';
              for (var i = 0; i < data.result.length; i++) {
                var codigo = data.result[i].Pes_Codigo;
                var nome = data.result[i].Pes_Nome;
                var foto = data.result[i].Paf_Imagem;
                var usucod = data.result[i].Usu_Codigo;
                var celular = "";
                if (data.result[i].Paf_Celular != "") {
                  celular = " - " + data.result[i].Paf_Celular;
                }

                html +=
                  '<option data-usucodigo="' +
                  usucod +
                  '" data-imagem="' +
                  foto +
                  '" value="' +
                  codigo +
                  '">' +
                  nome +
                  "" +
                  celular +
                  "</option>";
                clientesNomesComanda.push(nome);
              }
              $("#comCliente").html(html);
              if (data.result.length > 800) {
                $("#comCliente").select2({
                  minimumInputLength: 3,
                });
                $scope.manyClients = true;
              } else {
                $("#comCliente").select2();
                $scope.manyClients = false;
              }
              $("#comCliente").val("0").trigger("change");
            },
          });
        }

        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          data: {
            metodo: "buscaProfissionais",
            id: $_CONFIG.ID,
          },
          success: function (data) {
            var html2 = "";
            html2 += '<option value="">Profissional</option>';
            for (var i = 0; i < data.profissionais.length; i++) {
              var codigo = data.profissionais[i].Pes_Codigo;
              var apelido = data.profissionais[i].Pes_Apelido;
              html2 +=
                '<option value="' + codigo + '">' + apelido + "</option>";
            }
            $("#comProfissionalComissao").html(html2);
            $("#profissionalGorjeta").html(html2);
            $("#profissionalGorjetaAltera").html(html2);
            $("#profissionalSelVale").html(html2);
            $("#comProfissional").html(html2);
            $("#comProfissional").val("").trigger("change");
            $("#comProfissional").select2();
          },
        });
      };
      // Atualiza Dados Itens Insert
      $scope.atualizaDadosItensInsert = function (codigo) {
        tabelaCom.ajax.reload(function (e) {
          e.data.forEach(function (element, index, array) {
            if (element.Codigo == codigo) {
              $("#nomeClienteComanda").html(element.Cliente);
              $("#idComanda").html(element.Codigo);
              $("#numComanda").html(element.Codigo);
              $("#numComandaProd").html(element.Codigo);

              $("#dataComanda").html(element.DataCadastro);
              $scope.buscaItensComanda(element.Codigo);
              $("#comanda-modal").modal("show");
              $compile($("#tbBuscaComandas"))($scope);
              $("#tbBuscaComandas_paginate").click(function () {
                $compile($("#tbBuscaComandas"))($scope);
              });
            }
          });
        });
      };

      $("#comProfissionalComissao").change(function () {
        calculaValorInsert();
      });

      // Busca Tipo Inserção

      $("#comTipoManual").change(() => {
        if ($("#comTipoManual").val() == 1) {
          $("#divClienteCadastroComanda").hide();
          $("#divProfissionalCadastroComanda").show();
        } else {
          $("#divProfissionalCadastroComanda").hide();
          $("#divClienteCadastroComanda").show();
        }
      });
      $("#comTipoManual").change();

      // Busca Profissional Serviço
      $scope.buscaProfissionalServico = function (sercodigo, tipo) {
        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          data: {
            metodo: "buscaProfissionais",
            servico: sercodigo,
            id: $_CONFIG.ID,
            tipo: tipo,
          },
          success: function (data) {
            var html = "";
            html += '<option value="">Profissional</option>';
            for (var i = 0; i < data.profissionais.length; i++) {
              var codigo = data.profissionais[i].Pes_Codigo;
              var apelido = data.profissionais[i].Pes_Apelido;
              html += '<option value="' + codigo + '">' + apelido + "</option>";
            }
            $("#comInsertProfissional").html(html);
            $("#comInsertProfissional").val("").trigger("change");
            $("#comInsertProfissional").select2();
          },
        });
      };

      $scope.buscaProfissionalServico("", "");
      $("#comInsertProfissional").change(function () {
        setTimeout(function () {
          if (
            this.value != "" &&
            $("#comInsertServico").val() != "" &&
            $("#comInsertServico option:selected").get(0).dataset.tipoitem ==
              "1"
          ) {
            buscaAssocProfissionalServico(
              $("#comInsertServico").val(),
              $("#comInsertProfissional").val()
            );
          }
        }, 300);
      });

      $("#comInsertServico").change(function () {
        setTimeout(function () {
          if (
            this.value != "" &&
            $("#comInsertProfissional").val() != "" &&
            $("#comInsertServico option:selected").get(0).dataset.tipoitem ==
              "1"
          ) {
            buscaAssocProfissionalServico(
              $("#comInsertServico").val(),
              $("#comInsertProfissional").val()
            );
          }
        }, 300);
      });

      // Busca Tipo Pagamento
      $scope.buscaTipoPagamento = function () {
        $scope.tiposPagamento = $_CONFIG.LISTA_PAGAMAENTO;
        if (j == 0) {
          $("#parcelarCaixa").prop("checked", false);
          $("#parcelarCaixa").change();
          $scope.novoTipoPagamento();
        }
        $("#codigoTransacao0").val("");

        valorCompletoComanda = $("#valorTotalComanda")
          .html()
          .replace($_CONFIG.MOEDA, "")
          .replace(",", ".");
      };

      // Novo Tipo De Pagamento
      var j = 0;
      var valorCompletoComanda = 0;
      $scope.novoTipoPagamento = function () {
        $("#codigoTransacao" + j).val("");
        if ($("#parcelarCaixa").get(0).checked) {
          swal(
            "Não é possivel adicionar mais formas de pagamento para uma comanda parcelada",
            "",
            "warning"
          );
          return false;
        } else if (j > 1) {
          toastr.error("Limite de tipos de pagamento: 2.");
        } else {
          var tabelaPagamento =
            '<div class="row borders" style="margin-top:5px !important;margin-bottom:5px !important;" id="linhaPagamento' +
            j +
            '">';
          tabelaPagamento +=
            '<div class="col-md-4 col-xs-12"><select  data-idx="' +
            j +
            '" id="tipoPagamento' +
            j +
            '" class="form-control input-sm"></select></div>';
          tabelaPagamento +=
            '<div class="col-md-4 col-xs-12"><select  id="divBandeiraPag' +
            j +
            '"  class="form-control input-sm"></select></div>';
          tabelaPagamento +=
            '<div class="col-md-3 col-xs-12"><input type="text" class="form-control input-sm valorFormat" data-idx="' +
            j +
            '" id="valorPagamento' +
            j +
            '"></div>';
          tabelaPagamento +=
            '<div class="col-md-1 col-xs-12" > <div class="row" >';
          tabelaPagamento +=
            '<button class="btn btn-xs btn-link" ng-click="comandaCodigoTransacao(' +
            j +
            ')" id="btnCodigoTransac' +
            j +
            '" style="transform: translateY(25%);"><i class="fa fa-tag"></i></button>';
          tabelaPagamento +=
            '<input type="hidden" id="codigoTransacao' + j + '">';
          tabelaPagamento += '<input type="hidden" id="TraCodigo' + j + '">';
          tabelaPagamento +=
            '<input type="hidden" id="IdTransaction' + j + '">';
          tabelaPagamento +=
            '<input type="hidden" id="StatusTransaction' + j + '">';
          if (j !== 0) {
            tabelaPagamento +=
              '<button  id="btnRemoveTipo' +
              j +
              '" class="btn btn-xs btn-link" style="transform: translateY(25%);"><i class="fa fa-trash"></i></button>';
          } else {
            tabelaPagamento += "";
          }
          tabelaPagamento += "</div></div>";

          $("#variostiposdepagamento").append(tabelaPagamento);
          $(".valor").maskMoney({
            allowZero: true,
            thousands: "",
            decimal: ",",
          });

          var tiposDePagamento = '<option value ="">Pagamento</option>';
          for (var i = 0; i < $scope.tiposPagamento.length; i++) {
            tiposDePagamento +=
              "<option value =" +
              $scope.tiposPagamento[i].TPa_Codigo +
              ' data-pagamentoOnline ="' +
              $scope.tiposPagamento[i].TPa_Pag_Online +
              '" data-pagamentoOnlineParcelado ="' +
              $scope.tiposPagamento[i].TPa_Parcelado +
              '" data-desconto="' +
              $scope.tiposPagamento[i].TPa_Desconto +
              '" data-tipodesconto="' +
              $scope.tiposPagamento[i].TPa_Tipo_Desconto +
              '" data-aplicacomissao="' +
              $scope.tiposPagamento[i].TPa_Aplica_Comissao +
              '"  data-integracao="' +
              $scope.tiposPagamento[i].TPa_Integracao +
              '"  data-tipoIntegracao="' +
              $scope.tiposPagamento[i].TPa_Tipo +
              '" >' +
              $scope.tiposPagamento[i].TPa_Descricao +
              "</option>";
          }

          $compile($("#divPagamentoOptions0"))($scope);
          $compile($("#btnRemoveTipo"))($scope);
          $compile($("#btnCodigoTransac" + j))($scope);
          $compile($("#tipoPagamento" + j))($scope);
          $("#tipoPagamento" + j).html(tiposDePagamento);

          $compile($("#divBandeiraPag" + j))($scope);
          $("#divBandeiraPag" + j).html('<option value ="">Bandeira</option>');
          $("#valorPagamento" + j).val(0.0);
          $("#divBandeiraPag" + j).prop("disabled", true);
          $("#valorPagamento" + j).unbind("change");
          var valor = 0.0;

          $("#valorPagamento" + j).change(function () {
            if ($("#tipoPagamento1 option:selected").val() !== undefined) {
              if ($("#tipoPagamento1 option:selected").val() !== "") {
                if (
                  $("#valorPagamento1").val() !== "" ||
                  $("#valorPagamento1").val() !== "0,00"
                ) {
                  valor =
                    parseFloat(
                      $("#valorPagamento0")
                        .val()
                        .replace($_CONFIG.MOEDA, "")
                        .replace(",", ".")
                    ) +
                    parseFloat(
                      $("#valorPagamento1")
                        .val()
                        .replace($_CONFIG.MOEDA, "")
                        .replace(",", ".")
                    );
                } else {
                  toastr.error(
                    "Por favor, insira o valor relacionado a segunda forma de pagamento."
                  );
                }
              } else {
                valor =
                  parseFloat(
                    $("#valorPagamento0")
                      .val()
                      .replace($_CONFIG.MOEDA, "")
                      .replace(",", ".")
                  ) +
                  parseFloat(
                    $("#valorPagamento1")
                      .val()
                      .replace($_CONFIG.MOEDA, "")
                      .replace(",", ".")
                  );
              }
            } else {
              valor = parseFloat(
                $("#valorPagamento0")
                  .val()
                  .replace($_CONFIG.MOEDA, "")
                  .replace(",", ".")
              );
            }

            $("#comValorTotal")
              .html($_CONFIG.MOEDA + valor.toFixed(2).replace(".", ","))
              .change();

            $scope.calculaParcelas($("#comValorTotal").html());
          });
          $(".valorFormat").on("keyup", function (e) {
            formataValorDinheiro(this);
          });

          $("#btnRemoveTipo" + j).unbind("click");
          $("#btnRemoveTipo" + j).click(function () {
            $("#valorPagamento0").val(valorCompletoComanda);
            $("#comValorTotal")
              .html(
                $_CONFIG.MOEDA +
                  parseFloat(valorCompletoComanda).toFixed(2).replace(".", ",")
              )
              .change();
            $("#valorPagamento0").focus();
            $("#btnInsereProdutoComanda").prop("disabled", false);
            $("#btnInsereServicoComanda").prop("disabled", false);
            $("#btnCobrarCliente").prop("disabled", false);
            $scope.removeTipoPagemento();
          });

          $("#tipoPagamento" + j).unbind("change");
          $("#tipoPagamento" + j).change(function () {
            var idx = this.dataset.idx;
            if (idx == 0 && j == 1) {
              if (
                $("#tipoPagamento" + idx + " option:selected").get(0).dataset
                  .desconto != "" &&
                $("#tipoPagamento" + idx + " option:selected").get(0).dataset
                  .desconto != undefined
              ) {
                var displayDesconto = 1;
                if (
                  $("#tipoPagamento" + idx + " option:selected").get(0).dataset
                    .tipodesconto != 2
                ) {
                  var tableItemsize = tabelaComItens.api().rows().length;
                  var numseritem = 0;
                  var numproitem = 0;
                  for (let i = 0; i <= tableItemsize; i++) {
                    if (tabelaComItens.api().rows().data()[i].TipoItem == 1) {
                      numseritem = numseritem + 1;
                    } else {
                      numproitem = numproitem + 1;
                    }
                  }

                  if (
                    $("#tipoPagamento" + idx + " option:selected").get(0)
                      .dataset.tipodesconto == 0 &&
                    numseritem == 0
                  ) {
                    displayDesconto = 0;
                  } else if (
                    $("#tipoPagamento" + idx + " option:selected").get(0)
                      .dataset.tipodesconto == 1 &&
                    numproitem == 0
                  ) {
                    displayDesconto = 0;
                  }
                }
                if (displayDesconto == 1) {
                  swal(
                    {
                      title: "Forma de pagamento com desconto",
                      text: `<h4>Essa forma de pagamento possui um desconto de ${
                        $("#tipoPagamento" + idx + " option:selected").get(0)
                          .dataset.desconto
                      }%, deseja aplicar a essa comanda?</h4>`,
                      type: "warning",
                      showCancelButton: true,
                      confirmButtonColor: "#DD6B55",
                      confirmButtonText: $_CONFIG.language.sim,
                      cancelButtonText: $_CONFIG.language.nao,
                      closeOnConfirm: true,
                      closeOnCancel: true,
                      html: true,
                    },
                    function (isConfirm) {
                      if (isConfirm) {
                        $.ajax({
                          dataType: "json",
                          url: "/pages/cadastros/alteraComandaDescontov2.php",
                          data: {
                            comcodigo: $("#idComanda").html(),
                            tipopagamento: $(
                              "#tipoPagamento" + idx + " option:selected"
                            ).val(),
                          },
                          success: function (result) {
                            if (result.data[0].erro == "0") {
                              $scope.atualizaDadosItens();
                              if (location.hash == "#/comandasabertas") {
                                $rootScope.$emit("atualizaDadosComanda", {});
                              }
                              toastr.success(result.data[0].resultado);
                            } else {
                              toastr.error(result.data[0].resultado);
                            }
                          },
                        });
                      }
                    }
                  );
                }
              }
            }

            if (
              $("#tipoPagamento" + idx + " option:selected").text() ==
              "Resgate de Pontos"
            ) {
              toastr.info(
                "Para efetivar o resgate tenha certeza de inserir o TOKEN, caso tenha associado prossiga normalmente"
              );
            }
            if ($("#tipoPagamento" + idx + " option:selected").val() == "") {
              $("#divBandeiraPag" + idx).val("");
              $("#divBandeiraPag" + idx).prop("disabled", true);
            } else {
              $scope.buscaTipoBandeira(this);
            }
          });

          j++;
        }
      };

      // Remove Tipo de Pagamento
      $scope.removeTipoPagemento = function () {
        if (j == 1) {
          toastr.error("A Comanda deve possuir ao menos um tipo de pagamento!");
        } else {
          if ($("#TraCodigo1").val() != "") {
            atualizaTransacao($("#TraCodigo1").val());
            $("#linhaPagamento1").remove();
            $("#parcelarCaixa").prop("disabled", false);
            $("#codigoTransacao1").val("");
            j = 1;
            g = 0;
          } else {
            $("#linhaPagamento1").remove();
            $("#parcelarCaixa").prop("disabled", false);
            $("#codigoTransacao1").val("");
            j = 1;
            g = 0;
          }
        }
      };

      $scope.atualizaTipoPagemento = function () {
        for (var i = j; i >= 0; i--) {
          $("#linhaPagamento" + i).remove();
          $("#parcelarCaixa").prop("disabled", false);
          $("#codigoTransacao" + i).val("");
        }
        j = 0;
        g = 0;
        $scope.buscaTipoPagamento();
      };

      // Busca Tipo Bandeira
      $scope.buscaTipoBandeira = function (tipobandeira) {
        var idx = tipobandeira.dataset.idx;
        var html = "";
        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          data: {
            metodo: "buscaTipoBandeira",
            id: $scope.idCliente,
            tpacodigo: tipobandeira.value,
          },
          success: function (result) {
            html += '<option value ="">Bandeira</option>';
            var iscartao = 1;

            if (result.result.length == 1) {
              iscartao = result.result[0].TPa_Cartao;
              for (var i = 0; i < result.result.length; i++) {
                html +=
                  "<option value =" +
                  result.result[i].TBa_Codigo +
                  " selected>" +
                  result.result[i].TBa_Descricao +
                  "</option>";
              }
            } else if (result.result.length > 1) {
              for (var i = 0; i < result.result.length; i++) {
                html +=
                  "<option value =" +
                  result.result[i].TBa_Codigo +
                  ">" +
                  result.result[i].TBa_Descricao +
                  "</option>";
              }
            } else {
              iscartao = 0;
            }

            if (result.result.length == "0") {
              $("#divBandeiraPag" + idx).prop("disabled", true);
            } else {
              $("#divBandeiraPag" + idx).prop("disabled", false);
            }
            if (iscartao == 0) {
              $("#divBandeiraPag" + idx).prop("disabled", true);
              html = '<option value ="">Bandeira</option>';
            }
            $("#divBandeiraPag" + idx).html(html);
            $("#divBandeiraPag" + idx).val("");

            $compile($("#divBandeiraPag" + idx))($scope);
          },
        });
      };

      //insere o codigo da transacao na comanda
      $scope.comandaCodigoTransacao = function (idx) {
        $("#idxCodigoTransac").val(idx);
        $("#codigoTransacao-modal").modal();
      };

      $scope.guardaCodigoTransac = function () {
        var idx = $("#idxCodigoTransac").val();
        $("#codigoTransacao" + idx).val($("#inputcodigo").val());
        $("#inputcodigo").val("");
        $("#codigoTransacao-modal").modal("hide");
      };

      // Editar item Comanda
      $scope.editarItemComanda = function (idx) {
        if (j == 1) {
          var registroTabela = tabelaComItens.fnGetData(idx);

          if (registroTabela.ProGorjeta == 0) {
            limpaToken($("#divTokenCom"), $("#tokenCom"), $("#msgTokenCom"));
            limpaToken($("#divCupomCom"), $("#cupomCom"), $("#msgCupomCom"));
            $("#comCupom").val("");
            $("#comCupom").prop("disabled", false);
            $("#btnValidarCupom").prop("disabled", false);
            $("#comValor").val(registroTabela.Valor);
            $("#comValorRestore").val(registroTabela.Valor);
            $("#comValorHd").val(registroTabela.ValorUn);
            $("#comValorHdOLD").val(registroTabela.ValorUn);
            $("#comValSerHd").val(registroTabela.ValorUn);
            $("#comCodItem").val(registroTabela.CodItem);
            $("#comTipoItem").val(registroTabela.TipoItem);
            $("#comCodSerPro").val(registroTabela.CodSerPro);
            $("#comCupomProfissional").val(registroTabela.Profissional_Codigo || registroTabela.CodigoProfissionalComissao || registroTabela.CodigoProfissional || "");
            $("#comCupomDataInicio").val(registroTabela.Data || registroTabela.DataAgendamento || "");
            $("#comDesconto").val(
              registroTabela.Desconto.replace("%", "")
                .replace($_CONFIG.MOEDA, "")
                .replace(" ", "")
            );
            $("#comQtde").val(registroTabela.Quantidade);
            $("#comComissao").val(
              parseFloat(registroTabela.Comissao).formatMoney(2, ",")
            );
            $("#comComissaoHd").val(registroTabela.ComissaoPadrao);
            $("#comComissaoPrincipalHd").val(registroTabela.ComissaoPrincipal);
            $("#itemNome").html(registroTabela.Item);
            $("#itemValorOriginal").val(registroTabela.ValorOriginal);
            if (registroTabela.Quantidade == 1) {
              $("#comToken").prop("disabled", false);
            } else {
              $("#comToken").prop("disabled", true);
            }

            $("#tipoUnidadeAddonEdtComanda").html(registroTabela.TipoUnidade);

            if (registroTabela.TUnCodigo != 1) {
              $("#comQtde").attr("type", "text");
              $("#comQtde").attr(
                "onkeyup",
                "formataValorDinheiro(this); calculaValor();"
              );
            } else {
              $("#comQtde").attr("type", "number");
              $("#comQtde").attr("onkeyup", "");
            }

            if (registroTabela.Combo != "") {
              $("#comValorHd").prop("disabled", true);
              $("#comQtde").prop("disabled", true);
              $("#comComissao").prop("disabled", true);
              $("#comToken").prop("disabled", true);
              $("#btnValidarToken").prop("disabled", true);
              $("#comParaUso").prop("disabled", true);
            } else {
              $("#comValorHd").prop("disabled", false);
              $("#comQtde").prop("disabled", false);
              $("#comToken").prop("disabled", false);
              $("#btnValidarToken").prop("disabled", false);
              $("#comParaUso").prop("disabled", false);
              if ($scope.parValorShowComissao == 1) {
                $("#comComissao").attr("disabled", true);
              } else {
                $("#comComissao").attr("disabled", false);
              }
            }
            $("#listaServicoUsoEdt").hide();
            if (registroTabela.TipoItem == "0") {
              $("#comQtde").prop("disabled", false);
              $("#comProValor").val(registroTabela.ProValor);
              if (registroTabela.Venda == "0") {
                $("#comParaUso").get(0).checked = true;
                if (
                  $scope.parDescontoProduto == "1" ||
                  $scope.parDescontoProduto == "2"
                ) {
                  if ($("#listServicoComandaEdt").children().length > 0) {
                    $("#listaServicoUsoEdt").show();
                  }
                }
              } else {
                $("#comParaUso").get(0).checked = false;
              }
            } else {
              $("#comQtde").prop("disabled", true);
            }

            if (registroTabela.Cortesia == "1") {
              $("#comCortesia").get(0).checked = true;
            } else {
              $("#comCortesia").get(0).checked = false;
            }

            if (registroTabela.TipoItem == "1") {
              $("#comParaUsoTipoItem").hide();
              $("#comAlteraDataAgendamento").show();
            } else {
              $("#comParaUsoTipoItem").show();
              $("#comAlteraDataAgendamento").hide();
            }

            if (registroTabela.TipoDesconto != "") {
              $("#tipoDesconto").val(registroTabela.TipoDesconto);
            } else {
              $("#tipoDesconto").val("-1");
            }

            $("#comanda-modal").modal("hide");
            $("#comandaEdit-modal").modal("show");
          } else {
            $("#itemComandaGorjeta").val(registroTabela.CodItem);
            $("#valorComandaGorjetaAltera").val(registroTabela.Valor);
            $("#profissionalGorjetaAltera").val(
              registroTabela.CodigoProfissionalComissao
            );
            $("#comandaAlteraGorjeta-modal").modal();
            $("#listaServicoUsoEdt").hide();
          }
        } else {
          swal(
            "Não é possivel alterar itens em uma comanda com mais de uma forma de pagamento",
            "",
            "warning"
          );
        }
      };

      $("#comValorDesconto").keyup(function () {
        if ($("#comValorDesconto").val() > 100) {
          $("#comValorDesconto").val(100);
        }
      });

      // Remove itens pacote comanda
      $scope.removePacoteItemComanda = function (codigo) {
        swal(
          {
            title: "Confirmar exclusão:",
            text: "Deseja desassociar o pacote?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Sim",
            cancelButtonText: "Não",
            closeOnConfirm: true,
          },
          function () {
            showLoader(true);
            $.ajax({
              dataType: "html",
              url: "/pages/cadastros/removePacoteItemComanda.php",
              data: {
                ppdcodigo: codigo,
              },
              success: function (data) {
                if (data == "0") {
                  toastr.success("Pacote Desassociado com Sucesso.");
                  $scope.atualizaDadosItens();
                  if (location.hash == "#/comandasabertas") {
                    $rootScope.$emit("atualizaDadosComanda", {});
                  }
                } else {
                  toastr.error(data, "Falha ao Desassociado o Pacote.");
                }
                showLoader(false);
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
                showLoader(false);
              },
            });
          }
        );
      };

      // Adicionar item Pacote comanda
      $scope.adicionarPacoteItemComanda = function (idx) {
        var hasPacote = 0;
        var hasAssinatura = 0;
        showLoader(true);
        if (j == 1) {
          var registroTabela = tabelaComItens.fnGetData(idx);
          $.ajax({
            url: "/pages/cadastros/buscaPacotesPessoaCombo.php",
            type: "POST",
            dataType: "json",
            async: false,
            data: {
              pescodigo: $("#codCliente").val(),
              codigo: registroTabela.CodSerPro,
              tipo: registroTabela.TipoItem,
            },
            success: function (data) {
              if (data.result.length > 0) {
                html = '<option value="-1">Selecione um Pacote</option>';
                for (var i = 0; i < data.result.length; i++) {
                  html +=
                    "<option data-codigo='" +
                    data.result[i].PTe_Codigo +
                    "' data-cadastro='" +
                    data.result[i].PPa_Dat_Cadastro +
                    "' data-uso='" +
                    data.result[i].PPa_Qtd_Usada +
                    "' data-total='" +
                    data.result[i].PPa_Qtd_Sessao +
                    "' value='" +
                    data.result[i].PPa_Codigo +
                    "'>" +
                    data.result[i].Pac_Descricao +
                    "</option>";
                }

                $("#pacotesComandaCombo").html(html);
                $("#comTipoItemPac").val(registroTabela.TipoItem);
                $("#comCodSerProPac").val(registroTabela.CodSerPro);
                $("#comCodItemPac").val(registroTabela.CodItem);
                $("#itemNomePacote").html(registroTabela.Item);

                hasPacote = 1;
              }

              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });

          $.ajax({
            url: "/pages/cadastros/buscaAssinaturaPessoaItens.php",
            type: "POST",
            dataType: "json",
            async: false,
            data: {
              pescodigocliente: $("#codCliente").val(),
              sercodigo: registroTabela.CodSerPro,
              dataagendamento: registroTabela.dataComanda,
            },
            success: function (data) {
              if (data.data.length > 0) {
                if (data.data[0].Disponivel == 1) {
                  hasAssinatura = 1;
                }

                if (data.data[0].ISMulti == 1) {
                  if (data.data[0].Disponiveis == 10000) {
                    $("#titleUtilizacao").html(`Ilimitado`);
                  } else {
                    $("#titleUtilizacao").html(
                      `${data.data[0].Usados}/${data.data[0].Disponiveis}`
                    );
                  }
                } else {
                  $("#titleUtilizacao").html(
                    `${data.data[0].Usados}/${data.data[0].Disponiveis}`
                  );
                }
                $("#titleVencimento").html(data.data[0].Vencimento);
                $("#titleAssinatura").html(data.data[0].Descricao);
                $("#AssCodigoAssocia").val(data.data[0].CodigoAssinatura);
                $("#APFCodigoAssocia").val(data.data[0].CodigoFatura);
                $("#CitCodigoAssocia").val(registroTabela.CodItem);
                $("#IsMultiUnidade").val(data.data[0].ISMulti);
              }
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
        } else {
          toastr.warning(
            "Não é possivel alterar itens em uma comanda com mais de uma forma de pagamento"
          );
        }

        if (hasPacote == 1 && hasAssinatura == 1) {
          $("#comanda-modal").modal("hide");
          $("#selectTipoAssociacao-modal").modal("show");
        } else if (hasPacote == 1 && hasAssinatura == 0) {
          $("#comanda-modal").modal("hide");
          $("#comandaPacote-modal").modal("show");
        } else if (hasPacote == 0 && hasAssinatura == 1) {
          $("#comanda-modal").modal("hide");
          $("#comandaAssinatura-modal").modal("show");
        } else {
          toastr.error(
            "Sem pacote ou assinatura para este Cliente com este Item."
          );
        }
      };

      $scope.displayOptionPacote = function () {
        $("#selectTipoAssociacao-modal").modal("hide");
        $("#comandaPacote-modal").modal("show");
      };

      $scope.displayOptionAssinatura = function () {
        $("#selectTipoAssociacao-modal").modal("hide");
        $("#comandaAssinatura-modal").modal("show");
      };

      // Exclui itens Comanda
      $scope.excluirItemComanda = function (idx) {
        var tempagOnline = 0;
        var itenComanda = tabelaComItens.fnGetData();
        for (var k = 0; k < itenComanda.length; k++) {
          if (itenComanda[k].PagamentoOnline == 1) {
            tempagOnline = 1;
          }
        }
        if (j == 2 && tempagOnline == 0) {
          toastr.warning(
            "Não é possivel alterar itens em uma comanda com mais de uma forma de pagamento"
          );
        } else {
          var registroTabela = tabelaComItens.fnGetData(idx);
          if (registroTabela.ExistePacote == "1") {
            toastr.error(
              "Para excluir este item, desassocie o pacote.",
              "Existe um pacote associado."
            );
          } else {
            swal(
              {
                title: "Confirmar exclusão:",
                text: "Deseja excluir o item " + registroTabela.Item,
                type: "input",
                inputPlaceholder: "Informe o Motivo da Exclusão",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Sim",
                cancelButtonText: "Não",
                closeOnConfirm: false,
              },
              function (inputValue) {
                if (inputValue === false) return false;
                if (inputValue === "") {
                  swal.showInputError("Especifique o motivo!");
                  return false;
                } else {
                  showLoader(true);
                  $.ajax({
                    dataType: "html",
                    url: "/pages/cadastros/removeItensComanda.php",
                    data: {
                      citcodigo: registroTabela.CodItem,
                      motivo: inputValue,
                    },
                    success: function (data) {
                      if (data == "0") {
                        toastr.success("Item Excluido com Sucesso.");
                        $scope.atualizaDadosItens();
                        if (location.hash == "#/comandasabertas") {
                          $rootScope.$emit("atualizaDadosComanda", {});
                        }

                        if (location.hash == "#/agenda") {
                          $rootScope.$emit("BuscaAgenda", {});
                        }
                        if (location.hash == "#/relGerencialEstoque") {
                          $rootScope.$emit("atulizaRelEstoque", {});
                        }
                        swal.close();
                      } else {
                        swal("Falha ao Excluir o Item.", data, "error");
                      }
                      showLoader(false);
                    },
                    error: function (result) {
                      swal("Falha na conexão.", "", "error");
                      showLoader(false);
                    },
                  });
                }
              }
            );
          }
        }
      };

      // Busca Combo Produto
      $scope.buscaProdutoCombo = function () {
        try {
          if ($("#comProduto").hasClass("select2-hidden-accessible")) {
            $("#comProduto").select2("destroy");
          }
        } catch (e) {
          console.log("");
        } finally {
          $("#formInsereItemComanda").each(function () {
            this.reset();
          });
          $("#comQtdeInsert").prop("disabled", false);

          if (
            $("#TprTipoComanda").html() == 1 ||
            $("#TprTipoComanda").html() == "" ||
            $("#treAgendaCodigo").html() == 1
          ) {
            $.ajax({
              dataType: "json",
              url: "/pages/cadastros/buscaProdutosv3.php",
              data: {
                procodigo: "",
                tipo: 2,
              },
              success: function (result) {
                var combo = "";
                combo +=
                  '<option data-iscombo="0" value="-1" selected="true"  data-valor="0" data-comissao="0">Selecione um Produto</option>';
                for (var i = 0; i < result.data.length; i++) {
                  if (result.data[i].Pro_Disp_Venda != 1) {
                    combo +=
                      '<option data-iscombo="0" data-imagem="' +
                      result.data[i].Pro_Figura +
                      '" value =' +
                      result.data[i].Pro_Codigo +
                      ' data-valor="' +
                      result.data[i].Pro_Valor +
                      '" data-comissao="' +
                      result.data[i].Pro_Comissao +
                      '" data-qtdminima="' +
                      result.data[i].StatusQtdMinima +
                      '" data-tuncodigo="' +
                      result.data[i].TUn_Codigo +
                      '" data-tunabreviatura="' +
                      result.data[i].TUn_Abreviatura +
                      '">' +
                      result.data[i].Pro_Descricao +
                      "</option>";
                  }
                }

                $.ajax({
                  dataType: "json",
                  url: "/pages/cadastros/buscaCombo.php",
                  async: false,
                  data: {
                    tipo: 3,
                  },
                  success: function (result) {
                    if (result.data.length > 0) {
                      combo =
                        '<optgroup label="Produto">' + combo + "</optgroup>";
                      combo += '<optgroup label="Combos">';
                      for (var j = 0; j < result.data.length; j++) {
                        combo +=
                          '<option data-iscombo="1" data-imagem="' +
                          result.data[j].CBo_Imagem +
                          '" data-comissao="0" value =' +
                          result.data[j].CBo_Codigo +
                          ' data-valor="' +
                          result.data[j].CBo_Valor +
                          '" data-tuncodigo="1" data-tunabreviatura="un" >' +
                          result.data[j].CBo_Descricao +
                          "</option>";
                      }
                      combo += "</optgroup>";
                    }
                  },
                });

                $("#comProduto").html(combo);
                $("#comProduto").select2({
                  templateResult: thumbProduto,
                });
              },
            });
          } else {
            $.ajax({
              dataType: "json",
              url: "/pages/cadastros/buscaProdutosProfissionais.php",
              data: {},
              success: function (result) {
                var combo = "";
                combo =
                  '<option value="-1" selected="true">Selecione um Produto</option>';

                for (var i = 0; i < result.data.length; i++) {
                  var comissao = 0.0;
                  if (result.data.geracomissaoprof == 1) {
                    comissao = result.data[i].comissao;
                  }

                  combo +=
                    '<option  data-iscombo="0" data-imagem="' +
                    result.data[i].figura +
                    '" value =' +
                    result.data[i].procodigo +
                    ' data-valor="' +
                    result.data[i].valor +
                    '" data-comissao="' +
                    comissao +
                    '" data-qtdminima="' +
                    result.data[i].qtdminima +
                    '" data-tuncodigo="' +
                    result.data[i].TUn_Codigo +
                    '"  data-tunabreviatura="' +
                    result.data[i].TUn_Abreviatura +
                    '">' +
                    result.data[i].descricao +
                    "</option>";
                }
                $("#comProduto").html(combo);
                $("#comProduto").select2({
                  templateResult: thumbProduto,
                });
              },
            });
          }

          $("#comQtdeInsert").attr("type", "number");
          $("#comQtdeInsert").attr("onkeyup", "");
        }
      };

      // Busca Select Serviço
      $scope.buscaServicoSelect = function () {
        $("#formInsereItemComandaSer").each(function () {
          this.reset();
        });
        $.ajax({
          dataType: "json",
          // url: '/pages/cadastros/buscaServicoSelect.php',
          url: "/pages/cadastros/buscaServicoSelectCombo.php",
          success: function (result) {
            var combo =
              '<option value =""  data-valor="" data-tipopreco="">Selecione um Serviço</option>';
            for (var i = 0; i < result.servicos.length; i++) {
              combo +=
                "<option value =" +
                result.servicos[i].Ser_Codigo +
                ' data-valor="' +
                result.servicos[i].Ser_Valor +
                '"  data-tipopreco="' +
                result.servicos[i].Ser_Tip_Preco +
                '" name="' +
                result.servicos[i].Ser_Duplo +
                '" data-tipoitem="' +
                result.servicos[i].TipoItem +
                '">' +
                result.servicos[i].Ser_Descricao +
                "</option>";
            }
            $("#comInsertServico").html(combo);
            $("#comInsertServico").select2({
              templateResult: thumbServico,
            });
          },
        });
      };

      $scope.buscaServicoSelect();

      // Busca Pessoa Conta
      $scope.buscaPessoaConta = function () {
        $scope.dadosClienteComanda = "";
        $("#pessoaConta").html("");
        $("#pessoaConta").hide();

        var pessoaConta = "";
        var pesCodigoCliente = $("#codCliente").val();

        if (pesCodigoCliente != "") {
          $("#pessoaConta").show();
          $.ajax({
            dataType: "json",
            url: localStorage.getItem("host"),
            data: {
              metodo: "buscaPessoaConta",
              id: $scope.idCliente,
              tipo: "5",
              pescodigocliente: pesCodigoCliente,
            },
            success: function (result) {
              if ($("#TprTipoComanda").html() == "3") {
                var tipocomandaconta = "profissional";
              } else {
                var tipocomandaconta = "cliente";
              }
              if (result.result[0] != undefined) {
                if (result.result[0].SaldoReal < 0.0) {
                  pessoaConta +=
                    "<label><span style='color:red'>Saldo na conta do " +
                    tipocomandaconta +
                    ": " +
                    result.result[0].PCo_Saldo +
                    "</label>&nbsp&nbsp<button ng-click='detalhesContaCliente()' class='btn btn-primary btn-xs'>Ver detalhes</button>&nbsp<button id='btnPagacomanda' class='btn btn-warning btn-xs' ng-click='pagaContaCliente(1," +
                    result.result[0].SaldoReal +
                    ")'>Pagar</button>";
                } else if (result.result[0].SaldoReal > 0.0) {
                  pessoaConta +=
                    "<label><span style='color:green'>Saldo na conta do " +
                    tipocomandaconta +
                    ": " +
                    result.result[0].PCo_Saldo +
                    "</label >&nbsp&nbsp<button ng-click='detalhesContaCliente()' class='btn btn-primary btn-xs'>Ver detalhes</button>&nbsp<button id='btnPagacomanda' class='btn btn-warning btn-xs' ng-click='pagaContaCliente(2," +
                    result.result[0].SaldoReal +
                    ")'>Pagar</button>";
                }
              }
              $("#pessoaConta").html(pessoaConta);
              $compile($("#pessoaConta"))($scope);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
          $("#btnPagacomanda").prop("disabled", false);
        } else {
          $("#pessoaConta").html("");
          $("#pessoaConta").hide();
        }
      };

      // Mostra info Cliente
      $scope.mostraInfoClientes = function (codcliente) {
        if ($_CONFIG.HASACESSOINFOCLI == 1) {
          var datafim = moment().locale("pt-br").format("L");
          var dataini = moment().add(-90, "days").locale("pt-br").format("L");
          $(".date.divDataIniAge").datepicker("update", dataini);
          $(".date.divDataFimAge").datepicker("update", datafim);
          $(".date.divDataIniCom").datepicker("update", dataini);
          $(".date.divDataFimCom").datepicker("update", datafim);
          $(".date.divDataIniPac").datepicker("update", dataini);
          $(".date.divDataFimPac").datepicker("update", datafim);
          $(".date.divDataIniPts").datepicker("update", dataini);
          $(".date.divDataFimPts").datepicker("update", datafim);

          if (codcliente == "") {
            toastr.error(
              "Para ver mais informações, associe um cliente.",
              "Sem Cliente Associado."
            );
          } else {
            showLoader(true);
            $.ajax({
              dataType: "json",
              url: "/pages/cadastros/buscaClientesInformacoes.php",
              data: {
                pescodigo: codcliente,
              },
              success: function (data) {
                $("#divBtnLGPD").hide();
                var valores = data.clientes[0];
                $("#cliNomeInfo").html(valores.Pes_Nome);
                $("#cliCpfInfo").html(valores.Paf_Cpf);
                $("#cliEmailInfo").html(valores.Paf_Email);
                $("#cliCelularInfo").html(valores.Paf_Celular);
                $("#cliTelefoneInfo").html(valores.Paf_Telefone);
                $("#cliLoginInfo").html(valores.Usu_Login);
                $("#cliSexoInfo").html(valores.Paf_Sexo);
                $("#cliDataNascimentoInfo").html(valores.PAF_Dat_Nascimento);
                $("#cliEnderecoInfo").html(valores.Paf_Endereco);
                $("#cliBairroInfo").html(valores.Paf_Bairro);
                $("#cliCidadeInfo").html(valores.Cid_Nome);
                $("#cliEstadoInfo").html(valores.Est_Sigla);
                $("#cliCepInfo").html(valores.Paf_CEP);
                $("#cliCodigoInfo").html(valores.Usu_Codigo);
                $("#cliObsInfo").html(valores.Paf_Observacao);
                $("#cliPesCodigoInfo").val(valores.Pes_Codigo);
                $("#cliDatCadastro").html(valores.Pes_Dat_Cadastro);

                $("#nomePrint").html(valores.Pes_Nome);
                $("#cpfPrint").html(valores.Paf_Cpf);
                $("#emailPrint").html(valores.Paf_Email);
                $("#celPrint").html(valores.Paf_Celular);
                $("#telPrint").html(valores.Paf_Telefone);
                $("#sexoPrint").html(valores.Paf_Sexo);
                $("#datanascPrint").html(valores.PAF_Dat_Nascimento);
                $("#endPrint").html(valores.Paf_Endereco);
                $("#bairroPrint").html(valores.Paf_Bairro);
                $("#cidPrint").html(valores.Cid_Nome);
                $("#estPrint").html(valores.Est_Sigla);
                $("#dataCadPrint").html(valores.Pes_Dat_Cadastro);

                var htmlbotao = `<button class="btn btn-primary btn-xs" id="btnEmailLGPD" ng-click="enviaEmailClienteLGPD(${valores.Pes_Codigo})"><i class="fa fa-envelope"></i> Termos de Uso</button><a class="btn btn-info btn-xs" target="_blank" href="https://docs.appbarber.com.br/termosdeuso-web/">Ver Termo</a>`;
                if (valores.Paf_Email != "" && valores.PAF_LGPD != 1) {
                  $("#divBtnLGPD").html(htmlbotao);
                  $("#divBtnLGPD").show();

                  $compile($("#divBtnLGPD"))($scope);
                } else {
                  $("#divBtnLGPD").html("");
                  $("#divBtnLGPD").hide();
                }

                if (valores.Paf_Imagem != "") {
                  $("#cliImagemInfo").attr("src", valores.Paf_Imagem);
                  $("#imgPrint").attr("src", valores.Paf_Imagem);
                } else {
                  $("#cliImagemInfo").attr("src", "/img/nopicture.png");
                  $("#imgPrint").attr("src", "/img/nopicture.png");
                }

                $App.formatDateSort();
                $scope.buscaCliAgendamento(
                  $("#cliDatInicioAge").val(),
                  $("#cliDatFimAge").val()
                );
                $scope.buscaCliComanda(
                  $("#cliDatInicioCom").val(),
                  $("#cliDatFimCom").val()
                );
                $scope.buscaCliPacote(
                  $("#cliDatInicioPac").val(),
                  $("#cliDatFimPac").val()
                );
                $("#servicoPront").val("");
                $("#profPront").val("");
                $("#cliDatInicioPron").val("");
                $("#cliDatFimPron").val("");
                $scope.buscaProntuarioCliente(codcliente);
                $scope.buscaCliPonto(codcliente);
                $scope.buscaPessoaContaInfoCli(codcliente);
                if (valores.StatusPessoa == "*") {
                  $(".btnAlteracaoCliente").hide();
                } else {
                  $(".btnAlteracaoCliente").show();
                }
                $("#infoCliente-modal").modal();
                showLoader(false);
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
                showLoader(false);
              },
            });

            $.ajax({
              dataType: "html",
              url: "/pages/cadastros/buscaClienteInfo.php",
              method: "POST",
              data: {
                pesCodigo: codcliente,
                tipo: 1,
                dataIni: "",
                dataFim: "",
              },
              dataType: "json",
              success: function (data) {
                $("#serDescricao").html(data.data[0].ServicoDescricao);
                $("#serTotal").html(data.data[0].TotalServico);
                $("#proNome").html(data.data[0].ProdutoDescricao);
                $("#porTotal").html(data.data[0].TotalProduto);
                $("#totalDias").html(data.data[0].DiasSemVir);
                $("#totalGasto").html(data.data[0].GastosClientes);
                if (data.data[0].UltimoAcessoCliente != "") {
                  $("#ultimoAcessoCliente").html(
                    data.data[0].UltimoAcessoCliente
                  );
                } else {
                  $("#ultimoAcessoCliente").html(
                    "Não possui usuário,<br> ou nunca acessou"
                  );
                }
              },
            });

            $("#CliAgeInicio").html("");
            $("#CliLastServico").html("");
            $("#CliLastProf").html("");

            $.ajax({
              dataType: "html",
              url: "/pages/cadastros/buscaClienteInfo.php",
              method: "POST",
              data: {
                pesCodigo: codcliente,
                tipo: 5,
                dataIni: "",
                dataFim: "",
              },
              dataType: "json",
              success: function (data) {
                $("#CliAgeInicio").html(data.data[0].Age_Dat_Inicio);
                $("#CliLastServico").html(data.data[0].Ser_Descricao);
                $("#CliLastProf").html(data.data[0].Pes_Nome);
              },
            });

            // card dos pontos
            $.ajax({
              dataType: "html",
              url: "/pages/relatorios/buscaProgramaFidelidade.php",
              method: "POST",
              data: {
                selCliente: codcliente,
                selTipo: 1,
              },
              dataType: "json",
              success: function (data) {
                if (data.data.length == 1) {
                  $("#pontosClientes").html(data.data[0].TotalPontos);
                } else {
                  $("#pontosClientes").html(0);
                }
              },
            });
            $("#pesCodigoTokenInfo").val(codcliente);
          }

          $.ajax({
            dataType: "json",
            url: "/pages/cadastros/buscaServicoSelect.php",
            success: function (result) {
              var combo = "";
              combo += "<option value=''>Nenhum</option>";
              for (var i = 0; i < result.servicos.length; i++) {
                combo +=
                  "<option value =" +
                  result.servicos[i].Ser_Codigo +
                  ' data-valor="' +
                  result.servicos[i].Ser_Valor +
                  '" name="' +
                  result.servicos[i].Ser_Duplo +
                  '">' +
                  result.servicos[i].Ser_Descricao +
                  "</option>";
              }
              $("#servicoPront").html(combo);
            },
          });
          $.ajax({
            dataType: "json",
            url: "pages/cadastros/buscaProfissionalSelect.php",
            success: function (data) {
              var profissional = "";
              profissional +=
                '<option  value="">' +
                $_CONFIG.language.profissional +
                "</option>";
              for (var i = 0; i < data.profissionais.length; i++) {
                var codigo = data.profissionais[i].Pes_Codigo;
                var nome = data.profissionais[i].Pes_Nome;
                profissional +=
                  '<option  value="' + codigo + '">' + nome + "</option>";
              }
              $("#profPront").html(profissional);
            },
          });
        } else {
          $("#infoCliente-modal").modal();
        }
      };

      $scope.detalhesContaCliente = function () {
        $App.formatDateSort();
        $("#contaClienteDeatalhes-modal").modal();
        if (typeof tabela != "undefined") {
          tabela.api().destroy();
        }
        var codcliente = $("#codCliente").val();
        // if (location.hash == "#/pacotesVenda") {
        // 	codcliente =  $("#venCliente").val();
        // }
        tabela = $("#tbContaClienteDetalhes").dataTable({
          ajax: {
            url: "/pages/cadastros/buscaContaClientes.php",
            method: "POST",
            data: function (d) {
              d.pescodigo = codcliente;
            },
          },
          fnRowCallback: function (nRow, aData) {
            var id = aData.PCo_Tipo;
            var $nRow = $(nRow);
            if (id == "D") {
              $nRow
                .map(function () {
                  return $(this).css({
                    color: "#F44336",
                  });
                })
                .get();
            } else {
              $nRow
                .map(function () {
                  return $(this).css({
                    color: "#1B5E20",
                  });
                })
                .get();
            }

            return nRow;
          },
          dom: "Bfrtip",
          buttons: [
            {
              extend: "excelHtml5",
              text: "Excel",
              exportOptions: {
                columns: ":visible",
              },
              footer: "true",
            },
            {
              extend: "pdfHtml5",
              title: "sistema - Conta Cliente",
              orientation: "landscape",
              pageSize: "LEGAL",
              exportOptions: {
                columns: ":visible",
              },
            },
          ],

          stateSaveCallback: function (settings, data) {
            data.order = [];
            localStorage.setItem(
              "DataTables_" + settings.sInstance,
              JSON.stringify(data)
            );
          },
          stateLoadCallback: function (settings) {
            return JSON.parse(
              localStorage.getItem("DataTables_" + settings.sInstance)
            );
          },
          stateSave: true,

          initComplete: function () {
            var vlrTotal = this.fnGetData(this.fnGetNodes().length - 1);

            $("#lblSaldo").show();
            $("#btnCredito").show();
            $("#btnDebito").show();

            if (vlrTotal == null) {
              $("#valorTotal").html("0,00");
            } else {
              $("#valorTotal").html(vlrTotal.Saldo);
            }
            resizeContent();
          },
          columnDefs: [
            {
              targets: [0, 1, 7, 8, 9],
              visible: false,
              searchable: false,
            },
          ],
          language: {
            url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
          },
          columns: [
            {
              data: "DT_RowId",
            },
            {
              data: "PCo_Codigo",
            },
            {
              data: "PCo_Descricao",
            },
            {
              data: "PCo_Dat_Lancamento",
              type: "moment-DD/MM/YYYY",
            },
            {
              data: "PCo_Valor",
            },
            {
              data: "PCo_TipoMov",
            },
            {
              data: "Saldo",
            },
            {
              data: "PCo_Tipo",
            },
            {
              data: "PCo_Vlr_Real",
            },
            {
              data: "Com_Codigo",
            },
          ],
        });
      };

      // Calcula Parcela
      $scope.calculaParcelas = function (valor) {
        valor = valor.replace(",", ".");
        valor = valor.replace($_CONFIG.MOEDA, "");
        var html = "";
        if (valor != "0.00") {
          for (var i = 2; i <= 12; i++) {
            var valorparcela = valor / i;
            var valorparcelatext = parseFloat(valorparcela)
              .formatMoney()
              .replace(".", ",");
            var option =
              "<option value='" +
              i +
              "'>" +
              i +
              "x de " +
              $_CONFIG.MOEDA +
              valorparcelatext +
              "</option>";
            html += option;
          }
        } else {
          var option = "<option value=''>" + $_CONFIG.MOEDA + "0,00</option>";
          html += option;
        }
        $("#selVezesParcela").html(html);
      };

      // Busca Itens Comanda
      $scope.buscaItensComanda = function (codigo) {
        $("#pessoaDetalhesAssinaturas").html("");
        $("#listServicoComanda").html("");
        $("#listServicoComandaEdt").html("");
        if (typeof tabelaComItens != "undefined") {
          tabelaComItens.api().destroy();
        }
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaPessoa.php",
          method: "POST",
          data: {
            tipo: 2,
          },
          success: function (result) {
            if (result.buscaPessoa.length > 0) {
              var valores = result.buscaPessoa[0];
              var html = "";
              $("#nomeSalao").html(valores.Nome);
              html =
                valores.Endereco +
                ", " +
                valores.Numero +
                " - " +
                valores.Bairro +
                " | " +
                valores.Cid_Nome +
                "/" +
                valores.Est_Sigla +
                "<br>";
              html += "Telefone: " + valores.Telefone + "<br>";
              html += "Email: " + valores.Email + "<br>";
              html += valores.CNPJ;
              $("#infoSalao").html(html);
              $("#enderecoEstabelecimento").show();
            } else {
              $("#enderecoEstabelecimento").hide();
              $("#nomeSalao").html("");
              $("#infoSalao").html("");
            }
          },
        });

        tabelaComItens = $("#tbComandaItens").dataTable({
          ajax: "/pages/cadastros/buscaItensComanda.php?codigo=" + codigo,
          language: {
            url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
          },
          bPaginate: false,
          bLengthChange: false,
          bFilter: false,
          bSort: false,
          bInfo: false,
          bAutoWidth: false,
          rowCallback: function (nRow, aData, index) {
            if (aData.TipoItem == 1) {
              $("#listServicoComanda").append(
                `<option value="${aData.AgeCodigo}">${aData.Item} - Profissional: ${aData.Profissional}</option>`
              );
              $("#listServicoComandaEdt").append(
                `<option value="${aData.AgeCodigo}">${aData.Item} - Profissional: ${aData.Profissional}</option>`
              );
            }
            $.ajax({
              url: "/pages/cadastros/buscaPacotesPessoaCombo.php",
              type: "POST",
              dataType: "json",
              data: {
                pescodigo: $("#codCliente").val(),
                codigo: aData.CodSerPro,
                tipo: aData.TipoItem,
              },
              success: function (data) {
                if (data.result.length > 0) {
                  for (var i = 0; i < nRow.children.length; i++) {
                    if (
                      nRow.children[i].className == " pacoteclass" &&
                      nRow.children[i].className != "sorting_1" &&
                      aData.ExistePacote != "1"
                    ) {
                      if (
                        nRow.children[i].children[0].children[1].className !=
                        "notpacote"
                      ) {
                        nRow.children[i].children[0].children[1].className =
                          "fa fa-exclamation";
                        nRow.children[i].children[0].children[1].style.display =
                          "inline";
                      }
                    }
                  }
                } else {
                }
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
              },
            });
            return nRow;
          },
          initComplete: function () {
            var vlrTotal = this.fnGetData(0);

            if (vlrTotal != null) {
              $("#valorTotalComanda").html(
                $_CONFIG.MOEDA + vlrTotal.ValorTotal
              );
              $("#comValorTotal").html($_CONFIG.MOEDA + vlrTotal.ValorTotal);
              $("#valorPagamento0").val(vlrTotal.ValorTotal);
              $("#comValorPag").val(vlrTotal.ValorTotal);
              $("#comCodSerPro").val(vlrTotal.CodSerPro);
              $scope.typeCadComanda = vlrTotal.TprCadastro;
              $("#comValorDesconto").val("");
              $("#btnNovoTipo").show();

              // CLIENTE_BUSCA_INFO
              $.ajax({
                dataType: "html",
                url: "/pages/cadastros/CLIENTE_Busca_Info.php",
                method: "POST",
                data: {
                  type: 1,
                  person_code: vlrTotal.ClienteCodigo,
                  client_code: "",
                },
                dataType: "json",
                success: function (data) {
                  if (data.data.error == false) {
                    $scope.dadosClienteComanda = data.data.client[0];
                    if ($scope.typeCadComanda == 1 || $_CONFIG.COBRANCA_CLIENTE == "1") {
                      if (data.data.client[0].CIE_ID_Externo != "") {
                        if (data.data.client[0].CIE_Cobranca == 1) {
                          $("#divCardButton").show();
                          $("#divPixButton").removeClass("col-md-offset-3");
                        } else {
                          $("#divCardButton").hide();
                          $("#divPixButton").addClass("col-md-offset-3");
                        }
                      } else {
                        $("#divCardButton").hide();
                        $("#divPixButton").addClass("col-md-offset-3");
                      }
                    } else {
                      $("#divCardButton").hide();
                      $("#divPixButton").addClass("col-md-offset-3");
                    }
                    if (data.data.client[0].Plano != "") {
                      var prefixo = "";

                      if (data.data.client[0].TipoAssinautra != "") {
                        prefixo = '<span class="badge bg-blue">R</span>';
                      } else {
                        prefixo = '<span class="badge bg-default">C</span>';
                      }
                      var detalhesAssinatura =
                        prefixo +
                        " " +
                        data.data.client[0].Plano +
                        " - " +
                        data.data.client[0].StatusAssinatura;

                      $("#pessoaDetalhesAssinaturas").html(detalhesAssinatura);
                    }
                  } else {
                    $("#divCardButton").hide();
                    $("#divPixButton").addClass("col-md-offset-3");
                  }
                },
              });

              $scope.calculaParcelas(vlrTotal.ValorTotal);

              var itensComandaLoop = this.fnGetData();
              var valorPagamentoOnline = 0.0;
              var itensOnline = 0;

              var valorPagamentoComanda = 0;
              var completePayment = 0;
              var isPix = 0;
              var isPinPad = 0;
              var isPinPadPix = 0;
              for (
                var loopItem = 0;
                loopItem < itensComandaLoop.length;
                loopItem++
              ) {
                if (itensComandaLoop[loopItem].PagamentoOnline == 1) {
                  valorPagamentoOnline =
                    valorPagamentoOnline +
                    parseFloat(
                      itensComandaLoop[loopItem].ValorUn.replace(",", ".")
                    );
                  itensOnline++;
                }
                valorPagamentoComanda = itensComandaLoop[loopItem].CPoValor;
                completePayment = itensComandaLoop[loopItem].CPoPagamentoTotal;
                isPix = itensComandaLoop[loopItem].isPix;
                isPinPad = itensComandaLoop[loopItem].isPinPad;
                isPinPadPix = itensComandaLoop[loopItem].isPinPadPix;
              }

              if (valorPagamentoOnline != 0) {
                if ($_CONFIG.COBRANCA_CLIENTE == "1") {
                  atualizaBotaoCobrarClienteComanda(vlrTotal.ValorTotal);
                } else {
                  $("#btnCobrarCliente").hide();
                }
                for (
                  var i = 0;
                  i < $("#tipoPagamento0").get(0).options.length;
                  i++
                ) {
                  if (isPinPad != 1) {
                    if (isPinPadPix != 1) {
                      if (
                        $("#tipoPagamento0").get(0).options[i].dataset
                          .pagamentoonline == "1" &&
                        $("#tipoPagamento0").get(0).options[i].dataset
                          .pagamentoonlineparcelado == ""
                      ) {
                        $("#tipoPagamento0").val(
                          $("#tipoPagamento0").get(0).options[i].value
                        );
                        $("#tipoPagamento0").prop("disabled", true);
                        $("#valorPagamento0").val(valorPagamentoOnline);
                        if (completePayment == 0) {
                          $("#valorPagamento0").val(valorPagamentoComanda);
                        }
                        $("#valorPagamento0").prop("disabled", true);
                        $("#btnNovoTipo").hide();
                      }
                    } else {
                      if (
                        $("#tipoPagamento0").get(0).options[i].dataset
                          .integracao == "3" &&
                        $("#tipoPagamento0").get(0).options[i].dataset
                          .pagamentoonline == "1" &&
                        $("#tipoPagamento0").get(0).options[i].dataset
                          .pagamentoonlineparcelado == "" &&
                        $("#tipoPagamento0").get(0).options[i].text ==
                          "Pix - PINPAD"
                      ) {
                        $("#tipoPagamento0").val(
                          $("#tipoPagamento0").get(0).options[i].value
                        );
                        $("#tipoPagamento0").prop("disabled", true);
                        $("#valorPagamento0").val(valorPagamentoOnline);
                        if (completePayment == 0) {
                          $("#valorPagamento0").val(valorPagamentoComanda);
                        }
                        $("#valorPagamento0").prop("disabled", true);
                        $("#btnNovoTipo").hide();
                      }
                    }
                  } else {
                    if (
                      $("#tipoPagamento0").get(0).options[i].dataset
                        .integracao == "3" &&
                      $("#tipoPagamento0").get(0).options[i].dataset
                        .pagamentoonline == "1" &&
                      $("#tipoPagamento0").get(0).options[i].dataset
                        .pagamentoonlineparcelado == "" &&
                      $("#tipoPagamento0").get(0).options[0].text ==
                        "Crédito - PINPAD"
                    ) {
                      $("#tipoPagamento0").val(
                        $("#tipoPagamento0").get(0).options[i].value
                      );
                      $("#tipoPagamento0").prop("disabled", true);
                      $("#valorPagamento0").val(valorPagamentoOnline);
                      if (completePayment == 0) {
                        $("#valorPagamento0").val(valorPagamentoComanda);
                      }
                      $("#valorPagamento0").prop("disabled", true);
                      $("#btnNovoTipo").hide();
                    }
                  }
                }

                if (
                  (j == 1 && this.fnGetData().length > itensOnline) ||
                  completePayment == 0
                ) {
                  $("#btnNovoTipo").click();
                  $("#btnRemoveTipo1").remove();
                  valor =
                    parseFloat(vlrTotal.ValorTotal.replace(",", ".")) -
                    parseFloat(valorPagamentoOnline);
                  if (completePayment == 0) {
                    valor =
                      parseFloat(vlrTotal.ValorTotal.replace(",", ".")) -
                      parseFloat(valorPagamentoComanda);
                  }
                  $("#valorPagamento1").val(valor);
                }

                $.ajax({
                  dataType: "json",
                  url: "/pages/cadastros/buscaTipoBandeira.php",
                  method: "POST",
                  data: {
                    tipopagamento: $("#tipoPagamento0 option:selected").val(),
                  },
                  success: function (result) {
                    var html = "";
                    for (var i = 0; i < result.data.length; i++) {
                      if (isPix == 1) {
                        if (result.data[i].TBa_Tipo_Bandeira == "2") {
                          html +=
                            "<option value =" +
                            result.data[i].TBa_Codigo +
                            " >" +
                            result.data[i].TBa_Descricao +
                            "</option>";
                        }
                      } else if (isPinPad == 1) {
                        if (result.data[i].TBa_Tipo_Bandeira == "4") {
                          html +=
                            "<option value =" +
                            result.data[i].TBa_Codigo +
                            " >" +
                            result.data[i].TBa_Descricao +
                            "</option>";
                        }
                      } else {
                        if (result.data[i].TBa_Tipo_Bandeira != "2") {
                          html +=
                            "<option value =" +
                            result.data[i].TBa_Codigo +
                            " >" +
                            result.data[i].TBa_Descricao +
                            "</option>";
                        }
                      }
                    }
                    $("#divBandeiraPag0").html(html);
                    $compile($("#divBandeiraPag0"))($scope);
                  },
                });

                $("#divBandeiraPag0").prop("disabled", true);
              } else {
                $("#tipoPagamento0").prop("disabled", false);
                $("#valorPagamento0").prop("disabled", false);
                atualizaBotaoCobrarClienteComanda(vlrTotal.ValorTotal);
              }
            } else {
              $("#valorTotalComanda").html($_CONFIG.MOEDA + "0.00");
              $("#comValorTotal").html("0.00");
              $("#valorPagamento0").val("0.00");
              $("#comValorPag").val("0.00");
              $scope.calculaParcelas("0,00");
            }

            $('[data-toggle="popover"]').popover({
              container: "body",
            });
            $compile($("#tbComandaItens"))($scope);
            $("#tbComandaItens_paginate").click(function () {
              $compile($("#tbComandaItens"))($scope);
            });
            $("#tbComandaItens_filter").change(function () {
              $compile($("#tbComandaItens"))($scope);
            });
            $("#tbComandaItens_length").change(function () {
              $compile($("#tbComandaItens"))($scope);
            });
          },

          stateSaveCallback: function (settings, data) {
            data.order = [];
            localStorage.setItem(
              "DataTables_" + settings.sInstance,
              JSON.stringify(data)
            );
          },
          stateLoadCallback: function (settings) {
            return JSON.parse(
              localStorage.getItem("DataTables_" + settings.sInstance)
            );
          },
          stateSave: true,

          columnDefs: [
            {
              targets: [
                0, 1, 2, 3, 5, 6, 9, 11, 12, 15, 16, 17, 18, 19, 21, 22,
              ],
              visible: false,
              searchable: false,
            },
          ],
          columns: [
            /*0*/
            {
              data: "Codigo",
            },
            /*1*/
            {
