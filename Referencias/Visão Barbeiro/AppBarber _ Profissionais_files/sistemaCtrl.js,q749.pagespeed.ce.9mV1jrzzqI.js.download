            return JSON.parse(
              localStorage.getItem("DataTables_" + settings.sInstance)
            );
          },
          stateSave: true,

          columns: [
            {
              data: "Com_Codigo",
            },
            {
              data: "Status",
            },
            {
              data: "Usu_Nome",
            },
            {
              data: "Com_Vlr_Total",
            },
            {
              data: "Com_Vlr_Pagamento",
            },
            {
              data: "Com_Observacao",
            },
            {
              class: "abrecomanda-control",
              orderable: false,
              data: null,
              defaultContent:
                '<button class="btn btn-success btn-xs ">Ver Comanda</button>',
            },
          ],
          ordering: false,
          language: {
            url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
          },
        });

        $("#tabelaClienteComanda tbody").on(
          "click",
          "td.abrecomanda-control",
          function () {
            var tr = $(this).closest("tr");
            var row = tabelaCliComanda.row(tr);
            var data = row.data();
            $scope.buscaItensComandaVer(data.Com_Codigo);
            $("#nomeClienteComandaVer").html(data.Pes_Nome);
            $("#idComandaVer").html(data.Com_Codigo);
            if (data.CCE_Cod_Externo != "") {
              $("#idComandaExternoVer").html("N˚: " + data.CCE_Cod_Externo);
              $("#idComandaExternoVer").show();
            } else {
              $("#idComandaExternoVer").html("");
              $("#idComandaExternoVer").hide();
            }
            $("#dataComandaVer").html(data.Com_Dat_Cadastro);
            $("#vercomanda-modal").modal("show");
          }
        );
      };

