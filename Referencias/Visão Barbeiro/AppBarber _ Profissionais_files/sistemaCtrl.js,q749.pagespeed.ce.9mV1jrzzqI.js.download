      //Altera itens Comanda
      $("#formAlteraItemComanda").submit(function (event) {
        event.preventDefault();
        $("#comToken").prop("disabled", false);
        if ($("#divTokenCom").hasClass("has-error")) {
          $("#comCortesia").prop("disabled", false);
          toastr.error("Token Inválido.");
        } else if (
          $("#comToken").val() != "" &&
          !$("#divTokenCom").hasClass("has-success")
        ) {
          toastr.error("Token não validado, tentando novamente...");
          $("#comToken").keyup();
        } else if (
          $("#tipoDesconto").val() == "-1" &&
          $("#comDesconto").val() != ""
        ) {
          toastr.error("Insira o tipo de desconto.");
        } else {
          if ($("#comToken").val().length < 5) {
            $("#comToken").val("");
          }

          $("#comValor").attr("disabled", false);
          $("#comQtde").attr("disabled", false);
          $("#comComissao").prop("disabled", false);
          $("#comToken").prop("disabled", false);
          $("#comCupom").prop("disabled", false);
          $("#comParaUso").prop("disabled", false);
          $("#comCortesia").prop("disabled", false);

          $("#comValorHd").prop("disabled", false);

          formAlteraItemComanda = $(this);
          var needSenha = 0;
          dataInsere = new FormData(this);
          dataInsere.append(
            "comissao",
            $("#comComissao").maskMoney("unmasked")[0].toFixed(2)
          );
          var valorAgendamento = "";

          if ($("#comParaUso").is(":checked")) {
            valorAgendamento = $("#listServicoComandaEdt").val();
          }

          if (
            $("#comToken").val() != "" ||
            $("#comValorHd").val() == $("#comValorHdOLD").val() ||
            $("#comParaUso").is(":checked") ||
            $("#comCortesia").is(":checked")
          ) {
            showLoader(true);
            needSenha = 0;
            dataInsere.append("needSenha", needSenha);
            dataInsere.append("agendamentoProduto", valorAgendamento);

            $.ajax({
              type: "POST",
              url: "/pages/cadastros/alteraItensComandav4.php",
              data: dataInsere,
              dataType: "json",
              processData: false,
              contentType: false,
              success: function (result) {
                if (result.result[0].erro == "0") {
                  $scope.atualizaDadosItens();
                  if (location.hash == "#/comandasabertas") {
                    $rootScope.$emit("atualizaDadosComanda", {});
                  }
                  toastr.success(result.result[0].resultado);

                  $("#comandaEdit-modal").modal("hide");
                  $("#comanda-modal").modal("show");

                  formAlteraItemComanda.each(function () {
                    this.reset();
                  });

                  limpaToken(
                    $("#divTokenCom"),
                    $("#tokenCom"),
                    $("#msgTokenCom")
                  );
                } else {
                  toastr.error(result.result[0].resultado);
                }
                showLoader(false);
                $("#comValor").attr("disabled", true);
                $("#btnValidarToken").attr("disabled", false);
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
                showLoader(false);
                $("#comValor").attr("disabled", true);
              },
            });
            return true;
          } else {
            needSenha = 1;
            if ($("#senhaDesconto").html() == "1") {
              var statesdemo = {
                state0: {
                  title: "Insira a senha ",
                  html: '<input class="form-control" type="password" name="password" id="password" value=""></label>',
                  buttons: {
                    Ok: 1,
                  },
                  submit: function (e, v, m, f) {
                    e.preventDefault();
                    if (f.password != null) {
                      showLoader(true);
                      dataInsere.append("senhaitens", MD5(f.password));
                      dataInsere.append("needSenha", needSenha);
                      dataInsere.append("agendamentoProduto", valorAgendamento);
                      $.ajax({
                        type: "POST",
                        url: "/pages/cadastros/alteraItensComandav4.php",
                        data: dataInsere,
                        dataType: "json",
                        processData: false,
                        contentType: false,
                        success: function (result) {
                          if (result.result[0].erro == "0") {
                            $scope.atualizaDadosItens();
                            if (location.hash == "#/comandasabertas") {
                              $rootScope.$emit("atualizaDadosComanda", {});
                            }
                            toastr.success(result.result[0].resultado);

                            $("#comandaEdit-modal").modal("hide");
                            $("#comanda-modal").modal("show");

                            formAlteraItemComanda.each(function () {
                              this.reset();
                            });

                            limpaToken(
                              $("#divTokenCom"),
                              $("#tokenCom"),
                              $("#msgTokenCom")
                            );
                          } else {
                            toastr.error(result.result[0].resultado);
                          }
                          showLoader(false);
                          $("#comValor").attr("disabled", true);
                        },
                        error: function (result) {
                          toastr.error("Falha na conexão.");
                          showLoader(false);
                          $("#comValor").attr("disabled", true);
                        },
                      });
                      $.prompt.close();
                      return true;
                    }
                  },
                },
              };
              $.prompt(statesdemo);
            } else {
              needSenha = 0;
              showLoader(true);
              dataInsere.append("needSenha", needSenha);
              dataInsere.append("agendamentoProduto", valorAgendamento);
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/alteraItensComandav4.php",
                data: dataInsere,
                dataType: "json",
                processData: false,
                contentType: false,
                success: function (result) {
                  if (result.result[0].erro == "0") {
                    $scope.atualizaDadosItens();
                    if (location.hash == "#/comandasabertas") {
                      $rootScope.$emit("atualizaDadosComanda", {});
                    }
                    toastr.success(result.result[0].resultado);

                    $("#comandaEdit-modal").modal("hide");
                    $("#comanda-modal").modal("show");

                    formAlteraItemComanda.each(function () {
                      this.reset();
                    });

                    limpaToken(
                      $("#divTokenCom"),
                      $("#tokenCom"),
                      $("#msgTokenCom")
                    );
                  } else {
                    toastr.error(result.result[0].resultado);
                  }
                  showLoader(false);
                  $("#comValor").attr("disabled", true);
                },
                error: function (result) {
                  toastr.error("Falha na conexão.");
                  showLoader(false);
                  $("#comValor").attr("disabled", true);
                },
              });
              return true;
            }
          }
        }
      });

      //Altera itens Pacote
      $("#formAlteraItemPacote").submit(function (event) {
        event.preventDefault();
        showLoader(true);

        $.ajax({
          type: "POST",
          url: "/pages/cadastros/inserePessoaPacoteDetalhesv2.php",
          data: {
            ppacodigo: $("#pacotesComandaCombo").val(),
            itemcodigo: $("#pacotesComandaCombo option:selected").get(0).dataset
              .codigo,
            pescodigo: $("#codCliente").val(),
            citcodigo: $("#comCodItemPac").val(),
          },
          dataType: "json",
          success: function (result) {
            if (result.data[0].erro == "0") {
              $scope.atualizaDadosItens();
              if (location.hash == "#/comandasabertas") {
                $rootScope.$emit("atualizaDadosComanda", {});
              }
              toastr.success(result.data[0].resultado);

              $("#comandaPacote-modal").modal("hide");
              $("#comanda-modal").modal("show");
            } else {
              toastr.error(result.data[0].resultado);
            }
            showLoader(false);
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });

        return true;
      });

      $scope.insereAgendamentoClube = function () {
        if ($("#IsMultiUnidade").val() == 0) {
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/insereAgendamentoClube.php",
            data: {
              citcodigo: $("#CitCodigoAssocia").val(),
              apfcodigo: $("#APFCodigoAssocia").val(),
              asscodigo: $("#AssCodigoAssocia").val(),
            },
            dataType: "json",
            success: function (result) {
              if (result.data[0].erro == "0") {
                $scope.atualizaDadosItens();
                toastr.success(result.data[0].resultado);

                $("#comandaAssinatura-modal").modal("hide");
                $("#comanda-modal").modal("show");
              } else {
                toastr.error(result.data[0].resultado);
              }
              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
        } else {
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/AGENDAMENTO_PLANO_ASSINATURA_Vincula.php",
            data: {
              invoice_item_code: $("#CitCodigoAssocia").val(),
              client_subscription_finantial_code: $("#APFCodigoAssocia").val(),
            },
            dataType: "json",
            success: function (data) {
              if (data.data.error == false) {
                if (data.data.subscription_plan[0].error == 0) {
                  $scope.atualizaDadosItens();
                  toastr.success(data.data.subscription_plan[0].result);

                  $("#comandaAssinatura-modal").modal("hide");
                  $("#comanda-modal").modal("show");
                } else {
                  toastr.error(data.data.subscription_plan.result);
                }
              } else {
                toastr.error(data.data.message);
              }
              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
        }
      };

      $("#cliEmail2").keyup(function () {
        $("#cliLoginId2").val($("#cliEmail2").val());
      });

      //Insere cliente (Comanda)
      $("#formCadastroClienteComanda").submit(function (event) {
        if ($("#cliLoginId2").val() != "" && $("#cliEmail2").val() == "") {
          toastr.error(
            "Por favor, insira um e-mail para o cliente receber os dados de acesso.",
            "Insira um E-mail"
          );
          return true;
        } else {
          event.preventDefault();
          formCadastro = $(this);
          showLoader(true);
          dataInsere = new FormData(this);
          dataInsere.append("apelido", $("#cliApelido").html());
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/insereClientes.php",
            data: dataInsere,
            dataType: "json",
            processData: false,
            contentType: false,
            success: function (result) {
              if (result.insereCliente[0].erro == "0") {
                $scope.cliLogin = "";
                toastr.success(result.insereCliente[0].resultado);
                $("#cadastrarClienteComanda-modal").modal("hide");
                pescodigo = result.insereCliente[0].pescodigo;
                $rootScope.$broadcast("AgendabuscaClientes", {
                  any: pescodigo,
                });

                if (hasManyClients) {
                  var codigo = result.insereCliente[0].pescodigo;
                  var nome = $("#cliNomeComanda").val();
                  var celular = $("#cliCelularComanda").val();
                  if (celular != "") {
                    celular = " - " + $("#cliCelularComanda").val();
                  }
                  $("#comCliente").append(
                    '<option data-usucodigo="" data-imagem="" value="' +
                      codigo +
                      '">' +
                      nome +
                      "" +
                      celular +
                      "</option>"
                  );
                  $("#cliente_menu").append(
                    '<option data-usucodigo="" data-imagem="" value="' +
                      codigo +
                      '">' +
                      nome +
                      "" +
                      celular +
                      "</option>"
                  );
                  $("#cliente_menu2").append(
                    '<option data-usucodigo="" data-imagem="" value="' +
                      codigo +
                      '">' +
                      nome +
                      "" +
                      celular +
                      "</option>"
                  );
                  $("#comCliente").val(codigo).trigger("change");
                  $("#cliente_menu").val(codigo).trigger("change");
                  $("#cliente_menu2").val(codigo).trigger("change");
                  if (location.hash == "#/filaDeEspera") {
                    $rootScope.$emit("buscaclientefila", {});

                    setTimeout(function () {
                      $("#pesCodigoCliente").val(codigo).trigger("change");
                    }, 2000);
                  }
                  if (location.hash == "#/assinantes") {
                    $rootScope.$emit("buscaClienteAssinatura", {});
                  }
                } else {
                  $scope.selecionaNovoCliente(
                    result.insereCliente[0].pescodigo
                  );
                  if (location.hash == "#/filaDeEspera") {
                    $rootScope.$emit("buscaclientefila", {});

                    setTimeout(function () {
                      $("#pesCodigoCliente")
                        .val(result.insereCliente[0].pescodigo)
                        .trigger("change");
                    }, 2000);
                  }
                  if (location.hash == "#/assinantes") {
                    $rootScope.$emit("buscaClienteAssinatura", {});
                    setTimeout(() => {
                      $("#AssCliente")
                        .val(result.insereCliente[0].pescodigo)
                        .change();
                      $("#AssClienteVinculo")
                        .val(result.insereCliente[0].pescodigo)
                        .change();
                    }, 2000);
                  }
                }

                formCadastro.each(function () {
                  this.reset();
                });
                $("#cliLoginId2").val("");
              } else {
                toastr.error(result.insereCliente[0].resultado);
              }

              showLoader(false);
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
              showLoader(false);
            },
          });
          return true;
        }
      });

      // Insere prontuario
      $("#formInsereDetalhesAgendamento").submit(function (event) {
        event.preventDefault();
        showLoader(true);
        formInsereDet = $(this);
        var dados = new FormData(this);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/insereAgendamentoProntuario.php",
          data: dados,
          dataType: "json",
          processData: false,
          contentType: false,
          success: function (result) {
            if (result.result[0].erro == "0") {
              toastr.success(result.result[0].resultado);
              formInsereDet.each(function () {
                this.reset();
              });
              $("#insereProntuario-modal").modal("hide");
              $scope.atualizatabelaProntuario();
            } else {
              toastr.error(result.result[0].resultado);
            }
            showLoader(false);
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });
        return true;
      });

      //insere imagens do prontuario
