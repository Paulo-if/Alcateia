      };

      $scope.buscaDadadosClienteTrocaAssinatura = function () {
        if ($("#clienteListaTrocaNotaAssinatura").val() != "") {
          showLoader(true);
          $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaPessoav2.php",
            data: {
              tipo: 1,
