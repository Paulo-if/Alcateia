                  data.buscaListaPontosItens[i].PIt_Codigo +
                  "'> " +
                  data.buscaListaPontosItens[i].Descricao +
                  "</option>";
              }
            }
            $("#itemTokemInfo").html(html);
          },
        });
      };

      $scope.resgataTokenInfo = function () {
