      $scope.criaCupomNotaPacote = function () {
        showLoader(true);
        var timegerado = new Date().getTime();
        var proceedNota = 1;
        var msgerro = "";

        if ($scope.emiteSemEnderecoPacote == undefined) {
          $scope.emiteSemEnderecoPacote = 1;
        } else if ($scope.emiteSemEnderecoPacote == 0) {
          if (
            $("#cliCupomUFNotaPacote").val() == "" ||
            $("#cliCupomUFNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o estado do cliente.";
          } else if (
            $("#cliCupomCidadeNotaPacote").val() == "" ||
            $("#cliCupomCidadeNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe a cidade do cliente.";
          } else if (
            $("#cliCupomCEPNotaPacote").val() == "" ||
            $("#cliCupomCEPNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o CEP do cliente.";
          } else if (
            $("#cliCupomBairroNotaPacote").val() == "" ||
            $("#cliCupomBairroNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o bairro do cliente.";
          } else if (
            $("#cliCupomLogradouroNotaPacote").val() == "" ||
            $("#cliCupomLogradouroNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o logradouro do cliente.";
          } else if (
            $("#cliCupomNumeroNotaPacote").val() == "" ||
            $("#cliCupomNumeroNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o numero do endereço do cliente.";
          }
        }

        if ($scope.emiteSemCPFPacote == undefined) {
          $scope.emiteSemCPFPacote = 1;
        } else if ($scope.emiteSemCPFPacote == 0) {
          if (
            $("#cliCupomCPFNotaPacote").val() == "" ||
            $("#cliCupomCPFNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o CPF do tomador do serviço. Favor informe o CPF do cliente.";
          }
        }

        if ($scope.emiteSemClientePacote == undefined) {
          $scope.emiteSemClientePacote = 1;
        } else if ($scope.emiteSemClientePacote == 0) {
          if (
            $("#cliCupomNomeNotaPacote").val() == "" ||
            $("#cliCupomNomeNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o nome do tomador do serviço. Favor informe o nome do cliente.";
          }
        }

        if (
          $("#enviaCupomEmailNotaPacote").val() == "1" &&
          $("#cliCupomEmailNotaPacote").val() == ""
        ) {
          proceedNota = 0;
          msgerro = "Informe um e-mail pra o envio a emissão.";
        }

        if (proceedNota == 1) {
          if (
            $("#servicoNaturezaNotaPacote option:selected").get(0) != undefined
          ) {
            if (
              $("#empresaCodigoNFNotaPacote").val() != "" &&
              $("#empresaCodigoNFNotaPacote").val() != undefined
            ) {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/insereNotaFiscalPacote.php",
                data: {
                  ppacodigo: $("#ppaCodigoNotaPacote").val(),
                  idEmpresa: $("#empresaCodigoNFNotaPacote").val(),
                  idExternoNota:
                    $("#ppaCodigoNotaPacote").val() + "_" + timegerado,
                  enviarEmail: $("#enviaCupomEmailNotaPacote").val(),
                  nomeCliente: $("#cliCupomNomeNotaPacote").val(),
                  emailCliente: $("#cliCupomEmailNotaPacote").val(),
                  cpfCliente: $("#cliCupomCPFNotaPacote").val(),
                  logradouroCliente: $("#cliCupomLogradouroNotaPacote").val(),
                  numeroCliente: $("#cliCupomNumeroNotaPacote").val(),
                  complementoCliente: $("#cliCupomComplementoNotaPacote").val(),
                  bairroCliente: $("#cliCupomBairroNotaPacote").val(),
                  cepCliente: $("#cliCupomCEPNotaPacote").val(),
                  ufCliente: $("#cliCupomUFNotaPacote").val(),
                  cidadeCliente: $("#cliCupomCidadeNotaPacote").val(),
                  descricaoServico: $("#servicosPrestadosNotaPacote").html(),
                  aliquotaIss: parseFloat(
                    $("#servicoNaturezaNotaPacote option:selected").get(0)
                      .dataset.aliquota
                  ),
                  itemServico: $(
                    "#servicoNaturezaNotaPacote option:selected"
                  ).get(0).dataset.itemlista,
                  cnae: $("#empresaCNAENotaPacote").val(),
                  codigoServico: $("#servicoNaturezaNotaPacote").val(),
                  valorTotal: parseFloat(
                    $("#valorCupomNotaPacote")
                      .html()
                      .replace($_CONFIG.MOEDA, "")
                      .replace(",", ".")
                  ),
                  timegerado: timegerado,
                  valorClss: parseFloat(
                    $("#valorClssNotaPacote").html().replace(",", ".")
                  ),
                  valorPis: parseFloat(
                    $("#valorPisNotaPacote").html().replace(",", ".")
                  ),
                  valorCofins: parseFloat(
                    $("#valorCofinsNotaPacote").html().replace(",", ".")
                  ),
                  valorInss: parseFloat(
                    $("#valorInssNotaPacote").html().replace(",", ".")
                  ),
                  valorIr: parseFloat(
                    $("#valorIrNotaPacote").html().replace(",", ".")
                  ),
                  observacao: $("#cliCupomObsNotaPacote").val(),
                  tipoPessoaNotaPacote: $("#tipoPessoaNotaPacote").val(),
                  deducoes: parseFloat(
                    $("#valorComissaoDisplayNotaPacote").val().replace(",", ".")
                  ),
                  descricaocidadeservico: $(
                    "#servicoNaturezaNotaPacote option:selected"
                  ).get(0).text,
                  metadados: "",
                  codigoNBS: $(
                    "#servicoNaturezaNotaPacote option:selected"
                  ).get(0).dataset.nbs,
                },
                dataType: "json",
                success: function (result) {
                  showLoader(false);
                  if (result.data[0].erro == 1) {
                    toastr.warning(result.data[0].resultado);
                  } else {
                    toastr.warning(result.resultNota.erronf);
                    if (
                      result.resultNota.nfid == "" ||
                      result.resultNota.nfid == undefined
                    ) {
                      $.ajax({
                        type: "POST",
                        url: "/pages/cadastros/removePacoteNotaFiscal.php",
                        data: {
                          pnfcodigoexterno:
                            $("#ppaCodigoNotaPacote").val() + "_" + timegerado,
                        },
                        dataType: "json",
                        success: function (data) {
                          if (data.data.erro != undefined) {
                            toastr.error(data.data.resultado);
                          } else {
                            if (data.data[0].erro == "0") {
                              toastr.success(data.data[0].resultado);
                            } else {
                              toastr.error(data.data[0].resultado);
                            }
                          }
                        },
                        error: function (result) {
                          toastr.error("Falha na conexão.");
                        },
                      });
                    }
                    $("#generateCupomServicoPacote-modal").modal("hide");
                  }
                },
                error: function (result) {
                  showLoader(false);
                  toastr.error("Falha na conexão.");
                },
              });
            } else {
              showLoader(false);
              toastr.error("Informe o ID da empresa");
            }
          } else {
            showLoader(false);
            toastr.error("Selecione o Serviço");
          }
        } else {
          showLoader(false);
          toastr.error(msgerro);
        }
      };

      $scope.criaCupomProdPacote = function () {
        showLoader(true);
        var timegerado = new Date().getTime();
        var proceedNota = 1;
        var msgerro = "";

        if ($scope.emiteSemEnderecoPacote == undefined) {
          $scope.emiteSemEnderecoPacote = 1;
        } else if ($scope.emiteSemEnderecoPacote == 0) {
          if (
