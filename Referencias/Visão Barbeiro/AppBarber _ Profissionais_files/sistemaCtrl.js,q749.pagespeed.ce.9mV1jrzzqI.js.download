        } else if ($scope.emiteSemCPFPacote == 0) {
          if (
            $("#cliCupomCPFProdNotaPacote").val() == "" ||
            $("#cliCupomCPFProdNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o CPF do tomador do serviço. Favor informe o CPF do cliente.";
          }
        }

        if ($scope.emiteSemClientePacote == undefined) {
          $scope.emiteSemClientePacote = 1;
        } else if ($scope.emiteSemClientePacote == 0) {
          if (
            $("#cliCupomNomeProdNotaPacote").val() == "" ||
            $("#cliCupomNomeProdNotaPacote").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o nome do tomador do serviço. Favor informe o nome do cliente.";
          }
        }

        if (
          $("#enviaCupomEmailProdNotaPacote").val() == "1" &&
          $("#cliCupomEmailProdNotaPacote").val() == ""
        ) {
          proceedNota = 0;
          msgerro = "Informe um e-mail pra o envio a emissão.";
        }

        if (proceedNota == 1) {
          var infoProcon = "";
          if ($("#cidCodigoNotaProdutoPacote").val() != "") {
            $.ajax({
              type: "POST",
              url: "/pages/cadastros/buscaCidadeProcon.php",
              async: false,
              data: {
                cidcodigo: $("#cidCodigoEmpresaNotaProduto").val(),
              },
              dataType: "json",
              success: function (result) {
                if (result.data.length > 0) {
                  infoProcon = `TELEFONE DO PROCON: ${result.data[0].CPo_Telefone} \n ENDERECO DO PROCON: ${result.data[0].CPo_Endereco}`;
                }
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
              },
            });
          }

          $.ajax({
            dataType: "json",
            url: "/pages/cadastros/buscaPessoaPacoteDetalhesv2.php",
            async: false,
            data: {
              tipo: 2,
              ppacodigo: $("#ppaCodigoNotaPacoteProduto").val(),
            },
            success: function (data) {
              if (data.data[0].TPa_Descricao != "") {
                $scope.tpapagamentopacote = data.data[0].TPa_Descricao;
                if (data.data[0].TBa_Descricao != "") {
                  $scope.tbapagamentopacote = data.data[0].TBa_Descricao;
                }
              }
            },
            error: function () {
              swal("Falha na conexão.", "", "error");
            },
          });

          if ($scope.tpapagamentopacote != "") {
            $scope.arrPagamentopacote = [];
            var descricaoPagamentopacote = "";
            $scope.valorPagamentoNotapacote = parseFloat(
              $("#valorCupomDisplayProdNotaPacote")
                .val()
                .replace($_CONFIG.MOEDA, "")
                .replace(" ", "")
            );
            var pushPagamentopacote = "";
            if (
              $scope.tpapagamentopacote == "Dinheiro" ||
              $scope.tpapagamentopacote == "dinheiro"
            ) {
              pushPagamentopacote = "Dinheiro";
            } else if (
              $scope.tpapagamentopacote == "Cartão de Crédito" ||
              $scope.tpapagamentopacote == "cartão de crédito"
            ) {
              pushPagamentopacote = "CartaoDeCredito";
            } else if (
              $scope.tpapagamentopacote == "Cartão de Débito" ||
              $scope.tpapagamentopacote == "cartão de débito"
            ) {
              pushPagamentopacote = "CartaoDeDebito";
            } else if (
              $scope.tpapagamentopacote == "Cheque" ||
              $scope.tpapagamentopacote == "cheque"
            ) {
              pushPagamentopacote = "Cheque";
            } else if (
              $scope.tpapagamentopacote == "Boleto" ||
              $scope.tpapagamentopacote == "boleto"
            ) {
              pushPagamentopacote = "BoletoBancario";
            } else if (
              $scope.tpapagamentopacote == "PIX" ||
              $scope.tpapagamentopacote == "pix" ||
              $scope.tpapagamentopacote == "Pix"
            ) {
              pushPagamentopacote = "PagamentoInstantaneoPix";
            } else if (
              $scope.tpapagamentopacote == "Resgate de Pontos" ||
              $scope.tpapagamentopacote == "resgate de pontos"
            ) {
              pushPagamentopacote = "ProgramaFidelidadeCashbackCarteiraVirtual";
            } else {
              descricaoPagamentopacote = $scope.tpapagamentopacote;
              pushPagamentopacote = "Outros";
            }

            if (descricaoPagamentopacote != "") {
              $scope.arrPagamentopacote.push({
                tipo: pushPagamentopacote,
                valor: $scope.valorPagamentoNotapacote,
                descricao: descricaoPagamentopacote,
              });
            } else {
              if (
                pushPagamentopacote == "CartaoDeCredito" ||
                pushPagamentopacote == "CartaoDeDebito"
              ) {
                $scope.arrPagamentopacote.push({
                  tipo: pushPagamentopacote,
                  valor: $scope.valorPagamentoNotapacote,
                  credenciadoraCartao: {
                    tipoIntegracaoPagamento: "NaoIntegradoAoSistemaDeGestao",
                  },
                });
              } else {
                $scope.arrPagamentopacote.push({
                  tipo: pushPagamentopacote,
                  valor: $scope.valorPagamentoNotapacote,
                });
              }
            }
          } else {
            $scope.arrPagamentopacote.push({
              tipo: "Dinheiro",
              valor: $scope.valorPagamentoNotapacote,
            });
          }

          if (
            $("#empresaCodigoNFProdNotaPacote").val() != "" &&
            $("#empresaCodigoNFProdNotaPacote").val() != undefined
          ) {
            $.ajax({
              type: "POST",
              url: "/pages/cadastros/insereNotaFiscalPacoteProduto.php",
              data: {
                ppacodigo: $("#ppaCodigoNotaPacoteProduto").val(),
                idEmpresa: $("#empresaCodigoNFProdNotaPacote").val(),
                idExternoNota:
                  $("#ppaCodigoNotaPacoteProduto").val() + "_" + timegerado,
                enviarEmail: $("#enviaCupomEmailProdNotaPacote").val(),
                nomeCliente: $("#cliCupomNomeProdNotaPacote").val(),
                telefoneCliente: $("#cliCupomTelefoneProdNotaPacote").val(),
                emailCliente: $("#cliCupomEmailProdNotaPacote").val(),
                cpfCliente: $("#cliCupomCPFProdNotaPacote").val(),
                logradouroCliente: $("#cliCupomLogradouroProdNotaPacote").val(),
                numeroCliente: $("#cliCupomNumeroProdNotaPacote").val(),
                complementoCliente: $(
                  "#cliCupomComplementoProdNotaPacote"
                ).val(),
                bairroCliente: $("#cliCupomBairroProdNotaPacote").val(),
                cepCliente: $("#cliCupomCEPProdNotaPacote").val(),
                ufCliente: $("#cliCupomUFProdNotaPacote").val(),
                cidadeCliente: $("#cliCupomCidadeProdNotaPacote").val(),
                item: $scope.produtosNotaPacote,
                timegerado: timegerado,
                tipoemissao: 1,
                pagamento: JSON.stringify($scope.arrPagamentopacote),
                informacaoAdicional: infoProcon,
                natureza: $("#naturezaNotaProdutoPacote").val(),
              },
              dataType: "json",
              success: function (result) {
                showLoader(false);
                if (result.data[0].erro == 1) {
                  toastr.warning(result.data[0].resultado);
                } else {
                  toastr.warning(result.resultNota.erronf);
                  if (
                    result.resultNota.nfid == "" ||
                    result.resultNota.nfid == undefined
                  ) {
                    $.ajax({
                      type: "POST",
                      url: "/pages/cadastros/removePacoteNotaFiscal.php",
                      data: {
                        pnfcodigoexterno:
                          $("#ppaCodigoNotaPacote").val() + "_" + timegerado,
                      },
                      dataType: "json",
                      success: function (data) {
                        if (data.data.erro != undefined) {
                          toastr.error(data.data.resultado);
                        } else {
                          if (data.data[0].erro == "0") {
                            toastr.success(data.data[0].resultado);
                          } else {
                            toastr.error(data.data[0].resultado);
                          }
                        }
                      },
                      error: function (result) {
                        toastr.error("Falha na conexão.");
                      },
                    });
                  }
                  $("#generateCuponProdutoPacote-modal").modal("hide");
                }
              },
              error: function (result) {
                showLoader(false);
                toastr.error("Falha na conexão.");
              },
            });
          } else {
            showLoader(false);
            toastr.error("Informe o ID da empresa");
          }
        } else {
          showLoader(false);
          toastr.error(msgerro);
        }
      };

      $scope.displayModalJornada = function () {
        $("#divTabelaJornada").hide();
        $("#divBotaoMaisJornada").hide();
        $("#addHorarioJornada").prop("disabled", true);
        $.ajax({
          dataType: "json",
          url: "pages/cadastros/buscaProfissionalSelect.php",
          success: function (data) {
            var profissional = "";
            profissional +=
              '<option  value="">' +
              $_CONFIG.language.profissional +
              "</option>";
            for (var i = 0; i < data.profissionais.length; i++) {
              var codigo = data.profissionais[i].Pes_Codigo;
              var nome = data.profissionais[i].Pes_Nome;
              profissional +=
                '<option  value="' + codigo + '">' + nome + "</option>";
            }
            $("#profissionalJornadaSelect").html(profissional);
          },
        });

        var stepTimePicker = "";

        if ($_CONFIG.TEMPOPADRAO == "40") {
          stepTimePicker = "20";
        } else if ($_CONFIG.TEMPOPADRAO == "45") {
          stepTimePicker = "15";
        } else {
          stepTimePicker = $_CONFIG.TEMPOPADRAO;
        }

        $(".timepicker").timepicker({
          timeFormat: "H:i",
          maxTime: "23",
          minTime: "01",
          forceRoundTime: true,
          step: parseInt(stepTimePicker),
        });

        $("#jornadaProfissional-modal").modal();
      };

      $scope.buscaPessoaJornadaLista = function () {
        if ($("#profissionalJornadaSelect").val() == "") {
          $("#addHorarioJornada").prop("disabled", true);
        } else {
          $("#addHorarioJornada").prop("disabled", false);
        }

        if ($("#profissionalJornadaSelect").val() != "") {
          $("#divTabelaJornada").show();
          $("#divBotaoMaisJornada").show();
          $("#pesCodigoJornadaInsere").val(
            $("#profissionalJornadaSelect").val()
          );
          $("#pesCodigoJornada").val($("#profissionalJornadaSelect").val());

          if (typeof tabelaListaJornada != "undefined") {
            tabelaListaJornada.destroy();
            $("#tabelaJornadaProfissional tbody").unbind("click");
          }
          tabelaListaJornada = $("#tabelaJornadaProfissional").DataTable({
            ajax: {
              url: "/pages/cadastros/buscaPessoaJornada.php",
              method: "POST",
              data: function (d) {
                d.pescodigo = $("#profissionalJornadaSelect").val();
              },
            },
            lengthMenu: [10],
            scrollX: isPortrait,

            stateSaveCallback: function (settings, data) {
              data.order = [];
              localStorage.setItem(
                "DataTables_" + settings.sInstance,
                JSON.stringify(data)
              );
            },
            stateLoadCallback: function (settings) {
              return JSON.parse(
                localStorage.getItem("DataTables_" + settings.sInstance)
              );
            },
            stateSave: true,
            fnRowCallback: function (nRow, aData) {
              var $nRow = $(nRow);
              var dia = aData.PJo_Dia;

              switch (dia) {
                case "1":
                  $nRow.find("td.Dia").html("Domingo");
                  break;
                case "2":
                  $nRow.find("td.Dia").html("Segunda-Feira");
                  break;
                case "3":
                  $nRow.find("td.Dia").html("Terça-Feira");
                  break;
                case "4":
                  $nRow.find("td.Dia").html("Quarta-Feira");
                  break;
                case "5":
                  $nRow.find("td.Dia").html("Quinta-Feira");
                  break;
                case "6":
                  $nRow.find("td.Dia").html("Sexta-Feira");
                  break;
                case "7":
                  $nRow.find("td.Dia").html("Sábado");
                  break;
              }
            },

            columns: [
              {
                data: "PJo_Dia",
                title: "Dia",
                class: "Dia jornadamobile",
                width: "15%",
              },
              {
                data: "PJo_Hor_Ini1",
                title: "Hora inicio 1",
                class: "jornadamobile",
                width: "10%",
              },
              {
                data: "PJo_Hor_Fim1",
                title: "Hora fim 1",
                class: "jornadamobile",
                width: "10%",
              },
              {
                data: "PJo_Hor_Ini2",
                title: "Hora inicio 2",
                class: "jornadamobile",
                width: "10%",
              },
              {
                data: "PJo_Hor_Fim2",
                title: "Hora fim 2",
                class: "jornadamobile",
                width: "10%",
              },
              {
                title: "Editar",
                class: "editarJornada-control",
                orderable: false,
                data: null,
                defaultContent:
                  '<button class="btn btn-success btn-xs " style="margin:auto"> <i class="fa fa-pencil"></i></button>',
                width: "5%",
              },
              {
                title: "Remover",
                class: "removerJornada-control",
                orderable: false,
                data: null,
                defaultContent:
                  '<button class="btn btn-danger btn-xs " style="margin:auto"> <i class="fa fa-trash"></i></button>',
                width: "5%",
              },
            ],
            ordering: false,
            language: {
              url: "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json",
            },
          });
          $("#tabelaJornadaProfissional tbody").on(
            "click",
            "td.editarJornada-control",
            function () {
              var tr = $(this).closest("tr");
              var row = tabelaListaJornada.row(tr);
              var data = row.data();
              $("#pesCodigoJornada").val(data.Pes_Codigo);
              $("#jornadaDiaSemana").val(data.PJo_Dia);
              $("#jornadaHoraIni1").val(data.PJo_Hor_Ini1);
              $("#jornadaHoraFim1").val(data.PJo_Hor_Fim1);
              $("#jornadaHoraIni2").val(data.PJo_Hor_Ini2);
              $("#jornadaHoraFim2").val(data.PJo_Hor_Fim2);
              $("#editarJornadaProfissional-modal").modal();
            }
          );

          if (isMobile) {
            $("#tabelaJornadaProfissional tbody").on(
              "click",
              "td.jornadamobile",
              function () {
                var row = tabelaListaJornada.row($(this));
                var data = row.data();
                $("#pesCodigoJornada").val(data.Pes_Codigo);
                $("#jornadaDiaSemana").val(data.PJo_Dia);
                $("#jornadaHoraIni1").val(data.PJo_Hor_Ini1);
                $("#jornadaHoraFim1").val(data.PJo_Hor_Fim1);
                $("#jornadaHoraIni2").val(data.PJo_Hor_Ini2);
                $("#jornadaHoraFim2").val(data.PJo_Hor_Fim2);
                $("#editarJornadaProfissional-modal").modal();
              }
            );
          }

          $("#tabelaJornadaProfissional tbody").on(
            "click",
            "td.removerJornada-control",
            function () {
              var tr = $(this).closest("tr");
              var row = tabelaListaJornada.row(tr);
              var data = row.data();
              swal(
                {
                  title: $_CONFIG.language.mensagens.excluir_titulo,
                  text: $_CONFIG.language.mensagens.excluir_jornada,
                  type: "warning",
                  showCancelButton: true,
                  confirmButtonColor: "#DD6B55",
                  confirmButtonText: $_CONFIG.language.sim,
                  cancelButtonText: $_CONFIG.language.nao,
                },
                function () {
                  showLoader(true);
                  $.ajax({
                    dataType: "html",
                    url: "/pages/cadastros/removeProfissionalJornada.php",
                    data: {
                      pescodigo: data.Pes_Codigo,
                      dia: data.PJo_Dia,
                    },
                    success: (data) => {
                      if (data == "0") {
                        toastr.success("Jornada Excluida com Sucesso.");
                        tabelaListaJornada.ajax.reload();
                      } else {
                        toastr.error(
                          data,
                          $_CONFIG.language.mensagens.falha_excluir
                        );
                      }
                      showLoader(false);
                    },
                    error: () => {
                      toastr.error($_CONFIG.language.errors.falha_conexao);
                      showLoader(false);
                    },
                  });
                }
              );
            }
          );
        } else {
          toastr.warning("Selecione um profissional");
        }
      };

      $scope.novoHorarioTrabalho = function () {
        $("#jornadaHoraIni1Insere").val("");
        $("#jornadaHoraFim1Insere").val("");
        $("#jornadaHoraIni2Insere").val("");
        $("#jornadaHoraFim2Insere").val("");
        $("#jornadaDiaSemanaInsere").val(1);

        $("#cadastrarJornadaProfissional-modal").modal();
      };

      $scope.InsereJornadaProfissional = function () {
        $("#jornadaDiaSemana").prop("disabled", false);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/insereProfissionalJornada.php",
          dataType: "json",
          data: {
            pjProfissional: $("#pesCodigoJornadaInsere").val(),
            pjHoraIni1: $("#jornadaHoraIni1Insere").val(),
            pjHoraFim1: $("#jornadaHoraFim1Insere").val(),
            pjDiaSemana: [$("#jornadaDiaSemanaInsere").val()],
            pjHoraIni2: $("#jornadaHoraIni2Insere").val(),
            pjHoraFim2: $("#jornadaHoraFim2Insere").val(),
          },
          success: function (result) {
            if (result.insereProfissionalJornada[0].erro == 1) {
              toastr.error(result.insereProfissionalJornada[0].resultado);
            } else {
              $("#cadastrarJornadaProfissional-modal").modal("hide");
              tabelaListaJornada.ajax.reload();
              toastr.success(result.insereProfissionalJornada[0].resultado);
            }
          },
          error: function (result) {
            toastr.error("Falha de Conexão");
          },
        });
      };

      $scope.edtJornadaProfissional = function () {
        $("#jornadaDiaSemana").prop("disabled", false);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/alteraProfissionalJornada.php",
          dataType: "json",
          data: {
            pjCodigo: $("#pesCodigoJornada").val(),
            pjHoraIni1: $("#jornadaHoraIni1").val(),
            pjHoraFim1: $("#jornadaHoraFim1").val(),
            pjDiaId: $("#jornadaDiaSemana").val(),
            pjHoraIni2: $("#jornadaHoraIni2").val(),
            pjHoraFim2: $("#jornadaHoraFim2").val(),
          },
          success: function (result) {
            if (result.alteraProfissionalJornada[0].erro == 1) {
              toastr.error(result.alteraProfissionalJornada[0].resultado);
              $("#jornadaDiaSemana").prop("disabled", true);
            } else {
              $("#editarJornadaProfissional-modal").modal("hide");
              tabelaListaJornada.ajax.reload();
              toastr.success(result.alteraProfissionalJornada[0].resultado);
              $("#jornadaDiaSemana").prop("disabled", true);
            }
          },
          error: function (result) {
            toastr.error("Falha de Conexão");
          },
        });
      };

      $scope.enviaEmailClienteLGPD = function (codigo) {
        swal(
          {
            title: "Enviar e-mail de consentimento dos termos de uso?",
            type: "info",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: $_CONFIG.language.sim,
            cancelButtonText: $_CONFIG.language.nao,
            closeOnConfirm: true,
          },
          function (isConfirm) {
            if (isConfirm) {
              $.ajax({
                dataType: "json",
                url: "/pages/cadastros/buscaEmailLGPD.php",
                method: "POST",
                data: {
                  pescodigo: codigo,
                  tipo: 1,
                },
                success: function (result) {
                  if (result.data[0].erro == "0") {
                    toastr.success(result.data[0].resultado);
                  } else {
                    swal(result.data[0].resultado);
                  }
                  showLoader(false);
                },
                error: function (result) {
                  swal("Falha na conexão.", "", "error");
                  showLoader(false);
                },
              });
            } else {
              showLoader(false);
            }
            showLoader(false);
          }
        );
      };

      $scope.addFavorito = (nome, url, icon, path) => {
        var localFav = localStorage.getItem("favoritos_" + $_CONFIG.CODUSUARIO);

        if (localFav != undefined && localFav != "") {
          var objFav = JSON.parse(localFav);
        } else {
          var objFav = [];
        }

        objFav.push({
          name: nome,
          url: url,
          icon: icon,
          path: path,
        });
        localStorage.setItem(
          "favoritos_" + $_CONFIG.CODUSUARIO,
          JSON.stringify(objFav)
        );

        $scope.favoritos = objFav;
        $scope.$apply();
      };

      $scope.removeFavorito = (url, origin) => {
        var localFav = localStorage.getItem("favoritos_" + $_CONFIG.CODUSUARIO);

        if (localFav != undefined && localFav != "") {
          var objFav = JSON.parse(localFav);
        } else {
          var objFav = [];
        }

        var newObjFav = _.without(
          objFav,
          _.findWhere(objFav, {
            url: url,
          })
        );
        localStorage.setItem(
          "favoritos_" + $_CONFIG.CODUSUARIO,
          JSON.stringify(newObjFav)
        );

        $scope.favoritos = newObjFav;

        $('.control-menu[ui-sref="' + url + '"]').removeClass("has-favorite");

        if (origin == 1) {
          $scope.$apply();
        }
      };

      $scope.limpaFavoritos = () => {
        swal(
          {
            title: $_CONFIG.language.mensagens.excluir_titulo,
            text: "Deseja limpar os favoritos?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: $_CONFIG.language.sim,
            cancelButtonText: $_CONFIG.language.nao,
          },
          function () {
            localStorage.removeItem("favoritos_" + $_CONFIG.CODUSUARIO);
            $scope.favoritos = [];
            $scope.$apply();
            $(".has-favorite").removeClass("has-favorite");
            toastr.success("Favoritos removidos.");
          }
        );
      };

      $scope.changeRoute = (url) => {
        $state.go(url);
      };

      $scope.favoritos.forEach((favorito) => {
        if ($('.control-menu[ui-sref="' + favorito.url + '"]').length > 0) {
          $('.control-menu[ui-sref="' + favorito.url + '"]').addClass(
            "has-favorite"
          );
        }
      });

      $.contextMenu({
        selector: ".has-favorite",
        callback: (key, options) => {
          if (key == "favorito") {
            var opt = options.$trigger[0];
            var urlFav = opt.getAttribute("ui-sref");
            $scope.removeFavorito(urlFav, 1);
          }
        },
        items: {
          favorito: {
            name: "Tirar dos Favoritos",
            icon: "fa-star",
          },
        },
      });

      $.contextMenu({
        selector: ".control-menu",
        callback: (key, options) => {
          if (key == "favorito") {
            $(options.$trigger[0]).addClass("has-favorite");
            var opt = options.$trigger[0];
            var nameFav = opt.text.trim();
            var urlFav = opt.getAttribute("ui-sref");

            var pathFav = "";

            var iconFav = "";
            if ($(opt.parentElement.parentElement).hasClass("treeview-menu")) {
              var father = opt.parentElement.parentElement;

              if (
                $(father.parentElement.parentElement).hasClass("treeview-menu")
              ) {
                iconFav =
                  father.parentElement.parentElement.parentElement.getElementsByTagName(
                    "i"
                  )[0].className;
                pathFav =
                  father.parentElement.parentElement.parentElement
                    .getElementsByTagName("a")[0]
                    .text.trim() +
                  " ► " +
                  father.parentElement.getElementsByTagName("a")[0].text.trim();
              } else {
                pathFav = opt.parentElement.parentElement.parentElement
                  .getElementsByTagName("a")[0]
                  .text.trim();
                iconFav =
                  opt.parentElement.parentElement.parentElement.getElementsByTagName(
                    "i"
                  )[0].className;
              }
            } else {
              iconFav = opt.getElementsByTagName("i")[0].className;
            }

            pathFav = pathFav + " ► " + nameFav;

            $scope.addFavorito(nameFav, urlFav, iconFav, pathFav);
          }
        },
        items: {
          favorito: {
            name: "Favorito",
            icon: "fa-star-o",
          },
        },
      });

      $scope.verDetalhesPacote = function (ppacodigo) {
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaPacotePessoaDetalhes.php",
          data: {
            ppacodigo: ppacodigo,
          },
          dataType: "json",
          success: function (result) {
            if (result.result.length > 0) {
              var html = "";
              for (var i = 0; i < result.result.length; i++) {
                valores = result.result[i];
                datahora = valores.PPD_Dat_Cadastro.split(" ");
                var classIcon = "";
                var descricao = "";
                if (valores.Tipo == "Produto") {
                  classIcon = "fa fa-shopping-cart bg-green";
                  descricao = valores.Pro_Descricao;
                } else {
                  classIcon = "fa fa-scissors bg-blue";
                  descricao = valores.Ser_Descricao;
                }

                html += '<li class="time-label">';
                html += '<span class="bg-teal-dark">';
                html += datahora[0];
                html += "</span>";
                html += "</li>";
                html += "<li>";
                html += '<i class="' + classIcon + '"></i>';
                html += '<div class="timeline-item">';
                html +=
                  '<span class="time"><i class="fa fa-clock-o"></i> ' +
                  datahora[1] +
                  " </span>";
                html +=
                  '<h3 class="timeline-header"><strong>' +
                  descricao +
                  "</strong></h3>";
                html += '<div class="timeline-body">';
                html += "<strong>Profissional:</strong> " + valores.Pes_Nome;
                html +=
                  "<p><strong>Quantidade:</strong> " +
                  valores.CIt_Quantidade +
                  "</p>";
                html += "</div>";
                html += '<div class="timeline-footer">';
                html +=
                  '<a class="btn btn-primary btn-xs" ng-click="showComandaPacote(' +
                  valores.Com_Codigo +
                  ');">Ver Comanda</a>';
                html += "</div>";
                html += "</div>";
                html += "</li>";
              }
              $("#timelinePacote").html(html);
              $compile($("#timelinePacote"))($scope);
              $("#infoPacotePessoaDetalhes-modal").modal();
            } else {
              html = '<li class="time-label">';
              html += "</li>";
              html += "<li>";
              html += '<i class="fa fa-ban"></i>';
              html += '<div class="timeline-item">';
              html += '<span class="time"></span>';
              html +=
                '<h3 class="timeline-header"><strong>Sem movimentações neste pacote.</strong></h3>';
              html += "</div>";
              html += "</li>";
              $("#timelinePacote").html(html);
              $("#infoPacotePessoaDetalhes-modal").modal();
            }
            var htmlitens = "";
            $("#showPacItens").removeClass("collapse in");
            $("#showPacItens").addClass("collapse");
            $("#iconCaret").removeClass("fa-caret-up");
            $("#iconCaret").addClass("fa-caret-down");
            $.ajax({
              type: "GET",
              url: "/pages/cadastros/buscaPessoaPacoteDetalhesv2.php",
              data: {
                ppacodigo: ppacodigo,
                tipo: 1,
              },
              dataType: "json",
              success: function (data) {
                for (var i = 0; i < data.data.length; i++) {
                  htmlitens += `${data.data[i].ItemDescricao} <br>&nbsp&nbsp&nbsp<b><small>Quantidade: </b> ${data.data[i].PTe_Quantidade} &nbsp<b>- Já Utilizados:</b> ${data.data[i].Utilizados}</small><br>`;
                }
                $("#itensPacoteMostrar").html(htmlitens);
              },
              error: function (data) {
                console.log(data);
              },
            });
            showLoader(false);
          },
          error: function (result) {
            swal("Falha na conexão.", "", "error");
            showLoader(false);
          },
        });
      };

      $scope.showComandaPacote = function (codigo) {
        $scope.buscaItensComandaVer(codigo);
        $("#idComandaVer").html(codigo);
        $("#edtComCartaoVer").val("");
        $("#vercomanda-modal").modal("show");
      };

      $("#changeCaret").click(function () {
        if ($("#iconCaret").hasClass("fa-caret-down")) {
          $("#iconCaret").removeClass("fa-caret-down");
          $("#iconCaret").addClass("fa-caret-up");
        } else {
          $("#iconCaret").removeClass("fa-caret-up");
          $("#iconCaret").addClass("fa-caret-down");
        }
      });

      function thumbProduto(state) {
        if (!state.id) {
          return state.text;
        }
        if (
          state.element.dataset.imagem == "" ||
          state.element.dataset.imagem == undefined
        ) {
          var $state = $(
            '<span><img src="/img/tag_prod.png" class="img-thumb" /> ' +
              state.text +
              "</span>"
          );
        } else {
          var $state = $(
            '<span><img src="' +
              state.element.dataset.imagem +
              '" class="img-thumb" /> ' +
              state.text +
              "</span>"
          );
        }
        return $state;
      }

      /* SORTEIO */
      $scope.entrantsList = [];

      $scope.getClientList = function (data) {
        $scope.entrantsList = [];
        $scope.entrantsList = data
          .map((val, i) => {
            if (val.CodCliente != "") {
              return [val.Cliente, val.CodCliente];
            } else {
              return false;
            }
          })
          .filter(((t = {}), (a) => !(t[a] = a in t)))
          .filter((item) => item != false);
        if ($scope.entrantsList.length > 1) {
          $("#btn-sortear").show();
        } else {
          $("#btn-sortear").hide();
        }
      };
      $scope.getRandomName = function () {
        var rand = Math.floor(Math.random() * $scope.entrantsList.length);
        var name = $scope.entrantsList[rand];
        $("#namesSorteio").text(name[0]);
        $("#namesSorteio").attr("data-codigo", name[1]);
      };

      $scope.doClick = function () {
        $("#sorteioCliente-modal").modal();
        $("#rollSorteio").html("Sortear");
        $("#rollSorteio").on("click", function (e) {
          $(this).hide();

          $scope.startDeceleratingTimeout(
            function () {
              $scope.getRandomName();
            },
            2,
            90
          );

          setTimeout(function () {
            var winner = $("#namesSorteio").text();
            $("#winnerSorteio").text(winner);
            $("#namesSorteio").hide();
            var htmlWinner = `
            <span>Cliente Sorteado: </span>
            <br>
            <strong> ${winner} </strong>
            <br>
            <a href="#" id="roll-againSorteio">Realizar novo Sorteio</a>
            <br>
            <a href="#" id="info-clienteSorteio">Info do Cliente</a>
          `;
            $("#winnerSorteio").html(htmlWinner);

            $.ajax({
              dataType: "json",
              method: "POST",
              url: "/pages/cadastros/insereLog.php",
              data: {
                descricao:
                  "Sorteio realizado. Sorteado: " +
                  $("#namesSorteio").get(0).dataset.codigo,
                tipo: 24,
              },
            });

            $("#roll-againSorteio").on("click", function (e) {
              e.preventDefault();
              $("#roll-againSorteio").unbind("click");
              $("#info-clienteSorteio").unbind("click");
              $("#winnerSorteio").html("");
              $("#namesSorteio").show();
              $("#rollSorteio").click();
            });
            $("#info-clienteSorteio").on("click", function (e) {
              e.preventDefault();
              $scope.mostraInfoClientes(
                $("#namesSorteio").get(0).dataset.codigo
              );
            });
          }, 9000);

          e.preventDefault();
        });
      };

      $scope.startDeceleratingTimeout = function (callback, factor, times) {
        var internalCallback = (function (t, counter) {
          return function () {
            if (--t > 0) {
              window.setTimeout(internalCallback, ++counter * factor);
              callback();
            }
          };
        })(times, 0);

        window.setTimeout(internalCallback, factor);
      };

      $scope.removeClienteInfo = function () {
        swal(
          {
            title: $_CONFIG.language.mensagens.excluir_titulo,
            text: '<h4><b>Deseja realmente excluir esse cliente?<br>Antes de excluir o cliente confira esse <a target="_blank" href="https://appbarber-appbeleza.zendesk.com/hc/pt-br/articles/360016694451-Meu-cliente-n%C3%A3o-consegue-se-cadastrar-ou-quer-utilizar-o-aplicativo-mas-ja-tenho-ele-cadastrado-o-que-devo-fazer-">TUTORIAL</a>, e verifique se a exclusão pode ser evitada com as orientações lá apresentadas</b></h4>' /*$_CONFIG.language.mensagens.excluir_cliente.replace("_NOME_", registroTabela.Nome)*/,
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: $_CONFIG.language.sim,
            cancelButtonText: $_CONFIG.language.nao,
            closeOnConfirm: false,
            closeOnCancel: true,
            html: true,
          },
          function (isConfirm) {
            if (isConfirm) {
              swal(
                {
                  title: "Está certo disso?",
                  text: '<h4><b><span style="color:red">Essa operação é irreversível.</span><br><br> O cliente não terá mais acesso ao seu estabelecimento no aplicativo, e não conseguirá se cadastrar novamente com o mesmo email;<br><br> Você não terá acesso as informações do cliente;</b></h4>' /*$_CONFIG.language.mensagens.excluir_cliente.replace("_NOME_", registroTabela.Nome)*/,
                  type: "warning",
                  showCancelButton: true,
                  confirmButtonColor: "#DD6B55",
                  confirmButtonText: $_CONFIG.language.sim,
                  cancelButtonText: $_CONFIG.language.nao,
                  html: true,
                },
                function () {
                  showLoader(true);

                  $.ajax({
                    dataType: "html",
                    url: "/pages/cadastros/removeClientes.php",
                    data: {
                      pescodigo: $("#cliPesCodigoInfo").val(),
                    },
                    success: function (data) {
                      if (data == "0") {
                        toastr.success(
                          $_CONFIG.language.mensagens.cliente_excluido
                        );
                      } else {
                        toastr.error(
                          data,
                          $_CONFIG.language.mensagens.falha_excluir
                        );
                      }
                      showLoader(false);
                    },
                    error: function (result) {
                      toastr.error($_CONFIG.language.mensagens.falha_conexao);
                      showLoader(false);
                    },
                  });
                  $("#infoCliente-modal").modal("hide");
                  showLoader(false);
                }
              );
            }
          }
        );
      };

      function thumbServico(state) {
        if (!state.id) {
          return state.text;
        }

        if (
          (state.element.dataset.tipopreco == "Igual a" ||
            state.element.dataset.tipopreco == "A partir de") &&
          state.element.dataset.valor.length != 0
        ) {
          var $state = $(
            "<span>" +
              state.text +
              '<br><small style="color:#adadad">' +
              state.element.dataset.tipopreco +
              " - " +
              $_CONFIG.MOEDA +
              " " +
              state.element.dataset.valor +
              "</small></span>"
          );
        } else if (
          state.element.dataset.tipopreco != "Igual a" &&
          state.element.dataset.tipopreco != "A partir de" &&
          state.element.dataset.valor.length != 0
        ) {
          var $state = $(
            "<span>" +
              state.text +
              '<br><small style="color:#adadad">' +
              $_CONFIG.MOEDA +
              " " +
              state.element.dataset.valor +
              "</small></span>"
          );
        } else {
          var $state = $("<span>" + state.text + "</span>");
        }

        return $state;
      }

      $scope.initScan = function () {
        // Initialize with options

        onScan.attachTo(document, {
          avgTimeByChar: 35,
          suffixKeyCodes: [9, 13], // enter-key expected at the end of a scan
          reactToPaste: false,
          minLength: 8, // Compatibility to built-in scanners in paste-mode (as opposed to keyboard-mode)
          onScan: function (sCode, iQty) {
            // Alternative to document.addEventListener('scan')

            if ($("#comanda-modal").hasClass("in")) {
              // Se está com a comanda aberta, insere o produto.
              addScanProduct(sCode);
            } else if (
              location.hash == "#/estoque" &&
              $("#cadastrar-modal").hasClass("in")
            ) {
              // Se está inserindo um novo produto, cola o código no campo de Código de Barras
              if (
                $(document.activeElement).hasClass("form-control") &&
                document.activeElement.id != "proBarCode"
              ) {
                $(document.activeElement).val(
                  $(document.activeElement).val().replace(sCode, "")
                );
              }
              $("#proBarCode").val(sCode);
            } else if (
              location.hash == "#/estoque" &&
              $("#editar-modal").hasClass("in")
            ) {
              // Se está editando um produto, cola o código no campo de código de barras
              if (
                $(document.activeElement).hasClass("form-control") &&
                document.activeElement.id != "proBarCodeEdt"
              ) {
                $(document.activeElement).val(
                  $(document.activeElement).val().replace(sCode, "")
                );
              }
              $("#proBarCodeEdt").val(sCode);
            } else if ($("#infoProdutoModal-modal").hasClass("in")) {
              // Se não está em nenhuma das outras telas, mostra o modal de informações do produto.
              infoScanProduct(sCode);
            }
          },
          onKeyDetect: function (iKeyCode) {
            // output all potentially relevant key events - great for debugging!
          },
          onScanError: function (oDebug) {},
          onPaste: function (sPasted, oEvent) {},
        });
      };

      $scope.insereProdutoComissionadoComanda = function (
        profissionalSelecionado
      ) {
        showLoader(true);

        var valorcomissaoprofissional =
          profissionalSelecionado.valor *
          (profissionalSelecionado.comissao / 100);

        $.ajax({
          type: "POST",
          url: "/pages/cadastros/insereComandaItensv2.php",
          data: {
            comcodigo: profissionalSelecionado.comcodigo,
            procodigo: profissionalSelecionado.procodigo,
            valor: profissionalSelecionado.valor,
            valorunitario: profissionalSelecionado.valorunitario,
            cittoken: "",
            citvenda: 0,
            citcomissaoproduto: valorcomissaoprofissional,
            pescodigoprocomissao: profissionalSelecionado.pescodigoprocomissao,
            citcortesia: 0,
            iscombo: 0,
            qtd: 1,
          },
          dataType: "json",
          success: function (result) {
            if (result.result[0].erro == "0") {
              $("#profissionalComissaoBarCode-modal").modal("hide");
              $scope.atualizaDadosItens();
              if (location.hash == "#/comandasabertas") {
                $rootScope.$emit("atualizaDadosComanda", {});
              }

              toastr.success(result.result[0].resultado);
            } else {
              toastr.error(result.result[0].resultado);
            }
            showLoader(false);
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            if ($("#comProduto option:selected").get(0).dataset.iscombo == 0) {
              $("#comValorInsert").attr("disabled", true);
            }
            showLoader(false);
          },
        });
      };

      $scope.goToContratar = function () {
        $state.go("contratacao");
      };

      function addScanProduct(sCode) {
        showLoader(true);
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaProdutosv3.php",
          data: {
            codigobarras: sCode,
            tipo: 3,
          },
          success: function (result) {
            if (result && result.data && result.data.length > 0) {
              if (
                result.data[0].Pro_Comissao != "" &&
                result.data[0].Pro_Comissao != "0"
              ) {
                // Busca Profissionais Comissão
                $scope.listProfissionaisComissaoCodigoBarras = new Array();
                $.ajax({
                  dataType: "json",
                  method: "POST",
                  url: "/pages/cadastros/buscaPessoaProduto.php",
                  data: {
                    procodigo: result.data[0].Pro_Codigo,
                    tipo: 2,
                  },
                  success: function (resultProfissionais) {
                    if (
                      resultProfissionais &&
                      resultProfissionais.data &&
                      resultProfissionais.data.length > 0
                    ) {
                      resultProfissionais.data.forEach((element) => {
                        var imagemProfissional =
                          "https://sistema.appbarber.com.br/img/nopicture.png";

                        if (
                          element.PAF_Imagem != undefined &&
                          element.PAF_Imagem != ""
                        ) {
                          imagemProfissional = element.PAF_Imagem;
                        }

                        $scope.listProfissionaisComissaoCodigoBarras.push({
                          comcodigo: $("#idComanda").html(),
                          procodigo: result.data[0].Pro_Codigo,
                          valor: result.data[0].Pro_Valor.replace(",", "."),
                          valorunitario: result.data[0].Pro_Valor.replace(
                            ",",
                            "."
                          ),
                          comissao: element.comissao,
                          pescodigoprocomissao: element.Pes_Codigo,
                          apelido: element.Pes_Apelido,
                          imagem: imagemProfissional,
                        });
                      });
                      $scope.$apply();
                      $("#profissionalComissaoBarCode-modal").modal();
                    }
                  },
                });
              } else {
                $.ajax({
                  type: "POST",
                  url: "/pages/cadastros/insereComandaItensv2.php",
                  data: {
                    comcodigo: $("#idComanda").html(),
                    procodigo: result.data[0].Pro_Codigo,
                    valor: result.data[0].Pro_Valor.replace(",", "."),
                    valorunitario: result.data[0].Pro_Valor.replace(",", "."),
                    cittoken: "",
                    citvenda: 0,
                    citcomissaoproduto: "",
                    pescodigoprocomissao: "",
                    citcortesia: 0,
                    iscombo: 0,
                    qtd: 1,
                  },
                  dataType: "json",
                  success: function (result) {
                    if (result.result[0].erro == "0") {
                      $scope.atualizaDadosItens();
                      if (location.hash == "#/comandasabertas") {
                        $rootScope.$emit("atualizaDadosComanda", {});
                      }

                      toastr.success(result.result[0].resultado);
                    } else {
                      toastr.error(result.result[0].resultado);
                    }
                  },
                  error: function (result) {
                    toastr.error("Falha na conexão.");
                    if (
                      $("#comProduto option:selected").get(0).dataset.iscombo ==
                      0
                    ) {
                      $("#comValorInsert").attr("disabled", true);
                    }
                  },
                });
              }
            } else {
              toastr.error(
                `Não foi encontrado nenhum produto cadastrado com o código de barras ${sCode}`
              );
            }
            showLoader(false);
          },
        });
      }

      function infoScanProduct(sCode) {
        showLoader(true);
        $.ajax({
          dataType: "json",
          url: "/pages/cadastros/buscaProdutosv3.php",
          data: {
            codigobarras: sCode,
            tipo: 3,
          },
          success: function (result) {
            if (result && result.data && result.data.length > 0) {
              $("#nomeProdutoScan").html(result.data[0].Pro_Descricao);
              $("#marcaProdutoScan").html(result.data[0].Pro_Marca);
              $("#valorProdutoScan").html(
                result.data[0].Moeda + " " + result.data[0].Pro_Valor
              );
              $("#valorProfProdutoScan").html(
                result.data[0].Moeda + " " + result.data[0].Pro_Vlr_Profissional
              );
              $("#qtdEmEstoqueProdutoScan").html(result.data[0].Pro_Saldo);

              $("#modeloProdutoScan").html(result.data[0].Pro_Descricao);

              if (result.data[0].Pro_Categoria == "") {
                $("#marcaProdutoScan").html("Não informada.");
              } else {
                $("#marcaProdutoScan").html(result.data[0].Pro_Marca);
              }

              if (result.data[0].Pro_Categoria == "") {
                $("#modeloProdutoScan").html("Não informada.");
              } else {
                $("#modeloProdutoScan").html(result.data[0].Pro_Categoria);
              }

              if (result.data[0].Pro_Figura == "") {
                $("#imagemProdutoScan").prop("src", "/img/prod_sem_imagem.png");
              } else {
                $("#imagemProdutoScan").prop("src", result.data[0].Pro_Figura);
              }
              document
                .getElementById("flipCardprod")
                .classList.add("flip-card-rotate");
            } else {
              toastr.error(
                `Não foi encontrado nenhum produto cadastrado com o código de barras ${sCode}`
              );
            }
            showLoader(false);
          },
        });
      }

      $scope.initScan();

      setTimeout(function () {
        if ($scope.parnota == 0) {
          $("#emissoesItemMenu").remove();
        }
      }, 20000);

      setTimeout(function () {
        if ($scope.caixinha == 0) {
          $("#itemMenuCaixinha").remove();
        }
      }, 20000);

      const closeComanda = function (
        thisInsereCaixa,
        thisCliCaixinha,
        emiteNota
      ) {
        showLoader(true);
        var parcelado = 0;
        var numPagamentos = 1;
        if ($("#tipoPagamento1 option:selected").val() !== undefined) {
          numPagamentos = 2;
        }
        var tiposPagamento = `${$(
          "#tipoPagamento0 option:selected"
        ).val()},${$scope.isUndefined(
          $("#tipoPagamento1 option:selected").val()
        )}`;
        var tiposBandeiras = `${$(
          "#divBandeiraPag0 option:selected"
        ).val()},${$scope.isUndefined(
          $("#divBandeiraPag1 option:selected").val()
        )}`;
        var valorPagamento = `${$("#valorPagamento0")
          .val()
          .replace(",", ".")},${$scope
          .isUndefined($("#valorPagamento1").val())
          .replace(",", ".")}`;
        var codigoTransacao = `${$scope.isUndefined(
          $("#codigoTransacao0").val()
        )},${$scope.isUndefined($("#codigoTransacao1").val())}`;

        if ($("#parcelarCaixa").get(0).checked) {
          parcelado = "1";
        } else {
          parcelado = "0";
        }

        var numeroParcelas = $("#selVezesParcela").val();
        var periodiciadadeParcelas = $("#selPeriodicidadeVenda").val();
        if (parcelado == "0") {
          periodiciadadeParcelas = "";
        }
        var comCodigo = $("#idComanda").html();

        $.ajax({
          type: "POST",
          url: "/pages/cadastros/atualizaComandav3.php",
          data: {
            comcodigo: comCodigo,
            tipo: 1,
            valorpagamento: valorPagamento,
            tpacodigo: tiposPagamento,
            tbacodigo: tiposBandeiras,
            codtransacao: codigoTransacao,
            inserecaixa: thisInsereCaixa,
            inserecontacli: thisCliCaixinha.contacli,
            inserecaixinha: thisCliCaixinha.caixinha,
            parcelado: parcelado,
            qtdparcela: numeroParcelas,
            periodicidade: periodiciadadeParcelas,
            motivo: "",
            transacao: $("#codigoTransacao0").val(),
            numpagamento: numPagamentos,
          },
          dataType: "json",
          success: function (result) {
            if (result.data[0].erro == "0") {
              $("#linhaPagamento1").remove();
              j = 1;
              $("#comanda-modal").modal("hide");
              $("#divBandeiraPag").hide();

              $("#insereCaixa").prop("checked", true);
              $("#parcelarCaixa").prop("checked", false);
              $("#trParcelar").hide();
              $("#trParcelarPer").hide();

              if (location.hash == "#/agenda") {
                $rootScope.$emit("BuscaAgenda", {});
              } else if (location.hash == "#/comandasabertas") {
                $rootScope.$emit("atualizaDadosComanda", {});
              } else if (location.hash == "#/comandashistorico") {
                $rootScope.$emit("atualizaDadosComandaHistorico", {});
              } else if (location.hash == "#/filaDeEspera") {
                $rootScope.$emit("atualizaDadosFila", {});
              } else if (location.hash == "#/relGerencialEstoque") {
                $rootScope.$emit("atulizaRelEstoque", {});
              }
              if (emiteNota == true) {
                $scope.generateCupom(
                  $("#idComanda").html(),
                  $("#codCliente").val()
                );
              }
              toastr.success(result.data[0].resultado);
              $("#btnFinalizarComanda").prop("disabled", false);
            } else {
              toastr.error(
                result.data[0].resultado,
                "Falha ao Finalizar Comanda."
              );
              $("#btnFinalizarComanda").prop("disabled", false);
            }
            showLoader(false);
          },
          error: function (result) {
            toastr.error("Falha na conexão.");
            if ($("#comProduto option:selected").get(0).dataset.iscombo == 0) {
              $("#comValorInsert").attr("disabled", true);
            }
            $("#btnFinalizarComanda").prop("disabled", false);
          },
        });
      };

      const displayComanda = function (comcodigo) {
        $.ajax({
          dataType: "json",
          url: localStorage.getItem("host"),
          data: {
            metodo: "buscaComanda",
            id: $scope.idCliente,
            comcodigo: comcodigo,
            tipo: 9,
          },
          success: (data) => {
            $("#idComandaExterno").hide();
            $("#iconInfoCliente").hide();
            $("#infoPontosCli").hide();
            let pessoaConta = "";
            let configContaCli = {};
            if (data.result[0].PCo_Saldo_Real < 0.0) {
              configContaCli.typeInsert = 1;
              configContaCli.color = "red";
            } else if (data.result[0].PCo_Saldo_Real > 0.0) {
              configContaCli.typeInsert = 2;
              configContaCli.color = "green";
            }
            $("#nomeClienteComanda").html(data.result[0].ClienteInfo);
            if (data.result[0].TPR_Codigo == 3) {
              $("#TprTipoComanda").html(data.result[0].TPR_Codigo);
              configContaCli.type = "profissional";
            } else {
              configContaCli.type = "cliente";
              $("#TprTipoComanda").html(data.result[0].TPR_Codigo);
              if (data.result[0].Cliente != "") {
                $("#iconInfoCliente").show();
                $("#infoPontosCli").show();

                $.ajax({
                  dataType: "html",
                  url: "/pages/relatorios/buscaProgramaFidelidade.php",
                  method: "POST",
                  data: {
                    selCliente: data.result[0].CodigoCliente,
                    selTipo: 1,
                  },
                  dataType: "json",
                  success: function (data) {
                    if (data.data.length == 1) {
                      $("#stringPontosCli").html(data.data[0].TotalPontos);
                    } else {
                      $("#stringPontosCli").html(0);
                    }
                  },
                });
              }
            }
            pessoaConta += `<label>
									<span style='color:${configContaCli.color}'>
										Saldo na conta do ${configContaCli.type}: ${data.result[0].PCo_Saldo}
									</span>
								</label>&nbsp&nbsp
								<button ng-click='detalhesContaCliente()' class='btn btn-primary btn-xs'>Ver detalhes</button>&nbsp<button id='btnPagacomanda' class='btn btn-warning btn-xs' ng-click='pagaContaCliente(2,${data.result[0].PCo_Saldo_Real})'>Pagar</button>`;

            $("#pessoaConta").html(pessoaConta);
            $compile($("#pessoaConta"))($scope);
            $("#idComanda").html(data.result[0].Com_Codigo);
            $("#idComandaExterno").html(data.result[0].CCE_Cod_Externo);

            if (data.result[0].CCE_Cod_Externo != "") {
              $("#idComandaExterno").show();
            }
            $("#dataComanda").html(data.result[0].Com_Dat_Cadastro);
            $("#edtComCartao").val(data.result[0].Com_Cod_Externo);
            $("#codCliente").val(data.result[0].CodigoCliente);
            var PromissePagamento = new Promise((resolve, reject) => {
              resolve($scope.atualizaTipoPagemento());
            });
            PromissePagamento.then(() => {
              $scope.buscaItensComanda(comcodigo);
            });
            $("#comanda-modal").modal("show");
          },
          error: (data) => {},
        });
      };

      $scope.setDestinoVale = function (tipo) {
        var datetoday = moment().locale("pt-br").format("L");

        $(".date.divDataFinVale").datepicker("update", datetoday);
        $("#destinoVale").val(tipo);
        $("#codigoCaixaVale").val($(".caxCodigoSai").val());
        if (tipo == 1) {
          $("#divDataFinVale").hide();
          $scope.tiposPagamento = $_CONFIG.LISTA_PAGAMAENTO;
          $scope.buscaValeLancamento();
        } else {
          $("#divDataFinVale").show();
        }
      };

      $scope.buscaValeLancamento = function () {
        var vale = "";
        var pagamento = "";
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/buscaDespesa.php",
          dataType: "json",
          success: function (result) {
            if (result.data.length >= 1) {
              for (var i = 0; i < result.data.length; i++) {
                if (result.data[i].TDe_Vale == "1") {
                  vale +=
                    "<option value='" +
                    result.data[i].TDe_Codigo +
                    "' >" +
                    result.data[i].TDe_Descricao +
                    "</option>";
                }
              }
            } else {
              vale += "<option value='' >Sem Vales Cadastrados</option>";
            }

            $("#buscaTipoVale").html(vale);
          },
          error: function (result) {},
        });

        pagamento += "<option value='' >Nenhum</option>";

        for (var i = 0; i < $scope.tiposPagamento.length; i++) {
          pagamento +=
            "<option value='" +
            $scope.tiposPagamento[i].TPa_Codigo +
            "' >" +
            $scope.tiposPagamento[i].TPa_Descricao +
            "</option>";
        }
        $("#tipoPagamentoVale").html(pagamento);
      };
      $scope.buscaValeLancamento();

      $scope.salvaValeProfissional = function () {
        $("#btnSalvaMovimentacaoVale").attr("disabled", true);

        if ($("#buscaTipoVale").val() != "") {
          if ($("#profissionalSelVale").val() != "") {
            if ($("#destinoVale").val() == 1) {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/insereFinanceiroCaixaMovimentacao.php",
                data: {
                  codigo: $("#codigoCaixaVale").val(),
                  valor: $("#valorValeProfissional").val(),
                  descricao: `Vale no CAIXA para o profissional ${$(
                    "#profissionalSelVale option:selected"
                  ).text()}:  ${$("#profissionalObsVale").val()}`,
                  tipo: 0,
                  tdecodigo: $("#buscaTipoVale").val(),
                  proximocaixa: 0,
                  profissional: $("#profissionalSelVale").val(),
                  sangria: 0,
                  tpacodigo: $("#tipoPagamentoVale").val(),
                },
                dataType: "json",
                success: (result) => {
                  if (result.result[0].erro == "0") {
                    toastr.success(result.result[0].resultado);
                    $("#cadastraVale-modal").modal("hide");
                    $("#valorValeProfissional").val("");
                    $("#buscaTipoVale").val("");
                    $("#tipoPagamentoVale").val("");
                    $("#profissionalSelVale").val("");
                    $("#btnSalvaMovimentacaoVale").attr("disabled", false);
                  } else {
                    swal(result.result[0].resultado, "", "error");
                    $("#btnSalvaMovimentacaoVale").attr("disabled", false);
                  }
                  showLoader(false);
                },
                error: () => {
                  $("#btnSalvaMovimentacaoVale").attr("disabled", false);
                  swal("Falha na conexão.", "", "error");
                  showLoader(false);
                },
              });
            } else {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/insereFinanceirov4.php",
                data: {
                  finDescricao: `Vale no FINANCEIRO para o profissional ${$(
                    "#profissionalSelVale option:selected"
                  ).text()}:  ${$("#profissionalObsVale").val()} `,
                  finValor: $("#valorValeProfissional").val(),
                  finEntradaSaida: 0,
                  finData: $("#finDataVale").val(),
                  finBaixado: 1,
                  buscaDespesa: $("#buscaTipoVale").val(),
                  buscaProfissional: $("#profissionalSelVale").val(),
                  tipoPagamento: $("#tipoPagamentoVale").val(),
                  buscaConta: $("#buscaContaValeFin").val(),
                },
                dataType: "json",
                success: function (result) {
                  if (result.result[0].erro == "0") {
                    $("#cadastraVale-modal").modal("hide");
                    $("#valorValeProfissional").val("");
                    $("#buscaTipoVale").val("");
                    $("#tipoPagamentoVale").val("");
                    $("#profissionalSelVale").val("");
                    $("#finDataVale").val("");
                    toastr.success(result.result[0].resultado);
                    $("#btnSalvaMovimentacaoVale").attr("disabled", false);
                  } else {
                    toastr.error(result.result[0].resultado);
                    $("#btnSalvaMovimentacaoVale").attr("disabled", false);
                  }
                  showLoader(false);
                },
                error: function (result) {
                  toastr.error("Falha na conexão.");
                  $("#btnSalvaMovimentacaoVale").attr("disabled", false);
                  showLoader(false);
                },
              });
            }
          } else {
            toastr.error("Favor informe o profissional");
            $("#btnSalvaMovimentacaoVale").attr("disabled", false);
          }
        } else {
          toastr.error("Favor informe o tipo de vale");
          $("#btnSalvaMovimentacaoVale").attr("disabled", false);
        }
      };

      $scope.cadastrarValeSistema = function () {
        showLoader(true);
        $.ajax({
          type: "POST",
          url: "/pages/cadastros/insereDespesa.php",
          data: {
            Despesa: $("#DescricaoValeSistema").val(),
            vale: $("#indicaValeSistema").val(),
          },
          dataType: "json",
          success: (result) => {
            if (result.data[0].erro == "0") {
              toastr.success(result.data[0].resultado);
              $("#novovale-modal").modal("hide");
              $("#DescricaoValeSistema").val("");
              $scope.buscaValeLancamento();
            } else {
              toastr.error(result.data[0].resultado);
            }
            showLoader(false);
          },
          error: () => {
            toastr.error("Falha na conexão.");
            showLoader(false);
          },
        });
      };

      $scope.undoFlipProd = function () {
        document
          .getElementById("flipCardprod")
          .classList.remove("flip-card-rotate");
        $("#nomeProdutoScan").html("Informações do Produto");
      };

      $scope.imprimirVerDia = function () {
        PrintElem("Ver Dia", "#printVerDia");
      };

      $("#parceladoContaCliModal").change(() => {
        if ($("#ContaCliValorEnt").val() != "") {
          if ($("#parceladoContaCliModal").val() == "1") {
            $(".divNumParcelasModal").show();
            var valorParcela = $("#ContaCliValorEnt").maskMoney("unmasked")[0];
            var parcelas = "";
            for (var i = 2; i <= 12; i++) {
              parcelas += `<option value='${i}'>${i}X de ${$_CONFIG.MOEDA} ${(
                valorParcela / i
              )
                .toFixed(2)
                .replace(".", ",")}</option>`;
            }

            $("#numParcelasContaCliModal").html(parcelas);
          } else {
            $(".divNumParcelasModal").hide();
          }
        } else {
          $(".divNumParcelasModal").hide();
          $("#parceladoContaCliModal").val(0);
          toastr.warning("Informe o valor para realizar o parcelamento");
        }
      });

      $("#ContaCliValorEnt").keyup(() => {
        if ($("#parceladoContaCliModal").val() == "1") {
          if ($("#ContaCliValorEnt").val() == "0,00") {
            $("#parceladoContaCliModal").val(0).change();
          } else {
            var valorParcela = $("#ContaCliValorEnt").maskMoney("unmasked")[0];
            var parcelas = "";
            for (var i = 2; i <= 12; i++) {
              parcelas += `<option value='${i}'>${i}X de ${$_CONFIG.MOEDA} ${(
                valorParcela / i
              )
                .toFixed(2)
                .replace(".", ",")}</option>`;
            }
          }

          $("#numParcelasContaCliModal").html(parcelas);
        }
      });

      $scope.generateCupomAssinatura = function (
        apfcodigo,
        assvalor,
        assdescricao,
        cliente,
        tipoassinatura = 1
      ) {
        if ($scope.parnfssinatura == 1 && $scope.parnota == 1) {
          $("#apfCodigoNotaAssinatura").val(apfcodigo);

          $("#valorCupomNotaAssinatura").html(assvalor);
          $("#valorCupomDisplayNotaAssinatura").val(
            `${$_CONFIG.MOEDA} ${assvalor.replace(",", ".")}`
          );
          $("#servicosPrestadosNotaAssinatura").html(assdescricao);
          $("#servicosPrestadosDisplayNotaAssinatura").val(assdescricao);

          var html = "<option value=''>Estado</option>";
          for (var i = 0; i < $_CONFIG.LISTA_ESTADO.length; i++) {
            html +=
              "<option value='" +
              $_CONFIG.LISTA_ESTADO[i].Est_Sigla +
              "'> " +
              $_CONFIG.LISTA_ESTADO[i].Est_Sigla +
              "</option>";
          }

          $("#cliCupomUFNotaAssinatura").html(html);

          $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaPessoa.php",
            async: false,
            data: {
              tipo: 1,
            },
            dataType: "json",
            success: function (result) {
              $scope.dadosEmpresaNotaAssinatura = result.buscaPessoa[0];
              $("#empresaCNAENotaAssinatura").val(result.buscaPessoa[0].CNAE);
              // $("#empresaCodigoNFAssinatura").val(result.buscaPessoa[0].CodigoNF);

              var codigoempresahtml = `<option value="${result.buscaPessoa[0].CodigoNF}">${result.buscaPessoa[0].CNPJ}</option>`;
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/buscaPessoaEnotas.php",
                dataType: "json",
                async: false,
                success: function (result) {
                  if (result.data.length > 0) {
                    for (var i = 0; i < result.data.length; i++) {
                      codigoempresahtml += `<option value="${result.data[i].PEn_Codigo_GW}">${result.data[i].PEn_CNPJ}</option>`;
                    }
                  }
                },
                error: function (result) {},
              });

              $("#empresaCodigoNFAssinatura").html(codigoempresahtml);

              $scope.emiteSemClientePacote =
                result.buscaPessoa[0].Cid_Emissao_SemCliente;
              $scope.emiteSemCPFPacote =
                result.buscaPessoa[0].Cid_Emissao_SemCPF;
              $scope.emiteSemEnderecoPacote =
                result.buscaPessoa[0].Cid_Emissao_SemEndereco;
              $("#empresaCSTNotaAssinatura").val(result.buscaPessoa[0].CST);

              if ($scope.emiteSemCliente == 0) {
                $("#nomeObrigatorioNotaAssinatura").show();
              } else {
                $("#nomeObrigatorioNotaAssinatura").hide();
              }

              if ($scope.emiteSemCPF == 0) {
                $("#CPFObrigatorioNotaAssinatura").show();
              } else {
                $("#CPFObrigatorioNotaAssinatura").hide();
              }

              if ($scope.emiteSemEndereco == 0) {
                $("#EstadoObrigatorioNotaAssinatura").show();
                $("#CidadeObrigatorioNotaAssinatura").show();
                $("#CepObrigatorioNotaAssinatura").show();
                $("#BairroObrigatorioNotaAssinatura").show();
                $("#NumeroObrigatorioNotaAssinatura").show();
                $("#LogradouroObrigatorioNotaAssinatura").show();
              } else {
                $("#EstadoObrigatorioNotaAssinatura").hide();
                $("#CidadeObrigatorioNotaAssinatura").hide();
                $("#CepObrigatorioNotaAssinatura").hide();
                $("#BairroObrigatorioNotaAssinatura").hide();
                $("#LogradouroObrigatorioNotaAssinatura").hide();
                $("#NumeroObrigatorioNotaAssinatura").hide();
              }
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
            },
          });

          $.ajax({
            type: "POST",
            url: "/pages/cadastros/buscaPessoaNatureza.php",
            data: {
              tipo: "1",
            },
            dataType: "json",
            success: function (result) {
              var naturezalista = "";
              for (var i = 0; i < result.data.length; i++) {
                naturezalista += `<option value='${result.data[i].Nat_Codigo_Externo}'  data-nbs='${result.data[i].Nat_NBS}' data-itemlista='${result.data[i].PNa_Codigo_Municipal_Servico}' data-aliquota='${result.data[i].PNa_Aliquota}'>${result.data[i].Nat_Descricao}</option>`;
              }
              $("#servicoNaturezaNotaAssinatura").html(naturezalista);
              $("#servicoNaturezaNotaAssinatura").select2();
            },
            error: function (result) {
              toastr.error("Falha na conexão.");
            },
          });

          if (cliente != "") {
            $.ajax({
              type: "POST",
              url: "/pages/cadastros/buscaClienteAlteraAgenda.php",
              data: {
                cliente: cliente,
              },
              dataType: "json",
              success: function (result) {
                $scope.dadosClienteNotaAssinatura = result.result[0];
                $("#cliCupomNomeNotaAssinatura").val(result.result[0].Pes_Nome);
                $("#cliCupomEmailNotaAssinatura").val(
                  result.result[0].Paf_Email
                );
                $("#cliCupomCPFNotaAssinatura").val(result.result[0].Paf_Cpf);
                $("#cliCupomCEPNotaAssinatura").val(result.result[0].Paf_CEP);
                $("#cliCupomUFNotaAssinatura").val(result.result[0].Est_Sigla);
                $("#cliCupomCidadeNotaAssinatura").val(
                  result.result[0].Cid_Nome
                );
                $("#cliCupomBairroNotaAssinatura").val(
                  result.result[0].Paf_Bairro
                );
                $("#cliCupomLogradouroNotaAssinatura").val(
                  result.result[0].Paf_Endereco
                );
                $("#cliCupomNumeroNotaAssinatura").val(
                  result.result[0].Paf_Numero
                );
                $("#cliCupomComplementoNotaAssinatura").val(
                  result.result[0].Paf_Complemento
                );
                $("#cliCupomNomeProdNotaAssinatura").val(
                  result.result[0].Pes_Nome
                );
                $("#cliCupomEmailProdNotaAssinatura").val(
                  result.result[0].Paf_Email
                );
                $("#cliCupomCPFProdNotaAssinatura").val(
                  result.result[0].Paf_Cpf
                );
                $("#cliCupomCEPProdNotaAssinatura").val(
                  result.result[0].Paf_CEP
                );
                $("#cliCupomUFProdNotaAssinatura").val(
                  result.result[0].Est_Sigla
                );
                $("#cliCupomCidadeProdNotaAssinatura").val(
                  result.result[0].Cid_Nome
                );
                $("#cliCupomBairroProdNotaAssinatura").val(
                  result.result[0].Paf_Bairro
                );
                $("#cliCupomLogradouroProdNotaAssinatura").val(
                  result.result[0].Paf_Endereco
                );
                $("#cliCupomNumeroProdNotaAssinatura").val(
                  result.result[0].Paf_Numero
                );
                $("#cliCupomComplementoProdNotaAssinatura").val(
                  result.result[0].Paf_Complemento
                );
                $("#cliCupomTelefoneProdNotaAssinatura").val(
                  result.result[0].Paf_Celular
                );
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
              },
            });
          }

          if ($scope.parnfdescontoparceiro == 1) {
            var obsParceiro = "";
            var valorComissao = 0.0;
            if (tipoassinatura == 1) {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/buscaAssinaturaComissaoNotaParceiro.php",
                async: false,
                data: {
                  tipo: "1",
                  dataini: "",
                  datafim: "",
                  apfcodigo: apfcodigo,
                },
                dataType: "json",
                success: function (data) {
                  if (data.data.length > 0) {
                    for (var i = 0; i < data.data.length; i++) {
                      var dadoComissaoLoop = data.data[i].ComissaoReceber;
                      var dadoPesCodigoLoop = data.data[i].CodigoProfissional;
                      if (
                        dadoPesCodigoLoop != "" &&
                        dadoPesCodigoLoop != undefined
                      ) {
                        $.ajax({
                          type: "POST",
                          url: "/pages/cadastros/buscaPessoav2.php",
                          async: false,
                          data: {
                            tipo: 2,
                            pescodigo: dadoPesCodigoLoop,
                          },
                          dataType: "json",
                          success: function (result) {
                            if (result.data.length != 0) {
                              if (
                                result.data[0].PAF_CPF != "" &&
                                result.data[0].PNa_Codigo != ""
                              ) {
                                var cnpjParceiro = result.data[0].PAF_CPF;
                                $.ajax({
                                  type: "POST",
                                  url: "/pages/cadastros/buscaPessoaNaturezav2.php",
                                  async: false,
                                  data: {
                                    tipo: "1",
                                    pescodigo: dadoPesCodigoLoop,
                                  },
                                  dataType: "json",
                                  success: function (result) {
                                    var valorcomissaodesconto = parseFloat(
                                      dadoComissaoLoop.replace(",", ".")
                                    );
                                    valorComissao =
                                      valorComissao + valorcomissaodesconto;
                                    var profissional = "";
                                    if ($scope.nomeProfissionalNota == 1) {
                                      profissional = `${result.data[0].Pes_Nome},`;
                                    }

                                    if (
                                      cnpjParceiro.replace(/\D/g, "").length >=
                                      14
                                    ) {
                                      obsParceiro += `R$ ${valorcomissaodesconto.toFixed(
                                        2
                                      )} de cota-parte profissional parceiro ${profissional} CNPJ ${cnpjParceiro}, emitida no código: ${
                                        result.data[0].Codigo
                                      };\n`;
                                    } else {
                                      obsParceiro += `R$ ${valorcomissaodesconto.toFixed(
                                        2
                                      )} de cota-parte profissional parceiro ${profissional} CPF ${cnpjParceiro}, emitida no código: ${
                                        result.data[0].Codigo
                                      };\n`;
                                    }
                                  },
                                  error: function (result) {
                                    toastr.error("Falha na conexão.");
                                  },
                                });
                              }
                            }
                          },
                          error: function (result) {
                            toastr.error("Falha na conexão.");
                          },
                        });
                      }
                    }
                  }
                },
                error: function (result) {
                  toastr.error("Falha na conexão.");
                },
              });
            } else {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/PLANO_ASSINATURA_Busca_Comissao.php",
                async: false,
                data: {
                  type: 3,
                  professional_code: "",
                  start_date: "",
                  end_date: "",
                  client_subscription_finantial_code: apfcodigo,
                },
                dataType: "json",
                success: function (data) {
                  if (data.data.length > 0) {
                    for (var i = 0; i < data.data.length; i++) {
                      var dadoComissaoLoop =
                        data.data[i].professional_value.toString();
                      var dadoPesCodigoLoop = data.data[i].professional_code;
                      if (
                        dadoPesCodigoLoop != "" &&
                        dadoPesCodigoLoop != undefined
                      ) {
                        $.ajax({
                          type: "POST",
                          url: "/pages/cadastros/buscaPessoav2.php",
                          async: false,
                          data: {
                            tipo: 2,
                            pescodigo: dadoPesCodigoLoop,
                          },
                          dataType: "json",
                          success: function (result) {
                            if (result.data.length != 0) {
                              if (
                                result.data[0].PAF_CPF != "" &&
                                result.data[0].PNa_Codigo != ""
                              ) {
                                var cnpjParceiro = result.data[0].PAF_CPF;
                                $.ajax({
                                  type: "POST",
                                  url: "/pages/cadastros/buscaPessoaNaturezav2.php",
                                  async: false,
                                  data: {
                                    tipo: "1",
                                    pescodigo: dadoPesCodigoLoop,
                                  },
                                  dataType: "json",
                                  success: function (result) {
                                    var valorcomissaodesconto = parseFloat(
                                      dadoComissaoLoop.replace(",", ".")
                                    );
                                    valorComissao =
                                      valorComissao + valorcomissaodesconto;
                                    var profissional = "";
                                    if ($scope.nomeProfissionalNota == 1) {
                                      profissional = `${result.data[0].Pes_Nome},`;
                                    }

                                    if (
                                      cnpjParceiro.replace(/\D/g, "").length >=
                                      14
                                    ) {
                                      obsParceiro += `R$ ${valorcomissaodesconto.toFixed(
                                        2
                                      )} de cota-parte profissional parceiro ${profissional} CNPJ ${cnpjParceiro}, emitida no código: ${
                                        result.data[0].Codigo
                                      };\n`;
                                    } else {
                                      obsParceiro += `R$ ${valorcomissaodesconto.toFixed(
                                        2
                                      )} de cota-parte profissional parceiro ${profissional} CPF ${cnpjParceiro}, emitida no código: ${
                                        result.data[0].Codigo
                                      };\n`;
                                    }
                                  },
                                  error: function (result) {
                                    toastr.error("Falha na conexão.");
                                  },
                                });
                              }
                            }
                          },
                          error: function (result) {
                            toastr.error("Falha na conexão.");
                          },
                        });
                      }
                    }
                  }
                },
                error: function (result) {
                  toastr.error("Falha na conexão.");
                },
              });
            }
          }

          var infoOrigem = "";
          var infoProcon = "";
          if ($scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 189886) {
            infoOrigem =
              "Fonte: IBPT/FECOMERCIO RJ - 18.1.A Resolução CGSN Nº 137, de 04 de Dezembro de 2017.\n";
          } else if (
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 8866546 ||
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 12690404 ||
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 320798 ||
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 7007706 ||
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 3224558 ||
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 13329906 ||
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 1034072 ||
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 20271388 ||
            $scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 20657910
          ) {
            infoOrigem =
              "EMISSAO DE NOTA CONFORME RESOLUCAO CGSN N. 140, DE 22 DE MAIO DE 2018\n";
          } else if ($scope.dadosEmpresaNotaAssinatura.Pes_Codigo == 17774557) {
            infoOrigem =
              "Serviço prestado sob regime de parceria nos termos da Lei nº 13.352/2016\n";
          }else if ($scope.dadosEmpresaNota.Pes_Codigo == 10839540) {
            infoOrigem =
              "Valor aproximado dos tributos: 17,29% - Fonte IBPT\n";
          }

          if ($scope.dadosEmpresaNotaAssinatura.Cid_Codigo != "") {
            $.ajax({
              type: "POST",
              url: "/pages/cadastros/buscaCidadeProcon.php",
              async: false,
              data: {
                cidcodigo: $scope.dadosEmpresaNotaAssinatura.Cid_Codigo,
              },
              dataType: "json",
              success: function (result) {
                if (result.data.length > 0) {
                  infoProcon = `TELEFONE DO PROCON: ${result.data[0].CPo_Telefone} \n ENDERECO DO PROCON: ${result.data[0].CPo_Endereco}`;
                }
              },
              error: function (result) {
                toastr.error("Falha na conexão.");
              },
            });
          }

          if ($scope.parnfdescontoparceiro == 1) {
            var valorServicos = parseFloat(
              $("#valorCupomNotaAssinatura")
                .html()
                .replace($_CONFIG.MOEDA, "")
                .replace(",", ".")
            );
            if ($scope.parDescriaoSalaoParceiro == 1) {
              $("#valorComissaoDisplayNotaAssinatura").val(0.0);
            } else {
              $("#valorComissaoDisplayNotaAssinatura").val(
                valorComissao.toFixed(2)
              );
            }
            if (obsParceiro != "") {
              $("#cliCupomObsNotaAssinatura").val(
                `${infoOrigem}R$ ${(valorServicos - valorComissao).toFixed(
                  2
                )} de cota-parte do salão parceiro: ${
                  $scope.dadosEmpresaNotaAssinatura.CNPJ
                }\n${obsParceiro} \n\n\n ${infoProcon}`
              );
            } else {
              $("#cliCupomObsNotaAssinatura").val(
                `${infoOrigem}\n\n\n ${infoProcon}`
              );
            }
          } else {
            $("#valorComissaoDisplayNotaAssinatura").val(0.0);
            $("#cliCupomObsNotaAssinatura").val(
              `${infoOrigem} \n\n\n ${infoProcon}`
            );
          }

          setTimeout(() => {
            if ($scope.parEnderecoNota == 0) {
              $("#usaEnderecoNotaAssinatura").val(0).change();
            } else {
              $("#usaEnderecoNotaAssinatura").val(1).change();
            }
          }, 1000);

          $("#generateCupomAssinatura-modal").modal();
        }
      };

      $scope.criaCupomNotaAssinatura = function () {
        showLoader(true);
        var timegerado = new Date().getTime();
        var proceedNota = 1;
        var msgerro = "";

        if ($scope.emiteSemEnderecoPacote == undefined) {
          $scope.emiteSemEnderecoPacote = 1;
        } else if ($scope.emiteSemEnderecoPacote == 0) {
          if (
            $("#cliCupomUFNotaAssinatura").val() == "" ||
            $("#cliCupomUFNotaAssinatura").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o estado do cliente.";
          } else if (
            $("#cliCupomCidadeNotaAssinatura").val() == "" ||
            $("#cliCupomCidadeNotaAssinatura").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe a cidade do cliente.";
          } else if (
            $("#cliCupomCEPNotaAssinatura").val() == "" ||
            $("#cliCupomCEPNotaAssinatura").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o CEP do cliente.";
          } else if (
            $("#cliCupomBairroNotaAssinatura").val() == "" ||
            $("#cliCupomBairroNotaAssinatura").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o bairro do cliente.";
          } else if (
            $("#cliCupomLogradouroNotaAssinatura").val() == "" ||
            $("#cliCupomLogradouroNotaAssinatura").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o logradouro do cliente.";
          } else if (
            $("#cliCupomNumeroNotaAssinatura").val() == "" ||
            $("#cliCupomNumeroNotaAssinatura").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o endereço do tomador do serviço. Favor informe o numero do endereço do cliente.";
          }
        }

        if ($scope.emiteSemCPFPacote == undefined) {
          $scope.emiteSemCPFPacote = 1;
        } else if ($scope.emiteSemCPFPacote == 0) {
          if (
            $("#cliCupomCPFNotaAssinatura").val() == "" ||
            $("#cliCupomCPFNotaAssinatura").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o CPF do tomador do serviço. Favor informe o CPF do cliente.";
          }
        }

        if ($scope.emiteSemClientePacote == undefined) {
          $scope.emiteSemClientePacote = 1;
        } else if ($scope.emiteSemClientePacote == 0) {
          if (
            $("#cliCupomNomeNotaAssinatura").val() == "" ||
            $("#cliCupomNomeNotaAssinatura").val() == undefined
          ) {
            proceedNota = 0;
            msgerro =
              "Sua cidade exige o nome do tomador do serviço. Favor informe o nome do cliente.";
          }
        }

        if (
          $("#enviaCupomEmailNotaAssinatura").val() == "1" &&
          $("#cliCupomEmailNotaAssinatura").val() == ""
        ) {
          proceedNota = 0;
          msgerro = "Informe um e-mail pra o envio a emissão.";
        }

        if (proceedNota == 1) {
          if (
            $("#servicoNaturezaNotaAssinatura option:selected").get(0) !=
            undefined
          ) {
            if (
              $("#empresaCodigoNFAssinatura").val() != "" &&
              $("#empresaCodigoNFAssinatura").val() != undefined
            ) {
              $.ajax({
                type: "POST",
                url: "/pages/cadastros/insereNotaFiscalAssinatura.php",
                data: {
                  apfcodigo: $("#apfCodigoNotaAssinatura").val(),
                  idEmpresa: $("#empresaCodigoNFAssinatura").val(),
                  idExternoNota:
                    $("#apfCodigoNotaAssinatura").val() + "_" + timegerado,
                  enviarEmail: $("#enviaCupomEmailNotaAssinatura").val(),
                  nomeCliente: $("#cliCupomNomeNotaAssinatura").val(),
                  emailCliente: $("#cliCupomEmailNotaAssinatura").val(),
                  cpfCliente: $("#cliCupomCPFNotaAssinatura").val(),
                  logradouroCliente: $(
                    "#cliCupomLogradouroNotaAssinatura"
                  ).val(),
                  numeroCliente: $("#cliCupomNumeroNotaAssinatura").val(),
                  complementoCliente: $(
                    "#cliCupomComplementoNotaAssinatura"
                  ).val(),
                  bairroCliente: $("#cliCupomBairroNotaAssinatura").val(),
                  cepCliente: $("#cliCupomCEPNotaAssinatura").val(),
                  ufCliente: $("#cliCupomUFNotaAssinatura").val(),
                  cidadeCliente: $("#cliCupomCidadeNotaAssinatura").val(),
                  descricaoServico: $(
                    "#servicosPrestadosNotaAssinatura"
                  ).html(),
                  aliquotaIss: parseFloat(
                    $("#servicoNaturezaNotaAssinatura option:selected").get(0)
                      .dataset.aliquota
                  ),
                  itemServico: $(
                    "#servicoNaturezaNotaAssinatura option:selected"
                  ).get(0).dataset.itemlista,
                  cnae: $("#empresaCNAENotaAssinatura").val(),
                  codigoServico: $("#servicoNaturezaNotaAssinatura").val(),
                  valorTotal: parseFloat(
                    $("#valorCupomNotaAssinatura")
                      .html()
                      .replace($_CONFIG.MOEDA, "")
                      .replace(",", ".")
                  ),
                  timegerado: timegerado,
                  valorClss: parseFloat(
                    $("#valorClssNotaAssinatura").html().replace(",", ".")
                  ),
                  valorPis: parseFloat(
                    $("#valorPisNotaAssinatura").html().replace(",", ".")
                  ),
                  valorCofins: parseFloat(
                    $("#valorCofinsNotaAssinatura").html().replace(",", ".")
                  ),
                  valorInss: parseFloat(
                    $("#valorIrNotaAssinatura").html().replace(",", ".")
                  ),
                  valorIr: parseFloat(
                    $("#valorInssNotaAssinatura").html().replace(",", ".")
                  ),
                  observacao: $("#cliCupomObsNotaAssinatura").val(),
                  deducoes: $("#valorComissaoDisplayNotaAssinatura").val(),
                  descricaocidadeservico: $(
                    "#servicoNaturezaNotaAssinatura option:selected"
                  ).get(0).text,
                  metadados: "",
                  codigoNBS: $(
                    "#servicoNaturezaNotaAssinatura option:selected"
                  ).get(0).dataset.nbs,
                  datacompetencia: $("#dataCompetenciaNotaAssinatura").val(),
                },
                dataType: "json",
                success: function (result) {
                  showLoader(false);
                  if (result.data[0].erro == 1) {
                    toastr.warning(result.data[0].resultado);
                  } else {
                    toastr.warning(result.resultNota.erronf);
                    if (
                      result.resultNota.nfid == "" ||
                      result.resultNota.nfid == undefined
                    ) {
                      $.ajax({
                        type: "POST",
                        url: "/pages/cadastros/removeAssinaturaNotaFiscal.php",
                        data: {
                          anfcodigoexterno:
                            $("#apfCodigoNotaAssinatura").val() +
                            "_" +
                            timegerado,
                        },
                        dataType: "json",
                        success: function (data) {
                          if (data.data.erro != undefined) {
                            toastr.error(data.data.resultado);
                          } else {
                            if (data.data[0].erro == "0") {
                              toastr.success(data.data[0].resultado);
                            } else {
                              toastr.error(data.data[0].resultado);
                            }
                          }
                        },
                        error: function (result) {
                          toastr.error("Falha na conexão.");
                        },
                      });
                    }
                  }
                  $("#generateCupomAssinatura-modal").modal("hide");
                },
                error: function (result) {
                  showLoader(false);
                  toastr.error("Falha na conexão.");
                },
              });
            } else {
              showLoader(false);
              toastr.error("Informe o ID da empresa");
            }
          } else {
            showLoader(false);
            toastr.error("Selecione o Serviço");
          }
        } else {
          showLoader(false);
          toastr.error(msgerro);
        }
      };

      $scope.listaClienteTroca = function () {
        $("#clienteListaTrocaNota").select2({
          ajax: {
            url: localStorage.getItem("host"),
            dataType: "json",
            delay: 250,
            data: function (params) {
              return {
                nome: params.term,
                metodo: "buscaClientes_v4",
                tipo: 5,
                id: $_CONFIG.ID,
              };
            },
            processResults: function (data, params) {
              return {
                results: data.result,
              };
            },
            cache: true,
          },
          placeholder: "Sem Cadastro",
          escapeMarkup: function (markup) {
            return markup;
          }, // let our custom formatter work
          minimumInputLength: 3,
          templateResult: thumbClienteName,
          templateSelection: formatRepoSelection,
        });

        $("#listaClienteTrocaNota-modal").modal();
      };

