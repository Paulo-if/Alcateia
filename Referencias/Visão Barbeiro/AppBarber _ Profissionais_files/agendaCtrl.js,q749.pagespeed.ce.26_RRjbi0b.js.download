	$scope.buscaServicoListaAgendamento = function () {
		$.ajax({
			method: "POST",
			dataType: "json",
			url: "/pages/cadastros/buscaServicoSelect.php",
			/*data: {
				profissional: $("#profisisonalHorDisp").val()
			},*/
			success: (data) => {
				$("#serListaAgendamento").html('<option value="">Serviço</option>');
				$("#servicoListaAgenda").html('<option value="">Serviço</option>');
				$("#servicoListaEsperaAltera").html('<option value="">Serviço</option>');

				for (var i = 0; i < data.servicos.length; i++) {
					$("#serListaAgendamento").append('<option value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>');
					$("#servicoListaAgenda").append('<option value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>');
					$("#servicoListaEsperaAltera").append('<option value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>');
				};
				$("#servicoListaAgenda").select2()
				$("#servicoListaEsperaAltera").select2()
			}
		});

	}


	$scope.pesquisaListaAgendamento = function () {
		$("#divListaAgendamento").show();
		if (typeof (tbListaAgendamento) != "undefined") {
			tbListaAgendamento.destroy();
		}
		tbListaAgendamento = $('#tableListaAgendamento').DataTable({
			dom: 'T<"clear">Blfrtip',
			buttons: [{
                extend: 'excelHtml5',
                text: 'Excel',
                exportOptions: {
                    columns: ':visible'
                },
                footer: 'true'
            }, {
                extend: 'pdfHtml5',
                title: sSistema + ' - Lista Agendamentos',
                orientation: 'landscape',
                footer: true,
                pageSize: 'LEGAL',
                exportOptions: {
                    columns: ':visible'
                }
            }, {
                extend: 'print',
                text: 'Imprimir',
                exportOptions: {
                    columns: ':visible'
                },
                footer: true
            }],
			"ajax": {
				"url": "/pages/relatorios/buscaListaAgendamento.php",
				"method": "POST",
				"data": function (d) {
					d.profissional = $("#profListaAgendamento").val();
					d.servico = $("#serListaAgendamento").val();
					d.cliente = $("#cliListaAgendamento").val();
					d.dataini = $("#dataIniListaAgendamento").val();
					d.datafim = $("#dataFimListaAgendamento").val();
					d.tipo = 1;
				}
			},
			"scrollX": isPortrait,
			"initComplete": function (d, i) {
				if (i.erro == "1") {
					toastr.error(i.resultado);
				}
			},
			"columns": [{
					"data": "Age_Dat_Inicio",
					"type": "moment-DD/MM/YYYY hh:mm",
					"title": "Data"
				},
				{
					"data": "CliNome",
					"title": "Cliente"
				},
				{
					"data": "ProNome",
					"title": "Profissional"
				},
				{
					"data": "Ser_Descricao",
					"title": "Serviço"
				},
				{
					"class": 'editaAgendamentoLista',
					"orderable": false,
					"data": null,
					"defaultContent": '<button class="btn btn-success btn-xs"  >Editar</button>',
				},
				{
					"class": 'cancelaHorarioLista',
					"orderable": false,
					"data": null,
					"defaultContent": '<button class="btn btn-danger btn-xs"  >Cancelar</button>',
				},
			],

			"language": {
				"url": "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json"
			}
		});

		$('#tableListaAgendamento tbody').on('click', 'td.cancelaHorarioLista', (e) => {
			var tr = $(e.currentTarget).closest('tr');
			var row = tbListaAgendamento.row(tr);
			var data = row.data();
			$("#AgeCodigoListaCancela").val(data.Age_Codigo);
			$("#cancelarAgendamentoLista-modal").modal()
		});


		$('#tableListaAgendamento tbody').on('click', 'td.editaAgendamentoLista', (e) => {
			var tr = $(e.currentTarget).closest('tr');
			var row = tbListaAgendamento.row(tr);
			var data = row.data();
			$("#citCodigoAlteraAgendamentoLista").val(data.CIt_Codigo);
			$('.date.dateAltAgeLista').datepicker('update', '');
			$("#dataOriginalAgendamento").val(data.DataAgendamento)
			$('.date.dateAltAgeLista').datepicker('update', data.DataAgendamento);
			$("#tipoAlteraAgendamentoLista").val(0).change();
			$scope.buscaProfissionalAlteraAgendamentoLista();
			$scope.buscaServicoAlteraAgendamentoLista(data.ProCodigo)
			$("#editarAgendamentoLista-modal").modal()
		});
	}


	$scope.cancelaAgendamentoLista = function () {

		if ($("#ageMotivoLista").val() == "") {
			toastr.error('Favor informe o motivo do cancelamento!');
		} else {
			showLoader(true);
			$.ajax({
				dataType: "json",
				url: "/pages/actions/cancelaHorario.php",
				method: "POST",
				data: {
					agendamento: $("#AgeCodigoListaCancela").val(),
					motivo: $("#ageMotivoLista").val()
				},
				success: (data) => {
					if (data.cancelaHorario[0].erro == 1) {
						toastr.error(data.cancelaHorario[0].resultado, "");
					} else {
						$('#cancelarAgendamentoLista-modal').modal('hide');
						$scope.pesquisaListaAgendamento();
						$("#ageMotivoLista").val("");
						toastr.success("Agendamento foi cancelado com sucesso.");
					}
					showLoader(false);
				},
				error: () => {
					swal("Falha na conexão.", "", "error");
					showLoader(false);
				}
			});

		}
	}


	$scope.buscaClienteLista = function () {
		if (hasManyClients) {
			$('.select2.clientes').select2({
				ajax: {
					url: "/pages/actions/buscaClientesMany.php",
					dataType: 'json',
					delay: 250,
					data: (params) => {
						return {
							nome: params.term
						};
					},
					processResults: (data, params) => {
						return {
							results: data.result
						};
					},
					cache: true
				},
				placeholder: 'Selecione o Cliente',
				escapeMarkup: (markup) => {
					return markup;
				},
				minimumInputLength: 3,
				templateResult: thumbCliente2,
				templateSelection: formatRepoSelection
			});
		} else {
			var html = '';
			var html2 = '';
			$.ajax({
				dataType: 'json',
				url: "/pages/actions/buscaClientes.php",
				method: "POST",
				data: {
					tipo: 2
				},
				success: (data) => {
					var html = '<option value="">Cliente</option>';
					for (var i = 0; i < data.result.length; i++) {
						var codigo = data.result[i].Pes_Codigo;
						var nome = data.result[i].Pes_Nome;
						var usuario = data.result[i].Usu_Codigo;

						html += '<option value="' + codigo + '" data-usucodigo="' + usuario + '">' + nome + '</option>';
					}
					$('#cliListaAgendamento').html(html);
					$('#pesCodigoClienteListaAgenda').html(html);
					$('.select2.clientes').select2();
				}
			});
		}
	}

	$scope.alteraAgendamentoLista = function () {
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/alteraAgendamento.php",
			data: {
				dataAlteraAgendamento: $("#dataAlteraAgendamentoLista").val(),
				horaAlteraAgendamento: $("#horaAlteraAgendamentoLista").val(),
				tipoAlteraAgendamento: $("#tipoAlteraAgendamentoLista").val(),
				codItem: $("#citCodigoAlteraAgendamentoLista").val(),
				profissionalAlteraAgendamento: $("#profissionalAlteraAgendamentoLista").val(),
				servicoAlteraAgendamento: $("#servicoAlteraAgendamentoLista").val(),
				DuracaoAlteraAgendamento: $("#DuracaoAlteraAgendamentoLista").val()

			},
			dataType: "json",
			success: (result) => {

				if (result.result[0].erro == "0") {
					$("#editarAgendamentoLista-modal").modal('hide');
					$scope.pesquisaListaAgendamento();
					toastr.success(result.result[0].resultado);

				} else {
					toastr.error(result.result[0].resultado);
				}
				showLoader(false);
			},
			error: () => {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});

	}

	$scope.buscaProfissionalAlteraAgendamentoLista = function () {
		$.ajax({
			method: "POST",
			dataType: "json",
			url: "/pages/cadastros/buscaProfissionalSelect.php",
			success: (data) => {
				$("#profissionalAlteraAgendamentoLista").html('<option value="">Selecione um Profissional</option>');
				for (var i = 0; i < data.profissionais.length; i++) {
					$("#profissionalAlteraAgendamentoLista").append('<option value="' + data.profissionais[i].Pes_Codigo + '">' + data.profissionais[i].Pes_Nome + '</option>');
				};
			}
		});
	}

	$scope.buscaServicoAlteraAgendamentoLista = function (codigoProfissional) {
		$.ajax({
			method: "GET",
			dataType: "json",
			url: "/pages/actions/buscaServicos.php",
			method: "POST",
			data: {
				tipo: '2',
				profissional: codigoProfissional
			},
			success: (data) => {
				$("#servicoAlteraAgendamentoLista").html('<option value="">Selecione um Serviço</option>');
				for (var i = 0; i < data.servicos.length; i++) {
					$("#servicoAlteraAgendamentoLista").append('<option value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>');
				};
			}
		});
	}

	$scope.hideDivsAlteraLista = function () {
		$("#divAlteraAgendamentoDataLista").hide();
		$("#divAlteraAgendamentoServicoLista").hide();
		$("#divAlteraAgendamentoProfissionalLista").hide();
		$("#divAlteraAgendamentoDuracaoLista").hide();
	}

	$("#tipoAlteraAgendamentoLista").change(() => {

		$scope.hideDivsAlteraLista();

		$("#profissionalAlteraAgendamentoLista").val('');
		$("#servicoAlteraAgendamentoLista").val('');
		$("#DuracaoAlteraAgendamentoLista").val('');
		$('.date.dateAltAgeLista').datepicker('update', '');
		setTimeout(() => {
			$('.date.dateAltAgeLista').datepicker('update', $("#dataOriginalAgendamento").val());
		}, 200)
		$("#horaAlteraAgendamentoLista").val('');
		$("#dataAlteraAgendamentoLista").val('');
		if ($("#tipoAlteraAgendamentoLista option:selected").val() == 1) {
			$("#divAlteraAgendamentoDataLista ").show();
			$("#profissionalAlteraAgendamentoLista").val('');
			$("#servicoAlteraAgendamentoLista").val('');
			$("#DuracaoAlteraAgendamentoLista").val('');
		} else if ($("#tipoAlteraAgendamentoLista option:selected").val() == 2) {
			$("#divAlteraAgendamentoServicoLista").show();
		} else if ($("#tipoAlteraAgendamentoLista option:selected").val() == 3) {
			$("#divAlteraAgendamentoProfissionalLista").show();
		} else if ($("#tipoAlteraAgendamentoLista option:selected").val() == 4) {
			$("#divAlteraAgendamentoDataLista").show();
			$("#divAlteraAgendamentoProfissionalLista").show();
		} else if ($("#tipoAlteraAgendamentoLista option:selected").val() == 5) {
			$("#divAlteraAgendamentoDataLista").show();
			$("#divAlteraAgendamentoServicoLista").show();
		} else if ($("#tipoAlteraAgendamentoLista option:selected").val() == 6) {
			$("#divAlteraAgendamentoServicoLista").show();
			$("#divAlteraAgendamentoProfissionalLista").show();
		} else if ($("#tipoAlteraAgendamentoLista option:selected").val() == 7) {
			$("#divAlteraAgendamentoDataLista").show();
			$("#divAlteraAgendamentoServicoLista").show();
			$("#divAlteraAgendamentoProfissionalLista").show();
		} else if ($("#tipoAlteraAgendamentoLista option:selected").val() == 8) {
			$("#divAlteraAgendamentoDuracaoLista").show();
			$scope.comboTempoPadrao();
		}
	});

	$("#profissionalAlteraAgendamentoLista").change(() => {
		$scope.buscaServicoAlteraAgendamentoLista($("#profissionalAlteraAgendamentoLista option:selected").val());
	});

	var initCalendar = () => {
		$('#calendar').fullCalendar({
			weekends: true,
			defaultView: 'resourceDay',
			allDayText: $_CONFIG.language.todo_dia,
			allDayDefault: false,
			allDaySlot: false,
			eventDurationEditable: true,
			disableDragging: false,
			editable: false,
			droppable: true,
			minTime: mMinTime,
			maxTime: mMaxTime,
			selectable: true,
			selectHelper: false,
			height: heightAgenda,
			now: curTimeZone,
			selectOverlap: false,
			slotEventOverlap: false,
			handleWindowResize: true,
			slotDuration: '00:' + $_CONFIG.TEMPOPADRAO + ':00',
			resources: resources,
			lazyFetching: true,
			titleFormat: {
				day: 'dddd, D/MMM/YYYY'
			},
			events: $scope.objAgenda,
			header: {
				left: 'prev,next today',
				center: 'title',
				right: 'resourceDay,agendaWeek,month'
			},
			buttonText: {
				today: $_CONFIG.language.hoje,
				month: $_CONFIG.language.mes,
				week: $_CONFIG.language.semana,
				day: $_CONFIG.language.dia
			},
			dateFormat: 'dd/mm/yy',
			axisFormat: 'HH:mm',
			timeFormat: 'HH:mm',
			dayNames: $_CONFIG.language.fc_day,
			dayNamesMin: $_CONFIG.language.fc_day_min,
			dayNamesShort: $_CONFIG.language.fc_day_short,
			monthNames: $_CONFIG.language.fc_month,
			monthNamesShort: $_CONFIG.language.fc_month_min,
			columnFormat: {
				month: 'ddd',
				week: 'ddd D/M',
				day: 'dddd d/M'
			},
			eventMouseout: () => {
				clearTimeout(timevalor);

				$('.popover').popover('hide');
			},
			eventMouseover: (event, jsEvent) => {
				if (event.codStatus != 6) {
					$el = $(jsEvent.currentTarget);
					var content = '';
					titulo = event.title
					if (event.codStatus != 4) {
						if (!$el[0].hasAttribute('data-original-title')) {
							timevalor = setTimeout(() => {

								$.ajax({
									dataType: "json",
									url: "/pages/actions/buscaAgendamentoTipoPagamento.php",
									type: 'POST',
									data: {
										comanda: event.Com_Codigo
									},
									success: (data) => {
										if (typeof (event.valor) !== 'undefined' && event.valor != '') {
											content = content + '<p><h6 class="text-green"><i class="fa fa-dollar"></i>  ' + event.valor + ' - Agendamento</h6></p>';
										} else {
											content = content;
										}
										content = content + '<p><h6 class="text-blue"><i class="fa fa-dollar"></i>  ' + data.result[0].ValorComanda + '- Comanda</h6></p>';

										if (event.CIt_Pag_Online == '1') {
											content = content + '<p><h6 class="text-green"><i class="ion ion-card"></i> Pago Online</h6></p>';
										}

										if (typeof (event.cupom) !== 'undefined' && event.cupom != '') {
											content = content + '<p><h6 class="text-blue"><i class="fa fa-ticket"></i> Cupom: <b>' + event.cupom + '</b></h6></p>';
										}

										if (event.icon != '') {
											content = content + '<p><h6 class="text-red"><i class="fa fa-exclamation-triangle"></i> Já se ausentou</h6></p>';
										}

										if (event.Age_Origem == '1') {
											content = content + '<p><h6><i class="fa fa-apple"></i> iOS - Aplicativo do Profissional</h6></p>';
										} else if (event.Age_Origem == '2') {
											content = content + '<p><h6><i class="fa fa-desktop"></i> Web </h6></p>';
										} else if (event.Age_Origem == '3') {
											content = content + '<p><h6><i class="fa fa-android"></i> Android - Aplicativo do Profissional</h6></p>';
										} else if (event.Age_Origem == 4) {
											content = content + '<p><h6><i class="fa fa-facebook-official"></i> Facebook/Site </h6></p>';
										} else if (event.Age_Origem == '8') {
											content = content + '<p><h6><i class="fa fa-apple"></i> iOS - Aplicativo do Cliente</h6></p>';
										} else if (event.Age_Origem == '9') {
											content = content + '<p><h6><i class="fa fa-android"></i> Android - Aplicativo do Cliente</h6></p>';
										}else if (event.Age_Origem == '10') {
											content = content + '<p><h6><i class="fa fa-map-marker"></i> Totem </h6></p>';
										}


										$.ajax({
											dataType: "json",
											url: "/pages/cadastros/buscaAgendamentoTag.php",
											type: 'GET',
											async: false,
											data: {
												agecodigo: event.id,
												id: $_CONFIG.ID
											},
											success: (data) => {
												if (data.data.length > 0) {
													for (var i = 0; i < data.data.length; i++) {
														content = content + `<label class="label" id="tagLabelPopUp${data.data[i].ATa_Codigo}"  style="background-color:${data.data[i].ATa_Cor}">${data.data[i].ATa_Descricao}</label><br>`
													}
												}
											}
										});

										if (event.rec == 1) {
											$.ajax({
												dataType: "json",
												url: "/pages/cadastros/buscaAgendamentoRecorrente.php",
												type: 'GET',
												async: false,
												data: {
													agendamento: event.id,
													id: $_CONFIG.ID
												},
												success: (data) => {
													if (data.data.length > 0) {
														if (data.data.length > 0) {
															if (data.data[0].erro == undefined) {
																for (var i = 0; i < data.data.length; i++) {
																	content = content + `<b>Agendamento recorrente ${data.data[i].AgendamentoAtual}/${data.data[i].TotalAgendamento}</b>`
																}
															} else {
																content = content + '<b>Este agendamento é recorrente';
															}
														}

													}
												}
											});
										}

										content = content + '<br><p class="text-center"><button type="button" id="close" class="btn btn-primary btn-xs" onclick="$(&quot;.popover&quot;).popover(&quot;hide&quot;);">Fechar</button></p>';

										$el.popover({
											html: true,
											title: titulo,
											content: content,
											trigger: 'click hover focus',
											container: 'body',
											placement: 'top'
										}).popover('show');
									}
								});
							}, 300);
						}
					}

				}
				return true;
			},
			eventDrop: function (calEvent, func, revertFunc) {
				swal({
					title: 'Deseja realmente alterar este horário?',
					type: 'warning',
					showCancelButton: true,
					confirmButtonColor: '#DD6B55',
					confirmButtonText: $_CONFIG.language.sim,
					cancelButtonText: $_CONFIG.language.nao,
					closeOnConfirm: true
				}, function (isConfirmed) {
					if (isConfirmed) {
						$scope.alteraAgendamentoDrag(calEvent.start.format('DD/MM/YYYY'), calEvent.start.format('HH:mm'), calEvent.CIt_Codigo, calEvent.resources[0], revertFunc);
					} else {
						revertFunc();
					}
					$('.popover').popover('hide');
				});
			},
			eventResize: (calEvent, _, revertFunc) => {
				swal({
					title: 'Deseja realmente alterar este horário?',
					type: 'warning',
					showCancelButton: true,
					confirmButtonColor: '#DD6B55',
					confirmButtonText: $_CONFIG.language.sim,
					cancelButtonText: $_CONFIG.language.nao,
					closeOnConfirm: true
				}, function (isConfirmed){
					if (isConfirmed) {
						duracao = (calEvent.end.diff(calEvent.start) / 1000) / 60;
						$scope.alteraAgendamentoResize(calEvent.start.format('DD/MM/YYYY'), duracao, calEvent.CIt_Codigo, calEvent.resources[0], revertFunc);
					} else {
						revertFunc();
					}
					$('.popover').popover('hide');
				});
			},
			eventClick: (calEvent, _, view) => {
				clearTimeout(timevalor);



				$("#sendWhatsappReminder").hide();

				if ((view.name == 'month') || (view.name == 'agendaWeek')) {
					$('#calendar').fullCalendar('gotoDate', calEvent.start);
					$('#calendar').fullCalendar('changeView', 'resourceDay');
				} else {
					if (calEvent.id != '0') {
						if (calEvent.usuario == 'Sem Cadastro') {
							$('#btnCadastraUsuario').show();
							$('#ProntuarioCliente').hide();
							$("#btnEdtClienteAgenda").hide();
						} else {
							$('#btnCadastraUsuario').hide();
							$('#ProntuarioCliente').show();
							$("#btnEdtClienteAgenda").show();
							$("#listaTagsClientes").html("");

							$.ajax({
								dataType: "json",
								url: "/pages/cadastros/buscaClienteTag.php",
								type: 'GET',
								data: {
									pescodigo: calEvent.codCliente,
								},
								success: (data) => {
									if (data.data.length > 0) {
										var tagClientecontent = "";
										for (var i = 0; i < data.data.length; i++) {

											tagClientecontent = tagClientecontent + `<label class="label"  style="background-color:${data.data[i].CTa_Cor}">${data.data[i].CTa_Descricao}</label> &nbsp`
										}
										$("#listaTagsClientes").html(tagClientecontent)
										$compile($('#listaTagsClientes'))($scope);
									}
								}
							});
						}
						$("#listaTagsAgendamento").html("");
						$("#lblRecorrencia").html('<i class="fa fa-spinner fa-pulse fa-fw"></i>')
						$.ajax({
							dataType: "json",
							url: "/pages/cadastros/buscaAgendamentoTag.php",
							type: 'GET',

							data: {
								agecodigo: calEvent.id,
								id: $_CONFIG.ID
							},
							success: (data) => {
								if (data.data.length > 0) {
									var tagcontent = "";
									for (var i = 0; i < data.data.length; i++) {

										tagcontent = tagcontent + `<label class="label" id="tagLabel${data.data[i].ATa_Codigo}" style="background-color:${data.data[i].ATa_Cor}">${data.data[i].ATa_Descricao} &nbsp<i class="fa fa-times pointer" ng-click="removeTagAgendamento(${data.data[i].ATa_Codigo})"></i> </label> &nbsp`
									}
									$("#listaTagsAgendamento").html(tagcontent)
									$compile($('#listaTagsAgendamento'))($scope);
								}
							}
						});

						if(calEvent.ass_multiunidade != '' && calEvent.ass_multiunidade != undefined){
							$("#HasAssinaturaAgendamento").html(`<i class="fa fa-star" style="background-color:#FFD700;border-radius:50%;padding:3px;color:black"></i> `)
						}else{
							if(calEvent.assinatura != ''  && calEvent.assinatura != undefined){
								$("#HasAssinaturaAgendamento").html(`<i class="fa fa-star" style="background-color:orange;border-radius:50%;padding:3px;color:white"></i> `)
							}else{
								$("#HasAssinaturaAgendamento").html('')
							}

						}

						if(calEvent.inadimplente_assinatura_multi == '1' && calEvent.inadimplente_assinatura_multi != undefined){
							$("#HasAssinaturaAgendamento").html(`<i class="fa fa-star"  style="background-color:#FF4500;border-radius:50%;padding:3px;color:black"></i> `)
						}else{
							if(calEvent.inadimplente_assinatura == '1'  && calEvent.inadimplente_assinatura != undefined){
								$("#HasAssinaturaAgendamento").html(`<i class="fa fa-star" style="background-color:#cd0707;border-radius:50%;padding:3px;color:white"></i> `)
							}
						}

					
						

						if (calEvent.rec == 1) {
							$("#divRecorrencia").show();
							htmlrecorrente = '';
							$scope.finalAgendamentoRecorrente = -1;
							$.ajax({
								dataType: "json",
								url: "/pages/cadastros/buscaAgendamentoRecorrente.php",
								type: 'GET',
								data: {
									agendamento: calEvent.id,
									id: $_CONFIG.ID
								},
								success: (data) => {

									if (data.data.length > 0) {
										if (data.data[0].erro == undefined) {
											for (var i = 0; i < data.data.length; i++) {
												htmlrecorrente += `Agendamento ${data.data[i].AgendamentoAtual}/${data.data[i].TotalAgendamento}`
												$scope.finalAgendamentoRecorrente = data.data[i].TotalAgendamento - data.data[i].AgendamentoAtual;
											}
										} else {
											htmlrecorrente += 'Este agendamento é recorrente';
											$scope.finalAgendamentoRecorrente = -1;
										}
										$("#lblRecorrencia").html(htmlrecorrente)
									}
								}
							});
						} else {
							$scope.finalAgendamentoRecorrente = -1;
							$("#divRecorrencia").hide()
						}

						$scope.buscaagendamentoclube(1, "", "", "", "", calEvent.CIt_Codigo);
						if($scope.hasnf == 1){
							$("#cpfnf").show();
						}
						if (calEvent.codStatus == '1') {
							
							$('#lblUsuario').html(calEvent.usuario);
							$('#lblCPFCliente').html(calEvent.PAF_CPF);
							$('#lblIDAgendamento').html(calEvent.id);
							$('#lblServico').html(calEvent.servico);
							$('#lblProfissional').html(calEvent.resources);
							$('#lblSerCodigo').html(calEvent.sercodigo);
							$('#lblFim').html(calEvent.end.format('DD/MM/YYYY HH:mm'));

							$('#fimAgendamento').html(calEvent.end.format('HH:mm'));
							$("#iniAgendamento").html(calEvent.start.format('HH:mm'));

							

							$("#lblObs").val(unescapeUnicode(calEvent.obs));

							$('#lblEmail').html(calEvent.email);
							$('#lblCelular').html(calEvent.celular);
							if(calEvent.celular != ''){
								$("#btnAgendamentoWhats").attr('disabled',false)
							}else{
								$("#btnAgendamentoWhats").attr('disabled',true)
							}
							$('#lblValor').html($_CONFIG.MOEDA + calEvent.valor);
							$('#lblValorHdn').html(calEvent.valor);
							$('#lblPesCodigo').html(calEvent.codCliente);
							$('#lblComCodigo').html(calEvent.Com_Codigo);
							$('#lblCItCodigo').html(calEvent.CIt_Codigo);
							$("#comandaBotao").html(calEvent.Com_Codigo);

							$("#dataAgendamentoLembrete").html(calEvent.start.format('DD/MM/YYYY HH:mm'));
							$("#pesCodigoClienteLembrete").val(calEvent.codCliente);
							$("#usuCodigoCodigoLembrete").val(calEvent.usuario);
							$("#ageCodigoLembrete").val(calEvent.id);
							$("#dataInicioLembrete").val(calEvent.start.format('YYYY/MM/DD'));
							$("#horaInicioLembrete").val(calEvent.start.format('HH:mm'));

							$("#btnVerComandaAgendamentoFinalizado").hide();
							$("#btnVerComandaAgendamento").show();
							$('#btnRealizadoAg').show();
							$('#btnAusenteAg').show();
							$('#btnCancelarAg').show();
							$('#btnMaisServico').show();


							$("#btnSendWhatsReminder").unbind('click');
							if (calEvent.celular != "") {
								$("#sendWhatsappReminder").show();
								$("#btnSendWhatsReminder").click(() => {

									$.ajax({
										type: "POST",
										url: "/pages/cadastros/AGENDAMENTO_Busca.php",
										data: {
											type: 1,
											scheduling_code: calEvent.id
										},
										dataType: "json",
										success: (result) => {
											var cliente = result.data.scheduling[0].person_name;
											var apelido = result.data.scheduling[0].person_nickname;
											var servico = result.data.scheduling[0].service_description;
											var datahora = result.data.scheduling[0].scheduling_start_date.split(" ");
											var dataAge = datahora[0];
											var horaAge = datahora[1];
											var profissional = result.data.scheduling[0].professional_name;
											var profissionalapelido = result.data.scheduling[0].professional_nickname;
											var pontosfidelidade = result.data.scheduling[0].person_loyalty_points;
											var linkconfirmacao = result.data.scheduling[0].confirmation_link;
											var confirmationLinkCode = result.data.scheduling[0].confirmation_link_code;
											var hashCode = result.data.scheduling[0].hash_code_invoice;
											if(linkconfirmacao != ''){
												if(result.data.scheduling[0].has_short_link == 0){
													if(confirmationLinkCode != ''){

														/*$.ajax({
															dataType: "json",
															url: '/pages/cadastros/geraShortLink.php',
															method: "POST",
															async: false,
															data: {
																longlink: linkconfirmacao
															},*/
														$.ajax({
															dataType: "json",
															url: '/pages/cadastros/geraShortLinkAWS.php',
															method: "POST",
															async: false,
															data: {
																longlink: linkconfirmacao,
																pesCodigo: $_CONFIG.CODESTABELECIMENTO,
																type: 1
															},
															success: function (data) {
																linkconfirmacao = data.shortLink
																$.ajax({
																	dataType: "json",
																	url: '/pages/cadastros/COMANDA_CONFIRMACAO_Atualiza.php',
																	data:{
																		confirmation_short_link: linkconfirmacao,
																		confirmation_link_code: confirmationLinkCode
																	},
																	method: "POST",
																	async: false,
																	success: function (data) {
																		console.log(data)
																	}
																});
															}
														});
													}
												}
											}else{
												var sistemalink = sSistema.toLowerCase()
												var thisNewLink = `https://sites.${sistemalink}.com.br/confirmacao-comanda?invoice=${hashCode}`;
												var thisShortLink = '';
												/*$.ajax({
													dataType: "json",
													url: '/pages/cadastros/geraShortLink.php',
													method: "POST",
													async: false,
													data: {
														longlink: thisNewLink
													},*/
												$.ajax({
													dataType: "json",
													url: '/pages/cadastros/geraShortLinkAWS.php',
													method: "POST",
													async: false,
													data: {
														longlink: thisNewLink,
														pesCodigo: $_CONFIG.CODESTABELECIMENTO,
														type: 1
													},
													success: function (data) {
														thisShortLink = data.shortLink
														linkconfirmacao = data.shortLink
													}
												});

												$.ajax({
													dataType: "json",
													url: '/pages/cadastros/COMANDA_CONFIRMACAO_Insere.php',
													method: "POST",
													async: false,
													data: {
														invoice_code: calEvent.Com_Codigo,
														short_link: thisShortLink,
														long_link: thisNewLink
													},
													success: function (data) {
														linkconfirmacao = thisShortLink
													}
												});
											}
											var strMessage = $Options.whatsapp.agenda.replace("[{cliente}]", cliente)
												.replace("[{apelido}]", apelido)
												.replace("[{servico}]", servico)
												.replace("[{dataAge}]", dataAge)
												.replace("[{horaAge}]", horaAge)
												.replace("[{profissional}]", profissional)
												.replace("[{profissionalapelido}]", profissionalapelido)
												.replace("[{pontosfidelidade}]", pontosfidelidade)
												.replace("[{estabelecimento}]", $_CONFIG.ESTABELECIMENTO);
											var celular = result.data.scheduling[0].person_phone;

											$.ajax({
												type: "POST",
												url: "/pages/cadastros/buscaMensagemLayout.php",
												dataType: "json",
												async: false,
												data: {
													tipo: 2,
													tipolayout: 4
												},
												success: function (result) {
													if (result.data.length > 0) {
														if (result.data[0].MLa_Descricao != undefined) {
															if (result.data[0].MLa_Descricao != "") {
																var texto = (result.data[0].MLa_Descricao).replaceAll('{{cliente}}', cliente)
																texto = texto.replaceAll('{{empresa}}', $_CONFIG.ESTABELECIMENTO)
																texto = texto.replaceAll('{{sistema}}', sSistema)
																texto = texto.replaceAll('{{profissional}}', profissional)
																texto = texto.replaceAll('{{profissionalapelido}}', profissionalapelido)
																texto = texto.replaceAll('{{pontosfidelidade}}', pontosfidelidade)
																texto = texto.replaceAll('{{datahora}}', `${dataAge} ${horaAge}`)
																texto = texto.replaceAll('{{servico}}', servico)
																texto = texto.replaceAll('{{linkconfirmacao}}', linkconfirmacao)
																texto = texto.replaceAll('{{apelido}}', apelido)
																strMessage = unescapeUnicode(texto);
															}
														}
													}
												},
												error: function (result) {

												}
											});
											sendWhatsReminder(celular, strMessage);
										}
									});



								});
							} else {
								$("#sendWhatsappReminder").hide();
							}

							$scope.datahoraencaixe = calEvent.start;
							$('#btnMaisProduto').show();
							$('#btnReabrirAg').hide();
							$('#informacao').show();
							$('#infohorario-modal').modal();
							$('#trEditaAgendamento').show();
							$('#btnAssociaCliente').show();
							$('#trTipoPagamento').hide();
							$("#trComprovante").hide();
							$('#tdDatCadastro').html('<b>' + calEvent.Age_Dat_Cadastro + '</b>');
							if (calEvent.Age_Origem == 1) {
								$('#tdOrigem').html('<i class="fa fa-apple"></i> iOS - Aplicativo do Profissional');
							} else if (calEvent.Age_Origem == 3) {
								$('#tdOrigem').html('<i class="fa fa-android"></i> Android - Aplicativo do Profissional');
							} else if (calEvent.Age_Origem == 2) {
								$('#tdOrigem').html('<i class="fa fa-desktop"></i> Web');
							} else if (calEvent.Age_Origem == 4) {
								$('#tdOrigem').html('<i class="fa fa-facebook-official"></i> Facebook/Site');
							} 
							else if (calEvent.Age_Origem == 5) {
								$('#tdOrigem').html('<i class="fa fa-apple"></i> iOS - Prime');
							}else if (calEvent.Age_Origem == 6) {
								$('#tdOrigem').html('<i class="fa fa-android"></i> Android - Prime');
							}
							
							
							else if (calEvent.Age_Origem == 8) {
								$('#tdOrigem').html('<i class="fa fa-apple"></i> iOS - Aplicativo do Cliente');
							}else if (calEvent.Age_Origem == 9) {
								$('#tdOrigem').html('<i class="fa fa-android"></i> Android - Aplicativo do Cliente');
							}else if (calEvent.Age_Origem == 10) {
								$('#tdOrigem').html('<i class="fa fa-map-marker"></i> Totem');
							}
							if (calEvent.AOp_Sem_Chat == 1) {
								$('#tdOrigem').append(`<br><b style="color:red">Este cliente optou por não conversar durante o atendimento</b>`);
							}
							
							$('.date.dateAltAge').datepicker('update', calEvent.start.format('DD/MM/YYYY'));
							$scope.buscaAgendamentoTipoPagamento(calEvent.Com_Codigo);

						} else if (calEvent.codStatus == '4') {
							$scope.desbloquearHorario(calEvent.id);
						} else if (calEvent.codStatus != '6') {
							$('#lblUsuario').html(calEvent.usuario);
							$('#lblCPFCliente').html(calEvent.PAF_CPF);

							$('#lblIDAgendamento').html(calEvent.id);
							$('#lblServico').html(calEvent.servico);
							$('#lblProfissional').html(calEvent.resources);
							$('#lblSerCodigo').html(calEvent.sercodigo);
							$('#lblFim').html(calEvent.end.format('DD/MM/YYYY HH:mm'));
							$('#lblObs').val(calEvent.obs);
							$('#lblEmail').html(calEvent.email);
							$('#lblCelular').html(calEvent.celular);
							if(calEvent.celular != ''){
								$("#btnAgendamentoWhats").attr('disabled',false)
							}else{
								$("#btnAgendamentoWhats").attr('disabled',true)
							}
							$('#lblValor').html($_CONFIG.MOEDA + calEvent.valor);
							$('#lblValorHdn').html(calEvent.valor);
							$('#lblPesCodigo').html(calEvent.codCliente);
							$('#btnRealizadoAg').hide();
							$('#btnAusenteAg').hide();
							$('#btnCancelarAg').hide();
							$('#btnMaisServico').hide();

							$('#btnMaisProduto').hide();
							$('#informacao').show();
							$('#tdDatCadastro').html('<b>' + calEvent.Age_Dat_Cadastro + '</b>');
							$('#infohorario-modal').modal();
							if (calEvent.codStatus == '2' || calEvent.codStatus == '5') {
								$('#btnReabrirAg').show();
								$('#lblComCodigo').html(calEvent.Com_Codigo);
								$("#comandaBotao").html(calEvent.Com_Codigo);
								if (calEvent.codStatus == '5') {
									$('#lblCItCodigo').html(calEvent.CIt_Codigo);
								}
								$('#trEditaAgendamento').hide();
								$('#btnAssociaCliente').hide();
								$("#btnVerComandaAgendamentoFinalizado").show();
								$("#btnVerComandaAgendamento").hide();

								$scope.buscaAgendamentoTipoPagamento(calEvent.Com_Codigo);
								if (calEvent.codStatus == '2') {

									$('#trTipoPagamento').show();
									if ($('#lblEmail').html() == "") {
										$("#trComprovante").show();

										$("#trComprovanteEmail").hide();
										$("#trComprovantePDF").show();
									} else {
										$("#trComprovante").show();

										$("#trComprovanteEmail").show();
										$("#trComprovantePDF").show();
									}
								} else {
									$("#trComprovante").hide();
									$("#trComprovanteEmail").hide();
									$("#trComprovantePDF").hide();
								}
							} else {
								$('#btnReabrirAg').hide();
								$('#trEditaAgendamento').show();
								$('#btnAssociaCliente').show();
								$('#trTipoPagamento').hide();
								$("#trComprovante").hide();
								$("#trComprovanteEmail").hide();
								$("#trComprovantePDF").hide();
							}

							if (calEvent.Age_Origem == 1) {
								$('#tdOrigem').html('<i class="fa fa-apple"></i> iOS - Aplicativo do Profissional');
							} else if (calEvent.Age_Origem == 3) {
								$('#tdOrigem').html('<i class="fa fa-android"></i> Android - Aplicativo do Profissional');
							} else if (calEvent.Age_Origem == 2) {
								$('#tdOrigem').html('<i class="fa fa-desktop"></i> Web');
							} else if (calEvent.Age_Origem == 4) {
								$('#tdOrigem').html('<i class="fa fa-facebook-official"></i> Facebook/Site');
							}
							
							else if (calEvent.Age_Origem == 5) {
								$('#tdOrigem').html('<i class="fa fa-apple"></i> iOS - Prime');
							} else if (calEvent.Age_Origem == 6) {
								$('#tdOrigem').html('<i class="fa fa-android"></i> Android - Prime');
							}
							
							else if (calEvent.Age_Origem == 8) {
								$('#tdOrigem').html('<i class="fa fa-apple"></i> iOS - Aplicativo do Cliente');
							} else if (calEvent.Age_Origem == 9) {
								$('#tdOrigem').html('<i class="fa fa-android"></i> Android - Aplicativo do Cliente');
							}else if (calEvent.Age_Origem == 10) {
								$('#tdOrigem').html('<i class="fa fa-map-marker"></i> Totem');
							}
							if (calEvent.AOp_Sem_Chat == 1) {
								$('#tdOrigem').append(`<br> <b style="color:red">Este cliente optou por não conversar durante o atendimento</b>`);
							}
							
						}
					}
				}
				$('.popover').popover('hide');
			},
			eventAfterRender: (event, element, view) => {

				if (event.title !== undefined) {
					event.title = unescapeUnicode(event.title.replaceAll("%20", " "));
				}

				if (event.CIt_Pag_Online == '1') {
					element.find('.fc-event-time').prepend('<i class="fa fa-credit-card-alt"></i> - ');
				}

				if (event.Age_Codigo_Pri_Visita == event.id) {
					element.find('.fc-event-time').prepend(`
						<span style="
							display:inline-flex;
							align-items:center;
							justify-content:center;
							width:18px;
							height:18px;
							background-color:#FFD700;
							border-radius:50%;
							color:black;
							font-size:10px;
							font-weight:bold;
							margin-right:4px;
						">
							1°
						</span>
					`);
				}

				if (typeof (event.cupom) !== 'undefined' && event.cupom != '') {
					element.find('.fc-event-time').prepend('<i class="fa fa-ticket"></i> - ');
				}

				if (event.Age_Origem == '1') {
					element.find('.fc-event-time').prepend('<i class="fa fa-apple"></i> - ');
					element.find('.fc-event-time').append(`<i class="fa fa-home pull-right" style="padding-top: 1pt; padding-right: 1pt;"></i> `);
				} else if (event.Age_Origem == '2') {
					element.find('.fc-event-time').prepend('<i class="fa fa-desktop"></i> - ');
				} else if (event.Age_Origem == '3') {
					element.find('.fc-event-time').prepend('<i class="fa fa-android"></i> - ');
					element.find('.fc-event-time').append(`<i class="fa fa-home pull-right" style="padding-top: 1pt; padding-right: 1pt;"></i> `);
				} else if (event.Age_Origem == '4') {
					element.find('.fc-event-time').prepend('<i class="fa fa-facebook-official"></i> - ');
				}
				
				else if (event.Age_Origem == '5') {
					element.find('.fc-event-time').prepend('<i class="fa fa-apple"></i> - ');
					element.find('.fc-event-time').append(`<i class="fa fa-user pull-right" style="padding-top: 1pt; padding-right: 1pt;"></i> `);
				} else if (event.Age_Origem == '6') {
					element.find('.fc-event-time').prepend('<i class="fa fa-android"></i> - ');
					element.find('.fc-event-time').append(`<i class="fa fa-user pull-right" style="padding-top: 1pt; padding-right: 1pt;"></i> `);
				}
				
				else if (event.Age_Origem == '8') {
					element.find('.fc-event-time').prepend('<i class="fa fa-apple"></i> - ');
					element.find('.fc-event-time').append(`<i class="fa fa-user pull-right" style="padding-top: 1pt; padding-right: 1pt;"></i> `);
				} else if (event.Age_Origem == '9') {
					element.find('.fc-event-time').prepend('<i class="fa fa-android"></i> - ');
					element.find('.fc-event-time').append(`<i class="fa fa-user pull-right" style="padding-top: 1pt; padding-right: 1pt;"></i> `);
				} else if (event.Age_Origem == '10') {
					element.find('.fc-event-time').prepend('<i class="fa fa-map-marker"></i> - ');
				} 



				if(event.ass_multiunidade != '' && event.ass_multiunidade != undefined){
					element.find('.fc-event-time').prepend(`<i class="fa fa-star" style="background-color:#FFD700;border-radius:50%;padding:3px;color:black;"></i> `);
				}else{
					if (event.assinatura != '' && event.assinatura != undefined) {
						element.find('.fc-event-time').prepend(`<i class="fa fa-star" style="background-color:orange;border-radius:50%;padding:3px"></i> `);
					}
				}
				if(event.inadimplente_assinatura_multi == '1' && event.inadimplente_assinatura_multi != undefined){
					element.find('.fc-event-time').prepend(`<i class="fa fa-star" style="background-color:#FF4500;border-radius:50%;padding:3px;color:black;"></i> `);
				}else{
					if(event.inadimplente_assinatura == '1' && event.inadimplente_assinatura != undefined){
						element.find('.fc-event-time').prepend(`<i class="fa fa-star" style="background-color:#cd0707;border-radius:50%;padding:3px"></i> `);
					}
				}

				
				if(event.isPacote != '' && event.isPacote != undefined && event.isPacote == 1){
					element.find('.fc-event-time').prepend(`<i class="fa fa-gift" ></i> `);
				}

				if(event.isAniversario != '' && event.isAniversario != undefined && event.isAniversario == 1){
					element.find('.fc-event-time').prepend(`<i class="fa fa-birthday-cake" ></i> `);
				}

				if (event.AOp_Sem_Chat == 1) {
					element.find('.fc-event-time').prepend(`<i class="fa fa-microphone-slash" style="background-color:white;border-radius:50%;padding:3px;color:red"></i> `);
				}

			},
			viewRender: (view, element) => {

				var dataSelecionada = moment(view.calendar.getDate().format()).toDate();
				if (view.name == 'resourceDay') {

					$('#dvCalendario').datepicker('setDate', dataSelecionada);
				}

				try {
					setDateTimeZone();
				} catch (err) {}
				$('.fc-header').hide();
				$scope.fixNameProf();
				$scope.isAgendamentoAntigo(1);

				$($('.fc-view').children().get(1)).children().css({
					overflow: 'hidden'
				});
			},
			eventRender: (event, element) => {
				if ((event.codStatus == '1')) {
					event.editable = true;
					event.durationEditable = true;
				} else {
					event.editable = false;
					event.durationEditable = false;
				}
				var originalClass = element[0].className;
				if (event.codStatus == '1') {
					if (event.Age_Confirmado == '1') {
						element[0].className = originalClass + ' hasmenu-confirmado';
					} else if (event.Encaixe == '1') {
						element[0].className = originalClass + ' hasmenu-encaixe';
					} else {
						element[0].className = originalClass + ' hasmenu';
					}
				} else if ((event.codStatus == '2') || (event.codStatus == "5")) {
					element[0].className = originalClass + ' hasmenu-realizado';
				} else if (event.codStatus == '4') {
					element[0].className = originalClass + ' hasmenu-bloqueado';
				}
				element[0].dataset.agecodigo = event.id;
			},
			resourceFilter: (resource) => {
				active = $('#users_menu option:selected').map((a, item) => {
					return item.value;
				}).get();
				return $.inArray(resource.id, active) > -1;
			},
			select: (startDate, endDate, jsEvent, view) => {
				selecionaHorarioAgenda(startDate,endDate,jsEvent.data.id,view)
			}
		});
	}

