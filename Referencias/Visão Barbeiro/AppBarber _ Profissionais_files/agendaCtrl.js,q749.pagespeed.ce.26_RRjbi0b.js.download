				}
			});
		/*}*/
	}

	$("#cliPaisAgendaEdt").change(function(){
		buscaEstados(this.value)
	})

	$("#cliPaisNovoCadastro").change(function(){
		buscaEstados(this.value)
	})

	$("#cliCepEdtAgenda").keyup((e, el) => {
		buscaCEPClienteEdt(e.currentTarget.value);
	});

	function buscaCEPClienteEdt(cep) {
		mCep = cep;

		if (cep && cep.length >= parseInt($_CONFIG.language.mascaras.max_cep)) {
			cep = cep.replace("-", "");
			showLoader(true);
			var pais = $_CONFIG.language.mascaras.lang;
			$.ajax({
				dataType: "json",
				method: 'POST',
				url: '/pages/cadastros/buscaPostalCode.php',
				data: {
					code: cep,
					pais: pais
				},
				success: function (data) {
					var estado = "";
					if (pais == "pt") {
						estado = $("#" + data.estado.replace(" ", "").toLowerCase() + "").val();
					} else {
						estado = $("#" + data.estado + "").val();
					}
					$("#cliEstadoEdtAgenda").val(estado);
					$("#cliCidadeEdAgendat").empty();

					$.ajax({
						dataType: "json",
						url: '/pages/cadastros/buscaCidadesWizard.php',
						method: "POST",
						data: {
							estCodigo: estado,
							cidNome: data.cidade
						},
						success: function (result) {
							$("#cliCidadeEdtAgenda").append(result.cidades);
							$("#cliCidadeEdtAgenda").attr("disabled", false);
							setTimeout(function () {
								$("#cliCidadeEdtAgenda").val(result.cidcodigo);
							}, 10);
							showLoader(false);
							$("#cliBairroEdtAgenda").val(data.bairro);
							$("#cliEnderecoEdtAgenda").val(data.endereco);
						}
					});
					showLoader(false);
				},
				error: function () {
					showLoader(false);
					toastr.error($_CONFIG.language.mensagens.falha_cep, $_CONFIG.language.mensagens.falha_consulta);
				}
			});
		}
	}

	$scope.editaClienteAgenda = function () {

		$.ajax({
			method: "POST",
			dataType: "json",
			url: "/pages/cadastros/buscaClienteAlteraAgenda.php",
			data: {
				cliente: $("#lblPesCodigo").html(),
			},
			success: function (data) {
				$('#cliSenhaAgenda').val("")
				$('#cliNomeEdtAgenda').val(data.result[0].Pes_Nome);
				$('#cliCpfEdtAgenda').val(data.result[0].Paf_Cpf);
				$('#cliEmailEdtAgenda').val(data.result[0].Paf_Email);
				$("#cliEmailEdtAgenda").change()
				$('#cliCelularEdtAgenda').val(data.result[0].Paf_Celular);
				$('#cliTelefoneEdtAgenda').val(data.result[0].Paf_Telefone);
				$('#cliEnderecoEdtAgenda').val(data.result[0].Paf_Endereco)
				$('#cliSexoEdtAgenda').val(data.result[0].Paf_Sexo);
				$('#cliDataNascimentoEdtAgenda').val(data.result[0].PAF_Dat_Nascimento);
				$('#usucodigoalteracao').val(data.result[0].Usu_Codigo);
				if (data.result[0].Usu_Codigo == "") {
					$("#possuiusu").hide()
					$("#npossuiusu").show()
				} else {
					$("#npossuiusu").hide()
					$("#possuiusu").show()

				}
				$('#cliEstadoEdtAgenda').val(data.result[0].Est_Sigla);
				$('#cliCepEdtAgenda').val(data.result[0].Paf_CEP);
				$('#cliCodigoEdtAgenda').val(data.result[0].Pes_Codigo);
				if(data.result[0].Pai_Codigo != ''){
					$("#cliPaisAgendaEdt").val(data.result[0].Pai_Codigo).change()
					setTimeout(function(){
						$('#cliEstadoEdtAgenda').val(data.result[0].Est_Codigo).change();
						setTimeout(function(){
							$('#cliCidadeEdtAgenda').val(data.result[0].Cid_Codigo).change();
						},1000)
					},1000)
				}

				$('#pesCodigoAltAgenda').val(data.result[0].Pes_Codigo);
				$('#cliObservacaoEdtAgenda').val(data.result[0].Paf_Observacao);
				$('#cliNumeroEdtAgenda').val(data.result[0].Paf_Numero);
				$('#cliComplementoEdtAgenda').val(data.result[0].Paf_Complemento);
				$('#cliBairroEdtAgenda').val(data.result[0].Paf_Bairro);
				$('#cliOndeAgenda').val(data.result[0].PAF_Com_Soube);
				$('#cliOndeEdt').val(data.result[0].PAF_Com_Soube);
				$('#cliRGEdtAgenda').val(data.result[0].Paf_RG);
				$scope.geraComboPaisTelefone('cliCelularEdtAgenda', 'cliDialCodeEdtAgenda', data.result[0].DDI)
				/*$.ajax({
					dataType: "html",
					url: '/pages/cadastros/buscaCidades.php',
					method: "POST",
					data: {
						estCodigo: data.result[0].Est_Codigo
					},
					success: function (result) {
						$("#cliCidadeEdtAgenda").append(result);
						$("#cliCidadeEdtAgenda").attr("disabled", false);
						$('#cliCidadeEdtAgenda').val(data.result[0].Cid_Codigo);
					}
				});*/

			},
			error: function (result) {}
		});
		$('[data-toggle="popover"]').popover({
			container: 'body'
		});
