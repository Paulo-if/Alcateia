			$("#DataListaEsperaAltera").val(data.LEs_Data);
			$("#ObsListaEsperaAltera").val(data.LEs_Descricao);
			$("#servicoListaEsperaAltera").change();
			$("#alteraClienteListaAgenda-modal").modal();
		});

		$('#modalListaEspera-modal').modal();

	}


	$('#formListaEsperaAgenda').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		formLista = $(this)
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/insereListaEspera.php",
			data: {
				DataLista: $("#DataListaAgenda").val(),
				ObsLista: $("#ObsListaDataAgenda").val(),
				pesCodigoCliente: $("#pesCodigoClienteListaAgenda").val(),
				usucodigo: $("#pesCodigoClienteListaAgenda option:selected").get(0).dataset.usucodigo,
				servico: $("#servicoListaAgenda").val()
			},
			dataType: "json",

			success: function (result) {
				if (result.data[0].erro == "0") {
					tabelaListaf.ajax.reload();
					toastr.success(result.data[0].resultado);
					$('#insereClienteListaAgenda-modal').modal("hide");
					formLista.each(function () {
						this.reset();
					});
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
				showLoader(false);
			}
		});
		return true;
	});


	$('#formAlteraListaEsperaAgenda').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		formListaAltera = $(this)
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/alteraListaEspera.php",
			data: {
				lescodigo: $("#CodigoListaEspera").val(),
				DataListaAlt: $("#DataListaEsperaAltera").val(),
				ObsListaAlt: $("#ObsListaEsperaAltera").val(),
				servicoAlt: $("#servicoListaEsperaAltera").val()
			},
			dataType: "json",
			success: function (result) {
				if (result.data[0].erro == "0") {
					tabelaListaf.ajax.reload();
					toastr.success(result.data[0].resultado);
					$('#alteraClienteListaAgenda-modal').modal("hide");
					formListaAltera.each(function () {
						this.reset();
					});
				} else {
					toastr.error(result.data[0].resultado);
				}
				showLoader(false);
			},
			error: function (result) {
				toastr.error("Falha na conexão.");
				showLoader(false);
			}
		});
		return true;
	});

	$scope.atualizaDadosListaEspera = function () {
		tabelaListaf.ajax.reload();
	}

	$scope.insereClienteListaEsperaAgenda = function () {
		$("#insereClienteListaAgenda-modal").modal();
		$scope.buscaClienteLista();
	}

	function loadPayments() {

		fetch('/pages/cadastros/buscaTipoPagamentoBandeiraFinalizarComanda.php')
			.then(data => data.json())
			.then((data) => {
				var arrayTpa = {};

				var tipoPagamentos = data.result.filter((data) => {
					return data.PagamentoBandeira == ""
				});
				tipoPagamentos.forEach((pagamento) => {

					if (pagamento.TPa_Cartao == "1") {
						var bandeiras = data.result.filter((bandeira) => {
							return bandeira.PagamentoBandeira == pagamento.TPa_Codigo
						});
						var arrayTBa = {};

						if (bandeiras.length > 0) {

							bandeiras.forEach((bandeira) => {
								arrayTBa[bandeira.TPa_Codigo] = {
									name: bandeira.TPa_Descricao,
									codigo: pagamento.TPa_Codigo
								};
							});

							arrayTpa[pagamento.TPa_Codigo] = {
								name: pagamento.TPa_Descricao,
								items: arrayTBa
							};
						} else {
							arrayTpa[pagamento.TPa_Codigo] = {
								name: pagamento.TPa_Descricao,
								codigo: pagamento.TPa_Codigo
							};
						}

					} else {
						arrayTpa[pagamento.TPa_Codigo] = {
							name: pagamento.TPa_Descricao,
							codigo: pagamento.TPa_Codigo
						};
					}

				});

				// return arrayTpa;
				$.contextMenu({
					selector: '.hasmenu',
					callback: (key, options) => {
						eventSel = $('#calendar').fullCalendar('clientEvents', options.$trigger[0].dataset.agecodigo)[0];
						$('#lblIDAgendamento').html(options.$trigger[0].dataset.agecodigo);

						if (key == 'realizado') {
							$('#lblValorHdn').html(eventSel.valor);
							$('#lblPesCodigo').html(eventSel.codCliente);
							$('#btnRealizadoAg').click();
						} else if (key == 'ausente') {
							$('#btnAusenteAg').click();
						} else if (key == 'cancelado') {
							$('#btnCancelarAg').click();
						} else if (key == 'confirmado') {
							$('#btnConfirmaAg').click();
						} else if (key == 'preferencia') {
							$('#btnPreferenciaAg').click();
						} else if (key == 'alt-encaixe') {
							$('#btnAlteraEncaixe').click();
						} else if (key == 'encaixe') {
							$('#idComanda').html(eventSel.Com_Codigo);
							$('#btnFechaItemComandaSer').hide();
							$('#btnFechaServicoModal').show();
							insereServicoComanda(0, eventSel.start);
						} else if (key == 'venda') {
							$('#comCodigoInsert').val(eventSel.Com_Codigo);

							$('#TprTipoComanda').html('1')
							$('#treAgendaCodigo').html('1');
							$scope.buscaProdutoCombo();
							$('#comanda-modal').modal('hide');
							$('#comandaInsert-modal').modal('show');
							$('#insereProdutoOrigem').val(0);
							$('#btnFechaItemComandaModal').show();
							$('#btnFechaItemComanda').hide();
						} else if (key == 'addtag') {
							$("#AgeCodigoTagAgendamento").val(eventSel.id)
							colorPicker.reset()
							$scope.stateTagColor = "#ebebeb";
							$('#addtagagendamento-modal').modal();
						}else if (key == 'nolocal') {
							$('#btnNoLocal').click();
						} else {

							var pagamentoSelecionado = options.commands[key];

							showLoader(true);
							$.ajax({
								dataType: "json",
								url: "/pages/actions/buscaAgendamentoTipoPagamento.php",
								type: 'POST',
								data: {
									comanda: eventSel.Com_Codigo,
								},
								success: (data) => {
									var codigoBandeira = "";

									if (key != pagamentoSelecionado.codigo) {
										codigoBandeira = key;
									}

									$.ajax({
										dataType: 'json',
										method: "POST",
										url: '/pages/cadastros/atualizaComandav3.php',
										data: {
											comcodigo: eventSel.Com_Codigo,
											tpacodigo: pagamentoSelecionado.codigo,
											inserecaixa: 1,
											inserecontacli: 0,
											inserecaixinha: 0,
											valorpagamento: data.result[0].ValorComanda.replace(',', '.'),
											tbacodigo: codigoBandeira,
											tipo: 1,
											parcelado: 0,
											qtdparcela: 1,
											transacao: '',
											motivo: '',

											numpagamento: 1
										},
										success: (data) => {
											showLoader(false);

											if (data.data[0].erro == "0") {
												toastr.success(data.data[0].resultado);
												$scope.atualizaEventos()
											} else {
												toastr.error(data.data[0].resultado);
											}
										},
										error: () => {
											showLoader(false);
										}
									})
								},
								error: () => {
									showLoader(false);
								}
							});
						}
					},
					items: {
						'realizado': {
							name: 'Abrir Comanda',
							icon: 'fa-clipboard'
						},
						'finalizaAutomatico': {
							name: 'Finalizar Comanda',
							icon: 'fa-check',
							items: arrayTpa
						},
						'ausente': {
							name: 'Ausente',
							icon: 'fa-close'
						},
						'cancelado': {
							name: 'Cancelado',
							icon: 'fa-trash-o'
						},
						'confirmado': {
							name: 'Confirmar',
							icon: 'fa-thumbs-up'
						},
						'preferencia': {
							name: 'Sem Preferência',
							icon: 'fa-hand-pointer-o'
						},
						'encaixe': {
							name: 'Encaixe',
							icon: 'fa-scissors'
						},
						'venda': {
							name: 'Venda',
							icon: 'fa-shopping-cart'
						},
						'alt-encaixe': {
							name: 'Alterar para Encaixe',
							icon: 'fa-puzzle-piece'
						},
						'addtag': {
							name: 'Adicionar Tag',
							icon: 'fa-tag'
						},
						'nolocal': {
							name: 'No Local',
							icon: 'fa-map-marker'
						}
					}
				});
			});



	}

