				tipoAlteraAgendamento: "8",
				codItem: codigoItem,
				profissionalAlteraAgendamento: ""
			},
			dataType: "json",
			success: function (result) {

				if (result.result[0].erro == "0") {
					$scope.isAgendamentoAntigo(2);
					toastr.success(result.result[0].resultado);
				} else {
					toastr.error(result.result[0].resultado);
					returnFunc();
				}
				showLoader(false);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	}

	$('#formAlteraAgendamento').submit((event) => {
		event.preventDefault();
		formAlteraAgendamento = $(event.currentTarget);
		showLoader(true);
		dataAltera = new FormData(event.currentTarget);
		dataAltera.append("codItem", $("#lblCItCodigo").html());
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/alteraAgendamento.php",
			data: dataAltera,
			dataType: "json",
			processData: false,
			contentType: false,
			success: (result) => {
				if (result.result[0].erro == "0") {
					$('#editarAgendamento-modal').modal("hide");
					$("#infohorario-modal").modal("hide");
					$scope.isAgendamentoAntigo(2);
					toastr.success(result.result[0].resultado);
				} else {
					swal(result.result[0].resultado, "", "error");
				}
				showLoader(false);
			},
			error: () => {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
		return true;
	});

