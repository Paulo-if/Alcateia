	$('#formCadastro').submit((event) => {

		if (($("#cliLoginIdAg").val() != "") && ($("#cliEmail").val() == "")) {
			swal("Insira um E-mail", "Por favor, insira um e-mail para o cliente receber os dados de acesso.", "error");
			return true;
		} else {

			var mailformat = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
			if(($("#cliEnderecoEletronico").val() != '') && ($("#cliEnderecoEletronico").val().match(mailformat) == null))
			{
				swal("Insira um e-mail válido", "O email informado não é valido.", "error");
				return true;
			}else{

				event.preventDefault();
				formCadastro = $(event.currentTarget);
				showLoader(true);
				dataInsere = new FormData(event.currentTarget);
				dataInsere.append("apelido", $("#cliApelido").html());
				dataInsere.append("cliEmail", $("#cliEnderecoEletronico").val());
				
				$.ajax({
					type: "POST",
					url: "/pages/cadastros/insereClientes.php",
					data: dataInsere,
					dataType: "json",
					processData: false,
					contentType: false,
					success: (result) => {

						if (result.insereCliente[0].erro == "0") {
							toastr.success(result.insereCliente[0].resultado);
							cliNome = $("#cliNome").val();
							cliCelular = $("#cliCelular").val();
							clientesNomes.push(cliNome + " | " + cliCelular);

							clientesIds[cliNome + " | " + cliCelular] = result.insereCliente[0].pescodigo;

							$('#cadastrarcliente-modal').modal("hide");

							if (clientesNomes.length > 1500) {
								$("#cliente_menu").append('<option data-usucodigo="" data-imagem="" data-celular="' + cliCelular + '" value="' + result.insereCliente[0].pescodigo + '">' + cliNome + ' - ' + cliCelular + '</option>');
								$("#cliente_menu2").append('<option data-usucodigo="" data-imagem="" data-celular="' + cliCelular + '" value="' + result.insereCliente[0].pescodigo + '">' + cliNome + ' - ' + cliCelular + '</option>');
								$("#cliente_menu").val(result.insereCliente[0].pescodigo).trigger('change');
								$("#cliente_menu2").val(result.insereCliente[0].pescodigo).trigger('change');

								var clientes = new Bloodhound({
									datumTokenizer: Bloodhound.tokenizers.whitespace,
									queryTokenizer: Bloodhound.tokenizers.whitespace,
									local: clientesNomes
								});

								$('.typeahead').typeahead('destroy');
								$('#the-basics .typeahead').typeahead(null, {
									limit: 20,
									source: clientes
								}).on('typeahead:selected', (e) => {
									var arrNome = e.currentTarget.value.split(' | ');
									nomeSelecionado = arrNome[0];
									idSelecionado = clientesIds[e.currentTarget.value];
								});
							} else {
								$scope.buscaClientes(result.insereCliente[0].pescodigo);
							}
							formCadastro.each((_, el) => {
								el.reset();
							});
							$("#cliLoginIdAg").val("");
						} else {
							swal(result.insereCliente[0].resultado, "", "error");
						}
						showLoader(false);
					},
					error: () => {
						swal("Falha na conexão.", "", "error");
						showLoader(false);
					}
				});
				return true;
			}
		}
	});

	$('#confirmarAssociar').click(() => {
		if (typeof (idSelecionado) != "undefined") {
			if (idSelecionado != "") {
				showLoader(true);
				$.ajax({
					dataType: "json",
					url: "/pages/actions/atualizaHorario.php",
					method: "POST",
					data: {
						agendamento: $("#lblIDAgendamento").html(),
						tipo: 3,
						cliente: idSelecionado
					},
					success: (data) => {
						if (data.result[0].erro == 1) {
							swal(data.result[0].resultado, "", "error");
						} else {
							toastr.success(data.result[0].resultado);
							$("#cpfnf").hide()
							$("#lblUsuario").html(nomeSelecionado);
							$("#btnAssociaCliente").click();
							$('.typeahead').typeahead('val', '');
							$("#lblPesCodigo").html(idSelecionado);

							$scope.atualizaEventos();
							$("#listaTagsClientes").html("");

							$.ajax({
								dataType: "json",
								url: "/pages/cadastros/buscaClienteTag.php",
								type: 'GET',
								data: {
									pescodigo: idSelecionado,
								},
								success: (data) => {
									if (data.data.length > 0) {
										var tagClientecontent = "";
										for (var i = 0; i < data.data.length; i++) {

											tagClientecontent = tagClientecontent + `<label class="label"  style="background-color:${data.data[i].CTa_Cor}">${data.data[i].CTa_Descricao}</label> &nbsp`
										}
										$("#listaTagsClientes").html(tagClientecontent)
										$compile($('#listaTagsClientes'))($scope);
									}
								}
							});
							idSelecionado = "";
							nomeSelecionado = "";
						}
						showLoader(false);
					},
					error: (result) => {
						swal("Falha na conexão.", "", "error");
						showLoader(false);
					}
				});
			} else {
				swal("Selecione um Cliente.", "", "error");
			}
		} else {
			swal("Selecione um Cliente.", "", "error");
		}
		return true;
	});

	function atualizaDados() {
		$('[data-toggle="popover"]').popover("hide");
		tabelaRodizio.api().ajax.reload(() => {
			$('[data-toggle="popover"]').popover({
				container: 'body'
			});
		});
	}

	$scope.atualizaCalendario();
	$scope.initAgenda = false;

	$('#formAgendamentoRecorrente').submit((event) => {
		event.preventDefault();
		formRecorrente = $(event.currentTarget);
		showLoader(true);
		$("#btnAgendarRecorrente").attr("disabled", true);
		$("#btnAgendarRecorrente").html('<i class="fa fa-spinner fa-pulse"></i> Cadastrando...');	
		dataRecorrente = new FormData(event.currentTarget);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/insereAgendamentoRecorrentev2.php",
			data: {
				pescodigocliente: $("#cliente_menu2").val(),
				pescodigoprofissional: $("#profissionalRecorrencia2").val(),
				sercodigo: $("#servico_menuRecorrente").val(),
				periodicidade: $("#recorrenciaPeriodicidade").val(),
				qtdAgendamento: $("#recorrenciaQtd").val(),
				dataAgendamento: $("#dataAgendamentoRecorrente2").val(),
				horaAgendamento: $("#horaAgendamentoRecorrente").val(),
				duracao: $("#duracaoAgendamentoRecorrente").val()
			},
			dataType: "json",
			/*processData: false,
			contentType: false,*/
			success: (result) => {
				var resultado = '<div style="max-height:200px;overflow-y:scroll">';
				for (var i = 0; i < result.data.length; i++) {
					if (result.data[i].erro == 0) {
						resultado += '<span style="color:green;"><i class="fa fa-check"></i>&nbsp' + result.data[i].resultado + '</span><br>'
					} else {
						resultado += '<span style="color:red;"><i class="fa fa-times"></i>&nbsp' + result.data[i].resultado + '</span><br>'
					}
				}
				resultado += '</div>'
				swal({
					title: "<small>Resultado</small>",
					text: resultado,
					html: true
				});
				$("#agendaHorario-modal").modal("hide");

				formRecorrente.each((_, el) => {
					el.reset();
				});
				$scope.isAgendamentoAntigo(2);
				$("#cliente_menu2").val("").trigger('change');
				showLoader(false);
				$("#btnAgendarRecorrente").removeAttr("disabled");
			},
			error: () => {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
				$("#btnAgendarRecorrente").removeAttr("disabled");
			}
		});
		return true;
	});

	$scope.editarAgendamento = () => {
		$("#horaAlteraAgendamento").val("");
		$("#editarAgendamento-modal").modal();
		$("#tipoAlteraAgendamento").val(0);
		$("#tipoAlteraAgendamento").change();
		$scope.hideDivsAltera();
		$scope.buscaServicoAlteraAgedamento($("#lblProfissional").html());
		$scope.buscaProfissionalAlteraAgedamento();
	}

	$scope.buscaServicoAlteraAgedamento = function (codigoProfissional) {
		$.ajax({
			method: "GET",
			dataType: "json",
			url: "/pages/actions/buscaServicos.php",
			method: "POST",
			data: {
				tipo: '2',
				profissional: codigoProfissional
			},
			success: (data) => {
				$("#servicoAlteraAgendamento").html('<option value="">Selecione um Serviço</option>');
				for (var i = 0; i < data.servicos.length; i++) {
					$("#servicoAlteraAgendamento").append('<option value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>');
				};
			}
		});
	}

	$scope.buscaProfissionalAlteraAgedamento = function () {
		$.ajax({
			method: "POST",
			dataType: "json",
			url: "/pages/cadastros/buscaProfissionalSelect.php",
			success: (data) => {
				$("#profissionalAlteraAgendamento").html('<option value="">Selecione um Profissional</option>');
				for (var i = 0; i < data.profissionais.length; i++) {
					$("#profissionalAlteraAgendamento").append('<option value="' + data.profissionais[i].Pes_Codigo + '">' + data.profissionais[i].Pes_Nome + '</option>');
				};
			}
		});
	}

	$("#profisisonalHorDisp").change(function () {
		if ($("#profisisonalHorDisp").val() != '') {
			$scope.buscaServicoProfissionalDisponivel();
		} else {
			$("#servicoHorDisp").html('<option value="">Selecione um Profissional</option>');
		}
	})

	$scope.buscaServicoProfissionalDisponivel = function () {
		$.ajax({
			method: "POST",
			dataType: "json",
			url: "/pages/cadastros/buscaServicoProfissionalSelect.php",
			data: {
				profissional: $("#profisisonalHorDisp").val()
			},
			success: function (data) {
				$("#servicoHorDisp").html('<option value="">Selecione um Serviço</option>');
				for (var i = 0; i < data.servicos.length; i++) {
					$("#servicoHorDisp").append('<option value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>');
				};
			}
		});

	}

	$scope.hideDivsAltera = function () {
		$("#divAlteraAgendamentoData").hide();
		$("#divAlteraAgendamentoServico").hide();
		$("#divAlteraAgendamentoProfissional").hide();
		$("#divAlteraAgendamentoDuracao").hide();
	}

	$scope.showDivsAltera = function () {
		$scope.hideDivsAltera();
		$scope.buscaProfissionalAlteraAgedamento();

		if ($("#tipoAlteraAgendamento option:selected").val() == 1) {
			$("#divAlteraAgendamentoData ").show();
		} else if ($("#tipoAlteraAgendamento option:selected").val() == 2) {
			$("#divAlteraAgendamentoServico").show();
		} else if ($("#tipoAlteraAgendamento option:selected").val() == 3) {
			$("#divAlteraAgendamentoProfissional").show();
			//$scope.buscaProfissionalServicoAlteraAgedamento();
		} else if ($("#tipoAlteraAgendamento option:selected").val() == 4) {
			$("#divAlteraAgendamentoData").show();
			$("#divAlteraAgendamentoProfissional").show();
			//$scope.buscaProfissionalServicoAlteraAgedamento();
		} else if ($("#tipoAlteraAgendamento option:selected").val() == 5) {
			$("#divAlteraAgendamentoData").show();
			$("#divAlteraAgendamentoServico").show();
		} else if ($("#tipoAlteraAgendamento option:selected").val() == 6) {
			$("#divAlteraAgendamentoServico").show();
			$("#divAlteraAgendamentoProfissional").show();
		} else if ($("#tipoAlteraAgendamento option:selected").val() == 7) {
			$("#divAlteraAgendamentoData").show();
			$("#divAlteraAgendamentoServico").show();
			$("#divAlteraAgendamentoProfissional").show();
		} else if ($("#tipoAlteraAgendamento option:selected").val() == 8) {
			$("#divAlteraAgendamentoDuracao").show();
			$scope.comboTempoPadrao();
		} else {
			$scope.hideDivsAltera();
		}
	}

	$scope.comboTempoPadrao = function () {
		var combotempo = "";
		for (var i = 1; i < 15; i++) {
			combotempo += "<option value=" + $_CONFIG.TEMPOPADRAO * i + ">" + $_CONFIG.TEMPOPADRAO * i + " Minutos</option>"
		}
		$("#DuracaoAlteraAgendamento").html(combotempo);
		$("#DuracaoAlteraAgendamentoLista").html(combotempo);
	}

	$("#tipoAlteraAgendamento").change(function () {
		$scope.showDivsAltera();
	});

	$("#profissionalAlteraAgendamento").change(function () {
		$scope.buscaServicoAlteraAgedamento($("#profissionalAlteraAgendamento option:selected").val());
	});

	$("#cliEmail").keyup(function () {
		$("#cliLoginIdAg").val($("#cliEmail").val());
	})

	$scope.alteraAgendamentoDrag = function (data, inicio, codigoItem, pescodigo, returnFunc) {

		showLoader(true);
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/alteraAgendamento.php",
			data: {
				dataAlteraAgendamento: data,
				horaAlteraAgendamento: inicio,
				tipoAlteraAgendamento: "4",
				codItem: codigoItem,
				profissionalAlteraAgendamento: pescodigo
			},
			dataType: "json",
			success: function (result) {

				if (result.result[0].erro == "0") {
					$scope.isAgendamentoAntigo(2);
					toastr.success(result.result[0].resultado);

				} else {
					toastr.error(result.result[0].resultado);
					returnFunc();
				}
				showLoader(false);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});
	}

	$scope.alteraAgendamentoResize = function (data, duracao, codigoItem, pescodigo, returnFunc) {

		showLoader(true);
		$.ajax({
			type: "POST",
