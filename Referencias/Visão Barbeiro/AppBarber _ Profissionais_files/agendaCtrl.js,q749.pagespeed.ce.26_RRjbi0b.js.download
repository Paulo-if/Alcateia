			showCancelButton: true,
			confirmButtonColor: "#DD6B55",
			confirmButtonText: "Sim",
			cancelButtonText: "Não",
			closeOnConfirm: true
		}, () => {
			var url = location.href;
			url = url.split('#/')[0];
			url = url + '#/whatsapp';
			window.location.href = url;
			$("#novo-modal").modal("hide");
		});
	})

