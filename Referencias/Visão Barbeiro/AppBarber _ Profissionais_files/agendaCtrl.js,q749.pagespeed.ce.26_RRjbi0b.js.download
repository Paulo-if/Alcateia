					execTime = false;

					if($('#calendar').fullCalendar('getView').calendar.fetchResources().length > $scope.limitScrollAgenda){
						var sizeAgenda = 50 + (144 * $('#calendar').fullCalendar('getView').calendar.fetchResources().length );
						$(".fc-content").width(sizeAgenda)
						$('#calendar').fullCalendar('getView').calendar.updateSize();
					}
				}
			});
