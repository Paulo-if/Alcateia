	$scope.buscaagendamentoclube = function (tipo, pescodigo, sercodigo, asscodigo, grucodigo, citcodigo) {
		if (tipo == '1') {
			$("#tipoclube").html('');
			$.ajax({
				method: "POST",
				dataType: "json",
				url: "/pages/cadastros/buscaAgendamentoClube.php",
				data: {
					tipo: tipo,

					citcodigo: citcodigo
				},
				success: (data) => {
					if (data.data[0] != undefined) {
						if (data.data[0].erro != 1) {
							var servico = $('#lblSerCodigo').html();
							var pessoa = $('#lblPesCodigo').html();
							if (data.data[0].Ass_Codigo != '') {
								var codigo = data.data[0].Ass_Codigo;
								$("#tipoclube").html(" - Clube de Assinaturas <button class='btn bg-purple btn-flat btn-xs' ng-click='buscaagendamentoclube(2," + pessoa + "," + servico + "," + codigo + ",null,null)'>Detalhes</button>")
							} else {
								if(data.data[0].Gru_Codigo != ''){
									var codigo = data.data[0].Gru_Codigo;
									$("#tipoclube").html(" - Clube de Clientes <button class='btn bg-purple btn-flat btn-xs' ng-click='buscaagendamentoclube(3," + pessoa + "," + servico + ",null," + codigo + ",null)'>Detalhes</button>")
								}
							}
							$compile($('#tipoclube'))($scope);
						}
					}

				}
			});
		} else if (tipo == '2') {
			$.ajax({
				method: "POST",
				dataType: "json",
				url: "/pages/cadastros/buscaAgendamentoClube.php",
				data: {
					tipo: tipo,
					cliente: pescodigo,
					servico: sercodigo,
					asscodigo: asscodigo

				},
				success: function (data) {
					if (data.data[0] != undefined) {
						if (data.data[0].erro == 0) {
							$("#nomeClube").html("Clube de Assinatura - " + data.data[0].Ass_Descricao + "<br>Vencimento: " + data.data[0].DataVencimento);
							$("#nomeservicoclube").html(data.data[0].Ser_Descricao);
							$("#clubedesconto").html("Desconto - " + data.data[0].AIt_Desconto + "%");
							$("#clubeinfo-modal").modal()
						}
					}

				}
			});
		} else if (tipo == '3') {
			$.ajax({
				method: "POST",
				dataType: "json",
				url: "/pages/cadastros/buscaAgendamentoClube.php",
				data: {
					tipo: tipo,
					cliente: pescodigo,
					servico: sercodigo,
					grucodigo: grucodigo

				},
				success: function (data) {
					if (data.data[0] != undefined) {
						if (data.data[0].erro == 0) {
							$("#nomeClube").html("Clube de Clientes - " + data.data[0].Gru_Descricao);
							$("#nomeservicoclube").html(data.data[0].Ser_Descricao);
							$("#clubedesconto").html("Desconto - " + data.data[0].SGr_Valor + '%');
							$("#clubeinfo-modal").modal()
						}
					}

				}
			});
		}
	}

	$scope.cadastrarlembrete = function () {

		$.ajax({
			method: "POST",
			dataType: "json",
			url: "/pages/cadastros/buscaClienteAlteraAgenda.php",
			data: {
				cliente: $("#lblPesCodigo").html(),
			},
			success: function (data) {
				$("#usuCodigoCodigoLembrete").val(data.result[0].Usu_Codigo);

			},
			error: function (result) {}
		});
		$scope.buscaSaldoSMSLem()
		$scope.buscaSaldoWhatsLem()
		$("#dataAgendamentoLembrete").html();
		$("#pesCodigoClienteLembrete").val();
		$("#usuCodigoCodigoLembrete").val();
		$("#ageCodigoLembrete").val();
		$("#dataInicioLembrete").val();
		$("#horaInicioLembrete").val();
		$("#cadastrarlembrete-modal").modal();
	}

	$('#formInserirLembrete').submit(function (event) {
		event.preventDefault();
		showLoader(true);
		var qtdlembrete = $("#min_lembrete").val();
		var dataatualenvio = moment($('#dataInicioLembrete').val() + " " + $('#horaInicioLembrete').val()).add(-qtdlembrete, "minutes");
		var dataenvio = dataatualenvio.locale("PT-BR").format("L") + " " + dataatualenvio.hours() + ":" + dataatualenvio.minute();

		if ($("#cbEnviaSmsLem").get(0).checked) {
			var cbEnviaSms = 1;
		} else {
			var cbEnviaSms = 0;
		}
		if ($("#cbEnviaWhatsLem").get(0).checked) {
			var cbEnviaWhats = 1;
		} else {
			var cbEnviaWhats = 0;
		}

		$.ajax({
			dataType: "json",
			url: '/pages/cadastros/insereLembretev2.php',
			method: "POST",
			data: {
				dataenvio: dataenvio,
				pescodigocliente: $("#pesCodigoClienteLembrete").val(),
				usucodigocliente: $("#usuCodigoCodigoLembrete").val(),
				agecodigo: $("#ageCodigoLembrete").val(),
				usasms: cbEnviaSms,
				usawhats: cbEnviaWhats
			},
			success: function (result) {
				if (result.data[0].erro == "0") {
					swal(result.data[0].resultado, "", "success");
					$("#cadastarlembrete-modal").modal("hide");

				} else {
					swal("Falha ao Inserir.", result.data[0].resultado, "error");
				}
				showLoader(false);
			},
			error: function (result) {
				swal("Falha na conexão.", "", "error");
				showLoader(false);
			}
		});

		return true;
	});
