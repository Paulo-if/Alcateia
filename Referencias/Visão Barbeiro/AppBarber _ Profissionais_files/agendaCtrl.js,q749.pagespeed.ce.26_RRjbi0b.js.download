	function atualizaJornada(diaAtual, profissional) {
		diaAtual = moment(diaAtual);

		$('#calendar').fullCalendar('removeEvents', -99);
		execTime = true;
		var validadata = localStorage.getItem(`jornada${profissional}|${diaAtual.date()}-${diaAtual.month()}-${diaAtual.year()}`)
		
		if(validadata == null){
			$.ajax({
				dataType: "json",
				url: "/pages/actions/buscaJornadaProfissionais.php",
				method: "POST",
				data: {
					dia: diaAtual.day() + 1,
					profissional: profissional,
					dataAgenda: diaAtual.locale("pt-br").format("L")
				},
				success: function (data) {

					if (data.jornada.length == 0) {
						setStorage(`jornada${profissional}|${diaAtual.date()}-${diaAtual.month()}-${diaAtual.year()}`, JSON.stringify(data))
						setStorage(`current_agenda_date`, `|${diaAtual.date()}-${diaAtual.month()}-${diaAtual.year()}`)
						listJornada.push(`jornada${profissional}|${diaAtual.date()}-${diaAtual.month()}-${diaAtual.year()}`);
						setStorage('listJornada',listJornada)
						var originalEventObject = $(this).data('eventObject');
						var horaIni = $.extend({}, originalEventObject);

						var dia = diaAtual.date();
						var mes = diaAtual.month() + 1;
						var ano = diaAtual.year();
						horaIni.id = -99;
						horaIni.start = new Date(ano + "/" + mes + "/" + dia + " 00:00:00");
						horaIni.end = new Date(ano + "/" + mes + "/" + dia + " 23:59:59");
						horaIni.backgroundColor = "#444444";
						horaIni.borderColor = "#444444";
						horaIni.codStatus = 6;
						horaIni.resources = profissional;
						$('#calendar').fullCalendar('renderEvent', horaIni, true);

					} else {
						setStorage(`jornada${profissional}|${diaAtual.date()}-${diaAtual.month()}-${diaAtual.year()}`, JSON.stringify(data))
						setStorage(`current_agenda_date`, `|${diaAtual.date()}-${diaAtual.month()}-${diaAtual.year()}`)
						listJornada.push(`jornada${profissional}|${diaAtual.date()}-${diaAtual.month()}-${diaAtual.year()}`);
						setStorage('listJornada',listJornada)
						if (data.jornada[0].PJo_Hor_Ini1 != null) {
							//var originalEventObject = $(this).data('eventObject');
							var originalEventObject = {};
							var horaIni = $.extend({}, originalEventObject);

							var dia = diaAtual.date();
							var mes = diaAtual.month() + 1;
							var ano = diaAtual.year();
							horaIni.id = -99;
							horaIni.start = new Date(ano + "/" + mes + "/" + dia + " 00:00:00");
							horaIni.end = new Date(ano + "/" + mes + "/" + dia + " " + data.jornada[0].PJo_Hor_Ini1);
