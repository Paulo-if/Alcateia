	function thumbCliente(state) {
		if (!state.id) {
			return state.text;
		}
		var celular = "";

		if (state.element.dataset.imagem == "" || state.element.dataset.imagem == undefined) {
			if (state.element.dataset.observacao == "" || state.element.dataset.observacao == undefined) {
				var $state = $(

					'<span><img src="/img/nopicture.png" class="img-thumb" class="img-thumb" /> ' + state.text + '</span>'
				);
			} else {
				var $state = $(
					`<div class="row">

						<div class="col-md-1">
							<img src="/img/nopicture.png" class="img-thumb" />
						</div>
						<div class="col-md-10">
							${state.text}<br>
							<small style="color:#adadad; margin-left:5px">${state.element.dataset.observacao}</small>
						</div>
					</div>`
				);
			}
		} else {
			if (state.element.dataset.observacao == "" || state.element.dataset.observacao == undefined) {
				var $state = $(
					'<span><img src="' + state.element.dataset.imagem + '" class="img-thumb" /> ' + state.text + '</span>'
				)
			} else {
				var $state = $(
					`<div class="row">

						<div class="col-md-1">
							<img src="${state.element.dataset.imagem}" style="height:50px;width:50px" />
						</div>
						<div class="col-md-10">
							${state.text}<br>
							<small style="color:#adadad; margin-left:5px">${state.element.dataset.observacao}</small>
						</div>
					</div>`
				)
			}
		}
		return $state;


	};

	function thumbCliente3(state) {
		if (!state.id) {
			return state.Pes_Nome;
		}
		var celular = "";

		if (state.Paf_Imagem == "" || state.Paf_Imagem == undefined) {
			if (state.PAF_Observacao == "" || state.PAF_Observacao == undefined) {
				var $state = $(

					'<span><img src="/img/nopicture.png" class="img-thumb" class="img-thumb" /> ' + state.Pes_Nome + ' - '+state.Paf_Celular+'</span>'
				);
			} else {
				var $state = $(
					`<div class="row">

						<div class="col-md-1">
							<img src="/img/nopicture.png" class="img-thumb" />
						</div>
						<div class="col-md-10">
							${state.Pes_Nome} - ${state.Paf_Celular}<br>

							<small style="color:#adadad; margin-left:5px">${state.PAF_Observacao}</small>
						</div>
					</div>`
				);
			}
		} else {
			if (state.PAF_Observacao == "" || state.PAF_Observacao == undefined) {
				var $state = $(
					'<span><img src="' + state.Paf_Imagemm + '" class="img-thumb" /> ' + state.Pes_Nome + ' - '+state.Paf_Celular+'</span>'
				)
			} else {
				var $state = $(
					`<div class="row">

						<div class="col-md-1">
							<img src="${state.Paf_Imagem}" style="height:50px;width:50px" />
						</div>
						<div class="col-md-10">
							${state.Pes_Nome} - ${state.Paf_Celular}<br>

							<small style="color:#adadad; margin-left:5px">${state.PAF_Observacao}</small>
						</div>
					</div>`
				)
			}
		}
		return $state;


	};

