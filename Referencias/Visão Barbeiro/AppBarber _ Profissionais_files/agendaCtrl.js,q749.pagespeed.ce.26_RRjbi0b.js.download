	$scope.buscaNumeroRecorrente = function () {
		var numeroAgendamento = "";
		$("#recorrenciaQtd").html(numeroAgendamento);
		if ($("#recorrenciaPeriodicidade").val() == 7) {
			for (var i = 1; i <= 52; i++) {
				numeroAgendamento += "<option value='" + i + "'>" + i + "</option>";
			}
		} else if (($("#recorrenciaPeriodicidade").val() == 15) || ($("#recorrenciaPeriodicidade").val() == 21)) {
			for (var i = 1; i <= 25; i++) {
				numeroAgendamento += "<option value='" + i + "'>" + i + "</option>";
			}
		} else if ($("#recorrenciaPeriodicidade").val() == 30) {
			for (var i = 1; i <= 12; i++) {
				numeroAgendamento += "<option value='" + i + "'>" + i + "</option>";
			}
		} else {
			for (var i = 1; i <= 10; i++) {
				numeroAgendamento += "<option value='" + i + "'>" + i + "</option>";
			}
		}

		$("#recorrenciaQtd").html(numeroAgendamento);
	}

	$("#recorrenciaPeriodicidade").change(() => {
		$scope.buscaNumeroRecorrente();
	});

	$scope.buscaNumeroRecorrente();

	$scope.mudaTelaRecorrente = function (tipo) {
		if (tipo == 1) {
			$("#divHoraRecorrente").show();
			$("#divDataRecorrente").show();
			$("#divProfissionalRecorrente").removeClass("col-lg-12 col-xs-12");
			$("#divProfissionalRecorrente").addClass("col-lg-5 col-xs-6");
			$("#QtdPeriodicidadeRecorrente").show();
			$("#datasCancelaRecorrente").hide();
			$("#btnCancelarRecorrente").hide();
			$("#btnAgendarRecorrente").show();
		} else if (tipo == 2) {
			$("#divHoraRecorrente").hide();
			$("#divDataRecorrente").hide();
			$("#divProfissionalRecorrente").removeClass("col-lg-5 col-xs-6");
			$("#divProfissionalRecorrente").addClass("col-lg-12 col-xs-12");
			$("#QtdPeriodicidadeRecorrente").hide();
			$("#datasCancelaRecorrente").show();
			$("#btnCancelarRecorrente").show();
			$("#btnAgendarRecorrente").hide();
		}
	}
	$("#tipoRecorrencia").change(() => {
		if ($("#tipoRecorrencia").val() == 1) {
			$scope.mudaTelaRecorrente(1);
		} else {
			$scope.mudaTelaRecorrente(2);
		}
	});
	$("#tipoRecorrencia").change();

	$scope.cancelaRecorrente = function () {

		if ($("#servico_menuRecorrente").val() == '') {
			toastr.error("Informe o Serviço");
		} else if ($("#cliente_menu2").val() == "") {
			toastr.error("Informe o Cliente");
		} else if ($("#dataIniCancelaRecorrente").val() == "") {
			toastr.error("Informe a Data Inicial");
		} else if ($("#dataFimCancelaRecorrente").val() == "") {
			toastr.error("Informe a Data Final");
		} else {
			showLoader(true);
			$.ajax({
				method: "POST",
				dataType: "json",
				url: "/pages/cadastros/cancelaAgendamentoRecorrente.php",
				data: {
					servico: $("#servico_menuRecorrente").val(),
					profissional: $("#profissionalRecorrencia").val(),
					cliente: $("#cliente_menu2").val(),
					dataini: $("#dataIniCancelaRecorrente").val(),
					datafim: $("#dataFimCancelaRecorrente").val(),

				},
				success: (data) => {
					if (data.data[0].erro == "0") {
						$("#agendaHorario-modal").modal("hide");
						$("#cliente_menu2").val("");
						$("#servico_menuRecorrente").val("");
						$('.date.dataIniCancelaRecorrente').datepicker('update', datainirec);
						$('.date.dataFimCancelaRecorrente').datepicker('update', datafimrec);
						swal(data.data[0].resultado, "", "success");
						showLoader(false);

					} else {
						swal(data.data[0].resultado, "", "error");
						showLoader(false);
					}

				},
				error: () => {
					swal("Falha na conexão.", "", "error");
					showLoader(false);
				}
			});
		}
	}

		if ($_CONFIG.LISTA_PAIS.length > 0 ) {
			var html = "<option value=''></option>";
			for (var i = 0; i < $_CONFIG.LISTA_PAIS.length; i++) {
				
					html += "<option id='" +$_CONFIG.LISTA_PAIS[i].Pai_Sigla + "' value='" + $_CONFIG.LISTA_PAIS[i].Pai_Codigo + "'> " + $_CONFIG.LISTA_PAIS[i].Pai_Nome + "</option>";
				
			}
			$("#cliPaisAgendaEdt").html(html);
			$("#cliPaisNovoCadastro").html(html);
			$("#cliPaisNovoCadastro").val($_CONFIG.PAIS);
		}else{
			$.ajax({
				dataType: "json",
				url: '/pages/cadastros/buscaPais.php',
				method: "POST",
				success: function (data) {
					var html = "";
					var sigla = ($_CONFIG.language.mascaras.lang).toUpperCase()
					for (var i = 0; i < data.result.length; i++) {
						if(sigla == data.result[i].Pai_Sigla ){
							html += '<option selected value="' + data.result[i].Pai_Codigo + '" data-sigla="'+data.result[i].Pai_Sigla+'">' + data.result[i].Pai_Nome + '</option>';
						}else{
							html += '<option value="' + data.result[i].Pai_Codigo + '" data-sigla="'+data.result[i].Pai_Sigla+'">' + data.result[i].Pai_Nome + '</option>';
						}
					}
					$("#cliPaisAgendaEdt").html(html);
					$("#cliPaisNovoCadastro").html(html);
					$("#cliPaisNovoCadastro").val($_CONFIG.PAIS);
				}
			});
		}

	function buscaEstados(pais) {
		/*if ($_CONFIG.LISTA_ESTADO.length > 0) {
			var html = "<option value=''></option>";
			for (var i = 0; i < $_CONFIG.LISTA_ESTADO.length; i++) {
				if (pais != "pt") {
