	$scope.atualizaCalendario = function () {
		clearInterval(nIntervId);
		nIntervId = null;
		nIntervId = setInterval(
			function () {
				if (updateSchedule) {
					var view = $('#calendar').fullCalendar('getView');
					$scope.buscaAgendaV3(1, view.calendar.getDate().locale('pt-BR').format('L'));
				}
			},
			$scope.timerAgendaMS
		);
	}
	// para poder usar buscaComanda()) em sistemaCtrl
	var emit = $rootScope.$on('BuscaAgenda', function () {
