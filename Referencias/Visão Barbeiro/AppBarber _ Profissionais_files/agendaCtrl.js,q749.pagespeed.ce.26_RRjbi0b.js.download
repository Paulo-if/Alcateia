	$("#cliCep").keyup((e) => {
		buscaCEPCliente(e.currentTarget.value);
	});

	$("#cliCep2").keyup((e) => {
		buscaCEPCliente2(e.currentTarget.value);
	});

	var buscaCEPCliente = (cep) => {
		mCep = cep;
		if (cep && cep.length >= parseInt($_CONFIG.language.mascaras.max_cep)) {
			cep = cep.replace("-", "");
			showLoader(true);
			var pais = $_CONFIG.language.mascaras.lang;
			$.ajax({
				dataType: "json",
				method: 'POST',
				url: '/pages/cadastros/buscaPostalCode.php',
				data: {
					code: cep,
					pais: pais
				},
				success: (data) => {
					var estado = "";
					if (pais == "pt") {
						estado = $("#" + data.estado.replace(" ", "").toLowerCase() + "").val();
					} else {
						estado = $("#" + data.estado + "").val();
					}
					$("#cliEstado").val(estado);
					$("#cliCidade").empty();

					$.ajax({
						dataType: "json",
						url: '/pages/cadastros/buscaCidadesWizard.php',
						method: "POST",
						data: {
							estCodigo: estado,
							cidNome: data.cidade
						},
						success: (result) => {
							$("#cliCidade").append(result.cidades);
							$("#cliCidade").attr("disabled", false);
							setTimeout(() => {
								$("#cliCidade").val(result.cidcodigo);
							}, 10);
							showLoader(false);
							$("#cliBairro").val(data.bairro);
							$("#cliEndereco").val(data.endereco);
						}
					});
					showLoader(false);
				},
				error: () => {
					showLoader(false);
					swal($_CONFIG.language.mensagens.falha_consulta, $_CONFIG.language.mensagens.falha_cep, "error");
				}
			});
		}
	}

	var buscaCEPCliente2 = (cep) => {
		mCep = cep;
		if (cep && cep.length >= parseInt($_CONFIG.language.mascaras.max_cep)) {
			cep = cep.replace("-", "");
