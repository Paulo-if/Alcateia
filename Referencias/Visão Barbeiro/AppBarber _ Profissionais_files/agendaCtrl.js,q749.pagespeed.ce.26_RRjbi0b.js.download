	$scope.addTagAgendamento = function () {

		if ($("#tagAgendamentoText").val() != '') {

			$.ajax({
				dataType: "json",
				url: "/pages/cadastros/insereAgendamentoTag.php",
				type: 'POST',

				data: {
					agecodigo: $("#AgeCodigoTagAgendamento").val(),
					cor: $scope.stateTagColor,
					descricao: $("#tagAgendamentoText").val()
				},
				success: (data) => {
					if (data.data.length > 0) {
						if (data.data[0].erro == 0) {
							toastr.success(data.data[0].resultado)


							$.ajax({
								dataType: "json",
								url: "/pages/cadastros/buscaAgendamentoTag.php",
								type: 'GET',
								async: false,
								data: {
									agecodigo: $("#AgeCodigoTagAgendamento").val(),
									id: $_CONFIG.ID
								},
								success: (data) => {
									if (data.data.length > 0) {
										var tagcontent = "";
										for (var i = 0; i < data.data.length; i++) {

											tagcontent = tagcontent + `<label class="label" id="tagLabel${data.data[i].ATa_Codigo}" style="background-color:${data.data[i].ATa_Cor}">${data.data[i].ATa_Descricao} &nbsp<i class="fa fa-times pointer" ng-click="removeTagAgendamento(${data.data[i].ATa_Codigo})"></i> </label> &nbsp`
										}
										$("#listaTagsAgendamento").html(tagcontent)
										$compile($('#listaTagsAgendamento'))($scope);
									}
								}
							});


							$scope.isAgendamentoAntigo(2)


							$("#addtagagendamento-modal").modal('hide');
							$("#tagAgendamentoText").val('')
						} else {
							toastr.error(data.data[0].resultado)
						}
					}
				}
			});
		} else {
			toastr.error("Favor informe uma descrição para a tag")
		}


	}

	$scope.removeTagAgendamento = function (value) {
		$.ajax({
			dataType: "json",
			url: "/pages/cadastros/removeAgendamentoTag.php",
			type: 'POST',
			data: {
				codigo: value
			},
			success: (data) => {
				if (data.data.length > 0) {
					if (data.data[0].erro == 0) {
						toastr.success(data.data[0].resultado)
						$(`#tagLabel${value}`).remove()
						$(`#tagLabelPopUp${value}`).remove()
					} else {
						toastr.error(data.data[0].resultado)
					}
				}
			}
		});

	}

