		$('#tbBuscaListaAgenda tbody').on('click', 'td.remover', function () {
			var tr = $(this).closest('tr');
			var row = tabelaListaf.row(tr);
			var data = row.data();
			swal({
					title: "Deseja realmente retirar o cliente da lista?",
					type: "warning",
					showCancelButton: true,
					confirmButtonColor: "#DD6B55",
					confirmButtonText: "Sim",
					cancelButtonText: "Não",
					closeOnConfirm: true
				},
				function () {
					showLoader(true);
					$.ajax({
