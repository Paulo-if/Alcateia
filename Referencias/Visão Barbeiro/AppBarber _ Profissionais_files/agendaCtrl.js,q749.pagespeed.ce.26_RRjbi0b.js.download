	$('#servico_menuRecorrente').change((e) => {
		var tempoPadrao = parseInt($_CONFIG.TEMPOPADRAO);
		var tempoServico = parseInt(e.currentTarget.options[e.currentTarget.selectedIndex].dataset.tempo);
		if (isNaN(tempoServico)) {
			tempoServico = undefined;
		}
		if (tempoServico != undefined && tempoServico != "") {
			var html = '';
			for (var i = tempoPadrao; i < tempoPadrao * 15; i = i + tempoPadrao) {

				if (i == tempoServico) {
					html += '<option value="' + i + '" selected>' + i + ' Minutos</option>';
				} else {
					html += '<option value="' + i + '">' + i + ' Minutos</option>';
				}
			}

			$('#duracaoAgendamentoRecorrente').prop('disabled', false);
		} else {

			var html = '<option value="">Duração</option>';
			$('#duracaoAgendamentoRecorrente').prop('disabled', true);
		}
		$('#duracaoAgendamentoRecorrente').html(html);

		$('#duracaoAgendamentoRecorrente').val(tempoServico).trigger('change');
	});

	$('#servico_menuRecorrente').change();

	function setDateTimeZone() {

		if (curTimeZone != undefined) {
			drawTimeLine(curTimeZone);
		} else {

			fetch('/php/timezone.php')
				.then(data => data.json())
				.then((data) => {

					if (data.error == "0") {
						curTimeZone = new Date(data.datetime);
					} else {
						curTimeZone = new Date();
					}

					localStorage.setItem("lastDateRedLine", new Date().getTime());

					clearInterval(intervalTimeZone);
					intervalTimeZone = null;
					intervalTimeZone = setInterval(
						function () {

							var lastDateRedLine = parseInt(localStorage.getItem('lastDateRedLine'));

							if ((new Date().getTime() - lastDateRedLine) > 120000){
								curTimeZone = undefined;
								setDateTimeZone();
							} else {
								localStorage.setItem("lastDateRedLine", new Date().getTime());
								curTimeZone = new Date(curTimeZone.getTime() + 60000);
								drawTimeLine(curTimeZone);
							}
						}, 60000);



					drawTimeLine(curTimeZone);

				});
		}
	}

	function drawTimeLine(curTime) {

		var parentDiv = jQuery(".fc-agenda-slots:visible").parent();
		var timeline = parentDiv.children(".timelineAgenda");
		if (timeline.length == 0) {
			timeline = jQuery("<hr>").addClass("timelineAgenda").attr("data-toggle", "popover").attr("data-trigger", "hover").attr("tabindex", "0").attr("data-placement", "top").attr("data-content", "Hora Atual");
			parentDiv.prepend(timeline);
			$('[data-toggle="popover"]').popover({
				container: 'body'
			});
		}

		var curCalView = jQuery("#calendar").fullCalendar('getView');
		if (curCalView.start.toDate() < curTime && curCalView.end.toDate() > curTime) {
			timeline.show();
		} else {
			timeline.hide();
			return;
		}

		var minTimeCalendar = curCalView.opt("minTime");
		var mAuxCalendar = minTimeCalendar.substring(0, minTimeCalendar.length - 3);
		var hourMinCalendar = mAuxCalendar.split(":");

		var hourCalendar = parseInt(hourMinCalendar[0]);
		var minuteCalendar = parseInt(hourMinCalendar[1]);

		var percentHourMinCalendar = hourCalendar + (minuteCalendar / 60);

		var maxTimeCalendar = curCalView.opt("maxTime");
		var mAuxCalendarMax = maxTimeCalendar.substring(0, maxTimeCalendar.length - 3);
		var hourMaxCalendar = mAuxCalendarMax.split(":");


		var hourCalendarMax = parseInt(hourMaxCalendar[0]);
		var minuteCalendarMaxAux = parseInt(hourMaxCalendar[1]);

		var momInit = new moment();
		var momEnd = new moment();

		momInit.set('hour', hourCalendar);
		momInit.set('minute', minuteCalendar);
		momInit.set('second', 0);

		momEnd.set('hour', hourCalendarMax);
		momEnd.set('minute', minuteCalendarMaxAux);
		momEnd.set('second', 0);

		var diffHours = momEnd.diff(momInit);

		var diffHoursSum = ((diffHours / 1000) / 60) % parseInt($_CONFIG.TEMPOPADRAO);

		var minuteCalendarMax = parseInt(hourMaxCalendar[1]) +  ((diffHoursSum > 0) ? (parseInt($_CONFIG.TEMPOPADRAO) - diffHoursSum) : 0);

		var percentHourMaxCalendar = hourCalendarMax + (minuteCalendarMax / 60);

		var curSeconds = (((curTime.getHours() - percentHourMinCalendar) * 60 * 60) + (curTime.getMinutes() * 60) + curTime.getSeconds());
		var percentOfDay = curSeconds / ((percentHourMaxCalendar - percentHourMinCalendar) * 3600);
		var topLoc = Math.floor(parentDiv.height() * percentOfDay);
		var timeCol = $('.fc-time:visible');
		timeline.css("top", topLoc + "px");

		if (curCalView.name == "agendaWeek") {
			var dayCol = jQuery(".fc-today:visible");
			var left = dayCol.position().left + 1;
			var width = dayCol.width() - 2;
			timeline.css({
				left: left + "px",
				width: width + "px"
			});
		}

	}

