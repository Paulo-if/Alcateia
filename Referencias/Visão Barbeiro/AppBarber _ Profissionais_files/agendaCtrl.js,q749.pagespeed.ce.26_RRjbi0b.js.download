	$("#formAlteraAgendamentoObs").submit((e) => {
		e.preventDefault();
		var agendamentoID = $("#idAgendamentoAlteraObs").val();
		var obs = $('#ageAlteraObs').val();
		showLoader(true);
		$.ajax({
			dataType: 'json',
			url: "/pages/actions/atualizaHorario.php",
			method: "POST",
			data: {
				agendamento: agendamentoID,
				tipo: '2',
				observacao: obs
			},
			success: (data) => {
				if (data.result[0].erro == 1) {
					swal(data.result[0].resultado, '', 'error');
				} else {
					toastr.success('Observação atualizada com sucesso.');
					$scope.isAgendamentoAntigo(2);
				}
				showLoader(false);
			},
			error: () => {
				swal('Falha na conexão.', '', 'error');
				showLoader(false);
			}
		});
	})

	$scope.buscaHorariosDisponives = function () {
		$("#divTabelaHorDisp").hide()
		$('#buscaHorariosDisponivel-modal').modal()
	}

	$scope.listaProfissional = '';
	$('#formBuscaHorariosDisponiveis').submit((e) => {
		e.preventDefault();
		showLoader(true);

		if ($("#profisisonalHorDisp").val() == "") {
			toastr.error("Informe o Profissional");
		} else if ($("#servicoHorDisp").val() == "") {
			toastr.error("Informe o Serviço");
		} else if (($("#dataIniHorarioDisp").val() == "") || ($("#dataFimHorarioDisp").val() == "")) {
			toastr.error("Informe um Período válido");
		} else {
			$("#divTabelaHorDisp").show()
			if (typeof (tbhordisp) != "undefined") {
				tbhordisp.destroy();
				$('#tabelaHorDisp tbody').unbind('click')
			}
			tbhordisp = $('#tabelaHorDisp').DataTable({
				"dom": 'T<"clear">lfrtip',
				"ajax": {
					"url": "/pages/cadastros/relatorioHorarioDisponivel.php",
					"method": "POST",
					"data": (d) => {
						d.profissional = $("#profisisonalHorDisp").val();
						d.servico = $("#servicoHorDisp").val();
						d.dataini = $("#dataIniHorarioDisp").val();
						d.datafim = $("#dataFimHorarioDisp").val();
					}
				},
				columnDefs: [{
					"defaultContent": "-",
					"targets": "_all"
				}],
				"scrollX": isPortrait,
				"initComplete": (d, i) => {
					if (i.data[0].erro == "1") {
						toastr.error(i.data[0].resultado);
						$('#tabelaHorDisp tbody').unbind('click')
						$("#divTabelaHorDisp").hide()
					}
				},
				"columns": [{
						"data": "dialivre",
						"type": "moment-DD/MM/YYYY"
					},
					{
						"data": "total"
					},
					{
						"class": 'verListaHorios',
						"orderable": false,
						"data": null,
						"defaultContent": '<button class="btn btn-primary btn-xs"  type="button">Ver horários</button>',
					},
					{
						"class": 'HorarioAnalitico',
						"orderable": false,
						"data": null,
						"defaultContent": '<button class="btn btn-success btn-xs"  type="button" >Ver na agenda</button>',
					},
				],

				"language": {
					"url": "//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json"
				}
			});

			$('#tabelaHorDisp tbody').on('click', 'td.HorarioAnalitico', (e) => {
				var tr = $(e.currentTarget).closest('tr');
				var row = tbhordisp.row(tr);
				var data = row.data();
				showLoader(true);
				$("#buscaHorariosDisponivel-modal").modal('hide');
				var listProf = localStorage.getItem("profissionais").split(",");

				if (_.indexOf(listProf, data.profissional.toString()) == -1) {

					listProf.push(data.profissional.toString());
					$('#users_menu').multiselect('deselectAll', false);
					$('#users_menu').multiselect('select', listProf).change();
					setTimeout(() => {
						$('#dvCalendario').datepicker('setDate', data.dialivre);
					}, 500);
				} else {

					$('#dvCalendario').datepicker('setDate', data.dialivre);
				}

				showLoader(false);

			});


			
			$('#tabelaHorDisp tbody').on('click', 'td.verListaHorios', (e) => {
				var tr = $(e.currentTarget).closest('tr');
				var row = tbhordisp.row(tr);
				var data = row.data();
				showLoader(true);
				var htmlhorarios = '';
				var datadia = `${((data.dia < 10) ? '0' : '')}${data.dia}/${((data.mes < 10) ? '0' : '')}${data.mes}/${data.ano}`
				var dataformat = `${data.ano}-${((data.mes < 10) ? '0' : '')}${data.mes}-${((data.dia < 10) ? '0' : '')}${data.dia}`
				var sertempo = data.sertempo;
				var servico = data.servico;
				$.ajax({
					method: "POST",
					dataType: "json",
					url: "/pages/cadastros/buscaHorariosDisponiveisv2.php",
					data: {
						servico: data.servico,
						profissional: data.profissional,
						dia: data.dia,
						mes: data.mes,
						ano: data.ano
					},
					success: (data) => {
						$scope.listaProfissional = data.data
						$scope.listaProfissional[0].data = dataformat;
						$scope.listaProfissional[0].tempo = sertempo;
						$scope.listaProfissional[0].servico = servico;
						$scope.listaProfissional[0].dialivre = datadia;
						htmlhorarios = `Horários no(a) *${$_CONFIG.ESTABELECIMENTO}* para o dia *${datadia}* \nProfissional: *${$scope.listaProfissional[0].Apelido}*  \n\n`
						for (var i = 0; i < $scope.listaProfissional[0].horarios.length; i++) {
							$scope.listaProfissional[0].horarios[i].DataIni = ($scope.listaProfissional[0].horarios[i].DataIni).split(":")[0] + ':' + ($scope.listaProfissional[0].horarios[i].DataIni).split(":")[1]
							htmlhorarios = htmlhorarios + ' - '+ ($scope.listaProfissional[0].horarios[i].DataIni).split(":")[0] + ':' + ($scope.listaProfissional[0].horarios[i].DataIni).split(":")[1] + '\n'
						}
						
						$scope.$apply();
						$("#listaHorariosProfissionalDetalhes-modal").modal()
						var dadosbotao =' <button class="btn btn-block btn-primary btnCliphorarios" data-clipboard-text="' + htmlhorarios + '" ><i class="fa fa-copy" alt="Copiar"></i> Copiar horários</button>';
						$("#btnCopiarHorarios").html(dadosbotao);
						var clipboard = new ClipboardJS('.btnCliphorarios');
						clipboard.on('success', function (e) {
							toastr.success("Copiado!");
						});
					}
				});
				//$('#tabelaHorDisp tbody').unbind('click')
				showLoader(false);

			});
		}

		showLoader(false);
		return true;
	});

