	$("#btnInserirAg").on("click", function () {
		showLoader(true)
		var profissional = $("#edtProfissional").val();
		var dia = $('#edtData2').val();
		var hora = $("#edtHoraIni").val();
		var cliente = $("#cliente_menu").val();
		var txtObs = $("#txtObs").val();
		var dataInicio = moment(dia + " " + hora, "YYYY-MM-DD HH:mm");

		var stringData = new Array();
		var stringItem = new Array();
		var stringTipoItem = new Array();
		var stringProfissional = new Array();
		var stringDuracao = new Array();
		var dataAux = dataInicio;

		for (var i = 0; i < $scope.numeroServicos; i++){
			stringItem.push($("#servico_menu" + i).val())
			stringTipoItem.push($("#servico_menu" + i + " option:selected").get(0).dataset.tipoitem)
			stringProfissional.push(profissional),
			stringDuracao.push(parseInt($("#tempo_menu" + i).val()));
			stringData.push(dataAux.format("YYYY-MM-DD HH:mm"));
			dataAux = dataAux.add(parseInt($("#tempo_menu" + i).val()), "m")
		}

		if ($("#cbEnviaSms").get(0).checked) {
			var cbEnviaSms = 1;
		} else {
			var cbEnviaSms = 0;
		}
		if ($('#cbEnviaWhats').get(0).checked) {
			var cbEnviaWhats = 1;
		} else {
			var cbEnviaWhats = 0;
		}

		$.ajax({
			dataType: "json",
			type: "POST",
			url: "/pages/cadastros/insereAgendamentov5.php",
			data: {
				item: stringItem.toString(),
				tipoitem: stringTipoItem.toString(),
				profissional: stringProfissional.toString(),
				dataagendamento: stringData.toString(),
				duracao: stringDuracao.toString(),
				cliente: cliente,
				cupom: '',
				numitens: $scope.numeroServicos,
				ageorigem:2,
				observacao:txtObs,
				lembrete: $("#add_lembrete_menu").val(),
				tempolembrete: $("#qtd_lembrete_menu").val(),
				sms: cbEnviaSms,
				whats: cbEnviaWhats
			},
			success: function (data) {
				if (data.data[0].erro == 0) {
					toastr.success(data.data[0].resultado);
					$scope.isAgendamentoAntigo(2);
					$('#agendaHorario-modal').modal('hide');
					showLoader(false);
				} else if (data.data[0].erro == 1) {
					swal(data.data[0].resultado, "", "error");
					showLoader(false);
				} else {
					swal(data.data[0].resultado, "", "error");
					showLoader(false);
				}
			},
			error: function (result) {

				showLoader(false);
			}
		});
	});

	$scope.buscaSaldoSMS = function () {
		$.ajax({
			dataType: "json",
			url: '/pages/actions/buscaSaldoSMS.php',
			success: function (data) {
				if (data.result.length > 0) {
					$("#lblSaldoSMSAg").html(data.result[0].Saldo);
					$scope.saldoSMS = data.result[0].Saldo;
					$scope.$apply();
