	$("#cliEstado2").change((e) => {
		var estado = e.currentTarget.value;
		$("#cliCidade2").empty();

		if (estado === -1) {
			$("#cliCidade2").attr("disabled", true);
		} else {
			$.ajax({
				dataType: "html",
				url: '/pages/cadastros/buscaCidades.php',
				method: "POST",
				data: {
					estCodigo: estado
				},
				success: (data) => {
					$("#cliCidade2").append(data);
					$("#cliCidade2").attr("disabled", false);
				}
			});
		}
	});
	$("#cliEstado").change((e) => {
		var estado = e.currentTarget.value;
		$("#cliCidade").empty();

		if (estado === -1) {
			$("#cliCidade").attr("disabled", true);
		} else {
			$.ajax({
				dataType: "html",
