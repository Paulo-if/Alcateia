	$("#btnRealizadoAg").click(() => {
		if($scope.finalAgendamentoRecorrente == 2){
			$App.showMessageColor("Agendamento recorrente", "Este é um dos últimos agendamentos recorrentes do cliente, caso necessário renove pela sua agenda", 1, '', 'info')
		}else if($scope.finalAgendamentoRecorrente == 1){
			$App.showMessageColor("Agendamento recorrente", "Este é o penúltimo agendamento recorrente do cliente", 1, '', 'info')
		}else if($scope.finalAgendamentoRecorrente == 0){
			$App.showMessageColor("Agendamento recorrente", "Esse é o último agendamento recorrente da lista, você pode lançar uma nova lista de agendamentos para o cliente pela sua agenda", 1, '', 'warning')
		}

		$('#ageValor').val($('#lblValorHdn').html());
		$('#codCliente').val($('#lblPesCodigo').html())
		if ($('#codCliente').val() == "") {
			$("#btnAssociaClienteComanda").show();
		} else {
			$("#btnAssociaClienteComanda").hide();
		}
		$scope.buscaPessoaConta();
		$scope.atualizaTipoPagemento();
		var agendamentoID = $("#lblIDAgendamento").html();

		$.ajax({
			dataType: "json",
			url: localStorage.getItem("host"),
			data: {
				metodo: 'buscaComanda',
				id: $scope.idCliente,
				agecodigo: agendamentoID,
				tipo: 3
			},
			success: (data) => {
				if (data.result[0].TPR_Codigo == 3) {
					$("#labelTipoClienteComanda").html("Profissional: ");
					$("#iconInfoCliente").hide();
					$("#infoPontosCli").hide();
					$("#TprTipoComanda").html(data.result[0].TPR_Codigo);
				} else {
					$("#labelTipoClienteComanda").html("Cliente: ");
					$("#iconInfoCliente").show();
					$("#TprTipoComanda").html(data.result[0].TPR_Codigo);

					if (data.result[0].Cliente != "") {
						$("#nomeClienteComanda").html(data.result[0].Cliente);
						$("#iconInfoCliente").show();
					} else {
						$("#nomeClienteComanda").html("Sem Cadastro");
						$("#iconInfoCliente").hide();
					}
					$("#infoPontosCli").show();

						$.ajax({
							dataType: "html",
							url: '/pages/relatorios/buscaProgramaFidelidade.php',
							method: "POST",
							data: {
								selCliente: data.result[0].CodigoCliente,
								selTipo: 1
							},
							dataType: "json",
							success: function (data) {

								if (data.data.length == 1) {
									$("#stringPontosCli").html(data.data[0].TotalPontos);
								} else {
									$("#stringPontosCli").html(0);
								}

							}
						});
				}

				$("#idComanda").html(data.result[0].Com_Codigo);
				if (data.result[0].CCE_Cod_Externo != '') {
					$("#idComandaExterno").html('N˚: ' + data.result[0].CCE_Cod_Externo);
					$("#idComandaExterno").show();
				} else {
					$("#idComandaExterno").html('');
					$("#idComandaExterno").hide();
				}
				$("#dataComanda").html(data.result[0].Com_Dat_Cadastro);
				$("#edtComCartao").val(data.result[0].Com_Cod_Externo);
				$("#codCliente").val()
				$('#infohorario-modal').modal('hide');
				$('#comanda-modal').modal('show');
				// setTimeout(function () {
				// 	$rootScope.$emit("buscaTransacao", data.result[0].Com_Codigo);
				// }, 500)


				$scope.buscaItensComanda(data.result[0].Com_Codigo);

			},
			error: () => {
				swal("Falha na conexão.", "", "error");
			}
		});
	});

