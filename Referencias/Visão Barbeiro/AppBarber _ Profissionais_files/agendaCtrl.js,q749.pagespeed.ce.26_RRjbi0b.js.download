	$scope.insereServicoEncaixe = function () {
		$('#formInsereServicoEncaixe').each((_, el) => {
			el.reset();
		});

		if (curTimeZone.getMinutes() < 10) {
			var hora = curTimeZone.getHours() + '0' + curTimeZone.getMinutes();
		} else {
			var hora = curTimeZone.getHours() + '' + curTimeZone.getMinutes();
		}
		$('.divDataServicoEncaixe').datepicker('update', curTimeZone);
		var horas = new Array();
		for (var i = 0; i < $('#comHoraIniEncaixe option').length; i++) {
			horas.push($('#comHoraIniEncaixe option')[i].value.replace(':', ''))
		}

		$('#comHoraIniEncaixe').select2();
		$('#comHoraIniEncaixe').select2('val', '');
		var hour = getproxhora(horas, hora);
		$('#comHoraIniEncaixe').val(hour.toString().splice(2, 0, ':'))
		$('#comHoraIniEncaixe').change();

		$.ajax({
			dataType: 'json',
			url: '/pages/cadastros/buscaServicoSelectCombo.php',
			success: (result) => {
				var combo = '';
				$('#insertServicoEncaixe').html('<option value =""  data-valor="" data-tipopreco="">Selecione um Serviço</option>');
				for (var i = 0; i < result.servicos.length; i++) {

					combo += '<option value =' + result.servicos[i].Ser_Codigo + ' data-valor="' + result.servicos[i].Ser_Valor + '" data-tipopreco="' + result.servicos[i].Ser_Tip_Preco + '" name="' + result.servicos[i].Ser_Duplo + '" data-tipoitem="'+result.servicos[i].TipoItem+'">' + result.servicos[i].Ser_Descricao + '</option>';
				}
				$('#insertServicoEncaixe').append(combo);
				$('#insertServicoEncaixe').select2({
					templateResult: thumbServico
				});
				$('#insertServicoEncaixe').select2('val', '');

				$('#insertServicoEncaixe').change((e) => {
					setTimeout(() => {
						if (e.currentTarget.value != '' && $('#comInsertProfissionalEncaixe').val() != '') {
							if($('#insertServicoEncaixe option:selected').get(0).dataset.tipoitem == '1'){
								buscaAssocProfissionalServico($('#insertServicoEncaixe').val(), $('#comInsertProfissionalEncaixe').val());
							}
						}
					}, 300);
				});
			}
		});

		var dataatual = moment().locale('pt-br').format('L');

		$('#comInsertProfissional').select2('val', '');
		//$('.divDataServicoEncaixe').datepicker('update', dataatual);

		$('#insertServicoEncaixe-modal').modal('show');
	}

