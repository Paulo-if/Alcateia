	$("#cliente_menu").on("change",function(){
		
		if($("#cliente_menu").val() != null && $("#cliente_menu").val() != ""){
			if($("#cliente_menu option:selected").get(0).dataset.ausente == 1){
				$("#jaAusentouFlag").html(` <i class="fa fa-exclamation-triangle" style="color: red"></i> <span style="color: red">Sim</span>`)
			}else{
				$("#jaAusentouFlag").html(` Não`)
			}
		}

		var codigoCliente = $("#cliente_menu").val()
		var pessoaConta = '';
		
		if (codigoCliente != '' && codigoCliente != 0 && codigoCliente != null) {

			$.ajax({
				dataType: 'json',
				url: "/pages/actions/buscaPessoaConta.php",
				type: 'POST',
				data: {
					tipo: '5',
					cliente: codigoCliente
				},
				success: function (result) {
					if (result.result[0] != undefined) {
						if (result.result[0].SaldoReal < 0.00) {
							pessoaConta += "<span style='color:red'> <i class='fa fa-arrow-down'> </i> " + result.result[0].PCo_Saldo + "</span>";
						} else if (result.result[0].SaldoReal > 0.00) {
							pessoaConta += "<span style='color:green'> <i class='fa fa-arrow-up'> </i> " + result.result[0].PCo_Saldo + "</span>";
						}else{
							pessoaConta += ` ${$_CONFIG.MOEDA} 0,00`
						}
					}
					$("#saldoContaCliAge").html(pessoaConta);
				},
				error: function (result) {
					toastr.error("Falha na conexão.");
					showLoader(false);
				}
			});
			var isAssinante ='';
			$("#IsAssinanteCliente").html(' Não')
			$.ajax({
				dataType: "json",
				url: "/pages/cadastros/buscaAssinaturaPessoaV3.php",
				method: "POST",
				data: {
					pescodigo: codigoCliente,
					asscodigo: '',
					tipo: 3,
					dataini: '',
					datafim: ''
				},
				success: function (result) {
					if(result.data.length > 0 ){
						if(result.data[0].erro ==  undefined){
							if(result.data[0].Ass_Descricao != ''){

								var status =`<i class="fa fa-circle" style="color:orange" data-toggle="tooltip" title="A Vencer."></i>`
								if(result.data[0].AssStatus == "Inadimplente"){
									status =`<i class="fa fa-circle" style="color:red" data-toggle="tooltip" title="Inadimplente"></i>`
								}else if(result.data[0].AssStatus == "Em Dia"){
									status =`<i class="fa fa-circle" style="color:green" data-toggle="tooltip" title="Em Dia"></i>`
								}else if(result.data[0].AssStatus == "Atrasado"){
									status =`<i class="fa fa-circle" style="color:orange" data-toggle="tooltip" title="Atrasado"></i>`
								}
								isAssinante = ` <span>${status} ${result.data[0].Ass_Descricao}</span>`
							}else{
								isAssinante = 'Não'
							}
							$("#IsAssinanteCliente").html(isAssinante);
						}
					}
				}
			});

			$.ajax({
				url: '/pages/cadastros/buscaPacotesPessoaCombo.php',
				type: 'POST',
				dataType: 'json',
				async: false,
				data: {
					pescodigo: codigoCliente,
					codigo: $("#servico_menu0").val(),
					tipo: 1
				},
				success: function (data) {
					if (data.result.length > 0) {
						$("#HasPacotesCliente").html(" Possuí pacotes para o serviço")
					}else{
						$("#HasPacotesCliente").html(" Sem pacotes disponíveis para o serviço")
					}

					showLoader(false);
				},
				error: function (result) {
					toastr.error("Falha na conexão.");
					showLoader(false);
				}
			});
		} else {
			$("#saldoContaCliAge").html('');
			$("#IsAssinanteCliente").html('');
		}
	})

	selecionaHorarioAgenda = function (startDate,endDate,profissional,view,servico = ''){
		var cbBloqueio = $('#cbBloqHorario').is(':checked');
		if ((view.name == "month") || (view.name == 'agendaWeek')) {
			$('#calendar').fullCalendar('gotoDate', startDate);
			$('#calendar').fullCalendar('changeView', 'resourceDay');
			$('#dvCalendario').datepicker('setDate', startDate);
		} else {
			if (cbBloqueio) {
				var bloqProfissional = profissional;
				var dataIniBloq = startDate.year() + '/' + (startDate.month() + 1) + '/' + startDate.date();
				var dataFimBloq = endDate.year() + '/' + (endDate.month() + 1) + '/' + endDate.date();
				var horaIniBloq = startDate.hour() + ':' + startDate.minute();
				var horaFimBloq = endDate.hour() + ':' + endDate.minute();
				$.ajax({
					dataType: 'json',
					url: "/pages/actions/agendaHorarioBloqueado.php",
					method: "POST",
					data: {
						profissional: bloqProfissional,
						diaini: dataIniBloq,
						diafim: dataFimBloq,
						horaini: horaIniBloq,
						horafim: horaFimBloq,
						observacao: 'Agenda Bloqueada'
					},
					success: function (data) {
						if (data.agendaHorarioBloqueado[0].erro == 1) {
							toastr.error(data.agendaHorarioBloqueado[0].resultado);
						} else {
							toastr.success(data.agendaHorarioBloqueado[0].resultado);
							$scope.atualizaEventos();
						}
					}
				});
			} else {
				if (!carregando) {
					var liveDate = new Date();
					$.ajax({
						dataType: 'json',
						url: "/pages/actions/buscaServicos.php",
						method: "POST",
						data: {
							profissional: profissional,
							tipo: 9,
						},
						success: (data) => {
							$scope.servicoSelect = data.servicos;
							$scope.numeroServicos = 0;
							$scope.criaServicoSelect();
							$('#servico_menuRecorrente').html('<option  value="">Selecione um Serviço</option>');
							$('#servicoAlteraAgendamento').html('<option data-tempo="" value="">Selecione um Serviço</option>');
							for (var i = 0; i < data.servicos.length; i++) {
								if(data.servicos[i].TipoItem == 1){
									$('#servico_menuRecorrente').append('<option data-tempo="' + data.servicos[i].Ser_Intervalo_Padrao + '" value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>')
									$('#servicoAlteraAgendamento').append('<option data-tempo="' + data.servicos[i].Ser_Intervalo_Padrao + '" value="' + data.servicos[i].Ser_Codigo + '">' + data.servicos[i].Ser_Descricao + '</option>')
								}
							};

							if(servico != ''){
								setTimeout(()=>{
									$('#servico_menu0').val(servico).change()
								},500)
							}
						}
					});

					$.ajax({
						dataType: 'json',
						url: '/pages/actions/buscaParametro.php',
						method: 'POST',
						data: {
							parcodigo: 52,
							origem: 1
						},
						success: (param3) => {
							$("#geralinkconfirmacao").val(param3.result[0].PVa_Vlr_Principal);
						}
					});
					
					$('#cliente_menu').select2('val', '');
					$('#edtData').val(startDate.format('DD/MM/YYYY'));
					$('#edtData').attr('disabled', true);
					$('#dataAgendamentoRecorrente').val(startDate.format('DD/MM/YYYY'));
					$('#dataAgendamentoRecorrente2').val(startDate.format('YYYY/MM/DD'));
					$('#dataAgendamentoRecorrente').attr('disabled', true);
					$('#celendardisabled').attr('disabled', true);
					$('#celendardisabled').unbind('click');
					$('#edtData2').val(startDate.format('YYYY/MM/DD'));
					$('#edtHoraIni').timepicker('setTime', startDate.format('HH:mm'));
					$('#horaAgendamentoRecorrente').timepicker('setTime', startDate.format('HH:mm'));
					$('#edtHoraIni2').timepicker('setTime', startDate.format('HH:mm'));
					$('#edtProfissional').val(profissional);
					$('#edtProfissional').attr('disabled', true);
					$('#profissionalRecorrencia').val(profissional);
					$('#profissionalRecorrencia2').val(profissional);
					$('#edtProfissionalBloqueado').val(profissional);
					$('#edtProfissionalDesbloquear').val(profissional);
					$('#profissionalRecorrencia').attr('disabled', true);
					$('#edtDataBloqueado').val(startDate.format('DD/MM/YYYY'));
					$('#edtData2Bloqueado').val(startDate.format('YYYY/MM/DD'));
					$('#edtDataFimBloqueado').val(startDate.format('DD/MM/YYYY'));
					$('#edtDataFim2Bloqueado').val(startDate.format('YYYY/MM/DD'));
					$('.date.dateAltAge').datepicker('update', startDate.format('DD/MM/YYYY'));
					$('.date.DateBloqueio').datepicker('update', startDate.format('DD/MM/YYYY'));
					$('.date.DateBloqueioFim').datepicker('update', startDate.format('DD/MM/YYYY'));
					$('#txtObsBloqueado').val("");
					$('#add_lembrete_menu').val(0).trigger('change');
					$('#txtObs').val("");
					$('#agendaHorario-modal').modal();
					$scope.buscaSaldoSMS();
					$scope.buscaSaldoWhats();
				}
			}
		}
	}

	// initCalendar();
	// initContextMenu();
	$scope.goToDataAgenda = function(hora, data, tempo,profissional,dialivre, servico){
		var dataini = moment(`${data} ${hora}`);
		var datafim = moment(`${data} ${hora}`).add(+tempo, 'minutes');
		var listProf = localStorage.getItem("profissionais").split(",");

		if (_.indexOf(listProf, profissional.toString()) == -1) {

			listProf.push(profissional.toString());
			$('#users_menu').multiselect('deselectAll', false);
			$('#users_menu').multiselect('select', listProf).change();
			setTimeout(() => {
				$('#dvCalendario').datepicker('setDate', dialivre);
			}, 500);
		} else {

			$('#dvCalendario').datepicker('setDate', dialivre);
		}
		$('#calendar').fullCalendar('changeView', 'resourceDay');
		selecionaHorarioAgenda(dataini,datafim,profissional,'resourceDay',servico)
		$("#listaHorariosProfissionalDetalhes-modal").modal('hide')
		$("#buscaHorariosDisponivel-modal").modal('hide')
	}

	$scope.buscaCategoriasAgenda = function(){

		var htmlcategoria ="";
		$.ajax({
		type: "POST",
		url: "/pages/cadastros/buscaCategoria.php",
		dataType: "json",     
		data:{tipo : 1},
		success: function(result) {
			htmlcategoria += "<br>";
			for(var i = 0; i<result.data.length;i++)
			{
				htmlcategoria += "<button id="+result.data[i].TCa_Codigo+" ng-click='changeCategoriaAgenda("+result.data[i].TCa_Codigo+")' class=' btncategoria btn btn-block btn-default' >"+result.data[i].TCa_Descricao+"</button>";
			}
			htmlcategoria += "<br>";
	
			$("#categoriasRodizioAgenda").html(htmlcategoria);
			$compile($('#categoriasRodizioAgenda'))($scope);
			$("#selecionarCategoria-modal").modal('show')
		},
		error: function(result) {
			swal("Falha na conexão." , "", "error");
			showLoader(false);
		}
		});
	}



	$scope.changeCategoriaAgenda = function(tcacodigo){
		showLoader(true)
		$.ajax({
			dataType: 'json',
			url: "/pages/cadastros/buscaCategoriaProfissionalv2.php",
			data: {
			
				tcacodigo: tcacodigo,
				pescodigo: ''
			},
			success: (data) => {
				if(data.data.length > 0){
					localStorage.removeItem("profissionais");
					var listaProf = [];
					for (var i = 0; i < data.data.length; i++) {
						listaProf.push(data.data[i].Pes_Codigo)
					}
					localStorage.setItem("profissionais",listaProf);
					setStorage("profissionais_" + $_CONFIG.CODESTABELECIMENTO, listaProf);
					$('#users_menu').multiselect('deselectAll', false);
					$('#users_menu').multiselect('select', listaProf).change();

					$("#selecionarCategoria-modal").modal('hide')
					showLoader(false)
				}else{
					toastr.warning('Nenhum profissional associado a essa categoria')
					showLoader(false)
				}
			}
		});
	}

	$scope.openWhatsAgendamento = function(){
		$.ajax({
			type: "POST",
			url: "/pages/cadastros/AGENDAMENTO_Busca.php",
			data: {
				type: 1,
				scheduling_code: $("#lblIDAgendamento").html()
			},
			dataType: "json",
			success: (result) => {
				var celular = result.data.scheduling[0].person_phone;
				sendWhatsReminder(celular, '');
			}
		});
	}
	
});