	$("#select").hide();
	$("#qtdDiasDiv").hide();

	$("#edtTipoBloqueio").on('change', function () {
		$scope.bloqueioTipo();
	});

	$scope.bloqueioTipo = function () {
		if ($("#edtTipoBloqueio").val() == "1") {
			$("#edtDataBloqueado").prop('disabled', true);
			$("#edtDataFimBloqueado").prop('disabled', true);
			$("#addonini").hide();
			$("#addonfim").hide();
			$("#datafimhide").hide();
			$("#edtProfissionalBloqueado").hide();
			$("#select").show();
			$("#qtdDiasDiv").show();
		} else {
			$("#edtDataBloqueado").prop('disabled', false);
			$("#edtDataFimBloqueado").prop('disabled', false);
			$("#addonini").show();
			$("#addonfim").show();
			$("#datafimhide").show();
			$("#edtProfissionalBloqueado").show();
			$("#select").hide();
			$("#qtdDiasDiv").hide();
		}
	}

	$("#edtQuantidadeDiasBloqueado").keyup(function () {
		if ($("#edtQuantidadeDiasBloqueado").val() > 180) {
			$("#edtQuantidadeDiasBloqueado").val(180);
		}
	});

	$("#btnInserirBloqueado").on('click', function () {
		if ($("#edtTipoBloqueio").val() == "0") {
			var id = $scope.idCliente;
			var profissionalBloqueado = $("#edtProfissionalBloqueado").val();
			var diaIniBloqueado = $('#edtData2Bloqueado').val();
			var diaFimBloqueado = $('#edtDataFim2Bloqueado').val();
			var horaIniBloqueado = $("#edtHoraIniBloqueado").val();
			var horaFimBloqueado = $("#edtHoraFimBloqueado").val();
			var txtObsBloqueado = $("#txtObsBloqueado").val();
			showLoader(true);
			$.ajax({
				dataType: "json",
				url: "/pages/actions/agendaHorarioBloqueado.php",
				method: "POST",
				data: {
					profissional: profissionalBloqueado,
					diaini: diaIniBloqueado,
					diafim: diaFimBloqueado,
					horaini: horaIniBloqueado,
					horafim: horaFimBloqueado,
					observacao: txtObsBloqueado
				},
				success: function (data) {
					if (data.agendaHorarioBloqueado[0].erro == 1) {
						swal(data.agendaHorarioBloqueado[0].resultado, "", "error");
					} else {
						$('#agendaHorario-modal').modal('hide');
						swal(data.agendaHorarioBloqueado[0].resultado, "", "success");
						$scope.isAgendamentoAntigo(2);
						$("#edtTipoBloqueio").val(0);
						$scope.bloqueioTipo();
					}
					showLoader(false);
				},
				error: function (result) {
					swal("Falha na conexão.", "", "error");
					showLoader(false);
				}
			});
		} else {
			var profissionalBloqueado = $("#edtMultiProfissionalBloqueado").val();
			var diaIniBloqueado = $('#edtData2Bloqueado').val();
			var diaFimBloqueado = $('#edtDataFim2Bloqueado').val();
			var horaIniBloqueado = $("#edtHoraIniBloqueado").val();
			var horaFimBloqueado = $("#edtHoraFimBloqueado").val();
			var txtObsBloqueado = $("#txtObsBloqueado").val();
			var qtdDias = $("#edtQuantidadeDiasBloqueado").val();
			var periodicidade = $("#edtPeriodicidadeBloqueado").val();
			showLoader(true);
			$("#btnInserirBloqueado").attr('disabled', true);
			$("#btnInserirBloqueado").html('<i class="fa fa-spinner fa-pulse"></i> Cadastrando...');	
			$.ajax({
				dataType: "json",
				type: "POST",
				url: "/pages/cadastros/insereAgendamentoBloqueadoRecorrentev2.php",
				data: {
					profissionalBloqueado: profissionalBloqueado,
					diaIniBloqueado: diaIniBloqueado,
					diaFimBloqueado: diaFimBloqueado,
					horaIniBloqueado: horaIniBloqueado,
					horaFimBloqueado: horaFimBloqueado,
					txtObsBloqueado: txtObsBloqueado,
					qtdDias: qtdDias,
					periodicidade: periodicidade
				},
				success: function (data) {
					if (data.falha == "0") {
						$('#agendaHorario-modal').modal('hide');
						swal("Horários bloqueados com sucesso", "", "success");
						$scope.isAgendamentoAntigo(2);

						$("#edtTipoBloqueio").val(0);
						$scope.bloqueioTipo();
						showLoader(false);
						$("#btnInserirBloqueado").removeAttr('disabled');
						$("#btnInserirBloqueado").html('BLOQUEAR');
					} else {

						swal("Erro ao bloquear horários, confira seus dados de bloqueio", "", "error");
						showLoader(false);
						$("#btnInserirBloqueado").removeAttr('disabled');
						$("#btnInserirBloqueado").html('BLOQUEAR');
					}
				},
				error: function (result) {
					swal("Falha na conexão.", "", "error");
					showLoader(false);
				}
			});
		}

	});

	$("#btnCancelarAg").on('click', () => {
		var agendamentoID = $("#lblIDAgendamento").html();
		$("#cancelarAgendamento-modal").modal();
		$('#formCancelaAgendamento').unbind('submit');
		$('#formCancelaAgendamento').submit((e) => {
			formCancela = $(e.currentTarget);
			showLoader(true);
			$.ajax({
				dataType: "json",
				url: "/pages/actions/cancelaHorario.php",
				method: "POST",
				data: {
					agendamento: agendamentoID,
					motivo: $("#ageMotivo").val()
				},
				success: (data) => {
					if (data.cancelaHorario[0].erro == 1) {
						toastr.error(data.cancelaHorario[0].resultado, "");
					} else {
						$('#infohorario-modal').modal('hide');
						toastr.success("Agendamento foi cancelado com sucesso.");
						$scope.isAgendamentoAntigo(2);
					}
					$("#cancelarAgendamento-modal").modal("hide");
					formCancela.each((_, el) => {
						el.reset();
					});
					showLoader(false);
				},
				error: () => {
					swal("Falha na conexão.", "", "error");
					showLoader(false);
				}
			});
			return true;
		});
	});

