								tabelaListaf.ajax.reload()
							} else {
								swal("Falha ao atualizar.", data, "error");
							}
							showLoader(false);
						},
						error: function (result) {
							swal("Falha na conexão.", "", "error");
							showLoader(false);
						}
					});
				});
		});

		$('#tbBuscaListaAgenda tbody').on('click', 'td.alterar', function () {
