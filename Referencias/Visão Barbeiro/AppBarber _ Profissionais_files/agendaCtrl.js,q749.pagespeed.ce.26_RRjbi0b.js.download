angular.module('appBeleza').controller('agendaCtrl', function ($rootScope, $scope, $compile, $state, $translate) {
	$rootScope.header = $Options.sistema + ' | Agenda';
	$scope.idCliente = $_CONFIG.ID;
	$scope.firstLoad = true;
	$scope.servicoSelect = '';
	$scope.numeroServicos = 0;
	$scope.datahoraencaixe = '';
	$scope.timerAgendaMS = 300000;
	$scope.calEvent;
	$scope.calendar;
	$scope.limitScrollAgenda = 20;
	$scope.finalAgendamentoRecorrente = -1;
	$scope.hasnf = 0;
	
	var listJornada = [];
	if(localStorage.getItem('listJornada') != null){
		listJornada = localStorage.getItem('listJornada').split(',')
	}
	var nIntervId;
	var timevalor;
	var heightAgenda = 2100;

	var curTimeZone;

	var tipoCategoria = 1;
	var tcacodigo = '';

	var slotsTempo = {
		'5': 300,
		'10': 150,
		'15': 100,
		'20': 75,
		'30': 50,
		'40': 40,
		'45': 35,
		'60': 30,
		'90': 20,
		'120':15
	}

	var heightAgenda = $_CONFIG.TAMANHOSLOT != '' ? (parseInt($_CONFIG.TAMANHOSLOT) * slotsTempo[$_CONFIG.TEMPOPADRAO]) : ($_CONFIG.TEMPOPADRAO == '5' ? 5000 : 2100)
	var mMinTime = $_CONFIG.INICIOAGENDA_PRINCIPAL;
	var mMaxTime = $_CONFIG.FIMAGENDA_PRINCIPAL;
	var mMinTimeTimePicker = $_CONFIG.INICIOAGENDA_SECUNDARIO;

	$scope.buscaparcategoria = function () {

		$.ajax({
			dataType: 'json',
			url: '/pages/actions/buscaParametro.php',
			async: false,
			method: 'POST',
			data: {
				parcodigo: 141
			},
			success: function (data) {
				if (data.result.length > 0) {
					if (data.result[0].PVa_Vlr_Principal == '1') {
						$("#btnSelecionarCategoriaAgenda").show()
					} else {
						$("#btnSelecionarCategoriaAgenda").hide()
					}
				} else {
					$("#btnSelecionarCategoriaAgenda").hide()
				}
			}
		});

		$.ajax({
			dataType: 'json',
			url: '/pages/actions/buscaParametro.php',
			async: false,
			method: 'POST',
			data: {
				parcodigo: 142
			},
			success: function (data) {
				if (data.result.length > 0) {
					if (data.result[0].PVa_Vlr_Principal != '') {
						if(data.result[0].PVa_Vlr_Principal <= 5){
							$scope.limitScrollAgenda = 5
						}else{
							$scope.limitScrollAgenda = data.result[0].PVa_Vlr_Principal
						}
					} else{
						$scope.limitScrollAgenda = 20;
					}
				} 
			}
		});

		$.ajax({
			dataType: 'json',
			url: '/pages/actions/buscaParametro.php',
			async: false,
			method: 'POST',
			data: {
				parcodigo: 161
			},
			success: function (data) {
				if (data.result.length > 0) {
					if (data.result[0].PVa_Vlr_Principal != '') {
						if(data.result[0].PVa_Vlr_Principal == 1){
							$(".multiUniClass").show()
						}else{
							$(".multiUniClass").hide()
						}
					} else{
						$(".multiUniClass").hide()
					}
				} 
			}
		});
		
		$.ajax({
			dataType: 'json',
			url: '/pages/actions/buscaParametro.php',
			async: false,
			method: 'POST',
			data: {
				parcodigo: 64
			},
			success: function (data) {
				if (data.result.length > 0) {
					if (data.result[0].PVa_Vlr_Principal != '') {
						if(data.result[0].PVa_Vlr_Principal == 1){
							$("#cpfnf").show()
							$scope.hasnf =1;
						}else{
							$("#cpfnf").hide()
							$scope.hasnf =0;
						}
					} else{
						$("#cpfnf").hide()
						$scope.hasnf =0;
					}
				}
			}
		});

	}
	$scope.buscaparcategoria();

	var intervalTimeZone;

	buscaEstados($_CONFIG.PAIS);
	$App.formatDateSort();

	$('#btnHideLegenda').click((e) => {
		$('#collapseExample').collapse('toggle');
		icon = $(e.currentTarget).find('i');
		icon.toggleClass('fa-plus fa-minus');
	})

	validaPerfil($state.current.name);

	$('#btnAgendaPrev').on('click',() => {
		$('#btnAgendaPrev').attr('disabled', true);
		$('#calendar').fullCalendar('prev');
		$('#btnAgendaPrev').attr('disabled', false);
	});

	$('#btnAgendaNext').on('click',() => {
		$('#btnAgendaNext').attr('disabled', true);
		$('#calendar').fullCalendar('next');
		$('#btnAgendaNext').attr('disabled', false);
	});

	$('#btnAgendaToday').on('click',() => {
		$('#btnAgendaToday').attr('disabled', true);
		$('#calendar').fullCalendar('gotoDate', curTimeZone);
		$('#btnAgendaToday').attr('disabled', false);
	});

	$('#btnAgendaDay').addClass('disabled');

	$('#btnAgendaDay').on('click',() => {
		$('#calendar').fullCalendar('changeView', 'resourceDay');
		$('#btnAgendaDay').addClass('disabled');
		$('#btnAgendaWeek').removeClass('disabled');
		$('#btnAgendaMonth').removeClass('disabled');
	});

	$('#btnAgendaWeek').on('click',() => {
		$('#calendar').fullCalendar('changeView', 'agendaWeek');
		$('#btnAgendaDay').removeClass('disabled');
		$('#btnAgendaWeek').addClass('disabled');
		$('#btnAgendaMonth').removeClass('disabled');
	});

	$('#btnAgendaMonth').on('click',() => {
		$('#calendar').fullCalendar('changeView', 'month');
		$('#btnAgendaDay').removeClass('disabled');
		$('#btnAgendaWeek').removeClass('disabled');
		$('#btnAgendaMonth').addClass('disabled');
	});

	$('#btnFechaItemComanda').on('click',() => {
		$('#comandaInsert-modal').modal('hide');
		$('#comanda-modal').modal('show');
	});

	$('#btnFechaItemComandaSer').on('click',() => {
		$('#comandaInsertSer-modal').modal('hide');
		$('#comanda-modal').modal('show');
	});

	$("#messageRenovar").on('click',(e) => {
		if (e.target.type != "button") {
			window.location.hash = '#/renovacao';
		}
	});

	$('#bar-date')
		.css('top', $('.navbar').height())
		.css('left', $('.sidebar').width())
		.css('width', '100%');

	$('#bar-info-date').css('height', '30px');



	if (!isMobile) {
		$('#divCalendario').css('overflow-y', 'scroll');
		$('#divCalendario').height($('html').height() - $('.navbar').height() - 165);
	}

	$scope.fixNameProf = function () {
		$('#divNameProf').html('');
		var tr = $('.fc-agenda-days').children('thead').children().children();
		var html = '<tfoot class="text-center"><tr>';

		tr.each((idx, el) => {
			if($('#calendar').fullCalendar('getView').calendar.fetchResources().length <= $scope.limitScrollAgenda){

				if (!$(el).hasClass('fc-agenda-gutter')) {
					if ($(el).hasClass('fc-last')) {
						if (el.previousElementSibling.style.width == '50px') {
							var elWidth = $('#divCalendario').width() - 50;
						} else {
							var elWidth = el.previousElementSibling.style.width;
						}
					} else {
						var elWidth = el.style.width;
					}
					jQuery('<label/>', {
						text: el.innerHTML.replace('&nbsp;', ' ')
					}).css({
						'text-align': 'center',
						'background-color': '#D2D6DE',
						'border-style': 'solid;',
						'border-left-color': 'grey',
						'width': elWidth,
						'left': el.offsetLeft
					}).appendTo('#divNameProf');
				}
			}else{
				html += `<td style="border: 1px solid #D2D6DE;background-color: fafafa;"><b>${el.innerHTML.replace('&nbsp;', ' ')}</b></td>`
			}
	

		});
		html += '</tfoot>';
		if($('#calendar').fullCalendar('getView').calendar.fetchResources().length > $scope.limitScrollAgenda){
			$('.fc-agenda-days').append(html)
		}
	};
	
	$('#navProf').show();
	$('#formProf').show();

	$('#cbEnviaSms').change((e) => {

		if (e.currentTarget.checked && ($('#lblSaldoSMSAg').html() == '0')) {
			toastr.error('Saldo insuficiente para enviar SMS');
			e.currentTarget.checked = false;
		}
	});

	$('#cbEnviaWhats').change((e) => {

		if (e.currentTarget.checked && ($('#lblSaldoWhatsAg').html() == '0')) {
			toastr.error('Saldo insuficiente para enviar WhatsApp');
			e.currentTarget.checked = false;
		}
	});

	$scope.buscaInfoRodizio = function () {
		$('#rodizio-modal').modal();
		setTimeout(() => {
			if (typeof (tabelaRodizio) != "undefined") {
				$('#tbBuscaRodAgenda tbody').unbind('click')
				tabelaRodizio.api().destroy();
			}
			tabelaRodizio = $('#tbBuscaRodAgenda').dataTable({
				'ajax': '/pages/cadastros/buscaRodizio.php',
				'order': [
					[0, 'asc']
				],
				"scrollX": isPortrait,
				'columnDefs': [{
					'targets': [0, 1, 4],
					'visible': false,
					'searchable': false
				}],
				'paging': false,
				'ordering': false,
				'info': false,
				'searching': false,
				'language': {
					'url': '//cdn.datatables.net/plug-ins/1.10.7/i18n/Portuguese-Brasil.json'
				},
				initComplete: () => {
					$compile($('#tbBuscaRodAgenda'))($scope);
					$('#tbBuscaRodAgenda_paginate').click(() => {
						$compile($('#tbBuscaRodAgenda'))($scope);
					});
					$('#tbBuscaRodAgenda_filter').change(() => {
						$compile($('#tbBuscaRodAgenda'))($scope);
					});
					$('#tbBuscaRodAgenda_length').change(() => {
						$compile($('#tbBuscaRodAgenda'))($scope);
					});
					if (tabelaRodizio.fnGetData().length > 0) {
						$('#divLoader').hide();
						$('#boxRodizio').show();
						$('#semRodizio').hide();
					} else {
						$('#lblTotalRodizio').html('');
						$('#lblValorInicial').html('');
						$('#lblNome').html('');
						$('#lblData').html('');
						$('#boxRodizio').hide();
						$('#semRodizio').show();
						resizeContent();
					}

					$('[data-toggle="popover"]').popover({
						container: 'body'
					});
				},
				'columns': [{
						'data': 'DT_RowId'
					},
					{
						'data': 'Codigo'
					},
					{
						'data': 'Ordem'
					},
					{
						'data': 'Nome'
					},
					{
						'data': 'Data'
					},
					{
						'data': 'Agendamentos'
					},
					{
						'data': 'Status'
					},
					{
						'data': 'BtnUp'
					},
					{
						'data': 'BtnDown'
					},
					{
						'data': 'BtnStatus'
					}
				]
			});
			
		}, 500);
	};

	var atualizaDadosRodizio = () => {
		$('[data-toggle="popover"]').popover('hide');
		tabelaRodizio.api().ajax.reload(() => {
			$('[data-toggle="popover"]').popover({
				container: 'body'
			});
			$compile($('#tbBuscaRodAgenda'))($scope);
			$('#tbBuscaRodAgenda_paginate').click(() => {
				$compile($('#tbBuscaRodAgenda'))($scope);
			});
		});
	}

	$scope.atualizaRodizio = function (direcao, ordem, rodcodigo, procodigo) {
		$.ajax({
			dataType: 'json',
			method: 'POST',
			url: '/pages/cadastros/atualizaRodizio.php',
			data: {
				tcacodigo: tcacodigo,
				tipo: tipoCategoria,
				direcao: direcao,
				ordem: ordem,
				rodcodigo: rodcodigo,
				procodigo: procodigo
			},
			success: (data) => {
				if (data.result[0].erro == '0') {
					toastr['success']('Atualizado com Sucesso.');
					atualizaDadosRodizio();
				} else {
					swal('Falha ao Atualizar.', data, 'error');
				}
			},
			error: (result) => {
				swal('Falha na conexão.', '', 'error');
			}
		});
	}

	$scope.atualizaStatus = function (status, rodcodigo, procodigo) {

		$.ajax({
			dataType: 'json',
			method: 'POST',
			url: '/pages/cadastros/atualizaRodizio.php',
			data: {
				tcacodigo: tcacodigo,
				tipo: tipoCategoria,
				status: status,
				rodcodigo: rodcodigo,
				procodigo: procodigo
			},
			success: (data) => {
				if (data.result[0].erro == '0') {
					toastr['success']('Atualizado com Sucesso.');
					atualizaDadosRodizio();
				} else {
					swal('Falha ao Atualizar.', data.result[0].resultado, 'error');
				}
			},
			error: (result) => {
				swal('Falha na conexão.', '', 'error');
			}
		});
	}

	$.ajax({
		dataType: 'json',
		url: '/pages/cadastros/buscaRodizio.php',
		success: (data) => {
			if (data.recordsTotal > 0) {
				$('#btnShowRodizio').show();
			} else {
				$('#btnShowRodizio').hide();
			}
		}
	});

	$scope.clientes = '';
	$scope.semCadastro = false;
	$scope.alteraDataAgendamento = false;
	$scope.objAgenda = Array();
	$('#calendar').fullCalendar('removeEvents');

	$scope.initAgenda = true;

	$('.input-group.date').datepicker({
		language: 'pt-BR',
		orientation: 'auto',
		autoclose: true,
		format: 'dd/mm/yyyy'
	});

	var datainirec = moment().locale('pt-br').format('L');
	var datafimrec = moment().add(+7, 'days').locale('pt-br').format('L');
	$('.date.dataIniCancelaRecorrente').datepicker('update', datainirec);
	$('.date.dataFimCancelaRecorrente').datepicker('update', datafimrec);

	$('.dataFimDisp').datepicker('update', datainirec);
	$('.dataIniDisp').datepicker('update', datainirec);

	$('.dataIniLista').datepicker('update', datainirec);
	$('.dataFimLista').datepicker('update', datainirec);

	$('.divDataListaAgenda').datepicker('update', datainirec);

	$scope.mostraClientes = function () {
		$scope.semCadastro = !$scope.semCadastro;
		$('.typeahead').typeahead('val', '');
	};

	var emitBuscaCliente = $rootScope.$on('AgendabuscaClientes', function (event, pescodigo) {
		$scope.buscaClientes(pescodigo.any);
	});

	$scope.buscaClientes = function (pescodigo) {
		if (hasManyClients) {
			$('.select2.cliente').select2({
				ajax: {
					url: '/pages/actions/buscaClientesMany.php',
					dataType: 'json',
					delay: 250,
					data: (params) => {
						return {
							nome: params.term							
						};
					},
					processResults: (data, params) => {
						return {
							results: data.result
						};
					},
					cache: true
				},
				placeholder: 'Sem Cadastro',
				escapeMarkup: (markup) => {
					return markup;
				},
				minimumInputLength: 3,
				templateResult: thumbCliente3,
				templateSelection: formatRepoSelection
			});

			$.ajax({
				dataType: 'json',
				url: '/pages/actions/buscaClientes.php',
				async: false,
				method: 'POST',
				data: {
					tipo: 2
				},
				success: function (data) {
					for (var i = 0; i < data.result.length; i++) {
						var codigo = data.result[i].Pes_Codigo;
						var nome = data.result[i].Pes_Nome;
						var foto = data.result[i].Paf_Imagem;
						var usucod = data.result[i].Usu_Codigo;
						var celular = data.result[i].Paf_Celular;
					}

					$scope.clientes = data.result;
					nomeCliente = new Array();
					clientesNomes.length = 0;

					$.each($scope.clientes, (index, cliente) => {
						clientesNomes.push(cliente.Pes_Nome + ' | ' + cliente.Paf_Celular);
						clientesIds[cliente.Pes_Nome + ' | ' + cliente.Paf_Celular] = cliente.Pes_Codigo;
					});

					var clientes = new Bloodhound({
						datumTokenizer: Bloodhound.tokenizers.whitespace,
						queryTokenizer: Bloodhound.tokenizers.whitespace,
						local: clientesNomes
					});

					$('.typeahead').typeahead('destroy');
					$('#the-basics .typeahead').typeahead(null, {
						limit: 20,
						source: clientes
					}).on('typeahead:selected', (e) => {
						var arrNome = e.currentTarget.value.split(' | ');
						nomeSelecionado = arrNome[0];
						idSelecionado = clientesIds[e.currentTarget.value];
					});
				}
			});

		} else {
			$.ajax({
				dataType: 'json',
				url: '/pages/actions/buscaClientes.php',
				async: false,
				method: 'POST',
				data: {
					tipo: 2
				},
				success: function (data) {
					var html = [];
					var html2 = [];

					html.push('<option data-usucodigo="" data-imagem="" data-celular="" value="" selected>Sem Cadastro</option>');
					html2.push('<option data-usucodigo="" data-imagem="" data-celular="" value="" selected>Sem Cliente</option>');
					for (var i = 0; i < data.result.length; i++) {
						var codigo = data.result[i].Pes_Codigo;
						var nome = data.result[i].Pes_Nome;
						var foto = data.result[i].Paf_Imagem;
						var usucod = data.result[i].Usu_Codigo;
						var celular = data.result[i].Paf_Celular;
						var observacao = data.result[i].PAF_Observacao;
						var ausente = data.result[i].PAF_Ausente;
						if (celular != '') {
							html.push('<option data-usucodigo="' + usucod + '" data-imagem="' + foto + '" data-celular="' + celular + '" data-observacao="' + observacao + '" value="' + codigo + '" data-ausente="'+ausente+'">' + nome + ' - ' + celular + '</option>');
							html2.push('<option data-usucodigo="' + usucod + '" data-imagem="' + foto + '" data-celular="' + celular + '" data-observacao="' + observacao + '" value="' + codigo + '" data-ausente="'+ausente+'">' + nome + ' - ' + celular + '</option>');
						} else {
							html.push('<option data-usucodigo="' + usucod + '" data-imagem="' + foto + '" data-celular="' + celular + '" data-observacao="' + observacao + '" value="' + codigo + '" data-ausente="'+ausente+'">' + nome + '</option>');
							html2.push('<option data-usucodigo="' + usucod + '" data-imagem="' + foto + '" data-celular="' + celular + '" data-observacao="' + observacao + '" value="' + codigo + '" data-ausente="'+ausente+'">' + nome + '</option>');
						}
					}

					setTimeout(() => {
						document.getElementById('cliente_menu').innerHTML = html.join('');
						document.getElementById('cliente_menu2').innerHTML = html2.join('');
						document.getElementById('insertClienteEncaixe').innerHTML = html2.join('');
						if (pescodigo != '') {
							$('#cliente_menu').val(pescodigo).trigger('change');
							$('#cliente_menu2').val(pescodigo).trigger('change');
							$('#insertClienteEncaixe').val(pescodigo).trigger('change');
						} else {
							$('#cliente_menu').val('').trigger('change');
							$('#cliente_menu2').val('').trigger('change');
							$('#insertClienteEncaixe').val('').trigger('change');
						}
					}, 300);

					$scope.clientes = data.result;
					nomeCliente = new Array();
					clientesNomes.length = 0;

					$.each($scope.clientes, (index, cliente) => {
						clientesNomes.push(cliente.Pes_Nome + ' | ' + cliente.Paf_Celular);
						clientesIds[cliente.Pes_Nome + ' | ' + cliente.Paf_Celular] = cliente.Pes_Codigo;

					});

					var clientes = new Bloodhound({
						datumTokenizer: Bloodhound.tokenizers.whitespace,
						queryTokenizer: Bloodhound.tokenizers.whitespace,
						local: clientesNomes
					});

					$('.typeahead').typeahead('destroy');
					$('#the-basics .typeahead').typeahead(null, {
						limit: 20,
						source: clientes
					}).on('typeahead:selected', (e) => {
						var arrNome = e.currentTarget.value.split(' | ');
						nomeSelecionado = arrNome[0];
						idSelecionado = clientesIds[e.currentTarget.value];

					});

					if (data.result.length > 800) {
						$('.select2.cliente').select2({
							templateResult: thumbCliente,
							minimumInputLength: 3
						});
					} else {
						$('.select2.cliente').select2({
							templateResult: thumbCliente
						});
					}
				}
			});
		}

	};

	$('#btnInserirDesbloquearAgenda').click(() => {
		var profissionalDesbloquear = $('#edtProfissionalDesbloquear').val();
		var diaIniDesbloquear = formataData($('#edtData2DesbloquearAgenda').val());
		var diaFimDesbloquear = formataData($('#edtDataFim2DesbloquearAgenda').val());
		var horaIniDesbloquear = $('#edtHoraIniDesbloquearAgenda').val();
		var horaFimDesbloquear = $('#edtHoraFimDesbloquearAgenda').val();
		showLoader(true);
		$.ajax({
			dataType: 'json',
			url: "/pages/actions/removeHorarioBloqueado.php",
			method: 'POST',
			data: {
				profissional: profissionalDesbloquear,
				diaini: diaIniDesbloquear,
				diafim: diaFimDesbloquear,
				horaini: horaIniDesbloquear,
				horafim: horaFimDesbloquear
			},
			success: (data) => {
				if (data.result[0].erro == 1) {
					swal(data.result[0].resultado, '', 'error');
				} else {
					$('#agendaHorario-modal').modal('hide');
					toastr.success(data.result[0].resultado);
					$scope.atualizaEventos();
					$('#formHorarioDesbloquear').each((_, el) => {
						el.reset();
					});
				}
				showLoader(false);
			}
		});
	});

	$.ajax({
		dataType: 'json',
		url: "/pages/actions/buscaProfissionais.php",
		success: (data) => {
			var html = '';
			var html2 = '';
			var html3 = '<option value="">Selecione um Profissional</option>';
			html2 += '<option value="">Profissional</option>';
			for (var i = 0; i < data.profissionais.length; i++) {
				var codigo = data.profissionais[i].Pes_Codigo;
				var nome = data.profissionais[i].Pes_Nome;
				var apelido = data.profissionais[i].Pes_Apelido;
				html += '<option value="' + codigo + '">' + nome + '</option>';
				html2 += '<option value="' + codigo + '">' + apelido + '</option>';
				html3 += '<option value="' + codigo + '">' + apelido + '</option>';
			}
		
			$('#edtProfissional').html(html);
			$('#comInsertProfissionalEncaixe').html(html2);
			$('#profissionalRecorrencia').html(html);
			$('#edtProfissionalBloqueado').html(html);
			$('#edtProfissionalDesbloquear').html(html);
			$('#profisisonalHorDisp').html(html3);
			$('#profListaAgendamento').html(html2);
			$('#comProfissionalComissao').html(html2);
			$('#edtMultiProfissionalBloqueado').html(html2);
			$('#comInsertProfissionalEncaixe').select2();
			$('#comInsertProfissionalEncaixe').change((e) => {

				setTimeout(() => {
					if (e.currentTarget.value != '' && $('#insertServicoEncaixe').val() != '') {
						if($('#insertServicoEncaixe option:selected').get(0).dataset.tipoitem == '1'){
							buscaAssocProfissionalServico($('#insertServicoEncaixe').val(), $('#comInsertProfissionalEncaixe').val());
						}
					}
				}, 300);
			});

		

		}
	});
	$.ajax({
		dataType: 'json',
		url: '/pages/actions/buscaParametro.php',
		method: 'POST',
		data: {
			parcodigo: 5,
			origem: 1
		},
		success: function (data) {
			if (data.result.length > 0) {
				$_CONFIG.TEMPOPADRAO = data.result[0].PVa_Vlr_Principal;
			}

			$.ajax({
				dataType: 'json',
				url: '/pages/actions/buscaParametro.php',
				method: 'POST',
				async:false,
				data: {
					parcodigo: 133,
					origem: 1
				},
				success: function (param2) {
					if (param2.result.length > 0) {
						if (param2.result[0].PVa_Vlr_Principal != '') {
							$_CONFIG.FIMAGENDA_PRINCIPAL = param2.result[0].PVa_Vlr_Principal;
							$_CONFIG.FIMAGENDA_SECUNDARIO = param2.result[0].PVa_Vlr_Secundario;
						}
					}
				}
			});

			$.ajax({
				dataType: 'json',
				url: '/pages/actions/buscaParametro.php',
				method: 'POST',
				async:false,
				data: {
					parcodigo: 43,
					origem: 1
				},
				success: function (param3) {
					if (param3.result.length > 0) {
						if (param3.result[0].PVa_Vlr_Principal != '') {
							$_CONFIG.INICIOAGENDA_PRINCIPAL = param3.result[0].PVa_Vlr_Principal;
							$_CONFIG.INICIOAGENDA_SECUNDARIO = param3.result[0].PVa_Vlr_Secundario;
						}
					}

					try {
						$scope.objAgenda = JSON.parse(getStorage('agenda'));
					} catch (e) {
						$scope.objAgenda = '';
					}
					$('#calendar').fullCalendar('destroy');

					$App.timePicker('.timepicker', mMinTimeTimePicker, 5);

					initCalendar();
					initContextMenu();
				}
			});
		}
	});

	$scope.adicionaServico = function () {
		$scope.criaServicoSelect();
	}

	$scope.criaServicoSelect = function () {

		var servicoHtml = '';
		servicoHtml = '<div id="divSelectServico' + $scope.numeroServicos + '">'
		servicoHtml += '<div class="col-lg-7 col-xs-6">';
		servicoHtml += '<div class="form-group">';
		servicoHtml += '<label id="lblServico">Serviço:</label>';
		servicoHtml += '<select class="form-control select2" id="servico_menu' + $scope.numeroServicos + '" data-idx="' + $scope.numeroServicos + '" name="servico_menu' + $scope.numeroServicos + '" style="width: 100%" required><br>';
		servicoHtml += '<option data-tempo="0" value="-1" data-valor="" data-tipopreco="" >Selecione um Serviço</option>';
		for (var i = 0; i < $scope.servicoSelect.length; i++) {
			servicoHtml += '<option data-tempo="' + $scope.servicoSelect[i].Ser_Intervalo_Padrao + '" value="' + $scope.servicoSelect[i].Ser_Codigo + '" data-valor="' + $scope.servicoSelect[i].Ser_Valor + '" data-tipopreco="' + $scope.servicoSelect[i].Ser_Tip_Preco + '" data-tipoitem="' + $scope.servicoSelect[i].TipoItem + '">' + $scope.servicoSelect[i].Ser_Descricao + '</option>';
		}
		servicoHtml += '</select>';
		servicoHtml += '</div></div>';

		if ($scope.numeroServicos !== 0) {
			servicoHtml += '<div class="col-lg-5 col-xs-6">';
			servicoHtml += '<div class="form-group">';
			servicoHtml += '<label id="lblTempo">Duração: <i data-toggle="popover" tabindex="0" data-trigger="hover" data-placement="right" class="fa fa-question-circle" style="color:grey" data-content="Você pode estipular uma duração maior do que a definida para o serviço."></i></label>';
			servicoHtml += '<div class="input-group">'
			servicoHtml += '<select class="form-control select2" id="tempo_menu' + $scope.numeroServicos + '" name="tempo_menu' + $scope.numeroServicos + '" style="width: 100%" disabled>';
			servicoHtml += '</select>';
			servicoHtml += '<span class="input-group-btn"><button type="button" id="btnRemoveServicoSelect' + $scope.numeroServicos + '"  ng-click="removeServicoCombo()"  class="btn btn-link btn-flat"><i class="fa fa-trash-o"></i></button></span>'
			servicoHtml += '</div>'
			servicoHtml += '</div>';
			servicoHtml += '</div>';

		} else {
			servicoHtml += '<div class="col-lg-5 col-xs-6">';
			servicoHtml += '<div class="form-group">';
			servicoHtml += '<label id="lblTempo">Duração: <i data-toggle="popover" tabindex="0" data-trigger="hover" data-placement="right" class="fa fa-question-circle" style="color:grey" data-content="Você pode estipular uma duração maior do que a definida para o serviço."></i></label>';
			servicoHtml += '<select class="form-control select2" id="tempo_menu' + $scope.numeroServicos + '" name="tempo_menu' + $scope.numeroServicos + '" style="width: 100%" disabled>';
			servicoHtml += '</select>';
			servicoHtml += '</div>';
			servicoHtml += '</div>';
		}
		servicoHtml += '</div>';
		if ($scope.numeroServicos == 0) {
			$('#servicos_select').html(servicoHtml);
		} else {
			$('#servicos_select').append(servicoHtml);
		}

		$('#servico_menu' + $scope.numeroServicos).change((e) => {
			 var tempoPadrao = parseInt($_CONFIG.TEMPOPADRAO);
			//var tempoPadrao = 5;
			var tempoServico = parseInt(e.currentTarget.options[e.currentTarget.selectedIndex].dataset.tempo);
			var idx = e.currentTarget.dataset.idx;
			var hasservicetime = 1;
			if (tempoServico != undefined) {
				var html = '';
				for (var i = tempoPadrao; i < tempoPadrao * 15; i = i + tempoPadrao) {

					if (i == tempoServico) {
						html += '<option value="' + i + '" selected>' + i + ' Minutos</option>';
						hasservicetime = 0;
					} else {
						html += '<option value="' + i + '">' + i + ' Minutos</option>';
					}
				}
				if(hasservicetime == 1){
					html = `<option value="${tempoServico}">${tempoServico} Minutos</option>`+html
				}

				$('#tempo_menu' + idx).prop('disabled', false);
			} else {
				var html = '';
				$('#tempo_menu' + idx).prop('disabled', true);
			}
			$('#tempo_menu' + idx).html(html);

			$('#tempo_menu' + idx).val(tempoServico).trigger('change');

			if(idx == 0){
				if($("#cliente_menu").val() != ''){

					$.ajax({
						url: '/pages/cadastros/buscaPacotesPessoaCombo.php',
						type: 'POST',
						dataType: 'json',
						async: false,
						data: {
							pescodigo: $("#cliente_menu").val(),
							codigo: $("#servico_menu0").val(),
							tipo: 1
						},
						success: function (data) {
							if (data.result.length > 0) {
								$("#HasPacotesCliente").html(" <b style='color:green'>Possuí pacotes para o serviço</b>")
							}else{
								$("#HasPacotesCliente").html(" <b style='color:orange'>Sem pacotes disponíveis para o serviço</b>")
							}
		
							showLoader(false);
						},
						error: function (result) {
							toastr.error("Falha na conexão.");
							showLoader(false);
						}
					});
				}
			}
			
		});

		$('#servico_menu' + $scope.numeroServicos).select2({
			templateResult: thumbServico
		});

		$compile($('#btnRemoveServicoSelect' + $scope.numeroServicos))($scope);
		$compile($('#tempo_menu' + $scope.numeroServicos))($scope);
		$scope.numeroServicos++;
	}

	function thumbServico(state) {
		if (!state.id) {
			return state.text;
		}

		if (((state.element.dataset.tipopreco == 'Igual a') || (state.element.dataset.tipopreco == 'A partir de')) && ((state.element.dataset.valor.length != 0))) {
			var $state = $(
				'<span>' + state.text + '<br><small style="color:#adadad">' + state.element.dataset.tipopreco + ' - ' + $_CONFIG.MOEDA + ' ' + state.element.dataset.valor + '</small></span>'
			);
		} else if (((state.element.dataset.tipopreco != 'Igual a') && (state.element.dataset.tipopreco != 'A partir de')) && ((state.element.dataset.valor.length != 0))) {
			var $state = $(
				'<span>' + state.text + '<br><small style="color:#adadad">' + $_CONFIG.MOEDA + ' ' + state.element.dataset.valor + '</small></span>'
			);
		} else {
			var $state = $(
				'<span>' + state.text + '</span>'
			);
		}

		return $state;
	};

	$scope.removeServicoCombo = function () {
		if ($scope.numeroServicos == 1) {
			toastr.error('O Agendamento deve possuir ao menos um servico!');
		} else {
			$('#divSelectServico' + ($scope.numeroServicos - 1)).remove();
			$scope.numeroServicos--;
		}
	}

