	$scope.desbloquearHorario = function (agecodigo) {
		swal({
			title: "Deseja desbloquear este horário?",
			type: "warning",
			showCancelButton: true,
			confirmButtonColor: "#DD6B55",
			confirmButtonText: "Sim",
			cancelButtonText: "Não",
			closeOnConfirm: true
		},
		function () {
			showLoader(true);
			$.ajax({
				dataType: "json",
				url: "/pages/actions/cancelaHorario.php",
				method: "POST",
				data: {
					agendamento: agecodigo
				},
				success: function (data) {
					if (data.cancelaHorario[0].erro == 1) {
						toastr.error(data.cancelaHorario[0].resultado, "");
					} else {
						toastr.success("Horário desbloqueado com sucesso.");
						$scope.isAgendamentoAntigo(2);
					}
					showLoader(false);
				},
				error: function (result) {
					swal("Falha na conexão.", "", "error");
					showLoader(false);
				}
			});
		});
	}

	$scope.buscaAgendaV3 = function (tipo, day) {
		if (tipo != 1) {
			$scope.showLoaderSchedule();
		}

		$.ajax({
			dataType: "json",
			url: "/pages/actions/buscaAgenda3.php",
			type: 'POST',
			data: {
				profissional: $('#users_menu').val(),
				tipo: tipo,
				dia: day
			},
			success: function (data) {
				if (tipo != 1) {
					$scope.hideLoaderSchedule();
				}

				setStorage("agenda", JSON.stringify(data).replaceAll("%20", " "));
				$scope.atualizaAgenda();

			},
			error: function () {
				if (tipo != 1) {
					$scope.hideLoaderSchedule();
				}
			}
		});
	}
	$("#btnRefreshAgenda").click(function(){
		$("#btnRefreshAgenda").attr('disabled',true);
		setTimeout(function(){
			$("#btnRefreshAgenda").attr('disabled',false);
		},1000)
	})
	$scope.isAgendamentoAntigo = function (tipo) {
		showLoader(true);
		var isAntigo = false;
		try {
			var view = $("#calendar").fullCalendar("getView");
			var day = view.calendar.getDate();
			var dayNow = view.calendar.getNow();
			isAntigo = (day.diff(dayNow, "days") < 0);
		} catch (err) {
			isAntigo = false;
		}

		if (isAntigo) {
			isLoadv3 = true;
			clearInterval(nIntervId);
		} else {
			$scope.atualizaCalendario();
		}

		if (view.name == "resourceDay") {
			$scope.buscaAgendaV3(1, view.calendar.getDate().locale("pt-BR").format("L"));
		} else if (view.name == "month") {
			$scope.buscaAgendaV3(2, view.calendar.getDate().locale("pt-BR").format("L"));
		} else {
			$scope.buscaAgendaV3(3, view.calendar.getDate().locale("pt-BR").format("L"));
		}
		showLoader(false)
	}

	$scope.atualizaEventos = function () {
		$scope.isAgendamentoAntigo(2);
	}

	$scope.showLoaderSchedule = function () {
		$(".divLoaderCalendarWidget").show();
	}

	$scope.hideLoaderSchedule = function () {
		$(".divLoaderCalendarWidget").hide();
	}

	$scope.atualizaAgenda = function () {

		if (!$scope.initAgenda) {

			var aux = $('#calendar').fullCalendar('clientEvents').filter((data) => {
				return data.id == -99
			});
			$('#calendar').fullCalendar('removeEvents');

			JSON.parse(getStorage("agenda")).forEach((data) => {
				aux.push(data);
			});
			$('#calendar').fullCalendar('addEventSource', aux);
		}
	}

