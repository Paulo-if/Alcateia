                strBrand = brand; 
                break;
        }
        return strBrand;
    }

	var formatBrandImage = function(brand) {
        var strBrand = "";
        switch (brand) {
            case 'mastercard':
                strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/mastercard.svg"; 
                break;
            case 'visa':
                strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/visa.svg"; 
                break;    
            case 'amex':
                strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/american-express.svg"; 
                break;
			case 'american express':
				strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/american-express.svg"; 
				break;	
            case 'elo':
                strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/elo.svg"; 
            break;
            case 'aura':
                strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/aura.svg"; 
                break;
            case 'discover':
                strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/discover.svg"; 
            break;  
            case 'hipercard':
                strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/hipercard.svg"; 
            break;   
            case 'pix':
                strBrand = "https://dash.zoop.com.br/assets/icons/banking/pix.png";
            break; 
            default:
                strBrand = "https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/mastercard.svg"; 
                break;
        }

        return strBrand;
    }

	var buscaAcao = function () {
		$.ajax({
			dataType: 'json',
			url: localStorage.getItem('host'),
			data: {
				id: $_CONFIG.ID,
				metodo: 'buscaAcao'
			},
			success: function (data) {
				if (data.result[0].erro == '0') {
					$_CONFIG.acoes.msgAction = data.result[0].mensagem;
					$_CONFIG.acoes.lastAction = data.result[0].descricao;
					$_CONFIG.acoes.dateAction = new Date();

					if (data.result[0].video != '') { //Vídeo

						$('#titleModalAcaoVideo').html(data.result[0].mensagem);
						videoId = queryParams('v', data.result[0].video);
						if (typeof ($_CONFIG.acoes.playerVideoAcao) === 'undefined') {
							$_CONFIG.acoes.playerVideoAcao = new YT.Player('player-acao', {
								height: window.outerHeight * 0.75,
								width: '100%',
								videoId: videoId,
								events: {
									'onReady': function () {
										$('#acao-video-modal').modal();
										$_CONFIG.acoes.playerVideoAcao.playVideo();
									}
								},
								playerVars: {
									'rel': 0
								}
							});
						} else {
							$_CONFIG.acoes.playerVideoAcao.loadVideoById(videoId);
							$('#acao-video-modal').modal();
						}

					} else if (data.result[0].imagem != '') { //Imagem

						$('#titleModalAcaoImagem').html(data.result[0].mensagem);
						var downloadingImage = new Image();
						downloadingImage.onload = function () {
							$('#imgAcao')[0].src = this.src;
							$('#imgAcao').click(function () {
								var win = window.open(this.src, '_blank');
								win.focus();
							});
						};
						downloadingImage.src = data.result[0].imagem;
						$('#acao-imagem-modal').modal();

					} else if (data.result[0].mensagem != '') { //Mensagem

						$.ajax({
							dataType: 'html',
							url: '/php/atualizaAcaoLog.php',
							method: 'POST',
							data: {
								tipo: 5,
								acao: $_CONFIG.acoes.lastAction
							}
						});

						swal({
								title: '',
								text: data.result[0].mensagem,
								html: true,
								showCancelButton: false,
								confirmButtonColor: sSistemaCor,
								allowEscapeKey: false,
								confirmButtonText: 'Fechar',
								closeOnConfirm: true
							},
							function () {
								$.ajax({
									dataType: 'html',
									url: '/php/atualizaAcaoLog.php',
									method: 'POST',
									data: {
										tipo: 6,
										acao: $_CONFIG.acoes.lastAction
									}
								});
							});
					}
				}
			}
		});
	};
	var sendMessage = function (title, msg, pos, fnOnClick) {
		var callback = null;
		var position = 'toast-top-right';

		if (typeof pos === 'string') {
			position = pos;
		}

		if (typeof fnOnClick === 'function') {
			callback = fnOnClick;
		}

		toastr.options = {
			'closeButton': true,
			'debug': false,
			'newestOnTop': false,
			'progressBar': false,
			'positionClass': position,
			'preventDuplicates': false,
			'onclick': callback,
			'timeOut': 0,
			'closeDuration': 0,
			'showEasing': 'swing',
			'hideEasing': 'swing',
			'showMethod': 'slideDown',
			'hideMethod': 'slideUp'
		}

		toastr.info(msg, title);

		toastr.options = {
			"closeButton": true,
			"debug": false,
			"newestOnTop": false,
			"progressBar": false,
			"positionClass": "toast-bottom-center",
			"preventDuplicates": false,
			"onclick": null,
			"showDuration": "300",
			"hideDuration": "1000",
			"timeOut": "5000",
			"extendedTimeOut": "1000",
			"preventDuplicates": true,
			"progressBar": true,
			"showEasing": "swing",
			"hideEasing": "linear",
			"showMethod": "fadeIn",
			"hideMethod": "fadeOut"
		}

	};

	var sendMessageColor = function (title, msg, pos, fnOnClick, color) {
		var callback = null;
		var position = 'toast-top-right';

		if (typeof pos === 'string') {
			position = pos;
		}

		if (typeof fnOnClick === 'function') {
			callback = fnOnClick;
		}

		toastr.options = {
			'closeButton': true,
			'debug': false,
			'newestOnTop': false,
			'progressBar': false,
			'positionClass': position,
			'preventDuplicates': false,
			'onclick': callback,
			'timeOut': 0,
			'closeDuration': 0,
			'showEasing': 'swing',
			'hideEasing': 'swing',
			'showMethod': 'slideDown',
			'hideMethod': 'slideUp'
		}

		switch (color) {
			case 'error':
				toastr.error(msg, title);
				break;
			case 'success':
				toastr.success(msg, title);
				break;
			case 'warning':
				toastr.warning(msg, title);
				break;
			case 'info':
				toastr.info(msg, title);
				break;
			default:
				toastr.info(msg, title);
				break;
		}
		

		toastr.options = {
			"closeButton": true,
			"debug": false,
			"newestOnTop": false,
			"progressBar": false,
			"positionClass": "toast-bottom-center",
			"preventDuplicates": false,
			"onclick": null,
			"showDuration": "300",
			"hideDuration": "1000",
			"timeOut": "5000",
			"extendedTimeOut": "1000",
			"preventDuplicates": true,
			"progressBar": true,
			"showEasing": "swing",
			"hideEasing": "linear",
			"showMethod": "fadeIn",
			"hideMethod": "fadeOut"
		}

	};



	return {
		formatDateSort: function () {
			formatDateSort();
		},
		timePicker: function (el, minTime, step) {
			timePicker(el, minTime, step);
		},
		datePicker: function (el) {
			datePicker(el);
		},
		fileinput: function (el) {
			fileinput(el);
		},
		showMessage: function (title, msg, pos, fnOnClick) {
			sendMessage(title, msg, pos, fnOnClick);
		},
		showMessageColor: function (title, msg, pos, fnOnClick, color) {
			sendMessageColor(title, msg, pos, fnOnClick, color);
		},
		changeFont: function (font) {
			changeFont(font);
		},
		buscaAcao: function () {
			buscaAcao();
		},
		toogleComboProfissionais: function (isShow) {
			toogleComboProfissionais(isShow);
		},
		funProxDiaUtil: function (strDate, format = "dd/mm/YYYY") {
			funProxDiaUtil(strDate, format);
		},
		showPIXModal: function(valor, qrcode, tipo, codexterno) {
			showPIXModal(valor, qrcode, tipo, codexterno);
		},
		showCartaoModal: function(cardid, customerid) {
			showCartaoModal(cardid, customerid);
		}
	};
}();

