				text: 'Realize o login novamente.',
				type: 'warning',
				showCancelButton: false,
				confirmButtonColor: sSistemaCor,
				allowEscapeKey: false,
				confirmButtonText: 'Ir para Login',
				closeOnConfirm: true
			},
			function () {
				window.location.href = '/login.php';
			});

	}
}, 10000); // 10000 milisegundos

