        switch (brand) {
            case 'pix':
                strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='PIX' src='https://dash.zoop.com.br/assets/icons/banking/pix.png' alt='PIX' height='20' width='21'></img>";
            break; 
            case 'mastercard':
                strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='MasterCard' src='https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/mastercard.svg' alt='MasterCard' height='22' width='34'></img>"; 
                break;
            case 'visa':
                strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='Visa' src='https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/visa.svg' alt='Visa' height='22' width='34'></img>"; 
                break;    
            case 'amex':
                strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='American Express' src='https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/american-express.svg' alt='American Express' height='22' width='34'></img>"; 
                break;
			case 'american express':
				strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='American Express' src='https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/american-express.svg' alt='American Express' height='22' width='34'></img>"; 
				break;	
            case 'elo':
                strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='Elo' src='https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/elo.svg' alt='Elo' height='22' width='34'></img>"; 
            break;
            case 'aura':
                strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='Aura' src='https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/aura.svg' alt='Aura' height='22' width='34'></img>"; 
                break;
            case 'discover':
                strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='Discover' src='https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/discover.svg' alt='Discover' height='22' width='34'></img>"; 
            break;  
            case 'hipercard':
                strBrand = "<img data-toggle='tooltip' data-placement='top' title='' data-original-title='MasterCard' src='https://appbarber-appbeleza.dash.zoop.com.br/assets/icons/cardbrand/hipercard.svg' alt='MasterCard' height='22' width='34'></img>"; 
            break;
