var $App = function () {

	var timePicker = function (el, minTime, step) {
		$(el).timepicker({
			'timeFormat': 'H:i',
			'forceRoundTime': true,
			'minTime': minTime,
			'maxTime': '11:59pm',
			'step': step
		});
	};

	var datePicker = function (el) {
		$(el).datepicker({
			language: 'pt-BR',
			orientation: 'top auto',
			autoclose: true,
			format: 'dd/mm/yyyy',
			todayHighlight: true
		});
	};

	var fileinput = function (el, maxsize) {
		$(el).fileinput({
			maxFilesNum: 1,
			showPreview: false,
			browseLabel: $_CONFIG.language.btn_procurar,
			removeLabel: $_CONFIG.language.btn_remover,
			browseIcon: '',
			maxFileSize: maxsize,
			allowedFileExtensions: ['jpg', 'png', 'jpeg'],
			showUpload: false
		});
	};

	var formatDateSort = function () {
		$.fn.dataTable.moment('DD/MM/YYYY');
		$.fn.dataTable.moment('DD/MM/YYYY hh:mm');
	};
	var toogleComboProfissionais = function (isShow) {
		if (isShow) {
			$('#navProf').show();
			$('#formProf').show();
		} else {
			$('#navProf').hide();
			$('#formProf').hide();
		}
	};
	var changeFont = function (font) {
		$('#font-style').attr('href', '/css/font-' + font + '.css');
	};
	var queryParams = function (name, url) {
		if (!url) url = location.href;
		name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
		var regexS = "[\\?&]" + name + "=([^&#]*)";
		var regex = new RegExp(regexS);
		var results = regex.exec(url);
		return results == null ? null : results[1];
	};

	var showPIXModal = function (valor, qrcode, tipo, codexterno) {
		$("#txtValorPIX").html(valor);
		var html = `<button class="btn btn-xs btn-primary text-center btnClipLinkPixCopiaecola" data-clipboard-text="${qrcode}" ><i class="fa fa-copy" alt="Copiar"></i> PIX Copia e Cola</button>`;
		$("#divPixCopiaECola").html(html);

		var clipboardPix = new ClipboardJS('.btnClipLinkPixCopiaecola');
		clipboardPix.on('success', function (e) {
			toastr.success("Código copiado com sucesso!");
		});

		$('#pix-qrcode').html("");

		$('#pix-qrcode').qrcode({
			text: qrcode,
			width: 256,
			height: 256
		});

		$(".overlay-qrcode-pix").hide();
		var tipoBuscaPIX = 1;
		if (tipo == 1){
			// Contratação			
			$("#confirmaContratar-modal").modal('hide');
		} else if (tipo == 2){
			// Renovação
			$("#confirmaContratar-modal").modal('hide');
		} else if (tipo == 3){
			// PIX Monthly
			$("#pixMonthly-modal").modal('hide');
		} else if (tipo == 4){
			// PIX Sms
			$("#comprarSMS-modal").modal('hide');
			tipoBuscaPIX = 2;

		} else if (tipo == 5){
			// PIX Sms
			$("#comprarWhats-modal").modal("hide");
			tipoBuscaPIX = 3;

		} else {
			// Perfil / Conta
			$("#confirmaContratar-modal").modal('hide');
		}


		$("#contratacaoPixQRCode-modal").modal();

		var intervalPix = setInterval(function () {
			$.ajax({
				dataType: "json",
				method: "POST",
				url: "/php/buscaPagamentoPIX.php",
				data: {
					codigoPIX: qrcode,
					codigoexterno: codexterno,
					tipo: tipoBuscaPIX
				},
				success: function (data) {
					if (data && data.result && data.result.length > 0) {
						
						if (data.result[0].erro == "0") {
							console.log(data.result[0].resultado);
							clearInterval(intervalPix);

							swal({
								title: "",
								text: data.result[0].resultado,
								html: true,
								type: "success"
							},
							function () {
								window.location.assign("/index.php");
							});
							
						} else {
							console.log(data.result[0].resultado);
						}

					} else {
						console.log("Pagamento Pendente");
					}
				}
			});
		}, 15000)

		$("#contratacaoPixQRCode-modal").on('hide.bs.modal', function () {
			clearInterval(intervalPix);
		});
	}

	var showCartaoModal = function (cardid, customerid) {
		// verDadosCartao-modal
		$("#verDadosCartao-modal").modal();
		$("#verDadosCartao-modal").unbind('hide.bs.modal');

		$("#verDadosCartao-modal").on('hide.bs.modal', function () {
			
			$("#txtDadosCartaoNumber").html("");
			$("#txtDadosCartaoHolderName").html("");
			$("#txtDadosCartaoExp").html("");
			$("#txtDadosCartaoBrand").html("");
			$(".overlayDadosCartao").show();
		});
		$.ajax({
			dataType: "json",
			method: "POST",
			url: "/php/pagarme/buscaDadosCartao.php",
			data: {
				cardid: cardid,
				customerid: customerid
			},
			success: function (data) {
				$(".overlayDadosCartao").hide();
				if (data.error) {
					$("#txtDadosCartaoNumber").html(data.message || "Nao foi possivel buscar os dados do cartao.");
					return;
				}

				var card = data.payment || data;
				var firstDigits = getCardValue(card.first_six_digits, card.first_digits);
				var lastDigits = getCardValue(card.last_four_digits, card.last_digits);
				var expiration = card.expiration_date || formatCardExpiration(card.exp_month, card.exp_year);

				$("#txtDadosCartaoNumber").html(`${leftPad(firstDigits, 6)}******${leftPad(lastDigits, 4)}`);
				$("#txtDadosCartaoHolderName").html(card.holder_name || "");
				$("#txtDadosCartaoExp").html(formatCardDateExp(expiration));

				

				$("#txtDadosCartaoBrand").html(formatBrand((card.brand || "").toLowerCase()));
			},
			error: function () {
				$(".overlayDadosCartao").hide();
				$("#txtDadosCartaoNumber").html("Nao foi possivel buscar os dados do cartao.");
			}
		});

		
	}

	var formatCardDateExp = function(exp) {
		if (!exp) {
			return "";
		}

		exp = String(exp);
		return [exp.slice(0, 2), '/', exp.slice(2)].join('');
	}

	var formatCardExpiration = function(month, year) {
		if (!month || !year) {
			return "";
		}

		month = String(month);
		if (month.length == 1) {
			month = "0" + month;
		}

		return month + String(year);
	}

	var getCardValue = function() {
		for (var i = 0; i < arguments.length; i++) {
			if (arguments[i] !== undefined && arguments[i] !== null && arguments[i] !== "") {
				return String(arguments[i]);
			}
		}

		return "";
	}

	var leftPad = function(value, size) {
		value = String(value || "");

		while (value.length > 0 && value.length < size) {
			value = "0" + value;
		}

		return value;
	}

	var formatBrand = function(brand) {
