function validaPerfil(perfil) {
	$.ajax({
		dataType: 'json',
		method: 'POST',
		url: '/php/verificaPerfil.php',
		data: {
			perfil: perfil
		},
		success: function (data) {
			if (data.erro == '1') {
				window.location.href = '#/permissao';
			}
		},
		error: function (data) {
			window.location.href = '#/permissao';
		}
	});
}

function validaGestor() {
	$.ajax({
		dataType: 'json',
		url: '/php/verificaGestor.php',
		success: function (data) {
			if (data.erro == '1') {
				window.location.href = '#/permissao';
			}
		},
		error: function (data) {
			window.location.href = '#/permissao';
		}
	});
}

function validaID(){
	$.ajax({
		dataType: 'json',
		url: '/php/validaID.php',
		success: function (data) {
			console.log(data);
			if (!data.isvalid) {
				swal({
					title: 'Tempo da Sessão Excedida.',
					text: 'Realize o login novamente.',
					type: 'warning',
					showCancelButton: false,
					confirmButtonColor: sSistemaCor,
					allowEscapeKey: false,
					confirmButtonText: 'Ir para Login',
					closeOnConfirm: true
				},
				function () {
					window.location.href = '/login.php';
				});

			}
		}, error: function () {
			console.log("Erro ao validar ID");
		}
	});
}

