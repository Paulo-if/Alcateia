var funProxDiaUtil = (strDate, format) => {
	if (format === undefined) {
		format = "DD/MM/YYYY";
	}
	var dataaux = moment(strDate);
	var dayofweek = dataaux.day();
	if (dayofweek === 0) {
		var newdate = moment(strDate).add(1, 'd');
		var isHoliday = funFeriado(newdate).isHoliday;
		if (isHoliday) {
			return funProxDiaUtil(newdate.format("YYYY-MM-DD"));
		} else {
			var proxDiaUtil = newdate.format(format);
			return proxDiaUtil;
		}
	} else if (dayofweek === 6) {
		
		var newdate = moment(strDate).add(2, 'd');
		var isHoliday = funFeriado(newdate).isHoliday;
		
		if (isHoliday) {
			return funProxDiaUtil(newdate.format("YYYY-MM-DD"));
		} else {
			var proxDiaUtil = newdate.format(format);
			return proxDiaUtil;
		}
	} else {
		var isHoliday = funFeriado(dataaux).isHoliday;
		if (isHoliday) {
			var newdate = moment(strDate).add(1, 'd');
			return funProxDiaUtil(newdate.format("YYYY-MM-DD"));
		} else {
			var proxDiaUtil = moment(strDate).format(format);
			return proxDiaUtil;
		}
	}
};

var funFeriado = (data) => {
	if (data === undefined) {
		return listFeriado;
	} else {
		if (listFeriado[data.format("DD/MM/YYYY")] === undefined) {
			return {
				isHoliday: false
			}
		} else {
			return {
				isHoliday: true,
				holiday: listFeriado[data.format("DD/MM/YYYY")],
				date: data.format("DD/MM/YYYY")
			};
		}
	}
}

function getProximoDiaUtil(dataReferencia) {
	const depoisDas1530 = dataReferencia.getHours() > 15 || (dataReferencia.getHours() === 15 && dataReferencia.getMinutes() > 30);
	const diasASomar = depoisDas1530 ? 2 : 1;
  
	// Converte lista de feriados em Set para busca eficiente
	const feriados = new Set(Object.keys(listFeriado).map(data => {
	  const [dia, mes, ano] = data.split('/');
	  return `${ano}-${mes.padStart(2, '0')}-${dia.padStart(2, '0')}`;
	}));
  
	// Função recursiva para achar o próximo dia útil
	function buscarDiaUtil(dataAtual, diasRestantes) {
	  const proximaData = new Date(dataAtual);
	  proximaData.setDate(proximaData.getDate() + 1);
  
	  const diaSemana = proximaData.getDay(); // 0 = domingo, 6 = sábado
	  const dataFormatada = proximaData.toISOString().split('T')[0];
  
	  const ehUtil = diaSemana !== 0 && diaSemana !== 6 && !feriados.has(dataFormatada);
  
	  if (ehUtil) {
		diasRestantes--;
	  }
  
	  return diasRestantes === 0
		? proximaData
		: buscarDiaUtil(proximaData, diasRestantes);
	}
  
	const resultado = buscarDiaUtil(dataReferencia, diasASomar);
  
	// Formata para DD/MM/YYYY
	const dia = resultado.getDate().toString().padStart(2, '0');
	const mes = (resultado.getMonth() + 1).toString().padStart(2, '0');
	const ano = resultado.getFullYear();
	return `${dia}/${mes}/${ano}`;
  }

